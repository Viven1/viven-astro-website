<section class="av2" data-analytics-v2>
  <header class="av2-head">
    <div>
      <h2>Analytics</h2>
      <p data-av2-mode aria-live="polite">Cargando datos reales…</p>
    </div>
    <div class="av2-controls">
      <label class="av2-select">
        <span>Período</span>
        <select data-av2-period>
          <option value="7">7 días</option>
          <option value="month">Este mes</option>
          <option value="30" selected>30 días</option>
          <option value="90">90 días</option>
        </select>
      </label>
      <label class="av2-switch">
        <input type="checkbox" data-av2-humans checked />
        <span></span>
        Solo personas
      </label>
      <button class="av2-refresh" type="button" data-av2-refresh aria-label="Actualizar analytics">↻</button>
    </div>
  </header>

  <nav class="av2-tabs" role="tablist" aria-label="Secciones de analytics">
    <button id="av2-tab-web" class="on" type="button" role="tab" aria-selected="true" aria-controls="av2-panel-web" data-av2-tab="web">Web</button>
    <button id="av2-tab-acquisition" type="button" role="tab" aria-selected="false" aria-controls="av2-panel-acquisition" data-av2-tab="acquisition">Adquisición</button>
    <button id="av2-tab-videos" type="button" role="tab" aria-selected="false" aria-controls="av2-panel-videos" data-av2-tab="videos">Videos</button>
  </nav>

  <div class="av2-notice" data-av2-notice hidden></div>

  <div class="av2-kpis" data-av2-kpis>
    <button type="button" data-av2-kpi="sessions"><small>Personas</small><strong data-av2-sessions>—</strong><span>Sesiones con actividad real</span></button>
    <button type="button" data-av2-kpi="views"><small>Páginas vistas</small><strong data-av2-views>—</strong><span data-av2-views-label>De personas</span></button>
    <button type="button" data-av2-kpi="time"><small>Tiempo en página</small><strong data-av2-time>—</strong><span>Mediana, no promedio</span></button>
    <button type="button" data-av2-kpi="leads"><small>Leads atribuibles</small><strong data-av2-leads>—</strong><span data-av2-leads-label>Ligados a las sesiones medidas</span></button>
    <button type="button" data-av2-kpi="rate"><small>Conversión</small><strong data-av2-rate>—</strong><span>Sesiones que generaron lead ÷ sesiones</span></button>
  </div>

  <div id="av2-panel-web" data-av2-view="web" role="tabpanel" aria-labelledby="av2-tab-web">
    <div class="av2-grid av2-grid-main">
      <article class="av2-panel av2-chart-panel">
        <div class="av2-panel-head"><div><h3>Tráfico y leads</h3><p data-av2-chart-caption>Por día</p></div><span class="av2-legend"><i></i> Personas <i></i> Leads</span></div>
        <div class="av2-chart" data-av2-chart><p class="av2-empty">Esperando datos reales</p></div>
      </article>
      <article class="av2-panel">
        <div class="av2-panel-head"><div><h3>Conversiones recientes</h3><p>Personas que dejaron sus datos</p></div><a href="/dashboard/?tab=leads">Ver personas →</a></div>
        <div class="av2-conversions" data-av2-conversions><p class="av2-empty">Esperando datos reales</p></div>
      </article>
    </div>
    <article class="av2-panel">
      <div class="av2-panel-head"><div><h3>Páginas con más actividad</h3><p>Vistas verificadas y mediana de lectura</p></div><a href="/dashboard/?tab=analytics">Abrir analytics original →</a></div>
      <div class="av2-table-wrap"><table class="av2-table"><thead><tr><th>Página</th><th>Vistas</th><th>Sesiones</th><th>Tiempo</th><th>Leads de entrada</th></tr></thead><tbody data-av2-pages><tr><td colspan="5" class="av2-empty">Esperando datos reales</td></tr></tbody></table></div>
    </article>
  </div>

  <div id="av2-panel-acquisition" data-av2-view="acquisition" role="tabpanel" aria-labelledby="av2-tab-acquisition" hidden>
    <div class="av2-grid">
      <article class="av2-panel">
        <div class="av2-panel-head"><div><h3>Canales</h3><p>Sesiones de entrada → leads</p></div></div>
        <div class="av2-table-wrap"><table class="av2-table"><thead><tr><th>Canal</th><th>Sesiones</th><th>Sesiones con lead</th><th>Conversión</th></tr></thead><tbody data-av2-channels><tr><td colspan="4" class="av2-empty">Esperando datos reales</td></tr></tbody></table></div>
      </article>
      <article class="av2-panel">
        <div class="av2-panel-head"><div><h3>Referencias externas</h3><p>Desde qué sitios llegan</p></div></div>
        <div class="av2-table-wrap"><table class="av2-table"><thead><tr><th>Sitio</th><th>Sesiones</th><th>Sesiones con lead</th><th>Conversión</th></tr></thead><tbody data-av2-referrers><tr><td colspan="4" class="av2-empty">Esperando datos reales</td></tr></tbody></table></div>
      </article>
    </div>
    <article class="av2-panel">
      <div class="av2-panel-head"><div><h3>Páginas de entrada</h3><p>Qué entrada convierte y cuál necesita revisión</p></div></div>
      <div class="av2-table-wrap"><table class="av2-table"><thead><tr><th>Entrada</th><th>Sesiones</th><th>Sesiones con lead</th><th>Conversión</th></tr></thead><tbody data-av2-landings><tr><td colspan="4" class="av2-empty">Esperando datos reales</td></tr></tbody></table></div>
    </article>
  </div>

  <div id="av2-panel-videos" data-av2-view="videos" role="tabpanel" aria-labelledby="av2-tab-videos" hidden>
    <div class="av2-video-kpis">
      <div><small>Reproducciones</small><strong data-av2-video-starts>—</strong></div>
      <div><small>Sesiones con video</small><strong data-av2-video-sessions>—</strong></div>
      <div><small>Completadas</small><strong data-av2-video-complete>—</strong></div>
      <div><small>Terminaron en lead</small><strong data-av2-video-leads>—</strong></div>
    </div>
    <article class="av2-panel">
      <div class="av2-panel-head"><div><h3>Rendimiento por video</h3><p>Tracking propio: inicio, progreso y conversión</p></div><a href="/dashboard/?tab=analytics">Abrir origen →</a></div>
      <div class="av2-table-wrap"><table class="av2-table"><thead><tr><th>Video</th><th>Inicios</th><th>25%</th><th>50%</th><th>75%</th><th>100%</th><th>Leads</th></tr></thead><tbody data-av2-videos><tr><td colspan="7" class="av2-empty">Esperando datos reales</td></tr></tbody></table></div>
    </article>
  </div>

  <div class="av2-drawer" data-av2-drawer hidden>
    <button class="av2-backdrop" type="button" data-av2-close aria-label="Cerrar"></button>
    <aside class="av2-sheet" role="dialog" aria-modal="true" aria-labelledby="av2-detail-title" tabindex="-1">
      <button class="av2-x" type="button" data-av2-close aria-label="Cerrar">×</button>
      <p class="av2-eyebrow" data-av2-detail-kind>Detalle</p>
      <h2 id="av2-detail-title" data-av2-detail-title></h2>
      <p data-av2-detail-sub></p>
      <div class="av2-detail" data-av2-detail-body></div>
      <a class="av2-origin" data-av2-origin href="/dashboard/?tab=analytics">Abrir en el dashboard original →</a>
    </aside>
  </div>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const root = document.querySelector('[data-analytics-v2]');
  if (root) {
    const db = createClient('https://lumoevaotokgqnpybkyf.supabase.co', 'sb_publishable_ORGL5_FNZTXcGKwvjs-ymw_Y8DV_4ca');
    const q = (selector) => root.querySelector(selector);
    const qa = (selector) => [...root.querySelectorAll(selector)];
    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
    const demo = new URLSearchParams(location.search).get('demo') === '1';
    const HUMAN_TRACKING_START = Date.parse('2026-08-24T00:00:00Z');
    const DAY = 864e5;
    let raw = { views: [], activity: [], leads: [], plays: [] };
    let view = { views: [], leads: [], sessions: new Set(), convertedSessions: new Set(), from: 0, to: 0, humans: true };
    let verification = { activity: true, videos: true };
    let loading = false;
    let focusBeforeDrawer = null;

    const formatN = (number) => Number(number || 0).toLocaleString('de-CH');
    const formatTime = (seconds) => {
      const value = Math.round(Number(seconds) || 0);
      if (!value) return '—';
      return value < 60 ? value + ' s' : Math.floor(value / 60) + ' min ' + (value % 60 ? value % 60 + ' s' : '');
    };
    const median = (values) => {
      const ordered = values.filter((value) => Number(value) > 0).map(Number).sort((a, b) => a - b);
      if (!ordered.length) return 0;
      const middle = Math.floor(ordered.length / 2);
      return ordered.length % 2 ? ordered[middle] : (ordered[middle - 1] + ordered[middle]) / 2;
    };
    const interval = () => {
      const value = q('[data-av2-period]').value;
      const to = Date.now();
      if (value === 'month') {
        const now = new Date();
        return { from: new Date(now.getFullYear(), now.getMonth(), 1).getTime(), to, label: 'este mes' };
      }
      const days = Number(value) || 30;
      return { from: to - days * DAY, to, label: 'últimos ' + days + ' días' };
    };
    const realLead = (lead) => !lead.es_prueba && !/^claude-/.test(lead.session_id || '') && !/bexio/i.test(lead.channel || '');
    const cleanPath = (path) => path || '/';
    const normalizeHost = (referrer) => {
      let host = String(referrer || '').trim();
      try { if (/^https?:\/\//i.test(host)) host = new URL(host).hostname; } catch (_) { return ''; }
      host = host.replace(/^www\./, '').replace(/[/?#].*$/, '').toLowerCase();
      return !host || host === 'viven.ch' || host.endsWith('.viven.ch') ? '' : host;
    };
    const field = (label, value) => '<div><small>' + esc(label) + '</small><strong>' + esc(value ?? '—') + '</strong></div>';

    async function fetchRows(table, columns, from, to) {
      const rows = [];
      const pageSize = 1000;
      const maxRows = 50000;
      for (let start = 0; start < maxRows; start += pageSize) {
        const result = await db.from(table).select(columns).gte('created_at', new Date(from).toISOString()).lte('created_at', new Date(to).toISOString()).order('created_at', { ascending: true }).range(start, start + pageSize - 1);
        if (result.error) return { data: [], error: result.error };
        rows.push(...(result.data || []));
        if (!result.data || result.data.length < pageSize) break;
      }
      if (rows.length >= maxRows) {
        const probe = await db.from(table).select('created_at').gte('created_at', new Date(from).toISOString()).lte('created_at', new Date(to).toISOString()).order('created_at', { ascending: true }).range(maxRows, maxRows);
        if (probe.error) return { data: [], error: probe.error };
        if (probe.data?.length) return { data: [], error: new Error(table + ' supera ' + formatN(maxRows) + ' filas en la ventana; métricas ocultas para evitar un total truncado') };
      }
      return { data: rows, error: null };
    }

    function setUnknown(message) {
      ['sessions', 'views', 'time', 'leads', 'rate', 'video-starts', 'video-sessions', 'video-complete', 'video-leads'].forEach((name) => {
        const element = q('[data-av2-' + name + ']');
        if (element) element.textContent = '—';
      });
      q('[data-av2-mode]').textContent = message;
      q('[data-av2-chart]').innerHTML = '<p class="av2-empty">No hay datos verificables para mostrar</p>';
      q('[data-av2-conversions]').innerHTML = '<p class="av2-empty">No hay datos verificables para mostrar</p>';
      ['pages', 'channels', 'referrers', 'landings', 'videos'].forEach((name) => {
        const body = q('[data-av2-' + name + ']');
        if (body) body.innerHTML = '<tr><td colspan="7" class="av2-empty">No hay datos verificables para mostrar</td></tr>';
      });
    }

    function openDetail(kind, title, subtitle, body, origin) {
      if (demo) return;
      focusBeforeDrawer = document.activeElement;
      q('[data-av2-detail-kind]').textContent = kind;
      q('[data-av2-detail-title]').textContent = title;
      q('[data-av2-detail-sub]').textContent = subtitle || '';
      q('[data-av2-detail-body]').innerHTML = body;
      q('[data-av2-origin]').href = origin || '/dashboard/?tab=analytics';
      q('[data-av2-origin]').hidden = demo;
      q('[data-av2-drawer]').hidden = false;
      q('.av2-sheet').focus();
    }
    const closeDetail = () => {
      q('[data-av2-drawer]').hidden = true;
      if (focusBeforeDrawer && typeof focusBeforeDrawer.focus === 'function') focusBeforeDrawer.focus();
      focusBeforeDrawer = null;
    };
    qa('[data-av2-close]').forEach((button) => button.addEventListener('click', closeDetail));
    const activate = (element, handler) => {
      element.tabIndex = 0;
      element.setAttribute('role', 'button');
      element.addEventListener('click', handler);
      element.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        handler();
      });
    };
    document.addEventListener('keydown', (event) => {
      const drawer = q('[data-av2-drawer]');
      if (drawer.hidden) return;
      if (event.key === 'Escape') { event.preventDefault(); closeDetail(); return; }
      if (event.key !== 'Tab') return;
      const focusable = qa('.av2-sheet button, .av2-sheet a[href]').filter((element) => !element.hidden);
      if (!focusable.length) return;
      const first = focusable[0], last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });

    function setVideoUnknown(message) {
      ['video-starts', 'video-sessions', 'video-complete', 'video-leads'].forEach((name) => { q('[data-av2-' + name + ']').textContent = '—'; });
      q('[data-av2-videos]').innerHTML = '<tr><td colspan="7" class="av2-empty">' + esc(message) + '</td></tr>';
    }

    function renderChart() {
      const days = [];
      const count = Math.max(1, Math.ceil((view.to - view.from) / DAY));
      for (let index = count - 1; index >= 0; index--) {
        const date = new Date(view.to - index * DAY);
        days.push({ key: date.toISOString().slice(0, 10), label: date.toLocaleDateString('es-CH', { day: '2-digit', month: 'short' }), sessions: new Set(), leads: 0 });
      }
      const byDay = new Map(days.map((day) => [day.key, day]));
      view.views.forEach((row) => { const day = byDay.get(String(row.created_at || '').slice(0, 10)); if (day && row.session_id) day.sessions.add(row.session_id); });
      view.leads.forEach((lead) => { const day = byDay.get(String(lead.created_at || '').slice(0, 10)); if (day) day.leads++; });
      const max = Math.max(1, ...days.map((day) => day.sessions.size));
      q('[data-av2-chart-caption]').textContent = (view.humans ? 'Personas' : 'Sesiones con tráfico automático') + ' · ' + days.length + (days.length === 1 ? ' día' : ' días');
      q('[data-av2-chart]').innerHTML = '<div class="av2-chart-bars">' + days.map((day, index) => {
        const height = Math.max(3, Math.round(day.sessions.size / max * 100));
        const show = days.length <= 10 || index % Math.ceil(days.length / 7) === 0 || index === days.length - 1;
        return '<button type="button" style="--h:' + height + '%" title="' + esc(day.label + ': ' + day.sessions.size + ' sesiones · ' + day.leads + ' leads') + '" data-av2-day="' + esc(day.key) + '"><i></i>' + (day.leads ? '<b>' + day.leads + '</b>' : '') + '<span>' + (show ? esc(day.label) : '') + '</span></button>';
      }).join('') + '</div>';
      qa('[data-av2-day]').forEach((button) => button.addEventListener('click', () => {
        const day = days.find((item) => item.key === button.dataset.av2Day);
        if (!day) return;
        openDetail('Día', day.label, 'Actividad verificada', field(view.humans ? 'Personas' : 'Sesiones', day.sessions.size) + field('Leads', day.leads), '/dashboard/?tab=analytics');
      }));
    }

    function renderConversions() {
      const recent = view.leads.slice().sort((a, b) => Date.parse(b.created_at || '') - Date.parse(a.created_at || '')).slice(0, 6);
      q('[data-av2-conversions]').innerHTML = recent.length ? recent.map((lead) => '<button type="button" data-av2-lead="' + esc(lead.id) + '"><span><b>' + esc(lead.name || lead.email || 'Contacto sin nombre') + '</b><small>' + esc(lead.company || lead.email || 'Sin empresa') + '</small></span><em>' + esc(lead.channel || 'direct') + '</em><time>' + esc(new Date(lead.created_at).toLocaleDateString('es-CH', { day: '2-digit', month: 'short' })) + '</time></button>').join('') : '<p class="av2-empty">No hubo leads en esta ventana</p>';
      qa('[data-av2-lead]').forEach((button) => button.addEventListener('click', () => {
        const lead = view.leads.find((row) => String(row.id) === String(button.dataset.av2Lead));
        if (!lead) return;
        openDetail('Lead', lead.name || lead.email || 'Contacto sin nombre', lead.company || '', field('Email', lead.email) + field('Canal', lead.channel || 'direct') + field('Entrada', lead.landing_path || '—') + field('Estado', lead.status || '—') + field('Fecha', new Date(lead.created_at).toLocaleString('es-CH')), '/dashboard/?lead=' + encodeURIComponent(lead.id));
      }));
    }

    function renderPages() {
      const pages = new Map();
      view.views.forEach((row) => {
        const key = cleanPath(row.path);
        const item = pages.get(key) || { views: 0, sessions: new Set(), durations: [] };
        item.views++;
        if (row.session_id) item.sessions.add(row.session_id);
        if (Number(row.duration) > 0) item.durations.push(Number(row.duration));
        pages.set(key, item);
      });
      const landingLeads = new Map();
      view.leads.forEach((lead) => { const key = cleanPath(lead.landing_path); landingLeads.set(key, (landingLeads.get(key) || 0) + 1); });
      const rows = [...pages.entries()].map(([path, item]) => ({ path, ...item, leads: landingLeads.get(path) || 0, time: median(item.durations) })).sort((a, b) => b.views - a.views).slice(0, 15);
      q('[data-av2-pages]').innerHTML = rows.length ? rows.map((row) => '<tr data-av2-page="' + esc(row.path) + '"><td><b>' + esc(row.path) + '</b></td><td>' + formatN(row.views) + '</td><td>' + formatN(row.sessions.size) + '</td><td>' + formatTime(row.time) + '</td><td>' + row.leads + '</td></tr>').join('') : '<tr><td colspan="5" class="av2-empty">Sin páginas verificadas en la ventana</td></tr>';
      qa('[data-av2-page]').forEach((row) => activate(row, () => {
        const item = rows.find((entry) => entry.path === row.dataset.av2Page);
        if (!item) return;
        openDetail('Página', item.path, 'Actividad dentro del período seleccionado', field('Vistas', item.views) + field('Sesiones', item.sessions.size) + field('Tiempo mediano', formatTime(item.time)) + field('Leads de entrada', item.leads), '/dashboard/?tab=analytics');
      }));
    }

    function perfRows(sessionMap, leadMap) {
      return [...new Set([...sessionMap.keys(), ...leadMap.keys()])].map((key) => {
        const sessionsValue = sessionMap.get(key);
        const leadsValue = leadMap.get(key);
        const sessions = sessionsValue instanceof Set ? sessionsValue.size : Number(sessionsValue) || 0;
        const leads = leadsValue instanceof Set ? leadsValue.size : Number(leadsValue) || 0;
        return { key, sessions, leads, rate: sessions ? leads / sessions * 100 : null };
      }).sort((a, b) => b.leads - a.leads || b.sessions - a.sessions);
    }
    function perfBody(selector, rows, label) {
      q(selector).innerHTML = rows.length ? rows.slice(0, 15).map((row) => '<tr data-av2-perf="' + esc(label) + '" data-av2-perf-key="' + esc(row.key) + '"><td><b>' + esc(row.key) + '</b></td><td>' + formatN(row.sessions) + '</td><td>' + row.leads + '</td><td>' + (row.rate === null ? '—' : row.rate.toFixed(row.rate < 10 ? 1 : 0) + '%') + '</td></tr>').join('') : '<tr><td colspan="4" class="av2-empty">Sin datos verificables en la ventana</td></tr>';
    }
    function renderAcquisition() {
      const entries = view.views.filter((row) => row.is_entry);
      const channels = new Map(), channelLeads = new Map(), landings = new Map(), landingLeads = new Map(), refs = new Map(), refBySession = new Map(), refLeads = new Map();
      const addSession = (map, key, sessionId) => {
        if (!sessionId) return;
        if (!map.has(key)) map.set(key, new Set());
        map.get(key).add(sessionId);
      };
      entries.forEach((entry) => {
        const channel = entry.channel || 'direct';
        addSession(channels, channel, entry.session_id);
        const landing = cleanPath(entry.path);
        addSession(landings, landing, entry.session_id);
        const host = normalizeHost(entry.referrer);
        if (host) { addSession(refs, host, entry.session_id); if (entry.session_id) refBySession.set(entry.session_id, host); }
      });
      view.leads.forEach((lead) => {
        const channel = lead.channel || 'direct';
        addSession(channelLeads, channel, lead.session_id);
        const landing = cleanPath(lead.landing_path);
        addSession(landingLeads, landing, lead.session_id);
        const host = lead.session_id && refBySession.get(lead.session_id);
        if (host) addSession(refLeads, host, lead.session_id);
      });
      const sets = { Canal: perfRows(channels, channelLeads), Referencia: perfRows(refs, refLeads), Entrada: perfRows(landings, landingLeads) };
      perfBody('[data-av2-channels]', sets.Canal, 'Canal');
      perfBody('[data-av2-referrers]', sets.Referencia, 'Referencia');
      perfBody('[data-av2-landings]', sets.Entrada, 'Entrada');
      qa('[data-av2-perf]').forEach((row) => activate(row, () => {
        const item = (sets[row.dataset.av2Perf] || []).find((entry) => entry.key === row.dataset.av2PerfKey);
        if (!item) return;
        openDetail(row.dataset.av2Perf, item.key, 'Rendimiento dentro de la misma ventana', field('Sesiones', item.sessions) + field('Sesiones con lead', item.leads) + field('Conversión', item.rate === null ? '—' : item.rate.toFixed(item.rate < 10 ? 1 : 0) + '%'), '/dashboard/?tab=analytics');
      }));
    }

    function renderVideos() {
      if (!verification.videos) { setVideoUnknown('No se pudo verificar el tracking de videos'); return; }
      const byVideo = new Map();
      raw.plays.filter((play) => play.session_id && view.sessions.has(play.session_id)).forEach((play) => {
        const key = play.label || play.video_id || 'Video sin identificar';
        const item = byVideo.get(key) || { id: play.video_id, starts: 0, marks: { 25: 0, 50: 0, 75: 0, 100: 0 }, sessions: new Set(), startedSessions: new Set(), progressedSessions: new Set(), maxBySession: new Map() };
        const pct = Number(play.pct) || 0;
        if (!pct) { item.starts++; item.startedSessions.add(play.session_id); }
        else if (item.marks[pct] !== undefined) { item.marks[pct]++; item.progressedSessions.add(play.session_id); }
        if (play.session_id) {
          item.sessions.add(play.session_id);
          item.maxBySession.set(play.session_id, Math.max(item.maxBySession.get(play.session_id) || 0, pct));
        }
        byVideo.set(key, item);
      });
      const leadSessions = new Set(view.leads.map((lead) => lead.session_id).filter(Boolean));
      const rows = [...byVideo.entries()].map(([name, item]) => ({ name, ...item, missingStart: [...item.progressedSessions].some((id) => !item.startedSessions.has(id)), leads: [...item.sessions].filter((id) => leadSessions.has(id)).length })).sort((a, b) => b.starts - a.starts);
      const allSessions = new Set(), complete = new Set(), leadVideoSessions = new Set();
      rows.forEach((row) => row.sessions.forEach((session) => { allSessions.add(session); if ((row.maxBySession.get(session) || 0) >= 100) complete.add(session); if (leadSessions.has(session)) leadVideoSessions.add(session); }));
      const startsIncomplete = rows.some((row) => row.missingStart);
      q('[data-av2-video-starts]').textContent = startsIncomplete ? '—' : formatN(rows.reduce((sum, row) => sum + row.starts, 0));
      q('[data-av2-video-sessions]').textContent = formatN(allSessions.size);
      q('[data-av2-video-complete]').textContent = formatN(complete.size);
      q('[data-av2-video-leads]').textContent = formatN(leadVideoSessions.size);
      q('[data-av2-videos]').innerHTML = rows.length ? rows.map((row, index) => '<tr data-av2-video="' + index + '"><td><b>' + esc(row.name) + '</b></td><td' + (row.missingStart ? ' title="Hay hitos de progreso históricos sin evento de inicio"' : '') + '>' + (row.missingStart ? '—' : row.starts) + '</td><td>' + row.marks[25] + '</td><td>' + row.marks[50] + '</td><td>' + row.marks[75] + '</td><td>' + row.marks[100] + '</td><td>' + row.leads + '</td></tr>').join('') : '<tr><td colspan="7" class="av2-empty">Sin reproducciones en la ventana</td></tr>';
      qa('[data-av2-video]').forEach((row) => activate(row, () => {
        const item = rows[Number(row.dataset.av2Video)];
        if (!item) return;
        openDetail('Video', item.name, item.missingStart ? 'Tracking histórico incompleto: faltan eventos de inicio' : (item.id ? 'ID ' + item.id : 'Tracking propio'), field('Inicios', item.missingStart ? '—' : item.starts) + field('25%', item.marks[25]) + field('50%', item.marks[50]) + field('75%', item.marks[75]) + field('100%', item.marks[100]) + field('Leads relacionados', item.leads), '/dashboard/?tab=analytics');
      }));
    }

    function render() {
      const range = interval();
      const humans = q('[data-av2-humans]').checked;
      const humanFrom = Math.max(range.from, HUMAN_TRACKING_START);
      const activityIds = new Set(raw.activity.filter((row) => Date.parse(row.created_at || '') >= humanFrom).map((row) => row.session_id).filter(Boolean));
      const baseViews = raw.views.filter((row) => !/^claude-/.test(row.session_id || ''));
      const views = humans ? baseViews.filter((row) => activityIds.has(row.session_id)) : baseViews;
      const comparableFrom = humans ? humanFrom : range.from;
      const sessions = new Set(views.map((row) => row.session_id).filter(Boolean));
      const comparableLeads = raw.leads.filter((lead) => realLead(lead) && Date.parse(lead.created_at || '') >= comparableFrom && Date.parse(lead.created_at || '') <= range.to);
      const leads = comparableLeads.filter((lead) => lead.session_id && sessions.has(lead.session_id));
      const convertedSessions = new Set(leads.map((lead) => lead.session_id));
      view = { views, leads, sessions, convertedSessions, from: comparableFrom, to: range.to, humans };
      const duration = median(views.map((row) => row.duration));
      q('[data-av2-sessions]').textContent = formatN(view.sessions.size);
      q('[data-av2-views]').textContent = formatN(views.length);
      q('[data-av2-time]').textContent = formatTime(duration);
      q('[data-av2-leads]').textContent = formatN(leads.length);
      const conversionRate = view.sessions.size ? convertedSessions.size / view.sessions.size * 100 : null;
      q('[data-av2-rate]').textContent = conversionRate === null ? '—' : conversionRate.toFixed(conversionRate < 10 ? 1 : 0) + '%';
      q('[data-av2-views-label]').textContent = humans ? 'De personas' : 'Incluye tráfico automático';
      q('[data-av2-leads-label]').textContent = humans && range.from < HUMAN_TRACKING_START ? 'Atribuidos desde que existe medición humana' : 'Ligados a las sesiones medidas';
      q('[data-av2-kpi="sessions"] small').textContent = humans ? 'Personas' : 'Sesiones';
      q('[data-av2-kpi="rate"] span').textContent = humans ? 'Personas que generaron lead ÷ personas' : 'Sesiones que generaron lead ÷ sesiones con bots';
      const notice = q('[data-av2-notice]');
      if (humans && range.from < HUMAN_TRACKING_START) {
        notice.hidden = false;
        notice.textContent = 'La actividad humana se registra desde el 24/08/2026. Todos los ratios usan únicamente el tramo comparable; no se mezclan ventanas distintas.';
      } else notice.hidden = true;
      const newest = Math.max(0, ...raw.views.map((row) => Date.parse(row.created_at || '') || 0));
      q('[data-av2-mode]').textContent = 'Datos reales · ' + range.label + (newest ? ' · último evento ' + new Date(newest).toLocaleString('es-CH') : ' · sin eventos en la ventana');
      renderChart();
      renderConversions();
      renderPages();
      renderAcquisition();
      renderVideos();
    }

    async function load() {
      if (loading) return;
      if (demo) {
        q('[data-av2-mode]').innerHTML = 'Vista demo · sin datos ni métricas ficticias <a class="mode-link" href="/dashboard-v2/analytics/">Ver datos reales →</a>';
        setUnknown('Vista demo · sin datos ni métricas ficticias');
        q('[data-av2-mode]').innerHTML = 'Vista demo · sin datos ni métricas ficticias <a class="mode-link" href="/dashboard-v2/analytics/">Ver datos reales →</a>';
        qa('a[href^="/dashboard/"]').forEach((link) => { link.hidden = true; });
        qa('[data-av2-kpi]').forEach((button) => { button.disabled = true; });
        return;
      }
      loading = true;
      q('[data-av2-refresh]').disabled = true;
      q('[data-av2-mode]').textContent = 'Verificando datos reales…';
      try {
        const { data: auth } = await db.auth.getSession();
        if (!auth.session) {
          setUnknown('Sesión local no iniciada');
          q('[data-av2-mode]').innerHTML = 'Sesión local no iniciada <a href="/dashboard/">Iniciar sesión →</a>';
          return;
        }
        const range = interval();
        const activityFrom = Math.max(range.from, HUMAN_TRACKING_START);
        const [views, activity, leads, plays] = await Promise.all([
          fetchRows('pageviews', 'created_at,path,device,session_id,channel,referrer,lang,is_entry,duration', range.from, range.to),
          fetchRows('session_activity', 'session_id,created_at', activityFrom, range.to),
          fetchRows('leads', '*', range.from, range.to),
          fetchRows('video_plays', '*', range.from, range.to),
        ]);
        verification = { activity: !activity.error, videos: !plays.error };
        if (views.error || leads.error || (q('[data-av2-humans]').checked && activity.error)) {
          const problem = views.error || leads.error || activity.error;
          setUnknown('No se pudieron verificar los datos · métricas ocultas' + (problem?.message ? ' · ' + problem.message : ''));
          return;
        }
        raw = { views: views.data || [], activity: activity.data || [], leads: leads.data || [], plays: plays.error ? [] : (plays.data || []) };
        render();
      } catch (error) {
        setUnknown('No se pudieron verificar los datos · métricas ocultas');
      } finally {
        loading = false;
        q('[data-av2-refresh]').disabled = false;
      }
    }

    qa('[data-av2-tab]').forEach((button) => button.addEventListener('click', () => {
      qa('[data-av2-tab]').forEach((item) => { item.classList.toggle('on', item === button); item.setAttribute('aria-selected', String(item === button)); });
      qa('[data-av2-view]').forEach((panel) => { panel.hidden = panel.dataset.av2View !== button.dataset.av2Tab; });
    }));
    q('[data-av2-period]').addEventListener('change', load);
    q('[data-av2-humans]').addEventListener('change', () => {
      if (q('[data-av2-humans]').checked && !verification.activity) { load(); return; }
      raw.views.length || raw.leads.length ? render() : load();
    });
    q('[data-av2-refresh]').addEventListener('click', load);
    qa('[data-av2-kpi]').forEach((button) => button.addEventListener('click', () => {
      const values = {
        sessions: ['Sesiones', view.sessions.size, view.humans ? 'Personas con actividad real detectada' : 'Incluye tráfico automático'],
        views: ['Páginas vistas', view.views.length, view.humans ? 'Solo sesiones con actividad humana' : 'Todo el tráfico'],
        time: ['Tiempo en página', formatTime(median(view.views.map((row) => row.duration))), 'Mediana para evitar que pestañas abiertas deformen el dato'],
        leads: ['Leads atribuibles', view.leads.length, 'Leads reales ligados por session_id a las sesiones del denominador'],
        rate: ['Conversión', view.sessions.size ? (view.convertedSessions.size / view.sessions.size * 100).toFixed(1) + '%' : '—', 'Sesiones con al menos un lead atribuible ÷ sesiones; numerador y denominador usan exactamente la misma ventana'],
      };
      const item = values[button.dataset.av2Kpi];
      if (item) openDetail('Métrica', item[0], item[2], field('Valor', item[1]) + field('Ventana', q('[data-av2-period] option:checked').textContent), '/dashboard/?tab=analytics');
    }));
    load();
  }
</script>

