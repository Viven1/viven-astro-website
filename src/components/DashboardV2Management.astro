          labels: ['Tarea', 'Estado', 'Última corrida', 'Frecuencia'],
          cells: (r) => [r.jobname || 'Cron sin nombre', text(r.estado), date(r.last_run, true), text(r.schedule)],
          detail: (r) => genericDetails(r, [['Tarea', 'jobname'], ['Agenda', 'schedule'], ['Activa', 'activo'], ['Estado', 'estado'], ['Última corrida', 'last_run', (v) => date(v, true)], ['Resultado', 'last_status'], ['Mensaje', 'last_message'], ['Minutos desde la última', 'minutos_desde'], ['Esperado cada (min)', 'esperado_cada_min']]),
          attention: (r) => ['apagado', 'nunca_corrio', 'fallo', 'atrasado'].includes(String(r.estado || '')), href: '', copy: 'Estado real de cada tarea programada.',
        },
        {
          key: 'freshness', label: 'Frescura', icon: '◷', rpc: 'frescura_de_datos', source: 'Fuente de datos',
          state: (r) => text(r.estado),
          title: (r) => r.que_es || r.tabla || 'Fuente sin nombre', sub: (r) => text(r.tabla),
          labels: ['Fuente', 'Estado', 'Último dato', 'Antigüedad'],
          cells: (r) => [r.que_es || r.tabla || 'Fuente sin nombre', text(r.estado), date(r.ultima, true), r.horas === null || r.horas === undefined ? '—' : `${r.horas} h`],
          detail: (r) => genericDetails(r, [['Tabla', 'tabla'], ['Qué mide', 'que_es'], ['Estado', 'estado'], ['Último dato', 'ultima', (v) => date(v, true)], ['Horas', 'horas'], ['Tolerancia (horas)', 'horas_tolerancia']]),
