          labels: ['Usuario', 'Rol', 'Creado', 'Fuente'],
          cells: (r) => [r.email || 'Acceso sin email', text(r.role), date(r.created_at), 'Roles del dashboard'],
          detail: (r) => genericDetails(r, [['Email', 'email'], ['Rol', 'role'], ['Creado', 'created_at', date]]),
          attention: () => false, href: '', copy: 'Roles registrados. La gestión de contraseñas permanece en el flujo protegido del dashboard original.',
        },
        {
