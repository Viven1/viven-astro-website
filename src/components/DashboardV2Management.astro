---
const { section = 'contenido' } = Astro.props;
const copy = {
  contenido: {
    title: 'Contenido',
    subtitle: 'Publicaciones, campañas y mejoras que alimentan la web',
  },
  automatizaciones: {
    title: 'Automatizaciones',
    subtitle: 'Workflows, ejecuciones, borradores y tareas automáticas',
  },
  sistema: {
    title: 'Sistema',
    subtitle: 'Configuración operativa, equipo y salud de la plataforma',
  },
};
const current = copy[section] || copy.contenido;
---

<section class="management" data-management-root data-section={section}>
  <header class="management-head">
    <div>
      <h2>{current.title}</h2>
      <p>{current.subtitle}</p>
      <small data-management-mode>Cargando datos reales…</small>
    </div>
    <label class="management-search">
      <span aria-hidden="true">⌕</span>
      <input data-management-search type="search" placeholder={`Buscar en ${current.title.toLowerCase()}…`} />
    </label>
  </header>

  <nav class="management-tabs" data-management-tabs aria-label={`Secciones de ${current.title}`}></nav>

  <div class="management-kpis" aria-label="Resumen de la sección">
    <div><small data-kpi-total-label>Registros</small><strong data-kpi-total>—</strong></div>
    <div><small>Requieren atención</small><strong data-kpi-attention>—</strong></div>
    <div><small>Actualizados este mes</small><strong data-kpi-month>—</strong></div>
  </div>

  <div class="management-toolbar">
    <div>
      <h3 data-list-title>Registros</h3>
      <p data-list-copy>La información verificada aparece aquí.</p>
    </div>
    <select data-management-filter aria-label="Filtrar por estado"><option value="">Todos los estados</option></select>
  </div>

  <div class="management-table" data-management-table>
    <div class="management-row management-labels" data-management-labels></div>
    <div data-management-list><p class="management-empty">Esperando datos reales.</p></div>
  </div>

  <div class="management-drawer" data-management-drawer hidden>
    <button class="management-backdrop" data-management-close type="button" aria-label="Cerrar detalle"></button>
    <article class="management-sheet" role="dialog" aria-modal="true" aria-labelledby="management-detail-title">
      <button class="management-close" data-management-close type="button" aria-label="Cerrar">×</button>
      <span class="management-eyebrow" data-detail-kind>Detalle</span>
      <h2 id="management-detail-title" data-detail-title>Detalle</h2>
      <p data-detail-sub></p>
      <div class="management-fields" data-detail-body></div>
      <footer><a class="management-origin" data-detail-origin href="/dashboard/">Abrir en el dashboard original →</a></footer>
    </article>
  </div>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const root = document.querySelector('[data-management-root]');
  if (root instanceof HTMLElement) {
    const db = createClient(
      'https://lumoevaotokgqnpybkyf.supabase.co',
      'sb_publishable_ORGL5_FNZTXcGKwvjs-ymw_Y8DV_4ca',
    );
    const section = root.dataset.section || 'contenido';
    const demo = new URLSearchParams(location.search).get('demo') === '1';
    const $ = (selector) => root.querySelector(selector);
    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    })[char]);
    const text = (value, fallback = '—') => {
      if (value === null || value === undefined || value === '') return fallback;
      if (typeof value === 'boolean') return value ? 'Sí' : 'No';
      if (Array.isArray(value)) return value.length ? value.join(', ') : fallback;
      if (typeof value === 'object') return JSON.stringify(value);
      return String(value);
    };
    const date = (value, withTime = false) => {
      if (!value) return '—';
      const parsed = new Date(value);
      if (Number.isNaN(parsed.getTime())) return text(value);
      return parsed.toLocaleString('es-CH', withTime
        ? { dateStyle: 'medium', timeStyle: 'short' }
        : { dateStyle: 'medium' });
    };
    const money = (value) => {
      if (value === null || value === undefined || value === '') return '—';
      const amount = Number(value);
      return Number.isFinite(amount) ? `CHF ${amount.toLocaleString('de-CH')}` : '—';
    };
    const status = (row) => text(row.status ?? (row.enabled === true ? 'active' : row.enabled === false ? 'paused' : ''), 'Sin estado');
    const timestamp = (row) => row.updated_at || row.created_at || row.published_at || row.scheduled_at || row.started_at || row.approved_at || row.at || row.last_run || row.ultima || null;
    const inactive = (value) => ['inactive', 'paused', 'disabled', 'cancelled', 'discarded', 'stopped'].includes(String(value || '').toLowerCase());
    const waiting = (value) => ['pending', 'queued', 'approved', 'draft', 'waiting', 'requested', 'failed', 'error'].includes(String(value || '').toLowerCase());
    const origin = (tab, sub = '') => `/dashboard/?tab=${encodeURIComponent(tab)}${sub ? `&sub=${encodeURIComponent(sub)}` : ''}`;
    const genericDetails = (row, fields) => fields.map(([label, key, format]) => [label, format ? format(row[key], row) : text(row[key])]);
    const subjectFor = (row) => row.subject || row.subject_i18n?.en || row.subject_i18n?.de || row.subject_i18n?.es || '';
    const minutesAsTime = (value) => {
      const minutes = Number(value);
      if (!Number.isFinite(minutes)) return '—';
      const hours = Math.floor(minutes / 60) % 24;
      const mins = minutes % 60;
      return `${String(hours).padStart(2, '0')}:${String(mins).padStart(2, '0')}`;
    };
    const canonicalDashboardUrl = (value) => {
      if (!value) return '';
      try {
        const url = new URL(String(value), location.origin);
        return url.origin === location.origin && url.pathname === '/dashboard/'
          ? `${url.pathname}${url.search}${url.hash}`
          : '';
      } catch (_) {
        return '';
      }
    };
    const issueSubject = (row) => row.content?.en?.subject || row.content?.de?.subject || row.content?.es?.subject || '';
    const cashflowTitle = (row) => {
      if (row._table === 'cashflow_entries') return row.description || 'Partida sin descripción';
      if (row._table === 'cashflow_recurring_templates') return row.description || 'Recurrente sin descripción';
      if (row._table === 'cashflow_loans') return row.name || 'Préstamo sin nombre';
      if (row._table === 'cashflow_bank_balance') return 'Saldo bancario';
      if (row._table === 'cashflow_alert_settings') return 'Configuración de alertas';
      return 'Registro de caja';
    };
    const cashflowSource = (row) => ({
      cashflow_entries: 'Partida',
      cashflow_recurring_templates: 'Recurrente',
      cashflow_loans: 'Préstamo / leasing',
      cashflow_bank_balance: 'Saldo',
      cashflow_alert_settings: 'Configuración',
    })[row._table] || 'Caja';
    const cashflowAmount = (row) => row.amount_chf ?? row.balance_chf ?? row.principal_chf ?? row.min_balance_threshold_chf;
    const cashflowDate = (row) => row.due_date || row.as_of_date || row.end_date || row.created_at;
    const cashflowDetail = (row) => {
      if (row._table === 'cashflow_entries') return genericDetails(row, [['Descripción', 'description'], ['Tipo', 'kind'], ['Origen', 'source'], ['Monto', 'amount_chf', money], ['Vencimiento', 'due_date', date], ['Estado', 'status'], ['Creado por', 'created_by']]);
      if (row._table === 'cashflow_recurring_templates') return genericDetails(row, [['Descripción', 'description'], ['Tipo', 'kind'], ['Monto', 'amount_chf', money], ['Frecuencia', 'frequency'], ['Día del mes', 'day_of_month'], ['Desde', 'start_date', date], ['Hasta', 'end_date', date], ['Activo', 'active']]);
      if (row._table === 'cashflow_loans') return genericDetails(row, [['Nombre', 'name'], ['Principal', 'principal_chf', money], ['Cuota mensual', 'monthly_payment_chf', money], ['Desde', 'start_date', date], ['Hasta', 'end_date', date], ['Notas', 'notes']]);
      if (row._table === 'cashflow_bank_balance') return genericDetails(row, [['Saldo', 'balance_chf', money], ['Fecha del saldo', 'as_of_date', date], ['Nota', 'note'], ['Creado por', 'created_by']]);
      return genericDetails(row, [['Umbral mínimo', 'min_balance_threshold_chf', money], ['Límite de crédito', 'credit_limit_chf', money], ['Email de alerta', 'alert_email'], ['Alertas activas', 'enabled'], ['Último período alertado', 'last_alerted_period']]);
    };
    let currentUserEmail = '';

    const sections = {
      contenido: [
        {
          key: 'blog', label: 'Blog', icon: '✍️', table: 'blogs', source: 'Blog',
          title: (r) => r.title || r.topic || 'Artículo sin título',
          sub: (r) => [String(r.lang || '').toUpperCase(), r.slug].filter(Boolean).join(' · '),
          labels: ['Artículo', 'Idioma', 'Estado', 'Actualizado'],
          cells: (r) => [r.title || r.topic || 'Artículo sin título', String(r.lang || '—').toUpperCase(), status(r), date(timestamp(r))],
          detail: (r) => genericDetails(r, [['Título', 'title'], ['Idioma', 'lang', (v) => String(v || '—').toUpperCase()], ['Estado', 'status'], ['Slug', 'slug'], ['Keyword objetivo', 'target_keyword'], ['Posición inicial', 'keyword_current_position'], ['Veredicto de keyword', 'keyword_verdict'], ['URL publicada', 'published_url'], ['Actualización', 'updated_at', date], ['Publicación', 'published_at', date]]),
          attention: (r) => ['pending', 'draft', 'review'].includes(String(r.status || '').toLowerCase()),
          href: origin('contenido', 'blog'), copy: 'Artículos y borradores en los idiomas de la web.',
        },
        {
          key: 'cola', label: 'Cola editorial', icon: '☷', table: 'content_queue', source: 'Cola editorial',
          title: (r) => r.topic || r.title || 'Tema sin título', sub: (r) => `Prioridad ${text(r.priority)}`,
          labels: ['Tema', 'Prioridad', 'Estado', 'Creado'],
          cells: (r) => [r.topic || r.title || 'Tema sin título', text(r.priority), status(r), date(timestamp(r))],
          detail: (r) => genericDetails(r, [['Tema', 'topic'], ['Estado', 'status'], ['Prioridad', 'priority'], ['Keyword objetivo', 'target_keyword'], ['Motivo de la keyword', 'keyword_why'], ['Prioridad de keyword', 'keyword_priority'], ['Finalizado', 'done_at', date], ['Creado', 'created_at', date]]),
          attention: (r) => waiting(r.status), href: origin('contenido', 'blog'), copy: 'Temas que esperan entrar al motor de contenido.',
        },
        {
          key: 'newsletter', label: 'Newsletter', icon: '▤', table: 'newsletters', source: 'Newsletter',
          title: (r) => subjectFor(r) || 'Envío sin asunto', sub: (r) => String(r.segment_lang || '—').toUpperCase(),
          labels: ['Campaña', 'Segmento', 'Estado', 'Fecha'],
          cells: (r) => [subjectFor(r) || 'Envío sin asunto', text(r.segment_stage), status(r), date(timestamp(r))],
          detail: (r) => genericDetails(r, [['Asunto', 'subject', (v, x) => text(v || subjectFor(x))], ['Asuntos por idioma', 'subject_i18n'], ['Estado', 'status'], ['Segmento', 'segment_stage'], ['Idioma', 'segment_lang', (v) => String(v || '—').toUpperCase()], ['Programado', 'scheduled_at', (v) => date(v, true)], ['Enviado', 'sent_at', (v) => date(v, true)], ['Cantidad enviada', 'sent_count'], ['Creado', 'created_at', date]]),
          attention: (r) => waiting(r.status), href: origin('contenido', 'news'), copy: 'Campañas, borradores y envíos guardados.',
        },
        {
          key: 'issues', label: 'Ediciones mensuales', icon: '▥', table: 'newsletter_issues', source: 'Edición mensual', order: 'created_at',
          title: (r) => issueSubject(r) || r.month || 'Edición sin asunto', sub: (r) => text(r.month),
          labels: ['Edición', 'Mes', 'Estado', 'Enviados'],
          cells: (r) => [issueSubject(r) || 'Edición sin asunto', text(r.month), status(r), r.sent_count === null || r.sent_count === undefined ? '—' : String(r.sent_count)],
          detail: (r) => genericDetails(r, [['Mes', 'month'], ['Estado', 'status'], ['Contenido por idioma', 'content'], ['Proyecto destacado', 'project_key'], ['Aprobado por', 'approved_by'], ['Enviado', 'sent_at', (v) => date(v, true)], ['Cantidad enviada', 'sent_count'], ['Creado', 'created_at', date]]),
          attention: (r) => r.status === 'draft', href: origin('contenido', 'news'), copy: 'Ediciones automáticas que nunca se envían sin aprobación humana.',
        },
        {
          key: 'seo', label: 'SEO', icon: '⌕', table: 'seo_actions', source: 'Acción SEO',
          title: (r) => r.page || r.title || 'Acción SEO', sub: (r) => text(r.action_type || r.type),
          labels: ['Página', 'Acción', 'Estado', 'Creado'],
          cells: (r) => [r.page || r.title || 'Acción SEO', text(r.action_type || r.type), status(r), date(timestamp(r))],
          detail: (r) => genericDetails(r, [['Página', 'page'], ['Tipo', 'action_type'], ['Estado', 'status'], ['Nota', 'note'], ['Creado por', 'created_by'], ['Fecha', 'created_at', date]]),
          attention: (r) => waiting(r.status), href: origin('contenido', 'seo'), copy: 'Cambios propuestos y aplicados sobre la web.',
        },
        {
          key: 'keywords', label: 'Keywords', icon: 'K', table: 'keyword_opportunities', source: 'Oportunidad de keyword', order: 'priority',
          title: (r) => r.keyword || 'Keyword sin nombre', sub: (r) => String(r.lang || '—').toUpperCase(),
          labels: ['Keyword', 'Tipo', 'Prioridad', 'Estado'],
          cells: (r) => [r.keyword || 'Keyword sin nombre', text(r.type), r.priority === null || r.priority === undefined ? '—' : String(r.priority), status(r)],
          detail: (r) => genericDetails(r, [['Keyword', 'keyword'], ['Idioma', 'lang', (v) => String(v || '—').toUpperCase()], ['Tipo', 'type'], ['Prioridad', 'priority'], ['Por qué', 'why'], ['Acción', 'action'], ['Fuente', 'source'], ['Estado', 'status'], ['Actualizado', 'updated_at', date]]),
          attention: (r) => r.status === 'new', href: origin('contenido', 'seo'), copy: 'Oportunidades acumuladas desde Search Console y Ads.',
        },
        {
          key: 'search-console', label: 'Search Console', icon: 'G', table: 'gsc_daily', source: 'Dato de Search Console', order: 'date',
          title: (r) => r.query || 'Búsqueda sin texto', sub: (r) => date(r.date),
          labels: ['Búsqueda', 'Clicks', 'Impresiones', 'Posición'],
          cells: (r) => [r.query || 'Búsqueda sin texto', String(r.clicks ?? '—'), String(r.impressions ?? '—'), r.position === null || r.position === undefined ? '—' : Number(r.position).toLocaleString('es-CH', { maximumFractionDigits: 1 })],
          detail: (r) => genericDetails(r, [['Búsqueda', 'query'], ['Fecha', 'date', date], ['Clicks', 'clicks'], ['Impresiones', 'impressions'], ['Posición', 'position'], ['Actualizado', 'updated_at', date]]),
          attention: () => false, href: origin('contenido', 'seo'), copy: 'Snapshots reales de búsquedas, clicks, impresiones y posición.',
        },
        {
          key: 'site-health', label: 'Salud web', icon: '✓', table: 'site_health_runs', source: 'Revisión del sitio', order: 'created_at',
          title: (r) => `Revisión ${date(r.created_at, true)}`, sub: (r) => `${r.total ?? '—'} URLs`,
          labels: ['Revisión', 'Correctas', 'Redirecciones', 'Rotas'],
          cells: (r) => [date(r.created_at, true), String(r.ok ?? '—'), String(r.redirect_count ?? '—'), String(r.broken_count ?? '—')],
          detail: (r) => genericDetails(r, [['Fecha', 'created_at', (v) => date(v, true)], ['URLs revisadas', 'total'], ['Correctas', 'ok'], ['Redirecciones', 'redirect_count'], ['Rotas', 'broken_count'], ['Detalle de rotas', 'broken'], ['Detalle de redirecciones', 'redirects']]),
          attention: (r) => Number(r.broken_count) > 0 || Number(r.redirect_count) > 0, href: origin('contenido', 'seo'), copy: 'Chequeos reales del sitemap y sus URLs.',
        },
        {
          key: 'magnets', label: 'Lead magnets', icon: '↓', table: 'magnet_sends', source: 'Envío de lead magnet', order: 'created_at',
          title: (r) => r.magnet || 'Lead magnet', sub: (r) => text(r.email),
          labels: ['Magnet', 'Contacto', 'Idioma', 'Enviado'],
          cells: (r) => [r.magnet || 'Lead magnet', text(r.email), String(r.lang || '—').toUpperCase(), date(r.sent_at || r.created_at, true)],
          detail: (r) => genericDetails(r, [['Magnet', 'magnet'], ['Email', 'email'], ['Idioma', 'lang', (v) => String(v || '—').toUpperCase()], ['Lead', 'lead_id'], ['Enviado', 'sent_at', (v) => date(v, true)], ['Abierto', 'opened_at', (v) => date(v, true)], ['Click', 'clicked_at', (v) => date(v, true)], ['Creado', 'created_at', date]]),
          attention: () => false, href: origin('contenido', 'magnets'), copy: 'Entregas reales por email y sus señales de apertura y click.',
        },
      ],
      automatizaciones: [
        {
          key: 'workflows', label: 'Workflows', icon: '⌘', table: 'automations', source: 'Workflow',
          title: (r) => r.name || 'Workflow sin nombre', sub: (r) => text(r.trigger_type || r.trigger),
          labels: ['Workflow', 'Disparador', 'Estado', 'Actualizado'],
          cells: (r) => [r.name || 'Workflow sin nombre', text(r.trigger_type || r.trigger), r.enabled === true ? 'Activo' : r.enabled === false ? 'Pausado' : status(r), date(timestamp(r))],
          detail: (r) => genericDetails(r, [['Nombre', 'name'], ['Activo', 'enabled'], ['Disparador', 'trigger', (v) => text(v)], ['Configuración', 'trigger_config'], ['Split A/B', 'ab_split', (v) => v === null || v === undefined ? '—' : `${v}% para B`], ['Pasos A', 'steps_a'], ['Pasos B', 'steps_b'], ['Actualizado', 'updated_at', date]]),
          attention: (r) => String(r.status || '').toLowerCase() === 'error', href: origin('sistema', 'auto'), copy: 'Reglas automáticas y secuencias configuradas.',
        },
        {
          key: 'runs', label: 'Ejecuciones', icon: '↻', table: 'automation_runs', source: 'Ejecución',
          title: (r) => `Ejecución ${text(r.id)}`, sub: (r) => `Lead ${text(r.lead_id)}`,
          labels: ['Ejecución', 'Lead', 'Estado', 'Próximo paso'],
          cells: (r) => [`Ejecución ${text(r.id)}`, text(r.lead_id), status(r), date(r.next_at, true)],
          detail: (r) => genericDetails(r, [['ID', 'id'], ['Workflow', 'automation_id'], ['Lead', 'lead_id'], ['Variante', 'variant'], ['Paso', 'step_idx'], ['Estado', 'status'], ['Próxima ejecución', 'next_at', (v) => date(v, true)]]),
          attention: (r) => ['failed', 'error'].includes(String(r.status || '').toLowerCase()), href: origin('sistema', 'auto'), copy: 'Personas que están recorriendo un workflow.',
        },
        {
          key: 'outbox', label: 'Bandeja', icon: '↗', table: 'outbox', source: 'Borrador automático',
          title: (r) => r.subject || 'Email sin asunto', sub: (r) => text(r.kind),
          labels: ['Asunto', 'Tipo', 'Estado', 'Programado'],
          cells: (r) => [r.subject || 'Email sin asunto', text(r.kind), status(r), date(r.scheduled_at, true)],
          detail: (r) => genericDetails(r, [['Asunto', 'subject'], ['Tipo', 'kind'], ['Estado', 'status'], ['Lead', 'lead_id'], ['Remitente', 'sender'], ['Programado', 'scheduled_at', (v) => date(v, true)], ['Creado', 'created_at', date]]),
          attention: (r) => ['pending', 'failed', 'error'].includes(String(r.status || '').toLowerCase()), href: (r) => `${origin('sistema', 'auto')}&ob=${encodeURIComponent(r.id)}`, copy: 'Emails automáticos que esperan revisión o salida.',
        },
        {
          key: 'templates', label: 'Plantillas', icon: '▱', table: 'email_templates', source: 'Plantilla',
          title: (r) => r.name || r.key || r.subject || 'Plantilla sin nombre', sub: (r) => String(r.lang || '—').toUpperCase(),
          labels: ['Plantilla', 'Idioma', 'Asunto', 'Actualizada'],
          cells: (r) => [r.name || r.key || 'Plantilla sin nombre', String(r.lang || '—').toUpperCase(), text(r.subject), date(timestamp(r))],
          detail: (r) => genericDetails(r, [['Clave', 'key'], ['Nombre', 'name'], ['Idioma', 'lang', (v) => String(v || '—').toUpperCase()], ['Asunto', 'subject'], ['Actualización', 'updated_at', date]]),
          attention: () => false, href: origin('sistema', 'tmpl'), copy: 'Personalizaciones guardadas. Los textos originales siguen disponibles en el editor del dashboard.',
        },
        {
          key: 'queue', label: 'Cola de trabajo', icon: '✓', table: 'work_queue', source: 'Tarea automática',
          title: (r) => r.title || 'Tarea sin título', sub: (r) => text(r.source),
          labels: ['Tarea', 'Tipo', 'Estado', 'Creada'],
          cells: (r) => [r.title || 'Tarea sin título', text(r.source), status(r), date(r.approved_at || r.created_at)],
          detail: (r) => genericDetails(r, [['Título', 'title'], ['Origen', 'source'], ['Referencia', 'ref'], ['Estado', 'status'], ['Detalle', 'detail'], ['Aprobado por', 'approved_by'], ['Aprobado', 'approved_at', (v) => date(v, true)], ['Terminado', 'done_at', (v) => date(v, true)], ['Resultado', 'done_note']]),
          attention: (r) => waiting(r.status), href: (r) => canonicalDashboardUrl(r.url) || origin('sistema', 'auto'), copy: 'Trabajo aprobado que todavía espera ejecución.',
        },
      ],
      sistema: [
        {
          key: 'services', label: 'Servicios', icon: '◇', table: 'services', source: 'Servicio',
          title: (r) => r.name || 'Servicio sin nombre', sub: (r) => text(r.phase || r.category),
          labels: ['Servicio', 'Fase', 'Unidad', 'Precio'],
          cells: (r) => [r.name || 'Servicio sin nombre', text(r.phase || r.category), text(r.unit), money(r.price)],
          detail: (r) => genericDetails(r, [['Nombre', 'name'], ['Fase', 'phase'], ['Unidad', 'unit'], ['Precio', 'price', money], ['Costo', 'cost', money], ['Activo', 'active'], ['Actualizado', 'updated_at', date]]),
          attention: () => false, href: origin('sistema', 'services'), copy: 'Catálogo real que alimenta las ofertas.',
        },
        {
          key: 'licenses', label: 'Licencias', icon: '□', table: 'licenses', source: 'Licencia',
          title: (r) => r.title || 'Licencia sin título', sub: (r) => r.lead_id === null || r.lead_id === undefined ? '—' : `Lead ${r.lead_id}`,
          labels: ['Licencia', 'Estado', 'Renovación', 'Monto'],
          cells: (r) => [r.title || r.name || 'Licencia sin título', status(r), date(r.renewal_date), money(r.amount)],
          detail: (r) => genericDetails(r, [['Título', 'title'], ['Estado', 'status'], ['Cliente', 'lead_id'], ['Monto', 'amount', money], ['Inicio', 'start_date', date], ['Renovación', 'renewal_date', date], ['Notas', 'notes']]),
          attention: (r) => {
            if (inactive(r.status) || !r.renewal_date) return false;
            const renewal = Date.parse(r.renewal_date);
            return Number.isFinite(renewal) && renewal <= Date.now() + 90 * 864e5;
          },
          href: origin('sistema', 'licenses'), copy: 'Derechos de uso e ingresos recurrentes.',
        },
        {
          key: 'cashflow', label: 'Cash Flow', icon: 'CHF', tables: ['cashflow_entries', 'cashflow_recurring_templates', 'cashflow_loans', 'cashflow_bank_balance', 'cashflow_alert_settings'], source: 'Cash Flow', superadmin: true,
          title: cashflowTitle, sub: cashflowSource,
          labels: ['Registro', 'Fuente', 'Monto', 'Fecha / estado'],
