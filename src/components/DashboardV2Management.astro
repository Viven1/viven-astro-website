        {
          key: 'health', label: 'Salud', icon: '!', table: 'dash_perf_log', source: 'Error registrado', order: 'at',
          filterRows: (sourceRows) => sourceRows.filter((r) => {
            const kind = String(r.phases?.kind || '');
            const at = Date.parse(r.at);
            return ['error', 'error_visto'].includes(kind) && Number.isFinite(at) && at >= Date.now() - 7 * 864e5;
          }),
          title: (r) => text(r.phases?.msg, '(sin mensaje)'), sub: (r) => text(r.phases?.donde || r.phases?.tab || r.email),
          labels: ['Evento', 'Origen', 'Tipo', 'Fecha'],
          cells: (r) => [text(r.phases?.msg, '(sin mensaje)'), text(r.phases?.donde || r.phases?.tab || r.email), r.phases?.kind === 'error' ? 'Excepción' : 'Aviso visible', date(r.at, true)],
          detail: (r) => [['Mensaje', text(r.phases?.msg)], ['Dónde', text(r.phases?.donde)], ['Pestaña', text(r.phases?.tab)], ['Tipo', r.phases?.kind === 'error' ? 'Excepción' : 'Aviso visible'], ['Usuario', text(r.email)], ['Fecha', date(r.at, true)], ['Navegador', text(r.ua)]],
          attention: () => true, href: '', copy: 'Errores de los últimos 7 días; vacío es una buena señal.',
        },
      ],
    };

    const configs = sections[section] || sections.contenido;
    let active = configs[0];
    let rows = [];
    let requestId = 0;
    let verified = false;

    async function readAll(table, order = '') {
      const data = [];
      for (let from = 0; from < 20000; from += 1000) {
        let query = db.from(table).select('*');
        if (order) query = query.order(order, { ascending: false });
        const result = await query.range(from, from + 999);
        if (result.error) return result;
        data.push(...(result.data || []));
        if ((result.data || []).length < 1000) return { data, error: null };
      }
      const probe = await db.from(table).select('*').range(20000, 20000);
      return probe.error || (probe.data || []).length
        ? { data: null, error: probe.error || { message: 'Más de 20.000 registros' } }
        : { data, error: null };
    }

    function setMode(html, isHtml = false) {
      const el = $('[data-management-mode]');
      if (!el) return;
      if (isHtml) el.innerHTML = html;
      else el.textContent = html;
    }
    function updateTabs() {
      const tabs = $('[data-management-tabs]');
      if (!tabs) return;
      tabs.innerHTML = configs.map((cfg) => `<button type="button" data-management-tab="${esc(cfg.key)}" class="${cfg.key === active.key ? 'active' : ''}"><span>${esc(cfg.icon)}</span>${esc(cfg.label)}</button>`).join('');
      tabs.querySelectorAll('[data-management-tab]').forEach((button) => {
        button.addEventListener('click', () => {
          active = configs.find((cfg) => cfg.key === button.dataset.managementTab) || configs[0];
          const search = $('[data-management-search]');
          if (search instanceof HTMLInputElement) search.value = '';
          updateTabs();
          load();
        });
      });
    }
    function clearNumbers() {
      ['[data-kpi-total]', '[data-kpi-attention]', '[data-kpi-month]'].forEach((selector) => {
        const el = $(selector);
        if (el) el.textContent = '—';
      });
    }
    function render() {
      if (!verified) return;
      const input = $('[data-management-search]');
      const select = $('[data-management-filter]');
      const term = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
      const filter = select instanceof HTMLSelectElement ? select.value : '';
      const stateFor = (row) => active.state ? active.state(row) : status(row);
      const filtered = rows.filter((row) => {
        const haystack = [active.title(row), active.sub(row), ...active.cells(row)].join(' ').toLowerCase();
        return (!term || haystack.includes(term)) && (!filter || stateFor(row) === filter);
      });
      const list = $('[data-management-list]');
      if (list) {
        list.innerHTML = filtered.length
          ? filtered.map((row, index) => `<button class="management-row" type="button" data-management-row="${index}">${active.cells(row).map((cell, cellIndex) => `<span${cellIndex === 0 ? ' class="management-primary"' : ''}>${esc(cell)}</span>`).join('')}</button>`).join('')
          : '<p class="management-empty">No hay resultados para esta vista.</p>';
        list.querySelectorAll('[data-management-row]').forEach((button) => {
          button.addEventListener('click', () => openDetail(filtered[Number(button.dataset.managementRow)]));
        });
      }
      const total = $('[data-kpi-total]');
      const attention = $('[data-kpi-attention]');
      const month = $('[data-kpi-month]');
      if (total) total.textContent = String(rows.length);
      if (attention) attention.textContent = String(rows.filter(active.attention).length);
      const dates = rows.map(timestamp).map((value) => Date.parse(value)).filter(Number.isFinite);
      if (month) {
        const start = new Date();
        start.setDate(1); start.setHours(0, 0, 0, 0);
        month.textContent = dates.length ? String(dates.filter((value) => value >= start.getTime()).length) : '—';
      }
    }
    function openDetail(row) {
      if (!row) return;
      const drawer = $('[data-management-drawer]');
      const kind = $('[data-detail-kind]');
      const titleEl = $('[data-detail-title]');
      const sub = $('[data-detail-sub]');
      const body = $('[data-detail-body]');
      const link = $('[data-detail-origin]');
      if (kind) kind.textContent = active.source;
      if (titleEl) titleEl.textContent = active.title(row);
      if (sub) sub.textContent = active.sub(row) || 'Información verificada del registro';
      if (body) body.innerHTML = active.detail(row).map(([label, value]) => `<div><small>${esc(label)}</small><strong>${esc(text(value))}</strong></div>`).join('');
      if (link instanceof HTMLAnchorElement) {
        const href = typeof active.href === 'function' ? active.href(row) : active.href;
        link.href = href || '/dashboard/';
        link.hidden = demo || !href;
      }
      if (drawer instanceof HTMLElement) drawer.hidden = false;
    }
    function closeDetail() {
      const drawer = $('[data-management-drawer]');
      if (drawer instanceof HTMLElement) drawer.hidden = true;
    }
    root.querySelectorAll('[data-management-close]').forEach((button) => button.addEventListener('click', closeDetail));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeDetail(); });
    $('[data-management-search]')?.addEventListener('input', render);
    $('[data-management-filter]')?.addEventListener('change', render);

    async function load() {
      const thisRequest = ++requestId;
      rows = [];
      verified = false;
      closeDetail();
      clearNumbers();
      const title = $('[data-list-title]');
      const copy = $('[data-list-copy]');
      const labels = $('[data-management-labels]');
      const list = $('[data-management-list]');
      const filter = $('[data-management-filter]');
      if (title) title.textContent = active.label;
      if (copy) copy.textContent = active.copy;
      if (labels) labels.innerHTML = active.labels.map((label) => `<span>${esc(label)}</span>`).join('');
      if (list) list.innerHTML = '<p class="management-empty">Cargando datos reales…</p>';
      if (filter instanceof HTMLSelectElement) filter.innerHTML = '<option value="">Todos los estados</option>';
      if (demo) {
        setMode(`Vista demo · sin datos ni métricas ficticias <a class="mode-link" href="/dashboard-v2/${esc(section)}/">Ver datos reales →</a>`, true);
        if (list) list.innerHTML = '<p class="management-empty">Los registros reales aparecen aquí al abrir esta vista con una sesión activa.</p>';
        return;
      }
      const { data: { session } } = await db.auth.getSession();
      if (thisRequest !== requestId) return;
      if (!session) {
        setMode('Sesión local no iniciada · iniciá sesión para consultar la información real.');
        if (list) list.innerHTML = '<p class="management-empty">No se muestran datos sin una sesión verificada.</p>';
        return;
      }
      currentUserEmail = String(session.user.email || '').toLowerCase();
      if (active.superadmin) {
        const roleResult = await db.from('user_roles').select('role').eq('email', currentUserEmail).maybeSingle();
        if (thisRequest !== requestId) return;
        if (roleResult.error || roleResult.data?.role !== 'superadmin') {
          setMode('Esta fuente está restringida a superadmin · información oculta.');
          if (list) list.innerHTML = '<p class="management-empty">No se muestran valores sin el rol requerido.</p>';
          return;
        }
      }
      setMode(`Consultando ${active.label.toLowerCase()}…`);
      let result;
      let partialFailures = 0;
      if (active.rpc) {
        result = await db.rpc(active.rpc);
      } else if (active.tables) {
        const results = await Promise.all(active.tables.map((table) => readAll(table)));
        partialFailures = results.filter((item) => item.error).length;
        const available = results.flatMap((item, index) => item.error ? [] : (item.data || []).map((row) => ({ ...row, _table: active.tables[index] })));
        const firstError = results.find((item) => item.error)?.error || null;
        result = partialFailures === results.length
          ? { data: null, error: firstError }
          : { data: available, error: null };
      } else {
        result = await readAll(active.table, active.order);
      }
      if (thisRequest !== requestId) return;
      if (result.error) {
        setMode('No se pudo verificar esta fuente · información oculta.');
        if (list) list.innerHTML = '<p class="management-empty">La consulta falló. No se completó ningún valor.</p>';
        return;
      }
      const sourceRows = (result.data || []).filter((row) => row.archived !== true && row.es_prueba !== true && row.is_test !== true);
      rows = active.filterRows ? active.filterRows(sourceRows) : sourceRows;
      verified = true;
      const states = [...new Set(rows.map((row) => active.state ? active.state(row) : status(row)).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'es'));
      if (filter instanceof HTMLSelectElement) filter.innerHTML = '<option value="">Todos los estados</option>' + states.map((state) => `<option>${esc(state)}</option>`).join('');
      setMode(`Datos reales · ${session.user.email || 'sesión activa'}${partialFailures ? ` · ${partialFailures} fuente${partialFailures === 1 ? '' : 's'} no disponible${partialFailures === 1 ? '' : 's'}` : ''}`);
      render();
    }

    updateTabs();
    load();
  }
</script>

