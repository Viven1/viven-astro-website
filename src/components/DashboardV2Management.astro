          detail: (r) => genericDetails(r, [['Anfitrión', 'host_name'], ['Rol', 'host_role'], ['Email', 'email'], ['Activa', 'active'], ['Desde', 'work_start', minutesAsTime], ['Hasta', 'work_end', minutesAsTime], ['Días disponibles', 'days'], ['Duraciones', 'durations'], ['Aviso mínimo', 'notice_hours', (v) => v === null || v === undefined ? '—' : `${v} horas`], ['Buffer', 'buffer_min', (v) => v === null || v === undefined ? '—' : `${v} min`], ['Horizonte', 'horizon_days', (v) => v === null || v === undefined ? '—' : `${v} días`]]),
          attention: () => false, href: (r) => !r.email || String(r.email).toLowerCase() === currentUserEmail ? origin('sistema', 'booking') : '', copy: 'Disponibilidad y reglas de reserva por anfitrión.',
        },
        {
          key: 'tests', label: 'A/B tests', icon: 'A/B', table: 'ab_tests', source: 'A/B test',
          title: (r) => r.name || 'Test sin nombre', sub: (r) => text(r.url_path),
          labels: ['Test', 'Página', 'Estado', 'Hasta'],
          cells: (r) => [r.name || 'Test sin nombre', text(r.url_path), status(r), date(r.end_at)],
          detail: (r) => genericDetails(r, [['Nombre', 'name'], ['Página', 'url_path'], ['Estado', 'status'], ['Split B', 'split_pct', (v) => v === null || v === undefined ? '—' : `${v}%`], ['Cambios', 'changes'], ['Desde', 'start_at', date], ['Hasta', 'end_at', date], ['Notas', 'notes'], ['Creado', 'created_at', date]]),
          attention: (r) => ['failed', 'error'].includes(String(r.status || '').toLowerCase()), href: origin('sistema', 'ab'), copy: 'Experimentos configurados sobre páginas públicas.',
        },
        {
          key: 'team', label: 'Equipo', icon: '◉', table: 'team_profiles', source: 'Perfil',
          title: (r) => r.name || r.email || 'Perfil sin nombre', sub: (r) => text(r.role),
          labels: ['Persona', 'Rol', 'Booking', 'Actualizado'],
          cells: (r) => [r.name || r.email || 'Perfil sin nombre', text(r.role), r.book_visible === true ? 'Visible' : r.book_visible === false ? 'No visible' : '—', date(timestamp(r))],
          detail: (r) => genericDetails(r, [['Nombre', 'name'], ['Email', 'email'], ['Rol', 'role'], ['Teléfono', 'phone'], ['Booking visible', 'book_visible'], ['Costo por hora', 'costo_hora', money], ['Actualizado', 'updated_at', date]]),
          attention: (r) => !r.name || !r.email, href: (r) => String(r.email || '').toLowerCase() === currentUserEmail ? origin('sistema', 'profile') : '', copy: 'Perfiles que operan y firman desde el dashboard.',
        },
