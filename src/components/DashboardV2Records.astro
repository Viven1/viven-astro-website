---
const { section } = Astro.props;
const labels = {
  proyectos: ['Proyectos','Producción, fechas, estado y entregas'],
  personas: ['Personas','Contactos, conversaciones y próximos pasos'],
  empresas: ['Empresas','Cuentas, personas y oportunidades relacionadas'],
  tecnicos: ['Técnicos','Contactos externos, roles, tarifas y disponibilidad'],
};
const [title, subtitle] = labels[section];
---
<section class="records" data-records-root data-section={section}>
  <div class="records-head"><div><h2>{title}</h2><p data-records-mode>Cargando datos reales…</p></div><div class="records-actions"><label class="records-search">⌕ <input data-records-search placeholder={`Buscar en ${title.toLowerCase()}…`} /></label><select data-records-filter><option value="">Todos</option></select></div></div>
  <div class="records-summary"><div><small>Total</small><strong data-records-total>—</strong></div><div><small data-summary-label>Requieren atención</small><strong data-records-attention>—</strong></div><div><small>Actualizados este mes</small><strong data-records-month>—</strong></div></div>
  <div class="records-table"><div class="records-row records-labels" data-records-labels></div><div data-records-list><p class="records-empty">Esperando datos reales</p></div></div>
  <div class="records-drawer" data-records-drawer hidden><div class="records-back"></div><article class="records-sheet"><button class="records-x" type="button">×</button><h2 data-detail-title>Detalle</h2><p data-detail-sub></p><div data-detail-body></div><div class="records-foot"><a class="btn primary" data-detail-origin href="/dashboard/">Abrir registro original</a></div></article></div>
</section>
<script>
import { createClient } from '@supabase/supabase-js';
const root=document.querySelector('[data-records-root]');
if(root){
  const db=createClient('https://lumoevaotokgqnpybkyf.supabase.co','sb_publishable_ORGL5_FNZTXcGKwvjs-ymw_Y8DV_4ca'),section=root.dataset.section,demo=new URLSearchParams(location.search).get('demo')==='1',q=s=>root.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),lang=v=>({de:'Alemán',en:'Inglés',es:'Español'}[String(v||'').toLowerCase()]||'Sin definir');
  let rows=[],filtered=[];
  const cfg={
    proyectos:{table:'projects',labels:['Proyecto','Etapa','Rodaje','Entrega'],status:x=>x.stage||'Sin etapa',attention:x=>(x.delivery_due&&Date.parse(x.delivery_due)<Date.now()&&String(x.stage).toLowerCase()!=='entregado')||(!x.shoot_start&&x.started_at&&Date.now()-Date.parse(x.started_at)>14*864e5),search:x=>[x.title,x.ref,x.stage],origin:x=>'/dashboard/?proyecto='+encodeURIComponent(x.ref||x.id),cells:x=>[`<b>${esc(x.title||'Proyecto sin título')}</b><small>${esc(x.ref||'Sin referencia')}</small>`,esc(x.stage||'—'),esc(x.shoot_start||'—'),esc(x.delivery_due||'—')],detail:x=>[['Referencia',x.ref],['Etapa',x.stage],['Inicio',x.started_at],['Rodaje',x.shoot_start],['Entrega',x.delivery_due],['Estado de factura',x.invoice_status]]},
    personas:{table:'leads',labels:['Persona','Empresa','Estado','Próximo seguimiento'],status:x=>x.status||'Sin estado',attention:x=>!x.next_follow_up_at||Date.parse(x.next_follow_up_at)<Date.now(),search:x=>[x.name,x.email,x.company,x.status],origin:x=>'/dashboard/?lead='+encodeURIComponent(x.id),cells:x=>[`<b>${esc(x.name||x.email||'Contacto sin nombre')}</b><small>${esc(x.email||'Sin email')}</small>`,esc(x.company||'—'),esc(x.status||'—'),esc(x.next_follow_up_at?new Date(x.next_follow_up_at).toLocaleString('es-CH'):'Sin fecha')],detail:x=>[['Email',x.email],['Empresa',x.company],['Estado',x.status],['Idioma',lang(x.lang)],['Teléfono',x.phone],['Próximo seguimiento',x.next_follow_up_at?new Date(x.next_follow_up_at).toLocaleString('es-CH'):'Sin fecha']]},
    empresas:{table:'companies',labels:['Empresa','Dominio','Contactos','Actualizada'],status:()=>'',attention:()=>false,search:x=>[x.name,x.domain],origin:x=>'/dashboard/?tab=companies&company='+encodeURIComponent(x.domain||x.id),cells:x=>[`<b>${esc(x.name||x.domain||'Empresa sin nombre')}</b><small>${esc(x.industry||'')}</small>`,esc(x.domain||'—'),String(x._contacts||0),esc(x.updated_at?new Date(x.updated_at).toLocaleDateString('es-CH'):'—')],detail:x=>[['Dominio',x.domain],['Industria',x.industry],['Web',x.website],['Teléfono',x.phone],['Dirección',x.address],['Contactos vinculados',x._contacts||0]]},
    tecnicos:{table:'crew',labels:['Técnico','Roles','Ciudad','Tarifa día'],status:x=>x.activo===false?'Inactivo':'Activo',attention:x=>!x.email||!(Array.isArray(x.roles)&&x.roles.length),search:x=>[x.name,x.email,x.empresa,x.ciudad,...(x.roles||[])],origin:x=>'/dashboard/?tab=crew&crew='+encodeURIComponent(x.id),cells:x=>[`<b>${esc(x.name||'Técnico sin nombre')}</b><small>${esc(x.email||'Sin email')}</small>`,esc((x.roles||[]).join(', ')||'—'),esc(x.ciudad||'—'),x.tarifa_dia?'CHF '+Number(x.tarifa_dia).toLocaleString('de-CH'):'—'],detail:x=>[['Email',x.email],['Teléfono',x.phone],['Ciudad',x.ciudad],['Idioma',lang(x.idioma||'de')],['Empresa',x.empresa],['Roles',(x.roles||[]).join(', ')],['Tarifa por día',x.tarifa_dia?'CHF '+Number(x.tarifa_dia).toLocaleString('de-CH'):'—'],['Tarifa por hora',x.tarifa_hora?'CHF '+Number(x.tarifa_hora).toLocaleString('de-CH'):'—']]}
  }[section];
  const field=([k,v])=>`<div class="records-field"><small>${esc(k)}</small><b>${esc(v||'—')}</b></div>`;
  function close(){q('[data-records-drawer]').hidden=true}q('.records-x').onclick=q('.records-back').onclick=close;
  function open(id){const x=rows.find(r=>String(r.id||r.domain)===String(id));if(!x)return;q('[data-detail-title]').textContent=x.title||x.name||x.company||x.domain||'Detalle';q('[data-detail-sub]').textContent=section==='proyectos'?'Proyecto y producción':section==='personas'?'Persona y contexto comercial':'Empresa y relaciones';q('[data-detail-body]').innerHTML='<div class="records-fields">'+cfg.detail(x).map(field).join('')+'</div>';q('[data-detail-origin]').href=cfg.origin(x);q('[data-detail-origin]').style.display=demo?'none':'';q('[data-records-drawer]').hidden=false}
  function render(){const term=q('[data-records-search]').value.trim().toLowerCase(),filter=q('[data-records-filter]').value;filtered=rows.filter(x=>(!term||cfg.search(x).some(v=>String(v||'').toLowerCase().includes(term)))&&(!filter||cfg.status(x)===filter));q('[data-records-list]').innerHTML=filtered.length?filtered.map(x=>`<button class="records-row" type="button" data-row-id="${esc(x.id||x.domain)}">${cfg.cells(x).map(c=>`<span>${c}</span>`).join('')}</button>`).join(''):'<p class="records-empty">No hay resultados</p>';q('[data-records-total]').textContent=String(rows.length);q('[data-records-attention]').textContent=String(rows.filter(cfg.attention).length);const m0=new Date(new Date().getFullYear(),new Date().getMonth(),1);q('[data-records-month]').textContent=String(rows.filter(x=>Date.parse(x.updated_at||x.created_at||x.started_at||'')>=m0).length);root.querySelectorAll('[data-row-id]').forEach(b=>b.onclick=()=>open(b.dataset.rowId))}
  q('[data-records-search]').oninput=render;q('[data-records-filter]').onchange=render;q('[data-records-labels]').innerHTML=cfg.labels.map(x=>`<span>${esc(x)}</span>`).join('');
  async function load(){if(demo){q('[data-records-mode]').innerHTML='Vista demo · sin registros ficticios <a class="mode-link" href="/dashboard-v2/'+section+'/">Ver datos reales →</a>';q('[data-records-total]').textContent=q('[data-records-attention]').textContent=q('[data-records-month]').textContent='—';q('[data-records-list]').innerHTML='<p class="records-empty">Los registros reales aparecen aquí.</p>';return}const {data:{session}}=await db.auth.getSession();if(!session){q('[data-records-mode]').innerHTML='Sesión local no iniciada <a class="mode-link" href="/dashboard/">Iniciar sesión →</a>';return}const base=await db.from(cfg.table).select('*').limit(2500);if(base.error){q('[data-records-mode]').textContent='No se pudieron verificar los datos · información oculta';return}rows=(base.data||[]).filter(x=>!x.archived&&!x.es_prueba&&!x.is_template);if(section==='empresas'){const leads=await db.from('leads').select('id,email,company_domain').limit(2500),count={};(leads.data||[]).forEach(l=>{const d=l.company_domain||(l.email||'').split('@')[1];if(d)count[d]=(count[d]||0)+1});rows.forEach(x=>x._contacts=count[x.domain]||0)}const statuses=[...new Set(rows.map(cfg.status).filter(Boolean))].sort();q('[data-records-filter]').innerHTML='<option value="">Todos</option>'+statuses.map(s=>`<option>${esc(s)}</option>`).join('');q('[data-records-mode]').textContent='Datos reales · '+(session.user.email||'sesión activa');render()}load();
}
</script>
