---
// Agenda nativa de Dashboard V2. El componente no recibe ni fabrica datos:
// todas las filas se cargan en el navegador desde la sesión real de Supabase.
---

<section class="agenda-v2" data-agenda-root>
  <div class="agenda-v2__head">
    <div>
      <h2>Agenda</h2>
      <p data-agenda-mode>Cargando reuniones y tareas reales…</p>
    </div>
    <div class="agenda-v2__views" aria-label="Vista de agenda">
      <button class="agenda-v2__view is-active" type="button" data-agenda-view="list" aria-pressed="true">Lista</button>
      <button class="agenda-v2__view" type="button" data-agenda-view="week" aria-pressed="false">Semana</button>
    </div>
  </div>

  <div class="agenda-v2__summary" aria-label="Resumen de agenda">
    <button type="button" data-agenda-shortcut="today"><small>Hoy</small><strong data-agenda-today>—</strong></button>
    <button type="button" data-agenda-shortcut="week"><small>Próximos 7 días</small><strong data-agenda-next>—</strong></button>
    <button type="button" data-agenda-shortcut="overdue"><small>Tareas vencidas</small><strong data-agenda-overdue>—</strong></button>
    <button type="button" data-agenda-shortcut="undated"><small>Sin fecha</small><strong data-agenda-undated>—</strong></button>
  </div>

  <div class="agenda-v2__toolbar">
    <label class="agenda-v2__search">
      <span aria-hidden="true">⌕</span>
      <input type="search" data-agenda-search placeholder="Buscar persona, empresa o tarea…" autocomplete="off" />
    </label>
    <label class="agenda-v2__select"><span>Período</span><select data-agenda-scope>
      <option value="upcoming">Próximos 30 días</option>
      <option value="today">Hoy</option>
      <option value="week">Próximos 7 días</option>
      <option value="overdue">Vencidas</option>
      <option value="undated">Sin fecha</option>
      <option value="all">Todo</option>
    </select></label>
    <label class="agenda-v2__select"><span>Tipo</span><select data-agenda-kind>
      <option value="all">Reuniones y tareas</option>
      <option value="booking">Solo reuniones</option>
      <option value="task">Solo tareas</option>
    </select></label>
    <label class="agenda-v2__select"><span>Responsable</span><select data-agenda-owner><option value="all">Todos</option></select></label>
  </div>

  <div class="agenda-v2__content">
    <div class="agenda-v2__list" data-agenda-list>
      <p class="agenda-v2__empty">Esperando datos reales</p>
    </div>
    <div class="agenda-v2__week" data-agenda-week hidden>
      <div class="agenda-v2__weekbar">
        <button type="button" data-week-prev aria-label="Semana anterior">←</button>
        <strong data-week-title>Semana</strong>
        <button type="button" data-week-next aria-label="Semana siguiente">→</button>
      </div>
      <div class="agenda-v2__weekgrid" data-week-grid></div>
    </div>
  </div>

  <div class="agenda-v2__drawer" data-agenda-drawer hidden>
    <div class="agenda-v2__backdrop" data-agenda-close></div>
    <article class="agenda-v2__sheet" role="dialog" aria-modal="true" aria-labelledby="agenda-v2-detail-title">
      <button class="agenda-v2__close" type="button" data-agenda-close aria-label="Cerrar">×</button>
      <div class="agenda-v2__badge" data-detail-kind>Agenda</div>
      <h2 id="agenda-v2-detail-title" data-detail-title>Detalle</h2>
      <p data-detail-subtitle></p>
      <div class="agenda-v2__fields" data-detail-fields></div>
      <div class="agenda-v2__message" data-detail-message hidden></div>
      <div class="agenda-v2__foot">
        <a class="btn" data-detail-meet href="#" target="_blank" rel="noreferrer" hidden>Entrar a la videollamada ↗</a>
        <a class="btn primary" data-detail-origin href="/dashboard/?tab=agenda">Abrir registro original</a>
      </div>
    </article>
  </div>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const agendaRoot = document.querySelector('[data-agenda-root]');
  if (agendaRoot instanceof HTMLElement) {
    const db = createClient(
      'https://lumoevaotokgqnpybkyf.supabase.co',
      'sb_publishable_ORGL5_FNZTXcGKwvjs-ymw_Y8DV_4ca'
    );
    const demo = new URLSearchParams(location.search).get('demo') === '1';
    const $ = (selector) => agendaRoot.querySelector(selector);
    const $$ = (selector) => [...agendaRoot.querySelectorAll(selector)];
    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[character]));
    const locale = 'es-CH';
    const dayMs = 86400000;
    const startDay = (value = new Date()) => {
      const date = new Date(value);
      date.setHours(0, 0, 0, 0);
      return date;
    };
    const endDay = (value = new Date()) => new Date(startDay(value).getTime() + dayMs);
    const taskHasTime = (task) => /^\d{2}:\d{2}/.test(String(task.due_time || ''));
    const taskDate = (task) => {
      if (!task.due_date) return null;
      // Mediodía evita que una fecha sin hora cambie de día por zona horaria.
      // Es sólo una clave interna de orden: nunca se presenta como hora real.
      const time = taskHasTime(task) ? String(task.due_time).slice(0, 5) : '12:00';
      const date = new Date(`${task.due_date}T${time}:00`);
      return Number.isNaN(date.getTime()) ? null : date;
    };
    const dateTime = (value) => value ? new Date(value).toLocaleString(locale, {
      weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit'
    }) : 'Sin fecha';
    const dateOnly = (value) => value ? new Date(value).toLocaleDateString(locale, {
      weekday: 'short', day: '2-digit', month: 'short', year: 'numeric'
    }) : 'Sin fecha';
    const shortDay = (value) => new Date(value).toLocaleDateString(locale, { weekday: 'short', day: '2-digit', month: 'short' });
    const language = (value) => ({ de: 'Alemán', en: 'Inglés', es: 'Español' }[String(value || '').toLowerCase()] || 'Sin definir');
    const cleanOwner = (value) => String(value || '').trim().toLowerCase();

    let items = [];
    let filteredItems = [];
    let currentView = 'list';
    let detailTrigger = null;
    let weekStart = startDay();
    weekStart.setDate(weekStart.getDate() - ((weekStart.getDay() + 6) % 7));

    const setVerifiedValues = (values) => {
      $('[data-agenda-today]').textContent = values ? String(values.today) : '—';
      $('[data-agenda-next]').textContent = values ? String(values.next) : '—';
      $('[data-agenda-overdue]').textContent = values ? String(values.overdue) : '—';
      $('[data-agenda-undated]').textContent = values ? String(values.undated) : '—';
    };

    const leadTitle = (lead, fallback = '') => lead?.name || lead?.company || lead?.email || fallback || 'Contacto sin nombre';
    const normalize = (bookings, tasks, leads) => {
      const leadMap = new Map(leads.map((lead) => [String(lead.id), lead]));
      const bookingRows = bookings
        .filter((booking) => String(booking.status || 'confirmed').toLowerCase() !== 'canceled')
        .map((booking) => {
          const lead = leadMap.get(String(booking.lead_id)) || null;
          const at = booking.start_at ? new Date(booking.start_at) : null;
          return {
            key: `booking:${booking.id}`, kind: 'booking', id: booking.id, leadId: booking.lead_id,
            title: `Videollamada · ${booking.name || leadTitle(lead, booking.email)}`,
            subtitle: booking.email || lead?.email || '', company: lead?.company || '', owner: booking.host_email || '',
            at: at && !Number.isNaN(at.getTime()) ? at : null, end: booking.end_at ? new Date(booking.end_at) : null,
            status: booking.status || 'confirmed', done: false, noDate: !at, hasTime: true, source: booking, lead
          };
        });
      const taskRows = tasks.map((task) => {
        const lead = leadMap.get(String(task.lead_id)) || null;
        const at = taskDate(task);
        return {
          key: `task:${task.id}`, kind: 'task', id: task.id, leadId: task.lead_id,
          title: task.title || 'Tarea sin título', subtitle: leadTitle(lead), company: lead?.company || '',
          owner: task.assignee || '', at, end: null, status: task.done ? 'done' : 'open', done: Boolean(task.done),
          noDate: !task.due_date, hasTime: taskHasTime(task), source: task, lead
        };
      });
      return [...bookingRows, ...taskRows].sort((a, b) => {
        if (!a.at && !b.at) return String(a.title).localeCompare(String(b.title));
        if (!a.at) return 1;
        if (!b.at) return -1;
        return a.at.getTime() - b.at.getTime();
      });
    };

    const isOverdue = (item) => {
      if (item.kind !== 'task' || item.done || !item.at) return false;
      return item.source.due_time ? item.at.getTime() < Date.now() : item.at < startDay();
    };
    const isToday = (item) => item.at && item.at >= startDay() && item.at < endDay();
    const isNext = (item, days) => item.at && item.at >= startDay() && item.at < new Date(startDay().getTime() + days * dayMs);

    const kindLabel = (item) => item.kind === 'booking' ? 'Videollamada' : 'Tarea';
    const stateLabel = (item) => {
      if (item.kind === 'booking') return 'Confirmada';
      if (item.done) return 'Completada';
      if (isOverdue(item)) return 'Vencida';
      return 'Pendiente';
    };
    const originalHref = (item) => item.kind === 'booking'
      ? '/dashboard/?tab=agenda'
      : `/dashboard/?lead=${encodeURIComponent(item.leadId || '')}`;

    function rowHtml(item) {
      const time = item.at
        ? (item.kind === 'task' && !item.hasTime ? 'Sin hora' : item.at.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' }))
        : '—';
      return `<button class="agenda-v2__row ${isOverdue(item) ? 'is-overdue' : ''} ${item.done ? 'is-done' : ''}" type="button" data-agenda-item="${esc(item.key)}">
        <span class="agenda-v2__date"><b>${esc(item.noDate ? 'Sin fecha' : shortDay(item.at))}</b><small>${esc(item.noDate ? 'Pendiente de agendar' : time)}</small></span>
        <span class="agenda-v2__rowmain"><i class="agenda-v2__kind agenda-v2__kind--${item.kind}">${item.kind === 'booking' ? '●' : '✓'}</i><span><b>${esc(item.title)}</b><small>${esc([item.subtitle, item.company].filter(Boolean).join(' · '))}</small></span></span>
        <span class="agenda-v2__owner">${esc(item.owner || 'Sin asignar')}</span>
        <span class="agenda-v2__status agenda-v2__status--${isOverdue(item) ? 'late' : item.done ? 'done' : item.kind}">${esc(stateLabel(item))}</span>
        <span class="agenda-v2__arrow">›</span>
      </button>`;
    }

    function matchesSharedFilters(item) {
      const term = $('[data-agenda-search]').value.trim().toLowerCase();
      const kind = $('[data-agenda-kind]').value;
      const owner = $('[data-agenda-owner]').value;
      const haystack = [item.title, item.subtitle, item.company, item.owner].join(' ').toLowerCase();
      return (!term || haystack.includes(term))
        && (kind === 'all' || item.kind === kind)
        && (owner === 'all' || cleanOwner(item.owner) === owner);
    }

    function applyFilters() {
      const scope = $('[data-agenda-scope]').value;
      const monthEnd = new Date(startDay().getTime() + 30 * dayMs);
      filteredItems = items.filter((item) => {
        const scopeMatch = scope === 'all'
          || (scope === 'today' && isToday(item))
          || (scope === 'week' && isNext(item, 7))
          || (scope === 'upcoming' && item.at && item.at >= startDay() && item.at < monthEnd && !item.done)
          || (scope === 'overdue' && isOverdue(item))
          || (scope === 'undated' && item.noDate && !item.done);
        return matchesSharedFilters(item) && scopeMatch;
      });
      renderList();
      renderWeek();
    }

    function renderList() {
      const list = $('[data-agenda-list]');
      if (!filteredItems.length) {
        list.innerHTML = '<p class="agenda-v2__empty">No hay resultados con estos filtros.</p>';
        return;
      }
      const groups = [];
      filteredItems.forEach((item) => {
        const key = item.noDate ? 'Sin fecha' : item.at.toISOString().slice(0, 10);
        let group = groups.find((entry) => entry.key === key);
        if (!group) { group = { key, items: [] }; groups.push(group); }
        group.items.push(item);
      });
      list.innerHTML = groups.map((group) => `<section class="agenda-v2__group"><h3>${esc(group.key === 'Sin fecha' ? group.key : new Date(`${group.key}T12:00:00`).toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' }))}</h3>${group.items.map(rowHtml).join('')}</section>`).join('');
      bindItems();
    }

    function renderWeek() {
      const end = new Date(weekStart.getTime() + 7 * dayMs);
      // La grilla semanal tiene su propio período: conserva búsqueda, tipo y
      // responsable, pero nunca queda recortada por el período de la lista.
      const weekItems = items.filter(matchesSharedFilters);
      $('[data-week-title]').textContent = `${weekStart.toLocaleDateString(locale, { day: 'numeric', month: 'short' })} — ${new Date(end.getTime() - dayMs).toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' })}`;
      $('[data-week-grid]').innerHTML = Array.from({ length: 7 }, (_, index) => {
        const day = new Date(weekStart.getTime() + index * dayMs);
        const nextDay = new Date(day.getTime() + dayMs);
        const dayItems = weekItems.filter((item) => item.at && item.at >= day && item.at < nextDay);
        return `<section class="agenda-v2__day ${isToday({ at: day }) ? 'is-today' : ''}"><h3><span>${esc(day.toLocaleDateString(locale, { weekday: 'short' }))}</span><b>${day.getDate()}</b></h3><div>${dayItems.length ? dayItems.map((item) => `<button type="button" class="agenda-v2__weekitem agenda-v2__weekitem--${item.kind}" data-agenda-item="${esc(item.key)}"><time>${esc(item.kind === 'task' && !item.hasTime ? 'Sin hora' : item.at.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' }))}</time><b>${esc(item.title)}</b><small>${esc(item.subtitle)}</small></button>`).join('') : '<p>Sin compromisos</p>'}</div></section>`;
      }).join('');
      bindItems();
    }

    function openDetail(key, trigger = null) {
      const item = items.find((entry) => entry.key === key);
      if (!item) return;
      detailTrigger = trigger instanceof HTMLElement ? trigger : document.activeElement;
      $('[data-detail-kind]').textContent = kindLabel(item);
      $('[data-detail-kind]').className = `agenda-v2__badge agenda-v2__badge--${item.kind}`;
      $('[data-detail-title]').textContent = item.title;
      $('[data-detail-subtitle]').textContent = [item.subtitle, item.company].filter(Boolean).join(' · ');
      const fields = item.kind === 'booking'
        ? [
            ['Inicio', dateTime(item.source.start_at)], ['Fin', dateTime(item.source.end_at)],
            ['Responsable', item.owner || 'Sin asignar'], ['Estado', stateLabel(item)],
            ['Duración', item.source.duration_m ? `${item.source.duration_m} minutos` : '—'], ['Idioma', language(item.source.lang)],
            ['Email', item.source.email], ['Teléfono', item.source.phone]
          ]
        : [
            ['Vencimiento', item.at ? (item.hasTime ? dateTime(item.at) : `${dateOnly(item.at)} · Sin hora`) : 'Sin fecha'], ['Responsable', item.owner || 'Sin asignar'],
            ['Estado', stateLabel(item)], ['Contacto', item.subtitle],
            ['Empresa', item.company], ['Completada', item.source.done_at ? dateTime(item.source.done_at) : '—']
          ];
      $('[data-detail-fields]').innerHTML = fields.map(([label, value]) => `<div><small>${esc(label)}</small><b>${esc(value || '—')}</b></div>`).join('');
      const message = String(item.source.message || '').trim();
      $('[data-detail-message]').hidden = !message;
      $('[data-detail-message]').innerHTML = message ? `<small>Mensaje del contacto</small><p>${esc(message)}</p>` : '';
      const meet = $('[data-detail-meet]');
      meet.hidden = !(item.kind === 'booking' && item.source.meet_url && !demo);
      if (!meet.hidden) meet.href = item.source.meet_url;
      const origin = $('[data-detail-origin]');
      origin.hidden = demo;
      origin.href = originalHref(item);
      $('[data-agenda-drawer]').hidden = false;
      document.body.classList.add('agenda-v2-open');
      requestAnimationFrame(() => $('.agenda-v2__close')?.focus());
    }

    function closeDetail() {
      $('[data-agenda-drawer]').hidden = true;
      document.body.classList.remove('agenda-v2-open');
      if (detailTrigger instanceof HTMLElement && detailTrigger.isConnected) detailTrigger.focus();
      detailTrigger = null;
    }
    function bindItems() {
      $$('[data-agenda-item]').forEach((button) => { button.onclick = () => openDetail(button.dataset.agendaItem, button); });
    }

    $$('[data-agenda-close]').forEach((button) => { button.onclick = closeDetail; });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !$('[data-agenda-drawer]').hidden) closeDetail(); });
    ['[data-agenda-search]', '[data-agenda-scope]', '[data-agenda-kind]', '[data-agenda-owner]'].forEach((selector) => {
      $(selector).addEventListener(selector.includes('search') ? 'input' : 'change', applyFilters);
    });
    $$('[data-agenda-shortcut]').forEach((button) => {
      button.onclick = () => { $('[data-agenda-scope]').value = button.dataset.agendaShortcut; currentView = 'list'; selectView(); applyFilters(); };
    });
    $$('[data-agenda-view]').forEach((button) => {
      button.onclick = () => { currentView = button.dataset.agendaView; selectView(); };
    });
    function selectView() {
      $$('[data-agenda-view]').forEach((button) => {
        const active = button.dataset.agendaView === currentView;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      $('[data-agenda-list]').hidden = currentView !== 'list';
      $('[data-agenda-week]').hidden = currentView !== 'week';
      $('[data-agenda-scope]').disabled = demo || currentView === 'week';
    }
    $('[data-week-prev]').onclick = () => { weekStart = new Date(weekStart.getTime() - 7 * dayMs); renderWeek(); };
    $('[data-week-next]').onclick = () => { weekStart = new Date(weekStart.getTime() + 7 * dayMs); renderWeek(); };

    function showUnavailable(message) {
      setVerifiedValues(null);
      $('[data-agenda-mode]').textContent = message;
      $('[data-agenda-list]').innerHTML = '<p class="agenda-v2__empty">La agenda queda oculta hasta verificar los datos reales.</p>';
      $('[data-week-grid]').innerHTML = '<p class="agenda-v2__empty">Sin datos verificados</p>';
    }

    async function fetchPaged(table, columns, configure) {
      const rows = [];
      const pageSize = 1000;
      const maxRows = 20000;
      const page = (from, to) => {
        let query = db.from(table).select(columns);
        query = configure(query);
        return query.range(from, to);
      };
      for (let start = 0; start < maxRows; start += pageSize) {
        const result = await page(start, start + pageSize - 1);
        if (result.error) return { data: [], error: result.error };
        rows.push(...(result.data || []));
        if (!result.data || result.data.length < pageSize) return { data: rows, error: null };
      }
      // No se publican totales parciales: una fila adicional invalida la fuente.
      const probe = await page(maxRows, maxRows);
      if (probe.error) return { data: [], error: probe.error };
      if (probe.data?.length) return { data: [], error: new Error(`${table} supera ${maxRows.toLocaleString('de-CH')} registros`) };
      return { data: rows, error: null };
    }

    async function loadAgenda() {
      if (demo) {
        setVerifiedValues(null);
        $('[data-agenda-mode]').innerHTML = 'Vista demo · sin reuniones, tareas ni contadores ficticios <a class="mode-link" href="/dashboard-v2/agenda/">Ver datos reales →</a>';
        $('[data-agenda-list]').innerHTML = '<p class="agenda-v2__empty">Las reuniones y tareas reales aparecen aquí.</p>';
        $('[data-week-grid]').innerHTML = '<p class="agenda-v2__empty">La semana real aparece al iniciar sesión.</p>';
        $$('input, select').forEach((control) => { control.disabled = true; });
        return;
      }
      const { data: { session }, error: sessionError } = await db.auth.getSession();
      if (sessionError) { showUnavailable('No se pudo verificar la sesión · información oculta'); return; }
      if (!session) {
        showUnavailable('Sesión local no iniciada');
        $('[data-agenda-mode]').innerHTML = 'Sesión local no iniciada <a class="mode-link" href="/dashboard/">Iniciar sesión →</a>';
        return;
      }
      const [bookingResult, taskResult, leadResult] = await Promise.all([
        fetchPaged('bookings', '*', (query) => query.order('start_at', { ascending: true }).order('id', { ascending: true })),
        fetchPaged('lead_tasks', '*', (query) => query.order('due_date', { ascending: true, nullsFirst: false }).order('id', { ascending: true })),
        fetchPaged('leads', 'id,name,email,company', (query) => query.order('id', { ascending: true }))
      ]);
      if (bookingResult.error || taskResult.error || leadResult.error) {
        showUnavailable('No se pudieron verificar reuniones y tareas · información oculta');
        return;
      }
      items = normalize(bookingResult.data || [], taskResult.data || [], leadResult.data || []);
      const owners = [...new Set(items.map((item) => item.owner).filter(Boolean))].sort((a, b) => a.localeCompare(b));
      $('[data-agenda-owner]').innerHTML = '<option value="all">Todos</option>' + owners.map((owner) => `<option value="${esc(cleanOwner(owner))}">${esc(owner)}</option>`).join('');
      setVerifiedValues({
        today: items.filter((item) => isToday(item) && !item.done).length,
        next: items.filter((item) => isNext(item, 7) && !item.done).length,
        overdue: items.filter(isOverdue).length,
        undated: items.filter((item) => item.kind === 'task' && item.noDate && !item.done).length
      });
      $('[data-agenda-mode]').textContent = `Datos reales · ${session.user.email || 'sesión activa'}`;
      applyFilters();
    }

    loadAgenda();
  }
</script>

<style is:global>
  body.agenda-v2-open{overflow:hidden}
  .agenda-v2{height:100%;overflow:auto;padding:24px;background:radial-gradient(circle at 60% -30%,#12334f 0,transparent 38%),var(--bg,#061526);color:var(--text,#f6f8fb)}
  .agenda-v2__head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:18px}.agenda-v2__head h2{font-size:30px;line-height:1.1;margin:0}.agenda-v2__head p{color:var(--muted,#96a9bc);margin:5px 0 0}.agenda-v2__views{display:flex;gap:6px;border:1px solid var(--line,#263c52);border-radius:10px;padding:4px;background:#081b2e}.agenda-v2__view{border:0;border-radius:7px;background:transparent;color:var(--muted,#96a9bc);padding:8px 14px;cursor:pointer}.agenda-v2__view.is-active{background:var(--lime,#d9fb35);color:#071526;font-weight:750}
