---
/* /abrir/?lead=274 — puente entre el email y la app.
 *
 * Por qué existe (13 ago 2026): el email del lead nuevo llevaba el enlace
 * `viven://lead/274` directo, y Sebastián lee el correo en Gmail. Gmail borra
 * todo href que no sea http(s)/mailto: el enlace a la app le llegaba muerto.
 *
 * Un enlace https sí sobrevive. Esta página es ese enlace: entra, intenta
 * abrir la app, y si la app no está (el iPhone de otro, la máquina de un
 * cliente, un navegador cualquiera) deja el botón para seguir en el navegador.
 * Nunca es un callejón sin salida.
 *
 * El id se limpia acá y se vuelve a limpiar en la app: el destino se arma
 * siempre con nuestro propio dominio, nunca con lo que venga en la URL.
 */
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Abriendo la ficha… — Viven</title>
<meta name="robots" content="noindex,nofollow" />
<meta name="theme-color" content="#0f1826" />
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%23142033%22/%3E%3Ctext%20x%3D%2232%22%20y%3D%2247%22%20font-family%3D%22Arial%2CHelvetica%2Csans-serif%22%20font-size%3D%2244%22%20font-weight%3D%22700%22%20fill%3D%22%23ddf98f%22%20text-anchor%3D%22middle%22%3Ev%3C/text%3E%3C/svg%3E" />
<style>
  :root { color-scheme: dark; }
  body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
         background:#0f1826; color:#eef2f8; font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; padding:24px; }
  .caja { max-width:420px; width:100%; text-align:center; }
  h1 { font-size:20px; margin:0 0 8px; font-weight:600; }
  p  { color:#93a2b8; margin:0 0 24px; font-size:14.5px; }
  a.btn { display:block; padding:13px 18px; border-radius:10px; text-decoration:none; font-weight:600; margin-top:10px; }
  .p { background:#ddf98f; color:#0f1826; }
  .s { background:#1b2740; color:#eef2f8; font-weight:500; }
  #tarde { display:none; }
</style>
</head>
<body>
<div class="caja">
  <h1 id="tit">Abriendo la ficha en la app…</h1>
  <p id="sub">Si no pasa nada en un segundo, la app no está instalada en este dispositivo.</p>
  <a class="btn p" id="app" href="#">Abrir en la app</a>
  <a class="btn s" id="web" href="/dashboard/">Seguir en el navegador</a>
</div>
<script is:inline>
  (function () {
    // solo dígitos: el id viene de un email, no se confía en el texto
    var m = /[?&]lead=(\d{1,12})(&|$)/.exec(location.search);
    var id = m ? m[1] : '';
    var app = 'viven://lead/' + id;
    var web = '/dashboard/' + (id ? '?lead=' + id : '');
    document.getElementById('app').href = app;
    document.getElementById('web').href = web;

    // intento automático: si la app está, el sistema se lleva el foco y esta
    // pestaña lo pierde. Se mira el CAMBIO de foco, no document.hidden a secas:
    // una pestaña que nació en segundo plano ya está oculta y diría "se abrió"
    // cuando no se abrió nada (pasó en la prueba).
    var seFue = false;
    addEventListener('blur', function () { seFue = true; });
    addEventListener('pagehide', function () { seFue = true; });
    document.addEventListener('visibilitychange', function () { if (document.hidden) seFue = true; });

    try { location.href = app; } catch (e) {}
    setTimeout(function () {
      if (seFue) return;                       // la app se lo llevó: no tocamos nada
      document.getElementById('tit').textContent = 'No pude abrir la app';
      document.getElementById('sub').textContent = 'Puede que no esté instalada en este dispositivo. Podés seguir en el navegador.';
    }, 1500);
  })();
</script>
</body>
</html>
