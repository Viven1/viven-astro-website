---
// Portal del cliente — estado del proyecto, el corte, comentarios con timecode,
// descargas y aprobación. Sin pelotear por email.
//
// Acceso: /portal/?id=<deal_id>&t=<portal_token>. Mirar y comentar alcanza con el
// link; DESCARGAR y APROBAR piden un código de 6 dígitos que se manda al email de la
// ficha del contacto (decisión de Sebastián, 26 ago 2026).
//
// Un solo idioma: el de la persona. "No hacen falta tres idiomas, solo el idioma del
// cliente que tenemos en su persona."
const SB_URL = 'https://lumoevaotokgqnpybkyf.supabase.co';
const SB_KEY = 'sb_publishable_ORGL5_FNZTXcGKwvjs-ymw_Y8DV_4ca';
import VivenLogoSymbol from '../../components/VivenLogoSymbol.astro';
import { BRIEF, BRIEF_T, BRIEF_SECCIONES } from '../../data/project-brief-i18n.js';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Project status — Viven</title>
<meta name="robots" content="noindex,nofollow" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#0f1826" />
<link rel="stylesheet" href="/assets/site.css" />
<!-- is:global y no `<style>` a secas: Astro SCOPEA los estilos agregando
     [data-astro-cid-…] a cada selector, y todo el HTML de esta página lo arma el JS en
     runtime — esos nodos no llevan el atributo, así que ninguna regla les pegaba. El
     portal estuvo sin estilos desde el día uno y nadie lo notó porque nadie lo abrió. -->
<style is:global>
  body{background:#0f1826}
  .pt-wrap{max-width:760px;margin:0 auto;padding:40px 20px 90px}
  /* ── Project brief ── mismo lenguaje visual que el resto del portal, pero se lee
     como un formulario y no como un panel: el que entra a contestarlo viene a escribir. */
  .pt-brief{border:1px solid var(--line-strong,#2c3d5c);border-radius:14px;background:rgba(255,255,255,.02);
    padding:18px 20px;margin:0 0 22px}
  .pt-brief.hecho{padding:14px 20px}
  .pt-brief .bh{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-size:15px}
  .pt-brief .bprog{flex:1;min-width:90px;max-width:220px;height:6px;border-radius:99px;background:rgba(255,255,255,.1);overflow:hidden}
  .pt-brief .bprog>span{display:block;height:100%;background:var(--acid,#ddf98f);transition:width .25s}
  .pt-brief .bn{font-size:12.5px;color:var(--muted,#9aa6bd);font-variant-numeric:tabular-nums}
  .pt-brief .bok{color:var(--acid,#ddf98f);font-size:13.5px}
  .pt-brief .bsub{color:var(--muted,#9aa6bd);font-size:13px;margin:8px 0 4px;line-height:1.5}
  .binv{background:none;border:1px solid var(--line-strong,#2c3d5c);color:var(--muted,#9aa6bd);
    border-radius:99px;font:600 12px inherit;padding:6px 13px;cursor:pointer;margin-left:auto}
  .binv:hover{color:#fff;border-color:#fff}
  .binv-box{border:1px solid var(--line-strong,#2c3d5c);border-radius:11px;padding:14px 16px;margin:12px 0 0}
  .binv-box b{font-size:14px}
  .binv-box p{color:var(--muted,#9aa6bd);font-size:12.5px;margin:4px 0 10px;line-height:1.5}
  .binv-box input{width:min(320px,100%);padding:9px 12px;border-radius:9px;border:1px solid var(--line-strong,#2c3d5c);
    background:rgba(0,0,0,.25);color:inherit;font:inherit;font-size:14px;margin-right:8px}
  .binv-msg{font-size:12.5px;color:var(--acid,#ddf98f);margin-top:8px}
  .bsec{margin:20px 0 0}
  .bsec-h{font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted,#9aa6bd);
    margin:0 0 4px;padding-bottom:7px;border-bottom:1px solid var(--line,#223049)}
  .bq{padding:15px 0;border-bottom:1px solid rgba(255,255,255,.05)}
  .bq:last-child{border-bottom:0}
  .bqt{font-size:15px;font-weight:600;line-height:1.4}
  .breq{color:var(--acid,#ddf98f);font-style:normal;font-weight:900;margin-left:5px}
  .bqh{font-size:12.5px;color:var(--muted-2,#6b7896);margin:3px 0 9px;line-height:1.5}
  .bchips{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 9px}
  .bchip{appearance:none;font:inherit;font-size:13px;cursor:pointer;padding:7px 13px;border-radius:999px;
    border:1px solid var(--line-strong,#2c3d5c);background:transparent;color:var(--muted,#9aa6bd);min-height:38px}
  .bchip:hover{border-color:#fff;color:#fff}
  .bchip.on{border-color:var(--acid,#ddf98f);background:rgba(221,249,143,.14);color:var(--acid,#ddf98f);font-weight:600}
  .blibre{width:100%;border:1px dashed var(--line-strong,#2c3d5c);border-radius:9px;padding:10px 12px;
    background:rgba(0,0,0,.2);color:inherit;font:inherit;font-size:14.5px;line-height:1.55;resize:vertical}
  .blibre:focus{outline:none;border-style:solid;border-color:var(--acid,#ddf98f)}
  .bq.ok .blibre{border-style:solid;border-color:var(--line,#223049)}
  .bsug{font-size:12.5px;color:var(--muted-2,#6b7896);margin-top:7px;line-height:1.5}
  .bsug span{color:var(--muted,#9aa6bd)}
  .busar{background:none;border:0;color:var(--acid,#ddf98f);font:600 12.5px inherit;cursor:pointer;text-decoration:underline;padding:0 2px}
  .bnav{display:flex;align-items:center;gap:12px;margin-top:20px;padding-top:16px;border-top:1px solid var(--line,#223049)}
  .bnav .sp{flex:1}
  .bbtn{background:var(--acid,#ddf98f);color:#1c2508;border:0;border-radius:99px;font:700 14px inherit;
    padding:11px 22px;cursor:pointer}
  .bbtn.g{background:transparent;color:var(--muted,#9aa6bd);border:1px solid var(--line-strong,#2c3d5c)}
  .bbtn:disabled{opacity:.5;cursor:default}
  .bdots{display:flex;gap:6px;flex:1;justify-content:center}
  .bdots i{width:7px;height:7px;border-radius:99px;background:rgba(255,255,255,.18)}
  .bdots i.on{background:var(--acid,#ddf98f);width:20px}
  @media(max-width:560px){ .bnav{flex-wrap:wrap} .bbtn{flex:1} }
  .pt-equipo{background:#f0c06018;border:1px solid #f0c060;border-radius:10px;padding:10px 13px;
    font-size:13px;color:#f0c060;margin:0 0 18px;line-height:1.5}
  .pt-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:24px}
  .pt-card{border:1px solid var(--line);border-radius:20px;background:var(--navy-800);padding:28px}
  .pt-card h1{font-size:clamp(20px,4vw,26px);line-height:1.2;margin:0 0 4px}
  .pt-sub{font-size:13.5px;color:var(--muted);margin:0 0 22px}

  .pt-steps{display:flex;align-items:flex-start;gap:0;margin-bottom:24px;flex-wrap:wrap}
  .pt-step{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--muted-2)}
  .pt-step .dot{width:22px;height:22px;border-radius:50%;border:2px solid var(--line-strong);display:flex;
    align-items:center;justify-content:center;font-size:10px;font-weight:700;flex:none}
  .pt-step.done .dot{background:var(--acid);border-color:var(--acid);color:#142033}
  .pt-step.done{color:var(--muted)}
  .pt-step.current .dot{border-color:var(--acid);color:var(--acid)}
  .pt-step.current{color:var(--acid);font-weight:700}
  .pt-sep{flex:1;height:2px;background:var(--line);margin:0 7px;min-width:10px}

  .pt-note{border:1px solid var(--line);border-left:3px solid var(--acid);border-radius:12px;
    background:var(--navy-900);padding:12px 15px;font-size:14px;color:var(--muted);margin-bottom:20px}

  .pt-vid{position:relative;border-radius:14px;overflow:hidden;border:1px solid var(--line);background:#000;aspect-ratio:16/9}
  .pt-vid iframe{width:100%;height:100%;border:0;display:block}
  .pt-vers{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0 0}
  .pt-vers button{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:999px;
    color:var(--muted);font:600 12px inherit;padding:6px 13px;cursor:pointer}
  .pt-vers button.on{border-color:var(--acid);color:var(--acid);background:rgba(221,249,143,.08)}
  .pt-vers button small{font-weight:400;opacity:.7}

  .pt-cbox{background:var(--navy-900);border:1px solid var(--line);border-radius:13px;padding:13px 15px;margin-top:18px}
  .pt-tc{display:inline-flex;align-items:center;gap:6px;background:var(--navy-800);border:1px solid var(--line);
    border-radius:7px;padding:3px 10px;font-size:11.5px;color:#f0c060;font-variant-numeric:tabular-nums;margin-bottom:9px}
  .pt-cbox textarea{width:100%;background:var(--navy-800);border:1px solid var(--line-strong);border-radius:10px;
    color:var(--text);font:inherit;font-size:14px;padding:10px 12px;min-height:62px;resize:vertical}
  .pt-row{display:flex;gap:9px;align-items:center;margin-top:9px;flex-wrap:wrap}

  .pt-coms{margin-top:16px;display:grid;gap:8px}
  .pt-com{background:var(--navy-900);border:1px solid var(--line);border-radius:12px;padding:11px 14px}
  .pt-com.mio{border-left:3px solid var(--acid)}
  .pt-com.hecho{opacity:.5}
  .pt-com .hd{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;font-size:11.5px;color:var(--muted-2)}
  .pt-com .hd b{color:var(--text);font-size:13px}
  .pt-com .hd .t{background:var(--navy-800);border-radius:6px;padding:1px 7px;color:#f0c060;
    font-variant-numeric:tabular-nums;font-weight:700;cursor:pointer}
  .pt-com p{margin:6px 0 0;font-size:13.5px;color:var(--muted);line-height:1.55;white-space:pre-wrap}

  .pt-files{display:grid;gap:7px;margin-top:16px}
  .pt-file{display:flex;align-items:center;gap:11px;background:var(--navy-900);border:1px solid var(--line);
    border-radius:11px;padding:10px 14px;font-size:13.5px}
  .pt-file .nm{flex:1;min-width:0;overflow-wrap:anywhere}
  .pt-file .nm small{display:block;font-size:11.5px;color:var(--muted-2)}

  .pt-ok{border:1px solid #7ed957;border-radius:13px;background:rgba(126,217,87,.07);padding:14px 16px;
    margin-top:18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .pt-ok div{flex:1;min-width:190px;font-size:13.5px;color:var(--muted)}
  .pt-aprobado{border-color:#7ed957;color:#7ed957;font-weight:700}

  .pt-code{background:var(--navy-900);border:1px solid var(--line);border-radius:13px;padding:14px 16px;margin-top:14px}
  .pt-code input{background:var(--navy-800);border:1px solid var(--line-strong);border-radius:10px;color:var(--text);
    font:700 20px/1 inherit;letter-spacing:.3em;padding:11px 14px;width:170px;text-align:center}
  .pt-err{color:#ff8b8b;font-size:13px;margin-top:8px}
  .pt-sec-h{font-size:10px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted-2);font-weight:700;margin:24px 0 8px}
</style>
</head>
<body>
<div class="pt-wrap">
  <div class="pt-top">
    <VivenLogoSymbol />
    <a href="/" class="logo" aria-label="Viven"><svg class="logo-mark"><use href="#viven-logo"/></svg></a>
    <span class="muted-note" id="pt-est" style="font-size:12px"></span>
  </div>
  <div id="pt-body"><div class="pt-card"><p class="muted-note">…</p></div></div>
</div>

<script is:inline define:vars={{ SB_URL, SB_KEY, BRIEF, BRIEF_T, BRIEF_SECCIONES }}>
  var qs = new URLSearchParams(location.search);
  var ID = qs.get('id'), TK = qs.get('t');
  /* Pase de equipo: viene en el link que abre el dashboard con "👁 Abrir". Se usa como
     token igual que el del cliente, y el servidor lo reconoce como del equipo. */
  var PASE = qs.get('pase');
  /* Entrar directo a una nota: ?ver=<id>&tc=<ms>. Es lo que hace que el minuto del email
     al montajista abra el corte en ese segundo — y adentro del portal, no en vimeo.com,
     que con el video privado no reproduce. */
  var VER_Q = qs.get('ver'), TC_Q = parseInt(qs.get('tc') || '', 10);
  var $ = function(i){ return document.getElementById(i); };
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){
    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }

  /* Las cinco etapas son las mismas que ve el equipo en Proyectos, para que el cliente
     y nosotros hablemos del mismo estado. Las viejas se mapean por si queda algún link
     dando vueltas. */
  var STEPS = ['desarrollo','preproduccion','rodaje','post','entregado'];
  var VIEJAS = { pre_production:'preproduccion', filming:'rodaje', editing:'post', client_review:'post', delivered:'entregado' };
  var L, DATA = null, VER = null, TOKEN = null;
  try { TOKEN = localStorage.getItem('vv_portal_' + ID); } catch(e){}
  /* El pase manda sobre lo que hubiera guardado, y NO se guarda: dura 2 horas y es para
     mirar, no para dejar el portal abierto en ese navegador. */
  if (PASE) TOKEN = PASE;

  var TX = {
    en: { title:'Your project status', steps:['Development','Pre-production','Filming','Post-production','Delivered'],
      ph:'What should change?', send:'Send comment', sent:'✅ Sent — we get it right away, with the timestamp.',
      here:'here', versions:'Versions', files:'Files', download:'Download', comments:'Comments',
      approve:'Approve this version', approveHint:'If everything looks good, approve — then we deliver the final files.',
      approved:'Approved', codeAsk:'We send a 6-digit code to', codeSend:'Send me the code',
      gateT:'Your project', gateP:'To open your project we send a 6-digit code to your email. It stays valid on this device for 30 days.',
      gateNoMail:'This project has no contact email yet — write to info@viven.ch and we open it for you.',
      codePh:'000000', codeGo:'Confirm', codeSent:'Code sent to', codeBad:'Wrong code', codeOld:'The code expired — ask for a new one',
      err:'Could not load — check the link or write to info@viven.ch', due:'Delivery by', noVid:'The cut is not ready yet.' },
    de: { title:'Ihr Projektstatus', steps:['Entwicklung','Vorproduktion','Dreh','Postproduktion','Geliefert'],
      ph:'Was soll geändert werden?', send:'Kommentar senden', sent:'✅ Gesendet — wir bekommen es sofort, mit dem Zeitpunkt.',
      here:'hier', versions:'Versionen', files:'Dateien', download:'Herunterladen', comments:'Kommentare',
      approve:'Diese Version freigeben', approveHint:'Wenn alles passt, freigeben — dann liefern wir die finalen Dateien.',
      approved:'Freigegeben', codeAsk:'Wir senden einen 6-stelligen Code an', codeSend:'Code senden',
      gateT:'Ihr Projekt', gateP:'Um Ihr Projekt zu öffnen, senden wir einen 6-stelligen Code an Ihre E-Mail. Er bleibt auf diesem Gerät 30 Tage gültig.',
      gateNoMail:'Für dieses Projekt ist noch keine Kontakt-E-Mail hinterlegt — schreiben Sie an info@viven.ch, wir schalten es frei.',
      codePh:'000000', codeGo:'Bestätigen', codeSent:'Code gesendet an', codeBad:'Falscher Code', codeOld:'Der Code ist abgelaufen — bitte neuen anfordern',
      err:'Konnte nicht geladen werden — Link prüfen oder info@viven.ch', due:'Lieferung bis', noVid:'Der Schnitt ist noch nicht bereit.' },
    es: { title:'El estado de tu proyecto', steps:['Desarrollo','Preproducción','Rodaje','Postproducción','Entregado'],
      ph:'¿Qué habría que cambiar?', send:'Enviar comentario', sent:'✅ Enviado — nos llega al instante, con el minuto.',
      here:'acá', versions:'Versiones', files:'Archivos', download:'Descargar', comments:'Comentarios',
      approve:'Aprobar esta versión', approveHint:'Si está todo bien, aprobalo — y entregamos los archivos finales.',
      approved:'Aprobado', codeAsk:'Te mandamos un código de 6 dígitos a', codeSend:'Mandame el código',
      gateT:'Tu proyecto', gateP:'Para abrir tu proyecto te mandamos un código de 6 dígitos a tu email. Queda válido en este dispositivo por 30 días.',
      gateNoMail:'Este proyecto todavía no tiene email de contacto — escribinos a info@viven.ch y te lo abrimos.',
      codePh:'000000', codeGo:'Confirmar', codeSent:'Código enviado a', codeBad:'Código incorrecto', codeOld:'El código venció — pedí uno nuevo',
      err:'No se pudo cargar — revisá el link o escribí a info@viven.ch', due:'Entrega hasta', noVid:'El corte todavía no está listo.' },
  };

  /* Si quien abre el portal es alguien de VIVEN, va con SU sesión y entra sin código.
     El token del dashboard vive en localStorage del mismo origen (viven.ch), así que
     está acá al alcance; se busca por el prefijo que usa supabase-js.
     (Sebastián, 26 ago 2026: "yo también tengo que ver el portal del cliente… tengo que
     poder ver qué ve y corregir si necesario".) */
  function sesionEquipo(){
    try {
      for (var i = 0; i < localStorage.length; i++){
        var k = localStorage.key(i);
        if (!k || k.indexOf('sb-') !== 0 || k.indexOf('-auth-token') < 0) continue;
        var v = JSON.parse(localStorage.getItem(k) || 'null');
        var t = v && (v.access_token || (v.currentSession && v.currentSession.access_token));
        // vencido no sirve: mandarlo haría que el servidor lo rechace y caiga al código
        var exp = v && (v.expires_at || (v.currentSession && v.currentSession.expires_at));
        if (t && (!exp || exp * 1000 > Date.now())) return t;
      }
    } catch(e){}
    return null;
  }

  function api(accion, extra){
    var jwt = sesionEquipo();
    return fetch(SB_URL + '/functions/v1/get-portal', {
      method:'POST', headers:{ 'Content-Type':'application/json', 'apikey':SB_KEY, 'Authorization':'Bearer ' + (jwt || SB_KEY) },
      body: JSON.stringify(Object.assign({ id:ID, t:TK, accion:accion, token:TOKEN }, extra || {}))
    }).then(function(r){ return r.json(); });
  }

  var mmss = function(ms){ var s = Math.floor((ms||0)/1000); return Math.floor(s/60) + ':' + String(s%60).padStart(2,'0'); };

  /* El reproductor de Vimeo sabe en qué segundo está: es lo que hace que la nota valga
     "en el 0:34" y no "en algún momento del principio". Se carga su API solo si el
     video es de Vimeo; con YouTube o sin video, el comentario va sin timecode. */
  var player = null, TC = 0;
  /* Un video de Vimeo que NO es público lleva un hash de privacidad en la URL
     (vimeo.com/123456789/a1b2c3d4e5) y el reproductor lo necesita como ?h=…. Esto lo
     tiraba, así que el corte se veía solo si el video estaba público — justo lo que no
     puede pasar: el cliente lo tiene que ver antes de que sea público.
     (Sebastián, 26 ago 2026: "en vimeo el video va a estar como privado… tiene que
     poder ser leído igualmente, si no lo ven todos antes de que sea real".) */
  function montarVimeo(url){
    var m = String(url||'').match(/vimeo\.com\/(?:video\/)?(\d+)(?:\/([0-9a-z]+))?/i);
    if (!m) return null;
    var h = m[2] || (String(url||'').match(/[?&]h=([0-9a-z]+)/i) || [])[1];
    return 'https://player.vimeo.com/video/' + m[1] + (h ? '?h=' + h : '');
  }
  function embed(url){
    var v = montarVimeo(url); if (v) return v;
    var y = String(url||'').match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]+)/);
    return y ? 'https://www.youtube.com/embed/' + y[1] : '';
  }
  function engancharVimeo(){
    var ifr = $('pt-iframe'); if (!ifr || !/player\.vimeo\.com/.test(ifr.src)) return;
    var arranca = function(){
      if (!window.Vimeo) return;
      try {
        player = new window.Vimeo.Player(ifr);
        var poner = function(d){ TC = Math.round(((d && d.seconds) || 0) * 1000); pintarTC(); };
        /* `timeupdate` solo dispara MIENTRAS se reproduce. El caso principal es el
           contrario: pausás en el cuadro que te molesta y ahí escribís. Sin `seeked` y
           `pause`, la nota se mandaba con el minuto viejo — probado: buscar al 0:41 con
           el video pausado dejaba el chip en 0:00. */
        player.on('timeupdate', poner);
        player.on('seeked', poner);
        player.on('pause', poner);
        player.on('play', poner);
        /* Saltar al minuto pedido, una sola vez. Se hace con `loaded` y no al toque: si
           se pide el salto antes de que el reproductor tenga el video, no pasa nada y el
           link parece roto. */
        if (TC_Q > 0 && !engancharVimeo.saltado){
          engancharVimeo.saltado = true;
          player.on('loaded', function(){
            player.setCurrentTime(TC_Q / 1000).catch(function(){});
          });
        }
      } catch(e){}
    };
    if (window.Vimeo) return arranca();
    var s = document.createElement('script');
    s.src = 'https://player.vimeo.com/api/player.js'; s.onload = arranca;
    document.head.appendChild(s);
  }
  function pintarTC(){ var e = $('pt-tc'); if (e) e.textContent = '🕐 ' + mmss(TC) + ' — ' + L.here; }

  function pasos(estado){
    var crudo = estado || 'desarrollo';
    var idx = Math.max(0, STEPS.indexOf(VIEJAS[crudo] || crudo));
    return STEPS.map(function(s, i){
      var cls = i < idx ? 'done' : (i === idx ? 'current' : '');
      return '<span class="pt-step ' + cls + '"><span class="dot">' + (i < idx ? '✓' : (i+1)) + '</span>' + L.steps[i] + '</span>' +
        (i < STEPS.length - 1 ? '<span class="pt-sep"></span>' : '');
    }).join('');
  }

  function render(){
    var d = DATA;
    var vers = d.versiones || [];
    if (!VER && VER_Q) VER = vers.filter(function(v){ return String(v.id) === String(VER_Q); })[0] || null;
    if (!VER && vers.length) VER = vers[0];
    var url = (VER && VER.video_url) || d.deliverable_url;
    var src = embed(url);
    var coms = (d.comentarios || []).filter(function(c){ return !VER || !c.version_id || String(c.version_id) === String(VER.id); });
    var aprobada = VER && VER.approved_at;

    $('pt-body').innerHTML =
      '<div class="pt-card">' +
        '<h1>' + esc(d.title || L.title) + '</h1>' +
        '<p class="pt-sub">' + esc(d.client_name || '') +
          (d.delivery_due ? ' · ' + L.due + ' ' + esc(d.delivery_due.split('-').reverse().join('.')) : '') + '</p>' +
        '<div class="pt-steps">' + pasos(d.production_status) + '</div>' +
        (d.portal_note ? '<div class="pt-note">' + esc(d.portal_note) + '</div>' : '') +
        briefHTML(d) +
        (src
          ? '<div class="pt-vid"><iframe id="pt-iframe" src="' + esc(src) + '" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>'
          : '<div class="pt-note">' + L.noVid + '</div>') +
        (vers.length > 1
          ? '<div class="pt-vers">' + vers.map(function(v){
              return '<button type="button" data-v="' + v.id + '" class="' + (VER && v.id === VER.id ? 'on' : '') + '">v' + v.n +
                (v.title ? ' <small>· ' + esc(v.title) + '</small>' : '') + '</button>'; }).join('') + '</div>'
          : '') +
        (src
          ? '<div class="pt-cbox"><span class="pt-tc" id="pt-tc">🕐 0:00 — ' + L.here + '</span>' +
            '<textarea id="pt-msg" placeholder="' + esc(L.ph) + '"></textarea>' +
            '<div class="pt-row"><button class="btn btn-primary" id="pt-send" type="button">' + L.send + '</button>' +
            '<span class="muted-note" id="pt-sent" style="font-size:12.5px"></span></div></div>'
          : '') +
        (coms.length
          ? '<div class="pt-sec-h">' + L.comments + '</div><div class="pt-coms">' + coms.map(function(c){
              return '<div class="pt-com ' + (c.from_client ? 'mio' : '') + (c.resolved ? ' hecho' : '') + '">' +
                '<div class="hd"><b>' + esc(c.author_name || 'VIVEN') + '</b>' +
                (c.tc_ms != null ? '<span class="t" data-go="' + c.tc_ms + '">' + mmss(c.tc_ms) + '</span>' : '') +
                (c.resolved ? '<span style="color:#7ed957">✓</span>' : '') + '</div>' +
                '<p>' + esc(c.body) + '</p></div>'; }).join('') + '</div>'
          : '') +
        ((d.archivos || []).length
          ? '<div class="pt-sec-h">' + L.files + '</div><div class="pt-files">' + d.archivos.map(function(f){
              return '<div class="pt-file"><span class="nm">' + esc(f.file_name) +
                '<small>' + (f.size_bytes ? Math.round(f.size_bytes/1048576) + ' MB' : '') + '</small></span>' +
                '<button class="btn btn-ghost small" type="button" data-dl="' + f.id + '">' + L.download + '</button></div>'; }).join('') + '</div>'
          : '') +
        (VER
          ? (aprobada
              ? '<div class="pt-ok"><div class="pt-aprobado">✓ ' + L.approved + ' · ' + esc(String(VER.approved_at).slice(0,10).split('-').reverse().join('.')) + '</div></div>'
              : '<div class="pt-ok"><div>' + L.approveHint + '</div>' +
                '<button class="btn btn-ghost small" id="pt-ok" type="button" style="border-color:#7ed957;color:#7ed957">✓ ' + L.approve + '</button></div>')
          : '') +
        '<div id="pt-code"></div>' +
      '</div>';

    engancharVimeo();
    var s = $('pt-send'); if (s) s.addEventListener('click', enviar);
    /* Y por las dudas: al empezar a escribir se le pregunta al reproductor dónde está.
       Es la última red — si algún evento no llegó, el minuto que se manda igual es el
       que el cliente está viendo. */
    var msg = $('pt-msg');
    if (msg) msg.addEventListener('focus', function(){
      if (!player) return;
      player.getCurrentTime().then(function(seg){ TC = Math.round((seg || 0) * 1000); pintarTC(); }).catch(function(){});
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-v]'), function(b){
      b.addEventListener('click', function(){ VER = vers.filter(function(v){ return String(v.id) === b.dataset.v; })[0]; render(); }); });
    Array.prototype.forEach.call(document.querySelectorAll('[data-go]'), function(b){
      b.addEventListener('click', function(){ if (player) player.setCurrentTime(+b.dataset.go/1000); }); });
    Array.prototype.forEach.call(document.querySelectorAll('[data-dl]'), function(b){
      b.addEventListener('click', function(){ conCodigo(function(){ bajar(b.dataset.dl); }); }); });
    var ok = $('pt-ok'); if (ok) ok.addEventListener('click', function(){ conCodigo(aprobar); });
    briefBind();
  }

  /* ══════════════ PROJECT BRIEF ══════════════
     Las 12 preguntas que definen de qué se trata el video, acá adentro del portal.

     DOS presentaciones, y no una: "toca testear qué es mejor para que no sea
     overwhelming" (Sebastián, 26 ago 2026). El servidor manda cuál le tocó a este
     cliente —se sortea al enviarlo y no cambia entre visitas— y acá se dibuja.
       · largo → las 12 de corrido, agrupadas en cuatro secciones.
       · pasos → una sección por vez, con Atrás/Siguiente.
     Lo que se mide después es cuántos LO TERMINAN, no cuántos lo abren. */
  var BSEC = 0;   // sección visible en modo 'pasos'

  function briefT(){ return BRIEF_T[(DATA && DATA.lang) || 'en'] || BRIEF_T.en; }
  function briefTxt(o){ var lg = (DATA && DATA.lang) || 'en'; return (o && (o[lg] || o.en)) || ''; }

  function briefHTML(d){
    if (!d.brief_enviado) return '';                 // todavía no se lo mandamos
    var T = briefT(), R = d.brief || {}, SUG = d.brief_sugerencias || {};
    var hechas = BRIEF.filter(function(q){ return (R[q.k] || '').trim(); }).length;
    var pasos = d.brief_variante === 'pasos';

    if (d.brief_listo){
      return '<div class="pt-brief hecho"><div class="bh"><b>📋 ' + esc(T.titulo) + '</b>' +
        '<span class="bok">✓ ' + esc(T.listo) + '</span></div></div>';
    }

    var secs = pasos ? [BRIEF_SECCIONES[BSEC]] : BRIEF_SECCIONES;
    var cuerpo = secs.map(function(sc){
      var qs = BRIEF.filter(function(q){ return q.sec === sc; });
      return '<div class="bsec"><div class="bsec-h">' + esc(T.secciones[sc]) + '</div>' +
        qs.map(function(q){ return briefPregunta(q, R, SUG, T); }).join('') + '</div>';
    }).join('');

    return '<div class="pt-brief">' +
      '<div class="bh"><b>📋 ' + esc(T.titulo) + '</b>' +
        '<span class="bprog"><span style="width:' + Math.round(hechas / BRIEF.length * 100) + '%"></span></span>' +
        '<span class="bn">' + hechas + ' ' + esc(T.de) + ' ' + BRIEF.length + ' ' + esc(T.contestadas) + '</span>' +
        '<button type="button" class="binv" id="b-inv">' + esc(T.invitar) + '</button></div>' +
      '<p class="bsub">' + esc(T.sub) + ' · <i>' + esc(T.guardado) + '</i></p>' +
      '<div id="b-invbox"></div>' +
      cuerpo +
      (pasos
        ? '<div class="bnav">' +
            (BSEC > 0 ? '<button type="button" class="bbtn g" id="b-prev">‹ ' + esc(T.anterior) + '</button>' : '') +
            '<span class="bdots">' + BRIEF_SECCIONES.map(function(_, i){
              return '<i class="' + (i === BSEC ? 'on' : '') + '"></i>'; }).join('') + '</span>' +
            (BSEC < BRIEF_SECCIONES.length - 1
              ? '<button type="button" class="bbtn" id="b-next">' + esc(T.siguiente) + ' ›</button>'
              : '<button type="button" class="bbtn" id="b-fin">' + esc(T.enviar) + '</button>') +
          '</div>'
        : '<div class="bnav"><span class="sp"></span><button type="button" class="bbtn" id="b-fin">' + esc(T.enviar) + '</button></div>') +
    '</div>';
  }

  function briefPregunta(q, R, SUG, T){
    var v = R[q.k] || '', sug = !v && SUG[q.k] ? SUG[q.k] : '';
    var partes = briefPartir(q, v);
    var ops = q.op ? briefTxt(q.op) : null;
    return '<div class="bq' + (v.trim() ? ' ok' : '') + '" data-k="' + q.k + '">' +
      '<div class="bqt">' + esc(briefTxt(q.q)) + (q.esencial ? '<i class="breq">·</i>' : '') + '</div>' +
      (briefTxt(q.h) ? '<div class="bqh">' + esc(briefTxt(q.h)) + '</div>' : '') +
      (ops ? '<div class="bchips"' + (q.multi ? ' data-multi' : '') + '>' + ops.map(function(o){
          return '<button type="button" class="bchip' + (partes.sel.indexOf(o) > -1 ? ' on' : '') + '" data-o="' + esc(o) + '">' + esc(o) + '</button>';
        }).join('') + '</div>' : '') +
      '<textarea class="blibre" rows="3" placeholder="' + esc(briefTxt(q.libre) || '') + '">' + esc(partes.txt) + '</textarea>' +
      /* La sugerencia se OFRECE, no se pone sola: una respuesta heredada a ciegas de otro
         proyecto es peor que un campo vacío, porque nadie la revisa. */
      (sug ? '<div class="bsug"><span>' + esc(T.sug) + ':</span> ' + esc(sug.slice(0, 160)) +
             (sug.length > 160 ? '…' : '') +
             ' <button type="button" class="busar" data-sug="' + q.k + '">' + esc(T.sugUsar) + '</button></div>' : '') +
    '</div>';
  }

  /* Mismo formato que el playbook del dashboard: "Chip · Otro chip — el texto".
     Un solo texto legible, que es el que después lee la IA para escribir el guion. */
  var BSEP = ' — ';
  function briefPartir(q, v){
    var sel = [], ops = q.op ? briefTxt(q.op) : [], resto = String(v || '');
    if (ops.length){
      var i = resto.indexOf(BSEP);
      var cab = i > -1 ? resto.slice(0, i) : resto;
      var tr = cab.split(' · ').map(function(x){ return x.trim(); }).filter(Boolean);
      var todas = tr.length && tr.every(function(t){ return ops.indexOf(t) > -1; });
      if (todas){ sel = tr; resto = i > -1 ? resto.slice(i + BSEP.length) : ''; }
    }
    return { sel: sel, txt: resto };
  }
  function briefJuntar(sel, txt){
    return [sel.join(' · '), String(txt || '').trim()].filter(Boolean).join(BSEP);
  }

  function briefBind(){
    var box = document.querySelector('.pt-brief'); if (!box) return;
    var T = briefT();
    Array.prototype.forEach.call(box.querySelectorAll('.bchip'), function(b){
      b.addEventListener('click', function(){
        var cont = b.parentElement;
        if (cont.hasAttribute('data-multi')) b.classList.toggle('on');
        else {
          var ya = b.classList.contains('on');
          Array.prototype.forEach.call(cont.querySelectorAll('.bchip'), function(x){ x.classList.remove('on'); });
          if (!ya) b.classList.add('on');
        }
        briefGuardar(b.closest('.bq'));
      });
    });
    Array.prototype.forEach.call(box.querySelectorAll('.blibre'), function(ta){
      ta.addEventListener('blur', function(){ briefGuardar(ta.closest('.bq')); });
    });
    Array.prototype.forEach.call(box.querySelectorAll('.busar'), function(b){
      b.addEventListener('click', function(){
        var fila = b.closest('.bq'), ta = fila.querySelector('.blibre');
        var q = BRIEF.filter(function(x){ return x.k === b.dataset.sug; })[0];
        var sug = (DATA.brief_sugerencias || {})[b.dataset.sug] || '';
        var partes = briefPartir(q, sug);
        ta.value = partes.txt;
        Array.prototype.forEach.call(fila.querySelectorAll('.bchip'), function(x){
          x.classList.toggle('on', partes.sel.indexOf(x.dataset.o) > -1); });
        b.closest('.bsug').remove();
        briefGuardar(fila);
      });
    });
    var iv = $('b-inv'); if (iv) iv.addEventListener('click', briefInvitar);
    var pv = $('b-prev'); if (pv) pv.addEventListener('click', function(){ BSEC = Math.max(0, BSEC - 1); render(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
    var nx = $('b-next'); if (nx) nx.addEventListener('click', function(){ BSEC = Math.min(BRIEF_SECCIONES.length - 1, BSEC + 1); render(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
    var fn = $('b-fin'); if (fn) fn.addEventListener('click', function(){
      fn.disabled = true;
      api('brief_listo').then(function(){ DATA.brief_listo = true; render(); });
    });
  }

  function briefGuardar(fila){
    if (!fila) return;
    var q = BRIEF.filter(function(x){ return x.k === fila.dataset.k; })[0]; if (!q) return;
    var sel = Array.prototype.map.call(fila.querySelectorAll('.bchip.on'), function(x){ return x.dataset.o; });
    var ta = fila.querySelector('.blibre');
    var v = briefJuntar(sel, ta ? ta.value : '');
    if (v === ((DATA.brief || {})[q.k] || '')) return;
    DATA.brief = DATA.brief || {}; DATA.brief[q.k] = v;
    fila.classList.toggle('ok', !!v.trim());
    briefProgreso();
    api('brief_guardar', { key: q.k, value: v }).then(function(r){
      if (r && r.error === 'necesita_codigo') conCodigo(function(){ api('brief_guardar', { key: q.k, value: v }); });
    });
  }

  /* El contador se actualiza sin redibujar: un render() mientras escribís te saca del
     campo. Mismo problema que tuvimos en Proyectos. */
  function briefProgreso(){
    var box = document.querySelector('.pt-brief'); if (!box) return;
    var T = briefT(), R = DATA.brief || {};
    var n = BRIEF.filter(function(q){ return (R[q.k] || '').trim(); }).length;
    var pr = box.querySelector('.bprog>span'); if (pr) pr.style.width = Math.round(n / BRIEF.length * 100) + '%';
    var bn = box.querySelector('.bn'); if (bn) bn.textContent = n + ' ' + T.de + ' ' + BRIEF.length + ' ' + T.contestadas;
  }

  function briefInvitar(){
    var T = briefT(), box = $('b-invbox'); if (!box) return;
    if (box.innerHTML){ box.innerHTML = ''; return; }
    box.innerHTML = '<div class="binv-box"><b>' + esc(T.invTit) + '</b>' +
      '<p>' + esc(T.invSub) + '</p>' +
      '<input id="b-inv-mail" type="email" placeholder="' + esc(T.invPh) + '" />' +
      '<button type="button" class="bbtn" id="b-inv-go">' + esc(T.invBtn) + '</button>' +
      '<div class="binv-msg" id="b-inv-msg"></div></div>';
    $('b-inv-go').addEventListener('click', function(){
      var m = ($('b-inv-mail').value || '').trim();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(m)) return;
      $('b-inv-go').disabled = true;
      api('brief_invitar', { email: m }).then(function(r){
        $('b-inv-go').disabled = false;
        $('b-inv-msg').textContent = (r && r.ok) ? T.invHecho + ' ' + m : '⚠️';
        if (r && r.ok) $('b-inv-mail').value = '';
      });
    });
  }

  function enviar(){
    var t = $('pt-msg').value.trim(); if (!t) return;
    var b = $('pt-send'); b.disabled = true;
    api('comentar', { texto:t, tc_ms: TC || null, version_id: VER ? VER.id : null }).then(function(r){
      b.disabled = false;
      if (r.error) { $('pt-sent').textContent = '⚠️'; return; }
      $('pt-msg').value = ''; $('pt-sent').textContent = L.sent;
      DATA.comentarios = (DATA.comentarios || []).concat([r.comentario]);
      render();
    });
  }

  /* Bajar y aprobar piden el código. Se manda SIEMPRE al email de la ficha, nunca a
     uno que escriba quien está mirando. */
  var pendiente = null;
  function conCodigo(fn){
    /* Ojo: `TOKEN` puede existir en el navegador y estar vencido del lado del servidor.
       Por eso quien llama a esto maneja el error 'necesita_codigo' volviendo a pedirlo,
       en vez de confiar en lo que dice localStorage. */
    if (DATA.verificado || TOKEN) return fn();
    pendiente = fn;
    $('pt-code').innerHTML = '<div class="pt-code"><p class="muted-note" style="margin:0 0 10px;font-size:13.5px">' +
      L.codeAsk + ' <b>' + esc(DATA.email_tapado || '') + '</b></p>' +
      '<button class="btn btn-primary small" id="pt-code-send" type="button">' + L.codeSend + '</button>' +
      '<div id="pt-code-in"></div></div>';
    $('pt-code-send').addEventListener('click', function(){
      var b = this; b.disabled = true;
      api('pedir_codigo').then(function(r){
        if (r.error) { b.disabled = false; return; }
        $('pt-code-in').innerHTML = '<p class="muted-note" style="margin:12px 0 8px;font-size:13px">' + L.codeSent + ' ' + esc(r.enviado_a) + '</p>' +
          '<input id="pt-code-v" inputmode="numeric" maxlength="6" placeholder="' + L.codePh + '" /> ' +
          '<button class="btn btn-primary small" id="pt-code-go" type="button">' + L.codeGo + '</button><div class="pt-err" id="pt-code-err"></div>';
        $('pt-code-go').addEventListener('click', verificar);
        $('pt-code-v').focus();
      });
    });
    $('pt-code').scrollIntoView({ behavior:'smooth', block:'center' });
  }
  /* Puerta de entrada: lo único que se ve sin código. No dice el nombre del proyecto ni
     del cliente — solo a qué email va el código, tapado. */
  function puerta(){
    $('pt-est').textContent = '';
    /* Si el servidor pide código, el token guardado en este navegador está vencido o ya
       no vale. Borrarlo acá evita que conCodigo() lo dé por bueno y siga de largo a una
       pantalla que el servidor no va a contestar. */
    TOKEN = null; try { localStorage.removeItem('vv_portal_' + ID); } catch(e){}
    /* Con pase vencido la puerta del cliente no ayuda: el que está mirando es del
       equipo y lo que necesita es saber que tiene que pedir otro pase. */
    if (PASE){
      $('pt-body').innerHTML = '<div class="pt-card"><h1 style="margin:0 0 10px">Pase vencido</h1>' +
        '<p class="muted-note" style="margin:0">El pase de equipo dura 2 horas. Volvé al proyecto en el dashboard y tocá <b>👁 Abrir</b> otra vez.</p></div>';
      return;
    }
    if (!DATA.tiene_email){
      $('pt-body').innerHTML = '<div class="pt-card"><h1 style="margin:0 0 10px">' + L.gateT + '</h1>' +
        '<p class="muted-note" style="margin:0">' + L.gateNoMail + '</p></div>';
      return;
    }
    $('pt-body').innerHTML = '<div class="pt-card"><h1 style="margin:0 0 10px">' + L.gateT + '</h1>' +
      '<p class="muted-note" style="margin:0 0 16px;font-size:13.5px">' + L.gateP + '</p>' +
      '<div id="pt-code"></div></div>';
    conCodigo(function(){ cargar(); });
  }

  function verificar(){
    var c = ($('pt-code-v').value || '').replace(/\D/g,'');
    api('verificar', { codigo:c }).then(function(r){
      if (r.error) { $('pt-code-err').textContent = r.error === 'codigo_vencido' ? L.codeOld : L.codeBad; return; }
      TOKEN = r.token; DATA.verificado = true;
      try { localStorage.setItem('vv_portal_' + ID, TOKEN); } catch(e){}
      $('pt-code').innerHTML = '';
      if (pendiente) { var f = pendiente; pendiente = null; f(); }
    });
  }
  function bajar(fileId){
    api('descargar', { file_id:+fileId }).then(function(r){
      if (r.error) { if (r.error === 'necesita_codigo') { TOKEN = null; conCodigo(function(){ bajar(fileId); }); } return; }
      window.location.href = r.url;
    });
  }
  function aprobar(){
    api('aprobar', { version_id: VER.id }).then(function(r){
      if (r.error) { if (r.error === 'necesita_codigo') { TOKEN = null; conCodigo(aprobar); } return; }
      cargar();
    });
  }

  function cargar(){
    api('estado').then(function(d){
      if (!d || d.error) { L = TX.en; $('pt-body').innerHTML = '<div class="pt-card"><p class="muted-note">' + TX.en.err + '</p></div>'; return; }
      DATA = d; L = TX[d.lang] || TX.en;
      document.documentElement.lang = d.lang || 'en';
      document.title = (d.title || L.title) + ' — Viven';
      VER = null;
      /* El link solo no abre nada: sin código verificado el servidor no manda ni el
         título. Esta es la puerta. */
      if (d.necesita_codigo) { puerta(); return; }
      render();
      /* Aviso de que lo estás viendo como equipo: si no, es imposible saber si lo que
         ves es lo que ve el cliente o un atajo tuyo. */
      if (d.modo_equipo){
        var av = document.createElement('div');
        av.className = 'pt-equipo';
        av.innerHTML = '👁 Lo estás viendo como <b>VIVEN</b>, sin código. El cliente (' +
          esc(d.email_cliente || d.email_tapado || '—') + ') tiene que pedir el suyo por email.';
        var w = document.querySelector('.pt-wrap');
        if (w && !document.querySelector('.pt-equipo')) w.insertBefore(av, w.firstChild.nextSibling);
      }
    }).catch(function(){ L = TX.en; $('pt-body').innerHTML = '<div class="pt-card"><p class="muted-note">' + TX.en.err + '</p></div>'; });
  }
  if (!ID || !TK) { $('pt-body').innerHTML = '<div class="pt-card"><p class="muted-note">' + TX.en.err + '</p></div>'; }
  else cargar();
</script>
</body>
</html>
