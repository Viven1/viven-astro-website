---
import Base from '../../../layouts/Base.astro';
import Testimonials from '../../../components/Testimonials.astro';
import VideoGallery from '../../../components/VideoGallery.astro';
import CalcBanner from '../../../components/CalcBanner.astro';
import { langPaths, localePath, L } from '../../../i18n.js';
export const getStaticPaths = langPaths;
const { lang } = Astro.params;
const p = (s) => localePath(lang, s);
const title = {"en":"Projects — Video Production Portfolio Zurich | Viven","de":"Projekte — Videoproduktion Portfolio Zürich | Viven","es":"Proyectos — Portafolio de producción de video Zúrich | Viven"};
const description = {"en":"Viven's video production portfolio: brand, product, employer-branding, how-to and social films for UBS, Siemens, Porsche, ON and FIFA — produced in Zurich.","de":"Das Portfolio der Viven Videoproduktion: Marken-, Produkt-, Employer-Branding-, How-To- und Social-Filme für UBS, Siemens, Porsche, ON und FIFA — produziert in Zürich.","es":"El portafolio de Viven: films de marca, producto, employer branding, tutoriales y social para UBS, Siemens, Porsche, ON y FIFA — producidos en Zúrich."};
---
<Base lang={lang} slug="projects" active="projects" title={title} description={description}>
  <script type="application/ld+json" slot="jsonld" set:html={"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"CollectionPage\",\"@id\":\"https://www.viven.ch/projects/#webpage\",\"url\":\"https://www.viven.ch/projects/\",\"name\":\"Projects — Viven video production portfolio\",\"description\":\"Brand, product, employer-branding, how-to, social and corporate films for 187 brands across 32 industries — produced by Viven in Zurich.\",\"about\":{\"@id\":\"https://www.viven.ch/#organization\"},\"isPartOf\":{\"@id\":\"https://www.viven.ch/#website\"},\"inLanguage\":[\"en\",\"de\",\"es\"]},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.viven.ch/projects/#breadcrumbs\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.viven.ch/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Projects\",\"item\":\"https://www.viven.ch/projects/\"}]},{\"@type\":\"ItemList\",\"@id\":\"https://www.viven.ch/projects/#videos\",\"name\":\"Selected Viven projects\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@type\":\"VideoObject\",\"name\":\"V-Zug — Combair V600\",\"description\":\"Product film for the V-Zug Combair V600 oven, produced by Viven.\",\"thumbnailUrl\":\"https://i.vimeocdn.com/video/1996950534-ab58c31114f162230baa21d656052dbd1f673936bd3e796469e75afa266991bb-d_960?region=us\",\"uploadDate\":\"2025-03-24T08:00:00+01:00\",\"embedUrl\":\"https://player.vimeo.com/video/1068759296\"}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@type\":\"VideoObject\",\"name\":\"Siemens — The Circle\",\"description\":\"Brand film for Siemens at The Circle, Zurich, produced by Viven.\",\"thumbnailUrl\":\"https://i.vimeocdn.com/video/1064645316-bbd239cf586fb16d26d9f62bb275e15aeae057038074f01bb6523a3ef415be91-d_960?region=us\",\"uploadDate\":\"2021-01-19T08:00:00+01:00\",\"embedUrl\":\"https://player.vimeo.com/video/502153490\"}},{\"@type\":\"ListItem\",\"position\":3,\"item\":{\"@type\":\"VideoObject\",\"name\":\"UBS — Apprenticeship\",\"description\":\"Employer-branding film for the UBS apprenticeship program, produced by Viven.\",\"thumbnailUrl\":\"https://i.vimeocdn.com/video/884633904-d825732fe23170e5186dee6fbe51c8d6c02f4bacb4e695e7679dbbbbd607f390-d_960?region=us\",\"uploadDate\":\"2020-04-27T08:00:00+01:00\",\"embedUrl\":\"https://player.vimeo.com/video/412290258\"}}]}]}"}></script>
<!-- ============ PAGE HERO ============ -->
<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={p("")} data-en="Home" data-de="Home" data-es="Inicio">{L(lang, "Home", "Home", "Inicio")}</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span data-en="Projects" data-de="Projekte" data-es="Proyectos">{L(lang, "Projects", "Projekte", "Proyectos")}</span>
    </nav>
    <span class="eyebrow" data-en="Projects" data-de="Projekte" data-es="Proyectos">{L(lang, "Projects", "Projekte", "Proyectos")}</span>
    <h1 data-en='Work that <span class="hl">moved the numbers.</span>'
        data-de='Arbeiten, die <span class="hl">Zahlen bewegt haben.</span>'
        data-es='Trabajo que <span class="hl">movió los números.</span>'><Fragment set:html={L(lang, `Work that <span class="hl">moved the numbers.</span>`, `Arbeiten, die <span class="hl">Zahlen bewegt haben.</span>`, `Trabajo que <span class="hl">movió los números.</span>`)} /></h1>
    <p class="lead"
       data-en="Selected projects with the full story — goals, process and results. Every project has its own page you can share. Filter by type and dive in."
       data-de="Ausgewählte Projekte mit der ganzen Geschichte — Ziele, Prozess und Resultate. Jedes Projekt hat eine eigene Seite zum Teilen. Nach Typ filtern und eintauchen."
       data-es="Proyectos seleccionados con la historia completa — objetivos, proceso y resultados. Cada proyecto tiene su propia página para compartir. Filtrá por tipo y entrá.">{L(lang, "Selected projects with the full story — goals, process and results. Every project has its own page you can share. Filter by type and dive in.", "Ausgewählte Projekte mit der ganzen Geschichte — Ziele, Prozess und Resultate. Jedes Projekt hat eine eigene Seite zum Teilen. Nach Typ filtern und eintauchen.", "Proyectos seleccionados con la historia completa — objetivos, proceso y resultados. Cada proyecto tiene su propia página para compartir. Filtrá por tipo y entrá.")}</p>
  </div>
</section>

<!-- ============ WORK GRID ============ -->
<section class="sec" id="work" style="padding-top:0">
  <div class="wrap">
    <div class="filters" role="group" aria-label="Filter projects">
      <button type="button" class="active" data-filter="all" data-en="All" data-de="Alle" data-es="Todos">{L(lang, "All", "Alle", "Todos")}</button>
      <button type="button" data-filter="brand" data-en="Brand" data-de="Marke" data-es="Marca">{L(lang, "Brand", "Marke", "Marca")}</button>
      <button type="button" data-filter="product" data-en="Product" data-de="Produkt" data-es="Producto">{L(lang, "Product", "Produkt", "Producto")}</button>
      <button type="button" data-filter="employer" data-en="Employer Branding" data-de="Employer Branding" data-es="Employer Branding">{L(lang, "Employer Branding", "Employer Branding", "Employer Branding")}</button>
      <button type="button" data-filter="howto" data-en="How-To" data-de="How-To" data-es="How-To">{L(lang, "How-To", "How-To", "How-To")}</button>
      <button type="button" data-filter="social" data-en="Social" data-de="Social" data-es="Social">{L(lang, "Social", "Social", "Social")}</button>
      <button type="button" data-filter="corporate" data-en="Corporate" data-de="Corporate" data-es="Corporativo">{L(lang, "Corporate", "Corporate", "Corporativo")}</button>
    </div>
    <VideoGallery lang={lang} feature={true} caseFirst={true} perClient={4} />
  </div>
</section>



<Testimonials lang={lang} />

<CalcBanner lang={lang} />

<!-- ============ CTA / FORM ============ -->
<section class="cta" id="start" style="padding-top:0">
  <div class="wrap">
    <div class="cta-card reveal">
      <div>
        <span class="eyebrow" data-en="Let's talk" data-de="Sprechen wir" data-es="Hablemos">{L(lang, "Let's talk", "Sprechen wir", "Hablemos")}</span>
        <h2 data-en="Tell us what you're working on." data-de="Erzählen Sie uns von Ihrem Projekt." data-es="Contanos en qué estás trabajando.">{L(lang, "Tell us what you're working on.", "Erzählen Sie uns von Ihrem Projekt.", "Contanos en qué estás trabajando.")}</h2>
        <p class="lead" data-en="Tell us your goal — we'll come back with timing and a clear quote within 48 hours. Free, no obligation." data-de="Nennen Sie uns Ihr Ziel — wir melden uns innert 48 Stunden mit Timing und einem klaren Angebot. Kostenlos und unverbindlich." data-es="Contanos tu objetivo — volvemos en 48 horas con tiempos y un presupuesto claro. Gratis y sin compromiso.">{L(lang, "Tell us your goal — we'll come back with timing and a clear quote within 48 hours. Free, no obligation.", "Nennen Sie uns Ihr Ziel — wir melden uns innert 48 Stunden mit Timing und einem klaren Angebot. Kostenlos und unverbindlich.", "Contanos tu objetivo — volvemos en 48 horas con tiempos y un presupuesto claro. Gratis y sin compromiso.")}</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 13 4 4L19 7"/></svg><span data-en="First draft within two weeks" data-de="Erster Entwurf in zwei Wochen" data-es="Primer borrador en dos semanas">{L(lang, "First draft within two weeks", "Erster Entwurf in zwei Wochen", "Primer borrador en dos semanas")}</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 13 4 4L19 7"/></svg><span data-en="One partner, brief to delivery" data-de="Ein Partner, vom Brief bis zur Auslieferung" data-es="Un partner, de principio a fin">{L(lang, "One partner, brief to delivery", "Ein Partner, vom Brief bis zur Auslieferung", "Un partner, de principio a fin")}</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 13 4 4L19 7"/></svg><span data-en="Multilingual delivery" data-de="Mehrsprachige Auslieferung" data-es="Entrega multilingüe">{L(lang, "Multilingual delivery", "Mehrsprachige Auslieferung", "Entrega multilingüe")}</span></li>
        </ul>
      </div>
      <div>
        <div class="lead-form-mount"></div>
        <p class="form-note" data-en="We'll reply within one business day. No spam, ever." data-de="Wir antworten innerhalb eines Werktags. Kein Spam." data-es="Respondemos en un día hábil. Nunca spam.">{L(lang, "We'll reply within one business day. No spam, ever.", "Wir antworten innerhalb eines Werktags. Kein Spam.", "Respondemos en un día hábil. Nunca spam.")}</p>
        <p class="book-call-note"><span data-en="Prefer to talk it through?" data-de="Lieber direkt sprechen?" data-es="¿Preferís hablarlo directamente?">{L(lang, "Prefer to talk it through?", "Lieber direkt sprechen?", "¿Preferís hablarlo directamente?")}</span> <a class="book-call" href="/book/" target="_blank" rel="noopener" data-en="Book a free 15-min call →" data-de="Gratis 15-Min-Call buchen →" data-es="Reservá una llamada gratis de 15 min →">{L(lang, "Book a free 15-min call →", "Gratis 15-Min-Call buchen →", "Reservá una llamada gratis de 15 min →")}</a></p>
      </div>
    </div>
  </div>
</section>
</Base>
