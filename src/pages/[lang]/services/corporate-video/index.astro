---
import RelatedPosts from '../../../../components/RelatedPosts.astro';
import Base from '../../../../layouts/Base.astro';
import CalcBanner from '../../../../components/CalcBanner.astro';
import Testimonials from '../../../../components/Testimonials.astro';
import VideoGallery from '../../../../components/VideoGallery.astro';
import { langPaths, localePath, L } from '../../../../i18n.js';
export const getStaticPaths = langPaths;
const { lang } = Astro.params;
const p = (s) => localePath(lang, s);
const title = {"en":"Corporate video production people actually finish | Viven","de":"Unternehmensfilm-Produktion Zürich, die man fertig schaut | Viven","es":"Producción de video corporativo que se mira entero | Viven"};
const description = {"en":"Internal communication films, keynotes and event coverage for UBS, FIFA and Philips. Fixed budget agreed upfront, first draft in two weeks.","de":"Interne Kommunikationsfilme, Keynotes und Event-Coverage für UBS, FIFA und Philips. Fixes Budget vor dem Dreh, erster Entwurf in zwei Wochen.","es":"Films de comunicación interna, keynotes y cobertura de eventos para UBS, FIFA y Philips. Presupuesto cerrado antes de rodar, primer corte en dos semanas."};
---
<Base lang={lang} slug="services/corporate-video" active="services" activeSub="corporate" title={title} description={description}>
  <script type="application/ld+json" slot="jsonld" set:html={"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Service\",\"@id\":\"https://www.viven.ch/services/corporate-video/#service\",\"name\":\"Corporate Video & Event Production\",\"serviceType\":\"Corporate video production\",\"url\":\"https://www.viven.ch/services/corporate-video/\",\"provider\":{\"@id\":\"https://www.viven.ch/#organization\"},\"areaServed\":[\"CH\",\"Europe\"],\"description\":\"Corporate communication films, internal content, keynotes and event coverage — concept, production and post end to end from Zurich. Produced for brands including UBS, FIFA and Philips.\"},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.viven.ch/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Services\",\"item\":\"https://www.viven.ch/services/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Corporate & Events\",\"item\":\"https://www.viven.ch/services/corporate-video/\"}]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How much does a corporate video cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It depends on scope — a single-camera interview film costs less than a multi-day event production. Most Viven projects range from CHF 4,000 to 80,000, and you always get a fixed, transparent quote before we start.\"}},{\"@type\":\"Question\",\"name\":\"Can you cover our event end to end?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We plan the coverage with you, film with a multi-camera crew, and deliver an aftermovie plus short social clips — often with first highlights ready the next day.\"}},{\"@type\":\"Question\",\"name\":\"Do you also produce internal communication videos?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Absolutely — leadership messages, town halls, onboarding and culture films. The same craft as our external work, tailored to what your teams actually watch.\"}},{\"@type\":\"Question\",\"name\":\"Can you deliver versions for global teams?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Subtitles and language versions in English, German and Spanish are standard, and additional languages are straightforward — one production serves every office.\"}}]}]}"}></script>
<!-- ============ PAGE HERO ============ -->
<section class="page-hero has-video">
  <div class="hero-bg" data-vimeo="866300150" data-mp4="/assets/heroes/866300150.mp4"><img class="reel" src="/assets/heroes/service-corporate-video.jpg" width="1600" height="900" alt="" fetchpriority="high" decoding="async" /><div class="grain"></div></div>
  <div class="hero-overlay"></div>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={p("")} data-en="Home" data-de="Home" data-es="Inicio">{L(lang, "Home", "Home", "Inicio")}</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href={p("services")} data-en="Services" data-de="Leistungen" data-es="Servicios">{L(lang, "Services", "Leistungen", "Servicios")}</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span data-en="Corporate &amp; Events" data-de="Corporate &amp; Events" data-es="Corporativo y eventos">{L(lang, "Corporate &amp; Events", "Corporate &amp; Events", "Corporativo y eventos")}</span>
    </nav>
    <span class="eyebrow" data-en="Corporate video &amp; event production" data-de="Unternehmensfilm- &amp; Event-Produktion" data-es="Producción de video corporativo y eventos">{L(lang, "Corporate video &amp; event production", "Unternehmensfilm- &amp; Event-Produktion", "Producción de video corporativo y eventos")}</span>
    <h1 data-en='Corporate video production that <span class="hl">keeps your audience close.</span>'
        data-de='Unternehmensfilm-Produktion, die <span class="hl">Ihr Publikum bindet.</span>'
        data-es='Producción de video corporativo que <span class="hl">mantiene cerca a tu audiencia.</span>'><Fragment set:html={L(lang, `Corporate video production that <span class="hl">keeps your audience close.</span>`, `Unternehmensfilm-Produktion, die <span class="hl">Ihr Publikum bindet.</span>`, `Producción de video corporativo que <span class="hl">mantiene cerca a tu audiencia.</span>`)} /></h1>
    <p class="lead"
       data-en="Corporate film production for leadership messages, keynotes and event aftermovies — business video people actually watch. Made for UBS, FIFA and Philips."
       data-de="Unternehmensfilm-Produktion für Führungsbotschaften, Keynotes und Event-Aftermovies — Business-Videos, die man wirklich anschaut. Produziert für UBS, FIFA und Philips."
       data-es="Producción de films corporativos para mensajes de liderazgo, keynotes y aftermovies de eventos — video empresarial que la gente realmente mira. Hecho para UBS, FIFA y Philips.">{L(lang, "Corporate film production for leadership messages, keynotes and event aftermovies — business video people actually watch. Made for UBS, FIFA and Philips.", "Unternehmensfilm-Produktion für Führungsbotschaften, Keynotes und Event-Aftermovies — Business-Videos, die man wirklich anschaut. Produziert für UBS, FIFA und Philips.", "Producción de films corporativos para mensajes de liderazgo, keynotes y aftermovies de eventos — video empresarial que la gente realmente mira. Hecho para UBS, FIFA y Philips.")}</p>
    <div class="hero-cta">
      <a href={p("contact")} class="btn btn-primary" data-en="Start a project" data-de="Projekt starten" data-es="Iniciar proyecto">{L(lang, "Start a project", "Projekt starten", "Iniciar proyecto")}</a>
      <a href="#work" class="btn btn-ghost" data-en="See corporate films" data-de="Unternehmensfilme ansehen" data-es="Ver films corporativos">{L(lang, "See corporate films", "Unternehmensfilme ansehen", "Ver films corporativos")}</a>
    </div>
    <p class="hero-price-note" style="margin-top:16px;font-size:14px;color:var(--muted)">💰 <span data-en="Typical projects: CHF 4'500–16'000" data-de="Typische Projekte: CHF 4'500–16'000" data-es="Proyectos típicos: CHF 4'500–16'000">{L(lang, "Typical projects: CHF 4'500–16'000", "Typische Projekte: CHF 4'500–16'000", "Proyectos típicos: CHF 4'500–16'000")}</span> · <a href="/en/video-cost-calculator/?type=corporate" data-en-href="/en/video-cost-calculator/?type=corporate" data-de-href="/de/videoproduktion-kosten-rechner/?type=corporate" data-es-href="/es/calculadora-costos-video/?type=corporate" style="color:var(--acid);text-decoration:underline;text-underline-offset:3px" data-en="calculate yours →" data-de="Ihren Preis berechnen →" data-es="calculá el tuyo →">{L(lang, "calculate yours →", "Ihren Preis berechnen →", "calculá el tuyo →")}</a></p>
  </div>
</section>

<!-- ============ WHAT YOU GET ============ -->
<section class="sec" id="what-you-get" style="padding-top:40px">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="What you get" data-de="Was Sie erhalten" data-es="Qué recibes">{L(lang, "What you get", "Was Sie erhalten", "Qué recibes")}</span>
      <h2 data-en="Every message. Every audience. One partner." data-de="Jede Botschaft. Jedes Publikum. Ein Partner." data-es="Cada mensaje. Cada audiencia. Un solo partner.">{L(lang, "Every message. Every audience. One partner.", "Jede Botschaft. Jedes Publikum. Ein Partner.", "Cada mensaje. Cada audiencia. Un solo partner.")}</h2>
      <p data-en="Corporate video is how modern companies talk — to their people and their market. Here's what we produce." data-de="Corporate Video ist, wie moderne Unternehmen kommunizieren — mit ihren Leuten und ihrem Markt. Das produzieren wir." data-es="El video corporativo es cómo hablan las empresas modernas — con su gente y su mercado. Esto es lo que producimos.">{L(lang, "Corporate video is how modern companies talk — to their people and their market. Here's what we produce.", "Corporate Video ist, wie moderne Unternehmen kommunizieren — mit ihren Leuten und ihrem Markt. Das produzieren wir.", "El video corporativo es cómo hablan las empresas modernas — con su gente y su mercado. Esto es lo que producimos.")}</p>
    </div>
    <div class="value-grid">
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
        <h3 data-en="Communication films" data-de="Kommunikationsfilme" data-es="Films de comunicación">{L(lang, "Communication films", "Kommunikationsfilme", "Films de comunicación")}</h3>
        <p data-en="Company stories, leadership messages and milestone films that carry your message with credibility." data-de="Unternehmensgeschichten, Führungsbotschaften und Meilenstein-Filme, die Ihre Botschaft glaubwürdig transportieren." data-es="Historias de empresa, mensajes de liderazgo y films de hitos que llevan tu mensaje con credibilidad.">{L(lang, "Company stories, leadership messages and milestone films that carry your message with credibility.", "Unternehmensgeschichten, Führungsbotschaften und Meilenstein-Filme, die Ihre Botschaft glaubwürdig transportieren.", "Historias de empresa, mensajes de liderazgo y films de hitos que llevan tu mensaje con credibilidad.")}</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg></div>
        <h3 data-en="Events &amp; keynotes" data-de="Events &amp; Keynotes" data-es="Eventos y keynotes">{L(lang, "Events &amp; keynotes", "Events &amp; Keynotes", "Eventos y keynotes")}</h3>
        <p data-en="Multi-camera event films, keynotes and aftermovies — with social-ready highlights, often by the next day." data-de="Multi-Kamera-Eventfilme, Keynotes und Aftermovies — mit Social-Highlights, oft schon am nächsten Tag." data-es="Films de eventos multicámara, keynotes y aftermovies — con highlights para redes, a menudo al día siguiente.">{L(lang, "Multi-camera event films, keynotes and aftermovies — with social-ready highlights, often by the next day.", "Multi-Kamera-Eventfilme, Keynotes und Aftermovies — mit Social-Highlights, oft schon am nächsten Tag.", "Films de eventos multicámara, keynotes y aftermovies — con highlights para redes, a menudo al día siguiente.")}</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg></div>
        <h3 data-en="Internal &amp; culture content" data-de="Interner &amp; Kultur-Content" data-es="Contenido interno y de cultura">{L(lang, "Internal &amp; culture content", "Interner &amp; Kultur-Content", "Contenido interno y de cultura")}</h3>
        <p data-en="Onboarding, town halls and culture films your teams actually watch to the end." data-de="Onboarding, Town Halls und Kulturfilme, die Ihre Teams wirklich bis zum Ende anschauen." data-es="Onboarding, town halls y films de cultura que tus equipos realmente miran hasta el final.">{L(lang, "Onboarding, town halls and culture films your teams actually watch to the end.", "Onboarding, Town Halls und Kulturfilme, die Ihre Teams wirklich bis zum Ende anschauen.", "Onboarding, town halls y films de cultura que tus equipos realmente miran hasta el final.")}</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 13 4 4L19 7"/></svg></div>
        <h3 data-en="Delivery-ready package" data-de="Lieferfertiges Paket" data-es="Paquete listo para publicar">{L(lang, "Delivery-ready package", "Lieferfertiges Paket", "Paquete listo para publicar")}</h3>
        <p data-en="Subtitles, language versions and formats for intranet, LinkedIn and event screens — ready to publish." data-de="Untertitel, Sprachversionen und Formate für Intranet, LinkedIn und Event-Screens — bereit zur Veröffentlichung." data-es="Subtítulos, versiones de idioma y formatos para intranet, LinkedIn y pantallas de evento — listos para publicar.">{L(lang, "Subtitles, language versions and formats for intranet, LinkedIn and event screens — ready to publish.", "Untertitel, Sprachversionen und Formate für Intranet, LinkedIn und Event-Screens — bereit zur Veröffentlichung.", "Subtítulos, versiones de idioma y formatos para intranet, LinkedIn y pantallas de evento — listos para publicar.")}</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ SELECTED WORK ============ -->
<section class="sec" id="work" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="Selected work" data-de="Ausgewählte Arbeiten" data-es="Trabajos seleccionados">{L(lang, "Selected work", "Ausgewählte Arbeiten", "Trabajos seleccionados")}</span>
      <h2 data-en="Corporate films we've made." data-de="Unternehmensfilme aus unserer Produktion." data-es="Films corporativos que hemos hecho.">{L(lang, "Corporate films we've made.", "Unternehmensfilme aus unserer Produktion.", "Films corporativos que hemos hecho.")}</h2>
      <p data-en="A few recent corporate and event productions. Hit play." data-de="Ein paar aktuelle Corporate- und Event-Produktionen. Einfach auf Play drücken." data-es="Algunas producciones corporativas y de eventos recientes. Dale play.">{L(lang, "A few recent corporate and event productions. Hit play.", "Ein paar aktuelle Corporate- und Event-Produktionen. Einfach auf Play drücken.", "Algunas producciones corporativas y de eventos recientes. Dale play.")}</p>
    </div>
    <VideoGallery cat="corporate" lang={lang} limit={9} />
    <div style="text-align:center;margin-top:44px" class="reveal">
      <a href={p("projects")} class="btn btn-ghost" data-en="See all projects" data-de="Alle Projekte ansehen" data-es="Ver todos los proyectos">{L(lang, "See all projects", "Alle Projekte ansehen", "Ver todos los proyectos")}</a>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="sec" style="padding-top:0;padding-bottom:0">
  <div class="wrap">
    <div class="stats reveal">
      <div class="stat"><div class="num">187</div><div class="lbl" data-en="Brands trusted us" data-de="Marken vertrauen uns" data-es="Marcas confiaron en nosotros">{L(lang, "Brands trusted us", "Marken vertrauen uns", "Marcas confiaron en nosotros")}</div></div>
      <div class="stat"><div class="num">3×</div><div class="lbl" data-en="More website visits for Siemens" data-de="Mehr Website-Besuche für Siemens" data-es="Más visitas web para Siemens">{L(lang, "More website visits for Siemens", "Mehr Website-Besuche für Siemens", "Más visitas web para Siemens")}</div></div>
      <div class="stat"><div class="num">47</div><div class="lbl" data-en="Five-star Google reviews" data-de="Fünf-Sterne-Google-Bewertungen" data-es="Reseñas de 5 estrellas en Google">{L(lang, "Five-star Google reviews", "Fünf-Sterne-Google-Bewertungen", "Reseñas de 5 estrellas en Google")}</div></div>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="sec" id="faq">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="FAQ" data-de="FAQ" data-es="FAQ">{L(lang, "FAQ", "FAQ", "FAQ")}</span>
      <h2 data-en="Corporate video questions, answered." data-de="Antworten auf Ihre Unternehmensfilm-Fragen." data-es="Preguntas sobre video corporativo, respondidas.">{L(lang, "Corporate video questions, answered.", "Antworten auf Ihre Unternehmensfilm-Fragen.", "Preguntas sobre video corporativo, respondidas.")}</h2>
    </div>
    <div class="faq reveal">
      <details>
        <summary data-en="How much does a corporate video cost?" data-de="Was kostet ein Unternehmensfilm?" data-es="¿Cuánto cuesta un video corporativo?">{L(lang, "How much does a corporate video cost?", "Was kostet ein Unternehmensfilm?", "¿Cuánto cuesta un video corporativo?")}</summary>
        <p data-en="It depends on scope — a single-camera interview film costs less than a multi-day event production. Most Viven projects range from CHF 4,000 to 80,000, and you always get a fixed, transparent quote before we start."
           data-de="Das hängt vom Umfang ab — ein Interviewfilm mit einer Kamera kostet weniger als eine mehrtägige Eventproduktion. Die meisten Viven-Projekte liegen zwischen CHF 4'000 und 80'000, und Sie erhalten immer ein fixes, transparentes Angebot, bevor wir starten."
           data-es="Depende del alcance — un film de entrevista a una cámara cuesta menos que una producción de evento de varios días. La mayoría de los proyectos de Viven van de CHF 4.000 a 80.000, y siempre recibís un presupuesto fijo y transparente antes de empezar.">{L(lang, "It depends on scope — a single-camera interview film costs less than a multi-day event production. Most Viven projects range from CHF 4,000 to 80,000, and you always get a fixed, transparent quote before we start.", "Das hängt vom Umfang ab — ein Interviewfilm mit einer Kamera kostet weniger als eine mehrtägige Eventproduktion. Die meisten Viven-Projekte liegen zwischen CHF 4'000 und 80'000, und Sie erhalten immer ein fixes, transparentes Angebot, bevor wir starten.", "Depende del alcance — un film de entrevista a una cámara cuesta menos que una producción de evento de varios días. La mayoría de los proyectos de Viven van de CHF 4.000 a 80.000, y siempre recibís un presupuesto fijo y transparente antes de empezar.")}</p>
      </details>
      <details>
        <summary data-en="Can you cover our event end to end?" data-de="Können Sie unser Event komplett begleiten?" data-es="¿Pueden cubrir nuestro evento de principio a fin?">{L(lang, "Can you cover our event end to end?", "Können Sie unser Event komplett begleiten?", "¿Pueden cubrir nuestro evento de principio a fin?")}</summary>
        <p data-en="Yes. We plan the coverage with you, film with a multi-camera crew, and deliver an aftermovie plus short social clips — often with first highlights ready the next day."
           data-de="Ja. Wir planen die Berichterstattung mit Ihnen, drehen mit einer Multi-Kamera-Crew und liefern einen Aftermovie plus kurze Social Clips — erste Highlights oft schon am nächsten Tag."
           data-es="Sí. Planificamos la cobertura con vos, filmamos con un equipo multicámara y entregamos un aftermovie más clips cortos para redes — a menudo con los primeros highlights listos al día siguiente.">{L(lang, "Yes. We plan the coverage with you, film with a multi-camera crew, and deliver an aftermovie plus short social clips — often with first highlights ready the next day.", "Ja. Wir planen die Berichterstattung mit Ihnen, drehen mit einer Multi-Kamera-Crew und liefern einen Aftermovie plus kurze Social Clips — erste Highlights oft schon am nächsten Tag.", "Sí. Planificamos la cobertura con vos, filmamos con un equipo multicámara y entregamos un aftermovie más clips cortos para redes — a menudo con los primeros highlights listos al día siguiente.")}</p>
      </details>
      <details>
        <summary data-en="Do you also produce internal communication videos?" data-de="Produzieren Sie auch interne Kommunikationsvideos?" data-es="¿También producen videos de comunicación interna?">{L(lang, "Do you also produce internal communication videos?", "Produzieren Sie auch interne Kommunikationsvideos?", "¿También producen videos de comunicación interna?")}</summary>
        <p data-en="Absolutely — leadership messages, town halls, onboarding and culture films. The same craft as our external work, tailored to what your teams actually watch."
           data-de="Unbedingt — Führungsbotschaften, Town Halls, Onboarding- und Kulturfilme. Dasselbe Handwerk wie bei unserer externen Arbeit, zugeschnitten auf das, was Ihre Teams wirklich anschauen."
           data-es="Por supuesto — mensajes de liderazgo, town halls, onboarding y films de cultura. El mismo oficio que nuestro trabajo externo, adaptado a lo que tus equipos realmente miran.">{L(lang, "Absolutely — leadership messages, town halls, onboarding and culture films. The same craft as our external work, tailored to what your teams actually watch.", "Unbedingt — Führungsbotschaften, Town Halls, Onboarding- und Kulturfilme. Dasselbe Handwerk wie bei unserer externen Arbeit, zugeschnitten auf das, was Ihre Teams wirklich anschauen.", "Por supuesto — mensajes de liderazgo, town halls, onboarding y films de cultura. El mismo oficio que nuestro trabajo externo, adaptado a lo que tus equipos realmente miran.")}</p>
      </details>
      <details>
        <summary data-en="Can you deliver versions for global teams?" data-de="Liefern Sie Versionen für globale Teams?" data-es="¿Entregan versiones para equipos globales?">{L(lang, "Can you deliver versions for global teams?", "Liefern Sie Versionen für globale Teams?", "¿Entregan versiones para equipos globales?")}</summary>
        <p data-en="Yes. Subtitles and language versions in English, German and Spanish are standard, and additional languages are straightforward — one production serves every office."
           data-de="Ja. Untertitel und Sprachversionen auf Deutsch, Englisch und Spanisch sind Standard, weitere Sprachen sind unkompliziert — eine Produktion bedient jeden Standort."
           data-es="Sí. Los subtítulos y versiones en inglés, alemán y español son estándar, y otros idiomas son sencillos — una producción sirve para todas las oficinas.">{L(lang, "Yes. Subtitles and language versions in English, German and Spanish are standard, and additional languages are straightforward — one production serves every office.", "Ja. Untertitel und Sprachversionen auf Deutsch, Englisch und Spanisch sind Standard, weitere Sprachen sind unkompliziert — eine Produktion bedient jeden Standort.", "Sí. Los subtítulos y versiones en inglés, alemán y español son estándar, y otros idiomas son sencillos — una producción sirve para todas las oficinas.")}</p>
      </details>
    </div>
  </div>
</section>


<Testimonials lang={lang} cat="corporate" />

<CalcBanner lang={lang} type="corporate" />

<!-- ============ CTA / FORM ============ -->
<RelatedPosts lang={lang} match={/corporate|corporativo/i} />

<section class="cta" id="start" style="padding-top:0">
  <div class="wrap">
    <div class="cta-card reveal">
      <div>
        <span class="eyebrow" data-en="Let's talk" data-de="Sprechen wir" data-es="Hablemos">{L(lang, "Let's talk", "Sprechen wir", "Hablemos")}</span>
        <h2 data-en="Tell us what you're working on." data-de="Erzählen Sie uns von Ihrem Projekt." data-es="Contanos en qué estás trabajando.">{L(lang, "Tell us what you're working on.", "Erzählen Sie uns von Ihrem Projekt.", "Contanos en qué estás trabajando.")}</h2>
        <p class="lead" data-en="Tell us your goal — we'll come back with timing and a clear quote within 48 hours. Free, no obligation." data-de="Nennen Sie uns Ihr Ziel — wir melden uns innert 48 Stunden mit Timing und einem klaren Angebot. Kostenlos und unverbindlich." data-es="Contanos tu objetivo — volvemos en 48 horas con tiempos y un presupuesto claro. Gratis y sin compromiso.">{L(lang, "Tell us your goal — we'll come back with timing and a clear quote within 48 hours. Free, no obligation.", "Nennen Sie uns Ihr Ziel — wir melden uns innert 48 Stunden mit Timing und einem klaren Angebot. Kostenlos und unverbindlich.", "Contanos tu objetivo — volvemos en 48 horas con tiempos y un presupuesto claro. Gratis y sin compromiso.")}</p>
