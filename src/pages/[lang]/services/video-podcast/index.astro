---
import RelatedPosts from '../../../../components/RelatedPosts.astro';
import Base from '../../../../layouts/Base.astro';
import FaqBuyer from '../../../../components/FaqBuyer.astro';
import Testimonials from '../../../../components/Testimonials.astro';
import VideoGallery from '../../../../components/VideoGallery.astro';
import { langPaths, localePath, L } from '../../../../i18n.js';
export const getStaticPaths = langPaths;
const { lang } = Astro.params;
const p = (s) => localePath(lang, s);
const title = {"en":"Video podcast production Zurich — branded shows | Viven","de":"Video-Podcast-Produktion Zürich — Branded Shows | Viven","es":"Producción de video podcasts en Zúrich — shows de marca | Viven"};
const description = {"en":"Video podcast and branded show production in Zurich. Record a season in batches and leave with the full episodes plus the vertical cuts for social. Built by the team behind FIFA's Living Football.","de":"Video-Podcast- und Branded-Show-Produktion in Zürich. Ganze Staffeln am Stück aufnehmen — inklusive der vertikalen Cuts für Social. Vom Team hinter FIFAs Living Football.","es":"Producción de video podcasts y shows de marca en Zúrich. Grabá una temporada en tandas y llevate los episodios completos más los cortes verticales para redes. Del equipo detrás de Living Football de FIFA."};
---
<Base lang={lang} slug="services/video-podcast" active="services" activeSub="podcast" title={title} description={description}>
  <script type="application/ld+json" slot="jsonld" set:html={"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Service\",\"@id\":\"https://www.viven.ch/services/video-podcast/#service\",\"name\":\"Video Podcast and Branded Show Production\",\"serviceType\":\"Video podcast, branded show and episodic series production\",\"description\":\"Video podcast and branded show production in Zurich: multi-camera studio, batch recording of full seasons, and vertical cuts for social delivered with every episode. Produced by Viven — the team behind FIFA's Living Football magazine show.\",\"url\":\"https://www.viven.ch/services/video-podcast/\",\"provider\":{\"@id\":\"https://www.viven.ch/#organization\"},\"areaServed\":[\"CH\",\"Europe\"]},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.viven.ch/services/video-podcast/#breadcrumbs\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.viven.ch/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Services\",\"item\":\"https://www.viven.ch/services/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Video Podcasts\",\"item\":\"https://www.viven.ch/services/video-podcast/\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://www.viven.ch/services/video-podcast/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Where do we record a video podcast?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Wherever the show works best: a set we build for you, your own office, or on location. For FIFA we built a full custom set at their Zurich headquarters — five broadcast cameras, a slider and Arri Skypanels — because the show had to look like the organisation behind it.\"}},{\"@type\":\"Question\",\"name\":\"How many episodes can we record in one day?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Two full-length episodes a day is realistic once the format is set. We started FIFA's Living Football at one 40-minute episode every two days and doubled that as the workflow settled, which is why we plan seasons rather than single episodes.\"}},{\"@type\":\"Question\",\"name\":\"Can a video podcast be streamed live?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Graphics and live streaming were fully integrated into the FIFA set-up, so episodes could go out across platforms with a finished look. The same rig works for a live launch, a town hall or a hybrid event.\"}},{\"@type\":\"Question\",\"name\":\"Do the social clips come with the episode?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Every episode is delivered with its short vertical cuts and subtitles. They are planned before the shoot: framing and pacing for vertical are decided on set, not rescued in the edit.\"}}]}]}"}></script>
<!-- ============ PAGE HERO ============ -->
<section class="page-hero has-video">
  <div class="hero-bg" data-vimeo="846518774" data-mp4="/assets/heroes/846518774.mp4"><img class="reel" src="/assets/heroes/service-video-podcast.jpg" width="1600" height="900" alt="" fetchpriority="high" decoding="async" /><div class="grain"></div></div>
  <div class="hero-overlay"></div>
  <div class="wrap">
    <div class="crumbs">
      <a href={p("")} data-en="Home" data-de="Home" data-es="Inicio">{L(lang, "Home", "Home", "Inicio")}</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href={p("services")} data-en="Services" data-de="Leistungen" data-es="Servicios">{L(lang, "Services", "Leistungen", "Servicios")}</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span data-en="Video Podcasts" data-de="Video-Podcasts" data-es="Video podcasts">{L(lang, "Video Podcasts", "Video-Podcasts", "Video podcasts")}</span>
    </div>
    <span class="eyebrow" data-en="Video podcasts &amp; branded shows — Zurich, Switzerland" data-de="Video-Podcasts &amp; Branded Shows — Zürich, Schweiz" data-es="Video podcasts y shows de marca — Zúrich, Suiza">{L(lang, "Video podcasts &amp; branded shows — Zurich, Switzerland", "Video-Podcasts &amp; Branded Shows — Zürich, Schweiz", "Video podcasts y shows de marca — Zúrich, Suiza")}</span>
    <h1 data-en='One recording day. <span class="hl">A month of content.</span>'
        data-de='Ein Drehtag. <span class="hl">Ein Monat Content.</span>'
        data-es='Un día de grabación. <span class="hl">Un mes de contenido.</span>'><Fragment set:html={L(lang, `One recording day. <span class="hl">A month of content.</span>`, `Ein Drehtag. <span class="hl">Ein Monat Content.</span>`, `Un día de grabación. <span class="hl">Un mes de contenido.</span>`)} /></h1>
    <p class="lead"
       data-en="Record several episodes back to back and walk out with the full show plus the vertical cuts for social. One set-up, one crew, a content calendar that fills itself."
       data-de="Mehrere Folgen am Stück aufnehmen und mit der ganzen Show plus den vertikalen Cuts für Social rausgehen. Ein Aufbau, ein Team, ein Content-Kalender, der sich selbst füllt."
       data-es="Grabá varios episodios seguidos y salí con el programa completo más los cortes verticales para redes. Un solo armado, un solo equipo, un calendario de contenido que se llena solo.">{L(lang, "Record several episodes back to back and walk out with the full show plus the vertical cuts for social. One set-up, one crew, a content calendar that fills itself.", "Mehrere Folgen am Stück aufnehmen und mit der ganzen Show plus den vertikalen Cuts für Social rausgehen. Ein Aufbau, ein Team, ein Content-Kalender, der sich selbst füllt.", "Grabá varios episodios seguidos y salí con el programa completo más los cortes verticales para redes. Un solo armado, un solo equipo, un calendario de contenido que se llena solo.")}</p>
    <div class="hero-cta">
      <a href="#start" class="btn btn-primary" data-en="Plan a season" data-de="Staffel planen" data-es="Planear una temporada">{L(lang, "Plan a season", "Staffel planen", "Planear una temporada")}</a>
      <a href="#work" class="btn btn-ghost" data-en="See the episodes" data-de="Folgen ansehen" data-es="Ver los episodios">{L(lang, "See the episodes", "Folgen ansehen", "Ver los episodios")}</a>
    </div>
  </div>
</section>

<!-- ============ WHAT YOU GET ============ -->
<section class="sec" id="value">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="What you get" data-de="Was Sie bekommen" data-es="Qué obtenés">{L(lang, "What you get", "Was Sie bekommen", "Qué obtenés")}</span>
      <h2 data-en="Shoot once. Publish for weeks."
          data-de="Einmal drehen. Wochenlang publizieren."
          data-es="Grabá una vez. Publicá durante semanas.">{L(lang, "Shoot once. Publish for weeks.", "Einmal drehen. Wochenlang publizieren.", "Grabá una vez. Publicá durante semanas.")}</h2>
      <p data-en="A podcast is not one video. It is a long episode, a trailer, six vertical clips and an audio track — all from the same afternoon."
         data-de="Ein Podcast ist nicht ein Video. Er ist eine lange Folge, ein Trailer, sechs vertikale Clips und eine Audiospur — alles aus demselben Nachmittag."
         data-es="Un podcast no es un video. Es un episodio largo, un tráiler, seis clips verticales y una pista de audio — todo de la misma tarde.">{L(lang, "A podcast is not one video. It is a long episode, a trailer, six vertical clips and an audio track — all from the same afternoon.", "Ein Podcast ist nicht ein Video. Er ist eine lange Folge, ein Trailer, sechs vertikale Clips und eine Audiospur — alles aus demselben Nachmittag.", "Un podcast no es un video. Es un episodio largo, un tráiler, seis clips verticales y una pista de audio — todo de la misma tarde.")}</p>
    </div>
    <div class="value-grid">
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3v4M8 3v4"/></svg></div>
        <h3 data-en="Batch recording" data-de="Aufnahme am Stück" data-es="Grabación en tanda">{L(lang, "Batch recording", "Aufnahme am Stück", "Grabación en tanda")}</h3>
        <p data-en="Your guests come once and you record several episodes in a row. That rhythm is what makes a whole season affordable instead of a series of one-offs." data-de="Ihre Gäste kommen einmal, und Sie nehmen mehrere Folgen hintereinander auf. Dieser Rhythmus macht eine ganze Staffel bezahlbar statt einer Reihe von Einzelproduktionen." data-es="Tus invitados vienen una vez y grabás varios episodios seguidos. Ese ritmo es lo que hace que una temporada entera sea accesible, en vez de una serie de producciones sueltas.">{L(lang, "Your guests come once and you record several episodes in a row. That rhythm is what makes a whole season affordable instead of a series of one-offs.", "Ihre Gäste kommen einmal, und Sie nehmen mehrere Folgen hintereinander auf. Dieser Rhythmus macht eine ganze Staffel bezahlbar statt einer Reihe von Einzelproduktionen.", "Tus invitados vienen una vez y grabás varios episodios seguidos. Ese ritmo es lo que hace que una temporada entera sea accesible, en vez de una serie de producciones sueltas.")}</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></div>
        <h3 data-en="Verticals come included" data-de="Vertikale Cuts inklusive" data-es="Los verticales vienen incluidos">{L(lang, "Verticals come included", "Vertikale Cuts inklusive", "Los verticales vienen incluidos")}</h3>
        <p data-en="Every episode ships with its short cuts for LinkedIn, Instagram and TikTok — framed for vertical while shooting, not badly cropped afterwards." data-de="Jede Folge kommt mit ihren kurzen Cuts für LinkedIn, Instagram und TikTok — beim Dreh vertikal kadriert, nicht nachträglich schlecht beschnitten." data-es="Cada episodio se entrega con sus cortes cortos para LinkedIn, Instagram y TikTok — encuadrados en vertical durante la grabación, no recortados mal después.">{L(lang, "Every episode ships with its short cuts for LinkedIn, Instagram and TikTok — framed for vertical while shooting, not badly cropped afterwards.", "Jede Folge kommt mit ihren kurzen Cuts für LinkedIn, Instagram und TikTok — beim Dreh vertikal kadriert, nicht nachträglich schlecht beschnitten.", "Cada episodio se entrega con sus cortes cortos para LinkedIn, Instagram y TikTok — encuadrados en vertical durante la grabación, no recortados mal después.")}</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg></div>
        <h3 data-en="Cost per episode goes down" data-de="Kosten pro Folge sinken" data-es="El costo por episodio baja">{L(lang, "Cost per episode goes down", "Kosten pro Folge sinken", "El costo por episodio baja")}</h3>
        <p data-en="Set, graphics and format are built once. The tenth episode costs a fraction of the first, and we quote the season with a clear per-episode price." data-de="Set, Grafik und Format entstehen einmal. Die zehnte Folge kostet einen Bruchteil der ersten, und wir offerieren die Staffel mit einem klaren Preis pro Folge." data-es="El set, los gráficos y el formato se hacen una sola vez. El décimo episodio cuesta una fracción del primero, y cotizamos la temporada con un precio por episodio claro.">{L(lang, "Set, graphics and format are built once. The tenth episode costs a fraction of the first, and we quote the season with a clear per-episode price.", "Set, Grafik und Format entstehen einmal. Die zehnte Folge kostet einen Bruchteil der ersten, und wir offerieren die Staffel mit einem klaren Preis pro Folge.", "El set, los gráficos y el formato se hacen una sola vez. El décimo episodio cuesta una fracción del primero, y cotizamos la temporada con un precio por episodio claro.")}</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg></div>
        <h3 data-en="Broadcast gear, your budget" data-de="Broadcast-Technik, Ihr Budget" data-es="Equipo broadcast, tu presupuesto">{L(lang, "Broadcast gear, your budget", "Broadcast-Technik, Ihr Budget", "Equipo broadcast, tu presupuesto")}</h3>
        <p data-en="Multi-camera, proper lighting and audio that survives headphones. We scale the same rig we build for broadcast shows down to what your format actually needs." data-de="Mehrkamera, richtiges Licht und Ton, der auch über Kopfhörer besteht. Wir skalieren dasselbe Setup, das wir für Broadcast-Shows bauen, auf das herunter, was Ihr Format wirklich braucht." data-es="Multicámara, luz de verdad y audio que sobrevive a los auriculares. Escalamos el mismo equipo que armamos para shows de broadcast a lo que tu formato realmente necesita.">{L(lang, "Multi-camera, proper lighting and audio that survives headphones. We scale the same rig we build for broadcast shows down to what your format actually needs.", "Mehrkamera, richtiges Licht und Ton, der auch über Kopfhörer besteht. Wir skalieren dasselbe Setup, das wir für Broadcast-Shows bauen, auf das herunter, was Ihr Format wirklich braucht.", "Multicámara, luz de verdad y audio que sobrevive a los auriculares. Escalamos el mismo equipo que armamos para shows de broadcast a lo que tu formato realmente necesita.")}</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ WORK ============ -->
<section class="sec" id="work" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="What we can do for you" data-de="Was wir für Sie tun können" data-es="Lo que podemos hacer por vos">{L(lang, "What we can do for you", "Was wir für Sie tun können", "Lo que podemos hacer por vos")}</span>
      <h2 data-en="The bar we work to." data-de="Der Massstab, an dem wir arbeiten." data-es="La vara con la que trabajamos.">{L(lang, "The bar we work to.", "Der Massstab, an dem wir arbeiten.", "La vara con la que trabajamos.")}</h2>
      <p data-en="FIFA asked for a magazine show and we built the studio for it: five broadcast cameras, a slider, Arri Skypanels and a live editing suite at their Zurich headquarters. Two seasons, 36 episodes — and we went from one 40-minute episode every two days to two a day. That is the level we bring to a season, scaled to your format and your budget."
         data-de="Die FIFA wollte eine Magazinshow, und wir bauten das Studio dafür: fünf Broadcast-Kameras, ein Slider, Arri Skypanels und eine Live-Schnitt-Suite in ihrem Zürcher Hauptquartier. Zwei Staffeln, 36 Folgen — und aus einer 40-Minuten-Folge alle zwei Tage wurden zwei pro Tag. Dieses Niveau bringen wir in eine Staffel ein, skaliert auf Ihr Format und Ihr Budget."
         data-es="La FIFA pidió un programa magazine y le construimos el estudio: cinco cámaras broadcast, un slider, Arri Skypanels y una suite de edición en vivo en su sede de Zúrich. Dos temporadas, 36 episodios — y pasamos de un episodio de 40 minutos cada dos días a dos por día. Ese es el nivel que traemos a una temporada, escalado a tu formato y a tu presupuesto.">{L(lang, "FIFA asked for a magazine show and we built the studio for it: five broadcast cameras, a slider, Arri Skypanels and a live editing suite at their Zurich headquarters. Two seasons, 36 episodes — and we went from one 40-minute episode every two days to two a day. That is the level we bring to a season, scaled to your format and your budget.", "Die FIFA wollte eine Magazinshow, und wir bauten das Studio dafür: fünf Broadcast-Kameras, ein Slider, Arri Skypanels und eine Live-Schnitt-Suite in ihrem Zürcher Hauptquartier. Zwei Staffeln, 36 Folgen — und aus einer 40-Minuten-Folge alle zwei Tage wurden zwei pro Tag. Dieses Niveau bringen wir in eine Staffel ein, skaliert auf Ihr Format und Ihr Budget.", "La FIFA pidió un programa magazine y le construimos el estudio: cinco cámaras broadcast, un slider, Arri Skypanels y una suite de edición en vivo en su sede de Zúrich. Dos temporadas, 36 episodios — y pasamos de un episodio de 40 minutos cada dos días a dos por día. Ese es el nivel que traemos a una temporada, escalado a tu formato y a tu presupuesto.")}</p>
    </div>
    <VideoGallery cat="podcast" lang={lang} limit={9} />
    <div style="text-align:center;margin-top:44px" class="reveal">
      <a href={p("projects")} class="btn btn-ghost" data-en="See all projects" data-de="Alle Projekte ansehen" data-es="Ver todos los proyectos">{L(lang, "See all projects", "Alle Projekte ansehen", "Ver todos los proyectos")}</a>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="stats reveal">
      <div class="stat"><div class="num">36</div><div class="lbl" data-en="Episodes across 2 seasons" data-de="Folgen in 2 Staffeln" data-es="Episodios en 2 temporadas">{L(lang, "Episodes across 2 seasons", "Folgen in 2 Staffeln", "Episodios en 2 temporadas")}</div></div>
      <div class="stat"><div class="num">40′</div><div class="lbl" data-en="Per episode, start to finish" data-de="Pro Folge, von A bis Z" data-es="Por episodio, de punta a punta">{L(lang, "Per episode, start to finish", "Pro Folge, von A bis Z", "Por episodio, de punta a punta")}</div></div>
      <div class="stat"><div class="num">2×</div><div class="lbl" data-en="Output after workflow tuning" data-de="Output nach optimiertem Workflow" data-es="Producción tras afinar el workflow">{L(lang, "Output after workflow tuning", "Output nach optimiertem Workflow", "Producción tras afinar el workflow")}</div></div>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="sec" id="faq" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="FAQ" data-de="FAQ" data-es="FAQ">{L(lang, "FAQ", "FAQ", "FAQ")}</span>
      <h2 data-en="Video podcasts, answered." data-de="Video-Podcasts, beantwortet." data-es="Video podcasts, respondido.">{L(lang, "Video podcasts, answered.", "Video-Podcasts, beantwortet.", "Video podcasts, respondido.")}</h2>
    </div>
    <div class="faq reveal">
      <details>
        <summary data-en="Where do we record?" data-de="Wo wird aufgenommen?" data-es="¿Dónde se graba?">{L(lang, "Where do we record?", "Wo wird aufgenommen?", "¿Dónde se graba?")}</summary>
        <p data-en="Wherever the show works best: a set we build for you, your own office, or on location. For FIFA we built a full custom set at their Zurich headquarters — five cameras, slider, Arri Skypanels — because the show had to look like the organisation behind it."
           data-de="Dort, wo die Show am besten funktioniert: ein Set, das wir für Sie bauen, Ihr eigenes Büro oder eine Location. Für die FIFA bauten wir ein komplett massgeschneidertes Set in ihrem Zürcher Hauptquartier — fünf Kameras, Slider, Arri Skypanels — weil die Show aussehen musste wie die Organisation dahinter."
           data-es="Donde el programa funcione mejor: un set que armamos para vos, tu propia oficina o una locación. Para la FIFA construimos un set a medida completo en su sede de Zúrich — cinco cámaras, slider, Arri Skypanels — porque el programa tenía que parecerse a la organización que estaba detrás.">{L(lang, "Wherever the show works best: a set we build for you, your own office, or on location. For FIFA we built a full custom set at their Zurich headquarters — five cameras, slider, Arri Skypanels — because the show had to look like the organisation behind it.", "Dort, wo die Show am besten funktioniert: ein Set, das wir für Sie bauen, Ihr eigenes Büro oder eine Location. Für die FIFA bauten wir ein komplett massgeschneidertes Set in ihrem Zürcher Hauptquartier — fünf Kameras, Slider, Arri Skypanels — weil die Show aussehen musste wie die Organisation dahinter.", "Donde el programa funcione mejor: un set que armamos para vos, tu propia oficina o una locación. Para la FIFA construimos un set a medida completo en su sede de Zúrich — cinco cámaras, slider, Arri Skypanels — porque el programa tenía que parecerse a la organización que estaba detrás.")}</p>
      </details>
      <details>
        <summary data-en="How many episodes can we record in one day?" data-de="Wie viele Folgen schaffen wir an einem Tag?" data-es="¿Cuántos episodios se graban en un día?">{L(lang, "How many episodes can we record in one day?", "Wie viele Folgen schaffen wir an einem Tag?", "¿Cuántos episodios se graban en un día?")}</summary>
        <p data-en="Two full-length episodes a day is realistic once the format is set. We started FIFA's series at one 40-minute episode every two days and doubled that as the workflow settled — which is exactly why we plan seasons, not single episodes."
           data-de="Zwei Folgen in voller Länge pro Tag sind realistisch, sobald das Format steht. Die FIFA-Serie startete mit einer 40-Minuten-Folge alle zwei Tage; mit eingespieltem Workflow verdoppelten wir das — genau deshalb planen wir Staffeln und nicht Einzelfolgen."
           data-es="Dos episodios completos por día es realista una vez que el formato está definido. La serie de la FIFA arrancó con un episodio de 40 minutos cada dos días y lo duplicamos cuando el workflow se asentó — por eso planificamos temporadas y no episodios sueltos.">{L(lang, "Two full-length episodes a day is realistic once the format is set. We started FIFA's series at one 40-minute episode every two days and doubled that as the workflow settled — which is exactly why we plan seasons, not single episodes.", "Zwei Folgen in voller Länge pro Tag sind realistisch, sobald das Format steht. Die FIFA-Serie startete mit einer 40-Minuten-Folge alle zwei Tage; mit eingespieltem Workflow verdoppelten wir das — genau deshalb planen wir Staffeln und nicht Einzelfolgen.", "Dos episodios completos por día es realista una vez que el formato está definido. La serie de la FIFA arrancó con un episodio de 40 minutos cada dos días y lo duplicamos cuando el workflow se asentó — por eso planificamos temporadas y no episodios sueltos.")}</p>
      </details>
      <details>
        <summary data-en="Can it be streamed live?" data-de="Kann live gestreamt werden?" data-es="¿Se puede transmitir en vivo?">{L(lang, "Can it be streamed live?", "Kann live gestreamt werden?", "¿Se puede transmitir en vivo?")}</summary>
        <p data-en="Yes. Graphics and live streaming were fully integrated into the FIFA set-up, so episodes could go out across platforms with a finished look. The same rig works for a live launch, a town hall or a hybrid event."
           data-de="Ja. Grafik und Livestreaming waren im FIFA-Setup vollständig integriert, sodass die Folgen plattformübergreifend mit fertigem Look ausgespielt werden konnten. Dasselbe Setup funktioniert für einen Live-Launch, ein Town Hall oder ein hybrides Event."
           data-es="Sí. Los gráficos y el streaming en vivo estaban totalmente integrados en el armado de la FIFA, así que los episodios podían salir en varias plataformas con un acabado terminado. El mismo equipo sirve para un lanzamiento en vivo, un town hall o un evento híbrido.">{L(lang, "Yes. Graphics and live streaming were fully integrated into the FIFA set-up, so episodes could go out across platforms with a finished look. The same rig works for a live launch, a town hall or a hybrid event.", "Ja. Grafik und Livestreaming waren im FIFA-Setup vollständig integriert, sodass die Folgen plattformübergreifend mit fertigem Look ausgespielt werden konnten. Dasselbe Setup funktioniert für einen Live-Launch, ein Town Hall oder ein hybrides Event.", "Sí. Los gráficos y el streaming en vivo estaban totalmente integrados en el armado de la FIFA, así que los episodios podían salir en varias plataformas con un acabado terminado. El mismo equipo sirve para un lanzamiento en vivo, un town hall o un evento híbrido.")}</p>
      </details>
      <details>
        <summary data-en="Do the social clips come with it?" data-de="Sind die Social-Clips dabei?" data-es="¿Los clips para redes vienen incluidos?">{L(lang, "Do the social clips come with it?", "Sind die Social-Clips dabei?", "¿Los clips para redes vienen incluidos?")}</summary>
        <p data-en="Yes. Every episode is delivered with its short vertical cuts and subtitles. They are planned before the shoot — framing and pacing for vertical are decided on set, not rescued in the edit."
