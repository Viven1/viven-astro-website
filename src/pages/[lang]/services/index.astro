---
import RelatedPosts from '../../../components/RelatedPosts.astro';
import Base from '../../../layouts/Base.astro';
import Testimonials from '../../../components/Testimonials.astro';
import CalcBanner from '../../../components/CalcBanner.astro';
import { langPaths, localePath, L } from '../../../i18n.js';
export const getStaticPaths = langPaths;
const { lang } = Astro.params;
const p = (s) => localePath(lang, s);
const calcHref = { en: '/en/video-cost-calculator/', de: '/de/videoproduktion-kosten-rechner/', es: '/es/calculadora-costos-video/' };
const title = {"en":"Video Production Services Zurich — Brand to Social | Viven","de":"Videoproduktion Leistungen Zürich — Marke bis Social | Viven","es":"Servicios de producción de video en Zúrich | Viven"};
const description = {"en":"Brand, product, employer-branding, how-to, social, corporate video and video podcasts — one Zurich production partner, one accountable team, end to end. Trusted by 187 brands.","de":"Imagefilme, Produkt-, Employer-Branding-, How-To-, Social- und Unternehmensfilme sowie Video-Podcasts — ein Produktionspartner in Zürich. 187 Marken vertrauen uns.","es":"Videos de marca, producto, employer branding, tutoriales, social, corporativos y video podcasts — un solo partner de producción en Zúrich. 187 marcas confían en nosotros."};
---
<Base lang={lang} slug="services" active="services" title={title} description={description}>
  <script type="application/ld+json" slot="jsonld" set:html={"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"ItemList\",\"@id\":\"https://www.viven.ch/services/#services\",\"name\":\"Video production services by Viven\",\"description\":\"Video production services offered by Viven AG in Zurich, Switzerland: brand, product, employer-branding, how-to, social media and corporate video.\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Brand Video Production\",\"url\":\"https://www.viven.ch/services/brand-video/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Product Video Production\",\"url\":\"https://www.viven.ch/services/product-video/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Employer Branding Video\",\"url\":\"https://www.viven.ch/services/employer-branding/\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"How-To & Tutorial Video\",\"url\":\"https://www.viven.ch/services/how-to-video/\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Social Media Video\",\"url\":\"https://www.viven.ch/services/social-media-video/\"},{\"@type\":\"ListItem\",\"position\":6,\"name\":\"Corporate & Event Video\",\"url\":\"https://www.viven.ch/services/corporate-video/\"},{\"@type\":\"ListItem\",\"position\":7,\"name\":\"Video Podcast Production\",\"url\":\"https://www.viven.ch/services/video-podcast/\"}]},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.viven.ch/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Services\",\"item\":\"https://www.viven.ch/services/\"}]}]}"}></script>
<!-- ============ PAGE HERO ============ -->
<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={p("")} data-en="Home" data-de="Home" data-es="Inicio">{L(lang, "Home", "Home", "Inicio")}</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span data-en="Services" data-de="Leistungen" data-es="Servicios">{L(lang, "Services", "Leistungen", "Servicios")}</span>
    </nav>
    <span class="eyebrow" data-en="Our services" data-de="Unsere Leistungen" data-es="Nuestros servicios">{L(lang, "Our services", "Unsere Leistungen", "Nuestros servicios")}</span>
    <h1 data-en='Every video your brand needs. <span class="hl">One partner.</span>'
        data-de='Jedes Video, das Ihre Marke braucht. <span class="hl">Ein Partner.</span>'
        data-es='Cada video que tu marca necesita. <span class="hl">Un solo partner.</span>'><Fragment set:html={L(lang, `Every video your brand needs. <span class="hl">One partner.</span>`, `Jedes Video, das Ihre Marke braucht. <span class="hl">Ein Partner.</span>`, `Cada video que tu marca necesita. <span class="hl">Un solo partner.</span>`)} /></h1>
    <p class="lead"
       data-en="From brand films to social series — strategy, production and post, end to end from Zurich. Trusted by UBS, Siemens, Porsche and ON."
       data-de="Von Imagefilmen bis Social-Serien — Strategie, Produktion und Post, end to end aus Zürich. Im Einsatz für UBS, Siemens, Porsche und ON."
       data-es="De films de marca a series para redes — estrategia, producción y post, de principio a fin en Zúrich. Con la confianza de UBS, Siemens, Porsche y ON.">{L(lang, "From brand films to social series — strategy, production and post, end to end from Zurich. Trusted by UBS, Siemens, Porsche and ON.", "Von Imagefilmen bis Social-Serien — Strategie, Produktion und Post, end to end aus Zürich. Im Einsatz für UBS, Siemens, Porsche und ON.", "De films de marca a series para redes — estrategia, producción y post, de principio a fin en Zúrich. Con la confianza de UBS, Siemens, Porsche y ON.")}</p>
    <div class="hero-cta">
      <a href={p("contact")} class="btn btn-primary" data-en="Start a project" data-de="Projekt starten" data-es="Iniciar proyecto">{L(lang, "Start a project", "Projekt starten", "Iniciar proyecto")}</a>
      <a href={calcHref[lang]} class="btn btn-ghost" data-en-href="/en/video-cost-calculator/" data-de-href="/de/videoproduktion-kosten-rechner/" data-es-href="/es/calculadora-costos-video/" data-en="Get a price in 60 seconds" data-de="Preis in 60 Sekunden" data-es="Precio en 60 segundos">{L(lang, "Get a price in 60 seconds", "Preis in 60 Sekunden", "Precio en 60 segundos")}</a>
    </div>
    <p class="hero-price-note" style="margin-top:16px;font-size:14px;color:var(--muted)">💰 <span data-en="Typical projects: CHF 3'500–17'000" data-de="Typische Projekte: CHF 3'500–17'000" data-es="Proyectos típicos: CHF 3'500–17'000">{L(lang, "Typical projects: CHF 3'500–17'000", "Typische Projekte: CHF 3'500–17'000", "Proyectos típicos: CHF 3'500–17'000")}</span> · <a href={calcHref[lang]} data-en-href="/en/video-cost-calculator/" data-de-href="/de/videoproduktion-kosten-rechner/" data-es-href="/es/calculadora-costos-video/" style="color:var(--acid);text-decoration:underline;text-underline-offset:3px" data-en="calculate yours →" data-de="Ihren Preis berechnen →" data-es="calculá el tuyo →">{L(lang, "calculate yours →", "Ihren Preis berechnen →", "calculá el tuyo →")}</a></p>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="sec" id="services" style="padding-top:40px">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="What we make" data-de="Was wir machen" data-es="Qué hacemos">{L(lang, "What we make", "Was wir machen", "Qué hacemos")}</span>
      <h2 data-en="Seven services. One team, end to end." data-de="Sieben Leistungen. Ein Team, end to end." data-es="Siete servicios. Un solo equipo, de principio a fin.">{L(lang, "Seven services. One team, end to end.", "Sieben Leistungen. Ein Team, end to end.", "Siete servicios. Un solo equipo, de principio a fin.")}</h2>
      <p data-en="Strategy, production and post under one roof — so nothing gets lost between agencies." data-de="Strategie, Produktion und Post unter einem Dach — damit nichts zwischen Agenturen verloren geht." data-es="Estrategia, producción y post bajo un mismo techo — para que nada se pierda entre agencias.">{L(lang, "Strategy, production and post under one roof — so nothing gets lost between agencies.", "Strategie, Produktion und Post unter einem Dach — damit nichts zwischen Agenturen verloren geht.", "Estrategia, producción y post bajo un mismo techo — para que nada se pierda entre agencias.")}</p>
    </div>
    <div class="services three">
      <a href={p("services/brand-video")} class="service reveal">
        <div class="thumb g-blue"></div>
        <div class="body">
          <span class="tag" data-en="Brand Videos" data-de="Imagefilme" data-es="Videos de marca">{L(lang, "Brand Videos", "Imagefilme", "Videos de marca")}</span>
          <h3 data-en="Films that carry the campaign" data-de="Filme, die die Kampagne tragen" data-es="Films que sostienen la campaña">{L(lang, "Films that carry the campaign", "Filme, die die Kampagne tragen", "Films que sostienen la campaña")}</h3>
          <p data-en="High-impact brand films made to perform across paid media, social and your website." data-de="Wirkungsstarke Imagefilme für Paid Media, Social und Ihre Website." data-es="Films de marca de alto impacto para paid media, social y tu web.">{L(lang, "High-impact brand films made to perform across paid media, social and your website.", "Wirkungsstarke Markenfilme für Paid Media, Social und Ihre Website.", "Films de marca de alto impacto para paid media, social y tu web.")}</p>
          <span class="more" data-en="Learn more →" data-de="Mehr erfahren →" data-es="Ver más →">{L(lang, "Learn more →", "Mehr erfahren →", "Ver más →")}</span>
        </div>
      </a>
      <a href={p("services/product-video")} class="service reveal">
        <div class="thumb g-pink"></div>
        <div class="body">
          <span class="tag" data-en="Product Videos" data-de="Produktvideos" data-es="Videos de producto">{L(lang, "Product Videos", "Produktvideos", "Videos de producto")}</span>
          <h3 data-en="Make products sell themselves" data-de="Produkte, die sich selbst verkaufen" data-es="Productos que se venden solos">{L(lang, "Make products sell themselves", "Produkte, die sich selbst verkaufen", "Productos que se venden solos")}</h3>
          <p data-en="Product films and launch videos that turn features into desire — and clicks into buyers." data-de="Produktfilme und Launch-Videos, die Features in Begehren verwandeln — und Klicks in Käufer." data-es="Films de producto y lanzamientos que convierten características en deseo — y clics en compradores.">{L(lang, "Product films and launch videos that turn features into desire — and clicks into buyers.", "Produktfilme und Launch-Videos, die Features in Begehren verwandeln — und Klicks in Käufer.", "Films de producto y lanzamientos que convierten características en deseo — y clics en compradores.")}</p>
          <span class="more" data-en="Learn more →" data-de="Mehr erfahren →" data-es="Ver más →">{L(lang, "Learn more →", "Mehr erfahren →", "Ver más →")}</span>
        </div>
      </a>
      <a href={p("services/employer-branding")} class="service reveal">
        <div class="thumb g-acid"></div>
        <div class="body">
          <span class="tag" data-en="Employer Branding" data-de="Employer Branding" data-es="Employer Branding">{L(lang, "Employer Branding", "Employer Branding", "Employer Branding")}</span>
          <h3 data-en="Recruitment &amp; culture films" data-de="Recruiting- &amp; Kulturfilme" data-es="Films de cultura y reclutamiento">{L(lang, "Recruitment &amp; culture films", "Recruiting- &amp; Kulturfilme", "Films de cultura y reclutamiento")}</h3>
          <p data-en="Show why people love working for you — and attract the talent you actually want." data-de="Zeigen Sie, warum Menschen gerne bei Ihnen arbeiten — und ziehen Sie die richtigen Talente an." data-es="Muestra por qué la gente ama trabajar contigo — y atrae el talento que realmente quieres.">{L(lang, "Show why people love working for you — and attract the talent you actually want.", "Zeigen Sie, warum Menschen gerne bei Ihnen arbeiten — und ziehen Sie die richtigen Talente an.", "Muestra por qué la gente ama trabajar contigo — y atrae el talento que realmente quieres.")}</p>
          <span class="more" data-en="Learn more →" data-de="Mehr erfahren →" data-es="Ver más →">{L(lang, "Learn more →", "Mehr erfahren →", "Ver más →")}</span>
        </div>
      </a>
      <a href={p("services/how-to-video")} class="service reveal">
        <div class="thumb g-teal"></div>
        <div class="body">
          <span class="tag" data-en="How-To &amp; Tutorials" data-de="How-To &amp; Tutorials" data-es="Tutoriales y How-To">{L(lang, "How-To &amp; Tutorials", "How-To &amp; Tutorials", "Tutoriales y How-To")}</span>
          <h3 data-en="Explain anything simply" data-de="Alles einfach erklären" data-es="Explicar cualquier cosa, simple">{L(lang, "Explain anything simply", "Alles einfach erklären", "Explicar cualquier cosa, simple")}</h3>
          <p data-en="Explainer and tutorial videos that make complex offers easy to say yes to." data-de="Erklär- und Tutorial-Videos, die komplexe Angebote leicht verständlich machen." data-es="Videos explicativos y tutoriales que hacen fácil decir que sí a ofertas complejas.">{L(lang, "Explainer and tutorial videos that make complex offers easy to say yes to.", "Erklär- und Tutorial-Videos, die komplexe Angebote leicht verständlich machen.", "Videos explicativos y tutoriales que hacen fácil decir que sí a ofertas complejas.")}</p>
          <span class="more" data-en="Learn more →" data-de="Mehr erfahren →" data-es="Ver más →">{L(lang, "Learn more →", "Mehr erfahren →", "Ver más →")}</span>
        </div>
      </a>
      <a href={p("services/social-media-video")} class="service reveal">
        <div class="thumb g-violet"></div>
        <div class="body">
          <span class="tag" data-en="Social Media" data-de="Social Media" data-es="Redes sociales">{L(lang, "Social Media", "Social Media", "Redes sociales")}</span>
          <h3 data-en="Scroll-stopping content" data-de="Content, der den Scroll stoppt" data-es="Contenido que frena el scroll">{L(lang, "Scroll-stopping content", "Content, der den Scroll stoppt", "Contenido que frena el scroll")}</h3>
          <p data-en="Short-form video series built for reach, engagement and conversion on every platform." data-de="Short-Form-Videoserien für Reichweite, Engagement und Conversion auf jeder Plattform." data-es="Series de video corto para alcance, engagement y conversión en cada plataforma.">{L(lang, "Short-form video series built for reach, engagement and conversion on every platform.", "Short-Form-Videoserien für Reichweite, Engagement und Conversion auf jeder Plattform.", "Series de video corto para alcance, engagement y conversión en cada plataforma.")}</p>
          <span class="more" data-en="Learn more →" data-de="Mehr erfahren →" data-es="Ver más →">{L(lang, "Learn more →", "Mehr erfahren →", "Ver más →")}</span>
        </div>
      </a>
      <a href={p("services/corporate-video")} class="service reveal">
        <div class="thumb g-amber"></div>
        <div class="body">
          <span class="tag" data-en="Corporate &amp; Events" data-de="Corporate &amp; Events" data-es="Corporativo y eventos">{L(lang, "Corporate &amp; Events", "Corporate &amp; Events", "Corporativo y eventos")}</span>
          <h3 data-en="Communication &amp; event content" data-de="Kommunikation &amp; Event-Content" data-es="Comunicación y eventos">{L(lang, "Communication &amp; event content", "Kommunikation &amp; Event-Content", "Comunicación y eventos")}</h3>
          <p data-en="Corporate communication, internal and event content that keeps your audience close." data-de="Unternehmenskommunikation, interne und Event-Inhalte, die Ihr Publikum binden." data-es="Comunicación corporativa, contenido interno y de eventos que mantiene cerca a tu audiencia.">{L(lang, "Corporate communication, internal and event content that keeps your audience close.", "Unternehmenskommunikation, interne und Event-Inhalte, die Ihr Publikum binden.", "Comunicación corporativa, contenido interno y de eventos que mantiene cerca a tu audiencia.")}</p>
          <span class="more" data-en="Learn more →" data-de="Mehr erfahren →" data-es="Ver más →">{L(lang, "Learn more →", "Mehr erfahren →", "Ver más →")}</span>
        </div>
      </a>
      <a href={p("services/video-podcast")} class="service reveal">
        <div class="thumb g-teal"></div>
        <div class="body">
          <span class="tag" data-en="Video Podcasts" data-de="Video-Podcasts" data-es="Video podcasts">{L(lang, "Video Podcasts", "Video-Podcasts", "Video podcasts")}</span>
          <h3 data-en="Your own show, season by season" data-de="Ihre eigene Show, Staffel für Staffel" data-es="Tu propio programa, temporada a temporada">{L(lang, "Your own show, season by season", "Ihre eigene Show, Staffel für Staffel", "Tu propio programa, temporada a temporada")}</h3>
          <p data-en="Branded shows and video podcasts, recorded in batches — episodes plus the vertical cuts for social." data-de="Branded Shows und Video-Podcasts, am Stück aufgenommen — Folgen plus die vertikalen Cuts für Social." data-es="Shows de marca y video podcasts, grabados en tandas — episodios más los cortes verticales para redes.">{L(lang, "Branded shows and video podcasts, recorded in batches — episodes plus the vertical cuts for social.", "Branded Shows und Video-Podcasts, am Stück aufgenommen — Folgen plus die vertikalen Cuts für Social.", "Shows de marca y video podcasts, grabados en tandas — episodios más los cortes verticales para redes.")}</p>
          <span class="more" data-en="Learn more →" data-de="Mehr erfahren →" data-es="Ver más →">{L(lang, "Learn more →", "Mehr erfahren →", "Ver más →")}</span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section class="sec" id="process" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="How we work" data-de="So arbeiten wir" data-es="Cómo trabajamos">{L(lang, "How we work", "So arbeiten wir", "Cómo trabajamos")}</span>
      <h2 data-en="Feature-film discipline. Business-first thinking." data-de="Spielfilm-Disziplin. Business-first-Denken." data-es="Disciplina de cine. Mentalidad de negocio.">{L(lang, "Feature-film discipline. Business-first thinking.", "Spielfilm-Disziplin. Business-first-Denken.", "Disciplina de cine. Mentalidad de negocio.")}</h2>
      <p data-en="We agree on the timeline before we start. And we stick to it." data-de="Wir vereinbaren den Zeitplan, bevor wir starten. Und wir halten ihn ein." data-es="Acordamos el cronograma antes de empezar. Y lo cumplimos.">{L(lang, "We agree on the timeline before we start. And we stick to it.", "Wir vereinbaren den Zeitplan, bevor wir starten. Und wir halten ihn ein.", "Acordamos el cronograma antes de empezar. Y lo cumplimos.")}</p>
    </div>
    <div class="process">
      <div class="step reveal">
        <div class="n">1</div>
        <h3 data-en="Creative development" data-de="Kreativentwicklung" data-es="Desarrollo creativo">{L(lang, "Creative development", "Kreativentwicklung", "Desarrollo creativo")}</h3>
        <p data-en="We start with your goal, not with a camera. Audience, emotion, action — the brief drives everything." data-de="Wir starten mit Ihrem Ziel, nicht mit der Kamera. Zielgruppe, Emotion, Aktion — das Briefing bestimmt alles." data-es="Empezamos con tu objetivo, no con una cámara. Audiencia, emoción, acción — el brief define todo.">{L(lang, "We start with your goal, not with a camera. Audience, emotion, action — the brief drives everything.", "Wir starten mit Ihrem Ziel, nicht mit der Kamera. Zielgruppe, Emotion, Aktion — das Briefing bestimmt alles.", "Empezamos con tu objetivo, no con una cámara. Audiencia, emoción, acción — el brief define todo.")}</p>
      </div>
      <div class="step reveal">
        <div class="n">2</div>
        <h3 data-en="Pre-production" data-de="Pre-Production" data-es="Preproducción">{L(lang, "Pre-production", "Pre-Production", "Preproducción")}</h3>
        <p data-en="Casting, crewing, storyboarding and scheduling — everything planned before a single shot." data-de="Casting, Crew, Storyboard und Zeitplan — alles geplant, bevor eine Aufnahme entsteht." data-es="Casting, equipo, storyboard y calendario — todo planificado antes de la primera toma.">{L(lang, "Casting, crewing, storyboarding and scheduling — everything planned before a single shot.", "Casting, Crew, Storyboard und Zeitplan — alles geplant, bevor eine Aufnahme entsteht.", "Casting, equipo, storyboard y calendario — todo planificado antes de la primera toma.")}</p>
      </div>
      <div class="step reveal">
        <div class="n">3</div>
        <h3 data-en="Production" data-de="Produktion" data-es="Producción">{L(lang, "Production", "Produktion", "Producción")}</h3>
        <p data-en="On set with the efficiency and discipline of a feature film crew — every minute accounted for." data-de="Am Set mit der Effizienz und Disziplin einer Spielfilm-Crew — jede Minute zählt." data-es="En el set con la eficiencia y disciplina de un equipo de cine — cada minuto cuenta.">{L(lang, "On set with the efficiency and discipline of a feature film crew — every minute accounted for.", "Am Set mit der Effizienz und Disziplin einer Spielfilm-Crew — jede Minute zählt.", "En el set con la eficiencia y disciplina de un equipo de cine — cada minuto cuenta.")}</p>
      </div>
      <div class="step reveal">
        <div class="n">4</div>
        <h3 data-en="Post-production" data-de="Post-Production" data-es="Postproducción">{L(lang, "Post-production", "Post-Production", "Postproducción")}</h3>
        <p data-en="Expert editing, sound design and finishing that merge craft with your brand identity." data-de="Professioneller Schnitt, Sound Design und Finishing — Handwerk trifft Markenidentität." data-es="Edición experta, diseño de sonido y acabado que unen oficio e identidad de marca.">{L(lang, "Expert editing, sound design and finishing that merge craft with your brand identity.", "Professioneller Schnitt, Sound Design und Finishing — Handwerk trifft Markenidentität.", "Edición experta, diseño de sonido y acabado que unen oficio e identidad de marca.")}</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:44px" class="reveal">
      <a href={p("why-viven")} class="btn btn-ghost" data-en="Why brands choose Viven" data-de="Warum Marken Viven wählen" data-es="Por qué las marcas eligen Viven">{L(lang, "Why brands choose Viven", "Warum Marken Viven wählen", "Por qué las marcas eligen Viven")}</a>
    </div>
  </div>
</section>


<Testimonials lang={lang} />

<CalcBanner lang={lang} />

<!-- ============ CTA / FORM ============ -->
<RelatedPosts lang={lang} match={/./} />

<section class="cta" id="start" style="padding-top:0">
  <div class="wrap">
    <div class="cta-card reveal">
      <div>
        <span class="eyebrow" data-en="Let's talk" data-de="Sprechen wir" data-es="Hablemos">{L(lang, "Let's talk", "Sprechen wir", "Hablemos")}</span>
        <h2 data-en="Tell us what you're working on." data-de="Erzählen Sie uns von Ihrem Projekt." data-es="Contanos en qué estás trabajando.">{L(lang, "Tell us what you're working on.", "Erzählen Sie uns von Ihrem Projekt.", "Contanos en qué estás trabajando.")}</h2>
        <p class="lead" data-en="Tell us your goal — we'll come back with timing and a clear quote within 48 hours. Free, no obligation." data-de="Nennen Sie uns Ihr Ziel — wir melden uns innert 48 Stunden mit Timing und einem klaren Angebot. Kostenlos und unverbindlich." data-es="Contanos tu objetivo — volvemos en 48 horas con tiempos y un presupuesto claro. Gratis y sin compromiso.">{L(lang, "Tell us your goal — we'll come back with timing and a clear quote within 48 hours. Free, no obligation.", "Nennen Sie uns Ihr Ziel — wir melden uns innert 48 Stunden mit Timing und einem klaren Angebot. Kostenlos und unverbindlich.", "Contanos tu objetivo — volvemos en 48 horas con tiempos y un presupuesto claro. Gratis y sin compromiso.")}</p>
        <ul>
