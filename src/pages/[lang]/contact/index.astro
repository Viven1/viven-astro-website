---
import Base from '../../../layouts/Base.astro';
import { langPaths, L } from '../../../i18n.js';
export const getStaticPaths = langPaths;
const { lang } = Astro.params;
const title = {"en":"Viven AG","de":"Viven AG","es":"Viven AG"};
const description = {"en":"We are no longer accepting new projects or inquiries.","de":"Wir nehmen keine neuen Projekte und Anfragen mehr entgegen.","es":"Ya no aceptamos nuevos proyectos ni consultas."};
---
<Base lang={lang} slug="contact" title={title} description={description} noindex={true}>
<section class="page-hero">
  <div class="wrap">
    <h1 style="font-size:clamp(26px,3.6vw,42px)"
        data-en="We are no longer accepting new projects or inquiries."
        data-de="Wir nehmen keine neuen Projekte und Anfragen mehr entgegen."
        data-es="Ya no aceptamos nuevos proyectos ni consultas.">{L(lang, "We are no longer accepting new projects or inquiries.", "Wir nehmen keine neuen Projekte und Anfragen mehr entgegen.", "Ya no aceptamos nuevos proyectos ni consultas.")}</h1>
  </div>
</section>
</Base>
