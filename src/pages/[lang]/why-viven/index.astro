---
import Base from '../../../layouts/Base.astro';
import Testimonials from '../../../components/Testimonials.astro';
import { langPaths, localePath, L } from '../../../i18n.js';
export const getStaticPaths = langPaths;
const { lang } = Astro.params;
const p = (s) => localePath(lang, s);
const calcHref = { en: '/en/video-cost-calculator/', de: '/de/videoproduktion-kosten-rechner/', es: '/es/calculadora-costos-video/' };
const title = {"en":"Why Viven — Feature-Film Craft, Business Results","de":"Warum Viven — Spielfilm-Handwerk, Business-Ergebnisse","es":"Por qué Viven — Oficio de cine, resultados de negocio"};
const description = {"en":"Why 187 brands across 32 industries choose Viven: feature-film craft, business-first thinking, end-to-end production — founded by the first Swiss producer on Netflix.","de":"Warum 187 Marken aus 32 Branchen Viven wählen: Spielfilm-Handwerk, Business-first-Denken, Produktion über einen Partner — gegründet vom ersten Schweizer Produzenten auf Netflix.","es":"Por qué 187 marcas de 32 industrias eligen Viven: oficio de cine, mentalidad de negocio y producción de principio a fin — fundada por el primer productor suizo en Netflix."};
---
<Base lang={lang} slug="why-viven" active="why" title={title} description={description}>
  <script type="application/ld+json" slot="jsonld" set:html={"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"AboutPage\",\"@id\":\"https://www.viven.ch/why-viven/#webpage\",\"url\":\"https://www.viven.ch/why-viven/\",\"name\":\"Why Viven — Feature-film craft, business results\",\"description\":\"Why 187 brands across 32 industries choose Viven: feature-film discipline on set, business-first thinking, one accountable team, end to end and timelines agreed upfront — and kept.\",\"about\":{\"@id\":\"https://www.viven.ch/#organization\"},\"isPartOf\":{\"@id\":\"https://www.viven.ch/#website\"},\"inLanguage\":[\"en\",\"de\",\"es\"]},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.viven.ch/why-viven/#breadcrumbs\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.viven.ch/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Why Viven\",\"item\":\"https://www.viven.ch/why-viven/\"}]},{\"@type\":\"Person\",\"@id\":\"https://www.viven.ch/why-viven/#sebastian-cepeda\",\"name\":\"Sebastian Cepeda\",\"jobTitle\":\"Founder & Executive Producer\",\"description\":\"First Swiss producer to bring the first Swiss feature film to Netflix.\",\"worksFor\":{\"@id\":\"https://www.viven.ch/#organization\"}}]}"}></script>
<!-- ============ PAGE HERO ============ -->
<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={p("")} data-en="Home" data-de="Home" data-es="Inicio">{L(lang, "Home", "Home", "Inicio")}</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span data-en="Why Viven" data-de="Warum Viven" data-es="Por qué Viven">{L(lang, "Why Viven", "Warum Viven", "Por qué Viven")}</span>
    </nav>
    <span class="eyebrow" data-en="Why Viven" data-de="Warum Viven" data-es="Por qué Viven">{L(lang, "Why Viven", "Warum Viven", "Por qué Viven")}</span>
    <h1 data-en='Feature-film craft. <span class="hl">Business results.</span>'
        data-de='Spielfilm-Handwerk. <span class="hl">Business-Ergebnisse.</span>'
        data-es='Oficio de cine. <span class="hl">Resultados de negocio.</span>'><Fragment set:html={L(lang, `Feature-film craft. <span class="hl">Business results.</span>`, `Spielfilm-Handwerk. <span class="hl">Business-Ergebnisse.</span>`, `Oficio de cine. <span class="hl">Resultados de negocio.</span>`)} /></h1>
    <p class="lead"
       data-en="Viven was founded by Sebastian Cepeda — the producer of the first Swiss feature film on Netflix. Today that same craft powers films for 187 brands across 32 industries."
       data-de="Viven wurde von Sebastian Cepeda gegründet — dem Produzenten des ersten Schweizer Spielfilms auf Netflix. Heute steckt dieses Handwerk in Filmen für 187 Marken aus 32 Branchen."
       data-es="Viven fue fundada por Sebastian Cepeda — el productor de la primera película suiza en Netflix. Hoy ese mismo oficio impulsa films para 187 marcas de 32 industrias.">{L(lang, "Viven was founded by Sebastian Cepeda — the producer of the first Swiss feature film on Netflix. Today that same craft powers films for 187 brands across 32 industries.", "Viven wurde von Sebastian Cepeda gegründet — dem Produzenten des ersten Schweizer Spielfilms auf Netflix. Heute steckt dieses Handwerk in Filmen für 187 Marken aus 32 Branchen.", "Viven fue fundada por Sebastian Cepeda — el productor de la primera película suiza en Netflix. Hoy ese mismo oficio impulsa films para 187 marcas de 32 industrias.")}</p>
    <div class="hero-cta">
      <a href={p("contact")} class="btn btn-primary" data-en="Start a project" data-de="Projekt starten" data-es="Iniciar proyecto">{L(lang, "Start a project", "Projekt starten", "Iniciar proyecto")}</a>
      <a href={calcHref[lang]} class="btn btn-ghost" data-en-href="/en/video-cost-calculator/" data-de-href="/de/videoproduktion-kosten-rechner/" data-es-href="/es/calculadora-costos-video/" data-en="Get a price in 60 seconds" data-de="Preis in 60 Sekunden" data-es="Precio en 60 segundos">{L(lang, "Get a price in 60 seconds", "Preis in 60 Sekunden", "Precio en 60 segundos")}</a>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="sec" style="padding-top:0;padding-bottom:0">
  <div class="wrap">
    <div class="stats four reveal">
      <div class="stat"><div class="num">187</div><div class="lbl" data-en="Brands trusted us" data-de="Marken vertrauen uns" data-es="Marcas confiaron en nosotros">{L(lang, "Brands trusted us", "Marken vertrauen uns", "Marcas confiaron en nosotros")}</div></div>
      <div class="stat"><div class="num">32</div><div class="lbl" data-en="Industries served" data-de="Branchen bedient" data-es="Industrias atendidas">{L(lang, "Industries served", "Branchen bedient", "Industrias atendidas")}</div></div>
      <div class="stat"><div class="num">47</div><div class="lbl" data-en="Five-star Google reviews" data-de="Fünf-Sterne-Google-Bewertungen" data-es="Reseñas de 5 estrellas en Google">{L(lang, "Five-star Google reviews", "Fünf-Sterne-Google-Bewertungen", "Reseñas de 5 estrellas en Google")}</div></div>
      <div class="stat"><div class="num">1st</div><div class="lbl" data-en="Swiss feature film on Netflix" data-de="Schweizer Spielfilm auf Netflix" data-es="Primera película suiza en Netflix">{L(lang, "Swiss feature film on Netflix", "Schweizer Spielfilm auf Netflix", "Primera película suiza en Netflix")}</div></div>
    </div>
  </div>
</section>

<!-- ============ THE VIVEN DIFFERENCE ============ -->
<section class="sec" id="difference">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="The Viven difference" data-de="Der Viven-Unterschied" data-es="La diferencia Viven">{L(lang, "The Viven difference", "Der Viven-Unterschied", "La diferencia Viven")}</span>
      <h2 data-en="Why brands choose us — and stay." data-de="Warum Marken uns wählen — und bleiben." data-es="Por qué las marcas nos eligen — y se quedan.">{L(lang, "Why brands choose us — and stay.", "Warum Marken uns wählen — und bleiben.", "Por qué las marcas nos eligen — y se quedan.")}</h2>
      <p data-en="Four things we do differently. None of them optional." data-de="Vier Dinge, die wir anders machen. Keines davon ist optional." data-es="Cuatro cosas que hacemos distinto. Ninguna es opcional.">{L(lang, "Four things we do differently. None of them optional.", "Vier Dinge, die wir anders machen. Keines davon ist optional.", "Cuatro cosas que hacemos distinto. Ninguna es opcional.")}</p>
    </div>
    <div class="value-grid">
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 8h16v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><path d="m4 8 2-5h3l-2 5"/><path d="m9 8 2-5h3l-2 5"/><path d="m14 8 2-5h3l-2 5"/></svg></div>
        <h3 data-en="Feature-film discipline" data-de="Spielfilm-Disziplin" data-es="Disciplina de cine">{L(lang, "Feature-film discipline", "Spielfilm-Disziplin", "Disciplina de cine")}</h3>
        <p data-en="The same rigor we bring to cinema, on every set: planned shots, tight schedules, zero wasted time." data-de="Dieselbe Präzision wie im Kino, an jedem Set: geplante Einstellungen, straffe Zeitpläne, keine verlorene Zeit." data-es="El mismo rigor del cine, en cada set: tomas planificadas, cronogramas ajustados, cero tiempo perdido.">{L(lang, "The same rigor we bring to cinema, on every set: planned shots, tight schedules, zero wasted time.", "Dieselbe Präzision wie im Kino, an jedem Set: geplante Einstellungen, straffe Zeitpläne, keine verlorene Zeit.", "El mismo rigor del cine, en cada set: tomas planificadas, cronogramas ajustados, cero tiempo perdido.")}</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
        <h3 data-en="Business-first thinking" data-de="Business-first-Denken" data-es="Mentalidad de negocio">{L(lang, "Business-first thinking", "Business-first-Denken", "Mentalidad de negocio")}</h3>
        <p data-en="We start with your goal, not a camera. Every creative choice is tied to the outcome you need." data-de="Wir starten mit Ihrem Ziel, nicht mit einer Kamera. Jede kreative Entscheidung zahlt auf Ihr Ergebnis ein." data-es="Empezamos con tu objetivo, no con una cámara. Cada decisión creativa apunta al resultado que necesitas.">{L(lang, "We start with your goal, not a camera. Every creative choice is tied to the outcome you need.", "Wir starten mit Ihrem Ziel, nicht mit einer Kamera. Jede kreative Entscheidung zahlt auf Ihr Ergebnis ein.", "Empezamos con tu objetivo, no con una cámara. Cada decisión creativa apunta al resultado que necesitas.")}</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 2 8.5 5v10L12 22l-8.5-5V7z"/><path d="M12 22V12"/><path d="m3.5 7 8.5 5 8.5-5"/></svg></div>
        <h3 data-en="End to end" data-de="Ein Partner, end to end" data-es="De principio a fin">{L(lang, "End to end", "Ein Partner, end to end", "De principio a fin")}</h3>
        <p data-en="Concept, script, shoot, edit, sound and delivery — one team, one standard, no hand-offs." data-de="Konzept, Skript, Dreh, Schnitt, Sound und Auslieferung — ein Team, ein Standard, keine Übergaben." data-es="Concepto, guion, rodaje, edición, sonido y entrega — un equipo, un estándar, sin intermediarios.">{L(lang, "Concept, script, shoot, edit, sound and delivery — one team, one standard, no hand-offs.", "Konzept, Skript, Dreh, Schnitt, Sound und Auslieferung — ein Team, ein Standard, keine Übergaben.", "Concepto, guion, rodaje, edición, sonido y entrega — un equipo, un estándar, sin intermediarios.")}</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
        <h3 data-en="Timelines that hold" data-de="Zeitpläne, die halten" data-es="Cronogramas que se cumplen">{L(lang, "Timelines that hold", "Zeitpläne, die halten", "Cronogramas que se cumplen")}</h3>
        <p data-en="We agree on the timeline before we start — and we keep it. Every time." data-de="Wir vereinbaren den Zeitplan vor dem Start — und halten ihn ein. Jedes Mal." data-es="Acordamos el cronograma antes de empezar — y lo cumplimos. Siempre.">{L(lang, "We agree on the timeline before we start — and we keep it. Every time.", "Wir vereinbaren den Zeitplan vor dem Start — und halten ihn ein. Jedes Mal.", "Acordamos el cronograma antes de empezar — y lo cumplimos. Siempre.")}</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section class="sec" id="process" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="How we work" data-de="So arbeiten wir" data-es="Cómo trabajamos">{L(lang, "How we work", "So arbeiten wir", "Cómo trabajamos")}</span>
      <h2 data-en="Four steps. Zero surprises." data-de="Vier Schritte. Null Überraschungen." data-es="Cuatro pasos. Cero sorpresas.">{L(lang, "Four steps. Zero surprises.", "Vier Schritte. Null Überraschungen.", "Cuatro pasos. Cero sorpresas.")}</h2>
      <p data-en="From first call to final delivery, you always know where your film stands." data-de="Vom ersten Gespräch bis zur finalen Auslieferung wissen Sie immer, wo Ihr Film steht." data-es="De la primera llamada a la entrega final, siempre sabes en qué punto está tu film.">{L(lang, "From first call to final delivery, you always know where your film stands.", "Vom ersten Gespräch bis zur finalen Auslieferung wissen Sie immer, wo Ihr Film steht.", "De la primera llamada a la entrega final, siempre sabes en qué punto está tu film.")}</p>
    </div>
    <div class="process">
      <div class="step reveal">
        <div class="n">1</div>
        <h3 data-en="Creative development" data-de="Kreativentwicklung" data-es="Desarrollo creativo">{L(lang, "Creative development", "Kreativentwicklung", "Desarrollo creativo")}</h3>
        <p data-en="We start with your goal, not with a camera. Together we define who the film must reach, what it should make them feel and what it should make them do. That brief drives every decision from first frame to last." data-de="Wir starten mit Ihrem Ziel, nicht mit der Kamera. Gemeinsam definieren wir, wen der Film erreichen muss, was er auslösen und wozu er bewegen soll. Dieses Briefing bestimmt jede Entscheidung — vom ersten bis zum letzten Bild." data-es="Empezamos con tu objetivo, no con una cámara. Juntos definimos a quién debe llegar el film, qué debe hacer sentir y qué acción debe provocar. Ese brief guía cada decisión, del primer al último cuadro.">{L(lang, "We start with your goal, not with a camera. Together we define who the film must reach, what it should make them feel and what it should make them do. That brief drives every decision from first frame to last.", "Wir starten mit Ihrem Ziel, nicht mit der Kamera. Gemeinsam definieren wir, wen der Film erreichen muss, was er auslösen und wozu er bewegen soll. Dieses Briefing bestimmt jede Entscheidung — vom ersten bis zum letzten Bild.", "Empezamos con tu objetivo, no con una cámara. Juntos definimos a quién debe llegar el film, qué debe hacer sentir y qué acción debe provocar. Ese brief guía cada decisión, del primer al último cuadro.")}</p>
      </div>
      <div class="step reveal">
        <div class="n">2</div>
        <h3 data-en="Pre-production" data-de="Pre-Production" data-es="Preproducción">{L(lang, "Pre-production", "Pre-Production", "Preproducción")}</h3>
        <p data-en="Casting, crewing, storyboarding and scheduling. Every location, every shot and every hour is locked before the shoot — so production runs without surprises." data-de="Casting, Crew, Storyboard und Zeitplan. Jede Location, jede Einstellung und jede Stunde steht fest, bevor gedreht wird — damit die Produktion ohne Überraschungen läuft." data-es="Casting, equipo, storyboard y calendario. Cada locación, cada toma y cada hora quedan definidas antes del rodaje — para que la producción avance sin sorpresas.">{L(lang, "Casting, crewing, storyboarding and scheduling. Every location, every shot and every hour is locked before the shoot — so production runs without surprises.", "Casting, Crew, Storyboard und Zeitplan. Jede Location, jede Einstellung und jede Stunde steht fest, bevor gedreht wird — damit die Produktion ohne Überraschungen läuft.", "Casting, equipo, storyboard y calendario. Cada locación, cada toma y cada hora quedan definidas antes del rodaje — para que la producción avance sin sorpresas.")}</p>
      </div>
      <div class="step reveal">
        <div class="n">3</div>
        <h3 data-en="Production" data-de="Produktion" data-es="Producción">{L(lang, "Production", "Produktion", "Producción")}</h3>
        <p data-en="On set we work with the efficiency and discipline of a feature film crew. Every shot is planned, every minute accounted for — and your team always knows what happens next." data-de="Am Set arbeiten wir mit der Effizienz und Disziplin einer Spielfilm-Crew. Jede Einstellung ist geplant, jede Minute verplant — und Ihr Team weiss immer, was als Nächstes passiert." data-es="En el set trabajamos con la eficiencia y disciplina de un equipo de cine. Cada toma está planificada, cada minuto contado — y tu equipo siempre sabe qué sigue.">{L(lang, "On set we work with the efficiency and discipline of a feature film crew. Every shot is planned, every minute accounted for — and your team always knows what happens next.", "Am Set arbeiten wir mit der Effizienz und Disziplin einer Spielfilm-Crew. Jede Einstellung ist geplant, jede Minute verplant — und Ihr Team weiss immer, was als Nächstes passiert.", "En el set trabajamos con la eficiencia y disciplina de un equipo de cine. Cada toma está planificada, cada minuto contado — y tu equipo siempre sabe qué sigue.")}</p>
      </div>
      <div class="step reveal">
        <div class="n">4</div>
        <h3 data-en="Post-production" data-de="Post-Production" data-es="Postproducción">{L(lang, "Post-production", "Post-Production", "Postproducción")}</h3>
        <p data-en="Expert editing, sound design and visual enhancements merge feature-film craft with your brand identity — until the film performs wherever you publish it." data-de="Professioneller Schnitt, Sound Design und visuelle Veredelung verbinden Spielfilm-Handwerk mit Ihrer Markenidentität — bis der Film überall dort wirkt, wo Sie ihn einsetzen." data-es="Edición experta, diseño de sonido y acabados visuales unen el oficio del cine con tu identidad de marca — hasta que el film funciona donde sea que lo publiques.">{L(lang, "Expert editing, sound design and visual enhancements merge feature-film craft with your brand identity — until the film performs wherever you publish it.", "Professioneller Schnitt, Sound Design und visuelle Veredelung verbinden Spielfilm-Handwerk mit Ihrer Markenidentität — bis der Film überall dort wirkt, wo Sie ihn einsetzen.", "Edición experta, diseño de sonido y acabados visuales unen el oficio del cine con tu identidad de marca — hasta que el film funciona donde sea que lo publiques.")}</p>
      </div>
    </div>
    <p class="reveal" style="text-align:center;margin-top:36px;color:var(--muted);font-size:15px"
       data-en="Social series take days. Employer-branding campaigns typically run 4–8 weeks. Either way: the timeline is agreed upfront — and kept."
       data-de="Social-Serien dauern Tage. Employer-Branding-Kampagnen typischerweise 4–8 Wochen. In jedem Fall: Der Zeitplan wird vorab vereinbart — und eingehalten."
       data-es="Las series para redes toman días. Las campañas de employer branding, típicamente 4–8 semanas. En todo caso: el cronograma se acuerda antes — y se cumple.">{L(lang, "Social series take days. Employer-branding campaigns typically run 4–8 weeks. Either way: the timeline is agreed upfront — and kept.", "Social-Serien dauern Tage. Employer-Branding-Kampagnen typischerweise 4–8 Wochen. In jedem Fall: Der Zeitplan wird vorab vereinbart — und eingehalten.", "Las series para redes toman días. Las campañas de employer branding, típicamente 4–8 semanas. En todo caso: el cronograma se acuerda antes — y se cumple.")}</p>
  </div>
</section>

<!-- ============ CLIENTS ============ -->
<section class="sec" id="clients" style="padding-top:0;padding-bottom:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="Clients" data-de="Kunden" data-es="Clientes">{L(lang, "Clients", "Kunden", "Clientes")}</span>
      <h2 data-en="In good company." data-de="In guter Gesellschaft." data-es="En buena compañía.">{L(lang, "In good company.", "In guter Gesellschaft.", "En buena compañía.")}</h2>
      <p data-en="187 brands across 32 industries trust Viven — including UBS, Siemens, Porsche, ON, Chanel, FIFA, Philips, Swarovski, IBM, Julius Bär, KPMG, V-ZUG and Franke."
         data-de="187 Marken aus 32 Branchen vertrauen Viven — darunter UBS, Siemens, Porsche, ON, Chanel, FIFA, Philips, Swarovski, IBM, Julius Bär, KPMG, V-ZUG und Franke."
         data-es="187 marcas de 32 industrias confían en Viven — entre ellas UBS, Siemens, Porsche, ON, Chanel, FIFA, Philips, Swarovski, IBM, Julius Bär, KPMG, V-ZUG y Franke.">{L(lang, "187 brands across 32 industries trust Viven — including UBS, Siemens, Porsche, ON, Chanel, FIFA, Philips, Swarovski, IBM, Julius Bär, KPMG, V-ZUG and Franke.", "187 Marken aus 32 Branchen vertrauen Viven — darunter UBS, Siemens, Porsche, ON, Chanel, FIFA, Philips, Swarovski, IBM, Julius Bär, KPMG, V-ZUG und Franke.", "187 marcas de 32 industrias confían en Viven — entre ellas UBS, Siemens, Porsche, ON, Chanel, FIFA, Philips, Swarovski, IBM, Julius Bär, KPMG, V-ZUG y Franke.")}</p>
    </div>
  </div>
</section>

<!-- ============ LOGO BAR ============ -->
<div class="logos" style="margin-top:56px">
  <div class="wrap">
    <p class="label" data-en="187 brands across 32 industries" data-de="187 Marken in 32 Branchen" data-es="187 marcas en 32 industrias">{L(lang, "187 brands across 32 industries", "187 Marken in 32 Branchen", "187 marcas en 32 industrias")}</p>
    <div class="marquee">
      <div class="marquee-track">
        <span>UBS</span><span>Siemens</span><span>Porsche</span><span>ON</span><span>Franke</span><span>V-ZUG</span><span>Chanel</span><span>FIFA</span><span>Philips</span><span>Swarovski</span><span>IBM</span><span>Sennheiser</span><span>Julius Bär</span><span>KPMG</span><span>Sigg</span>
        <span>UBS</span><span>Siemens</span><span>Porsche</span><span>ON</span><span>Franke</span><span>V-ZUG</span><span>Chanel</span><span>FIFA</span><span>Philips</span><span>Swarovski</span><span>IBM</span><span>Sennheiser</span><span>Julius Bär</span><span>KPMG</span><span>Sigg</span>
      </div>
    </div>
  </div>
</div>

<!-- ============ RESULTS ============ -->
<section class="sec" id="results">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow" data-en="Proof, not promises" data-de="Beweise statt Versprechen" data-es="Pruebas, no promesas">{L(lang, "Proof, not promises", "Beweise statt Versprechen", "Pruebas, no promesas")}</span>
      <h2 data-en="Real work. Real outcomes." data-de="Echte Arbeit. Echte Ergebnisse." data-es="Trabajo real. Resultados reales.">{L(lang, "Real work. Real outcomes.", "Echte Arbeit. Echte Ergebnisse.", "Trabajo real. Resultados reales.")}</h2>
      <p data-en="A film is only worth making if it moves the numbers. Here's what ours did." data-de="Ein Film lohnt sich nur, wenn er die Zahlen bewegt. Das haben unsere bewirkt." data-es="Un film solo vale la pena si mueve los números. Esto lograron los nuestros.">{L(lang, "A film is only worth making if it moves the numbers. Here's what ours did.", "Ein Film lohnt sich nur, wenn er die Zahlen bewegt. Das haben unsere bewirkt.", "Un film solo vale la pena si mueve los números. Esto lograron los nuestros.")}</p>
    </div>
    <div class="cases">
      <div class="case reveal">
        <div class="top g1" data-vimeo="1033111627">
          <span class="client">Siemens</span>
          <button class="play" type="button" aria-label="Play video"><svg viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg></button>
        </div>
