---
// Página de localización: Videoproduktion in Zürich — long-tail local ("in Zürich", "Produktionsfirma vor Ort").
// OJO canibalización: la home DE targetea el head keyword "Videoproduktion Zürich" — esta página va al
// long-tail hiperlocal (Kreise, Locations, Bewilligungen, Zürcher Kunden) y recibe link interno con anchor exacto.
import Base from '../../layouts/Base.astro';
import CalcBanner from '../../components/CalcBanner.astro';
import Testimonials from '../../components/Testimonials.astro';
const lang = "de";
const d = {"title": "Videoproduktion in Zürich — Ihre Produktionsfirma vor Ort | Viven", "description": "Videoproduktion mit Sitz in Zürich, Kreis 4. Keine Reisekosten, Crew kurzfristig am Set, Locations und Drehbewilligungen inklusive. Vertraut von FIFA, UBS und ON.", "h1": "Videoproduktion in Zürich — Ihre Produktionsfirma vor Ort", "lead": "Viven ist eine Videoproduktion mit Sitz an der Zeughausstrasse 31 im Zürcher Kreis 4 — fünf Minuten von der Hardbrücke, mit Kamera, Licht und Schnittplätzen im Haus. Für Zürcher Unternehmen heisst das: keine Reisekosten, Crews kurzfristig am Set und ein Partner, den Sie vor der Unterschrift persönlich treffen können. Wir produzieren Markenfilme, Corporate Videos und Eventvideos für Banken, Versicherungen, Tech-Firmen und Spitäler der Stadt — darunter FIFA, UBS, ON und das Stadtspital Zürich. Den ersten Schnitt prüfen Sie rund zwei Wochen nach dem Dreh.", "sections": [{"h2": "Eine Produktionsfirma um die Ecke, kein Lieferant per E-Mail", "html": "<p>Viele Agenturen drehen «auch» in Zürich. Wir sind von hier — und das verändert, wie ein Projekt läuft:</p><ul><li><strong>Kickoff persönlich:</strong> Briefing bei Ihnen im Büro oder bei uns im Kreis 4 — noch diese Woche, nicht nächsten Monat.</li><li><strong>Kurzfristige Drehs:</strong> Öffnet sich plötzlich die Agenda Ihres CEO oder verschiebt sich ein Event, steht eine Crew mit Equipment innert Tagen am Set, manchmal innert Stunden.</li><li><strong>Keine Reisekosten-Posten:</strong> Unser Equipment ist in Zürich zuhause. Sie bezahlen Produktion, nicht Kilometer.</li><li><strong>Nachdrehs ohne Drama:</strong> Braucht es nach der Abnahme eine zusätzliche Einstellung oder ein Interview, ist das eine Tramfahrt, keine Dienstreise.</li></ul><p>Eine feste Produktionsleitung führt Ihr Projekt vom Briefing bis zur Abgabe — und die Postproduktion passiert im selben Haus, aus dem die Kameras kommen.</p>"}, {"h2": "Zürcher Locations, die wir jeden Monat drehen", "html": "<p>Acht Jahre Produktion in dieser Stadt heisst: Wir wissen schon, wo Ihr Film spielen sollte — und was es braucht, um dort zu drehen:</p><ul><li><strong>Kreis 5 und Hardbrücke:</strong> die industriellen Kulissen rund um Im Viadukt, Schiffbau und Prime Tower, die Corporate-Filmen einen editorialen Look geben.</li><li><strong>Altstadt und Limmatquai:</strong> Grossmünster-Blick, Zunfthäuser und Gassen für Markenfilme, die unverkennbar nach Zürich aussehen sollen.</li><li><strong>Das Seebecken:</strong> Bürkliplatz, Utoquai und Seefeld mit den Alpen im Hintergrund — der klassische Establishing Shot, am besten im Morgenlicht.</li><li><strong>ETH und Hochschulquartier</strong> für Forschungs-, Bildungs- und Innovationsgeschichten, inklusive Terrassenblick über die Dächer.</li><li><strong>The Circle am Flughafen und die Hallen in Oerlikon</strong> für Kongresse, Produktlancierungen und Employer-Branding-Drehs.</li></ul><p>Wir wissen, welche Locations eine Drehbewilligung der Stadt Zürich brauchen und welche nicht, mit welchem Vorlauf die Behörden rechnen — und dass Drohnenaufnahmen am See in der Kontrollzone des Flughafens liegen und eine Freigabe brauchen. Sie briefen den Film; den Papierkram übernehmen wir.</p>"}, {"h2": "Produziert mit Zürichs Aushängeschildern", "html": "<p>Unsere Kundenliste liest sich wie die Stadt selbst. Wir haben produziert für die <strong>FIFA</strong> mit Sitz am Zürichberg, für <strong>UBS</strong> und <strong>Julius Bär</strong> im Bankenviertel, für <strong>ON</strong>, Zürichs Laufschuh-Erfolgsgeschichte, für <strong>Siemens Schweiz</strong> — und eine mehrteilige Employer-Branding-Serie für das <strong>Stadtspital Zürich</strong>. Dieser Mix — Banking, Versicherung, Tech, Sport, Gesundheit — ist Zürichs Wirtschaft im Kleinformat. Und er hat uns gelehrt, was Entscheider hier brauchen: Diskretion am Set im Büroturm, Freigabeprozesse, die Compliance-Abteilungen standhalten, und Filme, die auf (Schweizer-)Deutsch und Englisch gleichermassen funktionieren.</p><p>Es bedeutet auch: Referenzen, die Sie wirklich prüfen können. Fragen Sie nach dem Zürcher Case aus Ihrer Branche — wir zeigen Ihnen den Film und stellen den Kontakt zum Kunden her.</p>"}, {"h2": "Schweizerdeutsch am Set, Budgets und der nächste Schritt", "html": "<p>Interviews werden entspannter, wenn Menschen so sprechen dürfen wie im Alltag. Wir führen und drehen Interviews auf Schweizerdeutsch, Hochdeutsch, Englisch und Spanisch — und liefern untertitelte Versionen, damit ein einziger Zürcher Dreh Ihr lokales Publikum und Ihre internationalen Kanäle abdeckt.</p><p>Zürcher Projekte bewegen sich bei Viven zwischen CHF 4'000 für ein fokussiertes Interview- oder Eventvideo und CHF 80'000 für mehrtägige Markenkampagnen — immer als Fixofferte, nie nach offenem Aufwand. Den ersten Schnitt prüfen Sie rund zwei Wochen nach dem Dreh. Gegründet wurde Viven vom Produzenten des ersten Schweizer Spielfilms auf Netflix — dieser filmische Hintergrund prägt Licht, Bildsprache und Schnitt auch bei Corporate-Projekten. Sagen Sie uns, was Ihr Video erreichen soll, und Sie erhalten innert weniger Tage ein konkretes Konzept mit Offerte — oder kommen Sie an der Zeughausstrasse 31 auf einen Kaffee vorbei.</p>"}]};
const title = { "de": d.title };
const description = { "de": d.description };
const langUrls = { "de": "/de/videoproduktion-zuerich/", "en": "/en/video-production-zurich/", "es": "/es/produccion-de-video-zurich/" };
const SITE = 'https://www.viven.ch';
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.h1, description: d.description,
  provider: { '@id': SITE + '/#organization' },
  areaServed: { '@type': 'City', name: 'Zurich' },
  serviceType: 'Video production',
  url: SITE + '/de/videoproduktion-zuerich/',
});
---
<Base lang={lang} slug="videoproduktion-zuerich" active="services" title={title} description={description} singleLang={true} switchSlug="services" langUrls={langUrls}>
  <script type="application/ld+json" slot="jsonld" set:html={ld}></script>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Zürich — Schweiz</span>
      <h1 class="rsrc-h1">{d.h1}</h1>
      <p class="lead">{d.lead}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap rsrc-body">
      {d.sections.map((sec) => (
        <div class="rsrc-sec">
          <h2>{sec.h2}</h2>
          <div set:html={sec.html}></div>
        </div>
      ))}
      <div class="rsrc-ctabox">
        <div>
          <div class="rsrc-ctat">Ein Video in Zürich geplant?</div>
          <p class="rsrc-ctas">Erzählen Sie uns von Ihrem Projekt — klare Offerte, meist innert eines Arbeitstages.</p>
        </div>
        <div class="rsrc-ctabtns">
          <a class="btn btn-primary" href="#start">Projekt starten</a>
          <a class="btn btn-ghost" href="/book/" target="_blank" rel="noopener">📅 15-Min-Call buchen</a>
        </div>
      </div>
      <p class="rsrc-linkout">Fragen Sie sich, was das kosten würde? Unser <a href="/de/videoproduktion-kosten-rechner/?type=corporate">Kostenrechner für Videos</a>.</p>
    </div>
  </section>

  <Testimonials lang={lang} cat="corporate" />

  <CalcBanner lang={lang} type="corporate" />

  <!-- ============ CTA / FORM ============ -->
  <section class="cta" id="start" style="padding-top:0">
    <div class="wrap">
      <div class="cta-card reveal">
        <div>
          <span class="eyebrow" data-en="Let's talk" data-de="Sprechen wir" data-es="Hablemos">Let's talk</span>
          <h2 data-en="Tell us what you're working on." data-de="Erzählen Sie uns von Ihrem Projekt." data-es="Contanos en qué estás trabajando.">Tell us what you're working on.</h2>
          <p class="lead" data-en="Tell us your goal — we'll come back with timing and a clear quote within 48 hours. Free, no obligation." data-de="Nennen Sie uns Ihr Ziel — wir melden uns innert 48 Stunden mit Timing und einem klaren Angebot. Kostenlos und unverbindlich." data-es="Contanos tu objetivo — volvemos en 48 horas con tiempos y un presupuesto claro. Gratis y sin compromiso.">Tell us your goal — we'll come back with timing and a clear quote within 48 hours. Free, no obligation.</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 13 4 4L19 7"/></svg><span data-en="First draft within two weeks" data-de="Erster Entwurf in zwei Wochen" data-es="Primer borrador en dos semanas">First draft within two weeks</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 13 4 4L19 7"/></svg><span data-en="One partner, brief to delivery" data-de="Ein Partner, vom Brief bis zur Auslieferung" data-es="Un partner, de principio a fin">One partner, brief to delivery</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 13 4 4L19 7"/></svg><span data-en="Multilingual delivery" data-de="Mehrsprachige Auslieferung" data-es="Entrega multilingüe">Multilingual delivery</span></li>
          </ul>
        </div>
        <div>
          <div class="lead-form-mount"></div>
          <p class="form-note" data-en="We'll reply within one business day. No spam, ever." data-de="Wir antworten innerhalb eines Werktags. Kein Spam." data-es="Respondemos en un día hábil. Nunca spam.">We'll reply within one business day. No spam, ever.</p>
          <p class="book-call-note"><span data-en="Prefer to talk it through?" data-de="Lieber direkt sprechen?" data-es="¿Preferís hablarlo directamente?">Prefer to talk it through?</span> <a class="book-call" href="/book/" target="_blank" rel="noopener" data-en="Book a free 15-min call →" data-de="Gratis 15-Min-Call buchen →" data-es="Reservá una llamada gratis de 15 min →">Book a free 15-min call →</a></p>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    .rsrc-h1{font-size:clamp(28px,4.4vw,44px)!important}
    .rsrc-linkout{margin:18px 0 0;padding:14px 18px;border:1px solid var(--line);border-radius:13px;background:var(--navy-800);color:var(--muted);font-size:14.5px;line-height:1.6}
    .rsrc-linkout a{color:var(--acid);font-weight:600;text-decoration:none}
    .rsrc-linkout a:hover{text-decoration:underline}
    .rsrc-body{max-width:820px}
    .rsrc-sec{margin-bottom:30px}
    .rsrc-sec h2{font-size:clamp(19px,2.6vw,24px);margin-bottom:12px}
    .rsrc-sec p{color:var(--muted);font-size:15.5px;line-height:1.75;margin-bottom:12px}
    .rsrc-sec ul{margin:0 0 12px 20px;color:var(--muted);font-size:15.5px;line-height:1.75}
    .rsrc-sec li{margin-bottom:6px}
    .rsrc-sec strong{color:var(--text)}
    .rsrc-ctabox{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;border:1px solid var(--line-strong);background:var(--navy-800);border-radius:18px;padding:26px 28px;margin:40px 0 8px}
    .rsrc-ctat{font-family:'Space Grotesk';font-weight:700;font-size:20px;margin-bottom:6px}
    .rsrc-ctas{color:var(--muted);font-size:14px;max-width:460px;margin:0}
    .rsrc-ctabtns{display:flex;gap:10px;flex-wrap:wrap}
  </style>
</Base>
