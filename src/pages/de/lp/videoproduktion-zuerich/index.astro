---
import Base from '../../../../layouts/Base.astro';
import VideoGallery from '../../../../components/VideoGallery.astro';
import Testimonials from '../../../../components/Testimonials.astro';
import { localePath } from '../../../../i18n.js';
const lang = "de";
const p = (s) => localePath(lang, s);
const title = {"de":"Videoproduktion Zürich — Fixofferte in 48h | Viven"};
const description = {"de":"Schweizer Videoproduktion, der UBS, Siemens und FIFA vertrauen. Drei Konzeptideen und eine Fixofferte innert 48 Stunden — kostenlos."};
---
<Base lang={lang} slug="lp/videoproduktion-zuerich" active="" singleLang={true} langUrls={{"de":"/de/lp/videoproduktion-zuerich/","en":"/en/lp/video-production-zurich/","es":"/es/lp/produccion-de-video-zurich/"}} title={title} description={description}>
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Videoproduktion Zürich</span>
    <h1 class="rsrc-h1" set:html={`Videos, die verkaufen.<br/>Produziert in Zürich.`}></h1>
    <p class="lead" style="max-width:760px">Vom Markenfilm bis zum Produktvideo: ein Partner von der Idee bis zur Auslieferung — vertraut von UBS, Siemens, Porsche, ON und FIFA. Fixofferten ab CHF 4’000 — Sie geben das Budget frei, bevor wir drehen.</p>
    <p style="margin-top:22px;display:flex;gap:14px;align-items:center;flex-wrap:wrap">
      
      
</p>
    <p class="muted-note" style="margin-top:24px;letter-spacing:.6px;text-transform:uppercase;font-size:11px;opacity:.7">Vertraut von: UBS · Siemens · Porsche · ON · FIFA · Philips · V-ZUG</p>
  </div>
</section>
<section class="sec" style="padding-top:10px"><div class="wrap">
  <div class="lp-hero-video"><video src="/assets/heroes/1057568537.mp4" autoplay muted loop playsinline></video></div>
</div></section>
<section class="sec"><div class="wrap">
  <div class="lp-bens"><div class="lpb reveal"><span class="ic">🎯</span><h3>Strategie zuerst</h3><p>Jeder Film beginnt bei Ihrem Geschäftsziel — Leads, Recruiting oder Bekanntheit. Keine schönen, aber nutzlosen Videos.</p></div><div class="lpb reveal"><span class="ic">💎</span><h3>Fixofferte, null Überraschungen</h3><p>Klare Offerte innert 48 Stunden, ab CHF 4’000. Was offeriert ist, wird bezahlt — keine versteckten Posten.</p></div><div class="lpb reveal"><span class="ic">⚡</span><h3>Erster Schnitt in 2 Wochen</h3><p>Schnelle, mehrsprachige Lieferung: Deutsch, Englisch, Französisch oder Italienisch — inkl. Untertitel und Social Cut-downs.</p></div></div>
</div></section>
<section class="sec" style="padding-top:0"><div class="wrap">
  <div class="sec-head center"><span class="eyebrow">So läuft es ab</span></div>
  <div class="lp-steps"><div class="lps reveal"><span class="n">01</span><h3>Ziel besprechen</h3><p>15 Minuten — Call oder Formular. Was soll das Video erreichen?</p></div><div class="lps reveal"><span class="n">02</span><h3>Konzept + Offerte in 48h</h3><p>Drei Konzeptrichtungen, Timing und ein Fixpreis. Kostenlos.</p></div><div class="lps reveal"><span class="n">03</span><h3>Erster Schnitt in 2 Wochen</h3><p>Wir drehen, Sie geben frei. Korrekturen inklusive, bis es sitzt.</p></div></div>
</div></section>
<section class="sec" style="padding-top:0"><div class="wrap">
  <h2 style="font-size:22px;margin-bottom:20px">Aktuelle Arbeiten</h2>
  <VideoGallery lang={lang} limit={3} seed="lp/videoproduktion-zuerich" />
</div></section>
<Testimonials lang={lang} />
<section class="cta closed-notice" id="start" style="padding-top:0">
  <div class="wrap">
    <div class="cta-card reveal" style="display:block;text-align:center">
      <p class="lead" style="margin:0" data-en="We are no longer accepting new projects or inquiries." data-de="Wir nehmen keine neuen Projekte und Anfragen mehr entgegen." data-es="Ya no aceptamos nuevos proyectos ni consultas.">We are no longer accepting new projects or inquiries.</p>
    </div>
  </div>
</section>

<section class="sec" style="padding-top:0"><div class="wrap">
  <p style="text-align:center"><a class="book-call" href="/de/videoproduktion-kosten-rechner/">🧮 Noch nicht bereit für ein Gespräch? Videokosten in 60 Sekunden berechnen →</a></p>
</div></section>
<style is:global>
.rsrc-h1{font-size:clamp(30px,4.6vw,50px)!important;line-height:1.08}
.lp-hero-video{position:relative;aspect-ratio:16/9;border-radius:20px;overflow:hidden;border:1px solid var(--line-strong)}
.lp-hero-video video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.lp-bens{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}
.lp-bens .lpb{background:var(--navy-800);border:1px solid var(--line-strong);border-radius:18px;padding:26px 24px}
.lp-bens .lpb .ic{font-size:28px}
.lp-bens .lpb h3{font-family:'Space Grotesk';font-size:17.5px;margin:12px 0 8px}
.lp-bens .lpb p{font-size:14.5px;color:var(--muted);line-height:1.65;margin:0}
.lp-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;max-width:940px;margin:0 auto}
.lp-steps .lps{border:1px solid var(--line);border-radius:18px;padding:24px;position:relative}
.lp-steps .lps .n{font-family:'Space Grotesk';font-weight:800;font-size:14px;color:var(--acid);letter-spacing:1px}
.lp-steps .lps h3{font-family:'Space Grotesk';font-size:16.5px;margin:10px 0 6px}
.lp-steps .lps p{font-size:14px;color:var(--muted);line-height:1.6;margin:0}
</style>
</Base>
