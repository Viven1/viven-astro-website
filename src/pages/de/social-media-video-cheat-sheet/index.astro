---
import Base from '../../../layouts/Base.astro';
import LeadMagnet from '../../../components/LeadMagnet.astro';
import CalcBanner from '../../../components/CalcBanner.astro';
import { localePath, SITE } from '../../../i18n.js';
const lang = "de";
const p = (s) => localePath(lang, s);
const title = {"de":"Social-Media-Video Cheat-Sheet 2026 — Gratis-PDF | Viven"};
const description = {"de":"Gratis-Download: alle plattform-nativen Videoformate, Längen und Specs — YouTube, Reels, TikTok, LinkedIn — auf einer Seite. Vom Team, das für UBS und Siemens produziert."};
const URL = SITE + "/de/social-media-video-cheat-sheet/";
const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": URL + "#breadcrumbs",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE + "/" },
        { "@type": "ListItem", "position": 2, "name": "Kostenlose Tools", "item": SITE + "/de/tools/" },
        { "@type": "ListItem", "position": 3, "name": "Social-Media-Video Cheat-Sheet 2026", "item": URL }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": URL + "#faq",
      "mainEntity": [
        { "@type": "Question", "name": "Ist das Cheat-Sheet wirklich gratis?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Arbeits-E-Mail eintragen und das PDF wird sofort heruntergeladen — kostenlos und unverbindlich. Gelegentlich melden wir uns mit wirklich nützlichem Video-Content; abmelden können Sie sich jederzeit." } },
        { "@type": "Question", "name": "Welche Plattformen deckt es ab?", "acceptedAnswer": { "@type": "Answer", "text": "YouTube Shorts und Long-Form, Instagram Reels, Stories und Feed, TikTok und LinkedIn — mit Format, Framerate, idealer Länge und technischen Hinweisen zu jeder Plattform, alles auf einer A4-Seite." } },
        { "@type": "Question", "name": "Warum sind plattform-native Formate wichtig?", "acceptedAnswer": { "@type": "Answer", "text": "Weil die Algorithmen sie belohnen. Wir messen rund 40% mehr Engagement mit plattform-nativen Formaten gegenüber gestreckten Re-Uploads. Native Specs sind keine Pflichtübung — sie sind Wettbewerbsvorteil." } },
        { "@type": "Question", "name": "Wer hat dieses Cheat-Sheet gemacht?", "acceptedAnswer": { "@type": "Answer", "text": "Viven, eine Videoproduktionsfirma aus Zürich. Es ist dieselbe Referenz, die unsere Producer bei Drehs für Marken wie UBS, Siemens, Porsche, ON und FIFA nutzen." } }
      ]
    }
  ]
});
---
<Base lang={lang} slug="social-media-video-cheat-sheet" active="tools" singleLang={true} langUrls={{"en":"/en/social-media-video-cheat-sheet/","de":"/de/social-media-video-cheat-sheet/","es":"/es/cheat-sheet-video-redes-sociales/"}} title={title} description={description}>
  <script type="application/ld+json" slot="jsonld" set:html={ld}></script>

<!-- ============ PAGE HERO ============ -->
<section class="page-hero">
  <div class="wrap">
    <div class="crumbs">
      <a href={p("")}>Home</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href={p("tools")}>Kostenlose Tools</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span>Social-Media-Video Cheat-Sheet 2026</span>
    </div>
    <span class="eyebrow">Gratis-Download</span>
    <h1>Social-Media-Video Cheat-Sheet 2026 — <span class="hl">Gratis-Download</span></h1>
    <p class="lead">Alle plattform-nativen Formate, Frameraten, idealen Längen und Specs für YouTube, Reels, TikTok und LinkedIn — auf einer A4-Seite. Zusammengestellt vom Team, das Social Video für UBS, Siemens, Porsche und ON produziert — dieselbe Referenz, die unsere Producer am Set nutzen.</p>
    <div class="hero-cta">
      <a href="#download" class="btn btn-primary">Gratis-PDF herunterladen</a>
      <a href="#inside" class="btn btn-ghost">Was drin ist</a>
    </div>
  </div>
</section>

<!-- ============ PREVIEW ============ -->
<section class="sec" style="padding-top:24px">
  <div class="wrap">
    <div class="reveal" style="text-align:center">
      <a href="#download" title="PDF herunterladen">
        <img src="/assets/cheatsheet-preview-de.png" width="800" height="1131" alt="Vorschau des Social-Media-Video Cheat-Sheets 2026 — einseitiges PDF mit Formaten, Längen und Specs pro Plattform" decoding="async" style="width:100%;max-width:480px;border-radius:14px;box-shadow:0 24px 64px rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.12)" />
      </a>
      <p style="font-size:13.5px;opacity:.65;margin-top:14px">Eine Seite. Sieben Plattformen. Kein Raten am Export-Tag.</p>
    </div>
  </div>
</section>

<!-- ============ WHAT'S INSIDE ============ -->
<section class="sec" id="inside" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Was drin ist</span>
      <h2>Sieben Plattformen. Eine Seite. Kein Raten.</h2>
      <p>Das richtige Format und die richtige Länge für jede Plattform, auf der Sie publizieren — die komplette Spec-Tabelle mit Frameraten, Codecs, Bitraten und Dateilimits steht im PDF.</p>
    </div>
    <div class="value-grid">
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/></svg></div>
        <h3>YouTube Shorts</h3>
        <p>Vertikal 1080×1920 (9:16) — vertikal ist die native Erwartung. Maximal 60 Sekunden.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/></svg></div>
        <h3>YouTube Long-Form</h3>
        <p>Klassisch 1920×1080 (16:9) für den Haupt-Feed. 8–12 Minuten sind der Sweet Spot — Watch-Time schlägt Dauer.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/><circle cx="12" cy="18" r="1"/></svg></div>
        <h3>Instagram Reels</h3>
        <p>Vertikal 1080×1920 (9:16), bis 90 Sekunden — kürzer gewinnt meist. Hier lebt die Instagram-Reichweite 2026.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/><path d="M4 8v8M20 8v8"/></svg></div>
        <h3>Instagram Stories</h3>
        <p>Dasselbe vertikale 1080×1920-Asset (9:16) wie bei Reels. Maximal 15 Sekunden pro Story.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="3" width="12" height="18" rx="2"/></svg></div>
        <h3>Instagram Feed</h3>
        <p>Hochformat 1080×1350 (4:5) — wird vom Algorithmus aber zunehmend begraben. Reels priorisieren.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/><path d="M12 6v4l3 2"/></svg></div>
        <h3>TikTok</h3>
        <p>Vertikal 1080×1920 (9:16), nativ hochgeladen. 15–34 Sekunden sind der Sweet Spot.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/></svg></div>
        <h3>LinkedIn</h3>
        <p>Quadratisch 1:1 oder Hochformat 4:5, nur nativer Upload. 60–90 Sekunden für professionelle Feeds.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg></div>
        <h3>Plus: die drei Regeln</h3>
        <p>«Einmal drehen, nativ ausliefern» · «Die erste Sekunde ist das Thumbnail» · «Immer Untertitel» — jede im PDF erklärt.</p>
      </div>
    </div>
    <p class="reveal" style="text-align:center;margin-top:32px;font-size:15px;opacity:.8">Das PDF ergänzt die komplette Spec-Tabelle: Frameraten, Codecs, Bitraten, Dateigrössen-Limits und technische Hinweise pro Plattform.</p>
  </div>
</section>

<!-- ============ GATE ============ -->
<div id="download">
  <LeadMagnet lang={lang} magnet="social-formats" />
</div>

<!-- ============ WHO IT'S FOR ============ -->
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Für wen es ist</span>
      <h2>Gemacht für alle, die Social Video liefern.</h2>
    </div>
    <div class="value-grid">
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg></div>
        <h3>Marketing-Manager</h3>
        <p>Agenturen und interne Teams vom ersten Tag an mit den richtigen Specs briefen — keine Re-Exporte in der Nacht vor dem Launch.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></div>
        <h3>Social-Media-Manager</h3>
        <p>Eine Referenz neben dem Content-Kalender — und auf jeder Plattform jedes Mal nativ publizieren.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
        <h3>Gründer:innen</h3>
        <p>Vorerst alles selbst gemacht? Sparen Sie sich die Spec-Recherche und stecken Sie die Zeit in die Story.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="sec" id="faq" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2>Das Cheat-Sheet, beantwortet.</h2>
    </div>
    <div class="faq reveal">
      <details>
        <summary>Ist das Cheat-Sheet wirklich gratis?</summary>
        <p>Ja. Arbeits-E-Mail eintragen und das PDF wird sofort heruntergeladen — kostenlos und unverbindlich. Gelegentlich melden wir uns mit wirklich nützlichem Video-Content; abmelden können Sie sich jederzeit.</p>
      </details>
      <details>
        <summary>Welche Plattformen deckt es ab?</summary>
        <p>YouTube Shorts und Long-Form, Instagram Reels, Stories und Feed, TikTok und LinkedIn — mit Format, Framerate, idealer Länge und technischen Hinweisen zu jeder Plattform, alles auf einer A4-Seite.</p>
      </details>
      <details>
        <summary>Warum sind plattform-native Formate wichtig?</summary>
        <p>Weil die Algorithmen sie belohnen. Wir messen rund 40% mehr Engagement mit plattform-nativen Formaten gegenüber gestreckten Re-Uploads. Native Specs sind keine Pflichtübung — sie sind Wettbewerbsvorteil.</p>
      </details>
      <details>
        <summary>Wer hat dieses Cheat-Sheet gemacht?</summary>
        <p>Viven, eine Videoproduktionsfirma aus Zürich. Es ist dieselbe Referenz, die unsere Producer bei Drehs für Marken wie UBS, Siemens, Porsche, ON und FIFA nutzen.</p>
      </details>
    </div>
  </div>
</section>

<!-- ============ RELATED ============ -->
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="related reveal">
      <h2>Weiterlesen</h2>
      <div class="related-grid">
        <a href="/de/blog/social-media-video-formate-2026/" class="related-card reveal">
          <h3>Social-Media-Videos 2026: Formate, Längen und Specs</h3>
          <p>Der komplette Guide hinter dem Cheat-Sheet — die Begründung hinter jeder Spec, Plattform für Plattform.</p>
          <span class="more">Guide lesen →</span>
        </a>
        <a href={p("services/social-media-video")} class="related-card reveal">
          <h3>Social-Media-Videoproduktion</h3>
          <p>Scroll-stoppende Short-Form-Serien in 9:16, als Batch in Zürich produziert — damit Ihr Feed nie verstummt.</p>
          <span class="more">Zur Leistung →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<CalcBanner lang={lang} />
</Base>
