<Base lang={lang} slug="blog/multilingual-video-swiss-languages" active="blog" singleLang={true} langUrls={{"en":"/en/blog/multilingual-video-swiss-languages/","de":"/de/blog/","es":"/es/blog/"}} title={title} description={description}>
