      <div class="related-grid">
      {related.map((r) => (
        <a href={'/en/blog/' + r.slug + '/'} class="related-card reveal">
          <h3>{r.title}</h3>
          <p>{r.desc}</p>
          <span class="more">Read more →</span>
        </a>
      ))}
      </div>
    </div>
  </div>
</section>

<CalcBanner lang={lang} />

