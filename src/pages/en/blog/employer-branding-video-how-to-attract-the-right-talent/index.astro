---
import Base from '../../../../layouts/Base.astro';
import CalcBanner from '../../../../components/CalcBanner.astro';
import VideoGallery from '../../../../components/VideoGallery.astro';
import AuthorBox from '../../../../components/AuthorBox.astro';
const lang = 'en';
const title = {"en":"Employer Branding Video: How to Attract the Right Talent | Viven"};
const description = {"en":"Top candidates choose where to work too. How an employer branding film shows your real culture and attracts the talent your company actually wants."};

// Related reading: 3 posts hermanos con mayor overlap de palabras del slug — se recalcula en cada build
const OWN_SLUG = "employer-branding-video-how-to-attract-the-right-talent";
const REL_STOP = new Set(['the','and','with','for','your','how','what','why','video','videos','videoproduktion','videoproduccion','production','produktion','produccion','company','agentur','agency','marken','brands','marcas','schweiz','switzerland','suiza','zurich','zuerich','que','como','con','para','der','die','das','und','fuer','von','wie','ein','eine']);
const relWords = (x) => new Set(String(x).split('-').filter((w) => w.length > 2 && !REL_STOP.has(w)));
const relOwn = relWords(OWN_SLUG);
const related = Object.entries(import.meta.glob('../*/index.astro', { query: '?raw', import: 'default', eager: true }))
  .map(([rp, rraw]) => {
    const rslug = rp.split('/')[1];
    if (rslug === OWN_SLUG) return null;
    const rm = String(rraw).match(/const title = [{]"[a-z]{2}":("(?:[^"\\]|\\.)*")[}]/);
    const dm = String(rraw).match(/const description = [{]"[a-z]{2}":("(?:[^"\\]|\\.)*")[}]/);
    let rtitle = rslug, rdesc = '';
    try { if (rm) rtitle = JSON.parse(rm[1]).replace(/ \| Viven$/, ''); if (dm) rdesc = JSON.parse(dm[1]); } catch (e) { /* archivo irregular */ }
    let score = 0; relWords(rslug).forEach((w) => { if (relOwn.has(w)) score++; });
    return { slug: rslug, title: rtitle, desc: rdesc, score };
  }).filter(Boolean).sort((a, b) => b.score - a.score).slice(0, 3);
---
<Base lang={lang} slug="blog/employer-branding-video-how-to-attract-the-right-talent" active="blog" singleLang={true} langUrls={{"en":"/en/blog/employer-branding-video-how-to-attract-the-right-talent/","de":"/de/blog/employer-branding-video-wie-du-die-richtigen-talente-anziehst/","es":"/es/blog/employer-branding-en-video-como-atraer-al-talento-correcto/"}} title={title} description={description}>
  <script type="application/ld+json" slot="jsonld" set:html={"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BlogPosting\",\"@id\":\"https://www.viven.ch/en/blog/employer-branding-video-how-to-attract-the-right-talent/#article\",\"headline\":\"Employer Branding Video: How to Attract the Right Talent\",\"description\":\"Top candidates choose where to work too. How an employer branding film shows your real culture and attracts the talent your company actually wants.\",\"image\":\"https://i.vimeocdn.com/video/1996945412-11440cd0df3521e998bff13bcaab8bbed2a405430e442c73f998df74099d28b2-d_960?region=us\",\"datePublished\":\"2026-07-21\",\"dateModified\":\"2026-07-21\",\"inLanguage\":\"en\",\"author\":{\"@type\":\"Organization\",\"name\":\"Viven AG\",\"url\":\"https://www.viven.ch/\"},\"publisher\":{\"@id\":\"https://www.viven.ch/#organization\"},\"mainEntityOfPage\":{\"@id\":\"https://www.viven.ch/en/blog/employer-branding-video-how-to-attract-the-right-talent/\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.viven.ch/en/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://www.viven.ch/en/blog/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Employer Branding Video: How to Attract the Right Talent\",\"item\":\"https://www.viven.ch/en/blog/employer-branding-video-how-to-attract-the-right-talent/\"}]}]}"}></script>
  <section class="page-hero post-hero">
    <div class="wrap">
      <div class="post-wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/en/">Home</a>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          <a href="/en/blog/">Blog</a>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          <span>Employer Branding Video: How to Attract the Right Talent</span>
        </nav>
        <span class="eyebrow">Employer Branding</span>
        <h1>Employer Branding Video: How to Attract the Right Talent</h1>
        <p class="lead">In today's job market, companies aren't the only ones choosing — top candidates are choosing too. An employer branding film is the most powerful way to show them why they should choose you.</p>
        <p class="post-meta"><span>Viven Team</span> <span>·</span> <span>July 21, 2026</span></p>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:40px">
    <div class="wrap">
      <div class="post-wrap post-body reveal">
      <img src="https://i.vimeocdn.com/video/1996945412-11440cd0df3521e998bff13bcaab8bbed2a405430e442c73f998df74099d28b2-d_960?region=us" alt="Employer Branding Video: How to Attract the Right Talent" loading="eager" style="width:100%;border-radius:16px;margin:8px 0 26px;aspect-ratio:16/9;object-fit:cover" />

      <h2>Show your real culture, not stock footage</h2>
      <p>The most common employer branding mistake is looking like everyone else: generic imagery, stock-photo smiles, empty phrases. The talent you actually want to attract spots that instantly. A good film shows your real people, your real spaces, your real way of working. Authenticity is what makes it land.</p>

      <h2>Attract the right people, not everyone</h2>
      <p>A good employer branding video isn't trying to appeal to everyone — it's trying to resonate with the right people, and filter out the ones who wouldn't be a fit along the way. That lowers cost-per-hire and improves the quality of the candidates who apply.</p>

      <h2>Where an employer branding film lives</h2>
      <p>These films work on several fronts at once:</p>
      <ul>
      <li>On your <strong>careers page</strong>, where they turn visitors into applicants.</li>
      <li>On <strong>LinkedIn</strong> and job ads, where they boost response rates.</li>
      <li>In the hiring process, where they help candidates fall for the company before the interview.</li>
      </ul>

      <h2>Brands already doing this</h2>
      <p>We've produced employer branding films for UBS, Siemens and KPMG that attract exactly the candidate profile they're looking for. The key is always the same: a real story, told with real filmmaking craft.</p>

      
      </div>
    </div>
  </section>
<AuthorBox lang={lang} />
  <!-- ============ RELATED ============ -->
