    </div>
  </div>
</section>

<section class="sec blog-videos" style="padding-top:0"><div class="wrap">
    <h2 style="font-size:22px;margin-bottom:20px">See our work</h2>
    <VideoGallery lang={lang} limit={3} seed="employer-branding-video-how-to-attract-the-right-talent" />
  </div></section>
</Base>
