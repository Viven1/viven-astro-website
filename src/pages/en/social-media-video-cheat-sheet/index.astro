---
import Base from '../../../layouts/Base.astro';
import LeadMagnet from '../../../components/LeadMagnet.astro';
import CalcBanner from '../../../components/CalcBanner.astro';
import { localePath, SITE } from '../../../i18n.js';
const lang = "en";
const p = (s) => localePath(lang, s);
const title = {"en":"Social Media Video Cheat Sheet 2026 — Free PDF | Viven"};
const description = {"en":"Free download: every platform-native video format, length and spec — YouTube, Reels, TikTok, LinkedIn — on one page, from the team producing for UBS and Siemens."};
const URL = SITE + "/en/social-media-video-cheat-sheet/";
const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": URL + "#breadcrumbs",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE + "/" },
        { "@type": "ListItem", "position": 2, "name": "Free tools", "item": SITE + "/en/tools/" },
        { "@type": "ListItem", "position": 3, "name": "Social Media Video Cheat Sheet 2026", "item": URL }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": URL + "#faq",
      "mainEntity": [
        { "@type": "Question", "name": "Is the cheat sheet really free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Enter your work email and the PDF downloads immediately — no cost, no obligation. We may follow up with occasional, genuinely useful video content, and you can unsubscribe any time." } },
        { "@type": "Question", "name": "Which platforms does it cover?", "acceptedAnswer": { "@type": "Answer", "text": "YouTube Shorts and long-form, Instagram Reels, Stories and Feed, TikTok and LinkedIn — with format, frame rate, ideal length and technical notes for each, all on a single A4 page." } },
        { "@type": "Question", "name": "Why do platform-native formats matter?", "acceptedAnswer": { "@type": "Answer", "text": "Because algorithms reward them. We've measured around 40% higher engagement with platform-native formats versus stretched re-uploads. Native specs aren't compliance — they're competitive advantage." } },
        { "@type": "Question", "name": "Who made this cheat sheet?", "acceptedAnswer": { "@type": "Answer", "text": "Viven, a video production company based in Zurich, Switzerland. It's the same reference our producers use on shoots for brands like UBS, Siemens, Porsche, ON and FIFA." } }
      ]
    }
  ]
});
---
<Base lang={lang} slug="social-media-video-cheat-sheet" active="tools" singleLang={true} langUrls={{"en":"/en/social-media-video-cheat-sheet/","de":"/de/social-media-video-cheat-sheet/","es":"/es/cheat-sheet-video-redes-sociales/"}} title={title} description={description}>
  <script type="application/ld+json" slot="jsonld" set:html={ld}></script>

<!-- ============ PAGE HERO ============ -->
<section class="page-hero">
  <div class="wrap">
    <div class="crumbs">
      <a href={p("")}>Home</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href={p("tools")}>Free tools</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span>Social Media Video Cheat Sheet 2026</span>
    </div>
    <span class="eyebrow">Free download</span>
    <h1>Social Media Video Cheat Sheet 2026 — <span class="hl">Free Download</span></h1>
    <p class="lead">Every platform-native format, frame rate, ideal length and spec for YouTube, Reels, TikTok and LinkedIn — on one A4 page. Compiled by the team producing social video for UBS, Siemens, Porsche and ON, and the same reference our own producers use on set.</p>
    <div class="hero-cta">
      <a href="#download" class="btn btn-primary">Download the free PDF</a>
      <a href="#inside" class="btn btn-ghost">See what's inside</a>
    </div>
  </div>
</section>

<!-- ============ PREVIEW ============ -->
<section class="sec" style="padding-top:24px">
  <div class="wrap">
    <div class="reveal" style="text-align:center">
      <a href="#download" title="Download the PDF">
        <img src="/assets/cheatsheet-preview-en.png" width="800" height="1131" alt="Preview of the Social Media Video Cheat Sheet 2026 — one-page PDF with formats, lengths and specs per platform" decoding="async" style="width:100%;max-width:480px;border-radius:14px;box-shadow:0 24px 64px rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.12)" />
      </a>
      <p style="font-size:13.5px;opacity:.65;margin-top:14px">One page. Seven platforms. Zero guessing on export day.</p>
    </div>
  </div>
</section>

<!-- ============ WHAT'S INSIDE ============ -->
<section class="sec" id="inside" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">What's inside</span>
      <h2>Seven platforms. One page. No guessing.</h2>
      <p>The right format and length for every platform you publish on — the full spec table with frame rates, codecs, bitrates and file limits is in the PDF.</p>
    </div>
    <div class="value-grid">
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/></svg></div>
        <h3>YouTube Shorts</h3>
        <p>Vertical 1080×1920 (9:16) — vertical is the native expectation. Keep it at 60 seconds or less.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/></svg></div>
        <h3>YouTube long-form</h3>
        <p>Classic 1920×1080 (16:9) for the main feed. 8–12 minutes is the sweet spot — watch-time beats duration.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/><circle cx="12" cy="18" r="1"/></svg></div>
        <h3>Instagram Reels</h3>
        <p>Vertical 1080×1920 (9:16), up to 90 seconds — shorter usually wins. Where Instagram reach lives in 2026.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/><path d="M4 8v8M20 8v8"/></svg></div>
        <h3>Instagram Stories</h3>
        <p>Same vertical 1080×1920 (9:16) asset as Reels. 15 seconds max per story card.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="3" width="12" height="18" rx="2"/></svg></div>
        <h3>Instagram Feed</h3>
        <p>Portrait 1080×1350 (4:5) — but increasingly buried by the algorithm. Prioritize Reels.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/><path d="M12 6v4l3 2"/></svg></div>
        <h3>TikTok</h3>
        <p>Vertical 1080×1920 (9:16), uploaded natively. 15–34 seconds is the sweet spot.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/></svg></div>
        <h3>LinkedIn</h3>
        <p>Square 1:1 or portrait 4:5, native upload only. 60–90 seconds for professional feeds.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg></div>
        <h3>Plus: the three rules</h3>
        <p>"Shoot once, deliver native" · "The first second is the thumbnail" · "Captions always" — each explained in the PDF.</p>
      </div>
    </div>
    <p class="reveal" style="text-align:center;margin-top:32px;font-size:15px;opacity:.8">The PDF adds the full spec table: frame rates, codecs, bitrates, file-size limits and per-platform technical notes.</p>
  </div>
</section>

<!-- ============ GATE ============ -->
<div id="download">
  <LeadMagnet lang={lang} magnet="social-formats" />
</div>

<!-- ============ WHO IT'S FOR ============ -->
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Who it's for</span>
      <h2>Made for the people who ship social video.</h2>
    </div>
    <div class="value-grid">
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg></div>
        <h3>Marketing managers</h3>
        <p>Brief agencies and internal teams with the right specs from day one — no more re-exports the night before launch.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></div>
        <h3>Social media managers</h3>
        <p>Keep one reference next to your content calendar and publish native on every platform, every time.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
        <h3>Founders</h3>
        <p>Doing it yourself for now? Skip the spec rabbit holes and put the time into the story instead.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="sec" id="faq" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2>The cheat sheet, answered.</h2>
    </div>
    <div class="faq reveal">
      <details>
        <summary>Is the cheat sheet really free?</summary>
        <p>Yes. Enter your work email and the PDF downloads immediately — no cost, no obligation. We may follow up with occasional, genuinely useful video content, and you can unsubscribe any time.</p>
      </details>
      <details>
        <summary>Which platforms does it cover?</summary>
        <p>YouTube Shorts and long-form, Instagram Reels, Stories and Feed, TikTok and LinkedIn — with format, frame rate, ideal length and technical notes for each, all on a single A4 page.</p>
      </details>
      <details>
        <summary>Why do platform-native formats matter?</summary>
        <p>Because algorithms reward them. We've measured around 40% higher engagement with platform-native formats versus stretched re-uploads. Native specs aren't compliance — they're competitive advantage.</p>
      </details>
      <details>
        <summary>Who made this cheat sheet?</summary>
        <p>Viven, a video production company based in Zurich, Switzerland. It's the same reference our producers use on shoots for brands like UBS, Siemens, Porsche, ON and FIFA.</p>
      </details>
    </div>
  </div>
</section>

<!-- ============ RELATED ============ -->
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="related reveal">
      <h2>Go deeper</h2>
      <div class="related-grid">
        <a href="/en/blog/social-media-video-2026-formats-lengths-specs/" class="related-card reveal">
          <h3>Social Media Video 2026: Formats, Lengths &amp; Specs</h3>
          <p>The full written guide behind the cheat sheet — the reasoning behind every spec, platform by platform.</p>
          <span class="more">Read the guide →</span>
        </a>
        <a href={p("services/social-media-video")} class="related-card reveal">
          <h3>Social Media Video Production</h3>
          <p>Scroll-stopping short-form series in 9:16, batch-produced in Zurich — so your feed never goes quiet.</p>
          <span class="more">See the service →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<CalcBanner lang={lang} />
</Base>
