---
import Base from '../../../../layouts/Base.astro';
import VideoGallery from '../../../../components/VideoGallery.astro';
import Testimonials from '../../../../components/Testimonials.astro';
import { localePath } from '../../../../i18n.js';
const lang = "es";
const p = (s) => localePath(lang, s);
const title = {"es":"Producción de Video Zúrich — Presupuesto fijo en 48h | Viven"};
const description = {"es":"Productora de video suiza en la que confían UBS, Siemens y FIFA. Tres ideas de concepto y un presupuesto fijo en 48 horas — gratis."};
---
<Base lang={lang} slug="lp/produccion-de-video-zurich" active="" singleLang={true} langUrls={{"es":"/es/lp/produccion-de-video-zurich/","en":"/en/lp/video-production-zurich/","de":"/de/lp/videoproduktion-zuerich/"}} title={title} description={description}>
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Producción de video Zúrich</span>
    <h1 class="rsrc-h1" set:html={`Videos que venden.<br/>Producidos en Zúrich.`}></h1>
    <p class="lead" style="max-width:760px">Del video de marca al video de producto: un solo partner del concepto a la entrega — con la confianza de UBS, Siemens, Porsche, ON y FIFA. Presupuestos fijos desde CHF 4.000 — aprobás el presupuesto antes de que rodemos un solo frame.</p>
    <p style="margin-top:22px;display:flex;gap:14px;align-items:center;flex-wrap:wrap">
      
      
</p>
    <p class="muted-note" style="margin-top:24px;letter-spacing:.6px;text-transform:uppercase;font-size:11px;opacity:.7">Confían en nosotros: UBS · Siemens · Porsche · ON · FIFA · Philips · V-ZUG</p>
  </div>
</section>
<section class="sec" style="padding-top:10px"><div class="wrap">
  <div class="lp-hero-video"><video src="/assets/heroes/1057568537.mp4" autoplay muted loop playsinline></video></div>
</div></section>
<section class="sec"><div class="wrap">
  <div class="lp-bens"><div class="lpb reveal"><span class="ic">🎯</span><h3>Primero la estrategia</h3><p>Cada video parte de tu objetivo de negocio — leads, talento o awareness. Nada de videos lindos pero inútiles.</p></div><div class="lpb reveal"><span class="ic">💎</span><h3>Presupuesto fijo, cero sorpresas</h3><p>Oferta clara en 48 horas, desde CHF 4.000. Lo cotizado es lo que pagás.</p></div><div class="lpb reveal"><span class="ic">⚡</span><h3>Primer corte en 2 semanas</h3><p>Entrega rápida y multilingüe: alemán, inglés, francés o español — con subtítulos y cortes para redes incluidos.</p></div></div>
</div></section>
<section class="sec" style="padding-top:0"><div class="wrap">
  <div class="sec-head center"><span class="eyebrow">Cómo funciona</span></div>
  <div class="lp-steps"><div class="lps reveal"><span class="n">01</span><h3>Contanos tu objetivo</h3><p>15 minutos — llamada o formulario. ¿Qué tiene que lograr el video?</p></div><div class="lps reveal"><span class="n">02</span><h3>Concepto + presupuesto en 48h</h3><p>Tres direcciones de concepto, tiempos y un precio fijo. Gratis.</p></div><div class="lps reveal"><span class="n">03</span><h3>Primer corte en 2 semanas</h3><p>Rodamos, vos aprobás. Correcciones incluidas hasta que funcione.</p></div></div>
</div></section>
<section class="sec" style="padding-top:0"><div class="wrap">
  <h2 style="font-size:22px;margin-bottom:20px">Trabajos recientes</h2>
  <VideoGallery lang={lang} limit={3} seed="lp/produccion-de-video-zurich" />
</div></section>
<Testimonials lang={lang} />
<section class="cta closed-notice" id="start" style="padding-top:0">
  <div class="wrap">
    <div class="cta-card reveal" style="display:block;text-align:center">
      <p class="lead" style="margin:0" data-en="We are no longer accepting new projects or inquiries." data-de="Wir nehmen keine neuen Projekte und Anfragen mehr entgegen." data-es="Ya no aceptamos nuevos proyectos ni consultas.">We are no longer accepting new projects or inquiries.</p>
    </div>
  </div>
</section>

<section class="sec" style="padding-top:0"><div class="wrap">
  <p style="text-align:center"><a class="book-call" href="/es/calculadora-costos-video/">🧮 ¿Todavía no querés hablar? Calculá el costo de tu video en 60 segundos →</a></p>
</div></section>
<style is:global>
.rsrc-h1{font-size:clamp(30px,4.6vw,50px)!important;line-height:1.08}
.lp-hero-video{position:relative;aspect-ratio:16/9;border-radius:20px;overflow:hidden;border:1px solid var(--line-strong)}
.lp-hero-video video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.lp-bens{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}
.lp-bens .lpb{background:var(--navy-800);border:1px solid var(--line-strong);border-radius:18px;padding:26px 24px}
.lp-bens .lpb .ic{font-size:28px}
.lp-bens .lpb h3{font-family:'Space Grotesk';font-size:17.5px;margin:12px 0 8px}
.lp-bens .lpb p{font-size:14.5px;color:var(--muted);line-height:1.65;margin:0}
.lp-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;max-width:940px;margin:0 auto}
.lp-steps .lps{border:1px solid var(--line);border-radius:18px;padding:24px;position:relative}
.lp-steps .lps .n{font-family:'Space Grotesk';font-weight:800;font-size:14px;color:var(--acid);letter-spacing:1px}
.lp-steps .lps h3{font-family:'Space Grotesk';font-size:16.5px;margin:10px 0 6px}
.lp-steps .lps p{font-size:14px;color:var(--muted);line-height:1.6;margin:0}
</style>
</Base>
