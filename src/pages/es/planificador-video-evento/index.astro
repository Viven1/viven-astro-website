---
/* Planificador de video de evento — es.
   Toda la lógica y el markup viven en EventPlanner.astro y los textos en
   src/data/event-planner-i18n.js: acá solo se elige el idioma. Traducirlo copiando el
   archivo habría dejado tres copias de las mismas nueve preguntas. */
import Base from '../../../layouts/Base.astro';
import EventPlanner from '../../../components/EventPlanner.astro';
import { PLANNER, PLANNER_URLS } from '../../../data/event-planner-i18n.js';
const lang = "es";
const t = PLANNER[lang];
const title = { "es": t.title };
const description = { "es": t.description };
---
<Base lang={lang} slug={t.slug} active="" singleLang={true} langUrls={PLANNER_URLS} title={title} description={description}>
  <EventPlanner t={t} lang={lang} />
</Base>
