---
import Base from '../../../layouts/Base.astro';
import { localePath } from '../../../i18n.js';
const lang = "es";
const p = (s) => localePath(lang, s);
const title = {"es":"Calculadora de costos de video | Viven"};
const description = {"es":"Obtené al instante un rango de precio en CHF para tu proyecto de video: tipo, duración, días de rodaje y extras. Gratis — basada en presupuestos reales suizos."};
---
<Base lang={lang} slug="calculadora-costos-video" active="" singleLang={true} langUrls={{"en": "/en/video-cost-calculator/", "de": "/de/videoproduktion-kosten-rechner/", "es": "/es/calculadora-costos-video/"}} title={title} description={description}>
  <script type="application/ld+json" slot="jsonld" set:html={"{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"WebApplication\", \"name\": \"\u00bfCu\u00e1nto cuesta tu video?\", \"applicationCategory\": \"BusinessApplication\", \"operatingSystem\": \"Web\", \"offers\": {\"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"CHF\"}, \"url\": \"https://www.viven.ch/es/calculadora-costos-video/\", \"inLanguage\": \"es\", \"publisher\": {\"@id\": \"https://www.viven.ch/#organization\"}}, {\"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.viven.ch/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"\u00bfCu\u00e1nto cuesta tu video?\", \"item\": \"https://www.viven.ch/es/calculadora-costos-video/\"}]}]}"}></script>
<section class="page-hero"><div class="wrap"><div class="post-wrap">
  <span class="eyebrow">Herramienta gratis</span>
  <h1>¿Cuánto cuesta tu video?</h1>
  <p class="lead">Cinco preguntas rápidas y obtenés al instante un rango honesto en CHF — basado en presupuestos reales de más de 1137 producciones suizas para marcas como UBS, Siemens y FIFA.</p>
</div></div></section>
<section class="sec" style="padding-top:24px"><div class="wrap"><div class="calc-wrap reveal">
  <div class="calc-q"><h2>1. ¿Qué tipo de video?</h2><div class="calc-chips" data-group="type"><button type="button" data-v="brand">🎬 Video de marca</button><button type="button" data-v="product">📦 Video de producto</button><button type="button" data-v="eb">👥 Employer branding</button><button type="button" data-v="howto">🎓 Video explicativo</button><button type="button" data-v="social">📱 Pack redes sociales</button><button type="button" data-v="corporate">🏢 Video corporativo</button></div></div>
  <div class="calc-q"><h2>2. ¿Duración final?</h2><div class="calc-chips" data-group="dur"><button type="button" data-v="s">Menos de 1 min</button><button type="button" data-v="m">1–2 min</button><button type="button" data-v="l">2–5 min</button><button type="button" data-v="xl">5+ min</button></div></div>
  <div class="calc-q"><h2>3. Días de rodaje y locaciones</h2>
    <div class="calc-chips" data-group="days"><button type="button" data-v="0">1 día de rodaje</button><button type="button" data-v="1">2 días</button><button type="button" data-v="2">3+ días</button></div>
    <div class="calc-chips" data-group="locs" style="margin-top:10px"><button type="button" data-v="0">1 locación</button><button type="button" data-v="1">2 locaciones</button><button type="button" data-v="2">3+ locaciones</button></div></div>
  <div class="calc-q"><h2>4. ¿Quién sale en cámara?</h2><div class="calc-chips" data-group="talent"><button type="button" data-v="emp">👥 Empleados propios</button><button type="button" data-v="mod">💃 Modelos</button><button type="button" data-v="act">🎭 Actores profesionales</button><button type="button" data-v="none">🚫 Sin personas en cámara</button></div>
    <div id="calc-lic" hidden style="margin-top:12px"><p style="font-size:14px;margin:0 0 8px;opacity:.85">📡 ¿Dónde se va a usar el video? (elegí todos los que apliquen)</p><div class="calc-chips calc-multi" data-group="chan"><button type="button" data-v="tv">📺 TV</button><button type="button" data-v="online">💻 Ads online y social (paid)</button><button type="button" data-v="owned">🌐 Web y redes propias</button><button type="button" data-v="cine">🎦 Cine</button></div><p style="font-size:14px;margin:14px 0 8px;opacity:.85">🪪 Licencia de uso (buyout) — ¿por cuánto tiempo?</p><div class="calc-chips" data-group="lic"><button type="button" data-v="y1">🪪 1 año</button><button type="button" data-v="y2">🪪 2 años</button><button type="button" data-v="y3">🪪 3 años</button><button type="button" data-v="unl">🪪 Ilimitada</button></div><p style="font-size:12.5px;margin:12px 0 0;opacity:.6">ℹ️ La lógica de buyouts sigue las <a href="https://www.ssfv.ch/de/cast/schauspielgagen-werbung" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline">guías oficiales de SSFV / SzeneSchweiz</a> (% de buyout por placement y duración) — calculado para 1 rol protagónico; el costo final depende del cast.</p></div></div>
  <div class="calc-q"><h2>5. Extras</h2><div class="calc-chips calc-multi" data-group="extras"><button type="button" data-v="anim">✨ Animación / motion graphics</button><button type="button" data-v="drone">🚁 Tomas con drone</button><button type="button" data-v="ml">🌍 Versión en otro idioma</button><button type="button" data-v="subs">💬 Subtítulos</button><button type="button" data-v="fotos">📸 Fotos still</button><button type="button" data-v="testi">⭐ Testimonial de cliente</button></div></div>

  <div class="calc-est" id="calc-est" hidden>
    <div class="calc-est-label">🔒 Tu estimación está lista</div>
    <div class="calc-est-range calc-locked">Completá tus datos abajo para verla →</div>
    <span id="calc-range" hidden></span>
    <p class="muted-note">Rango realista para calidad de producción suiza, sobre 1137+ presupuestos reales.</p>
  </div>

  <div class="calc-form" id="calc-form-box" hidden>
    <h2>¿Te mando el desglose por email?</h2>
    <p class="form-note" style="margin:-4px 0 12px">Te llega el detalle línea por línea, para tenerlo a mano y compartirlo internamente.</p>
    <form id="calc-form" autocomplete="on">
      <input type="text" id="cf-first" placeholder="Nombre" autocomplete="given-name" required />
      <input type="text" id="cf-last" placeholder="Apellido" autocomplete="family-name" required />
      <input type="email" id="cf-email" placeholder="Email de trabajo" required />
      <input type="text" id="cf-co" placeholder="Empresa (opcional)" autocomplete="organization" />
      <input type="text" id="cf-hp" tabindex="-1" autocomplete="off" style="position:absolute;left:-5000px" aria-hidden="true" />
      <button class="btn btn-primary" type="submit">Mandame el desglose →</button>
    </form>
    <p class="form-note">Respondemos en un día hábil con una propuesta concreta. Nunca spam.</p>
    <p class="form-note calc-privacy">Al enviar, aceptás que te mandemos tu estimación por email y te contactemos sobre tu proyecto. Ver <a href="/es/privacy-policy/" style="color:inherit;text-decoration:underline">política de privacidad</a>. Nunca spam.</p>
  </div>

  <div class="calc-result" id="calc-result" hidden>
    <h2 id="calc-result-h">✅ Revisá tu bandeja de entrada</h2>
    <p id="calc-result-p">Te acabamos de mandar tu estimación personalizada a <strong id="calc-sent-email"></strong> (revisá spam si no aparece en un minuto). Mientras tanto:</p>
    <p style="margin-top:18px"><a class="book-call" href="/book/" target="_blank" rel="noopener">📅 Reservar llamada gratis de 15 min →</a></p>
    <p style="margin-top:10px;color:var(--muted);font-size:14px">¿Preferís no llamar todavía? <a href="/brief/?lang=es" style="color:var(--acid);text-decoration:underline;text-underline-offset:3px">Contanos tu proyecto por escrito →</a> y te respondemos con los próximos pasos.</p>
  </div>
</div></div></section>
<style is:global>
.calc-wrap{max-width:780px;margin:0 auto}
.calc-q{margin-bottom:26px}
.calc-q h2{font-size:17px;margin-bottom:12px}
.calc-chips{display:flex;flex-wrap:wrap;gap:9px}
.calc-chips button{background:var(--navy-800,#16233a);border:1px solid rgba(255,255,255,.14);border-radius:12px;color:inherit;font-family:inherit;font-size:14px;padding:11px 16px;cursor:pointer;transition:.18s}
.calc-chips button:hover{border-color:var(--acid,#ddf98f)}
.calc-chips button.on{background:var(--acid,#ddf98f);color:#0f1826;border-color:var(--acid,#ddf98f);font-weight:700}
.calc-est{border:1px solid var(--acid,#ddf98f);border-radius:16px;padding:20px 22px;margin:28px 0}
.calc-est-label{font-size:12px;letter-spacing:.8px;text-transform:uppercase;opacity:.7}
.calc-est-range{font-size:32px;font-weight:800;margin:6px 0 4px}
.calc-est-range.calc-locked{font-size:16px;font-weight:700;color:var(--acid,#ddf98f);cursor:default}
.calc-form{border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:22px;margin-top:8px}
.calc-form h2{font-size:17px;margin-bottom:12px}
.calc-privacy{font-size:11.5px;opacity:.65;margin-top:6px}
.calc-form form{display:grid;gap:10px;grid-template-columns:1fr 1fr}
.calc-form input{background:transparent;border:1px solid rgba(255,255,255,.2);border-radius:10px;color:inherit;font-family:inherit;font-size:14.5px;padding:12px 14px}
.calc-form input#cf-first,.calc-form input#cf-last{grid-column:auto}
.calc-form button{grid-column:1/-1}
@media(max-width:640px){.calc-form form{grid-template-columns:1fr}}
.calc-result{border:1px solid var(--acid,#ddf98f);border-radius:16px;padding:22px;margin-top:8px}
.calc-result table{width:100%;border-collapse:collapse;margin-top:10px}
.calc-result td{padding:7px 4px;border-bottom:1px solid rgba(255,255,255,.1);font-size:14px}
.calc-result td:last-child{text-align:right;font-variant-numeric:tabular-nums}
</style>
<script is:inline>
(function(){
  var PRICE = { types:{brand:6500,product:5000,eb:7500,howto:4000,social:3500,corporate:5500},
    durs:{s:.9,m:1,l:1.15,xl:1.3}, days:[0,2500,5000], locs:[0,600,1200],
    talent:{emp:0,mod:1500,act:2000,none:0}, chan:{tv:1,online:1,owned:.5,cine:.75}, lic:{y1:1,y2:1.8,y3:2.4,unl:3},
    extras:{anim:1300,drone:650,ml:350,subs:200,fotos:400,testi:1000} };
  var ITEMS = {"base": "Producción base", "dur": "Ajuste por duración", "days": "Días de rodaje extra", "locs": "Locaciones extra", "anim": "Animación / motion", "drone": "Drone", "ml": "Idioma adicional", "subs": "Subtítulos", "fotos": "Fotos still", "testi": "Testimonial"};
  var TAL = {"mod": "Modelos", "act": "Actores profesionales"};
  var LICL = {"y1": "1 año", "y2": "2 años", "y3": "3 años", "unl": "ilimitada"}; var CHANL = {"tv": "TV", "online": "ads online", "owned": "medios propios", "cine": "cine"};
  var sel = { type:null, dur:null, days:0, locs:0, talent:null, lic:null, chan:{}, extras:{} };
  function round500(n){ return Math.round(n/500)*500; }
  function round1000(n){ return Math.round(n/1000)*1000; }
  function calc(){
    if(!sel.type || !sel.dur || !sel.talent) return null;
    var chansOn = []; for(var c in sel.chan){ if(sel.chan[c]) chansOn.push(c); }
    if(PRICE.talent[sel.talent] && (!sel.lic || !chansOn.length)) return null;
    var lines = [];
    var base = PRICE.types[sel.type]; lines.push([ITEMS.base, base]);
    var t = base * PRICE.durs[sel.dur];
    if(PRICE.durs[sel.dur] !== 1) lines.push([ITEMS.dur + ' (' + {"s": "menos de 1 min", "m": "1\u20132 min", "l": "2\u20135 min", "xl": "5+ min"}[sel.dur] + ')', Math.round(base*(PRICE.durs[sel.dur]-1))]);
    if(PRICE.days[sel.days]){ t += PRICE.days[sel.days]; lines.push([ITEMS.days, PRICE.days[sel.days]]); }
    if(PRICE.locs[sel.locs]){ t += PRICE.locs[sel.locs]; lines.push([ITEMS.locs, PRICE.locs[sel.locs]]); }
    if(PRICE.talent[sel.talent]){ var rate = PRICE.talent[sel.talent], nd = [1,2,3][sel.days], tc = rate*nd;
      t += tc; lines.push([TAL[sel.talent] + ' (' + nd + (nd>1?' días':' día') + ')', tc]);
      var pct = 0, cn = []; chansOn.forEach(function(c){ pct += PRICE.chan[c]; cn.push(CHANL[c]); });
      var lc = Math.round(rate*pct*PRICE.lic[sel.lic]); t += lc;
      lines.push(['Buyout / licencia de uso ' + cn.join(' + ') + ' (' + LICL[sel.lic] + ')', lc]); }
    for(var k in sel.extras){ if(sel.extras[k]){ t += PRICE.extras[k]; lines.push([ITEMS[k], PRICE.extras[k]]); } }
    /* Rango −20% / +30%, redondeado a mil. Elegido por Sebastián el 14 ago 2026
       ("creo que es mejor un rango más grande, donde es entre x e y, y luego con
       detalles vamos al fino") después de comparar la tabla de la calculadora
       contra las 931 líneas de sus ofertas reales: animación, subtítulos y drone
       estaban por encima de lo que cobra, y la "jornada extra" es un número
       redondo que no existe como línea suelta. El rango ancho dice la verdad
       —esto es una orientación— en vez de fingir una precisión de ±12%.
       Piso de CHF 1'000 para que un proyecto mínimo no muestre 0. */
    return { lo: Math.max(round1000(t*.8), 1000), hi: round1000(t*1.3), lines: lines, total: Math.round(t) };
  }
  function fmt(n){ return 'CHF ' + n.toLocaleString('de-CH'); }
  function refresh(){
    var r = calc(); var est = document.getElementById('calc-est'), fb = document.getElementById('calc-form-box');
    if(!r){ est.hidden = true; fb.hidden = true; return; }
    est.hidden = false; fb.hidden = document.getElementById('calc-result').hidden === false;
    document.getElementById('calc-range').textContent = fmt(r.lo) + ' – ' + fmt(r.hi);
  }
  document.querySelectorAll('.calc-chips').forEach(function(g){
    var group = g.dataset.group, multi = g.classList.contains('calc-multi');
    g.querySelectorAll('button').forEach(function(b){
      b.addEventListener('click', function(){
        if(multi){ b.classList.toggle('on'); (group==='chan' ? sel.chan : sel.extras)[b.dataset.v] = b.classList.contains('on'); }
        else { g.querySelectorAll('button').forEach(function(x){ x.classList.remove('on'); }); b.classList.add('on');
          if(group==='type') sel.type = b.dataset.v; if(group==='dur') sel.dur = b.dataset.v;
          if(group==='days') sel.days = +b.dataset.v; if(group==='locs') sel.locs = +b.dataset.v;
          if(group==='talent'){ sel.talent = b.dataset.v;
            var lq = document.getElementById('calc-lic'), need = !!PRICE.talent[sel.talent];
            lq.hidden = !need;
            if(!need){ sel.lic = null; sel.chan = {}; lq.querySelectorAll('button').forEach(function(x){ x.classList.remove('on'); }); }
            /* Con modelos o actores hay que elegir canal Y licencia o no aparece
               ningun precio: 78% de fuga ahi. Arranca con lo mas barato y comun
               marcado y se cambia si no es eso. */
            else if(!sel.lic && !Object.keys(sel.chan).some(function(c){ return sel.chan[c]; })){
              var bo = lq.querySelector('.calc-chips[data-group="chan"] button[data-v="owned"]');
              var by = lq.querySelector('.calc-chips[data-group="lic"] button[data-v="y1"]');
              if(bo){ bo.classList.add('on'); sel.chan.owned = true; }
              if(by){ by.classList.add('on'); sel.lic = 'y1'; }
            } }
          if(group==='lic') sel.lic = b.dataset.v; }
        refresh();
        /* Feedback inmediato: al elegir, llevamos a la pregunta que falta (o al
           precio si ya esta). Antes, elegir el tipo de video no movia nada en
           pantalla y la mitad de la gente se iba en ese primer paso. */
        var est = document.getElementById('calc-est');
        if(est && !est.hidden){ est.scrollIntoView({behavior:'smooth', block:'nearest'}); }
        else if(!multi){
          var qs = [].slice.call(document.querySelectorAll('.calc-q'));
          var falta = qs.filter(function(q){ return !q.querySelector('.calc-chips button.on'); })[0];
          if(falta) falta.scrollIntoView({behavior:'smooth', block:'center'});
        }
      });
    });
  });
  /* Arranca con lo mas comun ya marcado: 1 jornada y 1 locacion. No cambian el
     precio (ambos suman 0) pero eran dos clicks obligatorios en apariencia. */
  ['days', 'locs'].forEach(function(g){
    var b = document.querySelector('.calc-chips[data-group="' + g + '"] button[data-v="0"]');
    if(b) b.classList.add('on');
  });


  document.getElementById('calc-form').addEventListener('submit', function(ev){
    ev.preventDefault();
    if(document.getElementById('cf-hp').value) return;
    var r = calc(); if(!r) return;
    var first = document.getElementById('cf-first').value.trim();
    var last = document.getElementById('cf-last').value.trim();
    var name = (first + ' ' + last).trim();
    var email = document.getElementById('cf-email').value.trim();
    var co = document.getElementById('cf-co').value.trim();
    /* nombre, apellido y empresa son obligatorios: con eso se puede armar una
       propuesta de verdad sin volver a preguntar (pedido de Sebastián, 14 ago) */
    if (!first || !last || !email) return;
    var cfg = [];
    document.querySelectorAll('.calc-chips button.on').forEach(function(b){ cfg.push(b.textContent.trim()); });
    var row = { name: name, first_name: first, last_name: last || null,
      email: email, company: co || null, form_path: location.pathname,
      message: '🧮 CALCULADORA — ' + cfg.join(' · ') + ' → ' + fmt(r.lo) + '–' + fmt(r.hi) };
    var extra = window.vivenAttribution ? window.vivenAttribution() : null;
    if(extra){ row.session_id = extra.session_id; row.lang = extra.lang;
      if(extra.attrib){ row.channel = extra.attrib.channel; row.gclid = extra.attrib.gclid; row.utm_source = extra.attrib.utm_source; row.utm_campaign = extra.attrib.utm_campaign; row.landing_path = extra.attrib.landing_path; } }
    var abT = window.vvAbTags ? window.vvAbTags() : window.__vvAB; if(abT) row.ab = abT;   /* tags A/B de esta u otras páginas */
    var submitBtn = document.querySelector('#calc-form button[type="submit"]');
    var origLabel = submitBtn.textContent; submitBtn.disabled = true; submitBtn.textContent = 'Enviando tu desglose…';
    var done = function(){
      document.getElementById('calc-form-box').hidden = true;
      var res = document.getElementById('calc-result');
      document.getElementById('calc-sent-email').textContent = email;
      res.hidden = false;
      res.scrollIntoView({behavior:'smooth', block:'start'});
    };
    var sendEmail = function(){
      if(window.sbCallFunction){
        window.sbCallFunction('calc-email', { to: email, name: name, lang: (extra && extra.lang) || document.documentElement.lang || 'en', lines: r.lines, lo: r.lo, hi: r.hi, config: cfg });
      }
    };
    if(window.sbInsertLead){ window.sbInsertLead(row).then(function(res){
        sendEmail(); done();
      }, function(){ sendEmail(); done(); }); }
    else { sendEmail(); done(); }
  });

  /* preset por URL (?type=brand|product|eb|employer|howto|social|corporate):
     los links desde service pages entran con la pregunta 1 ya respondida */
  try {
    var pv = new URLSearchParams(location.search).get('type');
    if (pv) {
      pv = ({ employer: 'eb' })[pv] || pv;
      var pb = document.querySelector('.calc-chips[data-group="type"] button[data-v="' + pv + '"]');
      if (pb) pb.click();
    }
  } catch (e) {}
})();
</script>
</Base>
