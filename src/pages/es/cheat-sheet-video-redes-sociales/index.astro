---
import Base from '../../../layouts/Base.astro';
import LeadMagnet from '../../../components/LeadMagnet.astro';
import CalcBanner from '../../../components/CalcBanner.astro';
import { localePath, SITE } from '../../../i18n.js';
const lang = "es";
const p = (s) => localePath(lang, s);
const title = {"es":"Cheat sheet de video para redes 2026 — PDF gratis | Viven"};
const description = {"es":"Descarga gratis: todos los formatos nativos de video, duraciones y specs — YouTube, Reels, TikTok, LinkedIn — en una página. Del equipo que produce para UBS y Siemens."};
const URL = SITE + "/es/cheat-sheet-video-redes-sociales/";
const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": URL + "#breadcrumbs",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": SITE + "/" },
        { "@type": "ListItem", "position": 2, "name": "Herramientas gratis", "item": SITE + "/es/tools/" },
        { "@type": "ListItem", "position": 3, "name": "Cheat sheet de video para redes 2026", "item": URL }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": URL + "#faq",
      "mainEntity": [
        { "@type": "Question", "name": "¿El cheat sheet es realmente gratis?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Dejá tu email de trabajo y el PDF se descarga al instante — sin costo y sin compromiso. Cada tanto te podemos escribir con contenido de video realmente útil, y te das de baja cuando quieras." } },
        { "@type": "Question", "name": "¿Qué plataformas cubre?", "acceptedAnswer": { "@type": "Answer", "text": "YouTube Shorts y formato largo, Instagram Reels, Stories y Feed, TikTok y LinkedIn — con formato, frame rate, duración ideal y notas técnicas de cada una, todo en una sola página A4." } },
        { "@type": "Question", "name": "¿Por qué importan los formatos nativos?", "acceptedAnswer": { "@type": "Answer", "text": "Porque los algoritmos los premian. Medimos alrededor de un 40% más de engagement con formatos nativos de plataforma versus re-uploads estirados. Los specs nativos no son burocracia: son ventaja competitiva." } },
        { "@type": "Question", "name": "¿Quién hizo este cheat sheet?", "acceptedAnswer": { "@type": "Answer", "text": "Viven, una productora de video de Zúrich, Suiza. Es la misma referencia que usan nuestros productores en rodajes para marcas como UBS, Siemens, Porsche, ON y FIFA." } }
      ]
    }
  ]
});
---
<Base lang={lang} slug="cheat-sheet-video-redes-sociales" active="tools" singleLang={true} langUrls={{"en":"/en/social-media-video-cheat-sheet/","de":"/de/social-media-video-cheat-sheet/","es":"/es/cheat-sheet-video-redes-sociales/"}} title={title} description={description}>
  <script type="application/ld+json" slot="jsonld" set:html={ld}></script>

<!-- ============ PAGE HERO ============ -->
<section class="page-hero">
  <div class="wrap">
    <div class="crumbs">
      <a href={p("")}>Inicio</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <a href={p("tools")}>Herramientas gratis</a>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      <span>Cheat sheet de video para redes 2026</span>
    </div>
    <span class="eyebrow">Descarga gratis</span>
    <h1>Cheat sheet de video para redes sociales 2026 — <span class="hl">descarga gratis</span></h1>
    <p class="lead">Todos los formatos nativos, frame rates, duraciones ideales y specs para YouTube, Reels, TikTok y LinkedIn — en una página A4. Lo armó el equipo que produce video para redes para UBS, Siemens, Porsche y ON: es la misma referencia que usan nuestros productores en el set.</p>
    <div class="hero-cta">
      <a href="#download" class="btn btn-primary">Descargar el PDF gratis</a>
      <a href="#inside" class="btn btn-ghost">Ver qué incluye</a>
    </div>
  </div>
</section>

<!-- ============ WHAT'S INSIDE ============ -->
<section class="sec" id="inside" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Qué incluye</span>
      <h2>Siete plataformas. Una página. Cero dudas.</h2>
      <p>El formato y la duración correctos para cada plataforma en la que publicás — la tabla completa de specs con frame rates, códecs, bitrates y límites de archivo está en el PDF.</p>
    </div>
    <div class="value-grid">
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/></svg></div>
        <h3>YouTube Shorts</h3>
        <p>El único aspect ratio que el feed de Shorts realmente empuja — y el error de subida que entierra tu video en silencio.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/></svg></div>
        <h3>YouTube formato largo</h3>
        <p>El rango exacto de duración que el algoritmo premia en 2026 — la mayoría rellena justo por encima.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/><circle cx="12" cy="18" r="1"/></svg></div>
        <h3>Instagram Reels</h3>
        <p>Dónde vive de verdad el alcance de Instagram en 2026 — y el corte de duración que separa lo que rinde del relleno.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/><path d="M4 8v8M20 8v8"/></svg></div>
        <h3>Instagram Stories</h3>
        <p>El límite de tiempo que cambia cómo editás — y el asset que podés reusar sin re-editar.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="3" width="12" height="18" rx="2"/></svg></div>
        <h3>Instagram Feed</h3>
        <p>Por qué el post clásico de feed está perdiendo — y el único caso donde todavía conviene.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="20" rx="2"/><path d="M12 6v4l3 2"/></svg></div>
        <h3>TikTok</h3>
        <p>El punto justo de duración, más angosto de lo que pensás — y dos cosas que TikTok penaliza en silencio.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/></svg></div>
        <h3>LinkedIn</h3>
        <p>El formato que frena el scroll de los profesionales — y el elemento obligatorio ahora que el autoplay es mudo.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg></div>
        <h3>Más: las tres reglas</h3>
        <p>«Filmá una vez, entregá nativo» · «El primer segundo es el thumbnail» · «Subtítulos siempre» — cada una explicada en el PDF.</p>
      </div>
    </div>
    <p class="reveal" style="text-align:center;margin-top:32px;font-size:15px;opacity:.8">El PDF suma la tabla completa de specs: frame rates, códecs, bitrates, límites de tamaño de archivo y notas técnicas por plataforma.</p>
  </div>
</section>

<!-- ============ GATE ============ -->
<div id="download">
  <LeadMagnet lang={lang} magnet="social-formats" aviso={false} />
</div>

<!-- ============ WHO IT'S FOR ============ -->
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Para quién es</span>
      <h2>Hecho para la gente que publica video en redes.</h2>
    </div>
    <div class="value-grid">
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg></div>
        <h3>Marketing managers</h3>
        <p>Brifeá agencias y equipos internos con los specs correctos desde el día uno — sin re-exports la noche antes del lanzamiento.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></div>
        <h3>Social media managers</h3>
        <p>Una sola referencia al lado de tu calendario de contenido — y publicás nativo en cada plataforma, todas las veces.</p>
      </div>
      <div class="value reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
        <h3>Founders</h3>
        <p>¿Por ahora lo hacés vos? Ahorrate la investigación de specs y poné ese tiempo en la historia.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="sec" id="faq" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2>El cheat sheet, respondido.</h2>
    </div>
    <div class="faq reveal">
      <details>
        <summary>¿El cheat sheet es realmente gratis?</summary>
        <p>Sí. Dejá tu email de trabajo y el PDF se descarga al instante — sin costo y sin compromiso. Cada tanto te podemos escribir con contenido de video realmente útil, y te das de baja cuando quieras.</p>
      </details>
      <details>
        <summary>¿Qué plataformas cubre?</summary>
        <p>YouTube Shorts y formato largo, Instagram Reels, Stories y Feed, TikTok y LinkedIn — con formato, frame rate, duración ideal y notas técnicas de cada una, todo en una sola página A4.</p>
      </details>
      <details>
        <summary>¿Por qué importan los formatos nativos?</summary>
        <p>Porque los algoritmos los premian. Medimos alrededor de un 40% más de engagement con formatos nativos de plataforma versus re-uploads estirados. Los specs nativos no son burocracia: son ventaja competitiva.</p>
      </details>
      <details>
        <summary>¿Quién hizo este cheat sheet?</summary>
        <p>Viven, una productora de video de Zúrich, Suiza. Es la misma referencia que usan nuestros productores en rodajes para marcas como UBS, Siemens, Porsche, ON y FIFA.</p>
      </details>
    </div>
  </div>
</section>

<!-- ============ RELATED ============ -->
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="related reveal">
      <h2>Para profundizar</h2>
      <div class="related-grid">
        <a href="/es/blog/formatos-video-redes-sociales-2026/" class="related-card reveal">
          <h3>Formatos y duraciones de video en redes sociales 2026</h3>
          <p>La guía completa detrás del cheat sheet — el porqué de cada spec, plataforma por plataforma.</p>
          <span class="more">Leer la guía →</span>
        </a>
        <a href={p("services/social-media-video")} class="related-card reveal">
          <h3>Producción de video para redes sociales</h3>
          <p>Series short-form en 9:16 que frenan el scroll, producidas en lote en Zúrich — para que tu feed nunca se apague.</p>
          <span class="more">Ver el servicio →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<CalcBanner lang={lang} />
</Base>
