---
import DashboardV2Records from '../../components/DashboardV2Records.astro';
import DashboardV2Agenda from '../../components/DashboardV2Agenda.astro';
import DashboardV2Management from '../../components/DashboardV2Management.astro';
import DashboardV2Analytics from '../../components/DashboardV2Analytics.astro';
export const prerender = true;

const sections = {
  ventas: { label: 'Ventas', tab: 'deals', hint: 'Pipeline, ofertas, propuestas y seguimientos' },
  proyectos: { label: 'Proyectos', tab: 'projects', hint: 'Producción, crew, entregas y facturación' },
  personas: { label: 'Personas', tab: 'leads', hint: 'Contactos, conversaciones, tareas y actividad' },
  empresas: { label: 'Empresas', tab: 'companies', hint: 'Cuentas, personas, oportunidades y actividad' },
  tecnicos: { label: 'Técnicos', tab: 'crew', hint: 'Equipo externo, disponibilidad, tarifas y documentos' },
  agenda: { label: 'Agenda', tab: 'agenda', hint: 'Reuniones, tareas y próximos compromisos' },
  analytics: { label: 'Analytics', tab: 'analytics', hint: 'Web, campañas, videos y oportunidades CRO' },
  contenido: { label: 'Contenido', tab: 'contenido', hint: 'Blog, noticias, SEO y recursos' },
  automatizaciones: { label: 'Automatizaciones', tab: 'sistema', sub: 'auto', hint: 'Bandeja, reglas, ejecuciones y aprobaciones' },
  sistema: { label: 'Sistema', tab: 'sistema', hint: 'Servicios, licencias, reservas, caja y configuración' },
};

export function getStaticPaths() {
  return ['ventas','proyectos','personas','empresas','tecnicos','agenda','analytics','contenido','automatizaciones','sistema']
    .map((section) => ({ params: { section }, props: { section } }));
}

const { section } = Astro.props;
const current = sections[section];
const query = new URLSearchParams({ tab: current.tab });
if (current.sub) query.set('sub', current.sub);
const source = `/dashboard/?${query}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#07182b" />
    <title>{current.label} 2 · Viven</title>
    <style is:global>
      html:not(.v2-authorized) body{visibility:hidden}
      :root{color-scheme:dark;--bg:#061526;--rail:#071a2d;--panel:#0b1e32;--line:#263c52;--text:#f6f8fb;--muted:#96a9bc;--lime:#d9fb35}
      *{box-sizing:border-box}html,body{height:100%;margin:0}body{background:var(--bg);color:var(--text);font:14px/1.4 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;overflow:hidden}.app{height:100%;display:grid;grid-template-columns:216px minmax(0,1fr)}
      aside{background:var(--rail);border-right:1px solid var(--line);padding:26px 15px;overflow:auto}.brand{font-size:27px;letter-spacing:.22em;margin:0 12px 28px}.brand small{display:block;color:var(--lime);font-size:9px;letter-spacing:.2em}.nav{display:grid;gap:4px}.nav a{color:var(--muted);text-decoration:none;padding:10px 12px;border-radius:9px}.nav a:hover{background:#11283e;color:white}.nav a.on{background:#152d43;color:var(--lime);box-shadow:inset 3px 0 var(--lime)}.contact-nav summary{cursor:pointer;color:var(--muted);padding:10px 12px;border-radius:9px;list-style:none}.contact-nav summary:after{content:'⌄';float:right}.contact-nav[open] summary{color:white}.contact-nav a{display:block;padding-left:25px;font-size:13px}.group{margin:17px 12px 5px;color:#637a90;font-size:10px;text-transform:uppercase;letter-spacing:.12em}.stage{display:grid;grid-template-rows:72px minmax(0,1fr);min-width:0}.top{display:flex;align-items:center;justify-content:space-between;padding:0 24px;border-bottom:1px solid var(--line);background:rgba(7,24,42,.95)}.title h1{font-size:21px;margin:0}.title p{margin:3px 0 0;color:var(--muted);font-size:12px}.actions{display:flex;gap:8px}.btn{border:1px solid var(--line);background:#10263b;color:var(--text);border-radius:9px;padding:9px 12px;text-decoration:none}.btn.primary{background:var(--lime);color:#071526;border-color:var(--lime);font-weight:750}.frame-wrap{position:relative;min-height:0;background:#061526}.frame-wrap:before{content:'Cargando ' attr(data-label) '…';position:absolute;inset:0;display:grid;place-items:center;color:var(--muted);z-index:0}.frame{position:relative;z-index:1;border:0;width:100%;height:100%;display:block;background:#061526}.safe{position:absolute;right:18px;bottom:14px;z-index:2;background:rgba(7,24,42,.92);border:1px solid var(--line);color:var(--muted);padding:7px 10px;border-radius:999px;font-size:11px;pointer-events:none;backdrop-filter:blur(10px)}
      .sales{height:100%;overflow:auto;padding:24px;background:radial-gradient(circle at 60% -30%,#12334f 0,transparent 38%),var(--bg)}.sales-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:18px}.sales-head h2{font-size:30px;margin:0}.sales-head p{color:var(--muted);margin:4px 0 0}.sales-tabs{display:flex;gap:7px}.sales-tab{border:1px solid var(--line);background:#0c2136;color:var(--muted);padding:9px 13px;border-radius:8px}.sales-tab.on{color:#071526;background:var(--lime);border-color:var(--lime);font-weight:750}.sales-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:18px}.sales-kpi{display:block;color:inherit;text-decoration:none;border:1px solid var(--line);background:rgba(11,30,50,.92);border-radius:11px;padding:16px}.sales-kpi:hover{border-color:#526d86}.sales-kpi span{color:var(--muted);font-size:12px}.sales-kpi strong{display:block;font-size:23px;margin-top:5px}.sales-board{display:grid;grid-template-columns:repeat(4,minmax(220px,1fr));gap:12px;align-items:start;overflow:auto;padding-bottom:12px}.sales-col{border:1px solid var(--line);background:rgba(8,26,44,.86);border-radius:12px;min-height:350px}.sales-col-head{display:flex;justify-content:space-between;padding:14px;border-bottom:1px solid var(--line)}.sales-col-head b{font-size:14px}.sales-col-head span{color:var(--muted);font-size:12px}.sales-list{display:grid;gap:8px;padding:9px}.deal-card{display:block;color:inherit;text-decoration:none;border:1px solid #294159;background:#0c2136;border-radius:9px;padding:12px}.deal-card:hover{border-color:var(--lime)}.deal-card h3{font-size:14px;margin:0 0 3px}.deal-card p{color:var(--muted);font-size:12px;margin:0}.deal-meta{display:flex;justify-content:space-between;gap:8px;margin-top:10px;font-size:12px}.deal-meta strong{color:var(--lime)}.sales-empty{color:var(--muted);padding:18px;text-align:center}.sales-docs{display:none;border:1px solid var(--line);background:rgba(8,26,44,.9);border-radius:12px;overflow:hidden}.sales.doc-mode .sales-board{display:none}.sales.doc-mode .sales-docs{display:block}.doc-row{display:grid;grid-template-columns:minmax(180px,1fr) 130px 130px 110px;gap:12px;padding:13px 16px;border-bottom:1px solid var(--line);align-items:center;color:inherit;text-decoration:none}.doc-row:hover{background:#10283e}.doc-row small{color:var(--muted)}.sales-drawer{position:fixed;inset:0;z-index:30;display:grid;place-items:center;padding:20px}.sales-drawer[hidden]{display:none}.sales-back{position:absolute;inset:0;background:rgba(1,9,17,.78);backdrop-filter:blur(5px)}.sales-sheet{position:relative;width:min(650px,calc(100vw - 40px));max-height:calc(100vh - 40px);overflow:auto;background:#0b2035;border:1px solid #38516a;border-radius:14px;padding:24px}.sales-x{position:absolute;right:15px;top:10px;border:0;background:transparent;color:white;font-size:25px}.sales-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:16px}.sales-field{border:1px solid var(--line);background:#07182a;border-radius:8px;padding:10px}.sales-field small{display:block;color:var(--muted)}.sales-related{margin-top:12px;border-top:1px solid var(--line);padding-top:12px}.sales-related p{margin:7px 0;color:#d6deea}
      .mobile-brand{display:none;width:105px;height:auto}.mode-link{color:var(--lime);font-weight:700;text-decoration:none;margin-left:6px}@media(max-width:1200px){.sales-board{grid-template-columns:repeat(2,minmax(220px,1fr));overflow:visible}}@media(max-width:850px){.app{grid-template-columns:1fr}.app>aside{display:none}.top{padding:0 14px}.mobile-brand{display:block}.title{display:none}.safe{display:none}.sales-kpis{grid-template-columns:1fr 1fr}.sales-board{grid-template-columns:repeat(2,minmax(0,1fr))}.doc-row{grid-template-columns:1fr 90px}.doc-row>*:nth-child(3){display:none}}@media(max-width:560px){.sales{padding:16px}.sales-head{align-items:flex-start;flex-direction:column}.sales-kpis,.sales-board{grid-template-columns:1fr}.actions .btn:first-child{display:none}}
      .records{height:100%;overflow:auto;padding:24px;background:radial-gradient(circle at 60% -30%,#12334f 0,transparent 38%),var(--bg)}.records-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:18px}.records-head h2{font-size:30px;margin:0}.records-head p{color:var(--muted);margin:4px 0 0}.records-actions{display:flex;gap:8px}.records-search{display:flex;align-items:center;gap:7px;border:1px solid var(--line);background:#0c2136;border-radius:9px;padding:8px 11px}.records-search input{width:240px;border:0;outline:0;background:transparent;color:white}.records-actions select{border:1px solid var(--line);background:#0c2136;color:white;border-radius:9px;padding:8px 12px}.records-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}.records-summary>div{border:1px solid var(--line);background:#0b1e32;border-radius:11px;padding:14px 16px}.records-summary small{color:var(--muted)}.records-summary strong{display:block;font-size:24px;margin-top:4px}.records-table{border:1px solid var(--line);background:#091c30;border-radius:12px;overflow:hidden}.records-row{width:100%;display:grid;grid-template-columns:minmax(220px,1.4fr) repeat(3,minmax(120px,1fr));gap:12px;align-items:center;padding:13px 16px;border:0;border-bottom:1px solid var(--line);background:transparent;color:white;text-align:left}.records-row:not(.records-labels){cursor:pointer}.records-row:not(.records-labels):hover{background:#10283e}.records-labels{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em}.records-row small{display:block;color:var(--muted);margin-top:2px}.records-empty{padding:28px;text-align:center;color:var(--muted)}.records-drawer{position:fixed;inset:0;z-index:35;display:grid;place-items:center;padding:20px}.records-drawer[hidden]{display:none}.records-back{position:absolute;inset:0;background:rgba(1,9,17,.8);backdrop-filter:blur(5px)}.records-sheet{position:relative;width:min(700px,calc(100vw - 40px));max-height:calc(100vh - 40px);overflow:auto;background:#0b2035;border:1px solid #38516a;border-radius:15px;padding:25px}.records-x{position:absolute;right:14px;top:9px;border:0;background:transparent;color:white;font-size:26px}.records-sheet h2{margin:0}.records-sheet>p{color:var(--muted)}.records-fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.records-field{border:1px solid var(--line);background:#07182a;border-radius:8px;padding:11px}.records-field small{display:block;color:var(--muted)}.records-foot{display:flex;justify-content:flex-end;margin-top:18px}@media(max-width:700px){.records-head{align-items:flex-start;flex-direction:column}.records-actions{width:100%}.records-search{flex:1}.records-search input{width:100%}.records-summary{grid-template-columns:1fr 1fr}.records-summary>div:last-child{grid-column:1/-1}.records-row{grid-template-columns:1fr 110px}.records-row span:nth-child(3),.records-row span:nth-child(4){display:none}.records-fields{grid-template-columns:1fr}}
    </style>
    <style is:global>
      @media(max-width:850px){.app{grid-template-columns:168px minmax(0,1fr)}.app>aside{display:block;padding:18px 9px}.brand{margin:2px 8px 22px}.brand img{width:125px!important}.nav a,.contact-nav summary{font-size:13px;padding:9px 10px}.contact-nav a{padding-left:19px}.group{margin:14px 9px 4px}.mobile-brand{display:none}.title{display:block}.top{padding:0 14px}}
      @media(max-width:600px){.app{grid-template-columns:138px minmax(0,1fr)}.app>aside{padding:14px 6px}.brand{margin:2px 7px 18px}.brand img{width:104px!important}.nav a,.contact-nav summary{font-size:12px;padding:8px}.contact-nav a{padding-left:15px}.group{font-size:9px;margin-left:8px;margin-right:8px}.top .title p{display:none}}
    </style>
    <script>
      import { createClient as createGateClient } from '@supabase/supabase-js';
      const gateLocal=['127.0.0.1','localhost'].includes(location.hostname),gateDemo=new URLSearchParams(location.search).get('demo')==='1';
      (async()=>{if(gateLocal&&gateDemo){document.documentElement.classList.add('v2-authorized');return}const gate=createGateClient('https://lumoevaotokgqnpybkyf.supabase.co','sb_publishable_ORGL5_FNZTXcGKwvjs-ymw_Y8DV_4ca'),{data:{session}}=await gate.auth.getSession();if(session)document.documentElement.classList.add('v2-authorized');else location.replace('/dashboard/');})();
    </script>
  </head>
  <body>
    <div class="app">
      <aside>
        <div class="brand"><img src="/assets/brand/viven-logo-white.svg" alt="VIVEN Film Production" style="display:block;width:145px;height:auto" /></div>
        <nav class="nav">
          <a href="/dashboard-v2/">◎ Hoy</a>
          <div class="group">Trabajo</div>
          {Object.entries(sections).slice(0,7).filter(([key])=>!['personas','empresas','tecnicos'].includes(key)).map(([key,item]) => <a class={key===section?'on':''} href={`/dashboard-v2/${key}/`}>{item.label}</a>)}
          <details class="contact-nav" open={['personas','empresas','tecnicos'].includes(section)}><summary>Contactos</summary>{['personas','empresas','tecnicos'].map(key=><a class={key===section?'on':''} href={`/dashboard-v2/${key}/`}>{sections[key].label}</a>)}</details>
          <div class="group">Gestión</div>
          {Object.entries(sections).slice(7).map(([key,item]) => <a class={key===section?'on':''} href={`/dashboard-v2/${key}/`}>{item.label}</a>)}
        </nav>
      </aside>
      <main class="stage">
        <header class="top">
          <img class="mobile-brand" src="/assets/brand/viven-logo-white.svg" alt="VIVEN Film Production" />
          <div class="title"><h1>{current.label}</h1><p>{current.hint}</p></div>
          <div class="actions"><a class="btn" href="/dashboard-v2/">Hoy 2</a><a class="btn primary" href={source} target="_top">Abrir pantalla completa ↗</a></div>
        </header>
        {section === 'ventas' ? (
          <section class="sales" id="sales-root">
            <div class="sales-head">
              <div><h2>Ventas</h2><p id="sales-mode">Cargando datos reales…</p></div>
              <div class="sales-tabs" role="tablist"><button class="sales-tab on" data-view="pipeline" type="button">Pipeline</button><button class="sales-tab" data-view="docs" type="button">Ofertas y propuestas</button></div>
            </div>
            <div class="sales-kpis">
              <a class="sales-kpi" href="/dashboard/?tab=deals" title="Deals ganados con won_at dentro del mes; los registros anteriores usan last_stage_at"><span>Cerrado este mes</span><strong id="sales-closed">—</strong></a>
              <a class="sales-kpi" href="/dashboard/?tab=deals" title="Valor real de cada deal abierto multiplicado por la probabilidad de su etapa"><span>Pipeline ponderado</span><strong id="sales-open">—</strong></a>
              <a class="sales-kpi" href="/dashboard/?tab=offers" title="Ofertas y propuestas no archivadas con estado draft o sent"><span>Documentos abiertos</span><strong id="sales-doc-count">—</strong></a>
              <a class="sales-kpi" href="/dashboard/?tab=deals" title="Ganados / (ganados + perdidos), ambos cerrados en el mes"><span>Win rate del mes</span><strong id="sales-rate">—</strong></a>
            </div>
            <div class="sales-board" id="sales-board">
              {['Nuevo','Contactado','Video call','Propuesta'].map((label,i) => <article class="sales-col"><div class="sales-col-head"><b>{label}</b><span id={`sales-count-${i}`}>—</span></div><div class="sales-list" id={`sales-list-${i}`}><p class="sales-empty">Esperando datos reales</p></div></article>)}
            </div>
            <div class="sales-docs" id="sales-docs"><div class="doc-row"><b>Documento</b><small>Tipo</small><small>Estado</small><small>Valor</small></div><p class="sales-empty">Esperando datos reales</p></div>
            <div class="sales-drawer" id="sales-drawer" hidden><div class="sales-back"></div><article class="sales-sheet" role="dialog" aria-modal="true" aria-labelledby="sales-detail-title"><button class="sales-x" type="button" aria-label="Cerrar">×</button><h2 id="sales-detail-title">Detalle</h2><p id="sales-detail-sub" style="color:var(--muted)"></p><div id="sales-detail-body"></div><div style="display:flex;justify-content:flex-end;margin-top:18px"><a class="btn primary" id="sales-origin" href="/dashboard/?tab=deals">Abrir en el dashboard actual</a></div></article></div>
          </section>
        ) : section === 'agenda' ? (
          <DashboardV2Agenda />
        ) : section === 'analytics' ? (
          <DashboardV2Analytics />
        ) : ['contenido','automatizaciones','sistema'].includes(section) ? (
          <DashboardV2Management section={section} />
        ) : ['proyectos','personas','empresas','tecnicos'].includes(section) ? (
          <DashboardV2Records section={section} />
        ) : (
          <div class="frame-wrap" data-label={current.label}>
            <iframe class="frame" title={current.label} src={source}></iframe>
            <div class="safe">Compatibilidad total · misma información y funciones</div>
          </div>
        )}
      </main>
    </div>
    {section === 'ventas' && <script>
      import { createClient } from '@supabase/supabase-js';
      const db=createClient('https://lumoevaotokgqnpybkyf.supabase.co','sb_publishable_ORGL5_FNZTXcGKwvjs-ymw_Y8DV_4ca');
      const q=s=>document.querySelector(s),qa=s=>[...document.querySelectorAll(s)],demo=new URLSearchParams(location.search).get('demo')==='1';
      const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const chf=n=>'CHF '+Math.round(Number(n)||0).toLocaleString('de-CH'),val=x=>Number(x?.total_net??x?.net_total??x?.value??x?.amount_chf??x?.amount??x?.deal_value??0)||0;
      const stage=s=>{s=String(s||'').toLowerCase();if(['won','cerrado','ganado'].includes(s))return'ganado';if(['lost','perdido'].includes(s))return'perdido';if(['proposal','propuesta','qualified'].includes(s))return'propuesta';if(['videocall','video call booked','call','agendada','booked'].includes(s))return'videocall';if(['contacted','contactado'].includes(s))return'contactado';return'nuevo'};
      const age=x=>Math.max(0,Math.floor((Date.now()-Date.parse(x||new Date()))/864e5)),firstDealOf=id=>deals.filter(x=>!x.archived&&String(x.lead_id)===String(id)).sort((a,b)=>Date.parse(a.created_at||0)-Date.parse(b.created_at||0))[0],docsFor=(d,list)=>list.filter(x=>{if(x.archived||x.is_template)return false;if(x.deal_id)return String(x.deal_id)===String(d.id);if(!x.lead_id||String(x.lead_id)!==String(d.lead_id))return false;const first=firstDealOf(d.lead_id);return !!(first&&String(first.id)===String(d.id))}),oneOf=a=>{if(!a.length)return 0;const r=a.find(x=>x.recommended);return r?val(r):a.reduce((s,x)=>s+val(x),0)/a.length},dealValue=d=>{const os=docsFor(d,offers),ps=docsFor(d,proposals),won=os.filter(x=>x.status==='won').reduce((a,x)=>a+val(x),0)+ps.filter(x=>x.status==='accepted').reduce((a,x)=>a+val(x),0);if(won)return won;return oneOf(os.filter(x=>['draft','sent'].includes(x.status)))+oneOf(ps.filter(x=>x.status==='sent'))||val(d)},dealProb=d=>{const s=stage(d.stage),base={nuevo:.2,contactado:.4,videocall:.6,propuesta:.5,ganado:1,perdido:0}[s]||0;if(s!=='propuesta')return base;const hasDoc=docsFor(d,offers).some(x=>['sent','won'].includes(x.status))||docsFor(d,proposals).some(x=>['sent','accepted'].includes(x.status));if(!hasDoc)return .4;const days=age(d.last_stage_at||d.created_at);return days<=7?.5:days<=14?.35:.2};
      const stageIndex=s=>({nuevo:0,contactado:1,videocall:2,propuesta:3}[stage(s)]??-1),leadName=(id,leads)=>{const l=leads.find(x=>String(x.id)===String(id))||{};return l.company||l.name||l.email||'Contacto sin nombre'};
      const field=(k,v)=>`<div class="sales-field"><small>${esc(k)}</small><b>${esc(v||'—')}</b></div>`;
      let leads=[],deals=[],offers=[],proposals=[],returnFocus=null;
      async function readAll(table){let data=[];for(let from=0;from<20000;from+=1000){const result=await db.from(table).select('*').range(from,from+999);if(result.error)return result;data.push(...(result.data||[]));if((result.data||[]).length<1000)return{data,error:null}}return{data:null,error:{message:'Más de 20.000 registros'}}}
      function closeDrawer(){q('#sales-drawer').hidden=true;if(returnFocus?.focus)returnFocus.focus()}q('.sales-x').onclick=q('.sales-back').onclick=closeDrawer;
      function detail(kind,id){const pool=kind==='deal'?deals:kind==='offer'?offers:proposals,x=pool.find(r=>String(r.id)===String(id))||{},isDeal=kind==='deal',name=leadName(x.lead_id,leads),amount=isDeal?dealValue(x):val(x);returnFocus=document.activeElement;q('#sales-detail-title').textContent=x.title||x.number||(isDeal?'Deal':'Documento');q('#sales-detail-sub').textContent=name;q('#sales-detail-body').innerHTML=`<div class="sales-grid">${field('Tipo',isDeal?'Deal':kind==='offer'?'Oferta':'Propuesta')}${field('Estado',isDeal?stage(x.stage):x.status)}${field('Valor',amount?chf(amount):'—')}${field('Actualizado',x.updated_at?new Date(x.updated_at).toLocaleString('es-CH'):'—')}</div><div class="sales-related"><b>Información relacionada</b><p>${esc(name)}</p></div>`;q('#sales-origin').href=isDeal?'/dashboard/?tab=deals':kind==='offer'?'/dashboard/?offer='+encodeURIComponent(x.id):'/dashboard/?propuesta='+encodeURIComponent(x.id);q('#sales-drawer').hidden=false;q('.sales-x').focus()}
      function bind(){qa('[data-sales-kind]').forEach(a=>a.onclick=e=>{if(demo||a.dataset.salesKind){e.preventDefault();detail(a.dataset.salesKind,a.dataset.salesId)}})}
      function render(){for(let i=0;i<4;i++){const rows=deals.filter(d=>!d.archived&&stageIndex(d.stage)===i);q('#sales-count-'+i).textContent=String(rows.length);q('#sales-list-'+i).innerHTML=rows.length?rows.map(d=>`<a class="deal-card" href="/dashboard/?tab=deals" data-sales-kind="deal" data-sales-id="${esc(d.id)}"><h3>${esc(d.title||leadName(d.lead_id,leads))}</h3><p>${esc(leadName(d.lead_id,leads))}</p><div class="deal-meta"><span>${d.next_action?esc(d.next_action):'Sin próximo paso'}</span><strong>${dealValue(d)?chf(dealValue(d)):'—'}</strong></div></a>`).join(''):'<p class="sales-empty">Sin deals en esta etapa</p>'}
        const docs=[...offers.map(x=>({...x,_kind:'offer',_type:'Oferta'})),...proposals.map(x=>({...x,_kind:'proposal',_type:'Propuesta'}))].filter(x=>!x.archived&&!x.is_template).sort((a,b)=>Date.parse(b.updated_at||b.created_at||0)-Date.parse(a.updated_at||a.created_at||0));q('#sales-docs').innerHTML='<div class="doc-row"><b>Documento</b><small>Tipo</small><small>Estado</small><small>Valor</small></div>'+((docs.length?docs.map(x=>`<a class="doc-row" href="/dashboard/?${x._kind==='offer'?'offer':'propuesta'}=${encodeURIComponent(x.id)}" data-sales-kind="${x._kind}" data-sales-id="${esc(x.id)}"><b>${esc(x.title||x.number||'Sin título')}<small style="display:block">${esc(leadName(x.lead_id,leads))}</small></b><span>${x._type}</span><span>${esc(x.status||'—')}</span><strong>${val(x)?chf(val(x)):'—'}</strong></a>`).join(''):'<p class="sales-empty">No hay documentos</p>'));bind()}
      function metrics(){const now=new Date(),m0=new Date(now.getFullYear(),now.getMonth(),1).getTime(),m1=new Date(now.getFullYear(),now.getMonth()+1,1).getTime(),inside=x=>{const t=Date.parse(x||'');return Number.isFinite(t)&&t>=m0&&t<m1},won=deals.filter(d=>!d.archived&&stage(d.stage)==='ganado'&&inside(d.won_at||d.last_stage_at)),lost=deals.filter(d=>!d.archived&&stage(d.stage)==='perdido'&&inside(d.lost_at||d.last_stage_at)),open=deals.filter(d=>!d.archived&&!['ganado','perdido'].includes(stage(d.stage))),docs=[...offers,...proposals].filter(x=>!x.archived&&!x.is_template&&['draft','sent'].includes(String(x.status||'').toLowerCase())),decided=won.length+lost.length,weighted=open.reduce((a,d)=>a+dealValue(d)*dealProb(d),0);q('#sales-closed').textContent=chf(won.reduce((a,d)=>a+dealValue(d),0));q('#sales-open').textContent=chf(weighted);q('#sales-doc-count').textContent=String(docs.length);q('#sales-rate').textContent=decided?Math.round(won.length/decided*100)+'%':'—'}
      qa('.sales-tab').forEach(b=>b.onclick=()=>{qa('.sales-tab').forEach(x=>x.classList.toggle('on',x===b));q('#sales-root').classList.toggle('doc-mode',b.dataset.view==='docs')});
      document.addEventListener('click',e=>{if(!demo)return;const a=e.target.closest('a[href^="/dashboard/"]');if(a&&!a.dataset.salesKind){e.preventDefault();q('#sales-detail-title').textContent='Datos reales no disponibles';q('#sales-detail-sub').textContent='Esta vista demo no inventa información';q('#sales-detail-body').innerHTML='<p class="sales-empty">Iniciá sesión para abrir registros, métricas y documentos reales.</p>';q('#sales-origin').style.display='none';q('#sales-drawer').hidden=false}});
      async function load(){if(demo){q('#sales-mode').innerHTML='Vista demo · sin registros ni métricas ficticias <a class="mode-link" href="/dashboard-v2/ventas/">Ver datos reales →</a>';for(let i=0;i<4;i++){q('#sales-count-'+i).textContent='—';q('#sales-list-'+i).innerHTML='<p class="sales-empty">Los datos reales aparecen aquí</p>'}q('#sales-docs').innerHTML='<div class="doc-row"><b>Documento</b><small>Tipo</small><small>Estado</small><small>Valor</small></div><p class="sales-empty">Los documentos reales aparecen aquí</p>';return}const {data:{session}}=await db.auth.getSession();if(!session){q('#sales-mode').innerHTML='Sesión local no iniciada <a class="mode-link" href="/dashboard/">Iniciar sesión →</a>';return}const [l,d,o,p]=await Promise.all([readAll('leads'),readAll('deals'),readAll('offers'),readAll('proposals')]);if([l,d,o,p].some(x=>x.error)){q('#sales-mode').textContent='No se pudo verificar el conjunto completo · métricas ocultas';return}leads=(l.data||[]).filter(x=>!x.es_prueba);deals=d.data||[];offers=o.data||[];proposals=p.data||[];q('#sales-mode').textContent='Datos reales · '+(session.user.email||'sesión activa');render();metrics()}load();
      document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!q('#sales-drawer').hidden)closeDrawer()});
    </script>}
    <script>
      const demoNav=new URLSearchParams(location.search).get('demo')==='1';
      if(demoNav){document.querySelectorAll('a[href^="/dashboard-v2/"]:not(.mode-link)').forEach(a=>{const u=new URL(a.href,location.origin);u.searchParams.set('demo','1');a.href=u.pathname+u.search});const full=document.querySelector('.top .actions .primary');if(full)full.style.display='none'}
    </script>
