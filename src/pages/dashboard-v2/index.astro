function metrics(){const now=new Date(),m0=new Date(now.getFullYear(),now.getMonth(),1).getTime(),m1=new Date(now.getFullYear(),now.getMonth()+1,1).getTime(),inMonth=x=>{const t=Date.parse(x||'');return Number.isFinite(t)&&t>=m0&&t<m1},won=deals.filter(d=>!d.archived&&stageOf(d.stage)==='ganado'&&inMonth(d.won_at||d.last_stage_at)),lost=deals.filter(d=>!d.archived&&stageOf(d.stage)==='perdido'&&inMonth(d.lost_at||d.last_stage_at)),openOffers=offers.filter(x=>!x.archived&&!x.is_template&&['draft','sent'].includes(String(x.status||'').toLowerCase())),openProps=props.filter(x=>!x.archived&&!x.is_template&&['draft','sent'].includes(String(x.status||'').toLowerCase())),closed=won.reduce((a,d)=>a+dealValue(d),0),decided=won.length+lost.length;const nums=[chf(closed),String(openOffers.length),String(openProps.length),decided?Math.round(won.length/decided*100)+'%':'—'];qa('.metric strong').forEach((e,i)=>e.textContent=nums[i]);const goal=monthlyGoal||0,pct=goal?Math.min(100,closed/goal*100):0;q('.goalrow span').innerHTML=goal?'Objetivo: <b>'+chf(goal)+'</b>':'Objetivo mensual no definido';q('.goalrow> b').textContent=goal?chf(closed)+' ('+Math.round(pct)+'%)':chf(closed);q('.bar').style.setProperty('--goal-pct',pct+'%');q('.bar').nextElementSibling.textContent=goal?'Cerrado '+chf(closed)+' de '+chf(goal)+' ('+Math.round(pct)+'%) · día '+now.getDate()+' de '+new Date(now.getFullYear(),now.getMonth()+1,0).getDate():'Definí el objetivo mensual en Ventas para medir el avance.'}
function activity(){const a=[...leads.slice(0,2).map(x=>({icon:'♙',t:'Nuevo lead añadido',s:x.name||x.email,at:x.created_at,href:'/dashboard/?lead='+encodeURIComponent(x.id)})),...props.slice(0,2).map(x=>({icon:'▤',t:'Propuesta actualizada',s:x.title,at:x.updated_at,href:'/dashboard/?propuesta='+encodeURIComponent(x.id)})),...projects.filter(problem).slice(0,1).map(x=>({icon:'▣',t:'Proyecto requiere decisión',s:x.title,at:x.started_at,href:'/dashboard/?proyecto='+encodeURIComponent(x.ref||x.id)}))].sort((a,b)=>Date.parse(b.at)-Date.parse(a.at)).slice(0,3);q('.activity').innerHTML=a.map(x=>`<a class="event" href="${x.href}"><span class="ico">${x.icon}</span><div><b>${esc(x.t)}</b><small>${esc(x.s)}</small></div><time>Hace ${age(x.at)||'<1'} d</time></a>`).join('')}
