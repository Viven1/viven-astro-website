async function draft(mode='generate'){const manualSubject=q('#fu-subject').value.trim(),manualBody=q('#fu-body').value.trim();if(mode==='improve'&&!manualBody){q('#fu-status').textContent='Escribí primero tu mensaje y después tocá “Mejorar mi texto”.';q('#fu-body').focus();return}q('#fu-status').textContent=mode==='improve'?'Claude está mejorando tu texto sin cambiar la intención…':'Claude está preparando el borrador con todo el contexto comercial…';aiBusy(true);if(demo){q('#fu-status').textContent='La demo no genera textos ficticios. En una sesión real Claude usa conversación, brief, deals, documentos, notas, tareas y proyectos.';aiBusy(false);return}const [h,b,n,t]=await Promise.all([db.from('email_log').select('direction,subject,body,created_at').eq('lead_id',String(fu.id)).order('created_at').limit(20),latestBriefFor(fu),db.from('lead_notes').select('body,author,created_at').eq('lead_id',String(fu.id)).order('created_at',{ascending:false}).limit(8),db.from('lead_tasks').select('title,body,due_date,done,created_at').eq('lead_id',String(fu.id)).order('created_at',{ascending:false}).limit(12)]);const history=(h.data||[]).map(x=>({direction:x.direction,subject:x.subject,body:String(x.body||'').replace(/<[^>]+>/g,' ').slice(0,800)})),business=commercialContext(fu,n.data||[],t.data||[]),fullBrief=[briefFullText(b),business].filter(Boolean).join('\n\n');const hint=mode==='improve'?`Improve the following draft while preserving exactly the sender's intent and facts. Make it natural, concise and ready to send. Do not add promises, prices or invented information. Keep the same language as the draft. SUBJECT: ${manualSubject||'(create a suitable subject)'}\n\nDRAFT BODY:\n${manualBody}`:'';const {data,error}=await db.functions.invoke('ai-email-draft',{body:{lead:fu,sender:'sebastian',hint,history,brief:fullBrief}});if(error||data?.error){q('#fu-status').textContent='Claude no pudo completar el texto. Tu borrador se conserva para que puedas reintentar.';aiBusy(false);return}