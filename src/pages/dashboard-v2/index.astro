async function load(){if(demo){q('#mode-note').textContent='Vista demo · sin registros ni métricas ficticias';return}const {data:{session}}=await db.auth.getSession();if(!session){q('#mode-note').textContent='Sesión local no iniciada · datos ocultos';return}q('#mode-note').textContent='Datos reales · sesión '+(session.user.email||'');const [l,p,j,d,o]=await Promise.all([readAll('leads','created_at'),readAll('proposals','updated_at'),readAll('projects','started_at'),readAll('deals','created_at'),readAll('offers','updated_at')]);if([l,p,j,d,o].some(x=>x.error)){q('#mode-note').textContent='Error al verificar el conjunto completo · información oculta';return}leads=(l.data||[]).filter(x=>!x.es_prueba);props=(p.data||[]).filter(x=>!x.archived&&!x.is_template);projects=(j.data||[]).filter(x=>!x.archived);deals=d.data||[];offers=o.data||[];items=[...leads.filter(x=>x.channel!=='manual'&&['new','nuevo','lead'].includes(String(x.status||'').toLowerCase())&&age(x.created_at)<4).map(x=>({type:'lead',title:x.company||x.name||x.email,copy:'lead nuevo hace '+age(x.created_at)+' día(s)',state:'Sin contactar',leadId:x.id})),...props.filter(x=>x.status==='sent'&&age(x.published_at||x.updated_at)>2).map(x=>({type:'sale',title:lead(x.lead_id).company||x.title,copy:'propuesta '+(x.last_view_at?'vista':'sin respuesta')+' hace '+age(x.published_at||x.updated_at)+' día(s)',value:value(x),leadId:x.lead_id})),...projects.filter(problem).map(x=>({type:'project',title:x.title||x.ref,copy:problem(x),ref:x.ref||x.id}))].sort((a,b)=>(b.value||0)-(a.value||0));dataVerified=true;setTabs();render();metrics();activity()}
