<style is:global>#follow-modal{position:fixed;inset:0;z-index:20;display:grid;place-items:center;padding:24px}#follow-modal[hidden]{display:none}.modal-back{position:absolute;inset:0;background:rgba(1,9,17,.78);backdrop-filter:blur(6px)}.modal{position:relative;width:min(650px,calc(100vw - 48px));max-height:calc(100vh - 48px);overflow:auto;background:#0b2035;border:1px solid #38516a;border-radius:16px;padding:28px;box-shadow:0 30px 90px #000}.modal-x{position:absolute;right:18px;top:13px;border:0;background:transparent;color:white;font-size:27px;cursor:pointer}.modal-kicker{color:var(--lime);font-size:11px;letter-spacing:.13em;margin:0 0 8px}.modal-title{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding-right:32px}.modal h2{margin:0}.modal-title p{margin:5px 0 0}.claude-pill{border:1px solid #526831;border-radius:999px;padding:6px 10px;color:var(--lime);font-size:12px;white-space:nowrap}.modal label{display:block;color:var(--muted);font-size:13px;margin-top:16px}.modal input,.modal textarea{display:block;width:100%;margin-top:6px;background:#07182a;border:1px solid var(--line);border-radius:8px;color:white;padding:11px;font:inherit}.modal textarea{resize:vertical;min-height:190px}.modal input:focus,.modal textarea:focus{outline:2px solid rgba(229,255,76,.28);border-color:var(--lime)}.modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px;flex-wrap:wrap}.modal-actions .btn{cursor:pointer}.modal-actions .btn:disabled{opacity:.55;cursor:wait}@media(max-width:650px){#follow-modal{padding:12px}.modal{width:100%;max-height:calc(100vh - 24px);padding:22px 18px}.modal-title{display:block}.claude-pill{display:inline-block;margin-top:10px}.modal-actions{display:grid}.modal-actions .btn{width:100%}}</style>
<script>
import { createClient } from '@supabase/supabase-js';
const db=createClient('https://lumoevaotokgqnpybkyf.supabase.co','sb_publishable_ORGL5_FNZTXcGKwvjs-ymw_Y8DV_4ca');
const q=(s)=>document.querySelector(s), qa=(s)=>[...document.querySelectorAll(s)], demo=new URLSearchParams(location.search).get('demo')==='1';
const esc=(s)=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const age=(x)=>Math.max(0,Math.floor((Date.now()-Date.parse(x||new Date()))/864e5));
const chf=(n)=>'CHF '+Math.round(Number(n)||0).toLocaleString('de-CH');
const value=(x)=>Number(x.total_net??x.net_total??x.value??x.amount_chf??x.amount??0)||0;
let leads=[],props=[],projects=[],deals=[],offers=[],items=[],active='all',fu=null;
const lead=(id)=>leads.find(x=>String(x.id)===String(id))||{};
const pickDeepestBrief=(rows)=>(rows||[]).find(b=>b&&b.goal)||(rows&&rows[0])||null;
async function latestBriefFor(r){try{let {data}=await db.from('briefs').select('*').eq('lead_id',String(r.id)).order('created_at',{ascending:false}).limit(5);if((!data||!data.length)&&r.email)({data}=await db.from('briefs').select('*').ilike('email',r.email).order('created_at',{ascending:false}).limit(5));return pickDeepestBrief(data)}catch{return null}}
function briefFullText(b){if(!b)return'';const a=b.answers||{},li=(k,v)=>{if(!v)return'';const s=Array.isArray(v)?v.join(', '):String(v);return s.trim()?k+': '+s+'\n':''};const fields=(li('Objetivo',b.goal)+li('Audiencia',a.audience)+li('Dónde va a correr',b.distribution||a.distribution)+li('Cantidad de videos',a.quantity)+li('Formatos',a.formats)+li('Idiomas y subtítulos',a.languages)+li('En cámara',a.oncamera)+li('Locaciones',a.locations)+li('Timing',b.timeline)+li('Presupuesto',b.budget)+li('Qué deben hacer después de verlo',a.action)+li('Qué deben sentir',a.feeling)+li('Adónde deben llegar',a.destination)+li('Referencias',a.references)).trim();const extra=b.extra&&String(b.extra).trim()?`SUS PROPIAS PALABRAS (leer y responder puntualmente): "${String(b.extra).trim()}"\n\n`:'';return(extra+fields).trim()}
function problem(p){if(p.stage==='entregado')return'';if(p.delivery_due&&p.delivery_due<new Date().toISOString().slice(0,10))return'fecha de entrega vencida';if(!p.shoot_start&&age(p.started_at)>14)return'sin fecha de rodaje';return''}
function itemHtml(x){const icon=x.type==='lead'?'♙':x.type==='project'?'▣':'▤';return `<div class="decision"><span class="ico ${x.type==='project'?'amber':''}">${icon}</span><div class="who"><b>${esc(x.title)}</b><span> · ${esc(x.copy)}</span></div><div class="${x.value?'amount':'status'}">${x.value?chf(x.value):'<i class="dot"></i>'+esc(x.state||'Requiere acción')}</div><div class="actions">${x.leadId?`<button class="btn" data-follow="${esc(x.leadId)}">Generar follow-up con IA</button><button class="btn" data-done="${esc(x.leadId)}">Marcar hecho</button>`:`<a class="btn" href="/dashboard/?proyecto=${encodeURIComponent(x.ref)}">Resolver ahora</a>`}</div><span class="dots">•••</span></div>`}
function render(){const rows=items.filter(x=>active==='all'||x.type===active);q('.card').querySelectorAll('.decision').forEach(x=>x.remove());q('.card').insertAdjacentHTML('beforeend',rows.slice(0,6).map(itemHtml).join('')||'<p class="muted" style="padding:25px">Todo al día.</p>');qa('[data-follow]').forEach(b=>b.onclick=()=>openFollow(b.dataset.follow));qa('[data-done]').forEach(b=>b.onclick=()=>done(b.dataset.done,b));}
function setTabs(){const counts={all:items.length,sale:items.filter(x=>x.type!=='project').length,project:items.filter(x=>x.type==='project').length};qa('.tabs button').forEach((b,i)=>{b.dataset.kind=['all','sale','project'][i];b.querySelector('.badge').textContent=counts[b.dataset.kind];b.onclick=()=>{active=b.dataset.kind;qa('.tabs button').forEach(x=>x.classList.toggle('on',x===b));render()}})}
function metrics(){const now=new Date(),month=now.getMonth(),year=now.getFullYear(),won=deals.filter(d=>['ganado','won'].includes(String(d.stage||'').toLowerCase())&&new Date(d.won_at||d.updated_at).getMonth()===month&&new Date(d.won_at||d.updated_at).getFullYear()===year),lost=deals.filter(d=>['perdido','lost'].includes(String(d.stage||'').toLowerCase())),open=deals.filter(d=>!d.archived&&!['ganado','won','perdido','lost'].includes(String(d.stage||'').toLowerCase()));const nums=[chf(won.reduce((a,d)=>a+value(d),0)),chf(open.reduce((a,d)=>a+value(d),0)*.55),chf(props.filter(p=>p.status==='sent').reduce((a,p)=>a+value(p),0)),Math.round(won.length/Math.max(1,won.length+lost.length)*100)+'%'];qa('.metric strong').forEach((e,i)=>e.textContent=nums[i]);}
function activity(){const a=[...leads.slice(0,2).map(x=>({icon:'♙',t:'Nuevo lead añadido',s:x.name||x.email,at:x.created_at})),...props.slice(0,2).map(x=>({icon:'▤',t:'Propuesta actualizada',s:x.title,at:x.updated_at})),...projects.filter(problem).slice(0,1).map(x=>({icon:'▣',t:'Proyecto requiere decisión',s:x.title,at:x.started_at}))].sort((a,b)=>Date.parse(b.at)-Date.parse(a.at)).slice(0,3);q('.activity').innerHTML=a.map(x=>`<div class="event"><span class="ico">${x.icon}</span><div><b>${esc(x.t)}</b><small>${esc(x.s)}</small></div><time>Hace ${age(x.at)||'<1'} d</time></div>`).join('')}
async function openFollow(id){fu=lead(id);if(!fu.email){location.href='/dashboard/?lead='+encodeURIComponent(id);return}q('#fu-name').textContent=fu.name||fu.company||'Contacto';q('#fu-email').textContent=fu.email;q('#fu-subject').value='';q('#fu-body').value='';q('#fu-status').textContent='Podés escribir desde cero o generar un primer borrador.';q('#follow-modal').hidden=false;await draft('generate')}
function aiBusy(on){q('#fu-generate').disabled=on;q('#fu-improve').disabled=on;q('#fu-generate').textContent=on?'Claude está escribiendo…':'✦ Generar con Claude';q('#fu-improve').textContent=on?'Claude está escribiendo…':'✦ Mejorar mi texto'}
async function draft(mode='generate'){const manualSubject=q('#fu-subject').value.trim(),manualBody=q('#fu-body').value.trim();if(mode==='improve'&&!manualBody){q('#fu-status').textContent='Escribí primero tu mensaje y después tocá “Mejorar mi texto”.';q('#fu-body').focus();return}q('#fu-status').textContent=mode==='improve'?'Claude está mejorando tu texto sin cambiar la intención…':'Claude está preparando el borrador con el contexto real…';aiBusy(true);if(demo){if(mode==='generate'){q('#fu-subject').value='Kurze Nachfrage zu unserem Angebot';q('#fu-body').value='Hallo '+(fu.name?.split(' ')[0]||'')+',\n\nich wollte kurz nachfragen, ob es bereits Feedback zu unserem Angebot gibt. Gerne bespreche ich offene Fragen persönlich.\n\nLiebe Grüsse\nSebastian'}q('#fu-status').textContent='Vista demo: en la sesión real este botón usa Claude y el historial completo.';aiBusy(false);return}const [h,b]=await Promise.all([db.from('email_log').select('direction,subject,body,created_at').eq('lead_id',String(fu.id)).order('created_at').limit(20),latestBriefFor(fu)]);const history=(h.data||[]).map(x=>({direction:x.direction,subject:x.subject,body:String(x.body||'').replace(/<[^>]+>/g,' ').slice(0,800)}));const hint=mode==='improve'?`Improve the following draft while preserving exactly the sender's intent and facts. Make it natural, concise and ready to send. Do not add promises, prices or invented information. Keep the same language as the draft. SUBJECT: ${manualSubject||'(create a suitable subject)'}\n\nDRAFT BODY:\n${manualBody}`:'';const {data,error}=await db.functions.invoke('ai-email-draft',{body:{lead:fu,sender:'sebastian',hint,history,brief:briefFullText(b)}});if(error||data?.error){q('#fu-status').textContent='Claude no pudo completar el texto. Tu borrador se conserva para que puedas reintentar.';aiBusy(false);return}q('#fu-subject').value=data.subject||manualSubject;q('#fu-body').value=data.body||manualBody;q('#fu-status').textContent=mode==='improve'?'✓ Claude mejoró tu texto. Revisalo antes de enviarlo.':'✓ Borrador creado por Claude con la conversación y el brief del contacto.';aiBusy(false)}
async function done(id,b){if(demo){b.textContent='✓ Hecho (demo)';return}b.disabled=true;const when=new Date(Date.now()+7*864e5).toISOString().slice(0,10);const r=await db.from('leads').update({next_follow_up_at:when}).eq('id',String(id));if(!r.error)await db.from('lead_notes').insert({lead_id:String(id),author:'dashboard-v2',body:'✓ Seguimiento hecho desde Hoy 2. Vuelve a aparecer el '+when+'.'});b.textContent=r.error?'Error':'✓ Hecho';}
q('.modal-x').onclick=q('.modal-back').onclick=()=>q('#follow-modal').hidden=true;q('#fu-generate').onclick=()=>draft('generate');q('#fu-improve').onclick=()=>draft('improve');q('#fu-send').onclick=async()=>{if(!q('#fu-body').value.trim()){q('#fu-status').textContent='Escribí un mensaje antes de enviarlo.';q('#fu-body').focus();return}if(demo){q('#fu-status').textContent='Demo: envío simulado correctamente.';return}const b=q('#fu-send');b.disabled=true;const {data,error}=await db.functions.invoke('send-outreach',{body:{to:fu.email,subject:q('#fu-subject').value,body:q('#fu-body').value,lead_id:fu.id,mark_contacted:true,fromName:'Sebastian'}});q('#fu-status').textContent=error||!data?.ok?'No se pudo enviar: '+(data?.error||error?.message||'sin respuesta'):'✓ Enviado y guardado en la conversación.';b.disabled=false};
q('.create').onclick=()=>location.href='/dashboard/?tab=leads';q('.search').onclick=()=>location.href='/dashboard/';
async function load(){if(demo){q('#mode-note').textContent='Vista funcional · datos de demostración';return}const {data:{session}}=await db.auth.getSession();if(!session){location.replace('/dashboard/');return}q('#mode-note').textContent='Datos reales · sesión '+(session.user.email||'');const [l,p,j,d,o]=await Promise.all([db.from('leads').select('*').order('created_at',{ascending:false}).limit(1000),db.from('proposals').select('*').order('updated_at',{ascending:false}).limit(1000),db.from('projects').select('*').eq('archived',false).order('started_at',{ascending:false}).limit(1000),db.from('deals').select('*').order('created_at',{ascending:false}).limit(1000),db.from('offers').select('*').order('updated_at',{ascending:false}).limit(1000)]);if([l,p,j,d,o].some(x=>x.error)){q('#mode-note').textContent='Error al cargar datos';return}leads=(l.data||[]).filter(x=>!x.es_prueba);props=(p.data||[]).filter(x=>!x.archived&&!x.is_template);projects=j.data||[];deals=d.data||[];offers=o.data||[];items=[...leads.filter(x=>x.channel!=='manual'&&['new','nuevo','lead'].includes(String(x.status||'').toLowerCase())&&age(x.created_at)<4).map(x=>({type:'lead',title:x.company||x.name||x.email,copy:'lead nuevo hace '+age(x.created_at)+' día(s)',state:'Sin contactar',leadId:x.id})),...props.filter(x=>x.status==='sent'&&age(x.published_at||x.updated_at)>2).map(x=>({type:'sale',title:lead(x.lead_id).company||x.title,copy:'propuesta '+(x.last_view_at?'vista':'sin respuesta')+' hace '+age(x.published_at||x.updated_at)+' día(s)',value:value(x),leadId:x.lead_id})),...projects.filter(problem).map(x=>({type:'project',title:x.title||x.ref,copy:problem(x),ref:x.ref||x.id}))].sort((a,b)=>(b.value||0)-(a.value||0));setTabs();render();metrics();activity()}
