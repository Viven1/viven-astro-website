let inspectedLeadId=null;const langName=(v)=>({de:'Alemán',en:'Inglés',es:'Español'}[String(v||'').toLowerCase()]||'Sin definir'),dateInput=(v)=>{if(!v||v==='Sin fecha')return'';const d=new Date(v);if(!Number.isFinite(d.getTime()))return'';const z=n=>String(n).padStart(2,'0');return d.getFullYear()+'-'+z(d.getMonth()+1)+'-'+z(d.getDate())+'T'+z(d.getHours())+':'+z(d.getMinutes())};const itemField=(k,v)=>k==='Próximo seguimiento'?`<label class="item-field"><small>Próximo seguimiento</small><input id="demo-follow-at" type="datetime-local" value="${dateInput(v)}"><em>${v&&v!=='Sin fecha'?'Tocá para cambiar fecha y hora':'Sin fecha · tocá para programar'}</em></label>`:`<div class="item-field"><small>${esc(k)}</small><b>${esc(k==='Idioma'?langName(v):(v||'—'))}</b></div>`,itemSection=(t,rows)=>rows.length?`<div class="item-section"><h3>${esc(t)}</h3>${rows.map(x=>`<p>${esc(x)}</p>`).join('')}</div>`:'';
