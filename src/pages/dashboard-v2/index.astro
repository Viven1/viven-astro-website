---
export const prerender = true;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#07182b" />
    <title>Hoy 2 · Viven</title>
    <style>
      :root {
        color-scheme: dark;
        --bg:#061526; --panel:#0b1e32; --panel2:#10263d; --line:#253c52;
        --text:#f5f7fb; --muted:#9caec0; --lime:#d9fb35; --amber:#ffbd45;
        --red:#ff716c; --blue:#64c8ff; --green:#53dfa5;
      }
      *{box-sizing:border-box} body{margin:0;background:radial-gradient(circle at 70% -20%,#12334f 0,transparent 36%),var(--bg);color:var(--text);font:15px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
      button,a{font:inherit} button{cursor:pointer}.shell{min-height:100vh;display:grid;grid-template-columns:216px 1fr}.side{border-right:1px solid var(--line);padding:30px 18px;position:sticky;top:0;height:100vh;background:rgba(4,18,33,.72);backdrop-filter:blur(18px)}
      .brand{font-size:28px;letter-spacing:.22em;margin:0 8px 36px}.brand small{display:block;color:var(--lime);font-size:9px;letter-spacing:.2em;margin-top:-2px}.nav{display:grid;gap:8px}.nav a{color:var(--muted);text-decoration:none;padding:12px 14px;border-radius:10px}.nav a.on{color:var(--lime);background:#142a40;border-left:3px solid var(--lime)}.nav a:hover{color:white;background:#10263d}.side-foot{position:absolute;bottom:24px;left:26px;color:#6f8498;font-size:12px}
      main{min-width:0}.top{height:82px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 36px;gap:20px}.search{border:1px solid var(--line);background:#0d2034;border-radius:10px;padding:12px 16px;color:var(--muted);width:min(440px,50vw)}.top-actions{display:flex;gap:10px;align-items:center}.btn{border:1px solid var(--line);background:#0d2034;color:var(--text);border-radius:10px;padding:10px 14px;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:7px}.btn:hover{border-color:#557088}.btn.primary{background:var(--lime);border-color:var(--lime);color:#071526;font-weight:750}.btn.small{padding:7px 10px;font-size:13px}.content{max-width:1460px;margin:auto;padding:34px 38px 64px}.eyebrow{color:var(--lime);text-transform:uppercase;letter-spacing:.12em;font-size:12px;font-weight:750}.head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:25px}.head h1{font-size:38px;line-height:1;margin:7px 0 8px}.head p{margin:0;color:var(--muted)}
      .summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:24px}.metric{background:linear-gradient(145deg,rgba(16,38,61,.96),rgba(9,28,47,.96));border:1px solid var(--line);border-radius:14px;padding:18px}.metric span{color:var(--muted);font-size:13px}.metric strong{display:block;font-size:26px;margin-top:4px}.metric.attn strong{color:var(--amber)}
      .layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.65fr);gap:18px}.panel{background:rgba(11,30,50,.9);border:1px solid var(--line);border-radius:15px;overflow:hidden}.panel-head{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px}.panel-head h2{font-size:18px;margin:0}.panel-head span{color:var(--muted);font-size:13px}.filters{display:flex;gap:7px;flex-wrap:wrap}.chip{border:1px solid var(--line);color:var(--muted);background:transparent;border-radius:999px;padding:6px 10px}.chip.on{background:rgba(217,251,53,.13);border-color:var(--lime);color:var(--lime)}
      .decisions{padding:8px}.decision{display:grid;grid-template-columns:5px minmax(0,1fr) auto;gap:14px;align-items:center;padding:14px 12px;border-radius:11px}.decision:hover{background:#10263d}.bar{align-self:stretch;border-radius:5px;background:var(--amber)}.decision.red .bar{background:var(--red)}.decision.blue .bar{background:var(--blue)}.decision.green .bar{background:var(--green)}.who{display:flex;align-items:center;gap:10px;margin-bottom:4px}.kind{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}.who b{font-size:15px}.copy{color:var(--muted);font-size:13px}.copy em{font-style:normal;color:var(--amber)}.decision-actions{text-align:right;display:flex;align-items:center;gap:10px}.money{white-space:nowrap;font-weight:750}.empty,.loading,.error{padding:34px 20px;text-align:center;color:var(--muted)}.error{color:#ffaaa7}.more{display:block;width:calc(100% - 16px);margin:4px 8px 10px;border:0;background:transparent;color:var(--muted);padding:10px}.more:hover{color:white}
      .right{display:grid;gap:18px;align-content:start}.agenda{padding:8px 18px 16px}.agenda-item{display:grid;grid-template-columns:52px 1fr;gap:12px;padding:12px 0;border-bottom:1px solid rgba(37,60,82,.7)}.agenda-item:last-child{border:0}.time{color:var(--lime);font-weight:750}.agenda-item b{display:block}.agenda-item small{color:var(--muted)}.signal{padding:15px 18px;border-bottom:1px solid rgba(37,60,82,.7)}.signal:last-child{border:0}.signal b{display:block}.signal small{color:var(--muted)}.notice{margin-top:18px;border:1px dashed #3b556e;border-radius:12px;color:var(--muted);padding:13px 16px;font-size:13px}.notice b{color:var(--text)}
      .skeleton{height:64px;margin:8px;border-radius:10px;background:linear-gradient(90deg,#10263d,#17334e,#10263d);background-size:200% 100%;animation:p 1.4s infinite}@keyframes p{to{background-position:-200% 0}}
      @media(max-width:980px){.shell{grid-template-columns:1fr}.side{display:none}.layout{grid-template-columns:1fr}.summary{grid-template-columns:repeat(2,1fr)}.top{padding:0 18px}.content{padding:25px 18px 55px}}
      @media(max-width:600px){.summary{grid-template-columns:1fr 1fr}.head{align-items:start}.head h1{font-size:32px}.top .search{display:none}.top{height:66px}.content{padding-top:22px}.decision{grid-template-columns:4px 1fr}.decision-actions{grid-column:2;justify-content:space-between}.panel-head{align-items:flex-start;flex-direction:column}.metric{padding:14px}.metric strong{font-size:21px}}
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="side">
        <div class="brand">VIVEN<small>FILM PRODUCTION</small></div>
        <nav class="nav" aria-label="Navegación">
          <a class="on" href="/dashboard-v2/">◎ Hoy 2</a>
          <a href="/dashboard-v2/ventas/">Ventas</a>
          <a href="/dashboard-v2/proyectos/">Proyectos</a>
          <a href="/dashboard-v2/personas/">Personas</a>
          <a href="/dashboard-v2/empresas/">Empresas</a>
          <a href="/dashboard-v2/tecnicos/">Técnicos</a>
          <a href="/dashboard-v2/agenda/">Agenda</a>
          <a href="/dashboard-v2/analytics/">Analytics</a>
          <a href="/dashboard-v2/contenido/">Contenido</a>
          <a href="/dashboard-v2/automatizaciones/">Automatizaciones</a>
          <a href="/dashboard-v2/sistema/">Sistema</a>
        </nav>
        <div class="side-foot">Vista paralela · no reemplaza el dashboard actual</div>
      </aside>
      <main>
        <header class="top">
          <div class="search">⌕ Buscar en Viven… <span style="float:right">⌘ K</span></div>
          <div class="top-actions">
            <button class="btn" id="refresh" type="button">↻ Actualizar</button>
            <a class="btn primary" href="/dashboard/?tab=leads">＋ Crear</a>
          </div>
        </header>
        <div class="content">
          <div class="head">
            <div><div class="eyebrow">Centro de decisiones</div><h1>Hoy</h1><p id="hello">Lo importante, ordenado para actuar.</p></div>
            <a class="btn" href="/dashboard/">Volver a la versión actual</a>
          </div>
          <section class="summary" aria-label="Resumen">
            <div class="metric attn"><span>Requieren decisión</span><strong id="m-total">—</strong></div>
            <div class="metric"><span>Leads sin contactar</span><strong id="m-leads">—</strong></div>
            <div class="metric"><span>Propuestas pendientes</span><strong id="m-props">—</strong></div>
            <div class="metric"><span>Proyectos bloqueados</span><strong id="m-projects">—</strong></div>
          </section>
          <div class="layout">
            <section class="panel">
              <div class="panel-head"><div><h2>Decisiones</h2><span id="updated">Cargando datos reales…</span></div><div class="filters" id="filters"><button class="chip on" data-filter="all">Todas</button><button class="chip" data-filter="lead">Leads</button><button class="chip" data-filter="proposal">Propuestas</button><button class="chip" data-filter="project">Proyectos</button></div></div>
              <div id="decisions" class="decisions"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></div>
            </section>
            <aside class="right">
              <section class="panel"><div class="panel-head"><h2>Próximas 24 horas</h2><span id="agenda-count"></span></div><div class="agenda" id="agenda"><div class="loading">Cargando agenda…</div></div></section>
              <section class="panel"><div class="panel-head"><h2>Señales recientes</h2><span>últimas 48 h</span></div><div id="signals"><div class="loading">Buscando actividad…</div></div></section>
            </aside>
          </div>
          <div class="notice"><b>Modo seguro:</b> esta pantalla todavía no escribe en la base. “Follow-up con IA” y las demás acciones abren el contacto en el dashboard actual, donde siguen funcionando el historial, el borrador, el envío y los controles existentes.</div>
        </div>
      </main>
    </div>

    <script>
      import { createClient } from '@supabase/supabase-js';
      const db = createClient('https://lumoevaotokgqnpybkyf.supabase.co','sb_publishable_ORGL5_FNZTXcGKwvjs-ymw_Y8DV_4ca');
      const $ = (id) => document.getElementById(id);
      const esc = (s) => String(s ?? '').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const days = (iso) => Math.max(0, Math.floor((Date.now()-Date.parse(iso||new Date()))/864e5));
      const money = (n) => n ? new Intl.NumberFormat('de-CH',{style:'currency',currency:'CHF',maximumFractionDigits:0}).format(Number(n)) : '';
      const leadUrl = (id) => '/dashboard/?lead=' + encodeURIComponent(id);
      let rows = [], filter = 'all', expanded = false;

      function valueOf(x){ return Number(x.total_net ?? x.net_total ?? x.value ?? x.amount ?? x.budget ?? 0) || 0; }
      function leadName(leads,id,fallback=''){ const l=leads.find(x=>String(x.id)===String(id)); return l?.company || l?.name || l?.email || fallback || 'Sin contacto'; }
      function projectProblem(p){
        if(p.stage==='entregado') return '';
        const age=days(p.started_at);
        if(p.delivery_due&&p.delivery_due<new Date().toISOString().slice(0,10)) return 'La fecha de entrega ya venció';
        if(!p.shoot_start&&age>14) return age+' días sin fecha de rodaje';
        const soon=p.shoot_start&&Date.parse(p.shoot_start+'T23:59:59')>Date.now()-864e5&&Date.parse(p.shoot_start+'T00:00:00')<Date.now()+5*864e5;
        if(soon&&!String(p.location||'').trim()) return 'Rodaje próximo sin locación';
        return '';
      }
      function render(){
        const visible=rows.filter(r=>filter==='all'||r.type===filter);
        const shown=expanded?visible:visible.slice(0,7);
        $('decisions').innerHTML = shown.length ? shown.map((r)=>`<article class="decision ${r.sev}"><span class="bar"></span><div><div class="who"><span class="kind">${esc(r.kind)}</span><b>${esc(r.title)}</b></div><div class="copy">${esc(r.copy)} ${r.age!=null?`· <em>${r.age} días</em>`:''}</div></div><div class="decision-actions">${r.value?`<span class="money">${money(r.value)}</span>`:''}<a class="btn small ${r.primary?'primary':''}" href="${r.href}">${esc(r.action)}</a></div></article>`).join('') : '<div class="empty">No hay decisiones en esta categoría.</div>';
        if(visible.length>7&&!expanded) $('decisions').insertAdjacentHTML('beforeend',`<button class="more" id="more">Ver las otras ${visible.length-7} →</button>`);
        $('more')?.addEventListener('click',()=>{expanded=true;render();});
      }
      async function load(){
        $('updated').textContent='Actualizando…';
        const {data:{session}}=await db.auth.getSession();
        if(!session){ location.replace('/dashboard/'); return; }
        const email=session.user?.email||'';
        $('hello').textContent='Hola' + (email?' '+email.split('@')[0]:'') + '. Esto es lo que necesita una decisión.';
        const now=new Date().toISOString(), future=new Date(Date.now()+24*864e5).toISOString();
        const [lq,pq,prq,bq,oq]=await Promise.all([
          db.from('leads').select('*').order('created_at',{ascending:false}).limit(1000),
          db.from('proposals').select('*').order('updated_at',{ascending:false}).limit(1000),
          db.from('projects').select('*').eq('archived',false).order('started_at',{ascending:false}).limit(1000),
          db.from('bookings').select('*').eq('status','confirmed').gte('start_at',now).lte('start_at',future).order('start_at').limit(20),
          db.from('offers').select('*').order('updated_at',{ascending:false}).limit(1000)
        ]);
        const err=[lq,pq,prq,bq,oq].find(q=>q.error)?.error;
        if(err){ $('decisions').innerHTML='<div class="error">No se pudieron cargar los datos. Abrí la versión actual o probá Actualizar.</div>'; $('updated').textContent=err.message; return; }
        const leads=(lq.data||[]).filter(l=>!l.es_prueba), props=(pq.data||[]).filter(p=>!p.archived&&!p.is_template), projects=(prq.data||[]).filter(p=>!p.es_prueba), offers=(oq.data||[]).filter(o=>!o.archived&&!o.is_template);
        const leadRows=leads.filter(l=>!/^claude-/.test(l.session_id||'')&&l.channel!=='manual'&&['new','nuevo','lead'].includes(String(l.status||'').toLowerCase())&&Date.now()-Date.parse(l.created_at)<72*36e5).map(l=>({type:'lead',kind:'Lead nuevo',title:l.company||l.name||l.email||'Sin nombre',copy:'Esperando primera respuesta',age:days(l.created_at),sev:'blue',value:0,primary:true,action:'Follow-up con IA',href:leadUrl(l.id)}));
        const propRows=props.filter(p=>p.status==='sent'&&days(p.published_at||p.updated_at)>2).map(p=>({type:'proposal',kind:'Propuesta',title:p.title||'Propuesta sin título',copy:leadName(leads,p.lead_id)+(p.last_view_at?' · vista por el cliente':' · todavía sin vistas'),age:days(p.published_at||p.updated_at),sev:days(p.published_at||p.updated_at)>8?'red':'',value:valueOf(p),primary:days(p.published_at||p.updated_at)>8,action:'Follow-up con IA',href:p.lead_id?leadUrl(p.lead_id):'/dashboard/?tab=offers'}));
        const projectRows=projects.map(p=>({p,problem:projectProblem(p)})).filter(x=>x.problem).map(({p,problem})=>({type:'project',kind:'Proyecto bloqueado',title:p.title||p.name||p.ref||'Proyecto',copy:problem,age:null,sev:'red',value:Number(p.amount_chf)||0,primary:false,action:'Resolver',href:'/dashboard/?proyecto='+encodeURIComponent(p.ref||p.id)}));
        rows=[...leadRows,...propRows,...projectRows].sort((a,b)=>(b.primary-a.primary)||(b.value-a.value)||(b.age-a.age));
        $('m-leads').textContent=leadRows.length; $('m-props').textContent=propRows.length; $('m-projects').textContent=projectRows.length; $('m-total').textContent=rows.length;
        $('updated').textContent='Actualizado '+new Date().toLocaleTimeString('es-CH',{hour:'2-digit',minute:'2-digit'}); render();
        const bookings=(bq.data||[]).filter(b=>!b.es_prueba&&( !b.host_email || b.host_email.toLowerCase()===email.toLowerCase()));
        $('agenda-count').textContent=bookings.length?bookings.length+' reuniones':'';
        $('agenda').innerHTML=bookings.length?bookings.map(b=>{const d=new Date(b.start_at);return `<div class="agenda-item"><span class="time">${d.toLocaleTimeString('es-CH',{hour:'2-digit',minute:'2-digit'})}</span><div><b>${esc(b.name||b.email||'Video call')}</b><small>${esc(b.duration_m||15)} min${b.meet_url?' · Google Meet':''}</small></div></div>`}).join(''):'<div class="empty">No hay reuniones en las próximas 24 horas.</div>';
        const signals=[...props.filter(p=>p.last_view_at&&Date.now()-Date.parse(p.last_view_at)<48*36e5).map(p=>({at:p.last_view_at,t:leadName(leads,p.lead_id)+' abrió la propuesta',s:p.title||'Propuesta',href:p.lead_id?leadUrl(p.lead_id):'/dashboard/?tab=offers'})),...offers.filter(o=>o.last_open_at&&Date.now()-Date.parse(o.last_open_at)<48*36e5).map(o=>({at:o.last_open_at,t:leadName(leads,o.lead_id,o.client)+' abrió la oferta',s:o.title||o.number||'Oferta',href:o.lead_id?leadUrl(o.lead_id):'/dashboard/?tab=offers'}))].sort((a,b)=>Date.parse(b.at)-Date.parse(a.at)).slice(0,5);
        $('signals').innerHTML=signals.length?signals.map(s=>`<a class="signal" style="display:block;color:inherit;text-decoration:none" href="${s.href}"><b>${esc(s.t)}</b><small>${esc(s.s)} · hace ${days(s.at)||'menos de 1'} día${days(s.at)===1?'':'s'}</small></a>`).join(''):'<div class="empty">Sin aperturas recientes.</div>';
      }
      $('filters').addEventListener('click',(e)=>{const b=e.target.closest('[data-filter]');if(!b)return;filter=b.dataset.filter;expanded=false;document.querySelectorAll('.chip').forEach(x=>x.classList.toggle('on',x===b));render();});
      $('refresh').addEventListener('click',load);
      document.addEventListener('keydown',(e)=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();location.href='/dashboard/';}});
      load();
    </script>
  </body>
</html>
