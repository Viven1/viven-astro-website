rgin:0 0 24px;color:var(--muted);font-size:18px}.card{border:1px solid var(--line);border-radius:12px;background:rgba(8,27,46,.86);overflow:hidden}.cardhead{height:63px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;border-bottom:1px solid var(--line)}.cardhead h2{font-size:19px}.tabs{display:flex}.tabs button{height:38px;min-width:125px;background:transparent;border:1px solid var(--line);color:var(--muted);font-size:15px}.tabs button.on{color:white;border-color:var(--lime)}.badge{display:inline-grid;place-items:center;min-width:25px;height:25px;border-radius:50%;background:#27394b;margin-left:6px;font-size:12px}.on .badge{background:var(--lime);color:#0b1824}.decision{min-height:69px;padding:10px 28px;display:grid;grid-template-columns:46px minmax(260px,1fr) 180px minmax(270px,auto) 28px;gap:18px;align-items:center;border-bottom:1px solid var(--line)}.decision:last-child{border:0}.ico{width:45px;height:45px;border:1px solid #66811e;border-radius:50%;display:grid;place-items:center;color:var(--lime);font-size:21px}.ico.amber{color:var(--amber);border-color:#a66c0e}.who b{font-size:16px}.who span,.status{color:var(--muted)}.dot{display:inline-block;width:11px;height:11px;background:var(--amber);border-radius:50%;margin-right:10px}.amount{font-size:17px}.actions{display:flex;justify-content:flex-end;gap:10px;align-items:center}.btn{border:1px solid var(--line);background:#0c2035;color:white;border-radius:8px;padding:10px 18px;text-decoration:none;white-space:nowrap}.btn.lime{background:var(--lime);border-color:var(--lime);color:#071421;font-weight:700}.draft{border:1px solid #42576e;border-radius:8px;padding:8px 12px;min-width:310px;font-size:13px}.draft small{display:block;color:#bbc4cf}.dots{color:var(--muted);font-weight:900}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:16px}.metric{border:1px solid var(--line);border-radius:11px;padding:21px 26px;background:rgba(8,27,46,.86)}.metric span{color:var(--mut