  function magnetsDraftPreview(draft){
    return (draft.sections || []).map((s) => '<h4>' + esc(s.heading || '') + '</h4>' +
      (s.kind === 'checklist' && Array.isArray(s.items)
        ? '<ul>' + s.items.map((it) => '<li>' + esc(it) + '</li>').join('') + '</ul>'
