  /* ---------- 🔗 Fusionar dos contactos a mano (RPC fusionar_contactos, SQL 0143) ----------
     El de-duplicador automático solo agarra los que comparten email. La misma persona
     cargada dos veces con dos direcciones distintas —"MARTIN BABU" y "Martin Babu DJ",
     que el 25 ago aparecían en Hoy como dos tareas idénticas— no la agarra nadie,
     porque no hay forma automática de saberlo sin equivocarse. Esto lo decide él.
     Se muda TODO lo que cuelga (deals, ofertas, propuestas, notas, tareas, emails) al
     que queda; los campos vacíos del que queda se completan con los del otro, y nunca
     se pisa un dato bueno. La fila vacía se borra recién al final. */
  $('ps-merge') && $('ps-merge').addEventListener('click', async () => {
    const ids = [...psSelected]; if (ids.length !== 2) return;
    const a = leadById(ids[0]) || {}, b = leadById(ids[1]) || {};
    const quien = (l) => (l.name || l.email || ('#' + l.id)) + (l.email && l.name ? ' · ' + l.email : '');
    /* Por defecto queda el MÁS VIEJO: es al que apuntan los links que ya se mandaron
       y el que tiene la fecha de alta verdadera. El botón deja invertirlo. */
    let queda = a, absorbido = b;
    if (Date.parse(b.created_at || 0) < Date.parse(a.created_at || 0)){ queda = b; absorbido = a; }
    const contar = (l) => {
      const d = dealsForLead(l.id).length;
      const o = (offersList || []).filter((x) => String(x.lead_id || '') === String(l.id) && !x.archived).length;
      const p = (propsAll || []).filter((x) => String(x.lead_id || '') === String(l.id) && !x.archived).length;
      const partes = [];
      if (d) partes.push(d + (d === 1 ? ' deal' : ' deals'));
      if (o) partes.push(o + (o === 1 ? ' oferta' : ' ofertas'));
      if (p) partes.push(p + (p === 1 ? ' propuesta' : ' propuestas'));
      return partes.length ? partes.join(', ') : 'sin nada colgando';
    };
    const invertir = confirm(
      'FUSIONAR DOS CONTACTOS\n\n' +
      'Queda:      ' + quien(queda) + '\n            (' + contar(queda) + ', alta ' + new Date(queda.created_at).toLocaleDateString('es-CH') + ')\n\n' +
      'Se absorbe: ' + quien(absorbido) + '\n            (' + contar(absorbido) + ', alta ' + new Date(absorbido.created_at).toLocaleDateString('es-CH') + ')\n\n' +
      'Todo lo que cuelga del segundo pasa al primero. No se pierde nada: los campos vacíos se completan y los mensajes se pegan uno abajo del otro.\n\n' +
      'Aceptar = fusionar así.\nCancelar = elegir al revés (o salir).');
    if (!invertir){
      const alReves = confirm('¿Fusionar AL REVÉS?\n\nQueda: ' + quien(absorbido) + '\nSe absorbe: ' + quien(queda) + '\n\nCancelar para no hacer nada.');
      if (!alReves) return;
      const t = queda; queda = absorbido; absorbido = t;
    }
    const btn = $('ps-merge'); btn.disabled = true;
    try {
      const { data, error } = await supabase.rpc('fusionar_contactos', { p_queda: +queda.id, p_absorbido: +absorbido.id });
      if (error) throw error;
      if (!data || !data.ok) throw new Error((data && data.error) || 'no se pudo');
      toast('🔗 Fusionados — ' + (data.movidas || 0) + ' cosas mudadas a ' + (queda.name || queda.email));
      psSelected.clear(); updatePsDelBtn();
      await loadAll();
      openLead(queda.id);   // que se vea el resultado, no que haya que ir a buscarlo
    } catch (e) {
      alert('No se pudo fusionar: ' + (e.message || e));
    } finally { btn.disabled = false; }
  });
  $('ps-mark-spam') && $('ps-mark-spam').addEventListener('click', async () => {
