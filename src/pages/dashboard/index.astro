  const PS_EN_JUEGO = ['nuevo', 'contactado', 'videocall', 'propuesta'];
  let psSeg = 'juego';
  function psSegMatch(r){
    if (psSeg === 'pruebas') return true;   // esa lista ya viene filtrada aparte
