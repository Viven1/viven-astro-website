  // borradores pendientes/aprobados de ESTE lead — misma tabla/lógica que la
  // Bandeja de salida (obLoad), pero visible directo en la ficha del contacto.
  async function lm2LoadPendingOutbox(r){
    const box = $('lm2-ob'); if (!box) return;
    try {
      const { data, error } = await supabase.from('outbox').select('*').eq('lead_id', r.id).in('status', ['pending', 'approved']).order('created_at');
      if (error || !data || !data.length){ box.hidden = true; box.innerHTML = ''; return; }
      const KIND_LBL = { followup: '📬 Follow-up', content_followup: '🎯 Contenido', reactivation: '♻️ Reactivación', workflow: '⚙️ Workflow' };
      /* Antes decía siempre «sale en 10 min», que es falso: los content_followup
         tienen fecha propia y pueden salir dentro de días. Ahora dice cuándo sale
         de verdad, leyendo scheduled_at. (Reporte de Sebastián, 11 ago 2026.) */
      const obCuando = (o) => {
        if (!o.scheduled_at) return ' · sale en ~10 min';
        const d = new Date(o.scheduled_at); if (isNaN(d)) return ' · sale en ~10 min';
        const min = Math.round((d - new Date()) / 60000);
        if (min <= 1) return ' · sale ya';
        if (min < 60) return ' · sale en ' + min + ' min';
        /* SIEMPRE en hora de Zúrich, no la del dispositivo. El envío se rige por
           el horario laboral suizo, así que mostrar la hora local del teléfono es
           informar otra cosa: un envío a las 12:40 de Zúrich se leía como "07:40"
           desde Argentina y parecía de madrugada. (Sebastián, 11 ago 2026.) */
        const ZH = { timeZone: 'Europe/Zurich' };
        const hhmm = d.toLocaleTimeString('es-CH', { ...ZH, hour: '2-digit', minute: '2-digit' });
        const diaZH = (x) => x.toLocaleDateString('en-CA', ZH);   // AAAA-MM-DD en Zúrich
        const hoy = new Date();
        if (diaZH(d) === diaZH(hoy)) return ' · sale hoy ' + hhmm;
        if (diaZH(d) === diaZH(new Date(hoy.getTime() + 86400000))) return ' · sale mañana ' + hhmm;
        return ' · sale el ' + d.toLocaleDateString('es-CH', { ...ZH, day: '2-digit', month: 'short' }) + ', ' + hhmm;
      };
      /* «¿cómo pueden salir dos al mismo tiempo?» — no salen juntos: son pasos
         de UNA secuencia, que se crean de una para poder aprobarlos todos
         juntos. Sin el número de paso parecían dos emails sueltos al mismo
         lead. La Bandeja ya lo mostraba; faltaba acá. (Sebastián, 11 ago 2026.) */
      const obPaso = (o) => (o.kind === 'content_followup' && o.step) ? ' · paso ' + o.step : '';
      box.hidden = false;
      box.innerHTML = data.map((o) => {
        const approved = o.status === 'approved';
        return '<div class="lm2-ob-card" data-obid="' + o.id + '">' +
          '<div class="lm2-ob-hd"><b>' + (KIND_LBL[o.kind] || '📤 Borrador') + obPaso(o) + (approved ? obCuando(o) : ' · para aprobar') + '</b>' +
          '<button class="btn btn-ghost small" data-obedit="' + o.id + '" type="button">✏️ Editar en Bandeja</button></div>' +
          '<div class="lm2-ob-subj">' + esc(o.subject || '') + '</div>' +
          '<div class="lm2-ob-body">' + esc((o.kind === 'content_followup' ? obHtmlToPreviewText(o.body) : String(o.body || '')).slice(0, 240)) + '</div>' +
          '<div class="lm2-ob-btns">' +
          (approved
