          (!b.bexio_id && b.gross != null ? '<button class="btn btn-primary small" data-bexio="' + b.id + '" type="button">🧾 Mandar a bexio</button>' : '') +
          '<button class="pj-crew-x" data-quitar="' + b.id + '" type="button" title="Quitar del proyecto">✕</button>' +
