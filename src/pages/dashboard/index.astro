  // cierra el editor y SIEMPRE limpia el estado de textarea-en-pantalla-completa
  // (⤢ Expandir) — sin esto, cerrar/guardar/borrar con un campo expandido dejaba
  // todo el dashboard sin poder scrollear hasta recargar la página
  function auCloseEditor(){ $('au-editor').hidden = true; document.body.classList.remove('au-fs-open'); }
  function auOpen(id){
    document.body.classList.remove('au-fs-open');
    const a = id ? auList.find((x) => x.id === id) : null;
    auCur = a || null;
    $('au-ed-title').textContent = a ? '✏️ ' + a.name : 'Nuevo workflow';
    $('au-name').value = a ? a.name : '';
    $('au-enabled').value = a && a.enabled ? '1' : '';
