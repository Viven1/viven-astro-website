    const rows = licList.filter(licMatch);
    if (!rows.length){ box.innerHTML = '<p class="muted-note">Sin licencias en este filtro.</p>'; return; }
    box.innerHTML = rows.map((l) => {
      const lead = l.lead_id ? leadById(l.lead_id) : null;
      const statusLbl = { renewed: '✅ Renovada', expired: '⏹ Vencida', cancelled: '🚫 Cancelada' }[l.status] || '';
      const sub = (l.amount ? licCHF(l.amount) + '/mes · ' : '') + (l.start_date ? 'desde ' + esc(l.start_date) + ' · ' : '') +
        'renueva ' + esc(l.renewal_date || '—') + (lead ? ' · ' + esc(lead.name || lead.email) : '');
      const actions = l.status === 'active'
        ? '<button class="of-act lic-pri" data-act="genoffer" type="button">🧾 Generar oferta de renovación</button>' +
          '<button class="of-act" data-act="renew" type="button">📅 Cambiar fecha</button>' +
          '<button class="of-act" data-act="edit" type="button">✏️ Editar</button>' +
          '<button class="of-act danger" data-act="cancel" type="button">🚫 Cancelar</button>' +
          '<button class="of-act danger" data-act="del" type="button">🗑 Borrar</button>'
