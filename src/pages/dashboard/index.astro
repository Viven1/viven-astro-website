  /* ================= WEB PUSH: notificaciones reales al celular ================= */
  const VAPID_PUB = 'BPZuJFhqNy9HDHDi0MzPh_DklooKyOUHInq7rfyqKIWXWMe6yShB1xCiQSJfOWUzaMhFT4NMwv3B_rwVPal-hyg';
  function b64ToU8(s){ const pad = '='.repeat((4 - s.length % 4) % 4); const b = atob((s + pad).replace(/-/g, '+').replace(/_/g, '/')); return Uint8Array.from([...b].map((c) => c.charCodeAt(0))); }
  function pushSupported(){ return 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window; }
  // versión del build visible en el sheet Más — para diagnosticar apps con código viejo
  const BUILD_VER = document.lastModified ? new Date(document.lastModified).toLocaleString('es-CH', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
  const mv = $('mob-ver'); if (mv && BUILD_VER) mv.textContent = 'build ' + BUILD_VER;
  // registrar el SW siempre (no solo al activar push): así la PWA instala y cachea el shell.
  // Update UX: el SW ya hace skipWaiting()+clients.claim() apenas instala una versión nueva,
  // así que 'controllerchange' es la señal confiable de "ya hay código nuevo corriendo, pero
  // esta pestaña sigue con el JS viejo en memoria" → mostramos el botón, nunca recargamos solos
  // (podrías estar escribiendo un email sin guardar). iOS puede tener la app abierta horas sin
  // re-chequear por su cuenta, así que forzamos reg.update() cada 5 min y al volver a la app.
  if ('serviceWorker' in navigator) {
    // 'controllerchange' también dispara en la primerísima instalación (sin
    // controller previo → nuevo controller), lo que mostraría "hay una versión
    // nueva" a alguien que recién instaló la app por primera vez. Solo es un
    // update real si YA había un controller activo antes de este page load.
    const hadController = !!navigator.serviceWorker.controller;
    navigator.serviceWorker.register('/dashboard-sw.js', { scope: '/dashboard/' }).then((reg) => {
      setInterval(() => reg.update().catch(() => {}), 5 * 60 * 1000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) reg.update().catch(() => {}); });
    }).catch(() => {});
    navigator.serviceWorker.addEventListener('controllerchange', () => {
      if (!hadController) return;
      const b = $('app-update-btn'); if (b) b.hidden = false;
    });
  }
  $('app-update-btn') && $('app-update-btn').addEventListener('click', () => location.reload());
  /* Estado real de push, en cada carga. Antes esto solo cambiaba el texto de un botón
     escondido en el panel de la campana: si la suscripción desaparecía (Chrome las rota,
     un perfil nuevo, o el servidor la borró tras un 410), quedaba permiso concedido +
     cero suscripción = ningún aviso y ninguna señal. Sebastián perdió leads así.
     Ahora: si el permiso YA está concedido, se vuelve a suscribir solo (no hace falta
     preguntar nada, el permiso está dado), se re-guarda siempre en la base — así una
     suscripción borrada del servidor vuelve sola — y si aun así no hay, se enciende un
     aviso VISIBLE en el header. */
  async function refreshPushBtn(){
    const btn = $('bell-push'), warn = $('push-warn');
    const sinPush = (motivo) => { if (warn){ warn.hidden = false; warn.title = motivo; } };
    // app nativa del iPhone: los avisos van por APNs y el token ya se registró
    if (window.__apnsOk){
      if (btn) btn.textContent = '📲 Avisos por la app ✓';
      if (warn) warn.hidden = true;
      return;
    }
    if (!pushSupported()){
      if (btn){ btn.textContent = '📲 Push no disponible'; btn.title = 'En iPhone: instalá la app (Compartir → Añadir a pantalla de inicio) y abrila desde el ícono'; }
      sinPush('Este navegador no soporta notificaciones. En iPhone: instalá la app desde Compartir → Añadir a inicio.');
      return;
    }
    try {
      const reg = await navigator.serviceWorker.getRegistration('/dashboard/')
        || await navigator.serviceWorker.register('/dashboard-sw.js', { scope: '/dashboard/' });
      let sub = await reg.pushManager.getSubscription();
      if (!sub && Notification.permission === 'granted'){
        // permiso ya dado: re-suscribir en silencio, sin molestar
        try { sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64ToU8(VAPID_PUB) }); }
        catch (e) { /* si el navegador se niega, cae al aviso de abajo */ }
      }
      if (sub){
        const j = sub.toJSON();
        if (meEmail){
          const { error } = await supabase.from('push_subscriptions').upsert(
            { endpoint: sub.endpoint, p256dh: j.keys.p256dh, auth: j.keys.auth, user_email: meEmail }, { onConflict: 'endpoint' });
          if (error){ sinPush('La suscripción no se pudo guardar: ' + error.message); return; }
        }
        if (btn) btn.textContent = '📲 Push activado ✓';
        if (warn) warn.hidden = true;
      } else {
        sinPush(Notification.permission === 'denied'
          ? 'Bloqueaste las notificaciones para este sitio — hay que permitirlas en el candado de la barra de direcciones.'
          : 'No estás recibiendo notificaciones en este dispositivo — tocá para activarlas.');
      }
    } catch (e) { sinPush('No se pudo verificar el estado de las notificaciones: ' + (e.message || e)); }
  }
  async function enablePush(){
    if (!pushSupported()){ toast('Este navegador no soporta push. En iPhone: instalá la app (Compartir → Añadir a inicio) y abrila desde el ícono.'); return; }
    try {
      const reg = await navigator.serviceWorker.register('/dashboard-sw.js', { scope: '/dashboard/' });
      const perm = await Notification.requestPermission();
      if (perm !== 'granted'){ toast('Permiso de notificaciones denegado'); return; }
      const sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64ToU8(VAPID_PUB) });
      const j = sub.toJSON();
      const { error } = await supabase.from('push_subscriptions').upsert(
        { endpoint: sub.endpoint, p256dh: j.keys.p256dh, auth: j.keys.auth, user_email: meEmail || null }, { onConflict: 'endpoint' });
      if (error){ toast('No se pudo guardar (¿SQL 0015?): ' + error.message); return; }
      $('bell-push').textContent = '📲 Push activado ✓';
      if ($('push-warn')) $('push-warn').hidden = true;
      toast('📲 Push activado — este dispositivo recibe leads, menciones y tasks');
    } catch (e){ toast('No se pudo activar push: ' + (e.message || e)); }
  }
