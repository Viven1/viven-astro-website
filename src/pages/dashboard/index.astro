    const SIGN = { de: 'Herzliche Grüsse\n' + me + ' · VIVEN AG', en: 'Best,\n' + me + ' · VIVEN AG', es: 'Saludos,\n' + me + ' · VIVEN AG' };
    const NOTE = {
      de: 'Hallo ' + (first || client) + '\n\nVielen Dank für Ihr Vertrauen — hier ist unsere Offerte für «' + title + '».\n\nDarin enthalten: ' + (top3 || 'alle Details unten') + '. Das Total liegt bei ' + gross + ' inkl. MwSt.\n\nWir haben Filme für UBS, Siemens, Porsche und ON produziert — und bringen dieselbe Qualität in Ihr Projekt.\n\nFragen oder Anpassungen? Buchen Sie direkt einen kurzen Call (Button unten) oder antworten Sie einfach auf dieses Mail.\n\nHerzliche Grüsse\n' + me + ' · VIVEN AG',
      en: 'Hi ' + (first || client) + '\n\nThank you for your trust — here is our offer for "' + title + '".\n\nIt includes: ' + (top3 || 'full details below') + '. The total comes to ' + gross + ' incl. VAT.\n\nWe\'ve produced films for UBS, Siemens, Porsche and ON — and we bring that same quality to your project.\n\nQuestions or adjustments? Book a quick call below, or simply reply to this email.\n\nBest,\n' + me + ' · VIVEN AG',
      es: 'Hola ' + (first || client) + ':\n\nGracias por tu confianza — acá está nuestra oferta para «' + title + '».\n\nIncluye: ' + (top3 || 'todos los detalles abajo') + '. El total es ' + gross + ' IVA incl.\n\nHemos producido videos para UBS, Siemens, Porsche y ON — y llevamos esa misma calidad a tu proyecto.\n\n¿Dudas o ajustes? Agendá un call corto abajo, o respondé este mail.\n\nSaludos,\n' + me + ' · VIVEN AG'
    };
