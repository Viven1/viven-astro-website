  /* ---------- Insights con IA (Edge Function ai-insights → Claude) ---------- */
  // genérico: se usa en Analytics, Leads y Ofertas con distintos resúmenes
  async function runInsights(btnId, bodyId, buildSummary, loadingMsg){
    const btn = $(btnId), body = $(bodyId);
    const summary = buildSummary();
    if (!summary) { body.innerHTML = '<p class="muted-note">Todavía no hay datos suficientes.</p>'; return; }
    const prev = btn.textContent; btn.disabled = true; btn.textContent = '✨ Analizando…';
    body.innerHTML = '<p class="ai-loading">' + (loadingMsg || 'La IA está analizando tus datos…') + '</p>';
    try {
      const { data, error } = await supabase.functions.invoke('ai-insights', { body: { summary, lang: 'es' } });
      if (error || !data || !Array.isArray(data.insights)) throw new Error(data?.error || error?.message || 'sin respuesta');
      body.innerHTML = data.insights.map((i) =>
        '<div class="ai-insight"><span class="ico">' + esc(i.icon || '💡') + '</span>' +
        '<div class="txt"><h4>' + esc(i.title || '') + '</h4><p>' + esc(i.detail || '') + '</p></div></div>'
      ).join('') || '<p class="muted-note">La IA no devolvió sugerencias.</p>';
    } catch (e) {
      body.innerHTML = '<p class="muted-note">No se pudo generar (¿deployaste ai-insights y hay crédito en Anthropic?): ' + esc(e.message) + '</p>';
    } finally { btn.disabled = false; btn.textContent = prev; }
  }

  // resumen del funnel de leads (conversión + tiempos entre etapas)
  function leadsSummary(){
    const set = (allLeads || []).filter((l) => inRange(l.created_at) && !/^claude-/.test(l.session_id || ''));
    if (!set.length) return null;
    const steps = [
      { k: 'leads', ts: (l) => l.created_at }, { k: 'contactado', ts: (l) => l.contacted_at },
      { k: 'videocall', ts: (l) => l.videocall_at }, { k: 'propuesta', ts: (l) => l.proposal_at }, { k: 'ganado', ts: (l) => l.won_at },
    ];
    const counts = steps.map((s) => set.filter((l) => s.ts(l)).length);
    const avgDays = (a, b) => { const ds = set.map((l) => { const x = Date.parse(b(l)), y = Date.parse(a(l)); return (x && y && x >= y) ? (x - y) / 864e5 : null; }).filter((v) => v != null); return ds.length ? +(ds.reduce((p, c) => p + c, 0) / ds.length).toFixed(1) : null; };
    const chan = {}; set.forEach((l) => { const c = l.channel || 'direct'; chan[c] = (chan[c] || 0) + 1; });
    const lost = set.filter((l) => l.lost_at).length;
    return {
      contexto: 'Funnel de leads de Viven (productora de video). Conversión y días promedio entre etapas.',
      periodo: rangeLabel(),
      leads: counts[0], contactados: counts[1], video_calls: counts[2], propuestas: counts[3], ganados: counts[4], perdidos: lost,
      conv_lead_a_contactado_pct: counts[0] ? Math.round(counts[1] / counts[0] * 100) : 0,
      conv_contactado_a_videocall_pct: counts[1] ? Math.round(counts[2] / counts[1] * 100) : 0,
      conv_videocall_a_propuesta_pct: counts[2] ? Math.round(counts[3] / counts[2] * 100) : 0,
      conv_propuesta_a_ganado_pct: counts[3] ? Math.round(counts[4] / counts[3] * 100) : 0,
      cierre_ganado_sobre_decididos_pct: (counts[4] + lost) ? Math.round(counts[4] / (counts[4] + lost) * 100) : 0,
      dias_lead_a_contactado: avgDays((l) => l.created_at, (l) => l.contacted_at),
      dias_contactado_a_videocall: avgDays((l) => l.contacted_at, (l) => l.videocall_at),
      dias_videocall_a_propuesta: avgDays((l) => l.videocall_at, (l) => l.proposal_at),
      dias_propuesta_a_ganado: avgDays((l) => l.proposal_at, (l) => l.won_at),
      canales: chan,
      sin_contactar: set.filter((l) => isNew(l.status)).length,
    };
  }

  // resumen de ofertas (conversión, semanas para cerrar, margen)
  function offersSummary(){
    /* Sin las de prueba. Esto es lo que se le manda a la IA para que escriba las
       conclusiones: una oferta inventada le mueve la conversión, el ticket medio y el
       margen, y devuelve un consejo bien redactado sobre números que no pasaron. */
    const ofs = (offersList || []).filter((o) => !esDePrueba(o));
    if (!ofs.length) return null;
    const won = ofs.filter((o) => o.status === 'won'), lost = ofs.filter((o) => o.status === 'lost'), open = ofs.filter((o) => o.status === 'sent');
    const dec = won.length + lost.length;
    const margins = ofs.map(offerMarginPct).filter((m) => isFinite(m));
    const closeW = won.map((o) => (Date.parse(o.updated_at) - Date.parse(o.created_at)) / 6048e5).filter((d) => d >= 0);
    return {
      contexto: 'Ofertas/presupuestos de Viven (productora de video). Precio al cliente vs costo interno.',
      ofertas_totales: ofs.length, enviadas_esperando: open.length, ganadas: won.length, perdidas: lost.length,
      conversion_ganadas_sobre_decididas_pct: dec ? Math.round(won.length / dec * 100) : 0,
      semanas_promedio_para_cerrar: closeW.length ? +(closeW.reduce((a, b) => a + b, 0) / closeW.length).toFixed(1) : null,
      valor_ganado_neto_chf: Math.round(won.reduce((a, o) => a + offerNet(o), 0)),
      margen_medio_pct: margins.length ? Math.round(margins.reduce((a, b) => a + b, 0) / margins.length) : null,
      ticket_medio_ganado_chf: won.length ? Math.round(won.reduce((a, o) => a + offerNet(o), 0) / won.length) : null,
    };
  }

  /* Insights de Analytics: automáticos, 1 vez por día por navegador (cache en localStorage).
     El ↻ fuerza una regeneración; si el invoke falla, no se reintenta solo hasta recargar. */
  /* v2: hasta el 25 ago los insights se generaban sobre datos con bots adentro. El
     sufijo invalida ese cache de una vez, sin tener que borrarlo a mano. */
  const AI_AUTO_LS = 'vv_ai_insights_v2';
  let aiAutoTried = false;
  function renderAiCards(list){
    $('ai-insights-body').innerHTML = list.map((i) =>
      '<div class="ai-insight"><span class="ico">' + esc(i.icon || '💡') + '</span>' +
      '<div class="txt"><h4>' + esc(i.title || '') + '</h4><p>' + esc(i.detail || '') + '</p></div></div>'
    ).join('') || '<p class="muted-note">La IA no devolvió sugerencias.</p>';
  }
  async function autoInsights(force){
    const today = new Date().toISOString().slice(0, 10);
    // cache del día: render instantáneo, cero llamadas
    if (!force){
      try {
        const c = JSON.parse(localStorage.getItem(AI_AUTO_LS) || 'null');
        if (c && c.date === today && Array.isArray(c.insights)){ renderAiCards(c.insights); return; }
      } catch (e) { /* cache corrupto → regenerar */ }
      if (aiAutoTried) return; // ya falló hoy en esta sesión: no martillar la función
    }
    if (!insightsData) return;
    aiAutoTried = true;
    const btn = $('ai-insights-btn'), body = $('ai-insights-body');
    btn.disabled = true;
    body.innerHTML = '<p class="ai-loading">La IA está analizando tu tráfico, canales y conversión…</p>';
    try {
      const summary = { ...insightsData, ...leadsSummary(), contexto: 'Tráfico web + funnel de leads de Viven.' };
      const { data, error } = await supabase.functions.invoke('ai-insights', { body: { summary, lang: 'es' } });
      if (error || !data || !Array.isArray(data.insights)) throw new Error(data?.error || error?.message || 'sin respuesta');
      try { localStorage.setItem(AI_AUTO_LS, JSON.stringify({ date: today, insights: data.insights })); } catch (e) { /* sin espacio */ }
      renderAiCards(data.insights);
    } catch (e) {
      body.innerHTML = '<p class="muted-note">No se pudo generar (¿deployaste ai-insights y hay crédito en Anthropic?): ' + esc(e.message) + '</p>';
    } finally { btn.disabled = false; }
  }
  $('ai-insights-btn').addEventListener('click', () => autoInsights(true));
  $('ai-leads-btn').addEventListener('click', () => runInsights('ai-leads-btn', 'ai-leads-body', leadsSummary,
    'La IA está analizando tu funnel de leads…'));
  $('ai-offers-btn').addEventListener('click', () => runInsights('ai-offers-btn', 'ai-offers-body', offersSummary,
    'La IA está analizando tus ofertas…'));

  /* ---------- Data ---------- */
  /* ---------- Ventana de tiempo (filtro global) ---------- */
  let rangeDays = 30;      // preset: 1 / 7 / 30 / 90 / 365
  let rangeDay = null;     // 'YYYY-MM-DD' → un día puntual (pisa el preset)
  /* Mes calendario en curso (del 1 al día de hoy). Pedido de Sebastián: con "30 días"
     un 17 del mes estás mirando desde el 18 del mes pasado, así que los leads y los
     cierres del mes anterior se cuelan en el número del mes. */
  let rangeMes = false;
  const inicioDeMes = () => { const d = new Date(); return new Date(d.getFullYear(), d.getMonth(), 1).getTime(); };
  const rangeStart = () => rangeDay ? new Date(rangeDay + 'T00:00:00').getTime()
    : rangeMes ? inicioDeMes()
    : Date.now() - rangeDays * 864e5;
  const rangeEnd = () => rangeDay ? new Date(rangeDay + 'T23:59:59.999').getTime() : Date.now();
  /* ===== CARTERA vs PERFORMANCE — una sola definición para todo el dashboard =====
     El import de bexio (channel='bexio-import') creó 168 leads y los marcó TODOS
     como ganados: son facturas ya pagadas, clientes de antes. Es tu cartera, no
     rendimiento de marketing. Contarlos deformaba todos los porcentajes: medido el
     12 ago 2026, el dashboard mostraba 89,4% de conversión cuando la conversión de
     los leads que trae el marketing es 4,8% (21 leads reales, 1 ganado). Y de las
     184 altas de los últimos 28 días, 168 eran el import.
     Regla: los números de PERFORMANCE usan solo leads de origen real; la cartera se
     muestra aparte y con nombre, nunca se esconde. (Aprobado por Sebastián.) */
  const esCartera = (l) => /bexio/i.test((l && l.channel) || '');
  /* ===== Direcciones nuestras y de prueba =====
     Sebastián, 25 ago: "sebastian@viven.ch o sofia@viven.ch son como tests, no para
     responderles. Lo mismo con cepeda.sebastian@gmail.com, los uso para testear".
     Aparecían en Hoy como si fueran clientes esperando respuesta —su propio email
     encabezando la lista de lo que hay que contestar— y sus mensajes internos se
     guardaban como "escribió el cliente" en la ficha de otra gente.
     Un solo lugar define qué es interno; si mañana hay otra dirección de prueba, se
     agrega acá y desaparece de todas las pantallas a la vez. */
  const CORREOS_PRUEBA = ['cepeda.sebastian@gmail.com'];
  const esInterno = (email) => {
    const e = String(email || '').toLowerCase().trim();
    if (!e) return false;
    return e.endsWith('@viven.ch') || CORREOS_PRUEBA.includes(e);
  };
  const esGanado = (l) => /ganado|won|cerrado/i.test((l && l.status) || '');
  const leadsPerf = () => (allLeads || []).filter((l) => !esCartera(l));
  const leadsCartera = () => (allLeads || []).filter(esCartera);

  /* ===== Conversión real por mes / trimestre / año =====
     Cohorte por fecha de alta: de los leads que ENTRARON en el período, cuántos
     terminaron ganados. Es la lectura honesta para marketing — un ganado se cuenta
     en el período en que llegó el lead, no en el que cerró, así se ve si lo que
     entra mejora. Sin la cartera de bexio (esCartera). */
  let cvpModo = 'mes';
  function cvpPeriodos(modo){
    const L = leadsPerf().filter((l) => l.created_at);
    if (!L.length) return [];
    const clave = (d) => modo === 'anio' ? String(d.getFullYear())
      : modo === 'trim' ? d.getFullYear() + '-Q' + (Math.floor(d.getMonth() / 3) + 1)
      : d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
    const etiqueta = (k) => {
      if (modo === 'anio') return k;
      if (modo === 'trim') return 'Q' + k.split('-Q')[1] + ' ' + k.split('-')[0];
      const [y, m] = k.split('-');
      return new Date(+y, +m - 1, 1).toLocaleDateString('es-CH', { month: 'long' }) + ' ' + y;
    };
    const acc = new Map();
    L.forEach((l) => {
      const k = clave(new Date(l.created_at));
      const a = acc.get(k) || { k, label: etiqueta(k), leads: 0, ganados: 0 };
      a.leads++; if (esGanado(l)) a.ganados++;
      acc.set(k, a);
    });
    return [...acc.values()].sort((a, b) => b.k.localeCompare(a.k))
      .map((a) => ({ ...a, pct: a.leads ? Math.round(1000 * a.ganados / a.leads) / 10 : 0 }));
  }
  /* ===== Visitantes por período (SQL 0140) =====
     Sebastián: "acá faltarían los visitantes, los leads, la conversión en % y de
     esos los clientes y esa conversión, para entender mejoras de mes a mes".
     Tiene razón: sin el escalón de arriba no se distingue un mes con menos leads
     por menos tráfico de uno con peor conversión.
     Se pide una vez por modo y se guarda: la tabla se re-dibuja en cada render de
     Analytics y no vale una consulta cada vez. */
  /* primer instante del período, a partir de su clave ('2026-08', '2026-Q3', '2026') */
  function cvpInicioDe(k){
    if (/^\d{4}$/.test(k)) return new Date(+k, 0, 1).getTime();
    const q = k.match(/^(\d{4})-Q([1-4])$/);
    if (q) return new Date(+q[1], (+q[2] - 1) * 3, 1).getTime();
    const m = k.match(/^(\d{4})-(\d{2})$/);
    return m ? new Date(+m[1], +m[2] - 1, 1).getTime() : 0;
  }
  const cvpVis = {};        // modo -> Map(clave -> {sesiones, personas})
  const cvpVisPidiendo = {};
  async function cvpCargarVisitas(modo){
    if (cvpVis[modo] || cvpVisPidiendo[modo]) return;
    cvpVisPidiendo[modo] = true;
    try {
      const { data, error } = await supabase.rpc('rpc_visitas_por_periodo', { p_modo: modo });
      if (error) throw error;
      const m = new Map();
      (data || []).forEach((r) => m.set(r.clave, { sesiones: +r.sesiones || 0, personas: +r.personas || 0 }));
      cvpVis[modo] = m;
      cvpRender();          // ya con los visitantes adentro
    } catch (e) {
      cvpVis[modo] = new Map();   // sin datos: la columna queda en '—', no rompe la tabla
    } finally { cvpVisPidiendo[modo] = false; }
  }
  function cvpRender(){
    cvpCargarVisitas(cvpModo);
    const box = $('cvp-body'); if (!box) return;
    const filas = cvpPeriodos(cvpModo);
    const cart = leadsCartera();
    $('cvp-count').textContent = filas.length ? '(' + filas.length + (cvpModo === 'mes' ? ' meses' : cvpModo === 'trim' ? ' trimestres' : ' años') + ' con datos)' : '';
    if (!filas.length){ box.innerHTML = '<p class="muted-note">Todavía no hay leads de origen real cargados.</p>'; }
    else {
      const max = Math.max(...filas.map((f) => f.leads), 1);
      const vis = cvpVis[cvpModo] || new Map();
      box.innerHTML = '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:13px">' +
        '<tr style="text-align:left;color:var(--muted-2);font-size:10.5px;text-transform:uppercase;letter-spacing:.04em">' +
        '<th style="padding:6px 8px 6px 0;font-weight:600">Período</th>' +
        '<th style="padding:6px 8px;font-weight:600">Visitantes</th><th style="padding:6px 8px;font-weight:600">Leads</th>' +
        '<th style="padding:6px 8px;font-weight:600">Visita → lead</th>' +
        '<th style="padding:6px 8px;font-weight:600">Clientes</th><th style="padding:6px 8px;font-weight:600">Lead → cliente</th>' +
        '<th style="padding:6px 0;font-weight:600;min-width:90px"></th></tr>' +
        filas.map((f) => {
          /* Dos fuentes posibles para "visitantes": personas confirmadas (solo desde
             el 24/08) o sesiones con bots adentro (lo único que existe para los meses
             viejos). Se usa la que haya y se DICE cuál es — un 🤖 al lado del número
             y el porcentaje en gris cuando el denominador incluye tráfico automático.
             Un 0,3% calculado sobre bots no se puede comparar contra un 12% de gente,
             y sin la marca parecería que la web se desplomó. */
          const v = vis.get(f.k);
          const per = v ? v.personas : 0, ses = v ? v.sesiones : 0;
          /* Solo se usan PERSONAS si el período empieza dentro de la era medida.
             En agosto 2026 hay 79 personas (del 24 al 31) y 18 leads (del 1 al 31):
             dividir uno por otro daba 23%, que es el mismo cruce de ventanas de
             siempre. Mientras el período esté medido a medias se usan las sesiones
             —que sí cubren el mes entero— con su 🤖 y su porcentaje en gris. */
          const usaPersonas = per > 0 && cvpInicioDe(f.k) >= HUMAN_DESDE;
          const den = usaPersonas ? per : ses;
          const visTxt = !den ? '<span style="color:var(--muted-2)">—</span>'
            : den.toLocaleString('de-CH') + (usaPersonas ? '' : ' <span title="Incluye tráfico automático: las personas se miden desde el 24/08" style="opacity:.6">🤖</span>');
          const pctVis = den ? (f.leads / den * 100) : null;
          const pctVisTxt = pctVis == null ? '<span style="color:var(--muted-2)">—</span>'
            : '<span style="color:' + (usaPersonas ? 'var(--acid)' : 'var(--muted-2)') + '"' +
              (usaPersonas ? '' : ' title="Sobre sesiones con bots incluidos — sirve para comparar meses entre sí, no como tasa real"') + '>' +
              (pctVis < 10 ? pctVis.toFixed(1) : Math.round(pctVis)) + '%</span>';
          return '<tr style="border-top:1px solid var(--line)">' +
          '<td style="padding:8px 8px 8px 0;color:var(--text)">' + esc(f.label) + '</td>' +
          '<td style="padding:8px;font-family:\'Space Grotesk\';font-weight:700">' + visTxt + '</td>' +
          '<td style="padding:8px;font-family:\'Space Grotesk\';font-weight:700">' + f.leads + '</td>' +
          '<td style="padding:8px;font-family:\'Space Grotesk\';font-weight:700">' + pctVisTxt + '</td>' +
          '<td style="padding:8px">' + f.ganados + '</td>' +
          '<td style="padding:8px;font-family:\'Space Grotesk\';font-weight:700;color:' + (f.pct >= 10 ? 'var(--won)' : f.pct > 0 ? 'var(--acid)' : 'var(--muted-2)') + '">' + f.pct + '%</td>' +
          '<td style="padding:8px 0"><div style="height:7px;border-radius:6px;background:rgba(255,255,255,.07);overflow:hidden"><i style="display:block;height:100%;width:' + Math.round(100 * f.leads / max) + '%;background:var(--acid);border-radius:6px"></i></div></td>' +
          '</tr>'; }).join('') + '</table></div>' +
        (vis.size ? '<p class="muted-note" style="margin:10px 0 0">🤖 = visitantes con tráfico automático adentro (las personas se miden desde el 24/08). Esos porcentajes van en gris: sirven para comparar un mes contra otro, no como tasa real.</p>' : '');
    }
    const cg = cart.filter(esGanado).length;
    $('cvp-cartera').innerHTML = cart.length
      ? '<b>Aparte — cartera existente:</b> ' + cart.length + ' clientes importados de bexio (' + cg + ' con factura pagada). No entran en los porcentajes de arriba porque no vinieron del marketing: son clientes de antes, traídos desde las facturas. Contarlos daba <b>89% de conversión</b> en vez de la real.'
      : '';
  }
  document.querySelectorAll('#cvp-seg button').forEach((b) => b.addEventListener('click', () => {
    cvpModo = b.dataset.cvp;
    document.querySelectorAll('#cvp-seg button').forEach((x) => x.classList.toggle('on', x === b));
    cvpRender();
  }));

  const inRange = (d) => { const t = new Date(d).getTime(); return t >= rangeStart() && t <= rangeEnd(); };
  const rangeLabel = () => rangeDay
    ? new Date(rangeDay + 'T00:00:00').toLocaleDateString('es-CH', { day: '2-digit', month: 'long', year: 'numeric' })
    : rangeMes ? new Date().toLocaleDateString('es-CH', { month: 'long' }) + ' (del 1 al ' + new Date().getDate() + ')'
    : (rangeDays === 1 ? 'Hoy' : 'Últimos ' + rangeDays + ' días');
  // nº de días que muestra el gráfico diario (acotado para que el SVG no explote)
  const rangeSpanDays = () => rangeDay ? 1 : rangeMes ? Math.max(1, Math.ceil((Date.now() - inicioDeMes()) / 864e5)) : rangeDays;
  const since = () => new Date(rangeStart()).toISOString();
  const until = () => new Date(rangeEnd()).toISOString();

  // Supabase/PostgREST cappea cada response a un máximo de filas (Max Rows del
  // proyecto) SIN avisar, aunque el cliente pida .limit(20000) — un .select()
  // sin paginar sobre una tabla que ya superó ese tope devuelve un subconjunto
  // arbitrario (no hay .order()) y todo lo que se cuenta desde ahí (sesiones,
  // canales, páginas) queda subestimado en silencio. Paginar con .range() +
  // .order() es la única forma de traer TODAS las filas del rango.
  // fix (auditoría de performance 2026-07-14): antes paginaba SECUENCIAL (una página
  // esperaba a la anterior) — con ventanas de 30d que superan las 1000 filas (pageviews
  // ronda 2800 totales), esto eran 2-3 round trips uno atrás del otro. En red móvil esto
  // fue justo la query más lenta de loadAll() (~2.6s vs ~400-800ms del resto) y frenaba
  // TODO el Promise.all. Ahora: 1 query liviana de count (head:true, sin filas) + todas
  // las páginas en paralelo — mismo resultado, sin la cascada secuencial.
  async function fetchAllRows(table, cols, sinceIso, untilIso, dateCol){
    dateCol = dateCol || 'created_at';
    const PAGE = 1000;
    // fix urgente (2026-07-14, hangeaba loadAll entero): .select() SIEMPRE primero —
    // .gte()/.lte() no existen en el QueryBuilder crudo de supabase.from(table), solo
    // en el FilterBuilder que devuelve .select(). Llamarlos antes tiraba un TypeError
    // sincrónico que async convertía en promesa rechazada, sin catch en loadAll() →
    // Promise.all entero colgado para siempre, sin error visible.
    /* El conteo viene en el Content-Range de la primera página: no hace falta una
       consulta aparte con head:true. Ver la nota larga en fetchAllRowsFull. */
    const primera = await supabase.from(table).select(cols, { count: 'exact' })
      .gte(dateCol, sinceIso).lte(dateCol, untilIso)
      .order(dateCol, { ascending: true })
      .range(0, PAGE - 1);
    if (primera.error) return { data: null, error: primera.error };
    const total = Math.min(primera.count || 0, 200000); // mismo salvavidas de siempre
    const filas = primera.data || [];
    if (total <= filas.length) return { data: filas, error: null };
    const pages = Math.ceil(total / PAGE);
    const resto = await Promise.all(Array.from({ length: pages - 1 }, (_, i) =>
      supabase.from(table).select(cols)
        .gte(dateCol, sinceIso).lte(dateCol, untilIso)
        .order(dateCol, { ascending: true })
        .range((i + 1) * PAGE, (i + 2) * PAGE - 1)
    ));
    const err = resto.find((r) => r.error);
    if (err) return { data: null, error: err.error };
    return { data: filas.concat(resto.flatMap((r) => r.data || [])), error: null };
  }

  /* Igual que fetchAllRows pero para tablas SIN ventana de fechas (leads, notas,
     tasks, propuestas). Existe porque los .limit(1000/2000) de loadAll eran techos
     mudos: al pasarlos, la "última actividad" de los contactos más viejos quedaba
     vacía y la pantalla no lo decía en ningún lado. Un número incompleto que no se
     declara incompleto es peor que no mostrarlo. */
  async function fetchAllRowsFull(table, cols, orderCol){
    const PAGE = 1000;
    /* UN VIAJE, NO DOS. Antes preguntaba el total con un `head:true` y recién después
       pedía la primera página: dos idas y vueltas por tabla, y son cinco tablas en cada
       carga y en cada refresco. PostgREST devuelve el total en el Content-Range de la
       misma consulta que trae los datos, así que la primera página ya viene con el conteo.
       Las cinco entran holgadas en una página (leads 205, deals 204, offers 63, proposals
       16, companies 13), así que en la práctica son 5 viajes menos por carga. En el set,
       con mala señal, eso es lo que más se siente — más que los bytes.
       La paginación sigue estando para el día que alguna pase de 1000: es el tope que ya
       nos comió filas en leads una vez, sin avisar. */
    const primera = await supabase.from(table)
      .select(cols, { count: 'exact' })
      .order(orderCol, { ascending: false })
      .range(0, PAGE - 1);
    if (primera.error) return { data: null, error: primera.error };
    const total = Math.min(primera.count || 0, 200000);
    const filas = primera.data || [];
    if (total <= filas.length) return { data: filas, error: null, total: total || filas.length };

    const pages = Math.ceil(total / PAGE);
    const resto = await Promise.all(Array.from({ length: pages - 1 }, (_, i) =>
      supabase.from(table).select(cols).order(orderCol, { ascending: false })
        .range((i + 1) * PAGE, (i + 2) * PAGE - 1)));
    const err = resto.find((r) => r.error);
    if (err) return { data: null, error: err.error };
    return { data: filas.concat(resto.flatMap((r) => r.data || [])), error: null, total };
  }

  /* Cartel de "esto no cargó" DENTRO del panel afectado. Antes, si fallaba leads o
     pageviews, loadAll tiraba un alert() y cortaba: se perdía el CRM entero porque
     falló la analítica. Ahora cada consulta que falla ensucia solo su panel y el
     resto de la pantalla sigue viva. */
  function avisoCarga(contenedorId, texto){
    const cont = $(contenedorId); if (!cont) return;
    let av = cont.querySelector(':scope > .carga-mal');
    if (!texto){ if (av) av.remove(); return; }
    if (!av){
      av = document.createElement('p');
      av.className = 'muted-note carga-mal';
      av.style.cssText = 'border:1px solid rgba(255,139,94,.4);background:rgba(255,139,94,.08);color:#ff8b5e;border-radius:10px;padding:9px 12px;margin:0 0 12px';
      cont.insertBefore(av, cont.firstChild);
    }
    av.textContent = texto;
  }

  // ventana ANTERIOR de igual longitud: pageviews para los ▲▼ de KPIs y la línea punteada
  // del gráfico. Se trae UNA vez por corrida de loadAll (misma Promise.all) y queda cacheada
  // en módulo para los re-render intermedios (realtime, cambio de sub-tab).
  let prevViews = [], prevStats = null;
  let prevWin = { start: 0, end: 0 };
  /* Sesiones con actividad humana (SQL 0136). Empieza a acumular el 24/08/2026:
     para períodos anteriores NO hay dato, y mostrar 0 sería mentir al revés —
     parecería que no entró nadie. */
  let humanAct = [];
  const HUMAN_DESDE = Date.parse('2026-08-24T00:00:00Z');
  // último timestamp por clave — lo usan la carga core (propuestas) y la de analítica
  const maxTo = (map, key, iso) => { const t = Date.parse(iso); if (t && (!map[key] || t > map[key])) map[key] = t; };

  /* ---------- Carga en dos tiempos ----------
     Antes esto era UNA función con doce consultas en paralelo que no dibujaba nada
     hasta tenerlas todas, y si fallaba leads O pageviews tiraba un alert() y se
     iba: se perdía el CRM entero porque falló la analítica. En el iPhone, con red
     de rodaje, eso son varios segundos de pantalla muerta.

     Ahora:
       · loadCore()      → lo que necesita Hoy y el CRM (personas, deals, ofertas,
                           propuestas, empresas, agenda). Dibuja apenas está.
       · loadAnalytics() → pageviews, videos y la actividad por contacto, que es lo
                           caro. Sale por detrás y redibuja cuando llega; si estás
                           parado en Analytics y todavía no vino, se pide al entrar.
     Cada consulta que falla pinta su propio cartel (avisoCarga) y no toca al resto. */
  let anaCargada = false, anaCargando = false;
  /* «La actividad humana ya llegó», sin importar por cuál de las dos cargas. El KPI de
     Personas miraba anaCargada, que con la carga liviana nunca se prende: la tarjeta
     habría quedado en «cargando…» para siempre con los datos ya en memoria. */
  let actCargada = false;

  async function loadCore(){
    const [leadsQ, offersQ, coQ, propsQ, dealsQ, bookQ, bookPasadasQ, bookHistQ] = await Promise.all([
      // Las cinco paginan. Un .select() sin paginar se corta en el Max Rows del
      // proyecto SIN avisar: ofertas, deals y empresas todavía no llegan a ese tope,
      // pero el día que lleguen el pipeline mostraría de menos y nada lo diría.
      // Es el mismo tope que ya nos comió filas en leads.
      fetchAllRowsFull('leads', '*', 'created_at'),
      fetchAllRowsFull('offers', '*', 'updated_at'),
      fetchAllRowsFull('companies', '*', 'domain'),
      fetchAllRowsFull('proposals', '*', 'updated_at'),
      fetchAllRowsFull('deals', '*', 'created_at'),
      supabase.from('bookings').select('*').gte('start_at', new Date().toISOString()).eq('status', 'confirmed').order('start_at').limit(8),
      // histórico 30d (pedido explícito: trackear video calls booked por persona) — created_at
      // = cuándo se hizo la reserva, no cuándo es la call, así cuenta "booked" de verdad
      /* Las pasadas también: la Agenda mostraba solo lo que viene y estaba vacía casi
         siempre (0 reuniones en los próximos 7 días, 8 en los últimos 30, la última
         ayer). Una pantalla que casi siempre está vacía se deja de abrir. */
      supabase.from('bookings').select('*').gte('start_at', new Date(Date.now() - 30 * 864e5).toISOString())
        .lt('start_at', new Date().toISOString()).order('start_at', { ascending: false }).limit(30),
      supabase.from('bookings').select('host_email,created_at').gte('created_at', new Date(Date.now() - 30 * 864e5).toISOString()),
    ]);
    // personas: es lo único sin lo cual la pantalla no tiene sentido — igual no se
    // corta la carga, se avisa en su tab y se sigue con lo que haya
    /* NO LLEGARON LOS DATOS: se rehidrata del respaldo en vez de dejar la pantalla vacía.
       Es el caso del set. La rehidratación NO pisa lo que ya esté en memoria si vino con
       datos: solo entra cuando la consulta falló, que es cuando no hay nada mejor. */
    if (leadsQ.error && !(leadsQ.data || []).length){
      const at = snapRehidratar();
      if (at){ vvSnapAt = at; vvSinSenal();
        avisoCarga('tab-leads', '📵 Sin conexión — estos datos son de ' + fechaHoraCorta(at) + '. Tocá 🔄 Actualizar cuando vuelva la señal.'); }
    }
    if (leadsQ.error) avisoCarga('tab-leads', '⚠️ No se pudieron cargar los contactos: ' + leadsQ.error.message + '. Probá 🔄 Actualizar.');
    else avisoCarga('tab-leads', '');
    /* Los tests salen de allLeads, no se borran. allLeads es de donde cuelga TODO —
       listas, pipeline, contadores, conversión— así que filtrar acá una sola vez es lo
       que hace imposible olvidarse en la próxima pantalla. Quedan aparte, a un clic.
       (Sebastián, 26 ago 2026: "los tests que hago con sebastian@viven.ch y
       cepeda.sebastian@gmail.com no pueden contar como leads, o me falsifica todos los
       datos".) */
    const _todos = leadsQ.data || allLeads || [];
    leadsPrueba = _todos.filter((l) => l.es_prueba);
    allLeads = _todos.filter((l) => !l.es_prueba);
    window.__vvLoadedAt = Date.now();
    // ofertas: best-effort (si no corrió el SQL 0003 todavía, seguimos sin romper el dashboard)
    if (offersQ && !offersQ.error) offersList = offersQ.data || [];
    // DEALS (SQL 0022): la entidad REAL del pipeline (varios proyectos por persona).
    // Sin la tabla → 1 deal sintético por persona (modo legado, mismo comportamiento).
    upBookings = (bookQ && !bookQ.error) ? (bookQ.data || []) : [];
    bookingsPasadas = (bookPasadasQ && !bookPasadasQ.error) ? (bookPasadasQ.data || []) : [];
    bookingsHist = (bookHistQ && !bookHistQ.error) ? (bookHistQ.data || []) : [];
    dealsReal = !!(dealsQ && !dealsQ.error);
    /* LOS DEALS DE LAS PRUEBAS TAMPOCO CUENTAN. El lead de prueba ya salía de `allLeads`,
       pero su deal seguía entrando en el pipeline y en la plata del mes: "Cerrado este mes
       CHF 12'000 · 1 deal ganado" era el «Proyecto de prueba x1».
       La regla vive en la base (`leads.es_prueba`, migración 0162) y hay que aplicarla en
       CADA entrada a memoria, no solo en la primera — es el mismo error que ya tuvo
       refreshLeadsList.
       (Sebastián, 26 ago 2026: "¿de dónde sale eso?" sobre los 12.000 de agosto.) */
    const _idsPrueba = new Set((leadsPrueba || []).map((l) => String(l.id)));
    /* Los de prueba se apartan, no se tiran: sin la fila en memoria no hay forma de
       borrarlos desde la pantalla, y quedaban colgando para siempre. Mismo par que
       allLeads / leadsPrueba. */
    dealsPrueba = dealsReal ? (dealsQ.data || []).filter((d) => _idsPrueba.has(String(d.lead_id))) : [];
    dealsList = dealsReal
      ? (dealsQ.data || []).filter((d) => !_idsPrueba.has(String(d.lead_id)))
      : [];
    const _withDeal = new Set(dealsList.map((d) => String(d.lead_id)));
    allLeads.forEach((l) => { if (!_withDeal.has(String(l.id))) dealsList.push(synthDeal(l)); });
    // companies: best-effort (si no corrió el SQL 0011, coMeta queda vacío)
    coMeta = {}; if (coQ && !coQ.error) (coQ.data || []).forEach((c) => { if (c.domain) coMeta[c.domain] = c; });
    actProps = {}; if (propsQ && !propsQ.error) (propsQ.data || []).forEach((p) => { if (p.lead_id) maxTo(actProps, String(p.lead_id), p.updated_at); });
    propsAll = (propsQ && !propsQ.error) ? (propsQ.data || []) : [];
    if (propsQ && propsQ.error) avisoCarga('tab-offers', '⚠️ No se pudieron cargar las propuestas: ' + propsQ.error.message);
    else avisoCarga('tab-offers', '');
    servicesLoad();   // catálogo de servicios (best-effort; sin tabla → RATECARD)
    loadTeamProfiles();   // 👤 Mi perfil (best-effort; sin tabla → sigue con SENDERS/TEAM hardcodeados)
    obBadgeRefresh();     // 📤 badge de pendientes en el sidebar (visible sin entrar a Workflows)
    // SELF-HEAL de ganados: los syncs (deal→ofertas, oferta→deal) existen desde hoy,
    // pero los datos viejos quedaron a medias — esta pasada los reconcilia y de ahí
    // en más Propuestas, Home y Deals muestran SIEMPRE los mismos números.
    (async () => {
      try {
        let dirty = false;
        // (la dirección "deal ganado → borradores won" se ELIMINÓ el 12/07: promovía
        //  cotizaciones nuevas de clientes ya ganados — como los paquetes de propuesta)
        for (const o of (offersList || []).filter((x) => x.status === 'won' && !x.archived && !x.is_template)) {
          const d = o.deal_id ? (dealsList || []).find((x) => String(x.id) === String(o.deal_id)) : (o.lead_id ? openDealOf(o.lead_id) : null);
          if (d && !d.synthetic && !['ganado', 'perdido'].includes(stageOf(d.stage))) {
            const now = new Date().toISOString();
            await supabase.from('deals').update({ stage: 'ganado', won_at: d.won_at || now, last_stage_at: now }).eq('id', d.id);
            d.stage = 'ganado'; d.won_at = d.won_at || now; dirty = true;
            mirrorLeadStatus(d.lead_id);
          }
        }
        if (dirty) renderLeads();
      } catch (e) { /* best-effort */ }
    })();
    // reconciliar: propuesta aceptada pero lead sin ganar (aceptó con el dashboard cerrado) → sync
    if (propsQ && !propsQ.error) (propsQ.data || []).forEach((p) => {
      if (p.status !== 'accepted' || !p.lead_id) return;
      const l = allLeads.find((x) => String(x.id) === String(p.lead_id));
      if (l && !['ganado', 'perdido'].includes(stageOf(l.status))) setLeadStage(l.id, 'ganado');
    });
    renderLeads();
    renderHome();
    // Deals/Ofertas/Propuestas/Companies ya se refrescan arriba en memoria (dealsList/offersList/
    // propsAll/coMeta), pero antes solo se volvían a DIBUJAR en pantalla si estabas en Home o
    // volvías a entrar al tab — si te quedabas parado en Pipeline/Ofertas/Propuestas/Companies,
    // el cambio de otra persona (Sofia/Sebastián) no aparecía hasta recargar la página entera.
    // Re-renderizar acá también, cada corrida de loadAll, para que se actualice solo donde sea
    // que estés mirando.
    renderPipeline();
    // no pisar la edición inline de la ficha de empresa (antes el guard miraba el form co-ed-save; ahora la edición es un input dentro de #co-about)
    if (!document.querySelector('#co-about input')) renderCompanies();
    renderOffersList();
    renderPropList();
    // sub-tabs de Analytics/Contenido: si estás mirando Ads o Search Console, que también
    // se refresquen solos (SC solo si el gate se reseteó — Google no cambia minuto a
    // minuto y la cuota duele). fix (auditoría 2026-07-15, post-reestructura del shell):
    // Search Console se mudó de Analytics a Contenido — este chequeo seguía mirando
    // anaSub==='seo' (imposible desde la reestructura, anaSub ya no incluye 'seo') y
    // tab-analytics, así que el auto-refresh de Search Console dejaba de dispararse
    // en silencio.
    if (!$('tab-analytics').hidden && anaSub === 'gads' && typeof window.gadsLoad === 'function') window.gadsLoad();
    if (!$('tab-contenido').hidden && contenidoSub === 'seo' && !seoLoaded){ loadSeo(); loadBing(); }
    licLoad(); // licencias no entraba en loadAll — se sumó para que también se mantenga al día sola
    $('updated-at').textContent = rangeLabel() + ' · actualizado ' + new Date().toLocaleTimeString('es-CH', { hour: '2-digit', minute: '2-digit' });
    /* La copia se guarda al final y solo si vinieron los contactos: guardar una carga a
       medias sería peor que no guardar nada — la próxima vez sin señal se vería un
       recorte incompleto con cara de completo. */
    if (allLeads && allLeads.length) { vvSnapAt = 0; snapGuardar(); }
    loadBell();
    subscribeRealtime();
  }

  /* Segunda fase: lo caro. pageviews de dos ventanas, videos y la actividad por
     contacto (notas/tasks). No bloquea nada — cuando llega, redibuja. */
  function anaMarcarCarga(activo){
    document.querySelectorAll('#ana-sub-web .kpis').forEach((k) => k.classList.toggle('vv-cargando', !!activo));
  }
  /* ── LA MITAD LIVIANA DE LA ANALÍTICA ──
     Hoy necesita dos cosas de acá: el KPI de «Personas» (que sale de session_activity, 250
     filas) y las señales calientes (qué lead conocido volvió a la web en las últimas 24 h).
     Pero pedía loadAnalytics ENTERA: 8.644 pageviews con nueve campos, 917 reproducciones y
     el histórico completo de notas y tasks. 7,3 segundos medidos, para una tarjeta y una
     lista de tres renglones.
     Analytics y Leads siguen pidiendo la completa; Hoy pide esta. Los pageviews de 60 días
     del sparkline ya venían por su cuenta (hmFetchWeeks) y no se tocan. */
  let anaLivianaAt = 0, anaLivianaBusy = false;

  async function loadAnalyticsLiviana(){
    if (anaCargada || anaCargando || anaLivianaBusy) return;
    if (Date.now() - anaLivianaAt < 120000) return;
    anaLivianaAt = Date.now(); anaLivianaBusy = true;
    try {
      const desde24 = new Date(Date.now() - 864e5).toISOString();
      const [actQ, vistas24] = await Promise.all([
        fetchAllRows('session_activity', 'session_id,created_at', since(), until()),
        fetchAllRows('pageviews', 'created_at,session_id', desde24, new Date().toISOString()),
      ]);
      if (actQ && !actQ.error){ humanAct = actQ.data || []; actCargada = true; }
      /* lastViews queda con las últimas 24 h: es lo único que Hoy lee de esa lista, y
         Analytics lo pisa con el período completo cuando de verdad se abre. */
      if (vistas24 && !vistas24.error && !anaCargada) lastViews = vistas24.data || [];
      if (!$('tab-hoy').hidden) renderHome();
    } catch (e){ console.error('ANALITICA_LIVIANA', e && e.message); }
    finally { anaLivianaBusy = false; }
  }

  async function loadAnalytics(force){
    if (anaCargando || (anaCargada && !force)) return;
    anaCargando = true;
    anaMarcarCarga(true);
    try {
      const winStart = rangeStart(), winEnd = rangeEnd(), winLen = winEnd - winStart;
      prevWin = { start: winStart - winLen, end: winStart - 1 };
      const [viewsQ, prevQ, videosQ, notesQ, tasksQ, actQ] = await Promise.all([
        fetchAllRows('pageviews', 'created_at,path,device,session_id,channel,referrer,lang,is_entry,duration', since(), until()),
        /* El período ANTERIOR se cuenta en la base. Se bajaban sus 6.349 filas enteras
           —con path, duración y todo— para sacar dos números: visitas y sesiones. Era el
           39% de todo lo que descarga esta pantalla, que tardaba 7,3 s.
           Si la RPC falla se cae al método viejo, así que un error acá no deja las flechas
           ▲▼ sin comparación. */
        supabase.rpc('stats_periodo', {
          desde: new Date(winStart - winLen).toISOString(),
          hasta: new Date(winStart - 1).toISOString(),
        }).then(async (r) => (r.error || !r.data
          ? await fetchAllRows('pageviews', 'created_at,session_id,duration', new Date(winStart - winLen).toISOString(), new Date(winStart - 1).toISOString())
          : { data: null, stats: typeof r.data === 'string' ? JSON.parse(r.data) : r.data })),
        fetchAllRows('video_plays', '*', since(), until()),
        fetchAllRowsFull('lead_notes', 'lead_id,created_at', 'created_at'),
        fetchAllRowsFull('lead_tasks', 'lead_id,created_at,done_at', 'created_at'),
        // sesiones donde hubo ALGUIEN: un scroll, un movimiento, un toque (SQL 0136).
        // Medido el 24/08: de 6.943 "sesiones" en 30 días, 5.725 eran tráfico
        // automático (una sola página, 78,5% de cero segundos). Sin esto, la
        // tarjeta de "visitantes" contaba bots.
        fetchAllRows('session_activity', 'session_id,created_at', new Date(winStart - winLen).toISOString(), until()),
      ]);
      if (viewsQ.error){
        avisoCarga('tab-analytics', '⚠️ No se pudo cargar la analítica web: ' + viewsQ.error.message + '. El resto del dashboard funciona igual.');
      } else {
        avisoCarga('tab-analytics', '');
        lastViews = viewsQ.data || [];
        /* Dos formas de tener el período anterior: los totales de la RPC (lo normal) o las
           filas crudas (si la RPC falló). `prevStats` es la fuente de verdad; prevViews
           queda solo para el camino viejo. */
        prevStats = (prevQ && prevQ.stats) || null;
        prevViews = (prevQ && !prevQ.error && !prevQ.stats) ? (prevQ.data || []) : [];
        humanAct = (actQ && !actQ.error) ? (actQ.data || []) : [];
        if (actQ && !actQ.error) actCargada = true;
        actWeb = {}; (lastViews || []).forEach((v) => { if (v.session_id) maxTo(actWeb, v.session_id, v.created_at); });
        renderAnalytics(lastViews, allLeads);
      }
      // actividad por contacto: si falla, las fichas quedan sin "última actividad"
      // pero Personas sigue andando
      actNotes = {}; if (notesQ && !notesQ.error) (notesQ.data || []).forEach((n) => maxTo(actNotes, String(n.lead_id), n.created_at));
      actTasks = {}; if (tasksQ && !tasksQ.error) (tasksQ.data || []).forEach((t) => { maxTo(actTasks, String(t.lead_id), t.created_at); if (t.done_at) maxTo(actTasks, String(t.lead_id), t.done_at); });
      if (!videosQ.error) renderVideoAna(videosQ.data || [], allLeads);
      // solo se marca cargada si los pageviews VINIERON. Si fallaron y la dejábamos
      // en true, volver a entrar al tab no reintentaba nunca y el KPI de visitas se
      // quedaba en '–' hasta recargar la página entera.
      anaCargada = !viewsQ.error;
      renderLeads(); renderHome();
    } catch (e) {
      avisoCarga('tab-analytics', '⚠️ No se pudo cargar la analítica: ' + (e.message || e));
    } finally { anaCargando = false; anaMarcarCarga(false); }
  }

  /* Compatibilidad: todo el archivo llama loadAll() (refresh, cambio de rango,
     realtime). Sigue existiendo y ahora significa "traé lo del CRM y después, por
     detrás, la analítica". */
  /* ── Medir, para no optimizar a ciegas ──
     La tabla `dash_perf_log` existe y tenía datos ricos hasta el 17 ago; el código que
     escribía en ella se perdió en algún refactor, y desde entonces nadie sabe qué tarda.
     Eso es peor que no tener medición: la tabla aparenta tenerla.
     Se guarda UNA fila por carga y por cambio de pestaña, con los hitos en ms. Sin datos
     personales — solo el email de quien la usa, que ya está en la sesión.
     No se espera nunca: medir no puede hacer más lenta la cosa que mide. */
  function perf(kind, marcas){
    try {
      supabase.from('dash_perf_log').insert({
        email: meEmail || null,
        phases: { kind, ...marcas },
        ua: (navigator.userAgent || '').slice(0, 200),
      }).then(() => {}, () => {});
    } catch (e){ }
  }

  /* ── Los errores del dashboard quedan registrados ──
     Tres veces en el día de hoy algo se rompió y me enteré porque Sebastián lo escribió.
     Un error de JS mata la función donde ocurre y deja la pantalla a medias sin decir
     nada: "no puedo entrar al proyecto" es lo que se ve desde afuera de una excepción.
     Se guarda en la misma tabla que los tiempos, con el kind 'error'. Uno por mensaje
     distinto y como mucho 5 por sesión — si algo falla en bucle, la tabla no se llena.
     Nunca rompe: si el registro falla, se ignora. */
  (function registrarErrores(){
    const vistos = new Set();
    const anotar = (msg, donde) => {
      const clave = String(msg).slice(0, 120);
      if (vistos.has(clave) || vistos.size >= 5) return;
      vistos.add(clave);
      try {
        perf('error', { msg: clave, donde: String(donde || '').slice(0, 160),
                        tab: (new URLSearchParams(location.search)).get('tab') || location.search.slice(0, 60) });
      } catch (e){ }
    };
    window.addEventListener('error', (e) => anotar(e.message, (e.filename || '') + ':' + e.lineno));
    /* Una promesa que falla no dispara 'error'. La mitad de lo que se rompe acá es una
       consulta que se cae adentro de un async. */
    window.addEventListener('unhandledrejection', (e) => {
      const r = e.reason;
      anotar((r && (r.message || r.error_description)) || String(r), 'promesa');
    });
  })();

  async function loadAll(){
    const t0 = performance.now();
    await loadCore();
    const core = Math.round(performance.now() - t0);

    /* La analítica son 14.500 pageviews y tarda unos seis segundos. Se pedía SIEMPRE al
       arrancar, aunque entraras directo a un proyecto por su link —que es como se abren
       los que se mandan por email— y ahí no la mira nadie: seis segundos de red y de CPU
       en el teléfono para nada.
       Ahora sale sola solo si la pestaña de destino la usa; en cualquier otra se pide
       cuando entrás (gotoTab ya lo hace). Medido: core ~1,2 s, total ~7,5 s. */
    const qs = new URLSearchParams(location.search);
    const destino = qs.get('tab') ||
      (qs.get('proyecto') || qs.get('project') ? 'projects' :
       qs.get('lead') ? 'leads' : qs.get('offer') || qs.get('propuesta') ? 'offers' :
       qs.get('empresa') || qs.get('company') ? 'companies' : 'hoy');
    /* Al arrancar: la completa solo si el destino la usa entera. Hoy —que es donde se
       cae por defecto— pide la liviana, que son 250 filas y no 16.000. */
    const laUsaEntera = ['analytics', 'leads'].includes(destino);
    const esHoy = destino === 'hoy' || !destino;

    perf('initial_load', { core, leads: allLeads.length, pruebas: leadsPrueba.length,
                           destino, analitica: laUsaEntera ? 'ya' : esHoy ? 'liviana' : 'después' });
    if (esHoy){
      loadAnalyticsLiviana().then(() => {
        perf('analytics_liviana', { ms: Math.round(performance.now() - t0) - core, destino });
      }, () => {});
      return;
    }
    if (!laUsaEntera) return;
    loadAnalytics(true).then(() => {
      perf('analytics', { ms: Math.round(performance.now() - t0) - core, destino });
    }, () => {});
  }

  /* ---------- Realtime: leads nuevos aparecen solos (gratis, sin polling) ---------- */
  let rtSubscribed = false;
  function subscribeRealtime(){
    if (rtSubscribed) return;
    rtSubscribed = true;
    supabase.channel('leads-live')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'leads' }, (payload) => {
        const r = payload.new;
        if (allLeads.some((l) => l.id === r.id)) return;
        allLeads.unshift(r);
        renderLeads();
        renderAnalytics(lastViews, allLeads);
        // manual = lo cargamos nosotros desde Personas — no es una novedad, sin toast
        if (r.channel !== 'manual') toast('🎬 Nuevo lead: ' + (r.name || r.email));
      })
      .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'leads' }, (payload) => {
        const i = allLeads.findIndex((l) => l.id === payload.new.id);
        if (i > -1) { allLeads[i] = payload.new; renderLeads(); renderAnalytics(lastViews, allLeads); }
      })
      .on('postgres_changes', { event: '*', schema: 'public', table: 'lead_tasks' }, () => { loadBell(); })
      .subscribe();
  }
  /* ¿Estamos dentro de la app del iPhone (WKWebView) o en un navegador normal?
     Importa para el botón "Imprimir / Guardar PDF" de ofertas y facturas: en un
     WKWebView sin el puente nativo, window.print() no hace absolutamente nada y el
     botón queda muerto —pendiente viejo—. La app de Viven inyecta window.print y
     ahí sí funciona; en cualquier otro WKWebView (por ejemplo la PWA agregada a
     inicio) no existe, y en vez de un botón que miente ofrecemos descargar el
     documento, que en iOS abre la hoja de compartir con "Guardar en Archivos" e
     "Imprimir". */
  const esWKWebView = () => !!(window.webkit && window.webkit.messageHandlers);
  /* El botón se escribe DENTRO del documento que se abre en la ventana nueva, así
     que su onclick corre allá: por eso el HTML se decide acá, del lado del que
     sabe en qué contexto está. */
  function botonImprimir(){
    if (tieneImpresion()) return '<button class="pr" onclick="window.print()">🖨 Imprimir / Guardar PDF</button>';
    return '<button class="pr" onclick="(function(){var b=new Blob([document.documentElement.outerHTML],{type:\'text/html\'});var a=document.createElement(\'a\');a.href=URL.createObjectURL(b);a.download=(document.title||\'documento\')+\'.html\';document.body.appendChild(a);a.click();a.remove();})()">📥 Guardar / Compartir</button>';
  }
  const tieneImpresion = () => !esWKWebView() || !!(window.webkit.messageHandlers && window.webkit.messageHandlers.imprimir);

  /* ===== LOS ERRORES DE POSTGRES NO SON PARA EL QUE USA LA APP =====
     Al cargar un pago recurrente el día 30, la pantalla mostró literalmente:
     'new row for relation "cashflow_recurring_templates" violates check constraint
     "cashflow_recurring_templates_day_of_month_check"'. Eso no dice qué hacer, y hay
     ~80 lugares que muestran error.message tal cual. En vez de parchear los 80, se
     traduce en el único lugar por donde pasan todos: el toast.
     Lo que no se reconoce se muestra igual — es preferible un mensaje feo a esconder
     un error que nadie va a poder describir después. */
  const CAMPOS_LINDOS = {
    day_of_month: 'el día del mes', amount_chf: 'el monto', unit_cost: 'el costo',
    due_date: 'la fecha de vencimiento', renewal_date: 'la fecha de renovación',
    email: 'el email', name: 'el nombre', title: 'el título', slug: 'la dirección web',
    stage: 'la etapa', status: 'el estado', kind: 'el tipo', frequency: 'la frecuencia',
    lead_id: 'el contacto', project_id: 'el proyecto', qty: 'la cantidad',
  };
  function humanizarError(msg){
    const m = String(msg || '');
    let x;
    if ((x = m.match(/violates check constraint "([a-z0-9_]+)_check"/i))){
      /* El nombre viene como <tabla>_<columna>_check y la tabla también tiene guiones
         bajos, así que una captura suelta se lleva todo ("cashflow recurring templates
         day of month"). Se busca cuál de los campos conocidos TERMINA el nombre. */
      const nom = x[1];
      const campo = Object.keys(CAMPOS_LINDOS).find((k) => nom === k || nom.endsWith('_' + k));
      return campo
        ? 'Ese valor no se puede guardar en ' + CAMPOS_LINDOS[campo] + '.'
        : 'Ese valor no es válido para este campo.';
    }
    if (/duplicate key value violates unique constraint/i.test(m)) return 'Ya existe uno igual — no se creó otro.';
    if ((x = m.match(/null value in column "([a-z_]+)"/i))){
      return 'Falta completar ' + (CAMPOS_LINDOS[x[1]] || x[1].replace(/_/g, ' ')) + '.';
    }
    if (/violates foreign key constraint/i.test(m)) return 'Está ligado a algo que ya no existe (o algo lo está usando).';
    if (/row-level security|permission denied/i.test(m)) return 'No tenés permiso para hacer eso.';
    if (/JWT expired|token is expired/i.test(m)) return 'Se venció la sesión — recargá la página.';
    if (/Failed to send a request to the Edge Function/i.test(m)) return 'No se pudo llamar al servidor (CORS). Avisá que hay que revisar la función.';
    if (/Failed to fetch|NetworkError/i.test(m)) return 'Sin conexión con el servidor — probá de nuevo.';
    return m;
  }

  /* ===== "9.531" NO SON NUEVE FRANCOS =====
     Sebastián cargó los sueldos como 9.531 —nueve mil quinientos treinta y uno, escrito
     a la europea— y el campo `type=number` lo leyó como 9,531: nueve francos con medio.
     No dio error, no se vio, y la proyección de liquidez quedó calculando una empresa
     con CHF 750 de costos fijos al mes. Un input de plata que se come mil francos en
     silencio es peor que uno que rechaza.
     Se acepta como se escribe de verdad: 9'531 · 9.531 · 9 531 · 9531 · 9'531.50.
     Regla para el punto/coma solo: si lo que sigue son EXACTAMENTE tres dígitos es
     separador de miles (9.531 → 9531); con uno o dos, es decimal (9.5 → 9.5). */
  function numCHF(v){
    let t = String(v ?? '').trim().replace(/[\s\u00a0'’´`]/g, '');
    if (!t) return 0;
    const neg = /^-/.test(t);
    t = t.replace(/[^0-9.,]/g, '');
    const iP = t.lastIndexOf('.'), iC = t.lastIndexOf(',');
    if (iP >= 0 && iC >= 0){
      // los dos: el ÚLTIMO manda como decimal, el otro era de miles
      const dec = Math.max(iP, iC);
      t = t.slice(0, dec).replace(/[.,]/g, '') + '.' + t.slice(dec + 1);
    } else if (iP >= 0 || iC >= 0){
      const i = Math.max(iP, iC), cola = t.length - i - 1;
      t = cola === 3 ? t.replace(/[.,]/g, '') : t.slice(0, i) + '.' + t.slice(i + 1).replace(/[.,]/g, '');
    }
    const n = parseFloat(t);
    return Number.isFinite(n) ? (neg ? -n : n) : 0;
  }

  /* Cada campo de plata dice, debajo, el número que entendió. Es la única forma de que
     "9.531" no se convierta en nueve francos sin que nadie se entere. */
  function chfEco(inp){
    let eco = inp.nextElementSibling;
    if (!eco || !eco.classList || !eco.classList.contains('chf-eco')){
      eco = document.createElement('div'); eco.className = 'chf-eco';
      inp.insertAdjacentElement('afterend', eco);
    }
    const v = numCHF(inp.value);
    eco.textContent = inp.value.trim() ? 'CHF ' + v.toLocaleString('de-CH', { maximumFractionDigits: 2 }) : '';
    eco.style.color = inp.value.trim() && !v ? '#ff8b8b' : '';
  }
  document.addEventListener('input', (e) => {
    if (e.target && e.target.classList && e.target.classList.contains('js-chf')) chfEco(e.target);
  });

  /* ── LO ÚLTIMO QUE SE CARGÓ, DE VERDAD ──
     El cartel de abajo decía «se ve lo último que se cargó» y era mentira: no había ningún
     respaldo local. Abrir la app sin señal daba el cartel Y las listas vacías, o sea el
     peor de los dos mundos: te avisa que estás viendo datos viejos mientras no ves nada.
     Sebastián mira el tablero EN EL SET, donde no hay señal.
     Ahora cada carga buena deja una copia. Si la siguiente no llega, se rehidrata de ahí y
     el cartel dice DE CUÁNDO es. La fecha no es un adorno: un dato viejo sin fecha es
     indistinguible de uno de ahora, y en esta app hay plata en pantalla.
     localStorage y no IndexedDB porque es síncrono y chico: se lee antes de pintar. Si no
     entra, se guarda una versión recortada con lo que sirve en el set —proyectos, crew,
     contactos, deals— antes que nada. */
  const SNAP = 'vv_snap_v1';
  function snapGuardar(){
    const intentos = [
      () => ({ leads: allLeads, pruebas: leadsPrueba, deals: dealsList, dealsPrueba,
               offers: offersList, props: propsAll, co: coMeta, book: upBookings }),
      /* recortado: lo que de verdad se usa sin señal. Las ofertas y las propuestas son lo
         más pesado (traen sus ítems enteros) y son justo lo que no se mira en un rodaje. */
      () => ({ leads: allLeads, pruebas: leadsPrueba, deals: dealsList, dealsPrueba, co: coMeta, book: upBookings }),
      () => ({ leads: allLeads, deals: dealsList }),
    ];
    for (const armar of intentos){
      try {
        localStorage.setItem(SNAP, JSON.stringify({ at: Date.now(), d: armar() }));
        return true;
      } catch (e){ /* sin lugar: se prueba con menos */ }
    }
    try { localStorage.removeItem(SNAP); } catch (e){ }
    return false;
  }
  function snapLeer(){
    try {
      const raw = localStorage.getItem(SNAP); if (!raw) return null;
      const o = JSON.parse(raw);
      return (o && o.at && o.d) ? o : null;
    } catch (e){ return null; }
  }
  /* Devuelve la edad para el cartel, o null si no hubo nada que rehidratar. */
  function snapRehidratar(){
    const o = snapLeer(); if (!o) return null;
    const d = o.d;
    /* Los dos JUNTOS en allLeads. Abajo, loadCore vuelve a separarlos con
       `_todos.filter(es_prueba)`; si acá se devolvieran ya separados, esa pasada dejaría
       leadsPrueba vacío y sin señal las pruebas volverían a contarse como reales — que es
       justo el bug que se acaba de arreglar, reapareciendo por la puerta de atrás. */
    const _leads = (Array.isArray(d.leads) ? d.leads : []).concat(Array.isArray(d.pruebas) ? d.pruebas : []);
    if (_leads.length) allLeads = _leads;
    if (Array.isArray(d.pruebas)) leadsPrueba = d.pruebas;
    /* Los deals NO se juntan: loadCore los separa con `dealsQ.data`, que sin señal no
       existe, así que lo que se deje acá es lo que queda. */
    if (Array.isArray(d.deals) && d.deals.length){ dealsList = d.deals; dealsReal = true; }
    if (Array.isArray(d.dealsPrueba)) dealsPrueba = d.dealsPrueba;
    if (Array.isArray(d.offers)) offersList = d.offers;
    if (Array.isArray(d.props)) propsAll = d.props;
    if (d.co && typeof d.co === 'object') coMeta = d.co;
    if (Array.isArray(d.book)) upBookings = d.book;
    return o.at;
  }

  /* SIN SEÑAL. En el set no hay internet y los datos viven en Supabase, así que la app
     puede ABRIR pero no traer nada. Antes eso se veía como paneles vacíos o cargando
     para siempre — que se lee como "se rompió". Un cartel arriba lo dice. */
  let vvSnapAt = 0;   // de cuándo es lo que se está viendo, si vino del respaldo
  function vvSinSenal(){
    let b = document.getElementById('vv-offline');
    if (!navigator.onLine){
      if (!b){
        b = document.createElement('div'); b.id = 'vv-offline';
        b.style.cssText = 'position:fixed;left:0;right:0;top:0;z-index:9998;background:#f0c060;color:#20160a;' +
          'font:600 13px Inter,sans-serif;padding:8px 14px;text-align:center';
        document.body.appendChild(b);
      }
      /* CON LA FECHA. «Lo último que se cargó» no dice nada: puede ser de hace un minuto o
         de anteayer, y sobre la pantalla hay plata. */
      b.textContent = vvSnapAt
        ? '📵 Sin conexión — estos datos son de ' + fechaHoraCorta(vvSnapAt) + ' (' + timeAgo(new Date(vvSnapAt).toISOString()) + '). Lo que toques no se guarda hasta que vuelva la señal.'
        : '📵 Sin conexión — no hay datos guardados de antes. Volvé a abrir con señal.';
    } else if (b) b.remove();
  }
  const fechaHoraCorta = (ms) => new Date(ms).toLocaleString('es-CH', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
  window.addEventListener('online', vvSinSenal);
  window.addEventListener('offline', vvSinSenal);
  vvSinSenal();

  function toast(msg){
    let t = document.getElementById('dash-toast');
    if (!t) {
      t = document.createElement('div'); t.id = 'dash-toast';
      t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;background:var(--acid);color:#142033;font-weight:700;font-family:Space Grotesk;padding:14px 20px;border-radius:12px;box-shadow:0 12px 40px -10px rgba(0,0,0,.6);transition:.3s;opacity:0;transform:translateY(10px)';
      document.body.appendChild(t);
    }
    /* UN AVISO DE ERROR TAMBIÉN SE REGISTRA.
       Los 68 `toast('⚠️ …')` del archivo son fallas que el código SÍ atrapó: la consulta se
       cayó, el archivo no subió, el email no salió. El usuario las ve y desaparecen en seis
       segundos; el registro de errores no las veía nunca, porque un catch que muestra un
       aviso no dispara 'error' ni 'unhandledrejection'.
       Se anota el texto crudo —no el humanizado— que es el que sirve para encontrar la
       causa. Nunca rompe el aviso: si el registro falla, el toast sale igual. */
    try {
      if (/^\s*(⚠️|❌|🚫)/.test(String(msg))) perf('error_visto', { msg: String(msg).slice(0, 160) });
    } catch (e){ }
    t.textContent = humanizarError(msg);
    requestAnimationFrame(() => { t.style.opacity = '1'; t.style.transform = 'none'; });
    clearTimeout(t._h);
    t._h = setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translateY(10px)'; }, 6000);
  }

  /* ================= CAMPANA: tareas y avisos (mobile/desktop/tablet) ================= */
  let bellItems = [], bellBound = false;
  function leadName(id){ const l = allLeads.find((x) => String(x.id) === String(id)); return l ? (l.name || l.email) : 'Lead'; }
  const startOfToday = () => { const d = new Date(); d.setHours(0, 0, 0, 0); return d; };
  const bellDismissed = new Set(JSON.parse(localStorage.getItem('bellDismissed') || '[]'));
  function dismissBellItem(k){
    bellDismissed.add(k);
    localStorage.setItem('bellDismissed', JSON.stringify([...bellDismissed].slice(-300)));
    // y a la BASE: descartada acá = descartada en todos tus dispositivos, para siempre
    supabase.from('bell_dismissed').upsert({ user_email: meEmail || '', key: k }).then(() => {}, () => {});
    bellItems = bellItems.filter((i) => (i.kind + ':' + i.id) !== k);
    renderBell();
  }
  /* BORRAR TODAS DE UNA. Descartar de a una es correcto cuando hay tres avisos; con
     veinte es una tarea en sí misma, y entonces no se descarta ninguna y el badge deja de
     significar algo. Va a la base igual que el descarte individual, así que se apaga en
     todos tus dispositivos.
     Pide confirmación porque no tiene vuelta atrás, y dice CUÁNTAS son: «borrar 23» y
     «borrar 2» no son la misma decisión.
     (Sebastián, 2 sep 2026: "dame la opción de borrar todas las notificaciones y no
     hacerlo uno por uno que tarda un montón".) */
  async function dismissBellAll(){
    const claves = bellItems.map((i) => i.kind + ':' + i.id);
    if (!claves.length){ toast('No hay avisos para borrar'); return; }
    if (!confirm('¿Borrar los ' + claves.length + ' avisos?\n\nSe van de todos tus dispositivos y no se pueden recuperar.')) return;
    claves.forEach((k) => bellDismissed.add(k));
    try { localStorage.setItem('bellDismissed', JSON.stringify([...bellDismissed].slice(-300))); } catch (e){ }
    bellItems = [];
    renderBell();
    /* En una sola llamada, no una por aviso: veintitrés upserts sueltos tardan más que el
       borrado de a uno que esto viene a reemplazar. */
    const { error } = await supabase.from('bell_dismissed')
      .upsert(claves.map((k) => ({ user_email: meEmail || '', key: k })));
    if (error) toast('⚠️ Se ocultaron acá, pero no se pudieron guardar: ' + error.message);
    else toast('🔕 ' + claves.length + ' aviso' + (claves.length === 1 ? '' : 's') + ' borrado' + (claves.length === 1 ? '' : 's'));
  }

  async function loadBell(){
    if (!bellBound){ bellBound = true;
      $('bell-btn').addEventListener('click', (e) => { e.stopPropagation(); toggleBell(); });
      $('bell-x').addEventListener('click', (e) => { e.stopPropagation(); $('bell-panel').hidden = true; });
      $('bell-panel').addEventListener('click', (e) => e.stopPropagation());
      document.addEventListener('click', () => { $('bell-panel').hidden = true; });
      $('bell-push').addEventListener('click', (e) => { e.stopPropagation(); enablePush(); });
    $('bell-clear') && $('bell-clear').addEventListener('click', (e) => { e.stopPropagation(); dismissBellAll(); });
      $('push-warn') && $('push-warn').addEventListener('click', (e) => { e.stopPropagation(); enablePush(); });
      refreshPushBtn();
    }
    try {
      const hace30 = new Date(Date.now() - 30 * 864e5).toISOString();
      const [tq, nq, bq, dq, aq] = await Promise.all([
        supabase.from('lead_tasks').select('*').eq('done', false).order('due_date', { ascending: true }).limit(60),
        supabase.from('lead_notes').select('*').not('mention', 'is', null).order('created_at', { ascending: false }).limit(30),
        supabase.from('briefs').select('id,lead_id,email,goal,created_at').order('created_at', { ascending: false }).limit(10),
        supabase.from('bell_dismissed').select('key').limit(1000),
        /* El buzón único: cualquier cosa que haya mandado una push dejó su aviso acá.
           Es lo que hace que la campana esté completa sin que cada función se acuerde. */
        supabase.from('avisos').select('*').is('archivado_at', null).gte('created_at', hace30)
          .order('created_at', { ascending: false }).limit(60),
      ]);
      if (dq && !dq.error) (dq.data || []).forEach((d) => bellDismissed.add(d.key));
      const tasks = (tq && !tq.error && tq.data) || [];
      const notes = (nq && !nq.error && nq.data) || [];
      const briefs = (bq && !bq.error && bq.data) || [];
      const mine = (t) => !meEmail || !t.assignee || String(t.assignee).toLowerCase() === meEmail; // sin asignar o para mí
      const t0 = startOfToday(), tEnd = new Date(t0.getTime() + 86400000);
      bellItems = [];
      const nowTs = Date.now();
      tasks.filter(mine).forEach((t) => {
        const due = t.due_date ? new Date(t.due_date + 'T' + (t.due_time || '00:00') + ':00') : null;
        let bucket = 'later', overdue = false;
        if (due) { if (t.due_time ? due.getTime() < nowTs : due < t0) { bucket = 'overdue'; overdue = true; } else if (due < tEnd) bucket = 'today'; else bucket = 'later'; }
        else bucket = 'nodate';
        bellItems.push({ kind: 'task', id: t.id, lead_id: t.lead_id, title: t.title, due, time: t.due_time || '', bucket, overdue, at: t.created_at });
      });
      // notas donde me mencionaron a mí (últimas 24-72h no filtramos, mostramos como aviso)
      notes.filter((n) => meEmail && String(n.mention || '').toLowerCase() === meEmail).slice(0, 8).forEach((n) => {
        bellItems.push({ kind: 'mention', id: n.id, lead_id: n.lead_id, title: (n.body || '').slice(0, 80), due: null, bucket: 'mention', overdue: false, at: n.created_at });
      });
      // ya estamos live con Sofia — @viven.ch es tráfico real entre nosotros, no test.
      // Las notificaciones siempre muestran todo, sin filtrar nada.
      const bellSkip = () => false;
      // leads nuevos sin contactar (últimas 72h) — lo mismo que llega por push. 'manual' = lo
      // cargamos nosotros mismos desde Personas → no es una novedad, no hace falta avisarnos
      const cutoff = Date.now() - 72 * 36e5;
      (allLeads || []).filter((l) => isNew(l.status) && !/^claude-/.test(l.session_id || '') && l.channel !== 'manual' && Date.parse(l.created_at) > cutoff && !bellSkip(l.email))
        .slice(0, 8).forEach((l) => {
          bellItems.push({ kind: 'lead', id: 'l' + l.id, lead_id: l.id, title: '🎬 Lead nuevo: ' + (l.name || l.email || ''), due: null, bucket: 'newlead', overdue: false, at: l.created_at });
        });
      // 🔔 EVENTOS DE NEGOCIO (últimos 7 días): videollamadas, briefs, ganadas
      const evCut = Date.now() - 7 * 864e5;
      const fmtDT = (iso) => new Date(iso).toLocaleString('es-CH', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
      (upBookings || []).filter((b) => !bellSkip(b.email)).slice(0, 6).forEach((b) => {
        bellItems.push({ kind: 'event', id: 'bk' + b.id, lead_id: b.lead_id, title: '📅 Videollamada: ' + (b.name || b.email || '') + ' · ' + fmtDT(b.start_at), due: null, bucket: 'event', overdue: false, at: b.created_at || b.start_at });
      });
      briefs.filter((b) => Date.parse(b.created_at) > evCut && !bellSkip(b.email)).slice(0, 6).forEach((b) => {
        const lid = b.lead_id || ((allLeads || []).find((l) => l.email && b.email && l.email.toLowerCase() === b.email.toLowerCase()) || {}).id;
        bellItems.push({ kind: 'event', id: 'br' + b.id, lead_id: lid, title: '📋 Brief recibido: ' + (b.email || '') + (b.goal ? ' · ' + b.goal : ''), due: null, bucket: 'event', overdue: false, at: b.created_at });
      });
      (offersList || []).filter((o) => o.status === 'won' && !o.archived && !o.is_template && Date.parse(o.updated_at) > evCut && !bellSkip((leadById(o.lead_id) || {}).email)).slice(0, 6).forEach((o) => {
        bellItems.push({ kind: 'event', id: 'ow' + o.id, lead_id: o.lead_id, title: '🏆 Oferta ganada: ' + (o.title || '') + ' · ' + fmtM(offerNet(o)), due: null, bucket: 'event', overdue: false, at: o.updated_at });
      });
      acceptedProps().filter((p) => Date.parse(p.accepted_at || p.updated_at) > evCut && !bellSkip((leadById(p.lead_id) || {}).email)).slice(0, 6).forEach((p) => {
        bellItems.push({ kind: 'event', id: 'pw' + p.id, lead_id: p.lead_id, title: '🏆 Propuesta aceptada: ' + (p.title || '') + (Number(p.accepted_total) ? ' · ' + fmtM(p.accepted_total) : ''), due: null, bucket: 'event', overdue: false, at: p.accepted_at || p.updated_at });
      });
      (dealsList || []).filter((d) => stageOf(d.stage) === 'ganado' && d.won_at && Date.parse(d.won_at) > evCut && !bellSkip((leadById(d.lead_id) || {}).email)).forEach((d) => {
        const l = leadById(d.lead_id) || {};
        bellItems.push({ kind: 'event', id: 'dw' + d.id, lead_id: d.lead_id, title: '🎉 Deal ganado: ' + (d.title || l.name || l.email || '') + ' · ' + fmtM(dealValue(d)), due: null, bucket: 'event', overdue: false, at: d.won_at });
      });
      /* Los avisos del buzón. Van primero porque son lo que acaba de pasar; y los que
         son para otra persona no se muestran. */
      ((aq && !aq.error && aq.data) || []).forEach((a) => {
        if (a.para && meEmail && String(a.para).toLowerCase() !== meEmail) return;
        bellItems.push({ kind: 'aviso', id: 'av' + a.id, lead_id: null, url: a.url,
          sub: a.url && /proyecto=/.test(String(a.url)) ? 'Proyecto ' + String(a.url).split('proyecto=')[1].split('&')[0] : '',
          title: a.title + (a.body ? ' · ' + String(a.body).slice(0, 90) : ''),
          due: null, bucket: 'event', overdue: false, at: a.created_at });
      });
      bellItems = bellItems.filter((i) => !bellDismissed.has(i.kind + ':' + i.id));
      renderBell();
    } catch (e) { /* si no corrió el SQL 0010, la campana queda vacía */ renderBell(); }
  }
  function renderBell(){
    const badge = $('bell-badge');
    const urgent = bellItems.filter((i) => i.bucket === 'overdue' || i.bucket === 'today' || i.bucket === 'mention' || i.bucket === 'newlead' || i.bucket === 'event').length;
    if (urgent > 0) { badge.hidden = false; badge.textContent = urgent > 99 ? '99+' : urgent; } else badge.hidden = true;
    const order = { newlead: 0, event: 1, overdue: 2, today: 3, mention: 4, later: 5, nodate: 6 };
    const labels = { newlead: ['🎬 Leads nuevos', false], event: ['🔔 Novedades', false], overdue: ['⚠️ Vencidas', true], today: ['📅 Para hoy', false], mention: ['💬 Te mencionaron', false], later: ['🕒 Próximas', false], nodate: ['📌 Sin fecha', false] };
    const list = $('bell-list');
    if (!bellItems.length) { list.innerHTML = '<div class="bell-empty">Nada pendiente 🎉<br>Las tareas que crees en un lead aparecen acá.</div>'; return; }
    const grouped = {};
    bellItems.forEach((i) => { (grouped[i.bucket] = grouped[i.bucket] || []).push(i); });
    const fmtDue = (i) => i.due ? (i.due.toLocaleDateString('es-CH', { day: '2-digit', month: 'short' }) + (i.time ? ' ' + i.time : '')) : '';
    let html = '';
    Object.keys(grouped).sort((a, b) => (order[a] ?? 9) - (order[b] ?? 9)).forEach((b) => {
      const [lbl, od] = labels[b] || [b, false];
      html += '<div class="bell-grp' + (od ? ' od' : '') + '">' + lbl + ' (' + grouped[b].length + ')</div>';
      grouped[b].forEach((i) => {
        /* El subtítulo era leadName(i.lead_id) SIEMPRE, y para un aviso que no es de
           ninguna persona eso devolvía la palabra "Lead" — un aviso sobre un proyecto
           firmado como si fuera de un contacto. */
        const sub = i.lead_id ? esc(leadName(i.lead_id)) : (i.sub ? esc(i.sub) : '');
        html += '<div class="bell-row"><button class="bell-item" data-lead="' + esc(i.lead_id) + '" data-url="' + esc(i.url || '') + '" type="button"><span class="bi-t">' + (i.kind === 'mention' ? '💬 ' : '') + esc(i.title || '(sin título)') + '</span><span class="bi-s">' + sub + (i.due ? (sub ? ' · ' : '') + '<span class="bi-due' + (i.overdue ? ' od' : '') + '">' + fmtDue(i) + '</span>' : '') + '</span>' + (i.at ? '<span class="bi-at">hace ' + timeAgo(i.at) + '</span>' : '') + '</button>' +
          '<button class="bell-dis" data-k="' + esc(i.kind + ':' + i.id) + '" type="button" title="Descartar esta notificación" aria-label="Descartar">✕</button></div>';
      });
    });
    list.innerHTML = html;
    /* Cada aviso ya venía con su destino (`url`) desde el buzón —el del brief apunta al
       proyecto— pero el click lo ignoraba y mandaba TODO a Personas, con openLead(null)
       cuando el aviso no era de nadie.
       (Sebastián, 26 ago 2026: "la notificacion me sigue llevando a personas no al
        proyecto donde esta la info".) */
    list.querySelectorAll('.bell-item').forEach((b) => b.addEventListener('click', () => {
      $('bell-panel').hidden = true;
      if (b.dataset.url){ bellIr(b.dataset.url); return; }
