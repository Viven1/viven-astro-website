     prueba?
     El Set se guarda, pero atado al ARRAY que lo generó: `leadsPrueba` se rearma entero en
     cada loadAll, así que comparar la referencia alcanza para saber si hay que rehacerlo.
     Guardarlo en una constante suelta lo dejaba viejo tras el primer refresco; rehacerlo en
     cada llamada costaba un Set nuevo por cada fila de cada lista filtrada. */
  let _dpArr = null, _dpSet = null;
  const esDePrueba = (x) => {
    if (!x) return false;
    if (_dpArr !== leadsPrueba){ _dpArr = leadsPrueba; _dpSet = new Set((leadsPrueba || []).map((l) => String(l.id))); }
    return _dpSet.has(String(x.lead_id));
  };
  const chipPrueba = (x) => esDePrueba(x) ? '<span class="chip-prueba">🧪 Prueba</span> ' : '';

  const pjCHF = (n) => 'CHF ' + Math.round(Number(n) || 0).toLocaleString('de-CH');
  const pjEtapa = (k) => PJ_ETAPAS.find((e) => e.k === k) || PJ_ETAPAS[0];
  const pjDias = (iso) => iso ? Math.floor((Date.now() - Date.parse(iso)) / 864e5) : null;
  /* Lo facturado de un proyecto sale de las facturas que bexio-invoice registra de
     nuestro lado. Se atan por oferta o por persona: una factura sin ninguno de los dos
     no se le puede adjudicar a nadie, y adivinar sería peor que no contarla. */
  const pjFacturado = (p) => (pjInvoices || [])
    .filter((i) => String(i.lead_id || '') === String(p.lead_id || '') && i.lead_id)
    .reduce((a, i) => a + (Number(i.gross) || 0), 0);

  /* La promesa de la carga en curso. Sin esto, quien quiere abrir un proyecto por su
     número tenía que adivinar cuánto tarda —reintentar cada 250 ms y rendirse a los 5
     segundos— y en una conexión lenta se rendía antes de que llegara la lista: "No
     encontré el proyecto 1202" con el proyecto ahí, cargando.
     (Sebastián, 26 ago 2026.) */
  let pjLoadP = null;

  function pjLoad(){ pjLoadP = pjLoadReal(); return pjLoadP; }

  async function pjLoadReal(){
    if (!pjBound){ pjBound = true; pjBind(); }
    const [pq, iq] = await Promise.all([
      supabase.from('projects').select('*').eq('archived', false).order('started_at', { ascending: false }),
      supabase.from('invoices').select('id,lead_id,offer_id,gross,net,status,number,issued_at'),
    ]);
    if (pq.error){
      $('pj-list').innerHTML = '<p class="muted-note">⚠️ ' + esc(pq.error.message) + ' (¿corriste la SQL 0152?)</p>';
      return;
    }
    pjList = pq.data || [];
    pjInvoices = (iq && !iq.error) ? (iq.data || []) : [];
    /* El proyecto abierto apunta a un objeto de la lista vieja: se lo reemplaza por el
       fresco para que lo que estás mirando no quede congelado en lo que había al entrar. */
    if (pjCur){
      const vivo = pjList.find((x) => String(x.id) === String(pjCur.id));
      if (vivo) pjCur = vivo; else pjCur = null;   // lo archivaron o lo borraron desde otra ventana
    }
    const pill = $('tab-pj-count');
    if (pill){ pill.textContent = pjList.length || ''; pill.hidden = !pjList.length; }
    pjRenderList();
  }

  /* LA PLATA DE PRUEBA NO SE SUMA. Los proyectos 1202 y 1203 —los dos de prueba— metían
     CHF 18.036 en «En producción»: la pantalla decía 40.394 donde lo real eran 22.358.
     Los 12.000 de uno de ellos son exactamente los que Sebastián ya preguntó de dónde
     salían (26 ago); se arregló para los deals y quedó vivo acá.
     Se filtra al SUMAR, nunca al cargar: la lista los sigue teniendo —se pueden abrir, y
     de ahí salen el portal y el brief— pero no cuentan como plata ni como rodaje.
     Ver filtrar-pruebas-rompe-lo-que-no-es-plata. */
  function pjEsPrueba(p){
    const ids = new Set((leadsPrueba || []).map((l) => String(l.id)));
    return !!p && ids.has(String(p.lead_id));
  }
  const pjReales = () => (pjList || []).filter((p) => !pjEsPrueba(p));

  function pjRenderList(){
    pjLimpiarBoton();
    /* Con un proyecto abierto, la lista se dibuja pero NO se muestra. pjLoad() termina
       llamando acá, y al recargar la página el proyecto que abrió la URL quedaba abierto
       medio segundo y después la lista lo tapaba: parecía que el link no funcionaba.
       (Sebastián, 26 ago 2026: "en el browser tampoco me lleva al proyecto".) */
    if (!pjCur){ $('pj-detail').hidden = true; $('pj-list-view').hidden = false; }

    // etapas con conteo y plata
    $('pj-etapas').innerHTML = PJ_ETAPAS.map((e) => {
      const en = pjReales().filter((p) => p.stage === e.k);
      const chf = en.reduce((a, p) => a + (Number(p.amount_chf) || 0), 0);
      return '<button type="button" class="pj-et' + (pjFiltro === e.k ? ' on' : '') + '" data-et="' + e.k + '">' +
        '<div class="n">' + en.length + '</div><div class="l">' + esc(e.l) + '</div>' +
        '<div class="chf">' + (chf ? pjCHF(chf) : '—') + '</div></button>';
    }).join('');
    $('pj-etapas').querySelectorAll('[data-et]').forEach((b) => b.addEventListener('click', () => {
      pjFiltro = pjFiltro === b.dataset.et ? null : b.dataset.et;
      pjRenderList();
    }));

    // KPIs
    const vivos = pjReales().filter((p) => p.stage !== 'entregado');
    const enProd = vivos.reduce((a, p) => a + (Number(p.amount_chf) || 0), 0);
    const sinFact = pjReales().reduce((a, p) => a + Math.max(0, (Number(p.amount_chf) || 0) - pjFacturado(p)), 0);
    const hoy = new Date().toISOString().slice(0, 10);
    const en30 = new Date(Date.now() + 30 * 864e5).toISOString().slice(0, 10);
    const rodajes = pjReales().filter((p) => p.shoot_start && p.shoot_start >= hoy && p.shoot_start <= en30);
    /* "El más quieto": el que lleva más días en la misma etapa sin fecha de rodaje.
       Es el que más riesgo corre de quedarse dormido, y no tiene otro lugar donde
       aparecer — un proyecto ganado no vuelve al pipeline. */
    const quietos = vivos.filter((p) => !p.shoot_start)
      .map((p) => ({ p, d: pjDias(p.started_at) || 0 })).sort((a, b) => b.d - a.d);
    const pctFact = enProd > 0 ? Math.round((1 - sinFact / pjReales().reduce((a, p) => a + (Number(p.amount_chf) || 0), 0)) * 100) : 0;
    const k = (n, sub, l, alerta) => '<div class="kpi"><div class="n"' + (alerta ? ' style="color:#f0c060"' : '') + '>' + n +
      (sub ? '<small class="bajo">' + sub + '</small>' : '') + '</div><div class="l">' + l + '</div></div>';
    $('pj-kpis').innerHTML =
      k(enProd ? pjCHF(enProd) : '—', vivos.length + (vivos.length === 1 ? ' proyecto' : ' proyectos'), 'En producción') +
      k(sinFact ? pjCHF(sinFact) : 'CHF 0', sinFact ? (100 - pctFact) + '% del total' : 'todo facturado', 'Sin facturar', sinFact > 0) +
      k(rodajes.length || '—', rodajes.length ? 'próximo ' + fmtDMY(rodajes[0].shoot_start) : 'ninguno agendado', 'Rodajes en 30 días') +
      k(quietos.length ? quietos[0].d + ' días' : '—', quietos.length ? 'sin fecha de rodaje' : 'todos con fecha', 'El más quieto', !!quietos.length);

    // lista
    const rows = pjFiltro ? pjList.filter((p) => p.stage === pjFiltro) : pjList;
    if (!pjList.length){
      $('pj-list').innerHTML = '<p class="muted-note">Todavía no hay proyectos. Aparecen solos en cuanto un deal pasa a <b>Ganado</b> — con el monto y las posiciones del paquete que el cliente aceptó ya adentro.</p>';
      return;
    }
    if (!rows.length){ $('pj-list').innerHTML = '<p class="muted-note">Ninguno en esta etapa.</p>'; return; }
    $('pj-list').innerHTML = rows.map((p) => {
      const e = pjEtapa(p.stage);
      const fact = pjFacturado(p), monto = Number(p.amount_chf) || 0;
      const falta = Math.max(0, monto - fact);
      const l = leadById(p.lead_id) || {};
      const dias = pjDias(p.started_at);
      const avisos = [];
      if (p.stage !== 'entregado' && !p.shoot_start && dias != null && dias > 14) avisos.push(dias + ' días sin fecha de rodaje');
      if (p.delivery_due && p.delivery_due < hoy && p.stage !== 'entregado') avisos.push('la entrega venció el ' + fmtDMY(p.delivery_due));
      if (p.stage === 'entregado' && falta > 0) avisos.push('entregado y todavía falta facturar ' + pjCHF(falta));
      return '<button type="button" class="pj-fila" data-pj="' + p.id + '">' +
        '<span class="tit">' + (p.ref ? '<span class="pj-ref">' + esc(String(p.ref)) + '</span> ' : '') + chipPrueba(p) + esc(p.title || 'Proyecto') +
          '<small>' + esc([l.company, l.name].filter(Boolean).join(' · ') || (l.email || '')) +
          (p.started_at ? ' · ganado ' + fmtDMY(p.started_at) : '') + '</small></span>' +
        '<span class="pj-chip" style="color:' + e.color + '">' + esc(e.l) + '</span>' +
        '<span class="plata">' + (monto ? pjCHF(monto) : '—') +
          (monto ? '<small>' + (fact ? pjCHF(fact) + ' facturado' : 'sin facturar') + '</small>' : '') + '</span>' +
        (avisos.length ? '<span class="aviso">⚠ ' + esc(avisos.join(' · ')) + '</span>' : '') +
      '</button>';
    }).join('');
    $('pj-list').querySelectorAll('[data-pj]').forEach((b) => b.addEventListener('click', () => pjOpen(b.dataset.pj)));
  }

  function pjOpen(id){
    const p = pjList.find((x) => String(x.id) === String(id)); if (!p) return;
    pjCur = p;
    $('pj-list-view').hidden = true; $('pj-detail').hidden = false;
    window.scrollTo(0, 0);
    /* El proyecto abierto queda escrito en la URL. En el iPhone la app se recarga sola
       —vuelve del fondo, cambia de red, se queda sin memoria— y sin esto cada recarga
       devolvía a la lista, con lo que estabas mirando perdido.
       Es la misma URL que ya se comparte con Sofia (?proyecto=1202), así que también
       sirve de marcador.
       (Sebastián, 26 ago 2026: "en el iPhone, cuando hago refresh vuelve a proyectos, no
       al que estaba trabajando".) */
    pjUrl(p);
    pjPaso = null;              // cada proyecto arranca en donde está parado, no donde quedó el anterior
    pjRenderDetail();
    pjContactosLoad();
    pjBriefRespLoad();
  }

  /* ── El deal del proyecto abierto ──
     dealsList NO sirve para esto. Desde el 26 ago los deals cuyo lead está marcado como
     prueba se sacan de esa lista, para que un proyecto inventado no sume plata al mes. Pero
     el token del portal vive en el deal, así que al proyecto de prueba se le rompió el
     portal, el brief y la vista previa de golpe: "No pude generar el link del portal" sobre
     un deal que SÍ tenía token en la base.
     La plata se sigue calculando sin las pruebas; lo que cambia es que el proyecto que
     tenés abierto siempre encuentra su deal, esté o no en la lista.
     (Sebastián, 27 ago 2026, con el cartel rojo en pantalla.) */
  const pjDeals = new Map();

  async function pjDeal(proj){
    const p = proj || pjCur;
    if (!p || !p.deal_id) return null;
    const id = String(p.deal_id);
    const enLista = (dealsList || []).find((x) => String(x.id) === id);
    if (enLista) return enLista;
    if (pjDeals.has(id)) return pjDeals.get(id);
    const { data } = await supabase.from('deals').select('*').eq('id', id).maybeSingle();
    if (data) pjDeals.set(id, data);
    return data || null;
  }

  /* La versión sin esperar, para el dibujado: usa lo que ya esté a mano. */
  function pjDealYa(proj){
    const p = proj || pjCur;
    if (!p || !p.deal_id) return null;
    const id = String(p.deal_id);
    return (dealsList || []).find((x) => String(x.id) === id) || pjDeals.get(id) || null;
  }

  function pjUrl(p){
    try {
      history.replaceState({}, '', location.pathname +
        (p ? '?proyecto=' + encodeURIComponent(p.ref || p.id) : '?tab=projects'));
    } catch (e){ /* si el navegador no deja, no pasa nada: se pierde solo el volver al mismo lugar */ }
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     TÉCNICOS
     ═══════════════════════════════════════════════════════════════════════════
     La gente a la que le PAGAMOS. No son leads —a un lead se le vende— y mezclarlos
     ensuciaría el pipeline: el mes que contratamos seis freelance parecerían seis
     clientes nuevos.

     De dónde sale la plata de cada uno, en orden:
       1. `project_costs.crew_id` — lo nuevo, atado a la persona.
       2. `project_costs.person` — texto libre de antes, se resuelve por ALIAS.
       3. `project_bills.supplier` — el nombre que salió del PDF de la factura, también
          por alias. Es lo único que dice lo que se pagó de verdad.
     Y `projects.crew` dice en qué proyectos estuvo, aunque no haya plata cargada.

     Lo que NO hace: adivinar que dos nombres parecidos son la misma persona. Hay dos
     Martin y puede haber dos Sofia; unir a ciegas mezcla la plata de dos personas, que
     es el error caro. Por eso "Unir repetidos" propone y decide una persona.
     ═══════════════════════════════════════════════════════════════════════════ */
  let crewList = [], crewAlias = [], crewCur = null, crewBound = false, crewT = null;
  let crewRol = null;   // el rol elegido en el filtro de Técnicos

  const crewNorm = (x) => String(x || '').trim().toLowerCase();

  /* La ficha del técnico a partir del nombre que tiene el proyecto.
     El crew de un proyecto guarda el nombre como se escribió ahí —«Sofia»— y la ficha puede
     llamarse «Sofia Treviño». Buscando por igualdad exacta no se encuentra, y entonces el
     plan de rodaje sale «sin teléfono» para alguien que SÍ tiene teléfono cargado. Pasa hoy
     en el 1201.
     Primero exacto, y solo si no hay, por nombre contenido en cualquiera de los dos
     sentidos — y únicamente si eso da UN candidato: con dos «Martin» distintos, adivinar
     es peor que no encontrar. */
  function crewFicha(nombre, lista){
    const l = lista || crewList || [];
    const n = crewNorm(nombre);
    if (!n) return null;
    const exacto = l.find((x) => crewNorm(x.name) === n);
    if (exacto) return exacto;
    const parciales = l.filter((x) => {
      const c = crewNorm(x.name);
      return c && (c.startsWith(n + ' ') || n.startsWith(c + ' '));
    });
    return parciales.length === 1 ? parciales[0] : null;
  }

  async function crewLoad(){
    if (!crewBound){ crewBound = true; crewBind(); }
    const [cq, aq] = await Promise.all([
      supabase.from('crew').select('*').order('name'),
      supabase.from('crew_alias').select('*'),
    ]);
    if (cq.error){
      $('crew-list').innerHTML = '<p class="muted-note">⚠️ ' + esc(cq.error.message) + ' (¿corriste la SQL 0169?)</p>';
      return;
    }
    crewList = cq.data || [];
    crewAlias = aq.error ? [] : (aq.data || []);
    const pill = $('tab-crew-count');
    if (pill){ pill.textContent = crewList.length || ''; pill.hidden = !crewList.length; }
    /* Los proyectos y los costos hacen falta para la plata: si se entró directo a esta
       pestaña puede que todavía no estén. */
    if (!pjList.length) await pjLoad();
    await crewPlataLoad();
    crewRenderList();
  }

  /* Los costos y las facturas de TODOS los proyectos, una sola vez. Pedirlos por técnico
     serían ocho consultas para ocho personas, y treinta cuando el equipo crezca. */
  let crewCostos = [], crewBills = [];
  async function crewPlataLoad(){
    const [cq, bq] = await Promise.all([
      supabase.from('project_costs').select('project_id,person,crew_id,concept,kind,qty,unit,unit_cost,paid'),
      supabase.from('project_bills').select('project_id,crew_id,supplier,net,gross,bill_date,estado'),
    ]);
    crewCostos = cq.error ? [] : (cq.data || []);
    crewBills = bq.error ? [] : (bq.data || []);
  }

  /* Todo lo de una persona: sus alias, sus proyectos y su plata. */
  function crewDatos(c){
    const alias = crewAlias.filter((a) => String(a.crew_id) === String(c.id)).map((a) => crewNorm(a.alias));
    const nombres = new Set([crewNorm(c.name), ...alias]);
    const esSuyo = (x) => nombres.has(crewNorm(x));

    const costos = crewCostos.filter((k) =>
      String(k.crew_id || '') === String(c.id) || (k.person && esSuyo(k.person)));
    const bills = crewBills.filter((b) =>
      String(b.crew_id || '') === String(c.id) || (b.supplier && esSuyo(b.supplier)));

    /* Los proyectos donde figura en el crew, aunque no haya un franco cargado: haber
       trabajado y no haberle cargado el costo es normal, no es que no estuvo. */
    const proyectos = (pjList || []).filter((p) => {
      const cr = Array.isArray(p.crew) ? p.crew : [];
      return cr.some((x) => x && esSuyo(x.nombre)) ||
             costos.some((k) => String(k.project_id) === String(p.id)) ||
             bills.some((b) => String(b.project_id) === String(p.id));
    });

    /* Presupuestado ≠ pagado. Un costo cargado es lo que PENSAMOS pagarle; una factura
       es lo que salió de la caja. Mezclarlos da un número que no es ninguno de los dos.
       (Es el mismo error que "confirmado no es pagado".) */
    const presupuestado = costos.reduce((a, k) => a + (Number(k.qty) || 0) * (Number(k.unit_cost) || 0), 0);
    const facturado = bills.reduce((a, b) => a + (Number(b.net) || Number(b.gross) || 0), 0);
    const roles = [...new Set([
      ...(Array.isArray(c.roles) ? c.roles : []),
      ...proyectos.flatMap((p) => (Array.isArray(p.crew) ? p.crew : []).filter((x) => x && esSuyo(x.nombre)).map((x) => x.rol)),
    ].filter(Boolean))];

    return { alias, costos, bills, proyectos, presupuestado, facturado, roles };
  }

  function crewRenderList(){
    $('crew-detail').hidden = true; $('crew-list-view').hidden = false;
    const q = crewNorm(($('crew-q') || {}).value);
    const datos = crewList.map((c) => ({ c, d: crewDatos(c) }));

    const totalPag = datos.reduce((a, x) => a + x.d.facturado, 0);
    const conProyecto = datos.filter((x) => x.d.proyectos.length).length;
    $('crew-kpis').innerHTML = [
      ['Técnicos', crewList.length, 'en la libreta'],
      ['Con proyecto', conProyecto, 'trabajaron con nosotros'],
      ['Pagado', pjCHF(totalPag), 'facturas de crew cargadas'],
      ['Roles', [...new Set(datos.flatMap((x) => x.d.roles))].length, 'distintos'],
    ].map(([l, n, s2]) => '<div class="kpi"><div class="kpi-l">' + esc(l) + '</div><div class="kpi-n">' + esc(n) +
      '</div><div class="kpi-s">' + esc(s2) + '</div></div>').join('');

    /* Los roles que existen de verdad, con cuántos hay de cada uno. Salen de los datos, no
       de una lista fija: un rol nuevo aparece solo la primera vez que se usa. */
    const cuenta = new Map();
    datos.forEach((x) => x.d.roles.forEach((r) => cuenta.set(r, (cuenta.get(r) || 0) + 1)));
    const roles = [...cuenta.entries()].sort((a, b) => b[1] - a[1] || String(a[0]).localeCompare(String(b[0])));
    $('crew-roles').innerHTML = !roles.length ? '' :
      '<button type="button" data-rol="" class="' + (crewRol ? '' : 'on') + '">Todos ' + datos.length + '</button>' +
      roles.map(([r, n]) => '<button type="button" data-rol="' + esc(r) + '" class="' + (crewRol === r ? 'on' : '') + '">' +
        esc(r) + ' ' + n + '</button>').join('');
    $('crew-roles').querySelectorAll('[data-rol]').forEach((b) => b.addEventListener('click', () => {
      crewRol = b.dataset.rol || null;
      crewRenderList();
    }));

    const porRol = crewRol ? datos.filter((x) => x.d.roles.includes(crewRol)) : datos;
    const filtrados = !q ? porRol : porRol.filter((x) =>
      crewNorm(x.c.name).includes(q) || x.d.roles.some((r) => crewNorm(r).includes(q)) ||
      crewNorm(x.c.empresa).includes(q));

    $('crew-list').innerHTML = !filtrados.length
      ? '<p class="muted-note" style="margin:0">' + (q || crewRol ? 'Nadie con eso.' : 'Todavía no hay técnicos. Se cargan solos cuando ponés gente en el crew de un proyecto.') + '</p>'
      : '<div class="lead-table-wrap"><table class="lead-table"><thead><tr><th>Técnico</th><th>Roles</th><th>Proyectos</th>' +
        '<th style="text-align:right">Presupuestado</th><th style="text-align:right">Pagado</th></tr></thead><tbody>' +
        filtrados.map(({ c, d }) =>
          '<tr style="cursor:pointer" data-crew="' + c.id + '">' +
            '<td><b>' + esc(c.name) + '</b>' + (c.interno ? ' <span class="muted-note">· interno</span>' : '') +
              (c.empresa ? '<br><span class="muted-note" style="font-size:11.5px">' + esc(c.empresa) + '</span>' : '') +
              (c.email ? '<br><span class="muted-note" style="font-size:11.5px">' + esc(c.email) + '</span>' : '') + '</td>' +
            '<td>' + (d.roles.length ? d.roles.map((r) => '<span class="pj-chipn">' + esc(r) + '</span>').join(' ') : '<span class="muted-note">—</span>') + '</td>' +
            '<td>' + (d.proyectos.length
              ? d.proyectos.length + '<br><span class="muted-note" style="font-size:11.5px">' + esc(d.proyectos.map((p) => p.ref).filter(Boolean).join(', ')) + '</span>'
              : '<span class="muted-note">—</span>') + '</td>' +
            '<td style="text-align:right">' + (d.presupuestado ? pjCHF(d.presupuestado) : '<span class="muted-note">—</span>') + '</td>' +
            '<td style="text-align:right">' + (d.facturado ? '<b>' + pjCHF(d.facturado) + '</b>' : '<span class="muted-note">—</span>') + '</td>' +
          '</tr>').join('') + '</tbody></table></div>';

    $('crew-list').querySelectorAll('[data-crew]').forEach((tr) =>
      tr.addEventListener('click', () => crewOpen(tr.dataset.crew)));
  }

  function crewOpen(id){
    const c = crewList.find((x) => String(x.id) === String(id)); if (!c) return;
    crewCur = c;
    $('crew-list-view').hidden = true; $('crew-detail').hidden = false;
    window.scrollTo(0, 0);
    crewRenderDetail();
  }

  function crewRenderDetail(){
    const c = crewCur; if (!c) return;
    const d = crewDatos(c);
    $('crew-name').textContent = c.name;
    $('crew-sub').textContent = [d.roles.join(' · '), c.empresa, c.ciudad].filter(Boolean).join(' — ') || 'sin rol cargado';
    $('crew-total').textContent = pjCHF(d.facturado);
    $('crew-total-sub').textContent = d.presupuestado
      ? 'pagado · ' + pjCHF(d.presupuestado) + ' presupuestado'
      : 'pagado';

    const campo = (k, id, v, ph, tipo) =>
      '<div class="pj-kv"><span class="k">' + k + '</span><span class="v">' +
      '<input class="pj-inp" id="' + id + '" ' + (tipo ? 'type="' + tipo + '" ' : '') +
      'value="' + esc(v == null ? '' : v) + '" placeholder="' + esc(ph || '') + '" /></span></div>';

    $('crew-datos').innerHTML =
      campo('Nombre', 'crew-f-name', c.name, '') +
      campo('Email', 'crew-f-email', c.email, 'para mandarle el plan y las notas', 'email') +
      campo('Teléfono', 'crew-f-phone', c.phone, '+41 …') +
      campo('Ciudad', 'crew-f-ciudad', c.ciudad, 'Zürich') +
      /* En qué idioma se le escribe. El plan de rodaje salía en español para todo el equipo
         dando por sentado que el equipo trabaja en español — solo Sebastián y Sofia.
         Vacío = alemán, que es donde estamos, y lo dice para que no parezca una decisión
         tomada cuando en realidad es un dato que falta.
         (Sebastián, 27 ago 2026: "solo sofia y yo trabajamos en español, el resto en alemán,
          inglés".) */
      '<div class="pj-kv"><span class="k">Le escribimos en</span><span class="v">' +
        '<select class="pj-inp" id="crew-f-idioma">' +
        [['', 'Alemán — sin definir'], ['de', 'Alemán'], ['en', 'Inglés'], ['es', 'Español']]
          .map(([k, l]) => '<option value="' + k + '"' + ((c.idioma || '') === k ? ' selected' : '') + '>' + l + '</option>').join('') +
        '</select></span></div>' +
      campo('Factura como', 'crew-f-empresa', c.empresa, 'si factura por una GmbH') +
      '<div class="pj-kv"><span class="k">Roles</span><span class="v">' +
        '<input class="pj-inp" id="crew-f-roles" value="' + esc((c.roles || []).join(', ')) + '" placeholder="DoP, Gaffer" /></span></div>' +
      '<div class="pj-kv"><span class="k">Es de casa</span><span class="v">' +
        '<label style="display:flex;gap:8px;align-items:center;font-size:13px;color:var(--muted)">' +
        '<input type="checkbox" id="crew-f-interno"' + (c.interno ? ' checked' : '') + ' /> no nos factura — es parte del equipo</label></span></div>' +
      (d.alias.length > 1
        ? '<p class="muted-note" style="margin:10px 0 0">También aparece como: ' + esc(d.alias.filter((a) => a !== crewNorm(c.name)).join(', ')) + '</p>'
        : '');

    $('crew-tarifas').innerHTML =
      campo('Por día', 'crew-f-tdia', c.tarifa_dia, 'CHF', 'number') +
      campo('Por hora', 'crew-f-thora', c.tarifa_hora, 'CHF', 'number') +
      campo('IBAN', 'crew-f-iban', c.iban, 'CH..') +
      '<p class="muted-note" style="margin:10px 0 0">La tarifa es el punto de partida para presupuestar. Lo que se le pagó de verdad sale de sus facturas, abajo.</p>';

    $('crew-notas').value = c.notas || '';

    $('crew-proy-est').textContent = d.proyectos.length
      ? d.proyectos.length + (d.proyectos.length === 1 ? ' proyecto' : ' proyectos')
      : 'todavía ninguno';
    $('crew-proyectos').innerHTML = !d.proyectos.length
      ? '<p class="muted-note" style="margin:0">Todavía no estuvo en ningún proyecto. Se engancha solo cuando lo ponés en el crew de uno.</p>'
      : '<div class="lead-table-wrap"><table class="lead-table"><thead><tr><th>Proyecto</th><th>Rol</th><th>Cuándo</th>' +
        '<th style="text-align:right">Presupuestado</th><th style="text-align:right">Pagado</th></tr></thead><tbody>' +
        d.proyectos.map((p) => {
          const nombres = new Set([crewNorm(c.name), ...d.alias]);
          const rol = (Array.isArray(p.crew) ? p.crew : []).filter((x) => x && nombres.has(crewNorm(x.nombre))).map((x) => x.rol).filter(Boolean).join(', ');
          const pres = d.costos.filter((k) => String(k.project_id) === String(p.id))
            .reduce((a, k) => a + (Number(k.qty) || 0) * (Number(k.unit_cost) || 0), 0);
          const pag = d.bills.filter((b) => String(b.project_id) === String(p.id))
            .reduce((a, b) => a + (Number(b.net) || Number(b.gross) || 0), 0);
          return '<tr><td><a href="#" data-pj="' + p.ref + '" style="color:var(--acid)">' +
              (p.ref ? '<b>' + p.ref + '</b> · ' : '') + esc(p.title || '') + '</a></td>' +
            '<td>' + (rol ? esc(rol) : '<span class="muted-note">—</span>') + '</td>' +
            '<td>' + (p.shoot_start ? fmtDMY(p.shoot_start) : '<span class="muted-note">sin fecha</span>') + '</td>' +
            '<td style="text-align:right">' + (pres ? pjCHF(pres) : '—') + '</td>' +
            '<td style="text-align:right">' + (pag ? '<b>' + pjCHF(pag) + '</b>' : '—') + '</td></tr>';
        }).join('') + '</tbody></table></div>';
    $('crew-proyectos').querySelectorAll('[data-pj]').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault(); gotoTab('projects'); abrirProyectoPorRef(a.dataset.pj);
    }));

    /* Por mes: solo de las FACTURAS. Un costo presupuestado no tiene fecha de pago, así
       que ponerlo en un mes sería inventarle una. */
    const meses = {};
    d.bills.forEach((b) => {
      const m = String(b.bill_date || '').slice(0, 7);
      if (!m) return;
      meses[m] = (meses[m] || 0) + (Number(b.net) || Number(b.gross) || 0);
    });
    const ks = Object.keys(meses).sort().reverse();
    const anios = {};
    ks.forEach((m) => { const a = m.slice(0, 4); anios[a] = (anios[a] || 0) + meses[m]; });
    $('crew-meses').innerHTML = !ks.length
      ? '<p class="muted-note" style="margin:0">Sin facturas suyas cargadas. Las facturas del crew se suben en cada proyecto y de ahí sale este número — un costo presupuestado no tiene fecha de pago, así que no cuenta acá.</p>'
      : Object.keys(anios).sort().reverse().map((a) =>
          '<div class="pj-sec-h">' + a + ' · <b style="color:var(--text)">' + pjCHF(anios[a]) + '</b></div>' +
          '<div class="lead-table-wrap"><table class="lead-table"><tbody>' +
          ks.filter((m) => m.startsWith(a)).map((m) =>
            '<tr><td>' + esc(new Date(m + '-01T00:00:00').toLocaleDateString('es', { month: 'long' })) + '</td>' +
            '<td style="text-align:right"><b>' + pjCHF(meses[m]) + '</b></td></tr>').join('') +
          '</tbody></table></div>').join('');

    /* Se guarda solo, como en proyectos: "si cambio, borro o hago algo pero no toco
       guardar, guardalo igual". */
    ['crew-f-name', 'crew-f-email', 'crew-f-phone', 'crew-f-ciudad', 'crew-f-empresa',
     'crew-f-roles', 'crew-f-tdia', 'crew-f-thora', 'crew-f-iban', 'crew-notas']
      .forEach((id) => { const el = $(id); if (el) el.addEventListener('input', crewGuardarDebounce); });
    $('crew-f-interno').addEventListener('change', crewGuardar);
    $('crew-f-idioma') && $('crew-f-idioma').addEventListener('change', crewGuardar);
  }

  function crewGuardarDebounce(){ clearTimeout(crewT); crewT = setTimeout(crewGuardar, 700); }

  async function crewGuardar(){
    const c = crewCur; if (!c) return;
    const num = (id) => { const v = String(($(id) || {}).value || '').trim(); return v === '' ? null : (Number(v) || null); };
    const txt = (id) => { const v = String(($(id) || {}).value || '').trim(); return v === '' ? null : v; };
    const patch = {
      name: txt('crew-f-name') || c.name,
      email: (txt('crew-f-email') || '').toLowerCase() || null,
      phone: txt('crew-f-phone'), ciudad: txt('crew-f-ciudad'), empresa: txt('crew-f-empresa'),
      roles: String(($('crew-f-roles') || {}).value || '').split(',').map((x) => x.trim()).filter(Boolean),
      tarifa_dia: num('crew-f-tdia'), tarifa_hora: num('crew-f-thora'),
      iban: txt('crew-f-iban'), notas: txt('crew-notas'),
      /* Vacío se guarda como null: «no lo sabemos» es distinto de «decidimos alemán», y esa
         diferencia es la que deja ver a quién le falta el dato. */
      idioma: txt('crew-f-idioma'),
      interno: !!($('crew-f-interno') || {}).checked,
    };
    const { error } = await supabase.from('crew').update(patch).eq('id', c.id);
    if (error){ $('crew-msg').textContent = '⚠️ ' + error.message; return; }
    Object.assign(c, patch);
    $('crew-msg').textContent = 'Guardado.';
    setTimeout(() => { if ($('crew-msg')) $('crew-msg').textContent = ''; }, 1600);
    /* Si le cambió el nombre, ese nombre nuevo también es un alias: los costos y las
       facturas viejas siguen diciendo el anterior. */
    if (patch.name && crewNorm(patch.name) !== crewNorm(c.name)) await crewAliasAgregar(c.id, patch.name);
    $('crew-name').textContent = patch.name;
  }

  async function crewAliasAgregar(crewId, alias){
    if (!alias) return;
    const { data } = await supabase.from('crew_alias')
      .upsert({ crew_id: crewId, alias }, { onConflict: 'alias' }).select();
    if (data && data.length) crewAlias.push(data[0]);
  }

  async function crewNuevo(){
    const nombre = String(prompt('Nombre del técnico:') || '').trim();
    if (!nombre) return;
    const { data, error } = await supabase.from('crew').insert({ name: nombre }).select().single();
    if (error){ toast(error.message); return; }
    crewList.push(data);
    await crewAliasAgregar(data.id, nombre);
    crewOpen(data.id);
  }

  /* Unir repetidos: propone los pares donde un nombre es prefijo del otro —"Sofia" y
     "Sofia Treviño"— pero NO une nada solo. Que dos nombres se parezcan no prueba que
     sean la misma persona: hay dos Martin, y unir a ciegas mezcla la plata de dos
     personas distintas. */
  function crewFusionar(){
    const pares = [];
    crewList.forEach((a) => crewList.forEach((b) => {
      if (a.id >= b.id) return;
      const na = crewNorm(a.name), nb = crewNorm(b.name);
      const mismo = (a.email && b.email && crewNorm(a.email) === crewNorm(b.email)) ||
                    na.startsWith(nb + ' ') || nb.startsWith(na + ' ');
      if (mismo) pares.push([a, b]);
    }));
    if (!pares.length){ toast('No encontré fichas que parezcan la misma persona'); return; }
    const [a, b] = pares[0];
    /* El que se queda es el del nombre MÁS LARGO: "Sofia Treviño" identifica mejor que
       "Sofia", y el corto pasa a ser su alias. */
    const queda = a.name.length >= b.name.length ? a : b, va = queda === a ? b : a;
    if (!confirm('¿«' + va.name + '» y «' + queda.name + '» son la misma persona?\n\n' +
                 'Queda «' + queda.name + '», y «' + va.name + '» pasa a ser otro nombre suyo — sus proyectos y su plata se le suman.\n\n' +
                 (pares.length > 1 ? 'Hay ' + pares.length + ' pares parecidos; los demás se preguntan después.' : ''))) return;
    (async () => {
      await crewAliasAgregar(queda.id, va.name);
      const suyos = crewAlias.filter((x) => String(x.crew_id) === String(va.id));
      for (const al of suyos) await supabase.from('crew_alias').update({ crew_id: queda.id }).eq('id', al.id);
      await supabase.from('project_costs').update({ crew_id: queda.id }).eq('crew_id', va.id);
      await supabase.from('project_bills').update({ crew_id: queda.id }).eq('crew_id', va.id);
      const { error } = await supabase.from('crew').delete().eq('id', va.id);
      if (error){ toast(error.message); return; }
      toast('🔗 Unidos en «' + queda.name + '»');
      crewLoad();
    })();
  }

  /* ── Importar contactos de técnicos ──
     Dos caminos porque los datos viven en dos sitios: los que ya son contactos del CRM, y
     los que están en la libreta de alguien. Ninguno de los siete tenía email ni teléfono,
     así que el plan de rodaje salía "sin teléfono" para todos.
     Nunca pisa un dato que ya está: solo completa lo que falta. Un email viejo corregido a
     mano no puede perderse porque el CRM tenga otro. */
  async function ciAbrir(){
    /* Si los técnicos todavía no llegaron, se abre igual y se redibuja cuando llegan: es
       mejor que un modal que no abre porque se adelantó a los datos. */
    if (!crewList.length){
      crewLoad().then(() => { if (!$('ci-modal').hidden) ciAbrir(); });
    }
    const norm = (x) => String(x || '').toLowerCase().trim();

    /* Segunda fuente: las direcciones a las que YA les escribimos. A Martin le mandamos
       emails a martinarya@gmail.com y en Personas figura con martinarya6@gmail.com — dos
       direcciones distintas de la misma persona, y la que sirve es a la que contestó.
       Se busca por el nombre de pila dentro de la dirección, que es como se escriben casi
       todas: nombre@ o nombreapellido@. */
    let porEmail = [];
    try {
      const sinDatos = (crewList || []).filter((c) => !c.email);
      if (sinDatos.length){
        const { data } = await supabase.from('email_log')
          .select('to_addr,created_at').not('to_addr', 'is', null)
          .order('created_at', { ascending: false }).limit(600);
        const vistos = new Set();
        (data || []).forEach((e) => {
          const dir = norm(e.to_addr);
          if (!dir.includes('@') || vistos.has(dir)) return;
          const usuario = dir.split('@')[0];
          const quien = sinDatos.find((c) => {
            const pila = norm(c.name).split(/\s+/)[0];
            return pila.length >= 4 && usuario.includes(pila);
          });
          if (quien){ vistos.add(dir); porEmail.push({ crew: quien, email: e.to_addr, tel: '', fuente: 'le escribimos' }); }
        });
      }
    } catch (e){ console.error('CI_EMAILS', e && e.message); }
    const sinDato = (c) => !c.email || !c.phone;
    /* El match es por nombre contenido, en cualquiera de los dos sentidos: la ficha dice
       "Martin" y la persona "Martin Arya". */
    const props = [];
    (crewList || []).filter(sinDato).forEach((c) => {
      const n = norm(c.name); if (!n) return;
      (allLeads || []).forEach((l) => {
        const ln = norm(l.name);
        if (!ln || !l.email) return;
        if (!(ln.includes(n) || n.includes(ln))) return;
        props.push({ crew: c, lead: l, email: l.email, tel: l.phone || '' });
      });
    });
    /* Las dos fuentes juntas, sin repetir la misma dirección para la misma persona. */
    porEmail.forEach((x) => {
      if (!props.some((p2) => p2.crew.id === x.crew.id && norm(p2.email) === norm(x.email))) props.push(x);
    });
    ciProps = props;
    $('ci-match').innerHTML = props.length
      ? props.map((x, i) => '<label class="ci-row"><input type="checkbox" data-ci="' + i + '" checked />' +
          '<span><b>' + esc(x.crew.name) + '</b>' +
          (x.crew.roles && x.crew.roles.length ? ' <span class="muted-note">' + esc(x.crew.roles.join(', ')) + '</span>' : '') +
          '<span class="ci-d">' + esc(x.email) + (x.tel ? ' · ' + esc(x.tel) : '') +
          ' <span class="muted-note">— ' + (x.lead ? 'de «' + esc(x.lead.name || x.lead.email) + '» en Personas' : esc(x.fuente || 'de un email nuestro')) + '</span></span></span></label>').join('')
      : '<p class="muted-note" style="margin:0 0 4px">No encontré a ninguno en Personas ni en los emails que mandamos. Usá el cuadro de abajo.</p>';
    $('ci-pegar').value = '';
    $('ci-msg').textContent = '';
    $('ci-modal').hidden = false;
  }
  let ciProps = [];

  async function ciGuardar(){
    const btn = $('ci-go');
    btn.disabled = true; btn.textContent = 'Guardando…';
    let tocados = 0, creados = 0;
    try {
      /* 1. Los que se tildaron de Personas. */
      const marcados = [...$('ci-match').querySelectorAll('[data-ci]')].filter((c) => c.checked).map((c) => ciProps[+c.dataset.ci]);
      for (const x of marcados){
        const patch = {};
        if (!x.crew.email && x.email) patch.email = x.email;
        if (!x.crew.phone && x.tel) patch.phone = x.tel;
        if (!Object.keys(patch).length) continue;
        const { error } = await supabase.from('crew').update(patch).eq('id', x.crew.id);
        if (error) throw new Error(error.message);
        Object.assign(x.crew, patch); tocados++;
      }

      /* 2. Lo pegado. Coma o tabulación, y el email se reconoce por la arroba: así una
         línea "Tobias, +41 79 …, tobias@…" entra igual que en el orden esperado. */
      const lineas = $('ci-pegar').value.split('\n').map((l) => l.trim()).filter(Boolean);
      for (const linea of lineas){
        const partes = linea.split(/[,;\t]+/).map((x) => x.trim()).filter(Boolean);
        if (!partes.length) continue;
        const email = partes.find((x) => /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(x)) || null;
        const tel = partes.find((x) => x !== email && /[\d]{6,}/.test(x.replace(/[^\d]/g, ''))) || null;
        const nombre = partes.find((x) => x !== email && x !== tel);
        if (!nombre) continue;
        const ya = (crewList || []).find((c) => String(c.name || '').toLowerCase().trim() === nombre.toLowerCase());
        if (ya){
          const patch = {};
          if (!ya.email && email) patch.email = email;
          if (!ya.phone && tel) patch.phone = tel;
          if (!Object.keys(patch).length) continue;
          const { error } = await supabase.from('crew').update(patch).eq('id', ya.id);
          if (error) throw new Error(error.message);
          Object.assign(ya, patch); tocados++;
        } else {
          const { data, error } = await supabase.from('crew')
            .insert({ name: nombre, email, phone: tel, activo: true }).select().single();
          if (error) throw new Error(error.message);
          if (data) crewList.push(data);
          creados++;
        }
      }

      $('ci-modal').hidden = true;
      crewRenderList();
      toast(tocados + creados
        ? '✓ ' + [tocados ? tocados + ' completado' + (tocados === 1 ? '' : 's') : '', creados ? creados + ' nuevo' + (creados === 1 ? '' : 's') : ''].filter(Boolean).join(' · ')
        : 'No había nada nuevo para guardar');
    } catch (e){
      $('ci-msg').textContent = '⚠️ ' + (e.message || e);
    } finally {
      btn.disabled = false; btn.textContent = 'Guardar los cambios';
    }
  }

  function crewBind(){
    $('crew-new').addEventListener('click', crewNuevo);
    $('crew-import').addEventListener('click', ciAbrir);
    $('ci-x').addEventListener('click', () => { $('ci-modal').hidden = true; });
    $('ci-back').addEventListener('click', () => { $('ci-modal').hidden = true; });
    $('ci-go').addEventListener('click', ciGuardar);
    $('crew-fusion').addEventListener('click', crewFusionar);
    $('crew-back').addEventListener('click', () => { clearTimeout(crewT); crewGuardar(); crewCur = null; crewRenderList(); });
    $('crew-q').addEventListener('input', crewRenderList);
    $('crew-del').addEventListener('click', async () => {
      const c = crewCur; if (!c) return;
      if (!confirm('¿Borrar la ficha de ' + c.name + '?\n\nSus proyectos y sus facturas NO se tocan: solo desaparece de esta lista.')) return;
      const { error } = await supabase.from('crew').delete().eq('id', c.id);
      if (error){ toast(error.message); return; }
      crewList = crewList.filter((x) => String(x.id) !== String(c.id));
      crewCur = null; crewRenderList();
    });
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     LA FICHA POR PASOS
     ═══════════════════════════════════════════════════════════════════════════
     El orden es el del trabajo real, no el de las tablas. Tres reglas que hacen que
     esto se use en vez de esquivarse:

     1. UN PASO NO BLOQUEA AL SIGUIENTE. Si el brief nunca volvió, "Guion" se abre igual
        —avisando que va con menos material. Un asistente que te obliga a completar el 2
        para ver el 3 se usa dos veces y después se saltea.
     2. EL ✓ SE CALCULA, Y SE PUEDE FORZAR. Se rodó y no se cargó nada: la app no puede
        discutir eso. `pasos_forzados` guarda lo único que no se puede deducir.
     3. UN ✓ NO ES UN REPROCHE. Lo que falta se dice en neutro. Un proyecto sin plan
        todavía es normal, no un atraso.

     "Plata" y "Todo lo demás" están en la barra pero no son pasos: no se terminan, se
     miran cuando hace falta.
     ═══════════════════════════════════════════════════════════════════════════ */
  const PJ_PASOS = [
    { k: 'cliente', l: 'Cliente' },
    { k: 'brief',   l: 'Brief' },
    { k: 'guion',   l: 'Guion' },
    { k: 'crew',    l: 'Crew' },
    { k: 'plan',    l: 'Plan' },
    { k: 'rodaje',  l: 'Rodaje' },
    { k: 'post',    l: 'Post' },
    { k: 'entrega', l: 'Entrega' },
    { k: 'plata',   l: '💰 Plata', suelto: true },
    { k: 'otros',   l: '⋯ Lo demás', suelto: true },
  ];
  let pjPaso = null, pjContactos = [];

  /* El estado de cada paso: hecho o no, y una línea de qué hay. La línea importa tanto
     como el ✓ — "7 personas" contesta sin abrir el panel. */
  function pjEstadoPasos(){
    const p = pjCur; if (!p) return {};
    const forz = Array.isArray(p.pasos_forzados) ? p.pasos_forzados : [];
    const hoy = new Date().toISOString().slice(0, 10);
    const crew = Array.isArray(p.crew) ? p.crew.filter((c) => c && (c.nombre || c.rol)) : [];
    const briefN = Object.keys(pbrResp || {}).filter((k) => String(pbrResp[k] || '').trim()).length;
    const guion = (pjGuiones || []).find((g) => g.elegido);
    const planN = (pjPlan && Array.isArray(pjPlan.cuerpo)) ? pjPlan.cuerpo.length : 0;
    const horas = (pjHoras || []).reduce((a, h) => a + (Number(h.horas) || 0), 0);
    const ultima = (pjVers || [])[0];
    const sinResolver = (pjComs || []).filter((c) => !c.resolved && c.from_client).length;
    const fact = pjFacturado(p), monto = Number(p.amount_chf) || 0;

    const e = {
      cliente: { ok: pjContactos.length > 0,
        d: pjContactos.length ? (pjContactos[0].name || pjContactos[0].email) + (pjContactos.length > 1 ? ' +' + (pjContactos.length - 1) : '') : 'sin contactos' },
      brief: { ok: !!p.brief_done_at || briefN >= 8,
        d: briefN ? briefN + ' de 12' : (p.brief_sent_at ? 'enviado, sin contestar' : 'sin empezar') },
      guion: { ok: !!guion || String(p.script_text || '').trim().length > 80,
        d: guion ? guion.angulo : (String(p.script_text || '').trim() ? 'cargado a mano' : ((pjGuiones || []).length ? (pjGuiones.length + ' sin elegir') : 'sin guion')) },
      crew: { ok: crew.length > 0,
        d: crew.length ? crew.length + (crew.length === 1 ? ' persona' : ' personas') : 'sin cargar' },
      plan: { ok: planN > 0,
        d: planN ? planN + ' bloques' : (p.shoot_start ? 'fechas puestas, sin plan' : 'sin fechas') },
      rodaje: { ok: !!(p.shoot_start && p.shoot_start <= hoy),
        d: p.shoot_start ? (fmtDMY(p.shoot_start) + (p.shoot_end && p.shoot_end !== p.shoot_start ? '–' + fmtDMY(p.shoot_end) : '')) : 'sin fecha' },
      post: { ok: !!(ultima && ultima.approved_at),
        d: !(pjVers || []).length ? 'sin versiones'
           : ultima.approved_at ? 'v' + ultima.n + ' aprobada'
           : sinResolver ? 'v' + ultima.n + ' · ' + sinResolver + ' sin resolver'
           : 'v' + ultima.n + ' esperando' },
      entrega: { ok: !!p.delivered_at,
        d: p.delivered_at ? fmtDMY(p.delivered_at) : (p.delivery_due ? 'para el ' + fmtDMY(p.delivery_due) : 'sin fecha') },
      plata: { ok: monto > 0 && fact >= monto,
        d: monto ? pjCHF(fact) + ' de ' + pjCHF(monto) : 'sin monto' },
      otros: { ok: true, d: horas ? horas + ' h puestas' : 'notas, equipo, horas' },
    };
    forz.forEach((k) => { if (e[k]) { e[k].ok = true; e[k].forzado = true; } });
    return e;
  }

  function pjRenderSteps(){
    const p = pjCur; if (!p) return;
    const e = pjEstadoPasos();
    if (!pjPaso) pjPaso = pjPasoSugerido(e);
    $('pj-steps').innerHTML = PJ_PASOS.map((s, i) => {
      const st = e[s.k] || {};
      return '<button type="button" class="pj-step' + (st.ok && !s.suelto ? ' hecho' : '') +
        (pjPaso === s.k ? ' on' : '') + '" data-step="' + s.k + '">' +
        '<span class="n">' + (s.suelto ? '' : '<span class="e">' + (st.ok ? '✓' : (i + 1)) + '</span>') +
          esc(s.l) + '</span>' +
        '<span class="d">' + esc(st.d || '') + '</span></button>';
    }).join('');
    $('pj-steps').querySelectorAll('[data-step]').forEach((b) =>
      b.addEventListener('click', () => { pjPaso = b.dataset.step; pjRenderSteps(); }));

    // un panel por vez
    /* Un bloque puede vivir en más de un paso: "Cuándo" hace falta al planificar y al
       rodar, y el portal se mira en post y en la entrega. Duplicar el markup sería peor. */
    document.querySelectorAll('#pj-detail [data-paso]').forEach((el) => {
      const suyo = String(el.dataset.paso || '').split(' ').includes(pjPaso);
      el.hidden = !suyo;
      /* Y si es un <details>, se abre. El guion y el plan son plegables —vienen de cuando
         los once bloques estaban todos en la misma pantalla y había que poder cerrarlos—
         pero ahora, parado en el paso «Plan», lo único que veías era el título con un
         triangulito: el plan estaba ahí abajo, plegado.
         (Sebastián, 27 ago 2026: "el plan de rodaje todavía no se ve como prometido".) */
      if (suyo && el.tagName === 'DETAILS') el.open = true;
    });
    pjRenderNext(e);
    if (pjPaso === 'cliente') pjRenderContactos();
    if (pjPaso === 'entrega') pjRenderEntrega();
    if (pjPaso === 'brief') pjRenderBriefRes();
  }

  /* Qué etapa le tocaría al proyecto según lo que ya está hecho. Solo se SUGIERE: mover la
     etapa cambia lo que ve el cliente en su portal, y eso no puede pasar solo. */
  function pjEtapaSegunPasos(){
    const p = pjCur; if (!p) return null;
    const e = pjEstadoPasos();
    if (p.delivered_at) return 'entregado';
    if ((pjVers || []).length) return 'post';
    if (p.shoot_start && p.shoot_start <= new Date().toISOString().slice(0, 10)) return 'rodaje';
    if (e.plan && e.plan.ok && e.crew && e.crew.ok) return 'preproduccion';
    return 'desarrollo';
  }

  /* El primer paso sin terminar. No es "el que sigue en la lista": es donde de verdad
     está parado el proyecto. */
  function pjPasoSugerido(e){
    const orden = PJ_PASOS.filter((s) => !s.suelto).map((s) => s.k);
    return orden.find((k) => !(e[k] || {}).ok) || 'post';
  }

  /* "Lo que sigue": una sola frase y como mucho una acción. Nunca hace nada solo —
     abre lo que corresponde y ahí adentro confirmás. */
  function pjRenderNext(e){
    const p = pjCur; if (!p) return;
    const caja = $('pj-next');
    const ultima = (pjVers || [])[0];
    const sinResolver = (pjComs || []).filter((c) => !c.resolved && c.from_client).length;
    let n = null;

    if (!pjContactos.length)
      n = { t: 'Falta el contacto del cliente.', s: 'Sin eso no se le puede mandar nada — ni el brief, ni el portal.', b: '👤 Agregar a alguien', paso: 'cliente', go: () => $('pj-cli-add').click() };
    else if (!e.brief.ok && !p.brief_sent_at)
      n = { t: 'Mandarle el Project Brief a ' + esc(pjContactos[0].name || pjContactos[0].email) + '.', s: 'De ahí sale el guion. También lo podés llenar vos con lo que ya sepas.', b: '📋 Abrir el brief', paso: 'brief', go: () => pjBriefVer() };
    else if (!e.guion.ok)
      n = { t: 'Escribir el guion.', s: 'Tres ángulos del mismo material, y elegís uno.', b: '✍️ Escribir 3 guiones', paso: 'guion', go: () => { $('pj-guion-blq').open = true; $('pj-gia-go').scrollIntoView({ behavior: 'smooth', block: 'center' }); } };
    else if (!e.crew.ok)
      n = { t: 'Armar el crew.', s: 'Los roles ya vendidos salen del presupuesto de un toque.', b: '✨ Traer del presupuesto', paso: 'crew', go: () => $('pj-crew-auto').click() };
    else if (!e.plan.ok)
      n = { t: 'Armar el plan de rodaje.', s: 'La IA lo propone entero y vos lo corregís. No guarda nada sin que lo toques.', b: '📅 Proponer un plan', paso: 'plan', go: () => { $('pj-plan-blq').open = true; $('pj-plan-ia').click(); } };
    else if (!(pjVers || []).length)
      n = { t: 'Subir el primer corte.', s: 'El cliente lo ve en su portal y comenta con el minuto exacto.', b: '⬆ Nueva versión', paso: 'post', go: () => $('pj-ver-add').click() };
    else if (ultima && !ultima.approved_at && !sinResolver && !ultima.notes_done_at && !pjForzado('aviso-v' + ultima.n))
      n = { t: 'Avisarle que la v' + ultima.n + ' está lista.', s: 'Está subida y el portal pide código. Todavía no la vio nadie.', b: '📤 Avisarle', paso: 'post', go: () => $('pj-portal-prev').click(),
            ok: () => pjForzarPaso('aviso-v' + ultima.n, 'Listo — no vuelvo a avisarte por la v' + ultima.n) };
    else if (sinResolver)
      n = { t: sinResolver + (sinResolver === 1 ? ' nota sin resolver' : ' notas sin resolver') + '.', s: 'Mandáselas al que monta con el .xml adentro, o resolvelas acá.', b: '📤 Al editor', paso: 'post', go: () => { const b = $('pj-vers').querySelector('[data-noted]'); if (b) b.click(); },
            ok: () => pjResolverTodas() };
    else if (e.post.ok && !p.delivered_at)
      n = { t: 'El corte está aprobado: entregá los archivos finales.', s: 'Y ahí se factura lo que falta.', b: '📦 Ir a la entrega', paso: 'entrega', go: () => { pjPaso = 'entrega'; pjRenderSteps(); } };
    else if (Number(p.amount_chf) > pjFacturado(p) && p.delivered_at)
      n = { t: 'Falta facturar ' + pjCHF(Number(p.amount_chf) - pjFacturado(p)) + '.', s: 'El proyecto ya se entregó.', b: '🧾 Facturar al cliente', paso: 'plata', go: () => $('pj-invoice').click() };

    if (!n){ caja.hidden = true; return; }
    caja.hidden = false;
    caja.innerHTML = '<div class="txt"><b>' + n.t + '</b><span>' + esc(n.s) + '</span></div>' +
      '<button class="btn btn-primary small" id="pj-next-go" type="button">' + esc(n.b) + '</button>' +
      '<button class="btn btn-ghost small" id="pj-next-ok" type="button" title="Darlo por hecho igual">✓ Ya está</button>';
    $('pj-next-go').addEventListener('click', () => {
      if (n.paso && pjPaso !== n.paso){ pjPaso = n.paso; pjRenderSteps(); }
      setTimeout(n.go, 60);
    });
    /* Darlo por hecho a mano. Existe porque la app se equivoca: se rodó sin cargar nada,
       el brief llegó por WhatsApp, el guion está en un Drive.
       Cada aviso descarta LO SUYO. Antes todos forzaban el paso, y para los dos avisos que
       no dependen del paso —las notas del cliente y el "avisale que está lista"— eso no
       cambiaba nada: el aviso volvía intacto.
       (Sebastián, 26 ago 2026: "aunque toque dado por hecho se mantiene ahi :(") */
    $('pj-next-ok').addEventListener('click', () => (n.ok ? n.ok() : pjForzarPaso(n.paso)));
  }

  function pjForzado(k){
    const p = pjCur;
    return !!(p && Array.isArray(p.pasos_forzados) && p.pasos_forzados.includes(k));
  }

  /* "Ya está" sobre las notas del cliente las da por resueltas de verdad — es lo que
     significa. Se pregunta porque son notas de otra persona. */
  async function pjResolverTodas(){
    const p = pjCur; if (!p) return;
    const abiertas = (pjComs || []).filter((c) => !c.resolved && c.from_client);
    if (!abiertas.length) return;
    if (!confirm('¿Doy por resueltas las ' + abiertas.length + ' notas del cliente?\n\nSe marcan como hechas y dejan de aparecer. Se puede deshacer una por una.')) return;
    const { error } = await supabase.from('project_comments')
      .update({ resolved: true, resolved_at: new Date().toISOString() })
      .in('id', abiertas.map((c) => c.id));
    if (error){ toast(error.message); return; }
    abiertas.forEach((c) => { c.resolved = true; });
    pjPortalRender();
    pjRenderSteps();
    toast('✓ ' + abiertas.length + (abiertas.length === 1 ? ' nota resuelta' : ' notas resueltas'));
  }

  async function pjForzarPaso(k, msg){
    const p = pjCur; if (!p || !k) return;
    const forz = Array.isArray(p.pasos_forzados) ? p.pasos_forzados.slice() : [];
    if (forz.includes(k)){ toast('Ese ya estaba dado por hecho'); return; }
    forz.push(k);
    const { error } = await supabase.from('projects').update({ pasos_forzados: forz }).eq('id', p.id);
    if (error){ toast(error.message); return; }
    p.pasos_forzados = forz;
    pjPaso = null;
    pjRenderSteps();
    toast(msg || '✓ Dado por hecho — se puede volver atrás desde el paso');
  }

  /* ── Paso 1 · Los contactos del proyecto ──
     No a todos se les manda lo mismo: el que aprueba el corte no es el que recibe la
     factura, y legal solo quiere la entrega final. Por eso cada uno tiene un tipo y el
     tilde de cada envío arranca de ahí. */
  const PJ_RECIBE = [['principal', 'Principal'], ['copia', 'En copia'], ['entregas', 'Solo entregas'], ['facturas', 'Facturas']];

  async function pjContactosLoad(){
    const p = pjCur; if (!p) return;
    const { data, error } = await supabase.from('project_contacts')
      .select('*').eq('project_id', p.id).order('id');
    pjContactos = error ? [] : (data || []);
    /* Si no hay ninguno pero el proyecto tiene su persona ganada, se ofrece de una: es
       el caso normal y hacerlo a mano es trabajo que ya está hecho en otro lado. */
    if (!pjContactos.length){
      const l = leadById(p.lead_id);
      if (l && l.email){
        const { data: c } = await supabase.from('project_contacts').insert({
          project_id: p.id, lead_id: l.id, name: l.name || null, email: String(l.email).toLowerCase(),
          role: l.job_title || null, recibe: 'principal' }).select().single();
        if (c) pjContactos = [c];
      }
    }
    if (pjPaso === 'cliente') pjRenderContactos();
    pjRenderSteps();
  }

  function pjRenderContactos(){
    const box = $('pj-cli'); if (!box) return;
    $('pj-cli-est').textContent = pjContactos.length
      ? pjContactos.length + (pjContactos.length === 1 ? ' persona' : ' personas')
      : 'todavía nadie';
    box.innerHTML = !pjContactos.length
      ? '<p class="muted-note" style="margin:0">Sin contactos no se le puede mandar nada. Agregá al menos a la persona con la que hablás.</p>'
      : '<div class="pj-gente">' + pjContactos.map((c) => {
          const ini = String(c.name || c.email || '?').trim().split(/\s+/).map((x) => x[0]).slice(0, 2).join('').toUpperCase();
          return '<div class="pj-per' + (c._on !== false ? ' on' : '') + '" data-c="' + c.id + '">' +
            '<span class="av">' + esc(ini) + '</span>' +
            '<div style="min-width:0">' +
              '<div class="nm">' + esc(c.name || '(sin nombre)') + '</div>' +
              (c.role ? '<div class="rol">' + esc(c.role) + '</div>' : '') +
              '<div class="ml">' + esc(c.email || '') + '</div>' +
              '<select data-r="' + c.id + '">' + PJ_RECIBE.map(([k, l]) =>
                '<option value="' + k + '"' + (c.recibe === k ? ' selected' : '') + '>' + l + '</option>').join('') + '</select>' +
              /* Su citación para el día de rodaje. El cliente que viene a ver el set casi
                 nunca llega a la misma hora que el equipo: llega cuando se rueda lo suyo.
                 (Sebastián, 27 ago 2026: "calltime para cada persona... para clientes,
                  técnicos, actores, etc.") */
              /* LA HORA YA NO SE CARGA ACÁ. Estaba suelta al lado del contacto, sin etiqueta,
                 y Sebastián abrió su propio proyecto y preguntó «¿qué es esto?» (28 ago
                 2026). Ahora vive en la pestaña «Citación» del plan de rodaje, con TODOS
                 —equipo y cliente— en una sola lista: es el lugar donde la pregunta «¿a qué
                 hora viene cada uno?» se hace de verdad.
                 (Sebastián, 29 ago 2026: "ese es el lugar correcto".) */
            '</div>' +
            '<button class="x" data-cdel="' + c.id + '" type="button" title="Sacarlo del proyecto">✕</button>' +
            '<span class="ck">' + (c._on !== false ? '✓' : '') + '</span></div>';
        }).join('') + '</div>' +
        '<p class="muted-note" style="margin:9px 0 0">La hora a la que citás a cada uno se pone en el plan de rodaje, pestaña <b>🕐 Citación</b> — ahí están todos juntos, equipo y cliente.</p>';


    box.querySelectorAll('.pj-per').forEach((el) => el.addEventListener('click', (ev) => {
      if (ev.target.closest('select, .x, input')) return;
      const c = pjContactos.find((x) => String(x.id) === el.dataset.c); if (!c) return;
      c._on = c._on === false;
      pjRenderContactos();
    }));
    box.querySelectorAll('[data-r]').forEach((sel) => sel.addEventListener('change', async () => {
      const c = pjContactos.find((x) => String(x.id) === sel.dataset.r); if (!c) return;
      /* Un solo principal: la base lo exige, así que primero se baja al que estaba. */
      if (sel.value === 'principal'){
        const otro = pjContactos.find((x) => x.recibe === 'principal' && String(x.id) !== String(c.id));
        if (otro){ await supabase.from('project_contacts').update({ recibe: 'copia' }).eq('id', otro.id); otro.recibe = 'copia'; }
      }
      const { error } = await supabase.from('project_contacts').update({ recibe: sel.value }).eq('id', c.id);
      if (error){ toast(error.message); return; }
      c.recibe = sel.value;
      pjRenderContactos();
    }));
    box.querySelectorAll('[data-cdel]').forEach((b) => b.addEventListener('click', async (ev) => {
      ev.stopPropagation();
      const c = pjContactos.find((x) => String(x.id) === b.dataset.cdel); if (!c) return;
      if (!confirm('¿Sacar a ' + (c.name || c.email) + ' de este proyecto?\n\nSigue en Personas: solo deja de recibir lo de acá.')) return;
      const { error } = await supabase.from('project_contacts').delete().eq('id', c.id);
      if (error){ toast(error.message); return; }
      pjContactos = pjContactos.filter((x) => String(x.id) !== String(c.id));
      pjRenderContactos(); pjRenderSteps();
    }));

    const n = pjContactos.filter((c) => c._on !== false).length;
    $('pj-cli-nota').textContent = n
      ? 'a ' + n + (n === 1 ? ' persona' : ' personas') + ' — el brief, el portal, una versión o la factura'
      : 'tildá al menos a uno';
  }

  /* Agregar a alguien: un formulario en la misma tarjeta, no tres prompt() encadenados.
     Con prompts no se ve lo que ya escribiste, no se puede corregir sin empezar de nuevo, y
     en el teléfono son tres pantallas del sistema tapando la app.
     El email va primero porque es la clave: si esa persona ya está en Personas, el resto se
     completa solo y el contacto queda enganchado con su ficha —así lo que se le mande cae
     en su historial y no en un contacto suelto que no es nadie. */
  function pjContactoNuevo(){
    const p = pjCur; if (!p) return;
    if ($('pj-cli-form')) { $('pj-cli-mail').focus(); return; }
    const caja = document.createElement('div');
    caja.id = 'pj-cli-form';
    caja.style.cssText = 'border:1px solid var(--acid);border-radius:12px;padding:13px 15px;margin-top:10px';
    caja.innerHTML =
      '<div class="pj-crew-row" style="grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) minmax(0,.9fr) auto">' +
        '<input class="pj-inp" id="pj-cli-mail" type="email" placeholder="email@empresa.ch" />' +
        '<input class="pj-inp" id="pj-cli-nom" placeholder="Nombre" />' +
        '<input class="pj-inp" id="pj-cli-rol" placeholder="Rol (Marketing, Legal…)" />' +
        '<button class="btn btn-primary small" id="pj-cli-ok" type="button">Agregar</button>' +
      '</div>' +
      '<p class="muted-note" style="margin:8px 0 0" id="pj-cli-hint">Si ya está en Personas, se engancha con su ficha.</p>';
    $('pj-cli').after(caja);
    const mail = $('pj-cli-mail'); mail.focus();

    /* Al escribir el email se busca en Personas y se completa lo que ya sabemos. */
    mail.addEventListener('blur', () => {
      const v = mail.value.trim().toLowerCase(); if (!v) return;
      const ya = (allLeads || []).find((l) => String(l.email || '').toLowerCase() === v);
      if (!ya) return;
      if (!$('pj-cli-nom').value) $('pj-cli-nom').value = ya.name || '';
      if (!$('pj-cli-rol').value) $('pj-cli-rol').value = ya.job_title || '';
      $('pj-cli-hint').textContent = '✓ Es ' + (ya.name || v) + ', que ya está en Personas — queda enganchado con su ficha.';
    });
    caja.addEventListener('keydown', (e) => {
      if (e.key === 'Enter'){ e.preventDefault(); $('pj-cli-ok').click(); }
      if (e.key === 'Escape') caja.remove();
    });
    $('pj-cli-ok').addEventListener('click', async () => {
      const v = mail.value.trim().toLowerCase();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)){ $('pj-cli-hint').textContent = '⚠️ Ese email no parece válido'; mail.focus(); return; }
      const ya = (allLeads || []).find((l) => String(l.email || '').toLowerCase() === v);
      const nombre = $('pj-cli-nom').value.trim(), rol = $('pj-cli-rol').value.trim();
      const { data, error } = await supabase.from('project_contacts').insert({
        project_id: p.id, lead_id: ya ? ya.id : null, name: nombre || (ya && ya.name) || null,
        email: v, role: rol || null, recibe: pjContactos.length ? 'copia' : 'principal' }).select().single();
      if (error){
        $('pj-cli-hint').textContent = /duplicate|unique/i.test(error.message)
          ? '⚠️ Esa persona ya está en el proyecto' : '⚠️ ' + error.message;
        return;
      }
      pjContactos.push(data);
      caja.remove();
      pjRenderContactos(); pjRenderSteps();
      toast('👤 ' + (nombre || v) + ' agregado' + (ya ? ' — enganchado con su ficha' : ''));
    });
  }

  /* Mandarles algo: cada opción lleva al flujo que YA tiene su preview. Esto no manda nada
     por su cuenta — elige el camino y a quién. */
  /* ═══ Mandarles algo ═══
     Un email de verdad: se ve el remitente, se ven los destinatarios, se ve el email
     exacto que le llega, y recién ahí aparece el botón de mandarlo. */
  let mlElegidos = [], mlListo = false;

  /* Los botones de arriba no son plantillas: le dicen a la IA de qué se trata el email y
     ella lo escribe con el material del proyecto —la versión que subimos, lo que contestó
     en el brief, las notas que dejó—. Una plantilla fija dice lo mismo para el proyecto
     que arranca y para el que va por la v4 con seis notas abiertas.
     (Sebastián, 26 ago 2026: "sin saludo, hola como andas? etc? por favor usa la IA bien
      usada.") */
  const ML_INTENC = [
    ['portal', '🔗 Que su portal está listo'],
    ['version', '🎞 Que hay una versión nueva'],
    ['brief', '📋 Que conteste el brief'],
    ['notas', '📝 En qué quedaron sus notas'],
    ['factura', '🧾 Que le mandamos la factura'],
  ];
  const ML_ADJ = { portal: 'portal', version: 'portal', brief: 'brief', notas: 'portal', factura: 'nada', libre: 'nada' };

  function pjContactosMandar(){
    const p = pjCur; if (!p) return;
    mlElegidos = pjContactos.filter((c) => c._on !== false);
    if (!mlElegidos.length){ toast('Tildá al menos a una persona'); return; }

    $('ml-sub').textContent = (p.ref ? p.ref + ' · ' : '') + (p.title || '');
    $('ml-de').innerHTML = '<option value="sofia">Sofia Treviño · sofia@viven.ch</option>' +
      '<option value="sebastian">Sebastian Cepeda · sebastian@viven.ch</option>';
    /* El idioma arranca en el del contacto, no en el nuestro: al cliente suizo alemán
       mandarle español porque el dashboard está en español es el error clásico. */
    const l = leadById(p.lead_id) || {};
    $('ml-lang').value = ['en', 'de', 'es'].includes(l.lang) ? l.lang : 'en';
    $('ml-asunto').value = '';
    $('ml-msg').value = '';
    $('ml-adj').value = 'nada';
    mlRenderPara();
    mlRenderPlantillas();
    mlInvalidar();
    $('ml-modal').hidden = false;
    setTimeout(() => $('ml-msg').focus(), 80);
  }

  function mlRenderPara(){
    const con = mlElegidos.filter((c) => c.email && String(c.email).includes('@'));
    const sin = mlElegidos.filter((c) => !c.email || !String(c.email).includes('@'));
    $('ml-para').innerHTML =
      '<span class="ml-lb" style="margin:0;align-self:center">Para</span>' +
      con.map((c) => '<span class="ml-chip"><b>' + esc(c.name || c.email) + '</b>' +
        '<span class="em">' + esc(c.email) + '</span>' +
        '<button type="button" data-quitar="' + esc(String(c.id)) + '" title="Sacarlo de este envío">✕</button></span>').join('') +
      sin.map((c) => '<span class="ml-chip no" title="Sin email cargado — no le va a llegar"><b>' +
        esc(c.name || '(sin nombre)') + '</b><span class="em">sin email</span></span>').join('');
    $('ml-para').querySelectorAll('[data-quitar]').forEach((b) => {
      b.addEventListener('click', () => {
        mlElegidos = mlElegidos.filter((c) => String(c.id) !== b.dataset.quitar);
        if (!mlElegidos.length){ toast('Sin destinatarios'); $('ml-modal').hidden = true; return; }
        mlRenderPara(); mlInvalidar();
      });
    });
  }

  /* Las plantillas rellenan los campos y los dejan editables. La versión vieja de esto era
     un menú que en vez de escribir el email te mandaba a otra pantalla. */
  function mlRenderPlantillas(){
    $('ml-plant').innerHTML = '<span class="ml-lb" style="margin:0;align-self:center">Escribir</span>' +
      ML_INTENC.map(([k, t]) => '<button type="button" data-pl="' + k + '">' + esc(t) + '</button>').join('') +
      '<button type="button" data-pl="libre">✨ Otra cosa…</button>';
    $('ml-plant').querySelectorAll('[data-pl]').forEach((b) => {
      b.addEventListener('click', () => mlEscribir(b.dataset.pl, b));
    });
  }

  /* La IA escribe el email entero: asunto, saludo, cuerpo y cierre, en el idioma del
     cliente. Después se edita a mano como cualquier texto — lo que sale es lo que ves. */
  async function mlEscribir(intencion, boton){
    let pedido = '';
    if (intencion === 'libre'){
      pedido = prompt('¿De qué le escribimos?\n\nUna línea alcanza: «que se atrasa una semana por el clima».') || '';
      if (!pedido.trim()) return;
    }
    const txt = boton.textContent;
    boton.disabled = true; boton.textContent = 'Escribiendo…';
    $('ml-msg-est').textContent = 'La IA está escribiendo con lo que sabemos del proyecto…';
    try {
      const { data, error } = await supabase.functions.invoke('ai-mensaje-cliente', { body: {
        project_id: pjCur.id,
        intencion,
        pedido,
        lang: $('ml-lang').value,
        de_nombre: $('ml-de').selectedOptions[0].textContent.split(' · ')[0],
        destinatarios: mlElegidos.map((c) => c.name || c.email),
      } });
      if (error) throw new Error(error.message);
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
      $('ml-asunto').value = data.asunto || '';
      $('ml-msg').value = data.mensaje || '';
      $('ml-adj').value = ML_ADJ[intencion] || 'nada';
      mlInvalidar();
      $('ml-msg-est').textContent = 'Armando el email…';
    } catch (e){
      toast('⚠️ ' + (e.message || e));
      $('ml-msg-est').textContent = 'Primero el preview. Nada sale sin que lo veas.';
    } finally {
      boton.disabled = false; boton.textContent = txt;
    }
  }

  /* El preview se arma solo. Antes había un botón "Ver cómo le llega" que había que
     apretar antes de mandar, con el preview apareciendo en esta misma ventana: un paso de
     más para ver algo que ya estaba a la vista.
     La garantía se mantiene igual —no se manda nada que no esté en pantalla— pero la da el
     estado del preview, no un botón: mientras se está rearmando, Mandarlo no anda.
     (Sebastián, 26 ago 2026: "ahora no me deja mandar el email sin ver el preview, pero el
      preview lo veo ahí mismo".) */
  let mlTimer = null, mlPide = 0;

  function mlInvalidar(){
    mlListo = false;
    $('ml-go').disabled = true;
    clearTimeout(mlTimer);
    if (!$('ml-msg').value.trim()){
      $('ml-prev').innerHTML = '<div class="ml-vacio">Escribí el mensaje —o pedíselo a la IA acá arriba— y el email aparece acá.</div>';
      $('ml-msg-est').textContent = '';
      return;
    }
    $('ml-msg-est').textContent = 'Armando el email…';
    mlTimer = setTimeout(mlVer, 700);
  }

  function mlCuerpo(){
    return {
      project_id: pjCur.id,
      contact_ids: mlElegidos.map((c) => String(c.id)),
      de: $('ml-de').value,
      lang: $('ml-lang').value,
      asunto: $('ml-asunto').value.trim(),
      mensaje: $('ml-msg').value.trim(),
      adjunto: $('ml-adj').value,
    };
  }

  async function mlVer(){
    if (!$('ml-msg').value.trim()) return;
    /* Cada pedido lleva número: si mientras vuelve uno seguís escribiendo, la respuesta
       vieja se descarta en vez de pintar un preview que ya no corresponde. */
    const mio = ++mlPide;
    try {
      const { data, error } = await supabase.functions.invoke('mandar-al-cliente',
        { body: { ...mlCuerpo(), dry_run: true } });
      if (mio !== mlPide) return;
      if (error) throw new Error(error.message);
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
      /* srcdoc y no innerHTML: el email trae su propio <body> y sus estilos, y meterlo en
         el dashboard lo pinta de otro color. Sin permitir scripts. */
      $('ml-prev').innerHTML =
        '<div class="cab">De <b>' + esc(data.de.from) + '</b> · responde a <b>' + esc(data.de.email) + '</b><br>' +
        'Para <b>' + esc(data.to.map((t) => t.email).join(', ')) + '</b><br>' +
        'Asunto: <b>' + esc(data.asunto) + '</b>' +
        (data.sin_email.length ? '<br><span style="color:#f0c060">Sin email, no les llega: ' + esc(data.sin_email.join(', ')) + '</span>' : '') +
        '</div><iframe sandbox="" title="Vista previa del email"></iframe>';
      $('ml-prev').querySelector('iframe').srcdoc = data.html;
      mlListo = true;
      $('ml-go').disabled = false;
      $('ml-go').textContent = '📤 Mandarlo a ' + data.to.length + (data.to.length === 1 ? ' persona' : ' personas');
      $('ml-msg-est').textContent = 'Esto es exactamente lo que le llega.';
    } catch (e){
      if (mio !== mlPide) return;
      $('ml-prev').innerHTML = '<div class="ml-vacio" style="color:#f0c060">No pude armar el email: ' + esc(e.message || String(e)) + '</div>';
      $('ml-msg-est').textContent = '';
    }
  }

  async function mlMandar(){
    if (!mlListo) return;
    const b = $('ml-go');
    b.disabled = true; b.textContent = 'Mandando…';
    try {
      const { data, error } = await supabase.functions.invoke('mandar-al-cliente', { body: mlCuerpo() });
      if (error) throw new Error(error.message);
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
      $('ml-modal').hidden = true;
      toast('📤 Mandado a ' + data.enviados + (data.enviados === 1 ? ' persona' : ' personas'));
    } catch (e){
      toast('⚠️ ' + (e.message || e));
      b.disabled = false; b.textContent = '📤 Mandarlo';
    }
  }

  /* Las respuestas del brief se leen al abrir el proyecto, no solo al abrir el modal:
     el ✓ del paso y el contador salen de acá. */
  async function pjBriefRespLoad(){
    const p = pjCur; if (!p) return;
    /* updated_at también: con brief_done_at se sabe qué contestó DESPUÉS de darlo por
       terminado. Esa respuesta llega cuando el brief ya se leyó —o ya se escribió el
       guion—, así que si no se marca no la ve nadie.
       (Sebastián, 27 ago 2026: "que se agregue al brief ya enviado".) */
    const { data } = await supabase.from('project_briefs').select('key,value,updated_at').eq('project_id', p.id);
    pbrResp = {}; pbrTarde = {};
    const _cierre = p.brief_done_at ? Date.parse(p.brief_done_at) : null;
    (data || []).forEach((r) => {
      pbrResp[r.key] = r.value || '';
      if (_cierre && Date.parse(r.updated_at) > _cierre + 60000) pbrTarde[r.key] = r.updated_at;
    });
    if (pjCur === p) pjRenderSteps();
  }

  function pjRenderBriefRes(){
    const p = pjCur; if (!p) return;
    const n = Object.keys(pbrResp || {}).filter((k) => String(pbrResp[k] || '').trim()).length;
    $('pj-brief-est').textContent = p.brief_done_at ? '✓ el cliente lo dio por terminado'
      : p.brief_sent_at ? 'enviado el ' + fmtDMY(p.brief_sent_at) : 'no se mandó todavía';
    $('pj-brief-res').innerHTML = n
      ? '<p class="muted-note" style="margin:0">' + n + ' de 12 contestadas. De acá salen los guiones y el plan de rodaje.</p>'
      : '<p class="muted-note" style="margin:0">Sin contestar. Los guiones se pueden escribir igual, pero con menos material — y se nota.</p>';
  }

  function pjRenderEntrega(){
    const p = pjCur; if (!p) return;
    const monto = Number(p.amount_chf) || 0, fact = pjFacturado(p), falta = Math.max(0, monto - fact);
    const aprobada = (pjVers || []).find((v) => v.approved_at);
    const arch = (pjFiles || []).filter((f) => f.visible_cliente);
    $('pj-entrega-est').textContent = p.delivered_at ? 'entregado el ' + fmtDMY(p.delivered_at)
      : p.delivery_due ? 'para el ' + fmtDMY(p.delivery_due) : 'sin fecha de entrega';
    $('pj-entrega').innerHTML =
      '<div class="pj-kv"><span class="k">El corte</span><span class="v">' +
        (aprobada ? '<span style="color:#7ed957">✓ v' + aprobada.n + ' aprobada el ' + fmtDMY(aprobada.approved_at) + '</span>'
                  : '<span style="color:#f0c060">todavía no hay ninguna versión aprobada</span>') + '</span></div>' +
      '<div class="pj-kv"><span class="k">Archivos para el cliente</span><span class="v">' +
        (arch.length ? arch.length + (arch.length === 1 ? ' archivo en su portal' : ' archivos en su portal')
                     : '<span class="muted-note">ninguno todavía</span>') + '</span></div>' +
      '<div class="pj-kv"><span class="k">Facturado</span><span class="v">' + pjCHF(fact) + ' de ' + pjCHF(monto) +
        (falta ? ' · <b style="color:#f0c060">faltan ' + pjCHF(falta) + '</b>' : '') + '</span></div>' +
      '<p class="muted-note" style="margin:12px 0 0">La entrega es una fase que se cobra: los masters por idioma y por formato, los subtítulos y los cortes para redes son trabajo de entrega, no de montaje.</p>' +
      '<div class="ab-urlrow" style="margin-top:12px">' +
        '<button class="btn btn-ghost small" id="pj-ent-file" type="button">📎 Subir un archivo final</button>' +
        '<button class="btn btn-ghost small" id="pj-ent-fact" type="button">🧾 Facturar al cliente</button>' +
        '<button class="btn ' + (p.delivered_at ? 'btn-ghost' : 'btn-primary') + ' small" id="pj-ent-ok" type="button">' +
          (p.delivered_at ? '↩︎ No estaba entregado' : '✅ Marcar como entregado') + '</button>' +
      '</div>';
    $('pj-ent-file').addEventListener('click', () => $('pj-file-add').click());
    $('pj-ent-fact').addEventListener('click', () => $('pj-invoice').click());
    $('pj-ent-ok').addEventListener('click', async () => {
      const nuevo = p.delivered_at ? null : new Date().toISOString();
      const { error } = await supabase.from('projects')
        .update({ delivered_at: nuevo, stage: nuevo ? 'entregado' : 'post' }).eq('id', p.id);
      if (error){ toast(error.message); return; }
      p.delivered_at = nuevo; p.stage = nuevo ? 'entregado' : 'post';
      pjRenderEntrega(); pjRenderSteps(); pjRenderDetail();
    });
  }

  function pjRenderDetail(){
    const p = pjCur; if (!p) return;
    const l = leadById(p.lead_id) || {};
    const monto = Number(p.amount_chf) || 0, fact = pjFacturado(p), falta = Math.max(0, monto - fact);

    /* La referencia adelante del título: es el número que se dice por teléfono, el que
       va en la factura al cliente y en la de cada freelance. Si vive escondido en una
       ficha no lo usa nadie. */
    $('pj-title').innerHTML = (p.ref ? '<span class="pj-ref" title="Referencia del proyecto — va en las facturas">' + esc(String(p.ref)) + '</span> ' : '') +
      esc(p.title || 'Proyecto');
    $('pj-sub').textContent = [l.company, l.name].filter(Boolean).join(' · ')
      + (p.started_at ? ' · ganado el ' + fmtDMY(p.started_at) + (pjDias(p.started_at) != null ? ', hace ' + pjDias(p.started_at) + ' días' : '') : '');
    $('pj-monto').textContent = monto ? pjCHF(monto) : '—';
    $('pj-monto-sub').textContent = monto ? (fact ? pjCHF(fact) + ' facturado' : 'sin facturar todavía') : 'sin monto heredado';

    /* Esto era una segunda barra de cinco botones justo arriba de la de pasos, y tres de
       los cinco decían lo mismo: Rodaje, Post y Entregado están en las dos. Pero no son la
       misma cosa —una es lo que ve el cliente en su portal, la otra es lo que nos falta
       hacer— así que fusionarlas habría escondido el estado público.
       Ahora es un renglón: dice qué ve el cliente y deja cambiarlo. Sigue siendo editable,
       ocupa una línea en vez de una barra, y no se puede confundir con el checklist.
       (Sebastián, 26 ago 2026: "volvé a ver bien el proyecto porque hay muchas cosas
        duplicadas".) */
    const etAct = PJ_ETAPAS.find((e) => e.k === p.stage) || PJ_ETAPAS[0];
    const sug = pjEtapaSegunPasos();
    $('pj-pasos').innerHTML =
      '<span class="pj-etq">El cliente ve</span>' +
      '<select class="pj-inp pj-etsel" id="pj-stage-sel">' +
        PJ_ETAPAS.map((e) => '<option value="' + e.k + '"' + (e.k === p.stage ? ' selected' : '') + '>' + esc(e.l) + '</option>').join('') +
      '</select>' +
      (sug && sug !== p.stage
        ? '<button type="button" class="pj-etsug" id="pj-stage-sug">por los pasos hechos iría en <b>' +
          esc((PJ_ETAPAS.find((e) => e.k === sug) || {}).l || sug) + '</b> — moverlo</button>'
        : '<span class="pj-etnota">en su portal, en su idioma</span>');
    $('pj-stage-sel').addEventListener('change', (ev) => pjSetStage(ev.target.value));
    if ($('pj-stage-sug')) $('pj-stage-sug').addEventListener('click', () => pjSetStage(sug));
    $('pj-pasos-nota').textContent = '';

    // cuándo
    $('pj-shoot-start').value = p.shoot_start || '';
    $('pj-shoot-end').value = p.shoot_end || '';
    $('pj-delivery').value = p.delivery_due || '';
    $('pj-plan').value = p.shooting_plan || '';
    $('pj-delivered').textContent = p.delivered_at ? fmtDMY(p.delivered_at) : '—';

    // quién
    $('pj-cliente').innerHTML = p.client_contact
      ? esc(p.client_contact) + (p.client_contact_email ? '<br><span class="muted-note">' + esc(p.client_contact_email) + '</span>' : '')
      : '<span class="falta">sin contacto</span>';
    $('pj-editor').value = p.editor || '';
    $('pj-editor-email').value = p.editor_email || '';
    pjEditorRender();
    const _cli = leadById(p.lead_id) || {};
    $('pj-cliente-email').value = p.client_contact_email || '';
    $('pj-cliente-email').placeholder = _cli.email || 'el de su ficha';
    $('pj-location').value = p.location || '';
    pjRenderCrew();

    // con qué
    $('pj-script').value = p.script_url || '';
    $('pj-storyboard').value = p.storyboard_url || '';
    $('pj-deliverable').value = p.deliverable_url || '';
    pjRenderGear();

    // plata
    const pctF = monto ? Math.round(fact / monto * 100) : 0;
    $('pj-fact').innerHTML =
      '<div class="pj-kv" style="border:0;padding-bottom:0"><span class="k">Facturado en bexio</span>' +
        '<span class="v"><b>' + pjCHF(fact) + '</b> de ' + pjCHF(monto) + '</span></div>' +
      '<div class="pj-track"><i style="width:' + pctF + '%;background:var(--acid)"></i>' +
        '<i style="width:' + (100 - pctF) + '%;background:color-mix(in srgb,#f0c060 40%,transparent)"></i></div>' +
      '<div class="pj-leyenda"><span><i style="background:var(--acid)"></i>Facturado</span>' +
        '<span><i style="background:color-mix(in srgb,#f0c060 40%,transparent)"></i>' +
        (falta ? 'Faltan ' + pjCHF(falta) : 'Nada pendiente') + '</span></div>';

    /* Lo que falta gastar por etapa: las posiciones del presupuesto traen su fase, así
       que se puede decir cuánta plata todavía no salió de la caja. */
    /* Las fases del presupuesto vienen en inglés ("Pre-Production", "Production",
       "Post-Production"). El primer intento las traducía borrando la palabra
       "production", así que "Production" quedaba en cadena vacía y la línea decía
       "— 14'808". Se mapean de verdad, y lo que no reconozca queda con su nombre. */
    /* Entrega es una fase, no un final. El cliente PAGA la entrega —los 60 outputs de
       Sonova, por idioma y por formato, son trabajo de entrega y no de montaje— y una
       fase que no existe no se cotiza ni se factura: cae adentro de post o se olvida.
       (Sebastián, 26 ago 2026: "la fase de delivery también tiene que existir, sobre todo
       en las ofertas dentro del proyecto, porque toca que el cliente pague el delivery".)
       'Development' cae en Pre: es la misma plata antes de rodar. */
    const FASE_LBL = { 'pre-production': 'Pre', 'preproduction': 'Pre', 'pre': 'Pre',
      'development': 'Pre', 'desarrollo': 'Pre',
      'production': 'Rodaje', 'produktion': 'Rodaje',
      'post-production': 'Post', 'postproduction': 'Post', 'post': 'Post',
      'delivery': 'Entrega', 'auslieferung': 'Entrega', 'entrega': 'Entrega' };
    const ORDEN = ['Pre', 'Rodaje', 'Post', 'Entrega'];
    const fases = {};
    (p.items || []).forEach((it) => {
      const crudo = String(it.phase || '').trim().toLowerCase();
      const f = FASE_LBL[crudo] || (it.phase ? String(it.phase) : 'Otros');
      fases[f] = (fases[f] || 0) + (Number(it.qty) || 0) * (Number(it.price) || 0);
    });
    const txt = Object.keys(fases)
      .sort((a, b) => (ORDEN.indexOf(a) + 1 || 99) - (ORDEN.indexOf(b) + 1 || 99))
      .map((f) => f + ' ' + Math.round(fases[f]).toLocaleString('de-CH')).join(' · ');
    $('pj-porfase').textContent = txt || '—';

    pjRenderPortal();
    pjRenderDesglose();
    pjRenderSteps();
    pjGuionesLoad();
    pjPlanLoad();
    pjPortalLoad();
    pjCostosLoad().then(() => { pjBillsLoad(); pjHorasLoad(); });

    // notas
    $('pj-notes').value = p.notes || '';
    $('pj-portal-note').value = p.portal_note || '';

    // posiciones
    const n = (p.items || []).length;
    $('pj-pos-sum').innerHTML = n
      ? n + ' posiciones heredadas del paquete que firmó — ' + pjCHF(monto)
      : 'Sin posiciones heredadas (el deal se ganó sin propuesta ni oferta)';
    $('pj-pos').innerHTML = n
      ? '<table class="lead-table"><thead><tr><th>Posición</th><th>Etapa</th><th style="text-align:right">Cant.</th><th style="text-align:right">Precio</th><th style="text-align:right">Total</th></tr></thead><tbody>' +
        (p.items || []).map((it) => '<tr><td>' + esc(it.name || '') + '</td><td class="muted-note">' + esc(it.phase || '—') + '</td>' +
          '<td style="text-align:right">' + esc(String(it.qty ?? '')) + ' ' + esc(it.unit || '') + '</td>' +
          '<td style="text-align:right">' + Math.round(Number(it.price) || 0).toLocaleString('de-CH') + '</td>' +
          '<td style="text-align:right">' + Math.round((Number(it.qty) || 0) * (Number(it.price) || 0)).toLocaleString('de-CH') + '</td></tr>').join('') +
        '</tbody></table>'
      : '';
  }

  /* Clasificar las posiciones del presupuesto en gente / equipo / ninguna de las dos.
     El primer intento excluía por palabra prohibida y se comía media lista: "Sound
     Engineer incl. Equipment" caía por "equipment", "Editor inkl. Suite" por "suite" y
     "Project Admin" por "admin" — tres personas convertidas en nada, y el descuento del
     20% listado como si fuera un equipo. Ahora manda lo POSITIVO: si el nombre tiene un
     rol adentro, es una persona, aunque después diga "incl. Equipment". */
  const PJ_ROLES = /producer|regie|director|photograph|\bdop\b|gaffer|editor|cutter|engineer|assistant|\bac\b|grip|colorist|operator|admin|animator|motion|script|stylist|make-?up|talent|actor|moderad|host/i;
  const PJ_EQUIPO = /\bkit\b|equipment|equipmemt|camera|kamera|lens|light|led|dolly|drone|gimbal|monitor|prompter|\bvan\b|tripod|slider|crane/i;
  /* Ni gente ni equipo: gastos y servicios que igual están en el presupuesto. */
  const PJ_NI = /discount|rabatt|per\s?diem|permit|bewilligung|subtitle|untertitel|insurance|versicherung|seguro|catering|transport|travel|hotel|parking|licen/i;
  const pjLimpiarRol = (nm) => String(nm || '')
    .replace(/\s*\(.*?\)\s*/g, ' ')            // "(logistics, crewing)" no es parte del rol
    .replace(/\s+(incl\.|inkl\.|including|con)\s.*$/i, '')  // "incl. Suite + Color" tampoco
    .replace(/\s{2,}/g, ' ').trim();
  function pjClasificar(){
    const p = pjCur, gente = [], equipo = [], vistos = new Set(), vistosEq = new Set();
    (p && p.items || []).forEach((it) => {
      const nm = String(it.name || '').trim();
      if (!nm) return;
      if (PJ_NI.test(nm)) return;
      if (PJ_ROLES.test(nm)){
        const rol = pjLimpiarRol(nm), k = rol.toLowerCase();
        if (!vistos.has(k)){ vistos.add(k); gente.push(rol); }
      } else if (PJ_EQUIPO.test(nm)){
        const k = nm.toLowerCase();
        if (!vistosEq.has(k)){ vistosEq.add(k); equipo.push(nm); }
      }
    });
    return { gente, equipo };
  }
  const pjRolesDelPresupuesto = () => pjClasificar().gente;
  /* ── El crew del proyecto ──
     Era un campo de texto por rol. Escribir el nombre a mano es lo que produjo que
     "Sofia" y "Sofia Treviño" fueran dos personas distintas, y que ninguna línea de costo
     supiera a quién pagarle. Ahora se ELIGE de la lista de Técnicos, y si no está se crea
     ahí mismo — con lo que haga falta para poder pagarle después.
     (Sebastián, 26 ago 2026: "que los técnicos se puedan elegir por dropdown en el
     proyecto, y si no está que dé un botón crear uno con toda la info que lo sincronice
     a Técnicos".)

     Se sigue guardando el NOMBRE en projects.crew además del id: lo que ya existe lo lee
     así (el plan de rodaje, el email al editor, la factura), y romperlo para ganar
     prolijidad no vale. El id es lo que ata; el nombre es lo que se lee. */
  /* Se pide UNA vez por sesión, con o sin resultado. `crewPedidos` es lo que corta: sin
     esa marca, una lista vacía —porque falló la red, o porque todavía no hay técnicos—
     hacía que se pidiera de nuevo en cada dibujo. */
  let crewPedidos = false;
  async function pjCrewTecnicos(){
    if (crewPedidos || crewList.length) return crewList;
    crewPedidos = true;
    const { data, error } = await supabase.from('crew').select('*').eq('activo', true).order('name');
    if (error) crewPedidos = false;              // que se pueda reintentar al abrir otro proyecto
    else crewList = data || [];
    return crewList;
  }

  /* El que monta, elegido de Técnicos como el resto del equipo. El email sale de SU ficha:
     tenerlo escrito acá y en la ficha es tener dos verdades, y un día una queda vieja.
     Si el técnico no tiene email, se dice — sin email no se le pueden mandar las notas. */
  function pjEditorRender(){
    const p = pjCur, sel = $('pj-editor-sel'); if (!p || !sel) return;
    pjCrewTecnicos().then((lista) => {
      if (pjCur !== p) return;
      const actual = String(p.editor || '');
      const hay = lista.some((t) => crewNorm(t.name) === crewNorm(actual));
      sel.innerHTML = '<option value="">— elegir —</option>' +
        (actual && !hay ? '<option value="' + esc(actual) + '" selected>' + esc(actual) + ' · sin ficha</option>' : '') +
        lista.map((t) => '<option value="' + esc(t.name) + '"' +
          (crewNorm(t.name) === crewNorm(actual) ? ' selected' : '') + '>' + esc(t.name) +
          (t.email ? '' : ' · sin email') + '</option>').join('') +
        '<option value="__nuevo__">＋ Crear un técnico nuevo…</option>';

      const t = lista.find((x) => crewNorm(x.name) === crewNorm(actual));
      const nota = $('pj-editor-nota');
      nota.innerHTML = !actual ? 'Sale de Técnicos. A esta persona se le mandan las notas del cliente.'
        : t && t.email ? 'Las notas van a <b>' + esc(t.email) + '</b> — de su ficha.'
        : t ? '⚠️ <b>' + esc(t.name) + '</b> no tiene email en su ficha. Sin eso no se le pueden mandar las notas.'
        : '⚠️ «' + esc(actual) + '» no está en Técnicos. Elegilo de la lista o creá su ficha.';
      /* El email del proyecto se mantiene al día con el de la ficha: lo leen el guardado y
         el email al editor, y si se quedan viejos las notas salen a una dirección muerta. */
      if (t && t.email && $('pj-editor-email').value !== t.email){
        $('pj-editor-email').value = t.email;
        pjAutoGuardar();
      }
    });
  }

  function pjRenderCrew(){
    const p = pjCur, box = $('pj-crew'); if (!box) return;
    const crew = Array.isArray(p.crew) ? p.crew : [];
    if (!crew.length){
      const n = pjRolesDelPresupuesto().length;
      box.innerHTML = '<span class="muted-note">Sin armar' + (n ? ' — hay <b>' + n + ' roles</b> vendidos en el presupuesto' : '') + '</span>';
      return;
    }
    /* Los técnicos se piden una vez y quedan en memoria; mientras llegan, el select
       muestra al que ya estaba puesto para que no parpadee vacío.
       EL REDIBUJADO SOLO SI ANTES NO ESTABAN. Sin esa condición esto se llamaba a sí
       mismo para siempre —dibujar pedía, y la respuesta volvía a dibujar— y la pestaña
       se colgaba al abrir cualquier proyecto que tuviera crew.
       (Sebastián, 26 ago 2026: "no puedo entrar dentro del proyecto ahora".) */
    if (!crewList.length){
      pjCrewTecnicos().then((t) => { if (pjCur === p && t.length) pjRenderCrew(); });
    }

    const opciones = (nombre) => {
      const hay = crewList.some((t) => crewNorm(t.name) === crewNorm(nombre));
      return '<option value="">— elegir —</option>' +
        /* Si el proyecto trae un nombre que todavía no es un técnico (de antes de esta
           pantalla), se muestra igual y marcado: esconderlo lo borraría en silencio. */
        (nombre && !hay ? '<option value="' + esc(nombre) + '" selected>' + esc(nombre) + ' · sin ficha</option>' : '') +
        crewList.map((t) => '<option value="' + esc(t.name) + '"' +
          (crewNorm(t.name) === crewNorm(nombre) ? ' selected' : '') + '>' + esc(t.name) +
          ((t.roles || []).length ? ' · ' + esc((t.roles || [])[0]) : '') + '</option>').join('') +
        '<option value="__nuevo__">＋ Crear un técnico nuevo…</option>';
    };

    /* La citación GENERAL: la primera hora del plan. Es el default de todos, y se muestra
       en gris dentro del campo para que se vea que ya hay una respuesta aunque no
       escribas nada. */
    const filasP = pjPlanFilas();
    const citaGeneral = pjCitaGeneral();

    /* Cada uno con SU hora. El DP y el asistente llegan a montar, el actor y el cliente
       llegan cuando se rueda: una sola hora para todos hace que la mitad del equipo
       espere dos horas o que el actor llegue tarde a lo suyo.
       Es lo que Maestro hace bien —cada persona recibe su citación, no la del equipo—.
       (Sebastián, 27 ago 2026: "calltime para cada persona para el plan de rodaje, para
        clientes, técnicos, actores, etc.") */
    box.innerHTML = '<div class="pj-crew">' + crew.map((c, i) =>
      '<div class="pj-crew-row" data-i="' + i + '">' +
        '<span class="pj-crew-rol" title="' + esc(c.rol || '') + '">' + esc(c.rol || 'Rol') + '</span>' +
        '<select class="pj-inp pj-crew-nm">' + opciones(c.nombre) + '</select>' +
        '<input class="pj-inp pj-crew-h" type="time" value="' + esc(c.hora || '') + '"' +
          (citaGeneral ? ' placeholder="' + esc(citaGeneral) + '" title="Su citación. Vacío = la general, ' + esc(citaGeneral) + '"' : ' title="Su citación"') + ' />' +
        '<button class="pj-crew-x" type="button" title="Sacar del crew">✕</button>' +
      '</div>').join('') + '</div>' +
      '<p class="muted-note" style="margin:9px 0 0">Salen de <b>Técnicos</b>. Lo que elijas acá es a quien después se le carga el costo y se le manda el plan.' +
      (citaGeneral ? ' La hora es <b>su</b> citación: vacía significa la general (' + esc(citaGeneral) + ').' : '') + '</p>';

    box.querySelectorAll('.pj-crew-h').forEach((inp) => inp.addEventListener('change', () => {
      const i = +inp.closest('[data-i]').dataset.i;
      const fila = pjCur.crew && pjCur.crew[i]; if (!fila) return;
      fila.hora = inp.value || null;
      pjAutoGuardar();
      pjPlanGenteRender && pjPlanGenteRender();
    }));

    /* El crew también se guarda solo: sacar a alguien y volver al listado sin tocar
       Guardar lo devolvía a la lista como si nada hubiera pasado. */
    box.querySelectorAll('.pj-crew-x').forEach((b) => b.addEventListener('click', () => {
      const i = +b.closest('[data-i]').dataset.i;
      pjCur.crew = (pjCur.crew || []).filter((_, j) => j !== i);
      pjRenderCrew();
      pjAutoGuardar();
    }));
    box.querySelectorAll('.pj-crew-nm').forEach((sel) => sel.addEventListener('change', async () => {
      const i = +sel.closest('[data-i]').dataset.i;
      const fila = pjCur.crew && pjCur.crew[i]; if (!fila) return;
      if (sel.value === '__nuevo__'){
        sel.value = fila.nombre || '';
        const nuevo = await pjCrewNuevo(fila.rol);
        if (!nuevo) return;
        fila.nombre = nuevo.name; fila.crew_id = nuevo.id;
      } else {
        fila.nombre = sel.value;
        const t = crewList.find((x) => crewNorm(x.name) === crewNorm(sel.value));
        fila.crew_id = t ? t.id : null;
        /* El rol del proyecto se suma a los roles del técnico: la próxima vez aparece
           con "Tobias · Director of Photography" y se elige sin pensar. */
        if (t && fila.rol && !(t.roles || []).includes(fila.rol)){
          const roles = [...(t.roles || []), fila.rol];
          await supabase.from('crew').update({ roles }).eq('id', t.id);
          t.roles = roles;
        }
      }
      pjRenderCrew();
      pjAutoGuardar();
    }));
  }

  /* Crear un técnico sin salir del proyecto. Pide lo mínimo para poder PAGARLE después:
     un nombre no alcanza cuando llega la factura y hay que saber a quién es y cuánto se
     había acordado. Todo lo demás se completa en su ficha. */
  function pjCrewNuevo(rolSugerido){
    return new Promise((resolve) => {
      const box = $('pj-crew');
      if ($('pjc-form')) $('pjc-form').remove();
      const caja = document.createElement('div');
      caja.id = 'pjc-form';
      caja.style.cssText = 'border:1px solid var(--acid);border-radius:12px;padding:14px 15px;margin-top:11px';
      caja.innerHTML =
        '<p class="pj-sec-h" style="margin:0 0 10px;padding:0;border:0">Nuevo técnico</p>' +
        '<div class="pj-crew-row" style="grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:8px;margin-bottom:8px">' +
          '<input class="pj-inp" id="pjc-nom" placeholder="Nombre y apellido" />' +
          '<input class="pj-inp" id="pjc-rol" placeholder="Rol" value="' + esc(rolSugerido || '') + '" />' +
        '</div>' +
        '<div class="pj-crew-row" style="grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:8px;margin-bottom:8px">' +
          '<input class="pj-inp" id="pjc-mail" type="email" placeholder="Email — para mandarle el plan y las notas" />' +
          '<input class="pj-inp" id="pjc-tel" placeholder="Teléfono" />' +
        '</div>' +
        '<div class="pj-crew-row" style="grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1.3fr);gap:8px">' +
          '<input class="pj-inp js-chf" id="pjc-dia" type="text" inputmode="decimal" placeholder="CHF por día" />' +
          '<input class="pj-inp" id="pjc-empresa" placeholder="Factura como (GmbH)" />' +
          '<input class="pj-inp" id="pjc-iban" placeholder="IBAN" />' +
        '</div>' +
        '<div class="ab-urlrow" style="margin-top:11px">' +
          '<button class="btn btn-primary small" id="pjc-ok" type="button">Crear y usar</button>' +
          '<button class="btn btn-ghost small" id="pjc-no" type="button">Cancelar</button>' +
          '<span class="muted-note" id="pjc-hint">Queda en Técnicos, con su ficha y su historial.</span>' +
        '</div>';
      box.after(caja);
      $('pjc-nom').focus();

      const cerrar = (r) => { caja.remove(); resolve(r); };
      $('pjc-no').addEventListener('click', () => cerrar(null));
      caja.addEventListener('keydown', (e) => {
        if (e.key === 'Enter'){ e.preventDefault(); $('pjc-ok').click(); }
        if (e.key === 'Escape') cerrar(null);
      });
      $('pjc-ok').addEventListener('click', async () => {
        const nom = $('pjc-nom').value.trim();
        if (!nom){ $('pjc-hint').textContent = '⚠️ Falta el nombre'; $('pjc-nom').focus(); return; }
        const mail = $('pjc-mail').value.trim().toLowerCase();
        /* Si ya hay una ficha con ese nombre o ese email, se usa esa en vez de crear otra:
           duplicar un técnico parte su historial de plata en dos y no se nota hasta que
           falta la mitad. */
        const ya = crewList.find((t) => crewNorm(t.name) === crewNorm(nom) ||
                                        (mail && crewNorm(t.email) === crewNorm(mail)));
        if (ya){ toast('Ya existe: se usa la ficha de ' + ya.name); cerrar(ya); return; }
        const dia = numCHF($('pjc-dia').value) || null;
        const { data, error } = await supabase.from('crew').insert({
          name: nom,
          roles: $('pjc-rol').value.trim() ? [$('pjc-rol').value.trim()] : [],
          email: mail || null, phone: $('pjc-tel').value.trim() || null,
          tarifa_dia: dia, empresa: $('pjc-empresa').value.trim() || null,
          iban: $('pjc-iban').value.trim() || null,
        }).select().single();
        if (error){ $('pjc-hint').textContent = '⚠️ ' + error.message; return; }
        crewList.push(data);
        await crewAliasAgregar(data.id, nom);
        toast('🎥 ' + nom + ' agregado a Técnicos');
        cerrar(data);
      });
    });
  }

  /* El equipo técnico también sale del presupuesto: los kits y alquileres son
     posiciones con nombre propio, no hay que volver a escribirlos. */
  function pjRenderGear(){
    const p = pjCur, box = $('pj-gear'); if (!box) return;
    const delPres = pjClasificar().equipo;
    const manual = Array.isArray(p.gear) ? p.gear.map((g) => g.nombre || String(g)) : [];
    const todo = [...new Set([...delPres, ...manual])];
    box.innerHTML = todo.length
      ? todo.map((g) => '<div class="muted-note" style="color:var(--text);font-size:13px">• ' + esc(g) + '</div>').join('')
        + '<p class="muted-note" style="margin:6px 0 0;font-size:11.5px">Del presupuesto — editable cuando haga falta.</p>'
      : '<span class="muted-note">Sin equipo en el presupuesto</span>';
  }




  /* Facturar al cliente desde el proyecto: encuentra el documento del que salió este
     proyecto —la propuesta aceptada o la oferta ganada— y abre el flujo de bexio que ya
     existe. Si no hay ninguno, lo dice con lo que se puede hacer, en vez de fallar. */
  function pjFacturar(){
    const p = pjCur; if (!p) return;
    const prop = (ppList || []).find((x) => !x.archived && !x.is_template && x.status === 'accepted'
      && (String(x.deal_id || '') === String(p.deal_id) || String(x.lead_id || '') === String(p.lead_id)));
    if (prop) return bxAbrir('propuesta', prop.id);
    const of = (offersList || []).filter((o) => !o.archived && o.status !== 'tier'
      && String(o.lead_id || '') === String(p.lead_id))
      .sort((a, b) => ((b.status === 'won') - (a.status === 'won'))
        || (Date.parse(b.updated_at || 0) - Date.parse(a.updated_at || 0)))[0];
    if (of) return bxAbrir('oferta', of.id);
    toast('Este proyecto no tiene oferta ni propuesta atrás — creá una en Ofertas y desde ahí sale la factura');
  }



  /* ---------- HORAS PUESTAS (SQL 0159) ----------
     "Ver costos reales de las personas versus el tiempo invertido para ver si lo
     mantenemos o no" — la otra mitad del margen. Los costos ya se cargan y las facturas
     los respaldan; esto es cuánto TIEMPO se puso, valuado con el costo por hora de cada
     persona: una hora de Sebastián y una de un freelance no valen lo mismo. */
  let pjHoras = [], pjTarifas = {};

  /* Qué puede hacer el token de Vimeo y cómo está configurado cada video. Nace de una
     pregunta concreta de Sebastián: "en vimeo el video va a estar como privado… tiene
     que poder ser leído igualmente". La respuesta no se puede adivinar desde afuera:
     hay que preguntarle a Vimeo. */
  /* Delegado: el botón vive en una sub-pestaña que puede no estar dibujada cuando corre
     este script. Engancharlo por id acá arriba fallaría en silencio — ya me pasó hoy con
     el playbook. */
  document.addEventListener('click', (e) => {
    if (e.target && e.target.id === 'vm-probe') vmProbe();
  });

  async function vmProbe(){
    const out = $('vm-probe-out'), b = $('vm-probe');
    b.disabled = true; out.innerHTML = '<p class="muted-note">Preguntándole a Vimeo…</p>';
    try {
      const { data, error } = await supabase.functions.invoke('vimeo-stats', { body: { probe: true } });
      if (error) throw new Error(error.message);
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
      if (data.pending){ out.innerHTML = '<p class="muted-note" style="color:#f0c060">⚠️ No hay token de Vimeo configurado.</p>'; return; }

      const puedeEditar = /\bedit\b/.test(String(data.scopes || ''));
      const vids = Array.isArray(data.videos) ? data.videos : [];
      /* Lo que importa de cada video: si se puede ver en vimeo.com, y si viven.ch está
         entre los dominios donde se puede embeber. Las dos cosas juntas. */
      const filas = vids.map((v) => {
        const pv = v.privacidad || {};
        const publico = pv.view === 'anybody';
        const emb = pv.embed;
        const okDominio = emb === 'whitelist';
        const bien = !publico && okDominio;
        return '<tr><td>' + esc(v.nombre || v.id) + '</td>' +
          '<td class="muted-note">' + esc(String(pv.view || '—')) + '</td>' +
          '<td class="muted-note">' + esc(String(emb || '—')) + '</td>' +
          '<td>' + (bien ? '<span style="color:#7ed957">✓ listo para el portal</span>'
            : publico ? '<span style="color:#f0c060">lo ve cualquiera en vimeo.com</span>'
            : '<span style="color:#f0c060">falta permitir el dominio</span>') + '</td></tr>';
      }).join('');

      out.innerHTML =
        '<p class="muted-note" style="margin:0 0 10px">Permisos del token: <b>' + esc(String(data.scopes || '—')) + '</b> · ' +
          (puedeEditar ? 'puede cambiar la privacidad desde acá' : 'es de solo lectura: la privacidad se cambia en Vimeo') + '</p>' +
        (vids.length
          ? '<table class="lead-table"><thead><tr><th>Video</th><th>Quién lo ve</th><th>Dónde se embebe</th><th>Para el portal</th></tr></thead><tbody>' + filas + '</tbody></table>'
          : '<p class="muted-note">La cuenta no devolvió videos.</p>');
    } catch (e){ out.innerHTML = '<p class="muted-note" style="color:#f0c060">⚠️ ' + esc(e.message || String(e)) + '</p>'; }
    finally { b.disabled = false; }
  }

  /* Leer el PDF de la oferta y llenar el formulario con lo que dice.
     NO crea nada: llena los campos para que se revise. Un PDF mal leído que ya creó un
     proyecto es más trabajo que uno que no se leyó. */
  let pjOfertaItems = null;
  async function pjLeerOferta(f){
    if (!f) return;
    const msg = $('pjf-pdf-msg');
    if (f.size > 10 * 1024 * 1024){ msg.textContent = '⚠️ Más de 10 MB — probá con el PDF solo'; return; }
    msg.textContent = '🤖 Leyendo…';
    try {
      const b64 = await new Promise((ok, no) => {
        const r = new FileReader();
        r.onload = () => ok(String(r.result).split(',')[1]);
        r.onerror = no; r.readAsDataURL(f);
      });
      const { data, error } = await supabase.functions.invoke('ai-oferta-leer', { body: { archivo_b64: b64, mime: f.type } });
      if (error) throw new Error(error.message);
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');

      if (data.titulo) $('pjf-title').value = data.titulo;
      if (data.total) $('pjf-monto').value = String(data.total);
      pjOfertaItems = data.items && data.items.length ? data.items : null;

      /* El cliente se busca entre los que ya existen; no se crea uno nuevo desde un PDF.
         Si no aparece, se dice cuál buscaba en vez de elegir el que se le parezca. */
      let elegido = null;
      const norm = (x) => String(x || '').toLowerCase().replace(/[^a-z0-9]+/g, '');
      const busca = [data.email, data.contacto, data.cliente].filter(Boolean);
      for (const q of busca){
        elegido = (allLeads || []).find((l) =>
          (data.email && String(l.email || '').toLowerCase() === String(data.email).toLowerCase()) ||
          (norm(l.name) && norm(l.name) === norm(q)) ||
          (norm(l.company) && norm(l.company) === norm(q)));
        if (elegido) break;
      }
      if (elegido) $('pjf-lead').value = String(elegido.id);

      const partes = [];
      partes.push('✅ ' + (data.items ? data.items.length : 0) + ' posiciones · ' + (data.total ? pjCHF(data.total) : 'sin total'));
      if (!elegido && data.cliente) partes.push('no encontré a «' + data.cliente + '» en Personas: elegilo vos');
      if (data.confianza === 'baja') partes.push('⚠️ lo leyó con poca confianza');
      if (data.dudas && data.dudas.length) partes.push('⚠️ ' + data.dudas.join(' · '));
      msg.innerHTML = esc(partes.join(' · '));
    } catch (e){ msg.textContent = '⚠️ ' + (e.message || e); }
  }

  /* Importar la oferta a un proyecto que YA existe: trae las posiciones, el monto y —lo
     que él pedía— arma el crew a partir de los roles vendidos. Pide confirmación porque
     pisa el paquete que el proyecto ya tenía. */
  async function pjImportarOferta(f){
    const p = pjCur; if (!p || !f) return;
    const msg = $('pj-imp-msg');
    if (f.size > 10 * 1024 * 1024){ msg.textContent = '⚠️ Más de 10 MB — probá con el PDF solo'; return; }
    msg.textContent = '🤖 Leyendo…';
    try {
      const b64 = await new Promise((ok, no) => {
        const r = new FileReader();
        r.onload = () => ok(String(r.result).split(',')[1]);
        r.onerror = no; r.readAsDataURL(f);
      });
      const { data, error } = await supabase.functions.invoke('ai-oferta-leer', { body: { archivo_b64: b64, mime: f.type } });
      if (error) throw new Error(error.message);
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
      if (!data.items || !data.items.length){ msg.textContent = '⚠️ No encontré posiciones en ese PDF'; return; }

      const tenia = Array.isArray(p.items) ? p.items.length : 0;
      const aviso = 'Leí ' + data.items.length + ' posiciones' + (data.total ? ' · ' + pjCHF(data.total) : '') +
        (tenia ? '\n\n⚠️ Este proyecto ya tiene ' + tenia + ' posiciones y se van a REEMPLAZAR.' : '') +
        ((data.dudas && data.dudas.length) ? '\n\n⚠️ ' + data.dudas.join('\n⚠️ ') : '') +
        '\n\n¿Lo importo?';
      if (!confirm(aviso)) { msg.textContent = 'Cancelado.'; return; }

      const patch = { items: data.items };
      if (data.total) patch.amount_chf = data.total;
      const { error: e2 } = await supabase.from('projects').update(patch).eq('id', p.id);
      if (e2) throw new Error(e2.message);
      Object.assign(p, patch);

      /* Y el crew: los roles de gente que están vendidos pasan a la lista, sin pisar a
         los que ya tienen nombre puesto. */
      const roles = pjRolesDelPresupuesto();
      const ya = new Set((p.crew || []).map((c) => String(c.rol || '').toLowerCase()));
      const nuevos = roles.filter((r) => !ya.has(r.toLowerCase()));
      if (nuevos.length){
        p.crew = (p.crew || []).concat(nuevos.map((r) => ({ rol: r, nombre: '' })));
        await supabase.from('projects').update({ crew: p.crew }).eq('id', p.id);
      }

      msg.textContent = '✅ ' + data.items.length + ' posiciones' + (nuevos.length ? ' · ' + nuevos.length + ' roles al crew' : '');
      pjRenderDetail();
      toast('📄 Oferta importada' + (nuevos.length ? ' · ponele nombre al crew' : ''));
    } catch (e){ msg.textContent = '⚠️ ' + (e.message || e); }
  }

  /* ═══ PROYECTO DE PRUEBA ═══
     Sebastián, 26 ago 2026: "quiero hacer uno como test para que podamos testear cosas
     — crear proyecto test x1, x2, etc. Para que no vaya a clientes reales."

     El truco está en el CONTACTO, no en el proyecto: se crea con un email
     prueba+N@viven.ch, que la base marca como es_prueba sola. Con eso, todo lo que sale
     del proyecto le llega a él y a nadie más — el brief, el portal, las notas al editor,
     los avisos. Y no ensucia ningún número, porque los leads de prueba ya están fuera de
     listas, contadores y conversión.

     No hace falta acordarse de nada: la regla vive en la base y vale para lo que venga. */
  async function pjCrearTest(){
    const b = $('pj-test'); b.disabled = true;
    try {
      /* El número sale de los que ya existen, no de un contador aparte: si se borra el
         test 2, el próximo es 3 igual y no hay dos con el mismo nombre. */
      const previos = (pjList || []).filter((x) => /^Proyecto de prueba/i.test(x.title || ''));
      const n = previos.reduce((mx, x) => Math.max(mx, +(String(x.title).match(/x(\d+)/i) || [])[1] || 0), 0) + 1;
      const titulo = 'Proyecto de prueba x' + n;
      /* Con el buzón de Sebastián, no uno inventado: prueba+1@viven.ch no existe como
         casilla y el código del portal no le llegaba a nadie. Con el signo + delante del
         buzón real, el correo entra igual y la dirección sigue contando como prueba
         (verificado contra email_es_prueba). */
      const mail = 'sebastian+prueba' + n + '@viven.ch';

      let lead = (allLeads || []).concat(leadsPrueba || []).find((l) => String(l.email || '').toLowerCase() === mail);
      if (!lead){
        const { data: nl, error: e0 } = await supabase.from('leads').insert({
          name: 'Cliente de prueba ' + n, first_name: 'Cliente', email: mail,
          company: 'PRUEBA — no es un cliente', lang: 'es', status: 'ganado',
          channel: 'prueba', message: 'Contacto creado para probar el flujo. No es real.',
        }).select().single();
        if (e0) throw new Error(e0.message);
        lead = nl; leadsPrueba.push(nl);
      }

      const ahora = new Date().toISOString();
      const { data: deal, error: e1 } = await supabase.from('deals').insert({
        lead_id: lead.id, title: titulo, stage: 'ganado', deal_value: 12000,
        won_at: ahora, last_stage_at: ahora,
      }).select().single();
      if (e1) throw new Error(e1.message);

      const { data: pr, error: e2 } = await supabase.from('projects').insert({
        deal_id: deal.id, lead_id: lead.id, title: titulo, stage: 'post',
        started_at: ahora, amount_chf: 12000,
        editor_email: 'sebastian+editor@viven.ch', editor: 'Editor de prueba',
        portal_note: 'Esto es un proyecto de prueba. No es un cliente.',
      }).select().single();
      if (e2){ await supabase.from('deals').delete().eq('id', deal.id); throw new Error(e2.message); }

      dealsList.unshift(deal);
      toast('🧪 ' + titulo + ' — todo lo que salga de acá va a ' + mail);
      await pjLoad();
      pjOpen(pr.id);
    } catch (e){ toast('⚠️ ' + (e.message || e)); }
    finally { b.disabled = false; }
  }

  /* Crear un proyecto a mano, con su deal ganado por atrás. */
  async function pjCrearManual(){
    const lid = $('pjf-lead').value;
    const titulo = $('pjf-title').value.trim();
    if (!lid){ toast('Elegí de quién es el proyecto'); return; }
    if (!titulo){ toast('Ponele nombre al proyecto'); return; }
    const monto = numCHF($('pjf-monto').value) || null;
    const b = $('pjf-save'); b.disabled = true;
    const ahora = new Date().toISOString();
    try {
      const { data: deal, error: e1 } = await supabase.from('deals').insert({
        lead_id: +lid, title: titulo, stage: 'ganado',
        deal_value: monto, won_at: ahora, last_stage_at: ahora,
      }).select().single();
      if (e1) throw new Error(e1.message);

      const { data: pr, error: e2 } = await supabase.from('projects').insert({
        deal_id: deal.id, lead_id: +lid, title: titulo,
        stage: $('pjf-stage').value, started_at: ahora, amount_chf: monto,
        /* Las posiciones leídas del PDF entran como el paquete del proyecto: es lo mismo
           que hereda un proyecto nacido de una propuesta aceptada. */
        items: pjOfertaItems || null,
      }).select().single();
      if (e2){
        /* Si el proyecto falla, el deal suelto queda dando vueltas en el board como una
           venta que nadie hizo. Se deshace. */
        await supabase.from('deals').delete().eq('id', deal.id);
        throw new Error(e2.message);
      }

      dealsList.unshift(deal);
      $('pj-form').hidden = true;
      $('pjf-title').value = ''; $('pjf-monto').value = ''; $('pjf-lead').value = '';
      $('pjf-pdf-msg').textContent = ''; pjOfertaItems = null;
      toast('🎬 Proyecto ' + (pr.ref ? pr.ref + ' ' : '') + 'creado');
      await pjLoad();
      pjOpen(pr.id);
    } catch (e){ toast('⚠️ ' + (e.message || e)); }
    finally { b.disabled = false; }
  }

  async function pjHorasLoad(){
    const p = pjCur; if (!p) return;
    const [h, t] = await Promise.all([
      supabase.from('project_hours').select('*').eq('project_id', p.id).order('fecha', { ascending: false }),
      supabase.from('team_profiles').select('email,name,costo_hora'),
    ]);
    pjHoras = h.error ? [] : (h.data || []);
    pjTarifas = {};
    (t.error ? [] : (t.data || [])).forEach((x) => { pjTarifas[String(x.email || '').toLowerCase()] = x; });
    pjHorasRender();
  }

  const pjTarifa = (persona) => Number((pjTarifas[String(persona || '').toLowerCase()] || {}).costo_hora) || 0;

  /* Interno vs externo. Solo el interno necesita costo por hora: el freelance ya manda su
     factura y esa plata entra por "Facturas del crew", así que ponerle también una tarifa
     contaría su costo dos veces. Interno = está en el equipo (team_profiles) o tiene mail
     @viven.ch. (Sebastián, 26 ago 2026: "Solo para gente interna, ya que la externa manda
     factura".) */
  function pjEsInterno(persona){
    const k = String(persona || '').toLowerCase();
    return !!pjTarifas[k] || /@viven\.ch$/.test(k);
  }

  /* Poner la tarifa desde la misma fila, sin ir a Mi perfil. Guarda en team_profiles, que
     es de donde salen todas las tarifas, así vale para este proyecto y para los que vengan. */
  async function pjTarifaPoner(persona){
    const k = String(persona || '').toLowerCase();
    if (!pjEsInterno(k)){
      toast('Es crew externo: su costo entra por la factura que manda, no por una tarifa');
      return;
    }
    const nom = (pjTarifas[k] || {}).name || persona;
    const act = pjTarifa(k);
    const v = prompt('Costo por hora de ' + nom + ' (CHF)\n\nEs lo que le cuesta a VIVEN una hora suya — sueldo con cargas dividido las horas del mes, no lo que se le factura al cliente.', act ? String(act) : '');
    if (v === null) return;
    const n = numCHF(v);
    if (!n){ toast('Sin un número no se puede calcular el costo'); return; }
    const { error } = await supabase.from('team_profiles')
      .upsert({ email: k, name: (pjTarifas[k] || {}).name || null, costo_hora: n }, { onConflict: 'email' });
    if (error){ toast(error.message); return; }
    pjTarifas[k] = { ...(pjTarifas[k] || {}), email: k, costo_hora: n };
    toast('Tarifa de ' + nom + ': ' + pjCHF(n) + '/h — el margen ya la está contando');
    pjHorasRender();
  }

  function pjHorasRender(){
    const p = pjCur; if (!p) return;
    const total = pjHoras.reduce((a, h) => a + Number(h.horas), 0);
    const costo = pjHoras.reduce((a, h) => a + Number(h.horas) * pjTarifa(h.persona), 0);
    const sinTarifa = pjHoras.filter((h) => !pjTarifa(h.persona));
    const hSin = sinTarifa.reduce((a, h) => a + Number(h.horas), 0);
    const quienes = [...new Set(pjHoras.map((h) => h.persona))];

    const est = $('pj-horas-est');
    if (est) est.textContent = total
      ? total.toLocaleString('de-CH') + ' h · ' + quienes.length + (quienes.length === 1 ? ' persona' : ' personas')
      : 'sin anotar';

    /* El margen "de verdad" = vendido − costos cargados − costo del tiempo. Se muestra
       solo cuando hay horas: sin horas, es el mismo número de arriba con otro nombre. */
    const vendido = Number(p.amount_chf) || 0;
    const costoLineas = pjCostos.reduce((a, c) => a + pjCostoTotal(c), 0);
    const margen = vendido - costoLineas - costo;
    $('pj-horas-res').innerHTML = !pjHoras.length
      ? '<p class="muted-note" style="margin:0 0 12px">Sin horas anotadas. Un proyecto puede cerrar con buen margen y haberse comido tres semanas de alguien — esto es lo que lo muestra.</p>'
      : '<div class="pj-margen-box">' +
          '<div><span>Tiempo puesto</span><b>' + total.toLocaleString('de-CH') + ' h</b></div>' +
          '<div><span>Lo que costó ese tiempo</span><b>' + pjCHF(costo) + '</b></div>' +
          '<div><span>Margen contando el tiempo</span><b style="color:' +
            (margen < 0 ? '#ff8b8b' : hSin ? '#f0c060' : 'var(--acid)') + '">' + pjCHF(margen) + '</b></div>' +
        '</div>' +
        (() => {
          const int = sinTarifa.filter((h) => pjEsInterno(h.persona));
          const ext = sinTarifa.filter((h) => !pjEsInterno(h.persona));
          const hInt = int.reduce((a, h) => a + Number(h.horas), 0);
          const hExt = ext.reduce((a, h) => a + Number(h.horas), 0);
          const av = [];
          if (hInt) av.push('<p class="muted-note" style="margin:8px 0 4px;color:#f0c060">⚠️ ' + hInt.toLocaleString('de-CH') +
            ' h de ' + esc([...new Set(int.map((h) => h.persona))].join(', ')) +
            ' sin costo por hora — esas horas entran como gratis y el margen miente para arriba. ' +
            'Tocá <b>sin tarifa</b> en la fila para ponerlo.</p>');
          if (hExt) av.push('<p class="muted-note" style="margin:4px 0 4px">' + hExt.toLocaleString('de-CH') +
            ' h de ' + esc([...new Set(ext.map((h) => h.persona))].join(', ')) +
            ' son crew externo: su costo entra por la factura que mandan, no por tarifa.</p>');
          if (!av.length) av.push('<p class="muted-note" style="margin:8px 0 12px">Todas las horas tienen su costo — este margen es el real.</p>');
          return av.join('') + '<div style="height:8px"></div>';
        })();

    $('pj-horas').innerHTML = !pjHoras.length ? '' :
      '<table class="lead-table"><thead><tr><th>Fecha</th><th>Quién</th><th>Qué hizo</th><th>Fase</th>' +
      '<th style="text-align:right">Horas</th><th style="text-align:right">Costo</th><th></th></tr></thead><tbody>' +
      pjHoras.map((h) => {
        const tf = pjTarifa(h.persona);
        const quien = (pjTarifas[String(h.persona || '').toLowerCase()] || {}).name || h.persona;
        return '<tr><td>' + fmtDMY(h.fecha) + '</td><td>' + esc(quien) + '</td>' +
          '<td>' + esc(h.tarea || '—') + '</td><td class="muted-note">' + esc(h.fase || '—') + '</td>' +
          '<td style="text-align:right">' + Number(h.horas).toLocaleString('de-CH') + '</td>' +
          '<td style="text-align:right">' + (tf
            ? '<button type="button" class="pj-tf-set" data-tf="' + esc(String(h.persona || '')) + '" title="' + pjCHF(tf) + '/h — click para cambiarlo">' + Math.round(h.horas * tf).toLocaleString('de-CH') + '</button>'
            : pjEsInterno(h.persona)
              ? '<button type="button" class="pj-tf-set falta" data-tf="' + esc(String(h.persona || '')) + '" title="Poner el costo por hora">sin tarifa</button>'
              : '<span class="muted-note" title="El crew externo factura aparte: su costo ya entra por Facturas del crew">vía factura</span>') + '</td>' +
          '<td><button class="pj-crew-x" data-hdel="' + h.id + '" type="button">✕</button></td></tr>';
      }).join('') + '</tbody></table>';

    $('pj-horas').querySelectorAll('[data-hdel]').forEach((b) => b.addEventListener('click', () => pjHoraBorrar(b.dataset.hdel)));
    $('pj-horas').querySelectorAll('[data-tf]').forEach((b) => b.addEventListener('click', () => pjTarifaPoner(b.dataset.tf)));
  }

  async function pjHoraAdd(){
    const p = pjCur; if (!p) return;
    /* Se propone quién sos y el crew que ya está armado: escribir el nombre a mano cada
       vez es la razón por la que nadie anota horas en ningún lado. */
    const opciones = [...new Set([meEmail, ...(p.crew || []).map((c) => c.nombre).filter(Boolean)])].filter(Boolean);
    const quien = prompt('¿Quién puso las horas?\n\n' + opciones.map((o, i) => (i + 1) + ') ' + o).join('\n') +
      '\n\nEscribí el número, o un nombre nuevo.', '1');
    if (quien === null) return;
    const persona = /^\d+$/.test(quien.trim()) ? opciones[+quien.trim() - 1] : quien.trim();
    if (!persona) return;
    const horas = numCHF(prompt('¿Cuántas horas?', '8') || '');
    if (!horas){ toast('Sin horas no hay nada que anotar'); return; }
    const tarea = prompt('¿Qué hizo? (opcional)') || '';
    const { data, error } = await supabase.from('project_hours').insert({
      project_id: p.id, persona, horas, tarea: tarea.trim() || null,
      fecha: new Date().toISOString().slice(0, 10),
    }).select().single();
    if (error){ toast(error.message); return; }
    pjHoras.unshift(data);
    pjHorasRender();
    toast('⏱ ' + horas + ' h · ' + persona);
  }
  async function pjHoraBorrar(id){
    const { error } = await supabase.from('project_hours').delete().eq('id', id);
    if (error){ toast(error.message); return; }
    pjHoras = pjHoras.filter((x) => String(x.id) !== String(id));
    pjHorasRender();
  }

  /* ---------- PORTAL DEL CLIENTE: VERSIONES, COMENTARIOS Y EXPORT (SQL 0157) ----------
     Del lado del equipo: qué versión vio, qué comentó y en qué segundo, y de ahí sacar
     las notas para Premiere. Del lado del cliente vive en /portal/. */
  let pjVers = [], pjComs = [], pjFiles = [];
  const pjMMSS = (ms) => { const s = Math.floor((ms || 0) / 1000); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };

  async function pjPortalLoad(){
    const p = pjCur; if (!p) return;
    const [v, c, f] = await Promise.all([
      supabase.from('project_versions').select('*').eq('project_id', p.id).order('n', { ascending: false }),
      supabase.from('project_comments').select('*').eq('project_id', p.id).order('tc_ms', { ascending: true, nullsFirst: true }),
      supabase.from('project_files').select('*').eq('project_id', p.id).order('created_at', { ascending: false }),
    ]);
    pjVers = v.error ? [] : (v.data || []);
    pjComs = c.error ? [] : (c.data || []);
    pjFiles = f.error ? [] : (f.data || []);
    pjPortalRender();
    pjRenderSteps();
  }

