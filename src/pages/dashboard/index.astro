<!-- ============ LEAD DETAIL MODAL ============ -->
<style is:global>
/* ============ FICHA DE CONTACTO V2 — estilo HubSpot/Keap ============
   Única ficha de persona del dashboard (la clásica se eliminó por completo —
   pedido de Sebastián: "de ahora en mas solo la ficha nueva, la vieja no existe mas"). */
/* Ficha V2 a pantalla COMPLETA (pedido de Sebastián: "abajo y los costados no lo son").
   Scoped a #lead-modal2. fixed+inset 0 con width 100% (no 100vw,
   que sumaría el ancho del scrollbar y daría scroll horizontal). */
#lead-modal2{padding:0;overflow:hidden}
/* padding:0 es CLAVE: .lead-card-wide trae padding interno (16px 26px + safe-area en móvil) que
   dejaba aire arriba del header sticky y a los costados — el fullscreen es del header a los bordes */
#lead-modal2 .lead-card{position:fixed;inset:0;width:100%;height:100vh;height:100dvh;max-width:none;max-height:none;border-radius:0!important;margin:0;padding:0}
#lead-modal2 .close{z-index:8} /* por encima del header sticky (z-index 6) */
/* Empresa V3 (co3): usa la MISMA gramática que la ficha de persona clásica (lm-top/lm-grid/
   ab-sec/lm-block) — cero estilos propios salvo el avatar cuadrado-redondeado (empresa ≠ persona) */
#co3-modal .lm-avatar{border-radius:12px}
.lm2-card{display:flex;flex-direction:column;height:100%;max-height:none;overflow:hidden}
.lm2-hd{position:sticky;top:0;z-index:6;display:flex;align-items:center;gap:12px;padding:14px 20px;border-bottom:1px solid var(--line);background:var(--navy-800);flex-wrap:wrap}
.lm2-avatar{width:42px;height:42px;border-radius:50%;background:var(--acid);color:#142033;display:grid;place-items:center;font-weight:800;font-family:'Space Grotesk';font-size:15px;flex:none}
.lm2-who{min-width:0}
.lm2-who .nm{font-family:'Space Grotesk';font-weight:700;font-size:16.5px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.lm2-who .sub{font-size:12px;color:var(--muted)}
.lm2-webbadge{margin-top:3px;font-size:11.5px;font-weight:600;color:var(--acid)}
.lm2-back{border:1px solid var(--line-strong);background:transparent;color:var(--muted);border-radius:100px;font:600 12px Inter,sans-serif;padding:7px 13px;cursor:pointer;white-space:nowrap}
.lm2-back:hover{color:var(--text);border-color:var(--muted)}
.lm2-nav{display:flex;align-items:center;border:1px solid var(--line-strong);border-radius:100px;overflow:hidden}
.lm2-nav button{width:30px;height:30px;border:0;background:transparent;color:var(--muted);cursor:pointer;font-size:15px;line-height:1}
.lm2-nav button:hover:not(:disabled){color:var(--text);background:rgba(255,255,255,.05)}
.lm2-nav button:disabled{opacity:.3;cursor:default}
.lm2-nav .lm2-nav-n{font-size:10.5px;color:var(--muted-2);padding:0 6px;font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap}
.lm2-pipe{display:flex;border:1px solid var(--line-strong);border-radius:100px;overflow:hidden;font-size:10.5px;font-weight:700}
.lm2-pipe span{padding:6px 11px;color:var(--muted-2);cursor:pointer;white-space:nowrap}
.lm2-pipe span.done{color:#142033;background:var(--acid)}
.lm2-pipe span.cur{color:var(--acid);background:rgba(221,249,143,.13)}
.lm2-pipe span:hover:not(.done):not(.cur){color:var(--text)}
.lm2-lost{font-size:10.5px;font-weight:700;color:#ff6b6b;border:1px solid #ff6b6b;border-radius:100px;padding:6px 11px}
.lm2-actions{margin-left:auto;display:flex;gap:8px;align-items:center;position:relative}
.lm2-menu{position:absolute;right:0;top:40px;z-index:9;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:12px;padding:6px;width:230px;box-shadow:0 18px 50px -12px rgba(0,0,0,.8);font-size:12.5px}
.lm2-menu button{display:block;width:100%;text-align:left;background:transparent;border:0;color:var(--text);font:inherit;padding:8px 10px;border-radius:8px;cursor:pointer}
.lm2-menu button:hover{background:rgba(255,255,255,.06)}
.lm2-menu button.danger{color:#ff8b8b}
.lm2-menu hr{border:none;border-top:1px solid var(--line);margin:4px 0}
.lm2-grid{display:grid;grid-template-columns:240px 1fr 280px;gap:0;overflow-y:auto;flex:1}
.lm2-l{border-right:1px solid var(--line);padding:16px}
.lm2-c{padding:16px 20px;background:rgba(0,0,0,.12);min-width:0}
.lm2-r{border-left:1px solid var(--line);padding:16px}
.lm2-sech{font-size:10px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted-2);font-weight:700;margin:0 0 10px}
.lm2-kv{display:grid;gap:9px;font-size:12.5px}
.lm2-kv .k{color:var(--muted-2);font-size:10px;text-transform:uppercase;letter-spacing:.06em}
.lm2-kv .v{font-weight:600;word-break:break-word}
.lm2-kv .v a{color:var(--acid);text-decoration:none}
.lm2-edit{cursor:pointer;border-radius:6px;margin:-2px -5px;padding:2px 5px}
.lm2-edit:hover{background:rgba(255,255,255,.05);outline:1px dashed var(--line-strong)}
.lm2-morefields{margin-top:12px;font-size:11.5px;color:var(--muted)}
.lm2-morefields summary{cursor:pointer;text-decoration:underline dotted}
.lm2-morefields .lm2-kv{margin-top:10px}
/* borrador(es) pendiente(s) de aprobar para ESTE contacto — visible en la ficha
   misma (pedido explícito de Sebastián: "poné los emails a aprobar en el
   contacto mismo, así todos vemos que se les envía"), no solo en la Bandeja. */
.lm2-ob-card{border:1px solid color-mix(in srgb,var(--acid) 45%,var(--line-strong));border-left:3px solid var(--acid);border-radius:13px;background:var(--navy-800);margin-bottom:14px;padding:14px 16px}
.lm2-ob-card+.lm2-ob-card{margin-top:-4px}
.lm2-ob-hd{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px}
.lm2-ob-hd b{font-size:13px}
.lm2-ob-subj{font-size:14px;font-weight:600;color:var(--text);margin-bottom:4px}
.lm2-ob-body{font-size:13px;color:var(--muted);line-height:1.5;white-space:pre-wrap;max-height:110px;overflow:hidden;margin-bottom:10px}
.lm2-ob-btns{display:flex;gap:8px;flex-wrap:wrap}
#ob-list .au-step.ob-focus{outline:2px solid var(--acid);outline-offset:3px;transition:outline-color .3s}
.lm2-composer{border:1px solid var(--line-strong);border-radius:13px;background:var(--navy-800);margin-bottom:16px;overflow:hidden}
.lm2-ctabs{display:flex;border-bottom:1px solid var(--line);font-size:12px;font-weight:700}
.lm2-ctabs button{background:transparent;border:0;color:var(--muted);font:inherit;font-weight:700;padding:9px 14px;cursor:pointer}
.lm2-ctabs button.on{color:var(--acid);box-shadow:inset 0 -2px var(--acid)}
.lm2-cbody{padding:10px 12px}
.lm2-cbody textarea{width:100%;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:10px;color:var(--text);font:13px/1.5 Inter,sans-serif;padding:9px 11px;min-height:64px;resize:vertical}
.lm2-cbody input,.lm2-cbody select{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:8px;color:var(--text);font:12.5px Inter,sans-serif;padding:7px 9px}
.lm2-crow{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;align-items:center}
.lm2-crow .sp{flex:1}
.lm2-chips{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}
.lm2-chips button{background:transparent;border:1px solid var(--line-strong);border-radius:100px;color:var(--muted);font:600 11px Inter,sans-serif;padding:5px 11px;cursor:pointer}
.lm2-chips button.on{border-color:var(--acid);color:var(--acid);background:rgba(221,249,143,.08)}
.lm2-tl{position:relative;padding-left:18px}
.lm2-tl::before{content:"";position:absolute;left:4px;top:6px;bottom:6px;width:1.5px;background:var(--line-strong)}
.lm2-ev{position:relative;padding:0 0 14px 10px}
.lm2-ev::before{content:"";position:absolute;left:-18px;top:5px;width:10px;height:10px;border-radius:50%;background:var(--navy-800);border:2px solid var(--muted-2)}
.lm2-ev.hot::before{border-color:var(--acid);background:var(--acid)}
.lm2-ev .when{font-size:10px;color:var(--muted-2);text-transform:uppercase;letter-spacing:.05em}
.lm2-ev .card{margin-top:4px;border:1px solid var(--line);border-radius:11px;background:var(--navy-800);padding:9px 12px;font-size:12.5px;word-break:break-word}
.lm2-ev .card .meta{color:var(--muted);font-size:11.5px;margin-top:3px}
.lm2-ev .card details summary{cursor:pointer;color:var(--muted);font-size:11.5px;margin-top:4px}
.lm2-ev .card details div{margin-top:6px;white-space:pre-wrap;color:var(--text);font-size:12.5px}
.lm2-chip{display:inline-block;font-size:9.5px;font-weight:700;border-radius:20px;padding:1px 7px;margin-right:6px;vertical-align:1px}
.lm2-chip.email{background:rgba(138,180,255,.15);color:#8ab4ff}
.lm2-chip.nota{background:rgba(240,192,96,.15);color:#f0c060}
.lm2-chip.brief{background:rgba(221,249,143,.14);color:var(--acid)}
.lm2-chip.sys{background:rgba(255,255,255,.08);color:var(--muted)}
.lm2-chip.task{background:rgba(126,217,87,.15);color:#7ed957}
.lm2-chip.web{background:rgba(94,199,209,.15);color:#5ec7d1}
/* hilos de notas estilo chat: raíz arriba, respuestas con sangría y borde (feedback: el quoteo anidado era ilegible) */
.lm2-msg{margin-top:7px}
.lm2-msg .a{font-size:11px;font-weight:700}
.lm2-msg .a .w{color:var(--muted-2);font-weight:400;font-size:10px}
.lm2-msg .b{font-size:12.5px;white-space:pre-wrap;word-break:break-word;margin-top:1px}
.lm2-msg.rep{border-left:2px solid var(--line-strong);padding-left:9px;margin-left:4px;margin-top:9px}
.lm2-next{border:1px solid rgba(221,249,143,.4);border-radius:12px;background:rgba(221,249,143,.07);padding:11px 13px;margin-bottom:12px}
.lm2-next .t{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--acid);font-weight:700}
.lm2-next .v{font-size:12.5px;font-weight:600;margin-top:4px}
.lm2-next .v small{display:block;color:var(--muted);font-weight:400;font-size:11px;margin-top:2px}
.lm2-as{border:1px solid var(--line);border-radius:12px;background:var(--navy-800);margin-bottom:11px;overflow:hidden}
.lm2-as .top{display:flex;align-items:center;gap:7px;padding:10px 13px;font-weight:700;font-size:12.5px}
.lm2-as .top .n{margin-left:auto;font-size:10.5px;color:var(--muted);font-weight:600}
.lm2-as .row{border-top:1px solid var(--line);padding:9px 13px;font-size:12px;display:flex;align-items:center;gap:7px;cursor:pointer;background:transparent;width:100%;border-left:0;border-right:0;border-bottom:0;color:var(--text);font-family:inherit;text-align:left}
.lm2-as .row:hover{background:rgba(255,255,255,.03)}
.lm2-as .row .amt{margin-left:auto;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
.lm2-as .row .stb{font-size:9.5px;font-weight:700;border:1px solid;border-radius:20px;padding:1px 6px;white-space:nowrap}
.lm2-as .add{border-top:1px solid var(--line);padding:8px 13px;font-size:11.5px;color:var(--acid);cursor:pointer;font-weight:600;background:transparent;border-left:0;border-right:0;border-bottom:0;width:100%;text-align:left;font-family:inherit}
.lm2-as .row select{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:7px;color:var(--text);font:600 10.5px Inter,sans-serif;padding:3px 5px;max-width:110px}
@media(max-width:960px){
  .lm2-grid{display:flex;flex-direction:column}
  .lm2-l{order:3;border:none;border-top:1px solid var(--line)}
  .lm2-c{order:1}
  .lm2-r{order:2;border:none;border-top:1px solid var(--line)}
  .lm2-pipe span{padding:6px 8px}
  /* móvil menos crowded (feedback de Sebastián): header comprimido, chips y pipeline en una sola
     fila scrolleable, timeline más densa, y el botón Crear pierde el texto (queda ➕ ▾) */
  /* sin el padding del card, el header sticky toca el borde: que respete el notch él mismo */
  .lm2-hd{padding:calc(10px + env(safe-area-inset-top)) 12px 10px;gap:8px}
  .lm2-avatar{width:36px;height:36px;font-size:13px}
  .lm2-who .nm{font-size:15px}
  .lm2-who .sub{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:calc(100vw - 120px)}
  .lm2-actions .btn{padding:7px 10px}
  #lm2-crear .lbl{display:none}
  .lm2-chips{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:2px}
  .lm2-chips::-webkit-scrollbar{display:none}
  .lm2-chips button{padding:5px 10px;flex:none}
  .lm2-pipe{overflow-x:auto;max-width:100%;flex-wrap:nowrap;scrollbar-width:none}
  .lm2-pipe::-webkit-scrollbar{display:none}
  .lm2-ev{padding-bottom:11px}
  .lm2-ev .card{padding:8px 10px}
  .lm2-ev .when{font-size:9.5px}
  .lm2-l-fold>summary{display:block}
}
/* rail izquierdo plegable en móvil: en desktop el summary se oculta y el details queda abierto */
.lm2-l-fold>summary{display:none;cursor:pointer;font-size:12.5px;font-weight:700;padding:4px 0;list-style:none}
.lm2-l-fold>summary::-webkit-details-marker{display:none}
/* ---- popup de follow-up ---- */
.fu-modal{position:fixed;inset:0;z-index:300;display:grid;place-items:center;padding:18px}
.fu-modal[hidden]{display:none}
.fu-back{position:absolute;inset:0;background:rgba(7,12,20,.66);backdrop-filter:blur(2px)}
.fu-card{position:relative;width:min(620px,100%);max-height:90vh;overflow:auto;background:var(--navy-800);
  border:1px solid var(--line-strong);border-radius:16px;padding:20px 22px;box-shadow:0 30px 70px -20px rgba(0,0,0,.7)}
.fu-hd{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;padding-bottom:13px;border-bottom:1px solid var(--line);margin-bottom:14px}
.fu-hd b{display:block;font:700 17px/1.25 'Space Grotesk',sans-serif}
.fu-hd span{color:var(--muted);font-size:13px}
.fu-x{background:none;border:0;color:var(--muted-2);font-size:24px;line-height:1;cursor:pointer;padding:0 2px}
.fu-x:hover{color:var(--text)}
.fu-ctx{display:grid;gap:8px;margin-bottom:14px}
/* lo que escribió el cliente: se lee como una cita, no como un dato más de la lista */
.fu-ctx .fu-dijo{display:flex;gap:9px;align-items:flex-start;background:var(--navy-900);border:1px solid var(--line);
  border-radius:12px;padding:11px 13px}
.fu-ctx .fu-dijo > i{font-style:normal;flex:none;opacity:.8}
.fu-ctx .fu-dijo > div{min-width:0}
.fu-ctx .fu-dijo b{display:block;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted-2);margin-bottom:5px}
.fu-ctx .fu-dijo .fu-asunto{text-transform:none;letter-spacing:0;color:var(--muted)}
.fu-ctx .fu-dijo blockquote{margin:0;font-size:13.5px;line-height:1.55;color:var(--text);
  border-left:2px solid color-mix(in srgb,var(--acid) 45%,transparent);padding-left:10px}
.fu-ctx div{display:flex;gap:9px;font-size:13px;color:var(--muted);align-items:baseline}
.fu-ctx i{font-style:normal;flex:none;width:15px;text-align:center}
.fu-ctx b{color:var(--text);font-weight:600}
.fu-mail input,.fu-mail textarea{width:100%;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:11px;
  color:var(--text);font-family:inherit;font-size:14px;padding:11px 13px}
.fu-mail input{margin-bottom:8px;font-weight:600}
.fu-mail textarea{resize:vertical;line-height:1.6}
.fu-bar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:12px}
.fu-bar #fu-hint{flex:1;min-width:180px;background:var(--navy-900);border:1px solid var(--line);border-radius:100px;
  color:var(--text);font-family:inherit;font-size:12.5px;padding:8px 13px}
.fu-de{font-size:12px;color:var(--muted-2);display:flex;align-items:center;gap:5px}
.fu-de select{background:var(--navy-900);border:1px solid var(--line);border-radius:8px;color:var(--text);font-family:inherit;font-size:12.5px;padding:6px 8px}
.fu-note{margin-top:10px;font-size:12px}
@media(max-width:620px){.fu-card{padding:16px 15px;max-height:94vh}}
/* 🧹 Limpiar: cada fila muestra por qué dudo (rojo) y qué rastro dejó (verde). La
   decisión es de Sebastián, así que la evidencia tiene que estar a la vista, no el veredicto. */
.limp-sec{display:flex;align-items:center;gap:8px;font-size:10.5px;letter-spacing:.09em;
  text-transform:uppercase;color:var(--muted);margin:18px 0 8px}
.limp-sec span{color:var(--text);font-weight:700}
.limp-mini{background:none;border:1px solid var(--line-strong);border-radius:99px;color:var(--muted);
  font:600 10.5px Inter,sans-serif;letter-spacing:.04em;padding:3px 9px;cursor:pointer;text-transform:none}
.limp-mini:hover{color:var(--text);border-color:var(--text)}
.limp-sec .limp-mini:first-of-type{margin-left:auto}
.limp-row{display:flex;gap:11px;align-items:flex-start;padding:9px 11px;border-radius:10px;
  border:1px solid transparent;cursor:pointer}
.limp-row:hover{background:var(--panel-2)}
.limp-row.on{background:#ff6b6b12;border-color:#ff6b6b55}
.limp-row input{margin-top:3px;flex:0 0 auto}
.limp-txt{min-width:0;flex:1}
.limp-t{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;font-size:13.5px}
.limp-co{color:var(--muted);font-size:12px}
.limp-st{margin-left:auto;font-size:11px;white-space:nowrap}
.limp-mal{color:#ff8b8b;font-size:11.5px;margin-top:2px;line-height:1.4}
.limp-bien{color:#7ed957;font-size:11.5px;margin-top:2px;line-height:1.4}
.limp-bien.vacio{color:var(--muted-2)}
/* Mientras el modal de bexio recalcula contra la API: la selección ya cambió (respuesta
   inmediata) pero los números todavía son los viejos, así que se atenúan en vez de
   mentir. El botón elegido se mantiene nítido para que se vea que el click entró. */
#bx-modal.calculando .bx-pcts button small,
#bx-modal.calculando .fu-ctx{opacity:.45;transition:opacity .12s}
#bx-modal.calculando .bx-pcts button.on{opacity:1}
/* composer colapsado en móvil: una sola barra finita hasta que lo tocás */
.lm2-cbar{display:block;width:100%;text-align:left;background:transparent;border:0;color:var(--muted);font:600 12.5px Inter,sans-serif;padding:12px 14px;cursor:pointer}
</style>
<!-- POPUP DE FOLLOW-UP — se abre desde Hoy, encima de la pantalla. NO es la ficha:
     la ficha es de tres columnas y tarda; acá se trata de mandar y seguir. Reusa las
     mismas piezas probadas (ai-email-draft para escribir, send-outreach para mandar). -->
<div class="fu-modal" id="fu-modal" hidden role="dialog" aria-modal="true" aria-label="Follow-up">
  <div class="fu-back" data-fu-close></div>
  <div class="fu-card">
    <div class="fu-hd">
      <div><b id="fu-quien">—</b><span id="fu-donde"></span></div>
      <button class="fu-x" type="button" data-fu-close aria-label="Cerrar">&times;</button>
    </div>
    <div class="fu-ctx" id="fu-ctx"></div>
    <div class="fu-mail">
      <input id="fu-subj" placeholder="Asunto" />
      <textarea id="fu-body" rows="9" placeholder="Escribiendo el borrador…"></textarea>
    </div>
    <div class="fu-bar">
      <button class="btn btn-primary small" id="fu-send" type="button">📨 Enviar</button>
      <button class="btn btn-ghost small" id="fu-redo" type="button">↻ Reescribir</button>
      <input id="fu-hint" placeholder="¿de qué debería hablar? (opcional)" />
      <label class="fu-de">De: <select id="fu-de"></select></label>
    </div>
    <p class="muted-note fu-note" id="fu-note">La IA lo escribe leyendo la conversación real. Nada sale hasta que toques Enviar.</p>
  </div>
</div>

<!-- 🧭 Playbook: vive en un modal y se abre a pedido. Estaba siempre desplegado
     arriba de la timeline y no hace falta: se usa cuando estás por llamar, no cada
     vez que abrís una ficha. (Sebastián, 26 ago 2026: "tiene que estar como botón a
     un costado y recién ahí abrir al tocarlo, no hace falta siempre".) -->
<div class="fu-modal" id="pb-modal" hidden role="dialog" aria-modal="true" aria-label="Playbook">
  <div class="fu-back" id="pb-back"></div>
  <div class="fu-card" style="width:min(720px,100%)">
    <div class="fu-hd">
      <div><b id="pb-quien">🧭 Playbook</b><span>Las preguntas de la llamada — las respuestas quedan para siempre</span></div>
      <button class="fu-x" id="pb-x" type="button" aria-label="Cerrar">✕</button>
    </div>
    <div id="lm2-pb"></div>
  </div>
</div>

<!-- Iba con class="fu-back", que es la clase del FONDO oscuro (position:absolute
     dentro del panel de ofertas). Sin el envoltorio .fu-modal —fixed y centrado—
     la tarjeta se dibujaba en el tope del panel, fuera de la pantalla y cortada.
     (Sebastián, 26 ago 2026: "arriba del todo y cortado, tiene que estar centrado
     para verlo bien o no sirve".) Y el header usaba .fu-head, que no existe en el
     CSS: la clase es .fu-hd. -->
<div class="fu-modal" id="bx-modal" hidden role="dialog" aria-modal="true" aria-label="Crear factura en bexio">
  <div class="fu-back" id="bx-back"></div>
  <div class="fu-card">
    <div class="fu-hd">
      <div><b id="bx-quien">—</b><span id="bx-donde"></span></div>
      <button class="fu-x" id="bx-x" type="button" aria-label="Cerrar">✕</button>
    </div>
    <div class="fu-ctx" id="bx-ctx"></div>
    <div class="bx-pcts" id="bx-pcts"></div>
    <div id="bx-cands"></div>
    <div class="fu-actions">
      <button class="btn btn-primary" id="bx-go" type="button">🧾 Crear borrador en bexio</button>
      <span class="muted-note" id="bx-note">Se crea como borrador. La factura la mandás vos desde bexio.</span>
    </div>
  </div>
</div>

<!-- 📤 Notas al editor. Adentro del dashboard y no en un window.open: el popup salía en
     blanco —con noopener la referencia a la ventana viene nula— y además ahí no se podía
     tocar nada. Acá se ve lo que va a salir, se edita, y el .xml está a la vista.
     (Sebastián, 26 ago 2026: "que salga directo desde el dashboard con un popup propio
     donde me muestre qué se le envía y le pueda hacer cambios, agregar cosas, etc.") -->
<!-- 📤 El plan de rodaje al equipo. Mismo patrón que el email al editor: se ve el email
     exacto que sale —lo arma el servidor, con el mismo código que manda— se puede agregar
     un mensaje, y recién ahí se manda. Nada sale sin que se toque el botón.
     (Sebastián, 26 ago 2026: "falta todo lo de poder mandar como PDF, etc.") -->
<div class="fu-modal" id="plm-modal" hidden role="dialog" aria-modal="true" aria-label="Mandar el plan de rodaje">
  <div class="fu-back" id="plm-back"></div>
  <div class="fu-card" style="width:min(860px,100%)">
    <div class="fu-hd">
      <div><b>📤 El plan al equipo</b><span id="plm-sub"></span></div>
      <button class="fu-x" id="plm-x" type="button" aria-label="Cerrar">✕</button>
    </div>
    <div class="ned-grid">
      <label>De<select class="ed-inp" id="plm-de"></select></label>
      <label>Asunto<input class="ed-inp" id="plm-asunto" type="text" /></label>
    </div>
    <div id="plm-para"></div>
    <div class="plm-tabs">
      <button type="button" class="on" data-plmv="equipo">👥 Lo que ve el equipo</button>
      <button type="button" data-plmv="cliente">🤝 Lo que ve el cliente</button>
    </div>
    <label class="ned-lbl">Algo que quieras agregarle <em>— va arriba del cronograma</em>
      <textarea class="ed-inp" id="plm-msg" rows="2" placeholder="Opcional. P. ej.: «la entrada es por atrás, el portón de la izquierda»."></textarea></label>
    <div class="ned-prev" id="plm-prev"></div>
    <div class="fu-actions">
      <button class="btn btn-primary" id="plm-go" type="button">📤 Mandar</button>
      <span class="muted-note" id="plm-msgout">Nada sale hasta que toques Mandar.</span>
    </div>
  </div>
</div>

<script type="application/json" id="brief-json" set:html={JSON.stringify({ BRIEF, BRIEF_SECCIONES, BRIEF_T })}></script>

<div class="fu-modal" id="ned-modal" hidden role="dialog" aria-modal="true" aria-label="Notas al editor">
  <div class="fu-back" id="ned-back"></div>
  <div class="fu-card" style="width:min(820px,100%)">
    <div class="fu-hd">
      <div><b>📤 Notas al editor</b><span id="ned-sub"></span></div>
      <button class="fu-x" id="ned-x" type="button" aria-label="Cerrar">✕</button>
    </div>
    <div class="ned-grid">
      <label>Para<input class="ed-inp" id="ned-to" type="email" /></label>
      <!-- De quién sale. No es cosmético: el montajista contesta a este email, y una
           respuesta que cae en la casilla equivocada se pierde el día que hace falta.
           (Sebastián, 26 ago 2026: "nota al editor, ¿de quién se envía? Poné para escoger
           la persona.") -->
      <label>De<select class="ed-inp" id="ned-de"></select></label>
      <label style="grid-column:1/-1">Asunto<input class="ed-inp" id="ned-asunto" type="text" /></label>
    </div>
    <label class="ned-lbl">Algo que quieras agregarle <em>— va arriba de las notas</em>
      <textarea class="ed-inp" id="ned-msg" rows="3" placeholder="Opcional. P. ej.: «la v3 va el viernes, priorizá las notas de audio»."></textarea></label>
    <div class="ned-prev" id="ned-prev"></div>
    <details class="ned-xml"><summary>📎 Lo que va adjunto</summary><div id="ned-adj"></div></details>
    <div class="fu-actions">
      <button class="btn btn-primary" id="ned-go" type="button">📤 Enviar</button>
      <span class="muted-note" id="ned-msgout">Nada sale hasta que toques Enviar.</span>
    </div>
  </div>
</div>

<!-- 📋 Project Brief. Antes se abría con window.open(..., 'noopener'), que devuelve null:
     salía un popup en blanco. Y además hacía falta poder llenarlo desde acá — muchas veces
     las respuestas llegan por teléfono o en la llamada, no por el formulario.
     (Sebastián, 26 ago 2026: "tocar el project brief abre un popup vacío" / "tengo que
     poder tenerlo dentro del panel y llenarlo ahí".) -->
<!-- Ojo con los ids: el modal del Playbook ya usaba pb-modal / pb-x / pb-back. Dos
     elementos con el mismo id hacen que getElementById devuelva el PRIMERO, así que
     "Abrir el brief" abría el Playbook vacío. Todo lo de acá lleva prefijo `pbf-`.
     (Sebastián, 26 ago 2026: "mandar playbook y solo veo eso sin preview ni nada".) -->
<div class="fu-modal" id="pbf-modal" hidden role="dialog" aria-modal="true" aria-label="Project Brief">
  <div class="fu-back" id="pbf-back"></div>
  <div class="fu-card" style="width:min(900px,100%)">
    <div class="fu-hd">
      <div><b>📋 Project Brief</b><span id="pbf-sub"></span></div>
      <button class="fu-x" id="pbf-x" type="button" aria-label="Cerrar">✕</button>
    </div>
    <div class="pb-tabs">
      <button type="button" class="on" data-pbt="llenar">✍️ Llenarlo acá</button>
      <button type="button" data-pbt="mandar">📤 Mandárselo al cliente</button>
    </div>
    <div id="pbf-llenar" class="pb-pane"></div>
    <div id="pbf-mandar" class="pb-pane" hidden></div>
  </div>
</div>

<!-- IMPORTAR CONTACTOS DE TÉCNICOS
     Ninguno de los siete tenía email ni teléfono, así que el plan de rodaje salía "sin
     teléfono" para todos y no se les podía mandar nada. Dos caminos, porque los datos
     están en dos sitios: algunos ya son contactos del CRM (Martin y Pascal lo estaban),
