  /* Escribir guiones con IA */
  .pj-gia{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:0 0 14px}
  .pj-gia label{display:flex;flex-direction:column;gap:3px;font-size:10px;letter-spacing:.09em;
    text-transform:uppercase;color:var(--muted-2);font-weight:700}
  .pj-gia select{min-width:172px;padding:7px 9px}
  .pj-gia input{flex:1;min-width:230px}
  .pj-g3{display:grid;grid-template-columns:repeat(auto-fit,minmax(268px,1fr));gap:12px;margin:0 0 14px}
  .pj-g{border:1px solid var(--line);border-radius:13px;padding:14px 15px;background:rgba(255,255,255,.015);
    display:flex;flex-direction:column;gap:8px}
  .pj-g.elegido{border-color:var(--acid);background:rgba(190,242,100,.05)}
  .pj-g .ang{font-weight:700;font-size:14px;line-height:1.3}
  .pj-g .pre{font-size:12.5px;color:var(--muted);line-height:1.5;margin:0}
  .pj-g .met{font-size:11px;color:var(--muted-2);letter-spacing:.03em}
  .pj-g .acc{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto;padding-top:6px}
  .pj-gtxt{max-height:270px;overflow:auto;border-top:1px solid var(--line);padding-top:9px;margin-top:2px}
  .pj-gtxt table{width:100%;border-collapse:collapse;font-size:12px}
  .pj-gtxt td{vertical-align:top;padding:5px 7px 5px 0;border-bottom:1px solid var(--line);line-height:1.45}
  .pj-gtxt td.tc{white-space:nowrap;color:var(--muted-2);font-variant-numeric:tabular-nums;width:1%}
  .pj-gtxt td.au{color:var(--muted)}
  .pj-gtxt .enc{font-weight:700;letter-spacing:.04em;font-size:11.5px}
  .pj-gtxt .dlg{white-space:pre-wrap;color:var(--muted);padding-left:14px}
  @media(max-width:820px){ .pj-gia input{min-width:100%} .pj-gia select{min-width:100%} .pj-gia label{width:100%} }
  .pj-sec-h{font-size:10px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted-2);font-weight:700;margin:20px 0 9px}
  .pj-chipn{display:inline-block;background:var(--navy-900);border:1px solid var(--line);border-radius:999px;
    padding:3px 10px;font-size:12px;color:var(--text);margin:0 5px 5px 0}
  .pj-nec{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
  .pj-nec .k{display:block;font-size:11px;color:var(--muted-2);margin-bottom:6px}
  /* Los avisos van arriba y en color: son lo único del desglose que cambia una decisión
     hoy. El de "no está presupuestado" es plata que se escapa, así que va aparte. */
  .pj-avisos{border:1px solid var(--line);border-left:3px solid #f0c060;border-radius:12px;
    background:var(--navy-900);padding:12px 15px;margin:14px 0 0}
  .pj-avisos.plata{border-left-color:#ff8b8b}
  .pj-avisos b{display:block;font-size:12.5px;margin-bottom:6px;color:var(--text)}
  .pj-avisos ul{margin:0;padding-left:18px}
  .pj-avisos li{font-size:13px;color:var(--muted);margin-bottom:4px}
  .pj-jor{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}
  .pj-jor-d{background:var(--navy-900);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
  .pj-jor-d b{font-size:13.5px}
  .pj-jor-d .loc{font-size:12.5px;color:var(--acid);margin-top:3px}
  .pj-jor-d .esc{font-size:12px;color:var(--muted);margin-top:4px}
  .pj-jor-d .notas{font-size:11.5px;color:var(--muted-2);margin-top:6px;line-height:1.45}
  .pj-esc{border:1px solid var(--line);border-radius:12px;background:var(--navy-900);padding:11px 14px;margin-bottom:7px}
  .pj-esc > summary{cursor:pointer;list-style:none;display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;font-size:13.5px}
  .pj-esc > summary::-webkit-details-marker{display:none}
  .pj-esc > summary::after{content:'▸';margin-left:auto;color:var(--muted-2)}
  .pj-esc[open] > summary::after{transform:rotate(90deg)}
  .pj-esc > summary em{font-style:normal;font-size:11.5px;color:var(--muted-2)}
  .pj-esc-kv{display:flex;gap:10px;align-items:baseline;margin-top:7px;flex-wrap:wrap}
  .pj-esc-kv > span{flex:none;width:130px;font-size:11px;color:var(--muted-2)}
  @media(max-width:560px){.pj-esc-kv > span{width:auto}}

  /* ---- facturas del crew ---- */
  .pj-com{border:1px solid var(--line);border-radius:12px;background:var(--navy-900);padding:11px 14px;margin-bottom:7px}
  .pj-com.hecho{opacity:.55}
  .pj-com .hd{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;font-size:11.5px;color:var(--muted-2)}
  .pj-com .hd b{color:var(--text);font-size:13px}
  .pj-com .hd .t{background:var(--navy-800);border-radius:6px;padding:1px 7px;color:#f0c060;font-weight:700;font-variant-numeric:tabular-nums}
  .pj-com .hd .est{margin-left:auto}
  .pj-com p{margin:6px 0 0;font-size:13.5px;color:var(--muted);line-height:1.55;white-space:pre-wrap}
  .pj-com-acc{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}
  .pj-bill{border:1px solid var(--line);border-radius:12px;background:var(--navy-900);padding:11px 14px;margin-bottom:8px}
  .pj-bill-hd{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
  .pj-bill-hd b{font-size:14px}
  .pj-bill-est{font-size:11px;font-weight:700}
  .pj-bill-chf{margin-left:auto;font-size:15px;font-weight:700;font-variant-numeric:tabular-nums}
  .pj-bill-sub{font-size:12px;color:var(--muted);margin-top:3px}
  .pj-bill-duda{font-size:12px;color:#f0c060;margin-top:6px;line-height:1.45}
  .pj-bill-acc{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px;align-items:center}
  /* 🧪 LO DE PRUEBA, DICHO EN LA FILA. Los proyectos 1202/1203 son inventados y en pantalla
     nada lo decía: metían CHF 18.036 en «En producción» y una alerta roja en Hoy por un rodaje
     que no existe. Violeta a propósito — verde, rojo y ámbar ya significan un estado del
     negocio, y «esto es de mentira» no es un estado del negocio sino una etiqueta sobre el dato.
     (Sebastián, 28 ago 2026: "un chip para las pruebas alcanza".) */
  /* La versión: discreta pero siempre visible, también en el teléfono —donde .dash-sub se
     esconde—, porque es justo ahí donde hace falta comparar la pantalla de uno con la del
     otro. Tabular para que dos números se comparen de un vistazo. */
  .dash-ver{color:var(--muted-2);font-size:11px;font-variant-numeric:tabular-nums;letter-spacing:.04em;margin-top:2px;cursor:default}
  /* Los escalones del embudo se pueden tocar para ver quiénes son. La lupa aparece al
     pasar por encima: en reposo el embudo se lee como un gráfico, no como un menú. */
  .fn-row.fn-tocable{cursor:pointer;border-radius:10px;transition:background .12s}
  .fn-row.fn-tocable:hover,.fn-row.fn-tocable:focus-visible{background:var(--panel-2);outline:none}
  .fn-row.fn-tocable:focus-visible{box-shadow:0 0 0 2px var(--acid)}
  .fn-lupa{opacity:0;font-size:10px;transition:opacity .12s}
  .fn-row.fn-tocable:hover .fn-lupa,.fn-row.fn-tocable:focus-visible .fn-lupa{opacity:.8}
  .fng{border:1px solid var(--line);border-radius:12px;background:var(--panel);margin-top:12px;overflow:hidden}
  .fng-h{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px;
    border-bottom:1px solid var(--line);font-weight:700;font-size:13px}
  .fng-row{display:grid;grid-template-columns:1.2fr 1.4fr auto auto;gap:12px;align-items:center;width:100%;
    background:none;border:0;border-bottom:1px solid var(--line);color:inherit;font:inherit;text-align:left;
    padding:9px 14px;cursor:pointer}
  .fng-row:last-child{border-bottom:0}
  .fng-row:hover{background:var(--panel-2)}
  .fng-n{font-weight:600;font-size:13.5px}
  .fng-c,.fng-d{color:var(--muted);font-size:12.5px}
  .fng-s{font-size:11.5px;font-weight:700;white-space:nowrap}
  .fng-d{font-variant-numeric:tabular-nums;white-space:nowrap}
  @media(max-width:560px){
    /* En el teléfono, la empresa y la fecha pasan a un segundo renglón antes que apretarse */
    .fng-row{grid-template-columns:1fr auto;row-gap:2px}
    .fng-c{grid-column:1/-1;order:3}
  }
  /* Una fila por persona en la pestaña Citación: nombre, rol, contacto y su hora, editable
     ahí mismo. (El bloque anterior de estilos propios para las pestañas se borró a
     propósito: usan .co-seg, el control segmentado que ya se usa en Analytics, Ofertas y
     Sistema. Un control nuevo que se parece pero no es igual se nota, y era exactamente lo
     que Sebastián vio: «el diseño no pega con nada».) */
  /* Columnas FIJAS, no `auto`: con auto, cada fila las acomodaba a su contenido y el
     teléfono de uno no quedaba debajo del teléfono del otro. Una lista donde las columnas
     bailan se lee peor que una tabla, que es lo que esto es. */
  .pj-cita-row{display:grid;
    grid-template-columns:minmax(110px,1.4fr) minmax(80px,1fr) 150px minmax(150px,1.6fr) repeat(var(--cita-dias,1),115px);
    gap:14px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line);font-size:13px}
  /* El encabezado con el nombre de cada jornada y su citación general. Solo aparece con
     más de un día: con uno solo, una fila de títulos para una sola columna es ruido. */
  .pj-cita-cab{border-bottom-color:var(--line-strong);padding-bottom:5px}
  .pj-cita-cab .jh{color:var(--muted-2);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;text-align:center}
  .pj-cita-cab .jh em{display:block;font-style:normal;font-variant-numeric:tabular-nums;
    letter-spacing:0;text-transform:none;font-size:11.5px;color:var(--muted)}
  /* «No viene» se ve distinto de «llega a la general»: apagado, no verde. */
  .pj-cita-h.fuera{color:var(--muted-2);border-style:dashed;font-style:italic}
  .pj-cita-row .n{font-weight:600;color:var(--text)}
  .pj-cita-row .r{color:var(--muted-2);font-size:11.5px}
  .pj-cita-row .t{font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--muted);
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pj-cita-row .t.no{color:var(--warn);font-family:inherit;font-style:italic;font-size:11.5px}
  .pj-cita-h{width:100%;text-align:center}
  /* En verde el que tiene hora propia: se ve de un golpe quién no llega con el resto */
  .pj-cita-h.propia{border-color:var(--acid);color:var(--acid);font-weight:700}
  #pj-plan-tabs span{color:var(--muted-2);font-weight:500}
  @media(max-width:700px){
    /* En el teléfono el contacto pasa abajo antes que apretarse contra la hora */
    .pj-cita-row{grid-template-columns:1fr repeat(var(--cita-dias,1),100px);row-gap:3px}
