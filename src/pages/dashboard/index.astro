        const it = servicesList.find((x) => String(x.id) === String(row.dataset.id));
        const span = row.querySelector('[data-usage]'); if (!it || !span) return;
        const clave = String(it.name || '').trim().toLowerCase();
        const n = m.get(clave) || 0;
        /* El uso se cuenta por NOMBRE, así que dos servicios que se llaman igual —hoy
           "Producer" existe dos veces, a CHF 950/Tag y a CHF 120/Std— muestran los dos
           el mismo número, que es la suma de los dos. Decirlo es más honesto que un 80
           repetido que parece de cada uno. */
        const homonimos = servicesList.filter((x) => String(x.name || '').trim().toLowerCase() === clave).length;
