      en: { subject: 'How was working with Viven? 🌟', body: 'Hi {{first_name}},\n\nIt was a pleasure producing your video — we hope it\'s already working hard for you.\n\nIf you have 60 seconds, a short Google review would mean a lot to our small team (and helps other companies find us).\n\nThank you — and see you on the next project!\nSebastian & the Viven team' },
      de: { subject: 'Wie war die Zusammenarbeit mit Viven? 🌟', body: 'Guten Tag {{first_name}},\n\nEs war uns eine Freude, Ihr Video zu produzieren — wir hoffen, es arbeitet bereits fleissig für Sie.\n\nWenn Sie 60 Sekunden haben: Eine kurze Google-Bewertung würde unserem kleinen Team enorm helfen.\n\nHerzlichen Dank — bis zum nächsten Projekt!\nSebastian & das Viven-Team' },
      es: { subject: '¿Cómo fue trabajar con Viven? 🌟', body: 'Hola {{first_name}}:\n\nFue un placer producir tu video — esperamos que ya esté trabajando duro para vos.\n\nSi tenés 60 segundos, una reseña corta en Google ayuda muchísimo a nuestro equipo.\n\n¡Gracias — y hasta el próximo proyecto!\nSebastian y el equipo de Viven' },
    } },
  ];
  let tmplRows = {};       // 'key|lang' → fila de email_templates
  let tmplCurKey = null, tmplCurLang = 'en';
  async function tmplInit(){
    tmplRows = {};
    try {
      const { data, error } = await supabase.from('email_templates').select('*');
      if (error) throw error;
      (data || []).forEach((r) => { tmplRows[r.key + '|' + r.lang] = r; });
    } catch (e) { /* tabla pendiente (SQL 0062) — todo queda "original" */ }
    $('tmpl-list').innerHTML = TMPL_TOUCHPOINTS.map((t) => {
      const badges = ['en', 'de', 'es'].map((lg) => {
        const has = !!tmplRows[t.key + '|' + lg];
        return '<span class="pill" style="margin-right:6px;' + (has ? 'background:rgba(126,217,87,.18);color:#7ed957' : 'background:rgba(255,255,255,.06);color:var(--muted)') + '">' + lg.toUpperCase() + (has ? ' ✏️ editada' : ' · original') + '</span>';
      }).join('');
      return '<div class="of-card"><div class="of-card-open" data-tk="' + t.key + '">' +
        '<div class="of-card-main"><div class="of-card-title">' + esc(t.label) + '</div>' +
        '<div class="of-card-sub">' + badges + (t.wired ? '' : ' <span class="muted-note">— edición lista, envío server-side pendiente</span>') + '</div></div></div></div>';
    }).join('') || '<p class="muted-note">Sin touchpoints.</p>';
    $('tmpl-list').querySelectorAll('[data-tk]').forEach((c) => c.addEventListener('click', () => tmplOpen(c.dataset.tk)));
  }
  function tmplSwitchLang(lg){
    tmplCurLang = lg;
    $('tmpl-ed-langs').querySelectorAll('.tmpl-lang-btn').forEach((b) => b.classList.toggle('btn-primary', b.dataset.lg === lg));
    const row = tmplRows[tmplCurKey + '|' + lg];
    // sin fila guardada en email_templates → precargar el texto REAL que se manda hoy
    // (TMPL_TOUCHPOINTS[].defaults), no un campo en blanco — el badge "editada/original"
    // sigue reflejando solo si hay fila en la DB, no qué texto se ve acá.
    const t = TMPL_TOUCHPOINTS.find((x) => x.key === tmplCurKey);
    const def = (t && t.defaults && t.defaults[lg]) || { subject: '', body: '' };
    $('tmpl-ed-subject').value = row ? row.subject : def.subject;
    $('tmpl-ed-body').value = row ? row.body : def.body;
    $('tmpl-ed-restore').hidden = !row;
    $('tmpl-ed-preview').style.display = 'none';
  }
  function tmplOpen(key){
    tmplCurKey = key;
    const t = TMPL_TOUCHPOINTS.find((x) => x.key === key);
    $('tmpl-ed-title').textContent = t.label;
    $('tmpl-ed-vars').innerHTML = 'Variables disponibles: ' + t.vars.map((v) => '<code>{{' + v + '}}</code>').join(' · ') + ' — el resto del email (logo, botones, firma) es estructura fija.';
    $('tmpl-ed-langs').innerHTML = ['en', 'de', 'es'].map((lg) => '<button type="button" class="btn btn-ghost small tmpl-lang-btn" data-lg="' + lg + '">' + lg.toUpperCase() + '</button>').join('');
    $('tmpl-ed-langs').querySelectorAll('.tmpl-lang-btn').forEach((b) => b.addEventListener('click', () => tmplSwitchLang(b.dataset.lg)));
    $('tmpl-editor').hidden = false;
    tmplSwitchLang('en');
    $('tmpl-editor').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  const TMPL_SAMPLE = { first_name: 'Alex', last_name: 'Muster', name: 'Alex Muster', company: 'Acme AG', range: "CHF 8'000 – 14'000", calc_range: "CHF 8'000 – 14'000", when: 'Montag, 14. Juli, 10:00', duration: '15' };
  /* Una llave mal escrita no rompe nada: sale literal en el email del cliente. Pasó de
     verdad — la plantilla alemana de reseña usaba {{last_name}} cuando el envío solo
     resolvía {{first_name}}, y ese email decía "Guten Tag {{last_name}}," (nunca llegó a
     salir porque la función tampoco leía la plantilla, pero iba a salir así). */
  const tmplTokensRaros = (txt, vars) => [...new Set(String(txt || '').match(/\{\{[a-z_]+\}\}/gi) || [])]
    .filter((t) => !vars.includes(t.slice(2, -2)));
  $('tmpl-ed-preview-btn') && $('tmpl-ed-preview-btn').addEventListener('click', () => {
    const tok = (s) => String(s || '').replace(/\{\{(\w+)\}\}/g, (m, k) => (TMPL_SAMPLE[k] !== undefined ? TMPL_SAMPLE[k] : m));
    const subj = tok($('tmpl-ed-subject').value);
    const bodyHtml = tok($('tmpl-ed-body').value).trim().split(/\n{2,}/).map((p) => '<p style="margin:0 0 10px">' + esc(p).replace(/\n/g, '<br>') + '</p>').join('');
    $('tmpl-ed-preview').innerHTML = '<p class="muted-note">Asunto</p><p><b>' + esc(subj) + '</b></p><p class="muted-note" style="margin-top:10px">Cuerpo</p>' + (bodyHtml || '<p class="muted-note">(vacío)</p>');
    $('tmpl-ed-preview').style.display = 'block';
  });
  $('tmpl-ed-save') && $('tmpl-ed-save').addEventListener('click', async () => {
    const subject = $('tmpl-ed-subject').value.trim(), body = $('tmpl-ed-body').value.trim();
    if (!subject || !body){ toast('Completá asunto y cuerpo'); return; }
    const tDef = TMPL_TOUCHPOINTS.find((x) => x.key === tmplCurKey) || { vars: [] };
    const raros = tmplTokensRaros(subject + ' ' + body, tDef.vars);
    if (raros.length && !confirm('Estas llaves no existen para esta plantilla y saldrían tal cual en el email:\n\n'
      + raros.join('  ') + '\n\nLas que sí funcionan: ' + tDef.vars.map((v) => '{{' + v + '}}').join('  ')
      + '\n\n¿Guardar igual?')) return;
    const { error } = await supabase.from('email_templates').upsert({ key: tmplCurKey, lang: tmplCurLang, subject, body, updated_at: new Date().toISOString() });
    if (error){ toast('⚠️ ' + error.message + ' (¿corriste la SQL 0062?)'); return; }
    tmplRows[tmplCurKey + '|' + tmplCurLang] = { key: tmplCurKey, lang: tmplCurLang, subject, body };
    $('tmpl-ed-restore').hidden = false;
    toast('💾 Guardado'); tmplInit();
  });
  $('tmpl-ed-restore') && $('tmpl-ed-restore').addEventListener('click', async () => {
    if (!confirm('¿Restaurar el original? Se borra tu edición para ' + tmplCurLang.toUpperCase() + '.')) return;
    await supabase.from('email_templates').delete().eq('key', tmplCurKey).eq('lang', tmplCurLang);
    delete tmplRows[tmplCurKey + '|' + tmplCurLang];
    toast('↺ Restaurado'); tmplSwitchLang(tmplCurLang); tmplInit();
  });
  $('tmpl-ed-close') && $('tmpl-ed-close').addEventListener('click', () => { $('tmpl-editor').hidden = true; });

  /* =========================================================================
     👤 MI PERFIL (SQL 0064 team_profiles) — Task C. Foto + firma del usuario
     LOGUEADO (meEmail) — no un admin de todo el team. Foto vía Supabase
     Storage bucket "team-avatars" (crear a mano una vez, ver migración 0064).
     ========================================================================= */
  let profileAvatarPendingUrl = null;
  function profileRenderAvatar(url, name){
    const el = $('profile-avatar-preview'); if (!el) return;
    if (url) { el.style.background = 'transparent'; el.innerHTML = '<img src="' + esc(url) + '" style="width:100%;height:100%;object-fit:cover" />'; }
    else { const nm = name || meEmail || '?'; el.style.background = avColorG(nm); el.innerHTML = esc((nm[0] || '?').toUpperCase()); }
  }
  function profileRenderSignPreview(){
    $('profile-sign-preview').textContent = $('profile-signature').value.trim() || '(sin firma configurada — el compositor sigue usando el nombre elegido con el toggle Sofia/Sebastian)';
  }
  function profileInit(){
    $('profile-who').textContent = meEmail ? 'Editando el perfil de: ' + meEmail : '⚠️ No se detectó tu email de sesión — entrá de nuevo si esto persiste.';
    const p = profileFor(meEmail) || {};
    $('profile-name').value = p.name || '';
    $('profile-role').value = p.role || '';
    $('profile-phone').value = p.phone || '';
    $('profile-costo').value = p.costo_hora != null ? p.costo_hora : '';
    $('profile-signature').value = p.signature_text || '';
    profileAvatarPendingUrl = p.avatar_url || null;
    profileRenderAvatar(p.avatar_url, p.name);
    profileRenderSignPreview();
    profileFaltaRender(p);
  }
  /* Qué le falta a este perfil, dicho por lo que provoca — no por el campo vacío. */
  function profileFaltaRender(p){
    const box = $('profile-falta'); if (!box) return;
    const falta = [];
    if (!p.avatar_url) falta.push('<b>la foto</b> — los emails que salen a tu nombre muestran solo la inicial');
    if (!p.signature_text) falta.push('<b>la firma</b> — se firma con tu nombre y rol pelados');
    if (!p.phone) falta.push('<b>el teléfono</b> — no aparece en la firma de los emails');
    if (!p.costo_hora) falta.push('<b>tu costo por hora</b> — sin eso, las horas que anotes en un proyecto entran como gratis y el margen miente para arriba');
    if (!falta.length){ box.hidden = true; return; }
    const enBook = p.book_visible ? ' Y sos vos quien aparece en <b>/book/</b>, así que es la cara que ve el cliente al reservar.' : '';
    box.innerHTML = 'Te falta ' + falta.join('; ') + '.' + enBook;
    box.hidden = false;
  }
  $('profile-signature') && $('profile-signature').addEventListener('input', profileRenderSignPreview);
  $('profile-avatar-btn') && $('profile-avatar-btn').addEventListener('click', () => $('profile-avatar-file').click());
  $('profile-avatar-file') && $('profile-avatar-file').addEventListener('change', async (e) => {
    const file = e.target.files[0]; if (!file) return;
    if (!meEmail){ toast('Sin sesión detectada'); return; }
    try {
      const safeName = file.name.replace(/[^a-z0-9.\-_]/gi, '_');
      const path = meEmail.toLowerCase().replace(/[^a-z0-9@._-]/gi, '_') + '/' + Date.now() + '-' + safeName;
      const { error } = await supabase.storage.from('team-avatars').upload(path, file, { upsert: true });
      if (error) throw error;
      const { data: pub } = supabase.storage.from('team-avatars').getPublicUrl(path);
      profileAvatarPendingUrl = pub && pub.publicUrl;
      profileRenderAvatar(profileAvatarPendingUrl, $('profile-name').value);
      toast('📷 Foto subida — tocá 💾 Guardar para confirmar');
    } catch (err) { toast('⚠️ ' + (err && err.message || err) + ' (¿existe el bucket público "team-avatars" en Supabase Storage?)'); }
  });
  $('profile-save') && $('profile-save').addEventListener('click', async () => {
    if (!meEmail){ toast('Sin sesión detectada'); return; }
    const patch = {
      email: meEmail, name: $('profile-name').value.trim() || null, role: $('profile-role').value.trim() || null,
      phone: $('profile-phone').value.trim() || null, signature_text: $('profile-signature').value.trim() || null,
      costo_hora: $('profile-costo').value.trim() ? numCHF($('profile-costo').value) : null,
      avatar_url: profileAvatarPendingUrl || null, updated_at: new Date().toISOString(),
    };
    const { error } = await supabase.from('team_profiles').upsert(patch);
    if (error){ toast('⚠️ ' + error.message + ' (¿corriste la SQL 0064?)'); return; }
    teamProfiles[meEmail.toLowerCase()] = patch;
    toast('💾 Perfil guardado');
  });


  /* ---------- 🔑 Usuarios (edge function admin-users) ----------
     Sebastián quería poder crear a alguien del equipo, elegirle la contraseña,
     cambiársela y darlo de baja sin entrar nunca al panel de Supabase. Todo pasa
     por la función admin-users, que es la que tiene el service role; desde el
     navegador NO se toca auth.users ni se guarda una contraseña en ningún lado
     (ni en localStorage ni en el DOM más allá del input que él mismo llenó).

     Mientras la función no esté desplegada, esto devuelve 404: la pantalla se
     dibuja igual y muestra el error, no se bloquea. */
  let usrBuilt = false, usrRows = [], usrColados = [];
  const USR_MIN = 12;

  function usuariosInit(){
    if (!usrBuilt){
      usrBuilt = true;
      $('usr-new').addEventListener('click', () => {
        const pan = $('usr-form-panel'); pan.hidden = !pan.hidden;
        if (!pan.hidden){ $('usr-email').value = ''; $('usr-pass').value = ''; usrMedir(); $('usr-email').focus(); }
      });
      $('usr-cancel').addEventListener('click', () => { $('usr-form-panel').hidden = true; $('usr-pass').value = ''; });
      $('usr-gen').addEventListener('click', () => { $('usr-pass').value = usrGenerar(); usrMedir(); });
      $('usr-pass').addEventListener('input', usrMedir);
      $('usr-create').addEventListener('click', usrCrear);
    }
    usrCargar();
  }

  /* Contraseña al azar con crypto.getRandomValues — Math.random() no sirve para
     esto: es predecible y estas claves abren el CRM entero. */
  function usrGenerar(){
    const abc = 'abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!@#$%&*?';
    const n = 20, buf = new Uint32Array(n);
    crypto.getRandomValues(buf);
    return Array.from(buf, (x) => abc[x % abc.length]).join('');
  }
  /* Medidor de fuerza: largo + variedad. No pretende ser una ciencia — es para que
     nadie ponga "viven2026" y se quede tranquilo. */
  function usrFuerza(pw){
    const largo = pw.length;
    let clases = 0;
    if (/[a-z]/.test(pw)) clases++;
    if (/[A-Z]/.test(pw)) clases++;
    if (/[0-9]/.test(pw)) clases++;
    if (/[^a-zA-Z0-9]/.test(pw)) clases++;
    if (largo < USR_MIN) return { pct: Math.min(largo / USR_MIN * 40, 40), txt: 'Corta — mínimo ' + USR_MIN + ' caracteres', color: '#ff6b6b' };
    if (clases <= 2) return { pct: 55, txt: 'Débil — mezclá mayúsculas, números y símbolos', color: '#f0c060' };
    if (largo < 16) return { pct: 78, txt: 'Buena', color: '#7fd6a0' };
    return { pct: 100, txt: 'Muy buena', color: 'var(--acid)' };
  }
  function usrMedir(){
    const pw = $('usr-pass').value, f = usrFuerza(pw), bar = $('usr-meter').firstElementChild;
    bar.style.width = (pw ? f.pct : 0) + '%'; bar.style.background = f.color;
    $('usr-meter-txt').textContent = pw ? f.txt : '—';
  }

  async function usrLlamar(body){
    const { data, error } = await supabase.functions.invoke('admin-users', { body });
    if (error) throw new Error((data && data.error) || error.message || 'sin respuesta');
    if (data && data.error) throw new Error(data.error);
    return data || {};
  }

  async function usrCargar(){
    const box = $('usr-list'); box.innerHTML = '<p class="muted-note">Cargando…</p>';
    try {
      const d = await usrLlamar({ action: 'list' });
      usrRows = Array.isArray(d.users) ? d.users : [];
      // "colados": tienen cuenta de Auth pero no están en user_roles — quedaron del mes
      // que el alta pública estuvo abierta. La función los marca a propósito; taparlos
      // acá sería borrar justo la señal por la que se cerró el alta.
      // ...menos los que ya dimos de baja: darlos de baja BORRA su fila de user_roles,
      // así que vuelven en la lista de colados. Esos no son un descuido, son una decisión.
      usrColados = (Array.isArray(d.colados) ? d.colados : [])
        .filter((e) => { const u = usrRows.find((x) => x.email === e); return !u || !u.disabled; });
      usrRender();
    } catch (e) {
      // 404 = la función todavía no está desplegada. Se dice y listo: la pantalla
      // queda usable en cuanto exista, sin tocar nada acá.
      box.innerHTML = '<p class="muted-note" style="color:#ff8b5e">No se pudo leer la lista de usuarios: ' + esc(e.message || e) +
        '<br><span style="color:var(--muted-2)">Si dice 404, la función admin-users todavía no está desplegada.</span></p>';
    }
  }

  function usrRender(){
    const box = $('usr-list');
    if (!usrRows.length){ box.innerHTML = '<p class="muted-note">Todavía no hay usuarios.</p>'; return; }
    const f = (iso) => iso ? new Date(iso).toLocaleDateString('es-CH', { day: '2-digit', month: 'short', year: '2-digit' }) : '—';
    box.innerHTML = (usrColados.length
      ? '<p class="muted-note" style="color:#ff8b5e;margin:0 0 12px"><b>' + usrColados.length +
        (usrColados.length === 1 ? ' cuenta tiene' : ' cuentas tienen') + ' usuario y contraseña pero no están en la lista de acceso</b>' +
        ' — se registraron solas cuando el alta estaba abierta. Hoy no entran a ningún lado: o les das acceso, o las das de baja.</p>'
      : '') +
      '<div class="lead-table-wrap"><table class="lead-table"><thead><tr>' +
      '<th>Email</th><th>Rol</th><th>Último ingreso</th><th>Estado</th><th></th></tr></thead><tbody>' +
      usrRows.map((u) => {
        const baja = !!u.disabled;
        // sin rol = tiene cuenta pero no está en user_roles: no entra (SQL 0127, is_member())
        const sinAcceso = !u.role;
        return '<tr' + (baja ? ' style="opacity:.55"' : '') + '>' +
          '<td>' + esc(u.email || '') + (u.email === meEmail ? ' <span class="badge">vos</span>' : '') + '</td>' +
          '<td>' + (u.role === 'superadmin'
            ? '<span class="badge" style="color:#f0c060;border:1px solid #f0c060;background:rgba(240,192,96,.08)">superadmin</span>'
            : sinAcceso
              ? '<span class="badge" style="color:#ff8b5e;border:1px solid #ff8b5e;background:rgba(255,139,94,.08)">sin acceso</span>'
              : 'miembro') + '</td>' +
          '<td>' + f(u.last_sign_in_at) + '</td>' +
          '<td>' + (baja ? '🚫 De baja' : '✅ Activo') + '</td>' +
          '<td style="white-space:nowrap;text-align:right">' +
            '<button class="btn btn-ghost small" data-usr-pass="' + esc(u.email) + '" type="button">🔑 Contraseña</button> ' +
            '<button class="btn btn-ghost small" data-usr-role="' + esc(u.email) + '" type="button">' +
              (u.role === 'superadmin' ? '↓ Hacer miembro' : sinAcceso ? '✓ Dar acceso' : '↑ Hacer superadmin') + '</button> ' +
            (baja ? '' : '<button class="btn btn-ghost small danger" data-usr-off="' + esc(u.email) + '" type="button">✕ Dar de baja</button>') +
          '</td></tr>';
      }).join('') + '</tbody></table></div>';

    box.querySelectorAll('[data-usr-pass]').forEach((b) => b.addEventListener('click', () => usrCambiarPass(b.dataset.usrPass)));
    box.querySelectorAll('[data-usr-role]').forEach((b) => b.addEventListener('click', () => usrCambiarRol(b.dataset.usrRole)));
    box.querySelectorAll('[data-usr-off]').forEach((b) => b.addEventListener('click', () => usrDarDeBaja(b.dataset.usrOff)));
  }

  async function usrCrear(){
    const email = $('usr-email').value.trim().toLowerCase(), pass = $('usr-pass').value, role = $('usr-role').value;
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){ toast('Email inválido'); return; }
    if (pass.length < USR_MIN){ toast('La contraseña necesita al menos ' + USR_MIN + ' caracteres'); return; }
    const btn = $('usr-create'); btn.disabled = true; btn.textContent = 'Creando…';
    try {
      await usrLlamar({ action: 'create', email, password: pass, role });
      toast('✅ Usuario creado — pasale la contraseña por un canal seguro');
      $('usr-form-panel').hidden = true; $('usr-pass').value = ''; $('usr-email').value = '';
      usrMedir(); usrCargar();
    } catch (e) { toast('No se pudo crear: ' + (e.message || e)); }
    finally { btn.disabled = false; btn.textContent = 'Crear usuario'; }
  }

  async function usrCambiarPass(email){
    const nueva = prompt('Nueva contraseña para ' + email + '\n\nMínimo ' + USR_MIN + ' caracteres. Dejalo vacío y cancelá si no querés cambiarla.\n(Tip: 🎲 Generar en el formulario de arriba arma una segura.)');
    if (nueva === null) return;
    if (nueva.length < USR_MIN){ toast('Muy corta: mínimo ' + USR_MIN + ' caracteres'); return; }
    try {
      await usrLlamar({ action: 'set_password', email, password: nueva });
      toast('🔑 Contraseña cambiada — avisale por un canal seguro');
    } catch (e) { toast('No se pudo cambiar: ' + (e.message || e)); }
  }

  async function usrCambiarRol(email){
    const u = usrRows.find((x) => x.email === email); if (!u) return;
    // sin rol todavía: el paso que corresponde es darle acceso de miembro, no coronarlo
    const nuevo = !u.role ? 'member' : u.role === 'superadmin' ? 'member' : 'superadmin';
    const aviso = !u.role
      ? '¿Darle acceso a ' + email + ' como miembro?\n\nA partir de ahora entra al dashboard con la contraseña que ya tiene.'
      : nuevo === 'superadmin'
        ? '¿Hacer superadmin a ' + email + '?\n\nVa a ver Cash Flow y va a poder crear y dar de baja usuarios.'
        : '¿Sacarle superadmin a ' + email + '?\n\nDeja de ver Cash Flow y de administrar usuarios.';
    if (!confirm(aviso)) return;
    try { await usrLlamar({ action: 'set_role', email, role: nuevo }); toast('✅ Rol actualizado'); usrCargar(); }
    catch (e) { toast('No se pudo cambiar el rol: ' + (e.message || e)); }
  }

  async function usrDarDeBaja(email){
    if (email === meEmail){ toast('No podés darte de baja a vos mismo'); return; }
    if (!confirm('¿Dar de baja a ' + email + '?\n\nDeja de poder entrar al dashboard. Sus datos, notas y tareas quedan como están.')) return;
    try { await usrLlamar({ action: 'disable', email }); toast('🚫 Usuario dado de baja'); usrCargar(); }
    catch (e) { toast('No se pudo dar de baja: ' + (e.message || e)); }
  }

  /* ---------- 🩺 Salud de los crons (RPC cron_health) ----------
     25 tareas programadas y ninguna forma de saber si una se apagó: el newsletter
     que no sale o el blog que no se escribe se descubrían por ausencia, días
     después. Verde = la última corrida terminó bien y dentro de lo que su horario
     hacía esperar; rojo = falló, o hace más de dos ciclos que no corre. Rojo
     primero, porque lo que anda no necesita mirarse. */
  let cronsBuilt = false;
  function cronsInit(){
    if (!cronsBuilt){ cronsBuilt = true;
      $('crons-refresh').addEventListener('click', () => { cronsCargar(); frescuraCargar(); });
      $('errs-refresh') && $('errs-refresh').addEventListener('click', erroresCargar);
    }
    erroresCargar();
    cronsCargar();
    frescuraCargar();
  }

  /* ---------- 🧯 Lo que se rompió ----------
     Dos clases, y la diferencia importa:
     · «excepción» — un error de JS. Mata la función donde ocurre y deja la pantalla a
       medias sin decir nada. Desde afuera se ve como «no puedo entrar al proyecto».
     · «lo viste en pantalla» — el código lo atrapó y mostró un aviso de seis segundos.
       El usuario se enteró; el que arregla, no, hasta ahora.
     Se agrupan por mensaje: si algo falla en bucle, interesa el mensaje y cuántas veces,
     no doscientas filas iguales. */
  async function erroresCargar(){
    const box = $('errs-list'); if (!box) return;
    box.innerHTML = '<p class="muted-note">Cargando…</p>';
    const desde = new Date(Date.now() - 7 * 864e5).toISOString();
    const { data, error } = await supabase.from('dash_perf_log')
      .select('at,email,phases').gte('at', desde).order('at', { ascending: false }).limit(400);
    if (error){ box.innerHTML = '<p class="muted-note" style="color:#ff8b5e">No pude leer el registro: ' + esc(error.message) + '</p>'; return; }
    const grupos = new Map();
    for (const f of data || []){
      const p = f.phases || {};
      if (p.kind !== 'error' && p.kind !== 'error_visto') continue;
      const clave = p.kind + '|' + String(p.msg || '').slice(0, 140);
      const g = grupos.get(clave) || { kind: p.kind, msg: String(p.msg || '(sin mensaje)'),
                                       donde: p.donde || '', tab: p.tab || '', n: 0, ultima: f.at, quien: new Set() };
      g.n++; if (f.at > g.ultima) g.ultima = f.at;
      if (f.email) g.quien.add(String(f.email).split('@')[0]);
      grupos.set(clave, g);
    }
    const lista = [...grupos.values()].sort((a, b) => (a.ultima < b.ultima ? 1 : -1));
    if (!lista.length){
      box.innerHTML = '<p class="muted-note">✅ Ningún error en 7 días.</p>';
      return;
    }
    box.innerHTML = lista.map((g) => {
      const roto = g.kind === 'error';
      return '<div style="border-left:3px solid ' + (roto ? 'var(--lost)' : 'var(--warn)') +
        ';padding:9px 0 9px 12px;margin-bottom:12px">' +
        '<div style="font-weight:600;font-size:13.5px">' + esc(g.msg) + '</div>' +
        '<div class="muted-note" style="margin-top:3px">' +
          (roto ? 'dejó la pantalla a medias' : 'lo viste en un aviso') +
          ' · ' + g.n + '×' +
          (g.quien.size ? ' · ' + [...g.quien].join(', ') : '') +
          ' · última ' + timeAgo(g.ultima) +
          (g.tab ? ' · en ' + esc(String(g.tab).slice(0, 40)) : '') +
        '</div></div>';
    }).join('');
  }

  /* ---------- 📥 ¿Las tablas se están llenando? (RPC frescura_de_datos, SQL 0141) ----------
     El panel de crons pregunta si la tarea corrió. El 11 ago 2026 eso no alcanzó:
     Google apagó la versión v21 de su API, el sync de Ads empezó a recibir 404, y
     aun así el cron decía "succeeded" todos los días —porque el POST salía bien— y
     la función devolvía ok:true, porque su otra mitad (el Sheet) sí funcionaba.
     ads_daily quedó congelada catorce días y el panel de Ads siguió mostrando gasto
     y ROAS, solo que con menos datos adentro. Nadie tenía cómo notarlo.
     Esto pregunta otra cosa: cuándo entró la última fila. Es la diferencia entre
     "¿mandaste la carta?" y "¿llegó?". */
  async function frescuraCargar(){
    const box = $('frescura-list'); if (!box) return;
    box.innerHTML = '<p class="muted-note">Cargando…</p>';
    try {
      const { data, error } = await supabase.rpc('frescura_de_datos');
      if (error) throw error;
      const filas = Array.isArray(data) ? data : [];
      if (!filas.length){ box.innerHTML = '<p class="muted-note">Sin datos todavía.</p>'; return; }
      // lo que está mal, primero: lo que anda no necesita mirarse
      const orden = { viejo: 0, sin_datos: 1, ok: 2 };
      filas.sort((a, b) => (orden[a.estado] - orden[b.estado]) || ((b.horas || 0) - (a.horas || 0)));
      const cuanto = (h) => h == null ? 'nunca'
        : h < 1 ? 'hace minutos'
        : h < 48 ? 'hace ' + Math.round(h) + ' h'
        : 'hace ' + Math.round(h / 24) + ' días';
      const malas = filas.filter((f) => f.estado === 'viejo').length;
      box.innerHTML =
        '<p class="muted-note" style="margin:0 0 12px">' + (malas
          ? '⚠️ ' + malas + (malas === 1 ? ' tabla dejó de recibir datos.' : ' tablas dejaron de recibir datos.')
          : '✅ Todo lo que tiene que llenarse se está llenando.') + '</p>' +
        '<div style="overflow-x:auto"><table class="perf"><thead><tr>' +
          '<th>Qué</th><th>Último dato</th><th class="num">Se espera cada</th><th></th>' +
        '</tr></thead><tbody>' +
        filas.map((f) => {
          const color = f.estado === 'viejo' ? '#ff8b8b' : f.estado === 'sin_datos' ? 'var(--muted-2)' : '#7ed957';
          const sello = f.estado === 'viejo' ? '● atrasado' : f.estado === 'sin_datos' ? '○ sin datos' : '● al día';
          return '<tr><td>' + esc(f.que_es) + '<div class="muted-note" style="font-size:11px">' + esc(f.tabla) + '</div></td>' +
            '<td>' + cuanto(f.horas) + (f.ultima ? '<div class="muted-note" style="font-size:11px">' +
              new Date(f.ultima).toLocaleDateString('es-CH', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) + '</div>' : '') + '</td>' +
            '<td class="num">' + (f.horas_tolerancia < 48 ? f.horas_tolerancia + ' h' : Math.round(f.horas_tolerancia / 24) + ' d') + '</td>' +
            '<td style="color:' + color + ';font-weight:700;white-space:nowrap">' + sello + '</td></tr>';
        }).join('') + '</tbody></table></div>';
    } catch (e) {
      box.innerHTML = '<p class="muted-note">No se pudo cargar (' + esc(e.message || 'error') + ') — ¿corriste el SQL 0141?</p>';
    }
  }
  /* Cada cuánto corre, en minutos, leído del schedule de pg_cron. Solo lo que
     usamos de verdad: cada N minutos, horario, diario y semanal. Si no se entiende,
     devolvemos null y ese cron no se marca rojo por antigüedad (no inventamos). */
  function cronCadaMin(sched){
    const s = String(sched || '').trim();
    let m = s.match(/^\*\/(\d+) \* \* \* \*$/); if (m) return +m[1];
    if (/^\d+ \* \* \* \*$/.test(s)) return 60;
    if (/^[\d,\/*-]+ [\d,\/*-]+ \* \* \*$/.test(s)) return 60 * 24;
    if (/^[\d,\/*-]+ [\d,\/*-]+ \* \* [\d,]+$/.test(s)) return 60 * 24 * 7;
    return null;
  }
  /* La columna "cada" se lee, no se descifra: el schedule crudo ("0 7 * * *") no le
     dice nada a nadie. Si no lo entendemos, mostramos el crudo antes que mentir. */
  function cronCadaTexto(sched, minutos){
    const m = minutos != null ? +minutos : cronCadaMin(sched);
    if (m == null || !isFinite(m)) return String(sched || '—');
    if (m < 60) return 'cada ' + m + ' min';
    if (m === 60) return 'cada hora';
    if (m === 60 * 24) return 'todos los días';
    if (m === 60 * 24 * 7) return 'cada semana';
    if (m === 60 * 24 * 30) return 'una vez por mes';
    return 'cada ' + cronMins(m);
  }
  async function cronsCargar(){
    const box = $('crons-list'); box.innerHTML = '<p class="muted-note">Cargando…</p>';
    try {
      const { data, error } = await supabase.rpc('cron_health');
      if (error) throw error;
      const filas = Array.isArray(data) ? data : [];
      if (!filas.length){ box.innerHTML = '<p class="muted-note">Sin datos de crons todavía.</p>'; return; }
      /* Quién decide si un cron está mal: la RPC (SQL 0128), que ya devuelve `estado`
         y las filas ordenadas con lo urgente arriba. Acá NO se recalcula — dos motores
         con reglas parecidas terminan contradiciéndose y no se sabe a cuál creerle.
         El cálculo local queda solo de red: si la RPC es vieja y no manda `estado`. */
      const ahora = Date.now();
      const evaluadas = filas.map((c) => {
        const min = c.minutos_desde != null ? Math.round(+c.minutos_desde)
          : c.last_run ? Math.round((ahora - Date.parse(c.last_run)) / 60000) : null;
        if (c.estado){
          const mal = ['apagado', 'nunca_corrio', 'fallo', 'atrasado'].includes(c.estado);
          const motivo = c.estado === 'apagado' ? 'está apagado'
            : c.estado === 'nunca_corrio' ? 'nunca corrió'
            : c.estado === 'fallo' ? 'la última corrida falló'
            : c.estado === 'atrasado' ? 'hace ' + cronMins(min) + ' que no corre'
            : c.estado === 'sin_referencia' ? 'corrió — no sé cada cuánto debería'
            : '';
          return { ...c, min, fallo: c.estado === 'fallo', mal, gris: c.estado === 'sin_referencia', motivo };
        }
        const cada = cronCadaMin(c.schedule);
        const fallo = c.last_status && !/^succe/i.test(String(c.last_status));
        const tarde = cada != null && min != null && min > cada * 2;
        const nunca = !c.last_run;
        return { ...c, cada, min, fallo: !!fallo, mal: !!(fallo || tarde || nunca), motivo: fallo ? 'la última corrida falló' : nunca ? 'nunca corrió' : tarde ? 'hace ' + cronMins(min) + ' que no corre' : '' };
      });
      if (!filas.some((c) => c.estado)) evaluadas.sort((a, b) => (b.mal ? 1 : 0) - (a.mal ? 1 : 0) || String(a.jobname).localeCompare(String(b.jobname)));
      const mal = evaluadas.filter((c) => c.mal).length;
      const grises = evaluadas.filter((c) => c.gris).length;
      box.innerHTML =
        '<p class="muted-note" style="margin:0 0 12px">' + (mal
          ? '<b style="color:#ff8b5e">' + mal + (mal === 1 ? ' tarea necesita atención' : ' tareas necesitan atención') + '</b> de ' + evaluadas.length + '.'
          : '✅ Las ' + evaluadas.length + ' tareas corrieron cuando tenían que correr.') +
          // las "sin referencia" no son un problema, pero tampoco están verificadas: se dicen aparte
          (grises ? ' <span style="opacity:.8">' + grises + (grises === 1 ? ' tiene un horario' : ' tienen horarios') + ' que no sé leer, así que de esa no puedo decir si se atrasó.</span>' : '') + '</p>' +
        '<div class="lead-table-wrap"><table class="lead-table"><thead><tr><th>Tarea</th><th>Cada</th><th>Última corrida</th><th>Estado</th></tr></thead><tbody>' +
        evaluadas.map((c) => '<tr>' +
          '<td><span style="color:' + (c.mal ? '#ff8b5e' : c.gris ? 'var(--muted)' : '#7fd6a0') + '">●</span> ' + esc(c.jobname || '') + '</td>' +
          '<td class="muted-note" title="' + esc(c.schedule || '') + '">' + esc(cronCadaTexto(c.schedule, c.esperado_cada_min)) + '</td>' +
          '<td>' + (c.last_run ? esc(new Date(c.last_run).toLocaleString('es-CH', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })) : '—') + '</td>' +
          '<td>' + (c.mal
            /* el mensaje solo se muestra cuando la corrida falló: si el cron está
               atrasado, el último mensaje es viejo y decir "· ok" al lado del rojo confunde */
            ? '<span style="color:#ff8b5e">' + esc(c.motivo) + (c.fallo && c.last_message ? ' · ' + esc(String(c.last_message).slice(0, 60)) : '') + '</span>'
            : c.gris ? '<span class="muted-note">' + esc(c.motivo) + '</span>'
            : '<span style="color:#7fd6a0">ok</span>') + '</td>' +
        '</tr>').join('') + '</tbody></table></div>';
    } catch (e) {
      box.innerHTML = '<p class="muted-note" style="color:#ff8b5e">No se pudo leer el estado de los crons: ' + esc(e.message || e) +
        '<br><span style="color:var(--muted-2)">Si dice que no existe la función, falta correr la migración 0128 (cron_health).</span></p>';
    }
  }
  const cronMins = (m) => m < 90 ? m + ' min' : m < 60 * 48 ? Math.round(m / 60) + ' h' : Math.round(m / 1440) + ' días';

  /* ---------- Roles (SQL 0077) — gate de superadmin para el tab Cash Flow ----------
     La seguridad REAL la da RLS (public.is_superadmin()); esto es solo UX: si no
     sos superadmin, el nav item y el contenido del tab se sacan del DOM del todo
     (no solo hidden) apenas se resuelve el rol. */
  let isSuperadmin = false;
  async function checkRole(){
    isSuperadmin = false;
    if (meEmail){
      try {
        const { data } = await supabase.from('user_roles').select('role').eq('email', meEmail).maybeSingle();
        isSuperadmin = !!(data && data.role === 'superadmin');
      } catch (e) { isSuperadmin = false; }
    }
    // fix (2026-07-14, shell): Cash Flow ahora vive como sub-tab de "Sistema" en vez de
    // side-group propio — se oculta/saca el botón del segmentado + su contenido, no un
    // group entero. Ver sistemaSetSub() más arriba (defensivo: nunca aterriza ahí sin ser superadmin).
    const btn = $('sistema-seg-cashflow-btn'), tabEl = $('sistema-sub-cashflow');
    // Usuarios va por el mismo camino: crear gente y cambiar roles es solo superadmin.
    // La seguridad REAL la da la edge function (verifica el rol del lado del server);
    // esto es UX — que no quede un botón que va a devolver "no autorizado".
    const btnU = $('sistema-seg-usuarios-btn'), tabU = $('sistema-sub-usuarios');
    // Crons NO va acá: la RPC cron_health() (SQL 0128) pide is_member(), no superadmin
    // — cualquiera de la casa puede ver si los motores están andando.
    if (isSuperadmin){
      if (btn) btn.hidden = false;
      if (btnU) btnU.hidden = false;
    } else {
      if (btn) btn.remove();
      if (tabEl) tabEl.remove();
      if (btnU) btnU.remove();
      if (tabU) tabU.remove();
    }
  }

  /* ---------- Cash Flow (SQL 0077/0078/0079) ----------
     Proyección de liquidez de Viven AG, SOLO CHF, SOLO superadmin. Motor
     client-side: saldo actual (cashflow_bank_balance) + partidas manuales/Bexio
     (cashflow_entries) + recurrentes activos expandidos (cashflow_recurring_templates)
     + préstamos/leasing expandidos como cuota mensual (cashflow_loans), 12 meses
     hacia adelante. La MISMA lógica está portada a TS en la edge function
     cashflow-alert (cron diario, SQL 0079) para el aviso por email. */
  let cfBuilt = false, cfPeriod = 'monthly';
  let cfBalance = null, cfSettings = { min_balance_threshold_chf: 15000, alert_email: 'sebastian@viven.ch', enabled: true };
  let cfEntries = [], cfTemplates = [], cfLoans = [], cfEvents = [], cfMonths = [], cfWeeks = [];
  let cfRecEditing = null, cfLoanEditing = null;
  const cfCHF = (n) => 'CHF ' + Math.round(Number(n) || 0).toLocaleString('de-CH');

  function cfInit(){
    if (!isSuperadmin) return;   // no debería ser alcanzable sin esto (el nav item no existe), pero por las dudas
    if (!cfBuilt){
      cfBuilt = true;
      $('cf-entry-add').addEventListener('click', () => {
        const f = $('cf-entry-form'); f.hidden = !f.hidden;
        if (!f.hidden){ $('cf-entry-date').value = new Date().toISOString().slice(0, 10); f.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      });
      $('cf-entry-cancel').addEventListener('click', () => { $('cf-entry-form').hidden = true; });
      $('cf-entry-save').addEventListener('click', cfSaveEntry);
      $('cf-rec-add').addEventListener('click', () => { cfRecEditing = null; cfOpenRecForm(); });
      $('cf-rec-cancel').addEventListener('click', () => { $('cf-rec-form').hidden = true; });
      $('cf-rec-save').addEventListener('click', cfSaveRec);
      $('cf-loan-add').addEventListener('click', () => { cfLoanEditing = null; cfOpenLoanForm(); });
      $('cf-loan-cancel').addEventListener('click', () => { $('cf-loan-form').hidden = true; $('cf-loan-actions').hidden = true; });
      $('cf-loan-save').addEventListener('click', cfSaveLoan);
      $('cf-cfg-balance-save').addEventListener('click', cfSaveBalance);
      $('cf-cfg-threshold-save').addEventListener('click', cfSaveThreshold);
      $('cf-cfg-credit-save').addEventListener('click', cfSaveCredit);
    }
    cfLoad();
  }

  async function cfLoad(){
    const [balQ, setQ, entQ, tplQ, loanQ] = await Promise.all([
      supabase.from('cashflow_bank_balance').select('*').order('as_of_date', { ascending: false }).limit(1).maybeSingle(),
      supabase.from('cashflow_alert_settings').select('*').eq('id', 1).maybeSingle(),
      supabase.from('cashflow_entries').select('*').order('due_date', { ascending: true }),
      supabase.from('cashflow_recurring_templates').select('*').order('created_at', { ascending: false }),
      supabase.from('cashflow_loans').select('*').order('end_date', { ascending: true }),
    ]);
    const firstError = balQ.error || setQ.error || entQ.error || tplQ.error || loanQ.error;
    if (firstError){
      $('cf-table').innerHTML = '<p class="muted-note">⚠️ ' + esc(firstError.message) + ' (¿corriste las SQL 0077/0078?)</p>';
      return;
    }
    cfBalance = balQ.data || null;
    cfSettings = setQ.data || cfSettings;
    cfEntries = entQ.data || [];
    cfTemplates = tplQ.data || [];
    cfLoans = loanQ.data || [];
    if (cfSettings && $('cf-cfg-credit') && $('cf-cfg-credit').value === '') $('cf-cfg-credit').value = Number(cfSettings.credit_limit_chf || 0) || '';
    $('cf-cfg-balance-cap').textContent = cfBalance ? ('Último registrado: ' + cfCHF(cfBalance.balance_chf) + ' (al ' + cfBalance.as_of_date + ')') : 'Todavía no cargaste un saldo — cargalo abajo en Configuración.';
    $('cf-cfg-threshold').value = cfSettings.min_balance_threshold_chf ?? 15000;
    cfBaseRender();
    cfProject();
    cfRenderKpis();
    cfRenderSeg();
    cfRenderChart();
    cfRenderTable();
    cfRenderRec();
    cfRenderLoans();
  }

  // expande entries + recurrentes + préstamos a una lista plana de eventos (fecha + delta),
  // horizonte de 12 meses desde hoy — es la base tanto de la tabla de detalle como de las
  // series semanal/mensual del gráfico y de los KPIs (runway / próximo mes en rojo)
  function cfExpandEvents(){
    const events = [];
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const horizon = new Date(today); horizon.setMonth(horizon.getMonth() + 12);

    (cfEntries || []).forEach((e) => {
      const d = new Date(e.due_date + 'T00:00:00');
      if (d < today || d > horizon) return;
      events.push({ date: d, delta: e.kind === 'income' ? Number(e.amount_chf) : -Number(e.amount_chf), label: e.description, tag: e.source === 'bexio' ? 'bexio' : 'manual' });
    });

    (cfTemplates || []).filter((t) => t.active).forEach((t) => {
      const s = new Date(t.start_date + 'T00:00:00');
      const endT = t.end_date ? new Date(t.end_date + 'T00:00:00') : null;
      for (let m = 0; m < 13; m++){
        const monthCursor = new Date(today.getFullYear(), today.getMonth() + m, 1);
        if (monthCursor > horizon) break;
        if (monthCursor.getFullYear() < s.getFullYear() || (monthCursor.getFullYear() === s.getFullYear() && monthCursor.getMonth() < s.getMonth())) continue;
        const occurs = t.frequency === 'monthly'
          || (t.frequency === 'quarterly' && ((monthCursor.getFullYear() * 12 + monthCursor.getMonth()) - (s.getFullYear() * 12 + s.getMonth())) % 3 === 0)
          || (t.frequency === 'yearly' && monthCursor.getMonth() === s.getMonth());
        if (!occurs) continue;
        /* Un vencimiento el 30 o el 31 cae el ÚLTIMO día del mes cuando ese mes no
           llega: febrero 30 no existe y `new Date(2027,1,30)` se va sola al 2 de marzo,
           corriendo el pago de mes. Se acota al último día real. */
        const ultimoDia = new Date(monthCursor.getFullYear(), monthCursor.getMonth() + 1, 0).getDate();
        const diaReal = Math.min(Number(t.day_of_month) || 1, ultimoDia);
        const occDate = new Date(monthCursor.getFullYear(), monthCursor.getMonth(), diaReal);
        if (occDate < today || occDate < s || occDate > horizon) continue;
        if (endT && occDate > endT) continue;
        events.push({ date: occDate, delta: t.kind === 'income' ? Number(t.amount_chf) : -Number(t.amount_chf), label: t.description, tag: 'rec' });
      }
    });

    (cfLoans || []).forEach((l) => {
      const s = new Date(l.start_date + 'T00:00:00');
      const e = new Date(l.end_date + 'T00:00:00');
      const day = Math.min(s.getDate(), 28);
      for (let m = 0; m < 13; m++){
        const monthCursor = new Date(today.getFullYear(), today.getMonth() + m, 1);
        if (monthCursor > horizon) break;
        const occDate = new Date(monthCursor.getFullYear(), monthCursor.getMonth(), day);
        if (occDate < today || occDate < s || occDate > e || occDate > horizon) continue;
        events.push({ date: occDate, delta: -Number(l.monthly_payment_chf), label: l.name, tag: 'loan' });
      }
    });

    events.sort((a, b) => a.date - b.date);
    return events;
  }

  function cfMonthlySeries(events){
    const today = new Date(); today.setHours(0, 0, 0, 0);
    let running = cfBalance ? Number(cfBalance.balance_chf) : 0;
    const months = [];
    for (let m = 0; m < 12; m++){
      const mStart = new Date(today.getFullYear(), today.getMonth() + m, 1);
      const mEnd = new Date(today.getFullYear(), today.getMonth() + m + 1, 1);
      const evs = events.filter((ev) => ev.date >= mStart && ev.date < mEnd);
      const inflow = evs.reduce((a, ev) => a + (ev.delta > 0 ? ev.delta : 0), 0);
      const outflow = evs.reduce((a, ev) => a + (ev.delta < 0 ? -ev.delta : 0), 0);
      const delta = inflow - outflow;
      running += delta;
      months.push({ label: mStart.toLocaleDateString('es-CH', { month: 'short', year: '2-digit' }), delta, inflow, outflow, balance: running });
    }
    return months;
  }
  function cfWeeklySeries(events){
    const today = new Date(); today.setHours(0, 0, 0, 0);
    let running = cfBalance ? Number(cfBalance.balance_chf) : 0;
    const dow = (today.getDay() + 6) % 7;   // 0 = lunes
    const weekStart0 = new Date(today); weekStart0.setDate(today.getDate() - dow);
    const horizon = new Date(today); horizon.setMonth(horizon.getMonth() + 12);
    const weeks = [];
    for (let w = 0; w < 53; w++){
      const wStart = new Date(weekStart0); wStart.setDate(weekStart0.getDate() + w * 7);
      if (wStart > horizon) break;
      const wEnd = new Date(wStart); wEnd.setDate(wStart.getDate() + 7);
      const evs = events.filter((ev) => ev.date >= wStart && ev.date < wEnd);
      const inflow = evs.reduce((a, ev) => a + (ev.delta > 0 ? ev.delta : 0), 0);
      const outflow = evs.reduce((a, ev) => a + (ev.delta < 0 ? -ev.delta : 0), 0);
      const delta = inflow - outflow;
      running += delta;
      weeks.push({ label: wStart.toLocaleDateString('es-CH', { day: '2-digit', month: 'short' }), delta, inflow, outflow, balance: running });
    }
    return weeks;
  }
  function cfProject(){
    cfEvents = cfExpandEvents();
    cfMonths = cfMonthlySeries(cfEvents);
    cfWeeks = cfWeeklySeries(cfEvents);
  }

  /* Con qué está hecha la proyección y qué le falta. Sin esto la pantalla dibuja una
     curva de liquidez igual de convincente con cuatro facturas que con la contabilidad
     entera — y nada en pantalla avisa cuál de las dos estás mirando. */
  function cfBaseRender(){
    const box = $('cf-base'); if (!box) return;
    const ents = cfEntries || [], recs = cfTemplates || [], loans = cfLoans || [];
    const deBexio = ents.filter((e) => (e.source || '') === 'bexio').length;
    const aMano = ents.length - deBexio;
    /* Lo que entra, lo que sale, y lo que ya venció. Antes esta pantalla mostraba solo
       entradas: `kb_bill` devolvía 404 y el error se guardaba en un campo que nadie
       leía, así que Cash Flow proyectaba una empresa que cobra y nunca paga. */
    const entra = ents.filter((e) => e.kind === 'income').reduce((a, e) => a + (Number(e.amount_chf) || 0), 0);
    const sale = ents.filter((e) => e.kind === 'expense').reduce((a, e) => a + (Number(e.amount_chf) || 0), 0);
    const borradores = ents.filter((e) => /^📝/.test(e.description || ''));
    const vencidas = ents.filter((e) => /vencida hace/.test(e.description || ''));
    const vencChf = vencidas.reduce((a, e) => a + (Number(e.amount_chf) || 0), 0);
    const recAct = recs.filter((r) => r.active !== false).length;
    const loanAct = loans.length;

    const partes = [];
    partes.push('entra <b>' + pjCHF(entra) + '</b>');
    partes.push('sale <b>' + pjCHF(sale) + '</b>');
    partes.push('<b>' + ents.length + '</b> ' + (ents.length === 1 ? 'partida' : 'partidas')
      + (ents.length ? ' (' + deBexio + ' de bexio, ' + aMano + ' a mano)' : ''));
    /* Los recurrentes se muestran CON su total mensual. Con "2 recurrentes" a secas,
       que sumaran CHF 750 al mes para una empresa con oficina y empleada no se veía;
       con el número puesto, salta. (Era 9.531 mal leído como 9,531.) */
    const mensualRec = (recs || []).filter((r) => r.active !== false).reduce((a2, r) => {
      const n = Number(r.amount_chf) || 0;
      return a2 + (r.frequency === 'yearly' ? n / 12 : r.frequency === 'quarterly' ? n / 3 : n);
    }, 0);
    partes.push('<b>' + recAct + '</b> ' + (recAct === 1 ? 'recurrente' : 'recurrentes')
      + (mensualRec ? ' (' + pjCHF(mensualRec) + '/mes)' : ''));

    /* Redactado como "falta cargar X" y no "faltan X": con un solo ítem quedaba
       "todavía falta las salidas", y hacer concordar el verbo con una lista variable es
       pelearse con el castellano para nada. */
    const falta = [];
    if (!recAct) falta.push('los costos fijos: sueldos, alquiler, seguros, software');
    if (!cfBalance) falta.push('el saldo real del banco');
    if (!aMano && deBexio) falta.push('las salidas que no pasan por bexio');

    /* El runway y "próximo mes en rojo" arrancan del saldo del banco. Si ese saldo es
       de hace un mes, los dos números son de hace un mes y la pantalla no lo dice: el
       25 ago 2026 el último cargado era del 24 de julio. Un saldo viejo no es un hueco
       —es un número que parece fresco y no lo es—, así que va con su fecha a la vista. */
    let viejo = 0;
    if (cfBalance && cfBalance.as_of_date){
      viejo = Math.floor((Date.now() - new Date(cfBalance.as_of_date + 'T12:00:00').getTime()) / 864e5);
    }

    let txt = 'La proyección está hecha con ' + partes.join(' · ') + '.';
    /* Lo vencido va primero: son diez facturas por CHF 19.328 que ya deberían haberse
       cobrado o pagado, algunas de 2025. Metido dentro de la curva no se ve; dicho
       aparte, es lo primero que se mira. */
    if (vencidas.length){
      txt += ' <span class="cf-falta">' + vencidas.length + ' ya vencidas por ' + pjCHF(vencChf) +
        '</span> — están proyectadas a hoy porque es plata que ya debería haber entrado o salido.';
    }
    if (borradores.length){
      txt += ' <b>' + borradores.length + '</b> siguen en borrador en bexio (marcadas 📝): cuentan acá, pero hasta que las mandes no son cobrables ni pagables.';
    }
    if (viejo > 21){
      const dia = new Date(cfBalance.as_of_date + 'T12:00:00')
        .toLocaleDateString('es-CH', { day: 'numeric', month: 'long' });
      txt += ' <span class="cf-falta">El saldo del banco es del ' + esc(dia) + ' — hace ' + viejo
        + ' días</span>, así que el runway y el próximo mes en rojo arrancan de ahí y no de hoy.';
    }
    if (falta.length){
      txt += ' <span class="cf-falta">Para que dé la verdad todavía falta cargar ' + falta.join('; ')
        + '</span> — hasta entonces la curva es un techo, no un pronóstico.';
    }
    box.innerHTML = txt;
    box.hidden = false;

    /* Un panel vacío pide atención sin tener nada que dar: se abren solos solo si
       tienen algo adentro (y respetamos si vos lo abriste a mano). */
    const marcar = (id, n, vacio) => {
      const d = $(id); if (!d) return;
      const em = $(id + '-n'); if (em) em.textContent = n ? (n + (n === 1 ? ' cargado' : ' cargados')) : vacio;
      if (n && !d.dataset.tocado) d.open = true;
      if (!d.dataset.lig){ d.dataset.lig = '1'; d.addEventListener('toggle', () => { d.dataset.tocado = '1'; }); }
    };
    marcar('cf-det-rec', recAct, 'ninguno todavía — es lo que más le falta a la proyección');
    marcar('cf-det-loan', loanAct, 'ninguno cargado');
  }

  function cfRenderKpis(){
    const bal = cfBalance ? Number(cfBalance.balance_chf) : null;
    const kb = $('cf-k-balance');
    if (bal != null){
      kb.textContent = cfCHF(bal);
      kb.title = 'Actualizalo abajo en ⚙️ Configuración cuando cambie';
    } else {
      // sin saldo cargado la proyección no significa nada — llevarlo directo
      kb.innerHTML = '<a href="#cf-cfg-balance" style="color:var(--acid);font-size:15px;text-decoration:underline" onclick="document.getElementById(\'cf-cfg-balance\').focus()">Cargar saldo →</a>';
    }
    // runway REAL: hasta agotar el kontokorrent (piso = −límite), no hasta cero
    const creditLimit = Number((cfSettings && cfSettings.credit_limit_chf) || 0);
    const floor = -creditLimit;
    if (bal != null && creditLimit > 0){
      const avail = bal - floor;   // margen disponible hasta el límite
      $('cf-k-balance').innerHTML = cfCHF(bal) + '<span style="display:block;font-size:12px;font-weight:500;color:' + (avail > creditLimit * 0.2 ? 'var(--muted)' : '#ff8b8b') + '">quedan ' + cfCHF(avail) + ' del kontokorrent (' + cfCHF(creditLimit) + ')</span>';
    }
    const zeroIdx = cfMonths.findIndex((m) => m.balance < floor);
    const rw = $('cf-k-runway');
    if (zeroIdx === -1){ rw.textContent = '12+ meses'; rw.style.color = '#7ed957'; }
    else { rw.textContent = (zeroIdx + 1) + (zeroIdx === 0 ? ' mes' : ' meses') + (creditLimit > 0 ? ' hasta el límite' : ''); rw.style.color = '#ff8b8b'; }
    const threshold = Number((cfSettings && cfSettings.min_balance_threshold_chf) || 0);
    const redIdx = cfMonths.findIndex((m) => m.balance < threshold);
    const rm = $('cf-k-redmonth');
    if (redIdx === -1){ rm.textContent = 'Ninguno ✅'; rm.style.color = '#7ed957'; }
    else { rm.textContent = cfMonths[redIdx].label; rm.style.color = '#ff8b8b'; }
    const today = new Date(), in30 = new Date(today.getTime() + 30 * 864e5);
    const todayS = today.toISOString().slice(0, 10), in30S = in30.toISOString().slice(0, 10);
    const out30 = (cfEntries || []).filter((e) => e.kind === 'expense' && e.due_date >= todayS && e.due_date <= in30S).reduce((a, e) => a + Number(e.amount_chf), 0);
    $('cf-k-out30').textContent = cfCHF(out30);
  }

  function cfRenderSeg(){
    const seg = $('cf-seg'); if (!seg) return;
    seg.innerHTML = [['monthly', 'Mensual'], ['weekly', 'Semanal']].map(([k, lbl]) => '<button data-p="' + k + '" class="' + (cfPeriod === k ? 'on' : '') + '" type="button">' + lbl + '</button>').join('');
    seg.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { cfPeriod = b.dataset.p; cfRenderSeg(); cfRenderChart(); cfRenderTable(); }));
  }

  // gráfico SVG — reusa las mismas clases .gsvg/.g-grid/.g-yl/.g-xl/.g-line del chart de Analytics,
  // + línea punteada roja del umbral mínimo (no existe en Analytics, se agrega inline)
  function cfRenderChart(){
    const series = cfPeriod === 'weekly' ? cfWeeks : cfMonths;
    const box = $('cf-chart'); if (!box) return;
    if (!series.length){ box.innerHTML = '<p class="muted-note">Sin datos suficientes — cargá un saldo bancario en Configuración.</p>'; return; }
    const n = series.length, W = 1000, H = 260, padL = 66, padR = 14, padT = 16, padB = 28;
    const pw = W - padL - padR, ph = H - padT - padB;
    const threshold = Number((cfSettings && cfSettings.min_balance_threshold_chf) || 0);
    const creditLimit = Number((cfSettings && cfSettings.credit_limit_chf) || 0);
    const floor = -creditLimit;
    const vals = series.map((s) => s.balance);
    const minV = Math.min(0, threshold, creditLimit > 0 ? floor : 0, ...vals), maxV = Math.max(threshold, ...vals, 1);
    const range = (maxV - minV) || 1;
    const X = (i) => padL + (n <= 1 ? pw / 2 : (i / (n - 1)) * pw);
    const Y = (v) => padT + (1 - (v - minV) / range) * ph;
    const pts = series.map((s, i) => [X(i), Y(s.balance)]);
    const linePath = pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' ');
    const thY = Y(threshold);
    const grid = [minV, (minV + maxV) / 2, maxV].map((v) => {
      const y = Y(v);
      return '<line x1="' + padL + '" y1="' + y.toFixed(1) + '" x2="' + (W - padR) + '" y2="' + y.toFixed(1) + '" class="g-grid"/>' +
        '<text x="' + (padL - 8) + '" y="' + (y + 4).toFixed(1) + '" class="g-yl">' + cfCHF(v) + '</text>';
    }).join('');
    const step = Math.max(1, Math.ceil(n / 8));
    const xls = series.map((s, i) => ((i % step === 0) || i === n - 1) ? '<text x="' + X(i).toFixed(1) + '" y="' + (H - 8) + '" class="g-xl" text-anchor="middle">' + s.label + '</text>' : '').join('');
    const hover = series.map((s, i) => '<circle cx="' + X(i).toFixed(1) + '" cy="' + Y(s.balance).toFixed(1) + '" r="10" fill="transparent"><title>' + s.label + ': ' + cfCHF(s.balance) + '</title></circle>').join('');
    box.innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" class="gsvg">' + grid +
      '<line x1="' + padL + '" y1="' + thY.toFixed(1) + '" x2="' + (W - padR) + '" y2="' + thY.toFixed(1) + '" stroke="#ff8b8b" stroke-width="1.5" stroke-dasharray="5,4"/>' +
      (creditLimit > 0 ? '<line x1="' + padL + '" y1="' + Y(floor).toFixed(1) + '" x2="' + (W - padR) + '" y2="' + Y(floor).toFixed(1) + '" stroke="#ff4d4d" stroke-width="2" stroke-dasharray="3,3"/><text x="' + (W - padR) + '" y="' + (Y(floor) - 6).toFixed(1) + '" text-anchor="end" style="font-size:11px;fill:#ff4d4d">límite kontokorrent</text>' : '') +
      '<path d="' + linePath + '" class="g-line"/>' + hover + xls + '</svg>';
    $('cf-chart-cap').textContent = 'Punteada rosa = umbral de alerta (' + cfCHF(threshold) + ')' + (creditLimit > 0 ? ' · punteada roja = límite kontokorrent (−' + cfCHF(creditLimit) + ')' : '') + ' · saldo proyectado en verde';
  }

  function cfRenderTable(){
    const box = $('cf-table'); if (!box) return;
    if (!cfEvents.length){ box.innerHTML = '<p class="muted-note">Sin partidas futuras — agregá una con ➕ Agregar partida, o cargá recurrentes/préstamos abajo.</p>'; return; }
    // resumen por período (sigue el toggle Mensual/Semanal del gráfico): lo que
    // entra, lo que sale, neto y saldo proyectado — pedido: "resumen semanal y
    // mensual de lo que entra y lo que sale". Semanal: 13 semanas (~3 meses).
    const series = (cfPeriod === 'weekly' ? cfWeeks.slice(0, 13) : cfMonths).filter((r) => r.inflow || r.outflow || true);
    const sumRows = series.map((r) =>
      '<tr><td>' + esc(r.label) + '</td>' +
      '<td class="cf-amt pos">' + (r.inflow ? '+' + cfCHF(r.inflow) : '—') + '</td>' +
      '<td class="cf-amt neg">' + (r.outflow ? '−' + cfCHF(r.outflow) : '—') + '</td>' +
      '<td class="cf-amt ' + (r.delta >= 0 ? 'pos' : 'neg') + '">' + (r.delta >= 0 ? '+' : '−') + cfCHF(Math.abs(r.delta)) + '</td>' +
      '<td style="color:' + (r.balance < 0 ? '#ff8b8b' : 'inherit') + '">' + cfCHF(r.balance) + '</td></tr>').join('');
    const summary = '<div class="lead-table-wrap"><table class="lead-table"><thead><tr><th>' + (cfPeriod === 'weekly' ? 'Semana del' : 'Mes') + '</th><th>⬆ Entradas</th><th>⬇ Salidas</th><th>Neto</th><th>Saldo proyectado</th></tr></thead><tbody>' + sumRows + '</tbody></table></div>';
    let running = cfBalance ? Number(cfBalance.balance_chf) : 0;
    const TAGS = { rec: ['recurrente', 'rec'], loan: ['préstamo', 'loan'], bexio: ['Bexio', 'bexio'], manual: ['manual', 'manual'] };
    const rows = cfEvents.slice(0, 300).map((ev) => {
      running += ev.delta;
      const [tagLbl, tagCls] = TAGS[ev.tag] || TAGS.manual;
      return '<tr><td>' + ev.date.toLocaleDateString('es-CH') + '</td><td>' + esc(ev.label || '—') + '</td>' +
        '<td><span class="cf-tag ' + tagCls + '">' + tagLbl + '</span></td>' +
        '<td class="cf-amt ' + (ev.delta >= 0 ? 'pos' : 'neg') + '">' + (ev.delta >= 0 ? '+' : '−') + cfCHF(Math.abs(ev.delta)) + '</td>' +
        '<td>' + cfCHF(running) + '</td></tr>';
    }).join('');
    box.innerHTML = summary + '<details style="margin-top:12px"><summary style="cursor:pointer;color:var(--muted);font-size:13.5px">Ver movimientos uno por uno (' + cfEvents.length + ')</summary><div class="lead-table-wrap" style="margin-top:10px"><table class="lead-table"><thead><tr><th>Fecha</th><th>Descripción</th><th>Origen</th><th>Monto</th><th>Saldo corrido</th></tr></thead><tbody>' + rows + '</tbody></table></div></details>';
  }

