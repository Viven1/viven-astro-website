  .pj-prop h4{margin:0 0 4px;font-size:14px}
  .pj-prop .sub{font-size:12px;color:var(--muted-2);margin:0 0 12px}
  .pj-prop .acc{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}
  .pj-listas{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-top:16px}
  .pj-listas > div{border:1px solid var(--line);border-radius:12px;padding:13px 15px}
  .pj-listas h4{margin:0 0 8px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted-2)}
  .pj-listas ul{margin:0;padding-left:17px;font-size:12.5px;color:var(--muted);line-height:1.6}
  .pj-listas textarea{width:100%;background:var(--navy-900);border:1px solid var(--line);border-radius:9px;
    color:var(--text);font:inherit;font-size:12.5px;padding:8px 10px;resize:vertical}
  @media(max-width:820px){
    .pj-pl thead{display:none}
    .pj-pl,.pj-pl tbody,.pj-pl tr,.pj-pl td{display:block;width:100%}
    .pj-pl tr{border:1px solid var(--line);border-radius:11px;padding:8px;margin:0 0 10px}
    .pj-pl td{border:none;padding:2px 0}
    .pj-pl td::before{content:attr(data-l);display:block;font-size:9.5px;letter-spacing:.09em;
      text-transform:uppercase;color:var(--muted-2);font-weight:700;margin:4px 0 1px}
    .pj-pl input,.pj-pl textarea{border-color:var(--line)}
