  function fillBlogEditor(b){
    bgCur = b;
    $('bg-topic').value = b.topic || ''; $('bg-lang').value = b.lang || 'en';
    $('bg-title').value = b.title || ''; $('bg-slug').value = b.slug || ''; $('bg-desc').value = b.description || '';
    $('bg-hero').value = b.hero_image || '';
    $('bg-video').value = b.video_id || '';
    let html = '<span class="eyebrow">' + esc(b.eyebrow || 'Industry insight') + '</span><h1>' + esc(b.title || '') + '</h1>';
    html += '<p class="lead" id="bg-ed-lead" contenteditable="true" spellcheck="true">' + esc(b.lead || '') + '</p>';
    html += '<img id="bg-prevhero" src="' + esc(b.hero_image || '') + '" alt="" style="width:100%;border-radius:14px;margin:6px 0 18px;aspect-ratio:16/9;object-fit:cover' + (b.hero_image ? '' : ';display:none') + '" onerror="this.style.display=\'none\'" />';
    html += '<div class="post-body" id="bg-ed-body" contenteditable="true" spellcheck="true">' + blogPreviewHtml(b.body_html) + '</div>';
    html += '<div id="bg-prevvid" style="' + (b.video_id ? '' : 'display:none;') + 'position:relative;aspect-ratio:16/9;border-radius:14px;overflow:hidden;margin:18px 0">' + (b.video_id ? '<iframe src="https://player.vimeo.com/video/' + esc(b.video_id) + '?dnt=1" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;border:0" allowfullscreen></iframe>' : '') + '</div>';
    html += '<div id="bg-faqwrap"><h2 style="margin-top:24px;display:flex;align-items:center;gap:10px">FAQ <button class="btn btn-ghost small" id="bg-faq-add" type="button">➕ Pregunta</button></h2>' +
      (b.faq || []).map((f) => '<div class="bg-faq"><div class="q" contenteditable="true">' + esc(f.q) + '</div><div class="a" contenteditable="true">' + esc(f.a) + '</div><button class="bg-faq-x" type="button" title="Borrar pregunta">✕</button></div>').join('') + '</div>';
    html += '<p class="muted-note" style="margin-top:10px">✏️ TODO es editable: lead, cuerpo y FAQ (click y escribís). Imagen y video se cambian arriba y se ven acá. 💾 Guardar → 🌍 Propagar → 🚀 Publicar.</p>';
    $('bg-preview').innerHTML = html;
    const bindFaq = () => $('bg-preview').querySelectorAll('.bg-faq-x').forEach((x) => x.onclick = () => x.closest('.bg-faq').remove());
    bindFaq();
    $('bg-faq-add').addEventListener('click', () => {
      const d = document.createElement('div'); d.className = 'bg-faq';
      d.innerHTML = '<div class="q" contenteditable="true">Nueva pregunta…</div><div class="a" contenteditable="true">Respuesta…</div><button class="bg-faq-x" type="button">✕</button>';
      $('bg-faqwrap').appendChild(d); bindFaq(); d.querySelector('.q').focus();
    });
    $('bg-editing-lang').textContent = (LANGNAME[b.lang] || b.lang) + (b.status === 'published' ? ' · publicado' : ' · borrador');
    /* El botón decía siempre "Publicar en la web", así que para cambiar la foto de un
       artículo YA publicado no quedaba claro qué hacer — parecía que iba a crear un
       duplicado. No lo crea: publish-blog busca el sha del archivo en GitHub y lo
       reemplaza. Cambiar el texto es todo lo que faltaba para que se entienda.
       (Sebastián, 25 ago: "pero si publiqué una página y quiero cambiar foto o video,
       ¿cómo lo hago?".) */
    const pb = $('bg-publish');
    if (pb){
      pb.textContent = b.status === 'published' ? '🔄 Actualizar en la web' : '🚀 Publicar en la web';
      pb.title = b.status === 'published'
        ? 'Reemplaza el artículo que ya está publicado — misma URL, sin duplicados'
        : 'Lo sube por primera vez a viven.ch';
    }
    // tabs de idioma del grupo: cambiar de variante sin salir del editor; + = generar la que falta
    const sibs = blogsList.filter((x) => x.group_id && x.group_id === b.group_id);
    /* Cuando un idioma tiene DOS versiones (mellizas del motor), acá se muestran las dos
       y elegís vos. `find` devolvía la primera y por eso abrías siempre la misma —
       aunque la otra fuera la que editaste. Verificado el 25 ago: abrir DE traía la
       versión con UN video mientras la que Sebastián había editado tenía TRES.
       Se ordenan publicada primero y después por última edición, y cada una dice cuál
       es cuál. (Sebastián: "siempre lo que yo elijo".) */
    $('bg-versions').innerHTML = ['en', 'de', 'es'].map((l) => {
      const mismas = sibs.filter((x) => x.lang === l)
        .sort((x, y) => ((y.status === 'published') - (x.status === 'published'))
          || (Date.parse(y.updated_at || y.created_at || 0) - Date.parse(x.updated_at || x.created_at || 0)));
      if (!mismas.length) return '<button class="bl2-ltab miss" data-loc="' + l + '" data-id="' + esc(b.id) + '" type="button" title="Generar versión ' + LANGNAME[l] + ' (nativa, keywords locales)">+ ' + LANGNAME[l] + '</button>';
      return mismas.map((s, i) => {
        const cuando = s.updated_at ? new Date(s.updated_at).toLocaleDateString('es-CH', { day: '2-digit', month: 'short' }) : '';
        const sufijo = mismas.length > 1 ? ' · ' + (cuando || ('v' + (i + 1))) : '';
        const tit = LANGNAME[l] + (s.status === 'published' ? ' — publicado' : ' — borrador')
          + (mismas.length > 1 ? ' · una de ' + mismas.length + ' versiones en ' + LANGNAME[l] + ', editada el ' + (cuando || '?') : '');
        return '<button class="bl2-ltab' + (String(s.id) === String(b.id) ? ' on' : '') + (s.status === 'published' ? ' pub' : '')
          + (mismas.length > 1 ? ' dup' : '') + '" data-open="' + esc(s.id) + '" type="button" title="' + esc(tit) + '">'
          + LANGNAME[l] + sufijo + (s.status === 'published' ? ' ✓' : '') + '</button>';
      }).join('');
    }).join('');
    /* Cambiar de idioma guarda lo que estabas editando. Antes se perdía sin aviso:
       cambiabas la foto del alemán, tocabas "English" para ver cómo iba, y al volver
       la foto era la vieja otra vez. Nada avisaba porque nada fallaba — simplemente
       nunca se había guardado. */
    $('bg-versions').querySelectorAll('[data-open]').forEach((t) => t.addEventListener('click', async () => {
      if (String(t.dataset.open) === String(b.id)) return;
      if (bgCur && bgCur.id) await saveBlogEdits(true);
      loadBlog(t.dataset.open);
    }));
    $('bg-versions').querySelectorAll('[data-loc]').forEach((t) => t.addEventListener('click', () => localizeBlog(t.dataset.id, t.dataset.loc)));
    bl2RenderImgPick(); bl2RenderVidPick();
    $('bg-result').hidden = false; $('bg-pub-note').textContent = '';
  }
  function loadBlog(id, scroll){ const b = blogsList.find((x) => String(x.id) === String(id)); if (!b) return; fillBlogEditor(b);
    if (scroll) setTimeout(() => { const t = $('bg-editor-top'); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 60); }
  // vista previa editada → body_html canónico (los <a> internos vuelven a [[slug|anchor]])
  function bgCollectEdits(){
    const bodyEl = $('bg-ed-body'), leadEl = $('bg-ed-lead');
    if (!bodyEl || !bgCur) return null;
    let body = bodyEl.innerHTML
      .replace(/<a[^>]*href="https:\/\/www\.viven\.ch\/([^"]+?)\/?"[^>]*>([\s\S]*?)<\/a>/g, (m, sl, an) => '[[' + sl + '|' + an.replace(/<[^>]+>/g, '') + ']]')
      .replace(/\scontenteditable="true"|\sspellcheck="true"/g, '');
    const faq = [...$('bg-preview').querySelectorAll('.bg-faq')].map((d) => ({
      q: (d.querySelector('.q').textContent || '').trim(), a: (d.querySelector('.a').textContent || '').trim(),
    })).filter((f) => f.q && f.q !== 'Nueva pregunta…');
    return {
      title: $('bg-title').value.trim(), slug: $('bg-slug').value.trim(), description: $('bg-desc').value.trim(),
      lead: (leadEl.textContent || '').trim(), body_html: body, faq,
      hero_image: $('bg-hero').value.trim() || null, video_id: $('bg-video').value.trim() || null,
    };
  }
  async function saveBlogEdits(silent){
    const ed = bgCollectEdits(); if (!ed) return false;
    let { error } = await supabase.from('blogs').update(ed).eq('id', bgCur.id);
    if (error && /column/.test(error.message || '')){ const e2 = { ...ed }; delete e2.hero_image; delete e2.video_id; ({ error } = await supabase.from('blogs').update(e2).eq('id', bgCur.id)); }
    if (error){ toast('No se pudo guardar: ' + error.message); return false; }
    Object.assign(bgCur, ed);
    const i = blogsList.findIndex((x) => String(x.id) === String(bgCur.id)); if (i > -1) Object.assign(blogsList[i], ed);
    if (!silent) toast('💾 Correcciones guardadas');
    return true;
  }
  async function propagateBlog(){
    if (!bgCur) return;
    if (!(await saveBlogEdits(true))) return;
    const others = ['en', 'de', 'es'].filter((l) => l !== bgCur.lang);
    const btn = $('bg-prop'), prev = btn.textContent; btn.disabled = true;
    for (const l of others){
      btn.textContent = '🌍 Escribiendo ' + (LANGNAME[l] || l) + '…';
      $('bg-pub-note').textContent = 'Reescribiendo ' + (LANGNAME[l] || l) + ' fiel a tu versión corregida (keywords nativos)…';
      try {
        const { data, error } = await supabase.functions.invoke('ai-blog', { body: {
          topic: bgCur.topic || bgCur.title, lang: l, localize: true,
          source_title: bgCur.title, source_lead: bgCur.lead, source_html: bgCur.body_html, source_faq: bgCur.faq || [],
        } });
        if (error || !data || !data.body_html) throw new Error(data?.error || error?.message || 'sin respuesta');
        const sib = blogsList.find((x) => x.group_id === bgCur.group_id && x.lang === l);
        /* La foto y el video de cada idioma NO se pisan.
           Propagar reescribe el TEXTO desde el master, que es para lo que sirve. Pero
           antes también mandaba hero_image y video_id del master, así que si él había
           elegido una foto distinta para el alemán, propagar desde el inglés se la
           borraba — y las tres versiones terminaban con la misma imagen. Pasó de
           verdad el 25 ago con los tres posts de "Video SEO".
           Ahora: si el hermano ya tiene lo suyo, se respeta; solo se le pasa la del
           master cuando está vacío. */
        /* status SOLO para los que nacen acá. Antes iba 'draft' siempre, así que
           propagar sobre un idioma YA PUBLICADO lo devolvía a borrador en la base
           aunque siguiera al aire en la web. Efecto: la lista mostraba "falta el
           alemán" con el alemán publicado hace semanas. Comprobado el 25 ago con
           curl — cuatro artículos daban 200 y figuraban como borrador. Corregidos.
           (Sebastián: "¿por qué salen así? como si no tuviera todos los idiomas".)
           Ojo con lo que esto significa: propagar cambia el TEXTO de un idioma ya
           publicado, pero la web sigue mostrando el viejo hasta que se re-publique.
           Por eso la lista ahora marca "cambios sin publicar". */
        const row = { lang: l, topic: bgCur.topic, slug: data.slug, title: data.title, description: data.description, eyebrow: data.eyebrow, lead: data.lead, body_html: data.body_html, faq: data.faq || [], group_id: bgCur.group_id };
        if (!sib || sib.status !== 'published') row.status = 'draft';
        /* Y el slug de un idioma publicado NO se toca: cambiarlo deja el artículo
           viejo colgado en la web y rompe el link que ya está en Google. */
        else delete row.slug;
        if (!sib || !sib.hero_image) row.hero_image = bgCur.hero_image || null;
        if (!sib || !sib.video_id) row.video_id = bgCur.video_id || null;
        if (sib) { const { error: e2 } = await supabase.from('blogs').update(row).eq('id', sib.id); if (e2 && /column/.test(e2.message)) { delete row.hero_image; delete row.video_id; await supabase.from('blogs').update(row).eq('id', sib.id); } }
        else { const { error: e3 } = await supabase.from('blogs').insert(row); if (e3 && /column/.test(e3.message)) { delete row.hero_image; delete row.video_id; await supabase.from('blogs').insert(row); } }
        toast('✓ ' + (LANGNAME[l] || l) + ' actualizado desde el master');
      } catch (e) { toast('⚠️ ' + (LANGNAME[l] || l) + ': ' + (e.message || e)); }
    }
    btn.disabled = false; btn.textContent = prev;
    $('bg-pub-note').textContent = '🌍 Idiomas propagados desde tu versión corregida — revisalos y publicá cada uno.';
    await blogsLoad();
  }

  // genera un artículo (nuevo, o versión localizada si pasás groupId+localize) y lo guarda en blogs
  async function generateBlog(opts){
    opts = opts || {};
    const topic = (opts.topic || $('bg-topic').value).trim();
    const lang = opts.lang || $('bg-lang').value;
    if (!topic){ toast('Escribí un tema o keyword'); return; }
    const btn = opts.btn || $('bg-gen'), prev = btn.textContent; btn.disabled = true; btn.textContent = '✨ Escribiendo…';
    $('bg-note').textContent = 'La IA está escribiendo el artículo (' + (LANGNAME[lang] || lang) + ')…';
    try {
      const { data, error } = await supabase.functions.invoke('ai-blog', { body: { topic, lang, localize: !!opts.localize } });
      if (error || !data || !data.body_html) throw new Error(data?.error || error?.message || 'sin respuesta');
      const row = { lang, topic, slug: data.slug, title: data.title, description: data.description, eyebrow: data.eyebrow, lead: data.lead, body_html: data.body_html, faq: data.faq || [], status: 'draft' };
      if (opts.groupId) row.group_id = opts.groupId;
      const ins = await supabase.from('blogs').insert(row).select().single();
      if (ins.error) throw new Error('generado, pero no se pudo guardar (¿SQL 0009?): ' + ins.error.message);
      await blogsLoad();
      fillBlogEditor(ins.data);
      $('bg-note').textContent = '✨ Listo — guardado en la lista. Revisá, editá y publicá.';
    } catch (e) { $('bg-note').textContent = 'No se pudo generar (¿deployaste ai-blog + crédito Anthropic?): ' + e.message; }
    finally { btn.disabled = false; btn.textContent = prev; }
  }
  function localizeBlog(id, targetLang){
