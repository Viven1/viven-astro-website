  // orden de la tabla de Personas: click en el encabezado alterna ↑/↓
  let psSort = { k: 'created', dir: -1 }, psStage = 'all', psAct = 'all';
  function leadsListHTML(rows){
    if (!rows.length) return '<p class="muted-note" style="padding:14px">Sin personas que coincidan con la búsqueda o el filtro.</p>';
    const stageIdx = (r) => STAGES.findIndex((s) => s.key === stageOf(r.status));
    const actMap = new Map(rows.map((r) => [r.id, lastActivity(r)]));
    const scMap = new Map(rows.map((r) => [r.id, leadScore(r)]));
    // valor VISIBLE en la tabla: lo que hay/hubo sobre la mesa — regla única primero,
    // y si da 0 pero hay ofertas ligadas (ej. perdidas), mostrar ese valor igual.
    const rowVal = (r) => leadValue(r) || leadLostValue(r);
    const CMP = {
      name:    (a, b) => String(a.name || a.email || '').localeCompare(String(b.name || b.email || '')),
      email:   (a, b) => String(a.email || '').localeCompare(String(b.email || '')),
      company: (a, b) => String(companyName(leadDomain(a)) || a.company || '').localeCompare(String(companyName(leadDomain(b)) || b.company || '')),
      stage:   (a, b) => stageIdx(a) - stageIdx(b),
      value:   (a, b) => rowVal(a) - rowVal(b),
      channel: (a, b) => String(a.channel || '').localeCompare(String(b.channel || '')),
      score:   (a, b) => (scMap.get(a.id) || {}).score - (scMap.get(b.id) || {}).score,
      activity: (a, b) => ((actMap.get(a.id) || {}).t || 0) - ((actMap.get(b.id) || {}).t || 0),
      created: (a, b) => new Date(a.created_at) - new Date(b.created_at)
    };
    const sorted = rows.slice().sort((a, b) => (CMP[psSort.k] || CMP.created)(a, b) * psSort.dir);
    const AV_COLORS = ['#8ab4ff', '#c58af9', '#7ed957', '#f0c060', '#ff8b5e', '#5ec7d1', '#e08ac5'];
    const avColor = (n) => { let h = 0; const x = String(n || '?'); for (let i = 0; i < x.length; i++) h = (h * 31 + x.charCodeAt(i)) >>> 0; return AV_COLORS[h % AV_COLORS.length]; };
    const body = sorted.map((r) => {
      const s = STAGES.find((x) => x.key === stageOf(r.status)) || STAGES[0];
      const val = rowVal(r);
      const act = actMap.get(r.id);
      const isNl = String(r.message || '') === 'Newsletter signup';   // leads.source no existe — el origen vive en message (igual que 'CALCULADORA')
      const nm = r.name || r.first_name || (isNl && r.email) || '(sin nombre)';
      const ini = (nm[0] || '?').toUpperCase();
      const dom = leadDomain(r);
      const co = (dom && companyName(dom)) || r.company || '';
      const nd = dealsForLead(r.id).length;
      return '<tr data-id="' + esc(r.id) + '">' +
        '<td class="lt-chk"><input type="checkbox" class="ps-row-chk" data-id="' + esc(r.id) + '"' + (psSelected.has(String(r.id)) ? ' checked' : '') + ' onclick="event.stopPropagation()" /></td>' +
        '<td><div class="lt-person"><span class="lt-av" style="background:' + avColor(nm) + '">' + esc(ini) + '</span><div><div class="lt-name">' + esc(nm) + (isNl ? ' <span class="lt-nl">📰 Newsletter</span>' : '') + '</div>' + (r.job_title ? '<div class="lt-sub">' + esc(r.job_title) + '</div>' : '') + '</div></div></td>' +
        '<td class="lt-mail2">' + (r.email ? '<a href="mailto:' + esc(r.email) + '" onclick="event.stopPropagation()">' + esc(r.email) + '</a>' : '—') + '</td>' +
        '<td class="lt-ph">' + esc(r.phone || '—') + '</td>' +
        '<td>' + esc(co || '—') + '</td>' +
        '<td><span class="lt-pill" style="color:' + s.color + ';background:color-mix(in srgb,' + s.color + ' 14%,transparent);border-color:color-mix(in srgb,' + s.color + ' 40%,transparent)">' + s.label + '</span>' + (nd > 1 ? ' <span class="lt-nd" title="' + nd + ' proyectos">×' + nd + '</span>' : '') + '</td>' +
        (function(){ const sc = scMap.get(r.id) || { score: 0, tier: { t: '', c: 'var(--muted)' }, factors: [] }; return '<td><span class="lt-score" style="color:' + sc.tier.c + ';border-color:' + sc.tier.c + '" title="AI lead score ' + sc.score + '/100\n' + esc(sc.factors.join('\n')) + '">' + (sc.tier.t === 'Hot' ? '🔥 ' : '') + sc.score + '</span></td>'; })() +
        '<td class="lt-val">' + (val ? fmtChf(val) : '<span class="lt-num">—</span>') + '</td>' +
        '<td class="lt-act">' + esc(actLabel(act)) + '</td>' +
        '<td class="lt-num">' + new Date(r.created_at).toLocaleDateString('es-CH', { day: '2-digit', month: 'short', year: '2-digit' }) + '</td></tr>';
    }).join('');
    const TH = (k, l) => '<th data-k="' + k + '" class="lt-sort' + (psSort.k === k ? ' on' : '') + '" title="Ordenar por ' + l.toLowerCase() + '">' + l + (psSort.k === k ? (psSort.dir === 1 ? ' ↑' : ' ↓') : '') + '</th>';
    const allChecked = sorted.length > 0 && sorted.every((r) => psSelected.has(String(r.id)));
    return '<div class="lead-table-wrap lead-table-hs"><table class="lead-table"><thead><tr>' +
      '<th class="lt-chk"><input type="checkbox" id="ps-chk-all"' + (allChecked ? ' checked' : '') + ' title="Seleccionar todos los visibles" /></th>' +
      TH('name', 'Persona') + TH('email', 'Email') + '<th>Teléfono</th>' + TH('company', 'Empresa') + TH('stage', 'Etapa') + TH('score', 'Score') + TH('value', 'Valor') + TH('activity', 'Última actividad') + TH('created', 'Creado') +
      '</tr></thead><tbody>' + body + '</tbody></table></div>';
  }
  // Personas: selección múltiple para borrar en batch
