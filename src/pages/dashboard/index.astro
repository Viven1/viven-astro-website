  $('psf-save').addEventListener('click', async () => {
    const first = $('psf-first').value.trim(), email = $('psf-email').value.trim().toLowerCase();
    if (!first || !email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){ toast('Nombre y email válido son obligatorios'); return; }
    if ((allLeads || []).some((l) => String(l.email || '').toLowerCase() === email)){ toast('Ya existe una persona con ese email'); return; }
    const last = $('psf-last').value.trim();
    // empresa: conectar o crear (mismo criterio que en editar lead)
    let company = null, company_domain = null;
    const coText = $('psf-company').value.trim();
    if (coText){
      const res = resolveCompany(coText, email);
      company = res.name; company_domain = res.domain;
      if (!res.existing || !coMeta[res.domain]){
        const { data: co } = await supabase.from('companies').upsert({ domain: res.domain, name: res.name }, { onConflict: 'domain' }).select().single();
        if (co) coMeta[res.domain] = co;
      }
    }
    const row = { name: (first + ' ' + last).trim(), first_name: first, last_name: last || null, email, phone: $('psf-phone').value.trim() || null,
      company, company_domain, job_title: $('psf-job').value.trim() || null, lang: $('psf-lang').value, status: 'new', channel: 'manual', message: $('psf-msg').value.trim() || null };
    try {
      const res = await sbWriteRowsResilient('leads', [row], null);
      const created = res.rows[0];
      if (created && !allLeads.some((l) => l.id === created.id)) allLeads.unshift(created);
      ['psf-first', 'psf-last', 'psf-email', 'psf-phone', 'psf-company', 'psf-job', 'psf-msg'].forEach((id) => { $(id).value = ''; });
      $('ps-form').hidden = true;
      renderLeads();
      toast('✅ Persona creada' + (res.stripped.length ? ' (columnas sin guardar: ' + res.stripped.join(', ') + ' — corré el SQL)' : ''));
      if (created) openLead(created.id);
    } catch (err){ toast('No se pudo crear: ' + err.message); }
  });

