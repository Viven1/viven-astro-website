        // sin id no hay tracking ni auto-estado server-side: comportamiento de siempre + aviso para la próxima
        toast('📨 Enviada a ' + to + ' — 💡 guardá la oferta antes de enviar para tener tracking de apertura');
        if (ofCur.status === 'draft'){ ofCur.status = 'sent'; $('of-status').value = 'sent'; renderOf3Status(); }
      }
    });
  }

  function bindOffers(){
