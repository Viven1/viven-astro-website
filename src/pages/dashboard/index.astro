  /* ---------- 📤 Para mandar: borradores esperando el ok ----------
     Reusa la bandeja de salida que ya existe (tabla outbox) y su camino de
     envío: aprobar deja status='approved' con 10 minutos de ventana, y
     automations-run lo manda pasada la ventana. NO hay un segundo camino de
     envío — un email que sale por dos lados distintos es un email que algún día
     sale dos veces. */
  let sqRows = [];
  async function sqLoad(){
    const { data, error } = await supabase.from('outbox')
      .select('id,lead_id,subject,body,sender,kind,created_at')
      .eq('status', 'pending').order('created_at', { ascending: true }).limit(12);
    sqRows = error ? [] : (data || []);
    sqRender();
  }
  function sqRender(){
    const card = $('sq-card'), list = $('sq-list'); if (!card || !list) return;
    card.hidden = false;                                  // el botón de escribir vive acá aunque no haya nada
    $('sq-n').textContent = sqRows.length || '';
    if (!sqRows.length){
      list.innerHTML = '<p class="muted-note" style="margin:0">Ningún borrador esperando. Escribí el próximo con el botón de abajo.</p>';
      $('sq-note').textContent = '';
      return;
    }
    list.innerHTML = sqRows.map((o) => {
      const l = leadById(o.lead_id) || {};
      const quien = l.name || l.company || l.email || ('lead ' + o.lead_id);
      const cuerpo = String(o.body || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
      return '<div class="hm-item" style="cursor:default;align-items:flex-start">' +
        '<span class="ic">✉️</span>' +
        '<span class="tx">' +
          '<b>' + esc(quien) + '</b>' +
          '<small class="sq-subj">' + esc(o.subject || '(sin asunto)') + '</small>' +
          '<small class="sq-body">' + esc(cuerpo.slice(0, 180)) + (cuerpo.length > 180 ? '…' : '') + '</small>' +
        '</span>' +
        '<span class="wq-acts">' +
          '<button class="wq-b ok" data-sq-ok="' + o.id + '" type="button" title="Aprobar y enviar">✓</button>' +
          '<button class="wq-b" data-sq-ed="' + o.id + '" type="button" title="Editar en la Bandeja">✎</button>' +
          '<button class="wq-b" data-sq-no="' + o.id + '" type="button" title="No enviar">✕</button>' +
        '</span></div>';
    }).join('');
    $('sq-note').textContent = 'Al aprobar quedan 10 minutos para deshacerlo antes de que salga.';
    list.querySelectorAll('[data-sq-ok]').forEach((b) => b.addEventListener('click', async () => {
      const o = sqRows.find((x) => String(x.id) === b.dataset.sqOk); if (!o) return;
      const l = leadById(o.lead_id) || {};
      if (!confirm('¿Aprobar este email para ' + (l.name || l.email || 'este contacto') + '?\n\nAsunto: ' + (o.subject || '') + '\n\nSale en 10 minutos — hasta entonces se puede deshacer desde la Bandeja.')) return;
      const { error } = await supabase.from('outbox').update({ status: 'approved', scheduled_at: obUndoSched(o.id) }).eq('id', o.id);
      if (error){ toast('No se pudo aprobar: ' + error.message); return; }
      toast('✅ Aprobado — sale en 10 minutos'); sqLoad();
    }));
    list.querySelectorAll('[data-sq-ed]').forEach((b) => b.addEventListener('click', () => {
      gotoTab('sistema'); sistemaSetSub('auto'); obFocus(b.dataset.sqEd);
    }));
    list.querySelectorAll('[data-sq-no]').forEach((b) => b.addEventListener('click', async () => {
      await supabase.from('outbox').update({ status: 'discarded' }).eq('id', b.dataset.sqNo);
      toast('✕ No se envía'); sqLoad();
    }));
  }
  /* Escribir el próximo: agarra a la persona más urgente de "Para hoy" que
     todavía no tenga borrador, le escribe el email con la IA (leyendo su
     conversación real) y lo deja acá para aprobar. Nunca manda solo. */
  async function sqWriteNext(){
    const btn = $('sq-write'); if (!btn || btn.disabled) return;
    const conBorrador = new Set(sqRows.map((o) => String(o.lead_id)));
    const cand = hmTodayItems().map((i) => i.leadId).filter(Boolean)
      .find((id) => !conBorrador.has(String(id)));
    if (!cand){ toast('No hay nadie pendiente sin borrador'); return; }
    const r = leadById(cand);
    if (!r || !r.email){ toast('Ese contacto no tiene email'); return; }
    btn.disabled = true; btn.textContent = '✍️ Escribiendo a ' + (r.name || r.email) + '…';
    try {
      const { data: hist } = await supabase.from('email_log').select('direction,subject,body').eq('lead_id', String(r.id)).order('created_at', { ascending: false }).limit(8);
      const history = (hist || []).map((h) => ({ direction: h.direction, subject: h.subject, body: String(h.body || '').replace(/<[^>]+>/g, ' ').slice(0, 800) }));
      /* lead ACOTADO: mandar la fila entera arrastra el enrichment de la IA y
         otros campos largos, y el modelo devolvía texto suelto en vez del JSON
         ("formato inesperado", visto al probarlo). Con los campos que la
         función realmente usa, contesta bien. */
      const magro = { id: r.id, name: r.name, first_name: r.first_name, email: r.email, company: r.company,
        status: r.status, channel: r.channel, lang: r.lang, message: String(r.message || '').slice(0, 1500) };
      const { data, error } = await supabase.functions.invoke('ai-email-draft', { body: { lead: magro, sender, hint: '', history, brief: '' } });
      if (error || !data || data.error || !data.body) throw new Error(data?.error || error?.message || 'sin respuesta');
      const { error: e2 } = await supabase.from('outbox').insert({
        lead_id: r.id, kind: 'followup', sender, subject: data.subject || '', body: data.body, status: 'pending' });
      if (e2) throw new Error(e2.message);
      toast('✍️ Borrador listo para ' + (r.name || r.email));
      await sqLoad();
    } catch (e) { toast('No se pudo escribir: ' + (e.message || e)); }
    finally { btn.disabled = false; btn.textContent = '✍️ Escribir el próximo'; }
  }

  /* ---------- 🌐 Oportunidades de la web ----------
     El CRM dice a quién escribirle hoy; esto dice qué construir para que mañana
     haya más a quién escribirle. Sale de la demanda REAL del sitio
     (rpc_demanda_28d, SQL 0125: personas por tema y cuántos leads dejó cada uno)
     cruzada con lo que ya existe: un solo lead magnet, los posts publicados.

     La demanda se agrega en Postgres a propósito: son 7.640 pageviews en 28
     días y PostgREST devuelve como mucho 1000 filas SIN avisar — contarlas en el
     navegador daba el 13% del mes y parecía el mes entero. */
  const HM_OP_LS = 'viven_hm_op_v1';
  let hmDem = null, hmOpTried = false;
