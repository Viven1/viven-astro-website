      <div class="of-summary">
        <div class="of-sum-row"><span>Descuento <input id="of-disc" type="number" step="0.5" min="0" max="50" value="0" style="width:56px"/>%</span><b id="of-discamt" style="color:#f0c060">CHF 0.00</b></div>
        <div class="of-sum-row"><span>Total neto</span><b id="of-net">CHF 0.00</b></div>
        <div class="of-sum-row"><span>IVA <input id="of-vat" type="number" step="0.1" value="8.1" style="width:56px"/>%</span><b id="of-vatamt">CHF 0.00</b></div>
        <div class="of-sum-row total"><span>Total bruto</span><b id="of-gross">CHF 0.00</b></div>
        <hr/>
        <div class="of-sum-row int"><span>Costo interno (breakeven)</span><b id="of-cost">CHF 0.00</b></div>
        <div class="of-sum-row int"><span>Ganancia (neto − costo)</span><b id="of-profit" class="pos">CHF 0.00</b></div>
        <div class="of-sum-row int"><span>Margen</span><b id="of-marginpct" class="pos">0%</b></div>
        <div class="of-bep" id="of-bep"></div>
      </div>
      </div>

      <!-- ③ CONDICIONES -->
      <div id="of3-sec-3" hidden>
      <div class="of-meta">
        <div class="bf"><label>Válida hasta <span class="count" style="font-weight:400">(default: +30 días)</span></label><input id="of3-valid" type="date" /></div>
        <div class="bf"><label>Idioma de la oferta <span class="count" style="font-weight:400">(PDF + email)</span></label><select id="of3-lang"><option value="de">🇩🇪 DE</option><option value="en">🇬🇧 EN</option><option value="es">🇪🇸 ES</option></select></div>
      </div>
      <div class="bf" style="margin-bottom:14px"><label style="display:block;font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:6px">Texto personal — intro <span style="font-weight:400">(sale arriba de las posiciones, en el PDF y el email; la IA lo redacta desde el brief)</span></label><textarea id="of3-intro" class="ed-inp" style="min-height:90px" placeholder="Nos encantaría hacer este proyecto con ustedes…"></textarea></div>
      <div class="bf" style="margin-bottom:14px"><label style="display:block;font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:6px">Texto personal — cierre <span style="font-weight:400">(sale al final, antes del pie legal)</span></label><textarea id="of3-closing" class="ed-inp" style="min-height:70px" placeholder="¿Preguntas sobre el alcance o el precio? Escribinos o llamanos…"></textarea></div>
      <!-- términos y condiciones especiales (salen en el PDF y en el email) -->
      <div class="of-terms-box">
        <div class="pp-sec-h">Términos y condiciones especiales <span class="count">(pagos, cancelación, duración del shooting — editá a mano)</span></div>
        <textarea id="of-terms" class="ed-inp" style="min-height:130px"></textarea>
      </div>
      </div>

      <!-- ④ ENVIAR -->
      <div id="of3-sec-4" hidden>
        <div class="of3-send" id="of3-send-panel"></div>
      </div>
    </div>

    <!-- EDITOR DE PROPUESTA — sin cambios (lista de arriba ya es la unificada) -->
    <div id="pp-editor" hidden>
      <div class="of-bar">
        <button class="btn btn-ghost small" id="pp-back" type="button">← Volver</button>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
