  /* ---- bl2: pageviews del blog (30d) para KPIs + columna Visitas ---- */
  let bl2Views = null, bl2ViewsAt = 0, bl2ViewsBusy = false;
  // filtro por tipo de video en el historial del blog — pedido explícito:
  // "el blog no tiene filtros para entender que tipos de blogs tenemos, sino
  // tienen que leer todo y nadie lo hará". category viene de blogs.category
  // (SQL 0087), la MISMA clasificación que ya usa content-engine para elegir
