  }
  $('bx-x') && $('bx-x').addEventListener('click', bxCerrar);
  $('bx-go') && $('bx-go').addEventListener('click', bxCrear);
  /* Cerrar tocando afuera: ahora hay DOS afueras — el relleno del envoltorio fijo y el
