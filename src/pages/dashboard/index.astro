  const PJ_BRIEF_MAIL = {
    en: { s: 'A few questions before we start',
          p: 'Before we write anything, twelve questions decide what the film actually is. They live in your project portal — answer them at your own pace, they save as you go, and you can invite whoever knows the answers.' },
    de: { s: 'Ein paar Fragen, bevor wir starten',
