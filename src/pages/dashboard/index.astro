        if (!t.offsetParent && t.style.display !== 'block') return;
        t.style.height = 'auto'; t.style.height = (t.scrollHeight + 2) + 'px';
      };
      if (!t.dataset.fit){ t.dataset.fit = '1'; t.addEventListener('input', fit); }
      fit();
    });
