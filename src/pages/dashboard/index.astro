        '<div class="of-actions"><button class="of-act" data-auact="toggle" data-id="' + a.id + '" type="button">' + (a.enabled ? '⏸ Pausar' : '▶️ Activar') + '</button></div></div>';
    }).join('') || '<p class="muted-note">Sin workflows todavía — creá uno o cloná una plantilla.</p>';
