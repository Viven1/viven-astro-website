  // content_followup guarda el body como HTML de email ya armado — envuelve
  // en un mini-shell para que el iframe de preview se vea como el email real
  // (fondo blanco, tipografía legible) en vez del fondo oscuro del dashboard.
  function obPreviewShell(bodyHtml){
    return '<!doctype html><html><head><meta charset="utf-8"><style>body{margin:0;background:#fff;color:#222;font-family:Helvetica,Arial,sans-serif;padding:18px}</style></head><body>' + bodyHtml + '</body></html>';
  }
  function obHtmlToPreviewText(html){
    return String(html || '')
      .replace(/<(p|tr|table|div|br)[^>]*>/gi, '\n')
      .replace(/<[^>]+>/g, '')
      .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
      .replace(/[ \t]+/g, ' ').replace(/\n{2,}/g, '\n').trim();
  }
  // reasignar .srcdoc a un iframe que YA navegó una vez no siempre vuelve a
  // renderizar (probado: queda en blanco tras el primer set) — reemplazar el
  // nodo entero fuerza una navegación nueva cada vez, de forma confiable.
  function obSetPreview(frame, bodyHtml){
    const fresh = document.createElement('iframe');
    fresh.className = frame.className;
    fresh.setAttribute('sandbox', '');
    fresh.hidden = frame.hidden;
    fresh.srcdoc = obPreviewShell(bodyHtml);
    frame.replaceWith(fresh);
    return fresh;
  }
  let obAprCache = [], obUndoSched = () => new Date(Date.now() + 10 * 60e3).toISOString();
  /* ---- Cuándo sale, dicho completo ----
     "el 20 ago" o "en el próximo ciclo" no contestan la pregunta que se hace
     Sebastián cuando aprueba: a qué hora sale esto. Todo en hora de ZÚRICH, que
     es la que manda el envío, no la del teléfono de quien mira.
     El horario de envío (Lu-Vi 09-12 y 13:30-17) lo aplica automations-run; acá
     SOLO se avisa cuando la fecha cae afuera — no se calcula una hora nueva, para
     no terminar con dos motores diciendo cosas distintas. Si allá cambia la
     ventana, lo único que queda viejo acá es el aviso, nunca una fecha. */
  const ZH = { timeZone: 'Europe/Zurich' };
  function obEnHorarioSuizo(d){
    const p = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Zurich', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(d);
    const g = (t) => (p.find((x) => x.type === t) || {}).value || '';
    if (['Sat', 'Sun'].includes(g('weekday'))) return false;
    const m = (+g('hour')) * 60 + (+g('minute'));
    return (m >= 9 * 60 && m < 12 * 60) || (m >= 13 * 60 + 30 && m < 17 * 60);
  }
  function obFechaHora(d){
    const hoy = new Date().toLocaleDateString('en-CA', ZH) === d.toLocaleDateString('en-CA', ZH);
    const dia = d.toLocaleDateString('es-CH', { timeZone: 'Europe/Zurich', weekday: 'short' }).replace('.', '');
    const dm = d.toLocaleDateString('en-GB', { timeZone: 'Europe/Zurich', day: '2-digit', month: '2-digit' });
    const hh = d.toLocaleTimeString('es-CH', { timeZone: 'Europe/Zurich', hour: '2-digit', minute: '2-digit' });
    // el "el" va acá adentro: "sale el hoy a las 14:05" no lo dice nadie
    return (hoy ? 'hoy' : 'el ' + dia + ' ' + dm) + ' a las ' + hh;
  }
  function obCuandoSaleTxt(iso){
    // sin scheduled_at NO es "sin fecha": automations-run lo trata como "mandalo
    // apenas esté aprobado" (.or(scheduled_at.is.null,...)). Decir "sin fecha"
    // se leería como "no está programado" y es justo al revés.
    if (!iso) return 'sale en la próxima corrida en horario de envío';
    const d = new Date(iso);
    if (d <= new Date()) return 'ya cumplió su fecha: sale en la próxima corrida en horario de envío';
    return 'sale ' + obFechaHora(d) + ' (Zúrich)' +
      (obEnHorarioSuizo(d) ? '' : ' — cae fuera del horario de envío (Lu-Vi 09–12 y 13:30–17), así que sale en la primera ventana siguiente');
  }
  function obPorSalirHTML(rows){
    if (!rows.length) return '';
    return '<div style="border:1px solid color-mix(in srgb,var(--acid) 45%,transparent);border-radius:12px;padding:12px 16px;margin-bottom:14px">' +
      '<div style="font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--acid);font-weight:700;margin-bottom:8px">🕐 Por salir — todavía podés deshacer</div>' +
