  .side-group.collapsed .side-group-items{display:none}
  .side-item{display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:none;border:0;color:var(--muted);font-family:inherit;font-size:14px;font-weight:500;padding:9px 11px;border-radius:10px;cursor:pointer;transition:background .12s,color .12s}
  .side-item:hover{background:var(--navy-800);color:var(--text)}
