    finally { btn.disabled = false; }
  });
  $('rm-goal-inp').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('rm-goal-save').click(); });

  /* ---------- 🤖 Cola de "aprobado, falta hacerlo" (tabla work_queue — SQL 0124) ----------
     Sebastián, 14 ago 2026: aprobar una idea de CRO no hacía nada — escribía una
     marca en un jsonb y mostraba un cartel. "Hacelo y hacé que funcione bien o no
     sirve para nada". Esto es el lugar que hay que vaciar: lo aprobado queda acá,
     con los días de espera a la vista, hasta que alguien lo marca hecho. Sirve
     igual para las ideas de CRO y para las acciones sobre un cliente. */
  let wqRows = [];
  const wqDias = (iso) => Math.floor((Date.now() - new Date(iso).getTime()) / 864e5);
  const wqEspera = (iso) => { const d = wqDias(iso); return d <= 0 ? 'hoy' : d === 1 ? 'hace 1 día' : 'hace ' + d + ' días'; };

  async function wqLoad(){
    const { data, error } = await supabase.from('work_queue')
      .select('id,source,ref,title,detail,url,status,approved_at')
      .in('status', ['pending', 'doing']).order('approved_at', { ascending: true });
    if (error){ wqRows = []; wqRender(); return; }   // tabla sin crear todavía: el panel no molesta
    wqRows = data || [];
    wqRender();
  }
  function wqRender(){
    const card = $('wq-card'), list = $('wq-list'); if (!card || !list) return;
    card.hidden = wqRows.length === 0;
    $('wq-n').textContent = wqRows.length || '';
    // mismas clases que el resto de las listas de Hoy (.ic/.tx/.go): una fila
    // aprobada tiene que verse igual que cualquier otra cosa pendiente
    const ICONO = { cro: '🧪', accion: '📣', manual: '📌' };
    list.innerHTML = wqRows.map((r) => {
      const dias = wqDias(r.approved_at);
      return '<div class="hm-item' + (dias >= 7 ? ' ambar' : '') + '" style="cursor:default">' +
        '<span class="ic">' + (ICONO[r.source] || '📌') + '</span>' +
        '<span class="tx"><b>' + esc(r.title || '') + '</b>' +
          (r.detail ? '<small class="wq-det">' + esc(String(r.detail).slice(0, 160)) + '</small>' : '') +
          // la espera va en su propia línea: es el dato del panel y no puede
          // quedar cortada por el recorte del detalle
          '<small class="wq-age">aprobado ' + wqEspera(r.approved_at) + (r.status === 'doing' ? ' · en curso' : '') + '</small>' +
        '</span>' +
        '<span class="wq-acts">' +
          // el ↗ solo si lleva a otro lado: un botón que te deja donde ya estás
          // parece roto (reportado el 14 ago sobre las oportunidades de la web)
          (r.url && !/^\/dashboard\/\?tab=hoy$/.test(r.url) ? '<button class="wq-b" data-wq-ir="' + r.id + '" type="button" title="Ver dónde">↗</button>' : '') +
          '<button class="wq-b ok" data-wq-done="' + r.id + '" type="button" title="Marcar como hecho">✓</button>' +
          '<button class="wq-b" data-wq-cancel="' + r.id + '" type="button" title="Ya no hace falta">✕</button>' +
        '</span></div>';
    }).join('');
    const masViejo = wqRows.length ? wqDias(wqRows[0].approved_at) : 0;
    $('wq-note').textContent = wqRows.length
      ? (masViejo >= 7 ? '⚠️ Lo más viejo espera hace ' + masViejo + ' días.' : 'Se vacía a medida que se hacen.')
      : '';
    list.querySelectorAll('[data-wq-ir]').forEach((b) => b.addEventListener('click', () => {
      const r = wqRows.find((x) => String(x.id) === b.dataset.wqIr); if (r && r.url) location.href = r.url;
    }));
    list.querySelectorAll('[data-wq-done]').forEach((b) => b.addEventListener('click', () => wqSet(b.dataset.wqDone, 'done')));
    list.querySelectorAll('[data-wq-cancel]').forEach((b) => b.addEventListener('click', () => wqSet(b.dataset.wqCancel, 'cancelled')));
  }
  /* Encolar. El índice único (source, ref) con status pendiente hace que aprobar
     dos veces lo mismo —o un tap repetido en el teléfono— no cree dos pendientes. */
  async function wqAdd(item){
    /* Si eso mismo ya pasó por la cola —hecho o cancelado— NO vuelve a entrar.
       Sin esto, el backfill de CRO revivía cada idea ya resuelta en cuanto se
       abría el tab: la cola se llenaba sola de trabajo terminado. El índice
       único de la base solo cubre lo pendiente, así que el filtro va acá. */
    if (item.ref){
      const { data: previa } = await supabase.from('work_queue').select('id')
        .eq('source', item.source || 'manual').eq('ref', item.ref).limit(1);
      if (previa && previa.length) return false;
    }
    const fila = { source: item.source || 'manual', ref: item.ref || null, title: item.title || '(sin título)',
      detail: item.detail || null, url: item.url || null, status: 'pending', approved_by: meEmail || null };
    // el backfill sabe desde cuándo espera de verdad: sin esto todo lo viejo
    // aparecía como "aprobado hoy", que es justo lo que hay que poder ver
    if (item.approved_at) fila.approved_at = item.approved_at;
    const { error } = await supabase.from('work_queue').insert(fila);
    if (error && !/duplicate key|unique/i.test(error.message || '')){ toast('No se pudo encolar: ' + error.message); return false; }
    await wqLoad();
    return true;
  }
  async function wqCancelRef(source, ref){
    await supabase.from('work_queue').update({ status: 'cancelled' })
      .eq('source', source).eq('ref', ref).in('status', ['pending', 'doing']);
    await wqLoad();
  }
  async function wqSet(id, status, nota){
    const r = wqRows.find((x) => String(x.id) === String(id));
    const patch = { status };
    if (status === 'done'){ patch.done_at = new Date().toISOString(); if (nota) patch.done_note = nota; }
    const { error } = await supabase.from('work_queue').update(patch).eq('id', id);
    if (error){ toast('No se pudo actualizar: ' + error.message); return; }
    /* Cerrar el círculo del lado del CRO: si no se marca la idea en su propio
       jsonb, la tarjeta sigue diciendo "🤖 Aprobada" para siempre y el estado
       queda contradiciendo a la cola. */
    if (r && r.source === 'cro' && r.ref) await croMarcarIdea(r.ref, status === 'done' ? 'done' : null);
    // avisar al equipo que se hizo: el que aprobó no tiene que venir a preguntar
    if (status === 'done' && r) pushTo(null, '✅ Hecho: ' + (r.title || '').slice(0, 60), 'Lo aprobado ya está resuelto.', '/dashboard/?tab=auto');
    toast(status === 'done' ? '✅ Marcado como hecho' : 'Sacado de la cola');
    await wqLoad();
  }

  /* Cada KPI de Hoy abre lo que lo produjo. Se engancha UNA sola vez —los KPI son HTML
     fijo, no se redibujan— y con delegación, así no importa si algo los repinta.
     «Ganado» lleva a los deals ganados; el KPI cuenta el mes y la lista los muestra todos,
     con los últimos primero: acotar la lista a 30 días escondería el resto sin decirlo, y
     un filtro que el usuario no pidió es peor que uno de más. */
  let hkBound = false;
  function hkEnganchar(){
    if (hkBound) return; hkBound = true;
    const ir = (k) => {
      if (k === 'ganado' || k === 'winrate'){
        dlListStage = k === 'ganado' ? 'ganado' : 'perdido';
        dlSort = 'recent';
        gotoTab('deals');
        setDealsView('lista');
        if (k === 'winrate') toast('Perdidos. Tocá «Ganados» arriba para el otro lado del win rate.');
      } else if (k === 'visitas'){ gotoTab('analytics'); anaSetSub && anaSetSub('web'); }
      else if (k === 'roas'){ gotoTab('analytics'); anaSetSub && anaSetSub('gads'); }
    };
    document.addEventListener('click', (e) => {
      const el = e.target && e.target.closest && e.target.closest('.hk-go[data-hk]');
      if (el) ir(el.dataset.hk);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const el = e.target && e.target.closest && e.target.closest('.hk-go[data-hk]');
      if (el){ e.preventDefault(); ir(el.dataset.hk); }
    });
  }

  function renderHome(){
    hkEnganchar();
    const now = Date.now(), D = 864e5;
    /* --- KPIs --- */
    const k = hmDealKpis();
    /* Acá había tres escrituras a tarjetas que se mudaron al bloque de arriba hace
       tiempo: los ids ya no existen en ninguna parte y el `if` nunca era verdadero.
       Se borran en vez de dejarlas "por las dudas" — código que no puede correr esconde
       al que sí, y hace que un chequeo de referencias huérfanas se llene de ruido y se
       ignore. (26 ago 2026, al escribir scripts/check-dashboard.mjs.) */

    /* Esta tarjeta decía "Ganado (30 días): CHF 22'358" justo al lado del panel que
       dice "Cerrado este mes: CHF 0". Las dos eran ciertas —los 30 días agarran julio—
       pero puestas una al lado de la otra se contradicen a la vista, y encima la
       flecha decía "▲ nuevo" por un cierre de julio. Sebastián ya lo había pedido
       para el Ritmo del mes: lo que importa es el MES, porque es lo que hay que
       pagar del 1 al último. Ahora las dos hablan del mismo período.
       (Captura del 25/08.) */
    $('hm-won30').textContent = fmtChf(k.wonMesVal != null ? k.wonMesVal : k.won30Val);
    $('hm-won30-l').textContent = 'Ganado (' + new Date().toLocaleDateString('es-CH', { month: 'long' }) + ')';
    if (k.wonMesVal != null){
      setDelta('hm-won30-d', k.wonMesVal, k.wonMesPrevVal || 0);
      $('hm-won30-t').textContent = k.wonMesPrevVal
        ? 'el mes pasado: ' + fmtChf(k.wonMesPrevVal)
        : 'sin cierres el mes pasado';
    } else {
      setDelta('hm-won30-d', k.won30Val, k.prev30Val);
    }
    $('hm-wr').textContent = k.winRate === null ? '–' : k.winRate + '%';
    $('hm-wr-t').textContent = k.winRate !== null ? 'ganado / decidido: ' + k.won90 + '/' + k.dec90
      : !k.dec90 ? 'sin decididos en 90 d'
      : !k.lost90 ? 'todavía no se perdió ninguno — sin perdidos no hay porcentaje'
      : 'muy pocos casos (' + k.dec90 + ') para un porcentaje';
    // visitas 30d: con el rango global en 30d uso lastViews/prevViews (ya en memoria); si no, el cache de 60d
    let visCur = null, visPrev = null;
    // El anaCargada NO es decorativo: desde que la carga se parte en dos, Hoy se
    // dibuja ANTES de que lleguen los pageviews. Sin este chequeo, lastViews está
    // vacío y el KPI mostraba "0 visitas" con su flecha de caída durante unos
    // segundos — un número falso puesto como si fuera un dato. Mejor '–'.
    if (anaCargada && !rangeDay && rangeDays === 30){
      visCur = (lastViews || []).filter((v) => !/^claude-/.test(v.session_id || '')).length;
      visPrev = prevStats ? Number(prevStats.visitas) : (prevViews || []).filter((v) => !/^claude-/.test(v.session_id || '')).length;
    } else if (hmViews60){
      visCur = hmViews60.filter((v) => now - Date.parse(v.created_at) <= 30 * D).length;
      visPrev = hmViews60.filter((v) => { const a = now - Date.parse(v.created_at); return a > 30 * D && a <= 60 * D; }).length;
    }
    /* De 6.983 sesiones en 30 días, 5.237 (75%) son una sola página, cero segundos y
       sin referrer — tráfico automático. Mostrar eso como "visitas" a secas invita a
       leerlo como gente. Desde el 24/08 hay medición real de personas
       (session_activity: scroll, puntero, toque), así que:
         · si el período entero está medido → se muestran PERSONAS
         · si no → se muestran visitas, pero diciendo que incluyen tráfico automático
       Nunca un número sin etiqueta. */
    const persEn = (a, b) => new Set((humanAct || [])
      .filter((x) => { const t = Date.parse(x.created_at); return t >= a && t <= b; })
      .map((x) => x.session_id)).size;
    /* No hace falta esperar a que TODO el período esté medido: se muestra la parte
       que sí lo está y se dice desde cuándo. Esconder el número hasta tener 30 días
       completos sería tirar un dato bueno por no ser perfecto. */
    const desdeMed = Math.max(rangeStart(), HUMAN_DESDE);
    /* anaCargada, otra vez: session_activity llega en la segunda tanda igual que los
       pageviews. Sin este chequeo la tarjeta mostraba "Personas: 0" durante unos
       segundos — el mismo cero falso que ya habíamos sacado de las visitas, entrando
       por la puerta de al lado. */
    const medido = actCargada && rangeEnd() > HUMAN_DESDE;
    if (medido){
      const pers = persEn(desdeMed, rangeEnd());
      const parcial = rangeStart() < HUMAN_DESDE;

      /* Cuántas de esas personas dejaron sus datos, y si venimos mejor o peor.
         Las dos cosas se cuentan en el MISMO tramo —desde que existe la medición de
         personas— porque dividir leads de 30 días por personas de 4 da un número cuatro
         veces más alto y falso.
         El «vs» solo aparece cuando existe un período anterior de verdad: hoy la medición
         tiene 4 días, así que compararla contra los 4 anteriores sería compararla contra
         cero. Cuando haya el doble de ventana, la comparación aparece sola.
         (Sebastián, 27 ago 2026: "dejaría también la cantidad de personas que vieron la
          página, y si es mejor que la anterior [...] lo mismo con la conversion rate".) */
      const leadsEn = (a2, b2) => (allLeads || []).filter((l) => {
        if (/^claude-/.test(l.session_id || '')) return false;
        if (esCartera(l)) return false;
        const t = Date.parse(l.created_at);
        return t >= a2 && t <= b2;
      }).length;
      const conv = pers ? (leadsEn(desdeMed, rangeEnd()) / pers * 100) : null;
      const largo = rangeEnd() - desdeMed;
      const iniPrev = desdeMed - largo;
      const hayPrevio = iniPrev >= HUMAN_DESDE;
      const persPrev = hayPrevio ? persEn(iniPrev, desdeMed - 1) : null;
      const convPrev = (hayPrevio && persPrev) ? (leadsEn(iniPrev, desdeMed - 1) / persPrev * 100) : null;
      /* Mismo cálculo que Analytics (ceil, no round): con los mismos datos, la
         pantalla decía "últimos 1 día" acá y "últimos 2 días" allá. Y "últimos 1
         día" además está mal escrito. */
      const dias = Math.max(1, Math.ceil((rangeEnd() - desdeMed) / 864e5));
      $('hm-vis-l').textContent = parcial ? 'Personas (' + (dias === 1 ? 'último día' : 'últimos ' + dias + ' días') + ')'
                                          : 'Personas (' + rangeLabel().toLowerCase() + ')';
      $('hm-vis').textContent = pers.toLocaleString('de-CH');
      /* El subtítulo dice la conversión, que es lo que se quiere saber de ese número:
         de la gente que entró, cuánta dejó sus datos. */
      const convTxt = conv == null ? ''
        : (conv < 10 ? conv.toFixed(1) : Math.round(conv)) + '% dejó sus datos' +
          (convPrev != null ? ' · antes ' + (convPrev < 10 ? convPrev.toFixed(1) : Math.round(convPrev)) + '%' : '');
      $('hm-vis-t').textContent = [
        convTxt,
        parcial ? 'se mide desde el 24/08' : null,
        visCur != null ? 'de ' + visCur.toLocaleString('de-CH') + ' visitas' : null,
      ].filter(Boolean).join(' · ');
      const dd = $('hm-vis-d');
      if (dd){
        if (persPrev) setDelta('hm-vis-d', pers, persPrev);
        else { dd.textContent = ''; dd.className = 'kdelta'; }
      }
    } else {
      $('hm-vis-l').textContent = actCargada ? 'Visitas (' + rangeLabel().toLowerCase() + ')' : 'Personas';
      $('hm-vis-t').textContent = actCargada ? 'incluye tráfico automático · personas se mide desde el 24/08' : 'cargando…';
      $('hm-vis').textContent = visCur == null ? '–' : visCur.toLocaleString('de-CH');
      if (visCur == null){ const dd = $('hm-vis-d'); if (dd){ dd.textContent = ''; dd.className = 'kdelta'; } }
      else setDelta('hm-vis-d', visCur, visPrev);
    }
    // ROAS Ads: verde ≥1×, rojo <1×, '–' sin datos de gasto
    const ads = hmAdsStats();
    const spend = hmAds ? (+hmAds.spend || 0) : 0;
    const roasEl = $('hm-roas');
    if (spend && !ads.wonVal){
      /* CERO CIERRES NO ES ROAS 0,0×. Un ×0.0 en rojo se lee como "tiraste la plata",
         y no es lo que dice el dato: dice que todavía no se cerró nada que venga de
         Ads. Con ciclos de venta de meses, eso es lo normal las primeras semanas.
         El número aparece cuando haya con qué calcularlo. (Captura de Sebastián del
         25/08: ×0.0 en rojo con CHF 2'241 invertidos y el pipeline lleno.) */
      roasEl.textContent = '–'; roasEl.style.color = '';
      $('hm-roas-t').textContent = fmtChf(spend) + ' invertidos (30 d) · sin cierres atribuidos todavía';
    } else if (spend){
      const x = ads.wonVal / spend;
      roasEl.textContent = '×' + x.toFixed(1);
      roasEl.style.color = x >= 1 ? '#7ed957' : '#ff8b8b';
      $('hm-roas-t').textContent = fmtChf(spend) + ' invertidos (30 d)';
    } else {
      roasEl.textContent = '–'; roasEl.style.color = '';
      $('hm-roas-t').textContent = 'sin datos de Ads';
    }

    /* --- 🎯 Ritmo del mes (objetivo lazy: 1 fetch por sesión, después cache) --- */
    rmFetchGoal();
    rmRender();

    /* --- listas --- */
    const items = hmTodayItems();
    $('hm-today-n').textContent = items.length ? '(' + items.length + ')' : '';
    hmRenderToday(items);
    hmRenderAlive();
    hmRenderSignals();
    hmRenderAgenda();
    hmRenderCalls();
    hmRenderSpark();
    hmRenderAds();

    /* --- datos async con cache (los TTLs evitan refetch en cada auto-refresh) --- */
    epLoad();               // 📥 los que escribieron a info@ y no están en el CRM
    hmRodajesLoad();        // 🎬 rodajes de los próximos días a los que les falta algo
    hmFetchWeeks();
    hmFetchAds();
    ppEnsureForHome();
    sqLoad();
    /* hmOportunidades ya no se llama desde Hoy: el panel se mudó a Contenido →
       Search Console y se carga cuando se abre ese sub-tab. Llamarlo acá gastaba una
       llamada a la IA en cada carga del dashboard para una tarjeta que no está. */
    // tasks abiertas por lead (mismo cache que el board de Deals) — alimenta (c) y (e) de Para hoy
    dlFetchNextTasks([...new Set((dealsList || []).filter((d) => !d.archived && DL_OPEN.includes(stageOf(d.stage))).map((d) => String(d.lead_id)).filter((x) => x && x !== 'undefined' && x !== 'null'))]);
  }

  /* ---------- Pipeline kanban (drag & drop entre etapas) ---------- */
  const STAGES = [
    { key: 'nuevo',      label: 'Nuevo',        color: '#8ab4ff', prob: 0.2,  match: ['new', 'nuevo', '', 'pending'] },
    { key: 'contactado', label: 'Contactado',   color: '#f0c060', prob: 0.4,  match: ['contacted', 'contactado'] },
    { key: 'videocall',  label: 'Video Call',   color: '#c58af9', prob: 0.6,  match: ['videocall', 'video call booked', 'call', 'agendada', 'booked'] },
    /* Se llamaba solo "Propuesta enviada", pero el motor manda acá también las OFERTAS
       enviadas (ver el mapa {won:'ganado', sent:'propuesta'}): un deal con una oferta
       afuera aparecía en una columna que decía que le habían mandado una propuesta.
       (Sebastián, 26 ago 2026: "dice propuesta enviada, pero eso tmb tiene que ser
       oferta enviada".) La etapa es "les mandamos un documento con precio y esperamos". */
    { key: 'propuesta',  label: 'Oferta/propuesta enviada', color: '#f0904e', prob: 0.8,  match: ['proposal', 'propuesta', 'qualified'] },
    { key: 'ganado',     label: 'Ganado',       color: '#7ed957', prob: 1,    match: ['won', 'cerrado', 'ganado'] },
    { key: 'perdido',    label: 'Perdido',      color: '#ff6b6b', prob: 0,    match: ['lost', 'perdido'] },
    // "no por ahora, pero sí más adelante" — no cuenta en el pipeline abierto (como ganado/perdido),
    // pero a diferencia de esos dos tiene una fecha objetivo (follow_up_target_at) para retomar solo.
    { key: 'seguimiento_futuro', label: 'Seguimiento futuro', color: '#5ec7d1', prob: 0.1, match: ['seguimiento_futuro', 'snooze', 'follow_later'] },
  ];
  // color determinista del chip de empresa (por nombre)
  const CO_PALETTE = ['#8ab4ff', '#c58af9', '#7ed957', '#f0c060', '#ff8b5e', '#5ec7d1', '#e08ac5'];
  function coColor(name){ let h = 0; const s = String(name || ''); for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return CO_PALETTE[h % CO_PALETTE.length]; }
  // columna de timestamp por etapa (para el funnel: conversión y tiempos)
  const STAGE_TS = { contactado: 'contacted_at', videocall: 'videocall_at', propuesta: 'proposal_at', ganado: 'won_at', perdido: 'lost_at', seguimiento_futuro: 'snoozed_at' };
  const STAGE_ORDER = ['nuevo', 'contactado', 'videocall', 'propuesta', 'ganado'];
  function stageOf(status){
    const s = (status || '').toLowerCase();
    for (const st of STAGES) if (st.match.includes(s)) return st.key;
    return 'nuevo';
  }
  function timeAgo(iso){
    const s = (Date.now() - new Date(iso).getTime()) / 1000;
    if (s < 3600) return Math.max(1, Math.round(s / 60)) + 'm';
    if (s < 86400) return Math.round(s / 3600) + 'h';
    return Math.round(s / 86400) + 'd';
  }
  const OF_ST = { draft: 'Borrador', sent: 'Enviada', won: 'Ganada', lost: 'Perdida' };
  // ofertas (no archivadas) ligadas a un lead
