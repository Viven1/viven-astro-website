  const PB_QS = PLAYBOOK.flatMap((g) => g.qs);

  let pbResp = {};      // key → {value, scope, updated_at}
  let pbLead = null;    // el lead cuyo playbook está cargado

  const pbRef = (q, r) => q.scope === 'company' ? (leadDomain(r) || '') : String(r.id);

  async function pbLoad(r){
    pbLead = r; pbResp = {};
    const dom = leadDomain(r);
    const ors = [];
    ors.push(supabase.from('playbook_answers').select('*').eq('scope', 'lead').eq('ref', String(r.id)));
    if (dom) ors.push(supabase.from('playbook_answers').select('*').eq('scope', 'company').eq('ref', dom));
    const res = await Promise.all(ors);
    res.forEach((x) => (x.error ? [] : (x.data || [])).forEach((a) => { pbResp[a.scope + '|' + a.key] = a; }));
    if (!lm2Lead || String(lm2Lead.id) !== String(r.id)) return;   // cambió de contacto mientras cargaba
    pbRender();
