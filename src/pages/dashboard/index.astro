        if (!co0.address && ofCur.client_address) cpatch.address = ofCur.client_address;
        if (!co0.zip_city && ofCur.client_zip_city) cpatch.zip_city = ofCur.client_zip_city;
        if (!co0.phone && ofCur.client_phone) cpatch.phone = ofCur.client_phone;
