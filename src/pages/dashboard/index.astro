  // 3 reviews del tipo del proyecto (+ relleno de otras), en orden aleatorio → cada propuesta distinta
  function pickReviews(topic){
    const cat = { employer: 'employer', product: 'product', social: 'brand', event: 'corporate', howto: 'howto', brand: 'brand', general: 'corporate' }[topic] || 'corporate';
    const match = GREVIEWS.filter((r) => r.cat === cat), rest = GREVIEWS.filter((r) => r.cat !== cat);
    const shuffled = [...match.sort(() => Math.random() - 0.5), ...rest.sort(() => Math.random() - 0.5)].slice(0, 3);
    return shuffled.map((r) => ({ quote: r.text, name: r.name, role: r.company, company: 'Google Review ★★★★★' }));
  }
  function renderCompanyDetail(){
    const domain = coCur; const data = companiesData().find((c) => c.domain === domain) || { domain, name: companyName(domain), contacts: [], value: 0, won: false };
    const m = coMeta[domain] || {};
    const st = coStatus(data), mo = coMoney(data);
    $('co-avatar').textContent = data.name.slice(0, 2).toUpperCase();
    $('co-avatar').style.background = coColor(data.name); $('co-avatar').style.color = '#0f1826';
    $('co-name').textContent = data.name;
