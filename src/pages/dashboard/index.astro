  }
  function onRowInput(e){
    const tr = e.target.closest('tr'), i = +tr.dataset.i, f = e.target.dataset.f;
    let v = e.target.type === 'checkbox' ? e.target.checked : e.target.value;
    if (f === 'qty') v = parseFloat(String(v).replace(',', '.')) || 0;
      else if (f === 'price' || f === 'cost') v = numCHF(v);
    ofCur.items[i][f] = v;
    if (['qty', 'price', 'cost'].includes(f)){
      const it = ofCur.items[i], total = (Number(it.qty) || 0) * (Number(it.price) || 0), margin = total - (Number(it.qty) || 0) * (Number(it.cost) || 0);
      tr.children[6].textContent = fmtM(total);
      tr.children[7].textContent = fmtM(margin);
      tr.children[7].style.color = margin >= 0 ? '#7ed957' : '#ff8b8b';
      // actualizar el subtotal de la fase en vivo (sin re-render, para no perder el foco)
      const s = phaseSubtotal(phaseOf(it));
      const sub = $('of-rows').querySelector('.of-sub[data-phase="' + phaseOf(it) + '"]');
      if (sub){ sub.children[1].textContent = fmtM(s.net); sub.children[2].textContent = fmtM(s.net - s.cost); }
      recalc();
    }
  }
  function recalc(){
    const net = offerNet(ofCur), cost = offerCost(ofCur);
    const sum0 = (ofCur.items || []).filter((it) => !esOpt(it)).reduce((a, it) => a + (Number(it.qty) || 0) * (Number(it.price) || 0), 0);
    $('of-discamt').textContent = (sum0 - net) > 0.005 ? '− ' + fmtM(sum0 - net) : 'CHF 0.00';
    const vat = net * (parseFloat($('of-vat').value) || 0) / 100;
    const profit = net - cost, mp = net ? profit / net * 100 : 0;
    $('of-net').textContent = fmtM(net);
    $('of-vatamt').textContent = fmtM(vat);
    $('of-gross').textContent = fmtM(net + vat);
    $('of-cost').textContent = fmtM(cost);
    $('of-profit').textContent = fmtM(profit);
    $('of-profit').className = profit >= 0 ? 'pos' : 'neg';
    $('of-marginpct').textContent = Math.round(mp) + '%';
    $('of-marginpct').className = mp >= 50 ? 'pos' : mp >= 30 ? '' : 'neg';
    $('of-bep').textContent = cost > 0
      ? 'Breakeven en ' + fmtM(cost) + ' de costo externo. Podés descontar hasta ' + fmtM(profit) + ' (' + Math.round(mp) + '%) antes de perder plata.'
      : 'Sin costo externo cargado — todo el neto es margen.';
  }

  async function saveOffer(auto){
    auto = auto === true;   // autosave: silencioso, sin diálogos ni re-render de lista
    ofCur.title = $('of-title').value.trim();
    ofCur.client = $('of-client').value.trim();
    ofCur.lead_id = $('of-lead').value || null;
    ofCur.vat_rate = parseFloat($('of-vat').value) || 0;
    ofCur.status = $('of-status').value;
    ofCur.terms = $('of-terms').value.trim() || null;
    ofCur.client_company = $('of-ccompany').value.trim() || null;
    ofCur.client_contact = $('of-cperson').value.trim() || null;
    ofCur.client_address = $('of-caddr').value.trim() || null;
    ofCur.client_zip_city = $('of-czip').value.trim() || null;
    ofCur.client_phone = $('of-cphone').value.trim() || null;
    ofCur.client_email = $('of-cemail').value.trim() || null;
    ofCur.valid_until = $('of3-valid').value || null;
    ofCur.intro_text = $('of3-intro').value.trim() || null;
    ofCur.closing_text = $('of3-closing').value.trim() || null;
    ofCur.lang = $('of3-lang').value || null;
    // sync pipeline: sin lead ligado, ofrecer crear la persona (si no, la oferta queda fuera del board) — nunca en autosave (abre un confirm)
    if (!auto && !ofCur.lead_id && ofCur.client){
      const lid = await ensureLeadFor(ofCur.client, undefined, ofCur.status);
      if (lid){ ofCur.lead_id = lid; $('of-lead').innerHTML = leadOptions(lid); }
    }
    // ligar la oferta a un DEAL (proyecto): el abierto más reciente; si no hay, se crea uno
    if (!auto && dealsReal && ofCur.lead_id && !ofCur.deal_id){
      let od2 = openDealOf(ofCur.lead_id);
      if (od2 && od2.synthetic) od2 = await ensureRealDeal(od2);
      if (od2) ofCur.deal_id = od2.id;
      else { const st3 = { won: 'ganado', sent: 'propuesta' }[ofCur.status] || 'propuesta'; const nd = await newDealForLead(ofCur.lead_id, ofCur.title || 'Nuevo proyecto', st3); if (nd) ofCur.deal_id = nd.id; }
    }
    const payload = { title: ofCur.title, client: ofCur.client, lead_id: ofCur.lead_id, deal_id: ofCur.deal_id || null, vat_rate: ofCur.vat_rate, discount_pct: ofCur.discount_pct || 0, status: ofCur.status, items: ofCur.items, lost_reason: ofCur.lost_reason || null, terms: ofCur.terms, client_company: ofCur.client_company || null, client_contact: ofCur.client_contact || null, client_address: ofCur.client_address || null, client_zip_city: ofCur.client_zip_city || null, client_phone: ofCur.client_phone || null, client_email: ofCur.client_email || null, valid_until: ofCur.valid_until, intro_text: ofCur.intro_text, closing_text: ofCur.closing_text, lang: ofCur.lang };
    const btn = $('of-save'), prev = btn.textContent;
    if (!auto){ btn.disabled = true; btn.textContent = 'Guardando…'; }
    ofSaving = true;
    const doSave = (p) => ofCur.id
      ? supabase.from('offers').update(p).eq('id', ofCur.id).select().single()
      : supabase.from('offers').insert(p).select().single();
    let res = await doSave(payload);
    // columnas nuevas sin migrar (SQL 0014/0018/0061): sacarlas y reintentar
    for (let a = 0; a < 8 && res.error; a++) {
      const m = /Could not find the '([^']+)' column/.exec(res.error.message || '');
      if (m && m[1] in payload) { delete payload[m[1]]; res = await doSave(payload); } else break;
    }
    ofSaving = false;
    if (!auto){ btn.disabled = false; btn.textContent = prev; }
    if (res.error){ if (auto) return; alert('No se pudo guardar: ' + res.error.message); return; }
    if (res.data && res.data.id) ofCur.id = res.data.id;
    ofLastSaved = Date.now(); autosaveNote('of3-autosave', ofLastSaved);
    if (auto){
      // refrescar la fila en memoria sin re-dibujar nada (el usuario sigue tipeando)
      const ai2 = (offersList || []).findIndex((x) => String(x.id) === String(res.data.id));
      if (ai2 >= 0) offersList[ai2] = res.data; else offersList.unshift(res.data);
      return;
    }
    // unir: completar la ficha de la EMPRESA con los datos de la oferta (solo campos vacíos)
    try {
      const lead0 = allLeads.find((l) => String(l.id) === String(ofCur.lead_id));
      const dom0 = lead0 && leadDomain(lead0);
      if (dom0) {
        const co0 = coMeta[dom0] || {};
        const cpatch = { domain: dom0 };
        if (!co0.name && ofCur.client_company) cpatch.name = ofCur.client_company;
        if (!co0.address && ofCur.client_address) cpatch.address = ofCur.client_address;
        if (!co0.zip_city && ofCur.client_zip_city) cpatch.zip_city = ofCur.client_zip_city;
        if (!co0.phone && ofCur.client_phone) cpatch.phone = ofCur.client_phone;
        if (Object.keys(cpatch).length > 1) supabase.from('companies').upsert(cpatch, { onConflict: 'domain' }).select().single().then(({ data }) => { if (data) coMeta[dom0] = data; }, () => {});
      }
    } catch (e) { /* ficha de empresa: best-effort */ }
    // sync: oferta ganada → el deal (lead) pasa a Ganado automáticamente
    if (payload.status === 'won' && ofCur.lead_id){
      if (ofCur.deal_id) { const dd = (dealsList || []).find((x) => String(x.id) === String(ofCur.deal_id)); if (dd && stageOf(dd.stage) !== 'ganado') { await setDealStage(dd.id, 'ganado'); toast('🏆 Deal movido a Ganado'); } }
      else { const lead = allLeads.find((l) => String(l.id) === String(ofCur.lead_id)); if (lead && stageOf(lead.status) !== 'ganado') { await setLeadStage(lead.id, 'ganado'); toast('🏆 Deal movido a Ganado'); } }
    }
    // GUARDAR = guardar (no perder datos) — te quedás en el editor; «← Volver» es el que sale
    await offersLoad();
    // recién guardada puede haber ganado id y/o lead → habilitar 🌐 → Propuesta sin cerrar el editor
    const tp2 = $('of-toprop'); if (tp2) tp2.disabled = !(ofCur.id && ofCur.lead_id);
    toast('💾 Oferta guardada');
  }
