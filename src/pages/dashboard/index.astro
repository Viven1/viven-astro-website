        '<p style="font-size:11px;color:#8a94a8;text-align:center;margin-top:16px">' + L.valid + '<br><b style="color:#1a2230">' + COMPANY.name + '</b> · ' + COMPANY.web + ' · ' + COMPANY.email + ' · Zürich</p>' +
