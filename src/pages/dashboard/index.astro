    }));
    const marcar = (v) => {
      $('limp-body').querySelectorAll('[data-chk]').forEach((cb) => {
        if (!cb.closest('.limp-row').querySelector('.limp-mal')) return;   // los reales no se tocan en bloque
        cb.checked = v; cb.dispatchEvent(new Event('change'));
