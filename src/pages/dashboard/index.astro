  // ===== render del email (espejo cliente de la edge function newsletter-send) =====
  const NW_CALC = { en: 'https://www.viven.ch/en/video-cost-calculator', de: 'https://www.viven.ch/de/videoproduktion-kosten-rechner', es: 'https://www.viven.ch/es/calculadora-costos-video' };
  function nwAddUtm(url, id){ const u = String(url || '').trim(); if (!u || u.startsWith('mailto:') || u.startsWith('#')) return u; const tag = 'utm_source=newsletter&utm_campaign=nl-' + id; const parts = u.split('#'); const j = parts[0] + (parts[0].includes('?') ? '&' : '?') + tag; return parts[1] ? j + '#' + parts[1] : j; }
  function nwCtaDest(dest, lang){ if (dest === 'calculator') return NW_CALC[lang] || NW_CALC.en; if (dest === 'brief') return 'https://www.viven.ch/brief/'; if (dest === 'call') return 'https://www.viven.ch/book/'; return dest || 'https://www.viven.ch'; }
  function nwTextHtml(text, id){ return String(text || '').trim().split(/\n{2,}/).map((par) => { const wl = esc(par).replace(/(https?:\/\/[^\s<]+)/g, (m) => '<a href="' + nwAddUtm(m, id) + '" style="color:#5b7cfa">' + m + '</a>').replace(/\n/g, '<br>'); return '<p style="margin:0 0 16px;font-size:15px;line-height:1.65;color:#222">' + wl + '</p>'; }).join(''); }
  function nwBlocksHtml(blocks, lang, id){
    const abs = (s) => String(s || '').startsWith('http') ? s : 'https://www.viven.ch' + s;
    return (blocks || []).map((b) => {
      if (!b || !b.type) return '';
      if (b.type === 'text') return nwTextHtml(b.text || '', id);
      if (b.type === 'video'){ const url = nwAddUtm(b.url || 'https://www.viven.ch', id); const title = esc(b.title || 'Ver el video');
        return '<div style="margin:18px 0;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb"><a href="' + url + '" style="text-decoration:none;color:inherit;display:block"><div style="position:relative">' +
          (b.thumb ? '<img src="' + esc(b.thumb) + '" alt="' + title + '" style="display:block;width:100%;height:auto" />' : '<div style="width:100%;padding-bottom:56.25%;background:#16233a"></div>') +
          '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center"><span style="width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,.92);color:#0f1826;font-size:22px;line-height:56px;text-align:center;display:inline-block">▶</span></div></div>' +
          '<div style="background:#f4f5f7;padding:9px 13px;font-size:13px;color:#555"><b style="color:#222">' + title + '</b></div></a></div>'; }
      if (b.type === 'still'){ if (!b.src) return ''; const cap = esc(b.caption || '');
        return '<div style="margin:18px 0"><img src="' + esc(abs(b.src)) + '" alt="' + cap + '" style="display:block;width:100%;height:auto;border-radius:12px" />' + (cap ? '<div style="font-size:12px;color:#888;margin-top:6px;text-align:center">' + cap + '</div>' : '') + '</div>'; }
      if (b.type === 'cta'){ const href = nwAddUtm(nwCtaDest(b.dest || 'call', lang), id);
        return '<div style="text-align:center;margin:22px 0"><a href="' + href + '" style="background:#0f1826;color:#ddf98f;border-radius:100px;padding:13px 26px;font-size:14px;font-weight:700;text-decoration:none;display:inline-block">' + esc(b.label || 'Más info →') + '</a></div>'; }
      if (b.type === 'case'){ const url = nwAddUtm(b.url || 'https://www.viven.ch', id); const title = esc(b.title || 'Case study');
        return '<a href="' + url + '" style="text-decoration:none;color:inherit;display:block;margin:18px 0;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse"><tr>' +
          (b.thumb ? '<td width="120" style="width:120px"><img src="' + esc(abs(b.thumb)) + '" alt="' + title + '" width="120" style="display:block;width:120px;height:auto;object-fit:cover" /></td>' : '') +
          '<td style="padding:12px 14px;vertical-align:middle"><div style="font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:#8a919e">Case study</div><div style="font-size:14px;font-weight:700;color:#222;margin-top:3px">' + title + '</div><div style="font-size:12px;color:#5b7cfa;margin-top:5px">Ver el caso →</div></td></tr></table></a>'; }
      return '';
    }).join('');
  }
  /* Saludo por idioma — espejo EXACTO de greeting() en newsletter-send:
     en alemán NUNCA nombre de pila ni du, "Guten Tag" formal a secas (no tenemos
     apellido ni género confiables en leads). EN/ES sí con nombre de pila. */
  const NW_UNSUB = { en: 'Unsubscribe', de: 'Abmelden', es: 'Darse de baja' };
  function nwGreetPreview(lang){
    if (lang === 'de') return '<p style="margin:0 0 16px;font-size:15px;color:#222">Guten Tag</p>';
    const hi = lang === 'es' ? 'Hola' : 'Hi';
    return '<p style="margin:0 0 16px;font-size:15px;color:#222">' + hi + ' <span style="background:#fff3bf;padding:0 3px;border-radius:3px">&lt;nombre&gt;</span>,</p>';
  }
  function nwEmailHtml(langArg){
    const id = (nwCur && nwCur.id) || 'preview';
    const lang = langArg || ($('nw-lang').value === 'all' ? 'en' : $('nw-lang').value);
    const useBlocks = nwBlocks.some((b) => b.type !== 'text' || String(b.text || '').trim());
    const inner = useBlocks ? nwBlocksHtml(nwBlocks, lang, id) : nwTextHtml(nwDerivedBody(), id);
    return '<div style="max-width:600px;margin:0 auto">' +
      '<div style="background:#0f1826;border-radius:14px 14px 0 0;padding:18px 26px"><span style="font-family:\'Space Grotesk\',sans-serif;font-weight:800;color:#ddf98f;font-size:16px">viven</span> <span style="font-size:8px;color:#8290ab;text-transform:uppercase;letter-spacing:.05em">Film Production</span></div>' +
      '<div style="background:#fff;border-radius:0 0 14px 14px;padding:30px 26px">' + nwGreetPreview(lang) + inner + '<p style="margin:22px 0 0;font-size:14px;color:#444">' + (NW_FIRMA[lang] || NW_FIRMA.en) + '</p></div>' +
      '<p style="text-align:center;font-size:11.5px;color:#9aa;margin-top:16px">VIVEN AG · Zürich · viven.ch · <u>' + (NW_UNSUB[lang] || NW_UNSUB.en) + '</u></p></div>';
  }
  /* Qué cambia de verdad entre un alemán, un inglés y un español. Lo digo en la
     pantalla porque el malentendido natural es creer que el cuerpo se traduce:
     NO se traduce. Una campaña suelta se escribe una vez, en un idioma, y sale
     igual para todos; lo que cambia por destinatario es el saludo, el link de
     baja y el destino de los botones (la calculadora tiene una URL por idioma).
     La que sí tiene texto propio por idioma es la Edición mensual automática. */
  function nwLangDiffs(lang){
    const calc = (nwBlocks || []).some((b) => b && b.type === 'cta' && b.dest === 'calculator');
    const items = [
      'Saludo: <b>' + (lang === 'de' ? 'Guten Tag' : lang === 'es' ? 'Hola &lt;nombre&gt;,' : 'Hi &lt;name&gt;,') + '</b>' +
        (lang === 'de' ? ' <span style="color:var(--muted-2)">(en alemán, siempre formal y sin nombre de pila)</span>' : ''),
      'Link de baja: <b>' + NW_UNSUB[lang] + '</b>',
    ];
    if (calc) items.push('Botón a la calculadora: <b>' + esc(NW_CALC[lang] || NW_CALC.en) + '</b>');
    return items;
  }
  let nwPrevLang = 'en';
  /* ===== EL PREVIEW SALE DEL SERVIDOR =====
     "Siempre antes de mandar tengo que poder ver como preview y corregir si
     necesario". Antes esta ventana dibujaba el email acá, en el navegador, con su
     propia copia de cómo se arma — o sea que el preview y el email que sale eran dos
     programas distintos haciendo lo mismo. Funciona hasta que uno de los dos cambia.
     Ahora se le pide a newsletter-send que lo renderice con buildFull(), el MISMO
     código que arma lo que se manda. Para eso hace falta que la campaña esté guardada,
     así que se guarda antes: el borrador ya se guardaba solo en cada paso.
     Es la misma regla que ya rige los destinatarios — el número y el contenido salen
     de la función que envía, nunca de una copia en la pantalla. */
  async function nwPreview(){
    let ov = $('nw-preview-ov'); if (!ov){ ov = document.createElement('div'); ov.id = 'nw-preview-ov'; document.body.appendChild(ov); }
    ov.className = 'of-composer';
    const seg = $('nw-lang').value;
    if (seg !== 'all') nwPrevLang = seg;                      // segmento de un idioma: arrancá por ese
    else if (!['en', 'de', 'es'].includes(nwPrevLang)) nwPrevLang = 'en';
    let render = {};   // idioma → { subject, html } tal como lo devuelve el servidor
    const pintar = () => {
      const lg = nwPrevLang, p = nwPrev;
      const cuantos = p && p.por_idioma ? p.por_idioma[lg] : null;
      ov.querySelector('#nw-prev-tabs').innerHTML = ['de', 'en', 'es'].map((x) => {
        const n = p && p.por_idioma ? p.por_idioma[x] : null;
        return '<button class="btn ' + (x === lg ? 'btn-primary' : 'btn-ghost') + ' small" data-plg="' + x + '" type="button">' +
          NW_LG[x] + (n != null ? ' · ' + n : '') + '</button>';
      }).join('');
      const r = render[lg];
      const propio = r && r.tiene_version_propia;
      ov.querySelector('#nw-prev-diffs').innerHTML =
        (cuantos != null ? '<b style="color:var(--acid)">' + cuantos + '</b> ' + (cuantos === 1 ? 'persona lo recibe' : 'personas lo reciben') + ' así. ' : '') +
        (r ? '<b>Asunto:</b> ' + esc(r.subject || '(sin asunto)') : 'Pidiéndoselo al servidor…') +
        '<div style="margin-top:4px;color:' + (propio ? 'var(--acid)' : '#f0c060') + '">' +
        (propio ? '✓ Versión escrita en este idioma.'
                : '⚠️ Todavía no escribiste esta versión — estas personas reciben la inglesa. Escribila en la pestaña de arriba o usá «✨ Traducir».') +
        '</div>' +
        '<div style="margin-top:4px;color:var(--muted-2)">Esto es exactamente lo que sale: lo arma la misma función que hace el envío.</div>';
      ov.querySelector('#nw-prev-body').innerHTML = r ? r.html : '<p style="color:#666">Cargando…</p>';
      ov.querySelectorAll('[data-plg]').forEach((b) => b.addEventListener('click', () => { nwPrevLang = b.dataset.plg; pintar(); }));
    };
    ov.innerHTML = '<div class="ofc-card" style="max-width:640px"><h3 style="margin:0 0 4px">👁 Así le llega — por idioma</h3>' +
      '<p class="muted-note" style="margin:0 0 8px">El nombre y el link de baja son personales de cada destinatario. Los links salen con utm_campaign=nl-{id}.</p>' +
      '<div class="nw-langtabs" id="nw-prev-tabs"></div>' +
      '<p class="muted-note" id="nw-prev-diffs" style="margin:0 0 12px;font-size:11.5px"></p>' +
      '<div id="nw-prev-body" style="background:#f4f5f7;border-radius:14px;padding:20px;max-height:55vh;overflow-y:auto"></div>' +
      '<div style="display:flex;gap:8px;margin-top:12px"><button class="btn btn-ghost small" id="nw-prev-close" type="button">Cerrar</button></div></div>';
    pintar();
    ov.querySelector('#nw-prev-close').addEventListener('click', () => ov.remove());
    ov.addEventListener('click', (e) => { if (e.target === ov) ov.remove(); });
    nwFetchPrev().then((p) => { if (p && $('nw-preview-ov')) pintar(); });   // cuántos por idioma

    // guardar primero: el servidor renderiza lo GUARDADO, así que lo que ves es lo
    // que hay, no lo que quedó a medio escribir en la pantalla
    const idCampana = await nwSave();
    if (!idCampana){
      ov.querySelector('#nw-prev-body').innerHTML = '<p style="color:#a33">No pude guardar el borrador, así que no puedo mostrarte el email real. Revisá que haya asunto y contenido.</p>';
      return;
    }
    for (const lg of ['en', 'de', 'es']){
      try {
        const { data, error } = await supabase.functions.invoke('newsletter-send', { body: { render_preview: true, id: idCampana, lang: lg } });
        if (!error && data && data.ok) render[lg] = data;
      } catch (e) { /* un idioma que falla no tapa los otros */ }
      if ($('nw-preview-ov')) pintar();
    }
  }

  // ===== destinatarios: SIEMPRE del servidor =====
  /* El filtro real de a quién le llega el newsletter vive en la edge function
     newsletter-send (elegirDestinatarios) y su modo { preview:true } usa esa MISMA
     función, sin mandar nada. Todo lo que se muestre acá — el contador del panel,
     el KPI "Suscriptos", la lista de "Ver / editar lista" — sale de ahí.
     Antes este archivo tenía su propia copia del filtro en JavaScript y ya estaba
     dando OTRO número: excluía @viven.ch y @entropia, que sí reciben el newsletter,
     y mataba cualquier email con la palabra "test" adentro (testimonios@…).
     Regla: no reimplementar el filtro acá nunca más. */
  let nwPrev = null, nwPrevKey = '', nwPrevErr = '', nwPrevSeq = 0;
  function nwSegNow(){
    return {
      segment_stage: $('nw-stage') ? $('nw-stage').value : 'all',
      segment_lang: $('nw-lang') ? $('nw-lang').value : 'all',
      exclude_ids: [...nwExcludeIds].map(Number),
      exclude_emails: [...nwExcludeEmails],
      extra_emails: nwExtraEmails.slice(),
    };
  }
  async function nwFetchPrev(force){
    const seg = nwSegNow(), key = JSON.stringify(seg);
    if (!force && key === nwPrevKey && nwPrev) return nwPrev;
    const seq = ++nwPrevSeq;
    const { data, error } = await supabase.functions.invoke('newsletter-send', { body: { preview: true, ...seg } });
    if (seq !== nwPrevSeq) return nwPrev;   // llegó vieja: ya se pidió otra
    if (error || !data || data.error){
      nwPrev = null; nwPrevKey = ''; nwPrevErr = (error && error.message) || (data && data.error) || 'no se pudo contar';
      return null;
    }
    nwPrev = data; nwPrevKey = key; nwPrevErr = '';
    return data;
  }
  // resumen por idioma, con el mismo fallback que el envío (sin idioma → inglés)
  function nwLangLine(porIdioma){
    const p = porIdioma || {};
    return ['de', 'en', 'es'].filter((lg) => p[lg]).map((lg) => '<span>' + { de: '🇩🇪 Alemán', en: '🇬🇧 Inglés', es: '🇪🇸 Español' }[lg] + ' <b>' + p[lg] + '</b></span>').join('') || '<span>Sin destinatarios</span>';
  }
  function nwFueraLine(f){
    if (!f) return '';
    const items = [
      [f.followUp, 'en Follow up (clientes viejos de bexio, no reciben el newsletter)'],
      [f.baja, 'dados de baja'], [f.descartados, 'spam/descartados'], [f.duplicados, 'emails repetidos'],
      [f.fueraDeSegmento, 'fuera del segmento elegido'], [f.sacadosAMano, 'sacados a mano'],
    ].filter(([n]) => n > 0).map(([n, l]) => n + ' ' + l);
    return items.length ? 'No lo reciben: ' + items.join(' · ') + '.' : '';
  }

  /* ===== horario laboral suizo (solo para AVISAR, no para decidir) =====
     La decisión de mandar o no la toma newsletter-dispatch → enHorarioLaboral().
     Esto es una copia de las ventanas para poder decirle a Sebastián, en la
     pantalla, a qué hora va a salir de verdad lo que programó. Si algún día se
     cambia el horario, se cambia en newsletter-dispatch/index.ts (que es la
     autoridad) Y acá. El corte del mediodía es a propósito. */
  const NW_VENTANAS = [[9 * 60, 12 * 60], [13 * 60 + 30, 17 * 60]];
  function nwZurich(d){
    const p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Zurich', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(d);
    const g = (t) => (p.find((x) => x.type === t) || {}).value || '';
    const dias = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
    return { dow: dias[g('weekday')] != null ? dias[g('weekday')] : 1, min: +g('hour') * 60 + +g('minute') };
  }
  function nwEnHorario(d){
    const { dow, min } = nwZurich(d);
    if (dow < 1 || dow > 5) return false;
    return NW_VENTANAS.some(([a, b]) => min >= a && min < b);
  }
  // primer instante ≥ d que caiga en horario laboral, buscando de 15 en 15 min
  function nwProxSalida(d){
    let t = new Date(Math.ceil(d.getTime() / 9e5) * 9e5);   // redondeo al slot de 15 min
    for (let i = 0; i < 4 * 24 * 14; i++){                  // hasta 14 días adelante
      if (nwEnHorario(t)) return t;
      t = new Date(t.getTime() + 9e5);
    }
    return null;
  }
  const nwFechaZH = (d) => d.toLocaleString('es-CH', { timeZone: 'Europe/Zurich', weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
  /* ── LA REGLA DE HORARIO VALE PARA TODO BOTÓN QUE MANDA ──
     Hasta el 2 sep 2026 solo la miraba el despachador de programados. «Aprobar y
     enviar» llamaba directo a newsletter-send, que no la conocía, y una edición
     salió un miércoles a las 19:50 a 44 personas. Ahora: (1) el servidor la aplica
     siempre (ver _shared/horario.ts), y (2) acá, ANTES de llamarlo, si estamos fuera
     de horario el botón no manda: ofrece programar para el próximo hueco válido.
     (Sebastián: "siempre esa regla, si hago aprobar y enviar que controle antes de
     enviar ciegamente".) */
  function nwProximoHuecoSiFueraDeHorario(){
    const ahora = new Date();
    return nwEnHorario(ahora) ? null : nwProxSalida(ahora);
  }
  const nwHoraZH = (d) => d.toLocaleTimeString('es-CH', { timeZone: 'Europe/Zurich', hour: '2-digit', minute: '2-digit' });
  // valor para un <input type="datetime-local">, en la hora local del navegador
  const nwLocalIso = (d) => { const z = (n) => String(n).padStart(2, '0'); return d.getFullYear() + '-' + z(d.getMonth() + 1) + '-' + z(d.getDate()) + 'T' + z(d.getHours()) + ':' + z(d.getMinutes()); };
  function nwPreguntaFueraDeHorario(hueco){
    return confirm('⏰ Son las ' + nwHoraZH(new Date()) + ' en Zúrich: fuera del horario de envío (lun-vie 09:00–12:00 y 13:30–17:00).\n\n' +
      'No la mando ahora. ¿La programo para el ' + nwFechaZH(hueco) + '? Sale sola, sin que tengas que volver.');
  }
  function nwSchedHint(){
    const el = $('nw-sched-real'); if (!el) return;
    const modo = $('nw-sched-mode') && $('nw-sched-mode').value === 'at';
    const val = $('nw-sched-at') && $('nw-sched-at').value;
    if (!modo || !val){ el.hidden = true; el.innerHTML = ''; return; }
    const pedido = new Date(val);
    if (isNaN(pedido)){ el.hidden = true; return; }
    const real = nwProxSalida(pedido);
    el.hidden = false;
    if (!real){ el.innerHTML = '⚠️ No pude calcular la próxima ventana laboral.'; return; }
    el.innerHTML = Math.abs(real - pedido) < 9e5
      ? '✅ Sale el <b>' + nwFechaZH(real) + '</b> (hora de Zúrich).'
      : '⏰ Esa hora cae fuera del horario laboral suizo — sale el <b>' + nwFechaZH(real) + '</b> (hora de Zúrich).';
  }

  // ===== panel de envío (conteo, tandas, cupo, progreso) =====
  async function nwUpdateSendPanel(){
    const title = $('nw-send-title'), info = $('nw-send-info'); if (!title || !info) return;
    nwSchedHint();
    const sched = $('nw-sched-mode') && $('nw-sched-mode').value === 'at';
    const btn0 = $('nw-send'); if (btn0) btn0.textContent = sched ? '⏰ Programar' : (nwProximoHuecoSiFueraDeHorario() ? '⏰ Fuera de horario · programar' : '📤 Enviar ahora');
    if ($('nw-mode') && $('nw-mode').value === 'one'){
      title.textContent = '📤 Envío directo a 1 persona';
      info.innerHTML = 'Queda registrado en el historial (con utm y link de baja). El self-test rápido NO deja rastro.';
      if (btn0) btn0.textContent = '📤 Enviar ahora';
      return;
    }
    if (!nwPrev){ title.textContent = '📤 Contando destinatarios…'; info.innerHTML = 'Preguntándole al servidor quiénes lo reciben.'; }
    const p = await nwFetchPrev();
    if (!p){
      title.textContent = '📤 No pude contar los destinatarios';
      info.innerHTML = '⚠️ ' + esc(nwPrevErr || 'error') + '<br/>No mandes a ciegas: abrí «Ver / editar lista» y volvé a intentar.';
      return;
    }
    const n = p.total;
    const batches = Math.max(1, Math.ceil(n / 100));
    const secs = Math.max(1, Math.round(batches * 0.6 + n * 0.02));
    const cap = n > 100
      ? '<br/><span class="cap-over">⚠️ ' + n + " supera el tope diario del plan Free (100/día) — conviene Pro (USD 20/mes = 50'000).</span>"
      : "<br/>Cupo Free: <b>" + n + " de 3'000 este mes</b> ✓";
    const fuera = nwFueraLine(p.fuera);
    nwAvisoIdiomas(p.por_idioma);
    title.textContent = '📤 Listo para enviar a ' + n + ' persona' + (n === 1 ? '' : 's');
    info.innerHTML = '<div class="nw-sum">' + nwLangLine(p.por_idioma) + '</div>' +
      'En <b>' + batches + ' tanda' + (batches === 1 ? '' : 's') + ' de 100</b> (API batch de Resend) · duración estimada: <b>~' + secs + 's</b>' + cap +
      '<br/>Si el envío se corta, se retoma solo sin duplicar a nadie ✓' +
      (fuera ? '<br/><span style="color:var(--muted-2)">' + fuera + '</span>' : '') +
      '<br/><span style="color:var(--muted-2)">Este número lo calcula la misma función que hace el envío.</span>';
  }

  // ===== atribución de ventas por campaña =====
  function nwWonDeal(leadId){ return (dealsList || []).find((d) => String(d.lead_id) === String(leadId) && stageOf(d.stage) === 'ganado'); }
  function nwMoneyShort(v){ v = Number(v) || 0; return v >= 1000 ? 'CHF ' + (v / 1000).toLocaleString('de-CH', { maximumFractionDigits: 1 }) + 'k' : 'CHF ' + v.toLocaleString('de-CH', { maximumFractionDigits: 0 }); }

  // ---- Edición mensual automática (newsletter_issues, SQL 0114) ----
  let nwiCur = null, nwiList = [];
  /* Destinatarios de la edición mensual (SQL 0123). Antes salía a toda la base sin
     nada que elegir — Sebastián: "el newsletter mensual no tiene opción de a quién
     enviar, solo el de abajo". Mismos campos, mismo panel y MISMA función de
     selección en el servidor que la campaña manual. */
  let nwiExcludeIds = new Set(), nwiExcludeEmails = new Set(), nwiExtraEmails = [];
  let nwiPrev = null, nwiPrevKey = '', nwiPrevErr = '', nwiPrevSeq = 0;
  function nwiSegNow(){
    return {
      segment_stage: $('nwi-stage') ? $('nwi-stage').value : 'all',
      segment_lang: $('nwi-lang') ? $('nwi-lang').value : 'all',
      exclude_ids: [...nwiExcludeIds].map(Number),
      exclude_emails: [...nwiExcludeEmails],
      extra_emails: nwiExtraEmails.slice(),
    };
  }
  async function nwiFetchPrev(force){
    const seg = nwiSegNow(), key = JSON.stringify(seg);
    if (!force && key === nwiPrevKey && nwiPrev) return nwiPrev;
    const seq = ++nwiPrevSeq;
    const { data, error } = await supabase.functions.invoke('newsletter-send', { body: { preview: true, ...seg } });
    if (seq !== nwiPrevSeq) return nwiPrev;
    if (error || !data || data.error){ nwiPrev = null; nwiPrevKey = ''; nwiPrevErr = (error && error.message) || (data && data.error) || 'no se pudo contar'; return null; }
    nwiPrev = data; nwiPrevKey = key; nwiPrevErr = ''; return data;
  }
  async function nwiUpdateRecips(){
    const el = $('nwi-recips'); if (!el || !nwiCur) return;
    if (nwiCur.status !== 'draft'){ el.innerHTML = ''; return; }
    el.innerHTML = 'Contando destinatarios…';
    const p = await nwiFetchPrev();
    if (!p){ el.innerHTML = '⚠️ ' + esc(nwiPrevErr || 'no se pudo contar'); return; }
    el.innerHTML = '<b style="color:var(--acid)">' + p.total + '</b> destinatario' + (p.total === 1 ? '' : 's') +
      ', cada uno en su idioma.<div class="nw-sum">' + nwLangLine(p.por_idioma) + '</div>' +
      (nwFueraLine(p.fuera) ? '<div style="margin-top:2px">' + nwFueraLine(p.fuera) + '</div>' : '');
  }
  async function nwiSaveSeg(){
    if (!nwiCur || nwiCur.status !== 'draft') return;
    const seg = nwiSegNow();
    const row = { segment_stage: seg.segment_stage, segment_lang: seg.segment_lang,
      exclude_ids: seg.exclude_ids, exclude_emails: seg.exclude_emails, extra_emails: seg.extra_emails,
      updated_at: new Date().toISOString() };
    const { error } = await supabase.from('newsletter_issues').update(row).eq('id', nwiCur.id);
    if (error){ toast(/column/i.test(error.message || '') ? 'Falta correr el SQL 0123' : '⚠️ ' + error.message); return; }
    Object.assign(nwiCur, row);
  }
  const nwCtxIssue = () => ({
    id: 'nwi-recip-composer',
    titulo: '👥 Quién recibe la edición mensual',
    exclIds: nwiExcludeIds, exclEmails: nwiExcludeEmails, extras: nwiExtraEmails,
    fetch: (f) => nwiFetchPrev(f),
    onClose: async () => { await nwiSaveSeg(); nwiUpdateRecips(); },
  });
  async function nwiInit(){
    const { data, error } = await supabase.from('newsletter_issues').select('*').order('created_at', { ascending: false }).limit(24);
    if (error){ $('nwi-list').innerHTML = '<p class="muted-note">Falta correr el SQL 0114 — ' + esc(error.message) + '</p>'; return; }
    nwiList = data || [];
    const pend = nwiList.filter((i) => i.status === 'draft').length;
    $('nwi-count').textContent = pend ? pend + ' para revisar' : '';
    /* Las descartadas se acumulan y tapan la que importa. El botón solo aparece si hay
       algo que borrar: uno que casi siempre no hace nada se aprieta sin leer.
       (Sebastián, 2 sep 2026: "dejame borrar los newsletters automáticos descartados".) */
    const desc = nwiList.filter((i) => i.status === 'discarded');
    const bl = $('nwi-limpiar');
    if (bl){ bl.hidden = !desc.length; bl.textContent = '🗑 Borrar descartadas (' + desc.length + ')'; }
    $('nwi-list').innerHTML = nwiList.map((n) => {
      const badge = n.status === 'sent' ? '<span class="of-badge" style="color:var(--won);border-color:currentColor">✅ ' + (n.sent_count || 0) + ' enviados</span>'
        : n.status === 'discarded' ? '<span class="of-badge" style="color:#8a93a6;border-color:currentColor">Descartada</span>'
        : '<span class="of-badge" style="color:#f0c060;border-color:currentColor">⏳ Esperando aprobación</span>';
      const subj = (n.content && n.content.en && n.content.en.subject) || '(sin asunto)';
      return '<div class="of-card" style="margin-bottom:8px"><div class="of-card-open" data-nwi="' + n.id + '">' +
        '<div class="of-card-main"><div class="of-card-title">📬 ' + esc(n.month) + ' — ' + esc(subj) + '</div>' +
        '<div class="of-card-sub">' + new Date(n.created_at).toLocaleDateString('es-CH', { day: '2-digit', month: 'short' }) + (n.approved_by ? ' · aprobada por ' + esc(n.approved_by) : '') + '</div></div>' + badge + '</div></div>';
    }).join('') || '<p class="muted-note">Sin ediciones todavía — el cron arma la primera el próximo primer martes del mes, o generala ahora con «Generar draft ahora».</p>';
    $('nwi-list').querySelectorAll('[data-nwi]').forEach((c) => c.addEventListener('click', () => {
      nwiCur = nwiList.find((x) => x.id === c.dataset.nwi) || null; if (!nwiCur) return;
      $('nwi-detail').hidden = false;
      $('nwi-send').hidden = nwiCur.status !== 'draft';
      $('nwi-send').textContent = nwProximoHuecoSiFueraDeHorario() ? '⏰ Fuera de horario · aprobar y programar' : '✅ Aprobar y enviar';
      const esDraft = nwiCur.status === 'draft';
      if ($('nwi-prog')) $('nwi-prog').hidden = !esDraft;
      if ($('nwi-at')){
        $('nwi-at').hidden = !esDraft;
        /* Precargado mañana a las 09:00: es lo que se pide casi siempre y evita tipear una
           fecha entera para el caso normal. */
        if (!$('nwi-at').value){
          const m = new Date(); m.setDate(m.getDate() + 1); m.setHours(9, 0, 0, 0);
          $('nwi-at').value = new Date(m.getTime() - m.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        }
      }
      $('nwi-discard').hidden = nwiCur.status !== 'draft';
      $('nwi-note').textContent = nwiCur.status === 'sent' ? 'Ya enviada — solo lectura.' : nwiCur.status === 'discarded' ? 'Descartada — solo lectura.' : '';
      // destinatarios guardados de esta edición
      nwiExcludeIds = new Set((nwiCur.exclude_ids || []).map(String));
      nwiExcludeEmails = new Set((nwiCur.exclude_emails || []).map((x) => String(x).toLowerCase()));
      nwiExtraEmails = (nwiCur.extra_emails || []).slice();
      if ($('nwi-stage')) $('nwi-stage').value = nwiCur.segment_stage || 'all';
      if ($('nwi-lang')) $('nwi-lang').value = nwiCur.segment_lang || 'all';
      const soloLectura = nwiCur.status !== 'draft';
      ['nwi-stage', 'nwi-lang', 'nwi-recips-btn'].forEach((k) => { if ($(k)) $(k).disabled = soloLectura; });
      nwiPrev = null; nwiPrevKey = '';
      nwiUpdateRecips();
      nwiShowLang('en');
      $('nwi-detail').scrollIntoView({ behavior: 'smooth' });
    }));
  }
  function nwiShowLang(lg){
    if (!nwiCur) return;
    const lang = lg || 'en';
    document.querySelectorAll('.nwi-lang').forEach((b) => b.classList.toggle('btn-primary', b.dataset.lg === lang));
    const ct = (nwiCur.content || {})[lang] || {};
    $('nwi-subject').innerHTML = '<b>Asunto (' + lang.toUpperCase() + '):</b> ' + esc(ct.subject || '(vacío)') + (ct.ai === false ? ' · <b style="color:#f0c060">⚠️ copy de respaldo (la IA falló) — regenerá el draft o revisá el texto</b>' : '');
    // preview client-side espejo del wrapper de newsletter-send (saludo DE = "Guten Tag" formal, sin nombre)
    /* En el preview el saludo va con un nombre DE EJEMPLO y dicho como tal. Antes decía
       «Hi <name>,» y se lee como una etiqueta rota justo antes de apretar enviar — que es
       el peor momento para dudar. En el envío real sale el nombre de cada persona, y si no
       lo tenemos cargado no sale saludo (nunca un placeholder).
       (Sebastián, 2 sep 2026.) */
    const ejemploN = lang === 'de' ? '' : (lang === 'es' ? 'Hola María,' : 'Hi Anna,');
    const greet = ejemploN
      ? '<p style="margin:0 0 16px;font-size:15px;color:#222">' + ejemploN +
        ' <span style="font-size:12px;color:#8a93a6">← ejemplo: va el nombre de cada uno</span></p>'
      : '<p style="margin:0 0 16px;font-size:15px;color:#222">Guten Tag</p>';
    const html = '<!doctype html><body style="margin:0;background:#f4f5f7;font-family:Helvetica,Arial,sans-serif"><div style="max-width:600px;margin:0 auto;padding:28px 16px">' +
      '<div style="background:#0f1826;border-radius:14px 14px 0 0;padding:18px 26px"><img src="https://www.viven.ch/assets/brand/viven-logo-email.png" alt="VIVEN" height="24" style="height:24px" /></div>' +
      '<div style="background:#fff;border-radius:0 0 14px 14px;padding:30px 26px">' + greet + (ct.html || '<p>(sin contenido)</p>') +
      '<p style="margin:22px 0 0;font-size:14px;color:#444">' + (NW_FIRMA[lang] || NW_FIRMA.en) + '</p></div>' +
      '<p style="text-align:center;font-size:11.5px;color:#9aa;margin-top:16px">VIVEN AG · Zürich · viven.ch · (link de baja por suscriptor)</p></div></body>';
    $('nwi-preview').setAttribute('srcdoc', html);
  }

  /* El catálogo de proyectos: la MISMA lista para el desplegable y para la IA, así lo que
     ves elegir es exactamente lo que el modelo puede usar. Sale de STILLS_POOL, que arma
     el build desde projects.json — los mismos datos de la galería del sitio. */
  function nwCatalogo(){
    return (window.STILLS_POOL || [])
      .filter((g) => g && g.client && (g.stills || []).length)
      .map((g) => ({ cliente: String(g.client), still: String(g.stills[0]) }))
      .sort((a, b) => a.cliente.localeCompare(b.cliente))
      .slice(0, 40);
  }
  function nwLlenarProyectos(){
    const sel = $('nw-ai-proj'); if (!sel || sel.dataset.listo) return;
    const cat = nwCatalogo();
    if (!cat.length) return;
    sel.dataset.listo = '1';
    sel.innerHTML = '<option value="">— que elija la IA —</option>' +
      cat.map((c) => '<option value="' + esc(c.still) + '">' + esc(c.cliente) + '</option>').join('');
  }

  async function newsInit(){
    nwLlenarProyectos();
    nwiInit();
    const [nlRes, sendsRes] = await Promise.all([
      supabase.from('newsletters').select('*').order('created_at', { ascending: false }),
      supabase.from('newsletter_sends').select('newsletter_id,lead_id,opened_at,clicked_at'),
    ]);
    if (nlRes.error){ $('nw-list').innerHTML = '<p class="muted-note">Falta correr el SQL 0039 — ' + esc(nlRes.error.message) + '</p>'; return; }
    nwList = nlRes.data || [];
    const sends = sendsRes.error ? [] : (sendsRes.data || []);   // sin columnas de tracking (SQL 0075) → sin métricas
    $('nw-listcount').textContent = nwList.length || '';
    // editor: inicializar si está vacío
    if (!$('nw-editor').children.length) nwRenderEditor();
    nwRenderLangTabs();
    nwUpdateSendPanel();

    // agregado de envíos por campaña
    const agg = {};
    sends.forEach((s) => { const a = agg[s.newsletter_id] = agg[s.newsletter_id] || { n: 0, open: 0, click: 0, openLeads: [] }; a.n++; if (s.opened_at){ a.open++; if (s.lead_id) a.openLeads.push(s.lead_id); } if (s.clicked_at) a.click++; });

    // KPI mini — "Suscriptos" sale del servidor (misma función que el envío),
    // sin segmento ni exclusiones: es toda la lista.
    if ($('nw-kmini-subs')){
      $('nw-kmini-subs').textContent = '…';
      supabase.functions.invoke('newsletter-send', { body: { preview: true, segment_stage: 'all', segment_lang: 'all', exclude_ids: [], extra_emails: [] } })
        .then(({ data, error }) => {
          const n = (error || !data || data.error) ? null : data.total;
          $('nw-kmini-subs').textContent = n == null ? '?' : n;
          /* El número en el encabezado del paso ①: saber a cuántos le llega no debería
             requerir abrir nada. Sale del MISMO preview del servidor que usa el envío
             —no de una cuenta hecha acá— así que lo que dice es lo que va a salir. */
          const e1 = $('nw-paso1-n');
          if (e1 && n != null){
            /* Además del total, POR IDIOMA — y del MISMO desglose que ya calcula el
               servidor (p.por_idioma), no de una cuenta hecha acá. El cuerpo del email
               sale igual para todos —solo el saludo, el pie y el destino del botón
               cambian por idioma— así que saber que 9 de 33 son de habla alemana antes
               de escribir cambia lo que escribís. (Sebastián, 25 ago: "¿sale también
               con el idioma de cada uno?" — a medias, y esta es la mitad que hay que
               ver antes de escribir.) */
            const det = Object.entries(data.por_idioma || {}).filter(([, c]) => c > 0)
              .sort((a, b) => b[1] - a[1]).map(([L, c]) => c + ' ' + L.toUpperCase()).join(' · ');
            e1.textContent = n + (n === 1 ? ' persona' : ' personas') + (det ? ' · ' + det : '');
          }
        })
        .catch(() => { $('nw-kmini-subs').textContent = '?'; });
    }
    const lastSent = nwList.find((n) => n.status === 'sent');
    if ($('nw-kmini-open')){ if (lastSent){ const a = agg[lastSent.id] || { n: 0, open: 0 }; const sn = lastSent.sent_count || a.n; $('nw-kmini-open').textContent = sn ? Math.round(a.open / sn * 100) + '%' : '—'; } else $('nw-kmini-open').textContent = '—'; }
    if ($('nw-kmini-unsub')) $('nw-kmini-unsub').textContent = (allLeads || []).filter((l) => l.unsubscribed).length;

    // lista de campañas con atribución
    $('nw-list').innerHTML = nwList.map((n) => {
      const a = agg[n.id] || { n: 0, open: 0, click: 0, openLeads: [] };
      const sentN = n.sent_count || a.n;
      const date = new Date(n.sent_at || n.created_at).toLocaleDateString('es-CH', { day: '2-digit', month: 'short' });
      const seg = n.segment_stage === 'won' ? 'Clientes' : n.segment_stage === 'open' ? 'Prospectos' : 'Todos';
      let right;
      if (n.status === 'sent'){
        const openPct = sentN ? Math.round(a.open / sentN * 100) : 0;
        const clickPct = sentN ? Math.round(a.click / sentN * 100) : 0;
        // atribución directa (utm_campaign del lead) e influida (abrió → ganó en 30d)
        let directWon = 0; (allLeads || []).forEach((l) => { if (l.utm_campaign === 'nl-' + n.id){ const d = nwWonDeal(l.id); if (d) directWon += dealValue(d); } });
        const sentT = n.sent_at ? Date.parse(n.sent_at) : 0; let inflWon = 0; const seen = new Set();
        (a.openLeads || []).forEach((lid) => { if (seen.has(String(lid))) return; seen.add(String(lid)); const d = nwWonDeal(lid); if (!d) return; const wt = Date.parse(d.won_at || d.last_stage_at || ''); if (sentT && wt && wt >= sentT && wt <= sentT + 30 * 864e5) inflWon += dealValue(d); });
        let attr;
        if (directWon > 0) attr = '<b style="color:var(--won)">💰 ' + nwMoneyShort(directWon) + ' ganados</b>';
        else if (inflWon > 0) attr = '<b style="color:var(--won)">💰 ' + nwMoneyShort(inflWon) + ' influido</b>';
        else attr = '<span style="color:var(--muted-2)">sin ventas atribuidas</span>';
        right = '<span class="nw-pill ' + (openPct >= 35 ? 'ok' : 'warn') + '">' + openPct + '% abrió</span> <span class="nw-pill ' + (clickPct >= 5 ? 'ok' : 'warn') + '">' + clickPct + '% click</span><br/>' + attr;
      } else if (n.scheduled_at){
        /* el despachador no manda nada programado hace más de 48 h (guarda contra
           que un borrador viejo salga de golpe) — se avisa acá para reprogramar */
        const venc = Date.now() - Date.parse(n.scheduled_at) > 48 * 3600e3;
        const salida = venc ? null : nwProxSalida(new Date(Math.max(Date.now(), Date.parse(n.scheduled_at))));
        right = venc
          ? '<span class="nw-pill warn">⏰ venció — reprogramala</span>'
          : '<span class="nw-pill warn">⏰ ' + new Date(n.scheduled_at).toLocaleString('es-CH', { timeZone: 'Europe/Zurich', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) + '</span>' +
            (salida && Math.abs(salida - Date.parse(n.scheduled_at)) > 9e5 ? '<br/><span style="color:var(--muted-2)">sale ' + salida.toLocaleString('es-CH', { timeZone: 'Europe/Zurich', weekday: 'short', hour: '2-digit', minute: '2-digit' }) + '</span>' : '');
      } else {
        right = '<span class="of-badge" style="color:#8ab4ff;border-color:currentColor">Borrador</span>';
      }
      return '<div class="nw-sr clickable" data-nw="' + n.id + '"><div style="min-width:0"><div class="tt">' + esc(n.subject) + '</div>' +
        '<div class="sub">' + date + ' · ' + seg + ' · ' + (n.status === 'sent' ? sentN + ' enviados' : 'sin enviar') + '</div></div>' +
        '<div class="st2">' + right + '</div></div>';
    }).join('') || '<p class="muted-note">Sin campañas todavía.</p>';

    $('nw-list').querySelectorAll('[data-nw]').forEach((c) => c.addEventListener('click', () => {
      const n = nwList.find((x) => x.id === c.dataset.nw); if (!n) return;
      nwCur = n.status === 'sent' ? null : n;
      $('nw-stage').value = n.segment_stage; $('nw-lang').value = n.segment_lang;
      /* Las tres versiones. Una campaña vieja (sin i18n) entra como versión inglesa:
         es lo que de hecho recibieron todos, así que ponerla ahí es describir lo que
         pasó, no inventar una traducción que nunca existió. */
      const bi = n.blocks_i18n || {}, si = n.subject_i18n || {};
      nwI18n = { en: { subject: '', blocks: [] }, de: { subject: '', blocks: [] }, es: { subject: '', blocks: [] } };
      ['en', 'de', 'es'].forEach((lg) => {
        if (Array.isArray(bi[lg]) && bi[lg].length) nwI18n[lg] = { subject: si[lg] || '', blocks: bi[lg].map((b) => ({ ...b })) };
      });
      if (!nwI18n.en.blocks.length) nwI18n.en = { subject: n.subject || '', blocks: nwBlocksFromRow(n) };
      nwCargarTab('en');
      nwExcludeIds = new Set((n.exclude_ids || []).map(String)); nwExcludeEmails = new Set((n.exclude_emails || []).map((x) => String(x).toLowerCase())); nwExtraEmails = (n.extra_emails || []).slice();
      if (n.scheduled_at && n.status !== 'sent'){ $('nw-sched-mode').value = 'at'; $('nw-sched-at').hidden = false; try { $('nw-sched-at').value = new Date(n.scheduled_at).toISOString().slice(0, 16); } catch (e) {} }
      else { $('nw-sched-mode').value = 'now'; $('nw-sched-at').hidden = true; }
      $('nw-note').textContent = n.status === 'sent' ? 'Cargada como COPIA (la original ya se envió) — al enviar se crea una campaña nueva.' : 'Borrador cargado.';
      nwUpdateSendPanel();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }));
  }
  async function nwSave(){
    nwGuardarTab();   // lo que estás editando ahora entra en su idioma antes de guardar
    const cleanBlocks = nwBlocks.map((b) => ({ ...b })).filter((b) => b.type !== 'text' || String(b.text || '').trim());
    const body = nwDerivedBody();
    const hasContent = body.trim() || cleanBlocks.some((b) => b.type !== 'text');
    const subject = $('nw-subject').value.trim();
    if (!subject || !hasContent){ toast('Falta asunto o contenido'); return null; }
    const schedAt = ($('nw-sched-mode') && $('nw-sched-mode').value === 'at' && $('nw-sched-at').value) ? new Date($('nw-sched-at').value).toISOString() : null;
    /* Las tres versiones van a blocks_i18n/subject_i18n (SQL 0145). Los campos planos
       (subject/body/blocks) siguen guardándose con la versión que estás editando: así
       una campaña abierta con una versión vieja del dashboard, o el preview de otra
       pantalla, siguen encontrando algo. */
    const i18nB = {}, i18nS = {};
    ['en', 'de', 'es'].forEach((lg) => {
      const v = nwI18n[lg] || {};
      const bs = (v.blocks || []).map((b) => ({ ...b })).filter((b) => b.type !== 'text' || String(b.text || '').trim());
      if (String(v.subject || '').trim() && bs.length){ i18nB[lg] = bs; i18nS[lg] = String(v.subject).trim(); }
    });
    const row = { subject, body, blocks: cleanBlocks, blocks_i18n: i18nB, subject_i18n: i18nS, scheduled_at: schedAt, segment_stage: $('nw-stage').value, segment_lang: $('nw-lang').value, exclude_ids: [...nwExcludeIds].map(Number), exclude_emails: [...nwExcludeEmails], extra_emails: nwExtraEmails.slice(), updated_at: new Date().toISOString() };
    const saveRow = async (r) => {
      if (nwCur && nwCur.id){ const { error } = await supabase.from('newsletters').update(r).eq('id', nwCur.id); return { id: nwCur.id, error }; }
      const { data, error } = await supabase.from('newsletters').insert(r).select().single(); if (!error) nwCur = data; return { id: data && data.id, error };
    };
    let { id, error } = await saveRow(row);
    if (error && /blocks_i18n|subject_i18n/i.test(error.message || '')){
      // base sin el SQL 0145: se guarda igual, en un solo idioma
      const sinI18n = { ...row }; delete sinI18n.blocks_i18n; delete sinI18n.subject_i18n;
      ({ id, error } = await saveRow(sinI18n));
      if (!error) toast('Guardado en un solo idioma — falta correr el SQL 0145');
    }
    if (error && /blocks|scheduled_at|exclude_emails|column/i.test(error.message || '')){
      const legacy = { subject: row.subject, body: row.body, segment_stage: row.segment_stage, segment_lang: row.segment_lang, exclude_ids: row.exclude_ids, extra_emails: row.extra_emails, updated_at: row.updated_at };   // sin exclude_emails: base sin el SQL 0122
      ({ id, error } = await saveRow(legacy));
      if (!error) toast('Guardado sin bloques/programación — corré el SQL 0075');
    }
    if (error){ toast(/does not exist|relation/i.test(error.message) ? 'Falta correr el SQL 0039' : error.message); return null; }
    return id;
  }
  /* ===== overlays "quiénes son" =====
     Los tres números del panel (Suscriptos / Apertura / Bajas) y el botón
     "Ver / editar lista" abren una lista de gente real. Pedido de Sebastián
     (12 ago 2026): "todos esos números me tienen que mostrar quiénes se dieron
     de baja, quiénes están suscriptos, etc." */
  const NW_LG = { de: '🇩🇪 DE', en: '🇬🇧 EN', es: '🇪🇸 ES' };
  function nwPersonRow(p, izq, der){
    const nm = p.name || String(p.email || '').split('@')[0];
    return '<div class="nw-prow">' + (izq || '') +
      '<div class="who"><div class="nm">' + esc(nm) + '</div><div class="em">' + esc(p.email || '') + '</div></div>' +
      '<span class="nw-lgtag">' + (NW_LG[p.lang] || NW_LG.en) + '</span>' + (der || '') + '</div>';
  }
  // overlay reutilizable con buscador
  function nwBox(o){
    let ov = $(o.id); if (!ov){ ov = document.createElement('div'); ov.id = o.id; document.body.appendChild(ov); }
    ov.className = 'of-composer';
    ov.innerHTML = '<div class="ofc-card nw-peoplecard" style="max-width:520px">' +
      '<h3 style="margin:0 0 4px">' + o.title + '</h3>' +
      '<div class="muted-note" style="margin:0 0 8px" id="' + o.id + '-sub">' + (o.sub || '') + '</div>' +
      (o.head || '') +
      (o.buscador === false ? '' : '<input class="nw-ov-inp" id="' + o.id + '-q" placeholder="buscar por nombre o email" style="width:100%;margin-top:4px" />') +
      '<div class="nw-plist" id="' + o.id + '-list"></div>' +
      (o.foot || '') +
      '<div style="display:flex;gap:8px;margin-top:12px"><button class="btn btn-primary small" data-nwclose="1" type="button">Listo</button></div></div>';
    const cerrar = () => { ov.remove(); if (o.onClose) o.onClose(); };
    ov.querySelector('[data-nwclose]').addEventListener('click', cerrar);
    ov.addEventListener('click', (e) => { if (e.target === ov) cerrar(); });
    return ov;
  }
  const nwMatch = (p, q) => !q || (String(p.name || '') + ' ' + String(p.email || '')).toLowerCase().includes(q);

  // --- 1) el botón "Ver / editar lista" de la campaña -------------------------
  /* Un solo panel de destinatarios para los dos caminos: la campaña manual y la
     edición mensual. El `ctx` dice de dónde sale y a dónde vuelve el estado; el
     filtro y el total siguen viniendo del servidor en los dos casos. */
  const nwCtxCampana = () => ({
    id: 'nw-recip-composer',
    titulo: '👥 Quién recibe esta campaña',
    exclIds: nwExcludeIds, exclEmails: nwExcludeEmails, extras: nwExtraEmails,
    fetch: (f) => nwFetchPrev(f),
    onClose: async () => { if ($('nw-subject').value.trim() && nwDerivedBody().trim()) await nwSave(); nwUpdateSendPanel(); },
  });
  /* ===== EL CUERPO NO SE TRADUCE =====
     Lo que SÍ sale en el idioma de cada persona: el saludo (greeting), el pie con la
     firma, el link de baja y el destino del botón (/de/book/ vs /en/book/).
     Lo que NO: el asunto, el texto que escribís y la etiqueta del botón — eso es uno
     solo para todos. Medido el 25 ago: de los 33 destinatarios, 24 son EN y 9 DE, o
     sea que más de uno de cada cuatro recibiría "Guten Tag" y después texto en inglés,
     que se lee peor que no traducir nada.
     No se traduce solo a propósito: una traducción automática de un newsletter
     comercial se nota, y el selector de idioma ya permite mandar uno por idioma. Lo
     que faltaba era decirlo antes de apretar Enviar. */
  function nwAvisoIdiomas(porIdioma){
    const el = $('nw-aviso-lang'); if (!el) return;
    const langs = Object.entries(porIdioma || {}).filter(([, c]) => c > 0).sort((a, b) => b[1] - a[1]);
    if (langs.length < 2){ el.hidden = true; return; }
    const NOMBRE = { en: 'inglés', de: 'alemán', es: 'español' };
    el.hidden = false;
    el.innerHTML = '⚠️ Van <b>' + langs.length + ' idiomas</b> en el mismo envío (' +
      langs.map(([L, c]) => c + ' en ' + (NOMBRE[L] || L)).join(' · ') + '). ' +
      'El saludo y el pie salen en el idioma de cada uno, pero <b>el texto que escribís va igual para todos</b>. ' +
      'Si querés cada uno en su idioma, filtrá por idioma arriba y mandá uno por vez.';
  }
  async function nwShowRecipients(ctx){
    ctx = ctx || nwCtxCampana();
    const EXCL = ctx.exclIds, EXCLEM = ctx.exclEmails, EXTRAS = ctx.extras;
    const ov = nwBox({
      id: ctx.id,
      title: ctx.titulo,
      sub: 'Leyendo del servidor…',
      head: '<div style="display:flex;gap:8px;margin-bottom:8px"><input id="nw-recip-add" class="nw-ov-inp" type="email" placeholder="agregar un email suelto" style="flex:1" /><button class="btn btn-ghost small" id="nw-recip-add-btn" type="button">➕</button></div><div id="nw-recip-equipo"></div><div id="nw-recip-extra"></div>',
      foot: '<p class="muted-note" style="margin-top:10px">Destildar saca a esa persona de este envío. La selección se guarda con el borrador. El total lo calcula la misma función que hace el envío.</p>',
      onClose: ctx.onClose,
    });
    const $sub = ov.querySelector('#' + ctx.id + '-sub');
    const $list = ov.querySelector('#' + ctx.id + '-list');
    const $extra = ov.querySelector('#nw-recip-extra');
    const $q = ov.querySelector('#' + ctx.id + '-q');

    // la gente del segmento sale del servidor; los ticks son locales y el TOTAL
    // se vuelve a pedir al servidor (con debounce) para que nunca sea una cuenta mía
    let gente = [];
    // el desglose tiene que SUMAR al total, si no el número no se explica
    const pintarTotal = (p) => {
      if (!p){ $sub.innerHTML = '⚠️ ' + esc(nwPrevErr || 'no se pudo contar'); return; }
      const nEquipo = (p.recips || []).filter((r) => r.equipo).length;
      const nSueltos = (p.recips || []).filter((r) => r.manual && !r.equipo).length;
      const nSeg = p.total - nEquipo - nSueltos;
      const partes = [nSeg + ' del segmento'];
      if (nEquipo) partes.push(nEquipo + ' del equipo');
      if (nSueltos) partes.push(nSueltos + (nSueltos === 1 ? ' agregado a mano' : ' agregados a mano'));
      $sub.innerHTML = '<b style="color:var(--acid)">' + p.total + '</b> destinatario' + (p.total === 1 ? '' : 's') +
        ' — ' + partes.join(' + ') +
        '<div class="nw-sum">' + nwLangLine(p.por_idioma) + '</div>' +
        (nwFueraLine(p.fuera) ? '<div style="margin-top:4px">' + nwFueraLine(p.fuera) + '</div>' : '');
    };
    let tmr = null;
    const refrescarTotal = () => {
      $sub.innerHTML = 'Contando en el servidor…';
      clearTimeout(tmr);
      tmr = setTimeout(async () => pintarTotal(await ctx.fetch(true)), 350);
    };
    const pintarLista = () => {
      const q = ($q && $q.value || '').trim().toLowerCase();
      const vis = gente.filter((p) => nwMatch(p, q));
      $list.innerHTML = vis.map((p) => {
        const fuera = p.id != null && EXCL.has(String(p.id));
        const cb = '<input type="checkbox" data-lid="' + p.id + '"' + (fuera ? '' : ' checked') + ' style="flex:none" />';
        return '<label style="display:block' + (fuera ? ';opacity:.45' : '') + '">' + nwPersonRow(p, cb) + '</label>';
      }).join('') || '<p class="muted-note">' + (q ? 'Nadie con ese nombre o email.' : 'Nadie matchea este segmento.') + '</p>';
      $list.querySelectorAll('[data-lid]').forEach((cb) => cb.addEventListener('change', () => {
        const lid = cb.dataset.lid;
        if (cb.checked) EXCL.delete(lid); else EXCL.add(lid);
        pintarLista(); refrescarTotal();
      }));
    };
    const pintarExtras = () => {
      $extra.innerHTML = EXTRAS.map((em, i) => '<div class="nw-prow"><div class="who"><div class="nm">' + esc(em) + '</div><div class="em">agregado a mano</div></div><button type="button" class="nw-recip-x" data-i="' + i + '" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:15px">✕</button></div>').join('');
      $extra.querySelectorAll('.nw-recip-x').forEach((b) => b.addEventListener('click', () => {
        EXTRAS.splice(+b.dataset.i, 1); pintarExtras(); refrescarTotal();
      }));
    };

    // el equipo va siempre (no sale de los leads, no se puede destildar acá) —
    // se muestra igual, porque un total sin la gente que lo explica no sirve
    /* El equipo se agrega solo, pero TAMBIEN con check: Sebastian elige a quien,
       incluido a si mismo, campana por campana (12 ago 2026). No tienen lead_id,
       asi que se destildan por direccion (exclude_emails, SQL 0122). */
    const pintarEquipo = (p) => {
      const eq = (p.recips || []).filter((r) => r.equipo)
        .concat((p.sacados || []).filter((r) => r.equipo))
        .sort((a, b) => String(a.email).localeCompare(String(b.email)));
      const box = ov.querySelector('#nw-recip-equipo');
      box.innerHTML = eq.length
        ? eq.map((r) => {
            const fuera = EXCLEM.has(String(r.email).toLowerCase());
            const cb = '<input type="checkbox" data-lem="' + esc(r.email) + '"' + (fuera ? '' : ' checked') + ' style="flex:none" />';
            return '<label style="display:block' + (fuera ? ';opacity:.45' : '') + '">' +
              nwPersonRow(r, cb, '<span class="nw-lgtag">equipo</span>') + '</label>';
          }).join('')
        : '';
      box.querySelectorAll('[data-lem]').forEach((cb) => cb.addEventListener('change', () => {
        const em = String(cb.dataset.lem).toLowerCase();
        if (cb.checked) EXCLEM.delete(em); else EXCLEM.add(em);
        ctx.fetch(true).then((p2) => { if (p2){ pintarTotal(p2); pintarEquipo(p2); } });
      }));
    };

    const p = await ctx.fetch(true);
    if (!p){ $sub.innerHTML = '⚠️ ' + esc(nwPrevErr || 'no se pudo leer'); $list.innerHTML = ''; return; }
    // el segmento completo = los que reciben (menos los sueltos y el equipo) + los sacados a mano
    gente = (p.recips || []).filter((r) => !r.manual).concat(p.sacados || [])
      .sort((a, b) => String(a.name || a.email).localeCompare(String(b.name || b.email)));
    pintarTotal(p); pintarLista(); pintarExtras(); pintarEquipo(p);
    if ($q) $q.addEventListener('input', pintarLista);
    ov.querySelector('#nw-recip-add-btn').addEventListener('click', () => {
      const inp = ov.querySelector('#nw-recip-add'), em = inp.value.trim().toLowerCase();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)){ toast('Poné un email válido'); return; }
      if (gente.some((r) => String(r.email || '').toLowerCase() === em) || EXTRAS.includes(em)){ toast('Ese email ya está en la lista'); return; }
      EXTRAS.push(em); inp.value = ''; pintarExtras(); refrescarTotal();
    });
  }

  // --- 2) KPI "Suscriptos" → toda la base que recibe el newsletter -----------
  async function nwShowSubs(){
    const ov = nwBox({ id: 'nw-subs-box', title: '📮 Quiénes reciben el newsletter', sub: 'Leyendo del servidor…' });
    const $sub = ov.querySelector('#nw-subs-box-sub'), $list = ov.querySelector('#nw-subs-box-list'), $q = ov.querySelector('#nw-subs-box-q');
    // base entera, sin segmento ni exclusiones: esto es "toda la lista"
    const { data, error } = await supabase.functions.invoke('newsletter-send', { body: { preview: true, segment_stage: 'all', segment_lang: 'all', exclude_ids: [], extra_emails: [] } });
    if (error || !data || data.error){ $sub.innerHTML = '⚠️ ' + esc((error && error.message) || (data && data.error)); return; }
    const gente = (data.recips || []).slice().sort((a, b) => String(a.name || a.email).localeCompare(String(b.name || b.email)));
    $sub.innerHTML = '<b style="color:var(--acid)">' + data.total + '</b> personas, cada una en su idioma.' +
      '<div class="nw-sum">' + nwLangLine(data.por_idioma) + '</div>' +
      (nwFueraLine(data.fuera) ? '<div style="margin-top:4px">' + nwFueraLine(data.fuera) + '</div>' : '') +
      '<div style="margin-top:4px;color:var(--muted-2)">No hay lista de suscriptores aparte: es la base de leads con email, menos bajas, spam/descartados, repetidos y el grupo Follow up (clientes viejos de bexio)' +
      ((data.recips || []).some((r) => r.equipo) ? ', más las casillas del equipo (marcadas «equipo»), que reciben siempre para que veas lo que sale afuera' : '') + '.</div>';
    const pintar = () => {
      const q = ($q.value || '').trim().toLowerCase();
      const vis = gente.filter((p) => nwMatch(p, q));
      $list.innerHTML = vis.map((p) => nwPersonRow(p, '', p.equipo ? '<span class="nw-lgtag">equipo</span>' : '')).join('') || '<p class="muted-note">Nadie con ese nombre o email.</p>';
    };
    pintar(); $q.addEventListener('input', pintar);
  }

  // --- 3) KPI "Apertura últ. envío" → quién abrió y quién no -----------------
  async function nwShowOpens(){
    const last = (nwList || []).find((n) => n.status === 'sent');
    if (!last){ toast('Todavía no hay ninguna campaña enviada'); return; }
    const ov = nwBox({ id: 'nw-open-box', title: '👀 Quién abrió el último envío', sub: 'Leyendo…' });
    const $sub = ov.querySelector('#nw-open-box-sub'), $list = ov.querySelector('#nw-open-box-list'), $q = ov.querySelector('#nw-open-box-q');
    const { data, error } = await supabase.from('newsletter_sends').select('email,lead_id,opened_at,clicked_at').eq('newsletter_id', last.id);
    if (error){ $sub.innerHTML = '⚠️ ' + esc(error.message); return; }
    const byId = new Map((allLeads || []).map((l) => [String(l.id), l]));
    const gente = (data || []).map((s) => {
      const l = s.lead_id != null ? byId.get(String(s.lead_id)) : null;
      return { id: s.lead_id, email: s.email, name: (l && (l.first_name || l.name)) || '', lang: (l && l.lang) || 'en', abrio: !!s.opened_at, click: !!s.clicked_at, cuando: s.opened_at };
    }).sort((a, b) => (b.abrio - a.abrio) || String(a.name || a.email).localeCompare(String(b.name || b.email)));
    const nAbrio = gente.filter((p) => p.abrio).length, nClick = gente.filter((p) => p.click).length;
    $sub.innerHTML = '«' + esc(last.subject) + '» · enviado a <b style="color:var(--acid)">' + gente.length + '</b>' +
      '<div class="nw-sum"><span>Abrieron <b>' + nAbrio + '</b></span><span>Clickearon <b>' + nClick + '</b></span><span>Sin abrir <b>' + (gente.length - nAbrio) + '</b></span></div>' +
      (nAbrio === 0 ? '<div style="margin-top:4px;color:var(--muted-2)">0 aperturas puede ser real, o que el tracking de Resend no esté llegando (webhook resend-events).</div>' : '');
    const pintar = () => {
      const q = ($q.value || '').trim().toLowerCase();
      $list.innerHTML = gente.filter((p) => nwMatch(p, q)).map((p) => nwPersonRow(p, '',
        '<span class="nw-lgtag" style="' + (p.abrio ? 'border-color:var(--won);color:var(--won)' : '') + '">' + (p.click ? '🖱 click' : p.abrio ? '👀 abrió' : 'sin abrir') + '</span>',
      )).join('') || '<p class="muted-note">Nadie con ese nombre o email.</p>';
    };
    pintar(); $q.addEventListener('input', pintar);
  }

  // --- 4) KPI "Bajas" → quiénes se dieron de baja ----------------------------
  function nwShowUnsubs(){
    const ov = nwBox({ id: 'nw-unsub-box', title: '🚫 Quiénes se dieron de baja' });
    const $sub = ov.querySelector('#nw-unsub-box-sub'), $list = ov.querySelector('#nw-unsub-box-list'), $q = ov.querySelector('#nw-unsub-box-q');
    const gente = (allLeads || []).filter((l) => l.unsubscribed).map((l) => ({
      id: l.id, email: l.email, name: l.first_name || l.name || '', lang: l.lang || 'en', empresa: l.company || '',
    })).sort((a, b) => String(a.name || a.email).localeCompare(String(b.name || b.email)));
    $sub.innerHTML = gente.length
      ? '<b style="color:var(--acid)">' + gente.length + '</b> ' +
        (gente.length === 1 ? 'persona pidió no recibir más. No entra en ningún envío, ni siquiera si la agregás' : 'personas pidieron no recibir más. No entran en ningún envío, ni siquiera si las agregás') + ' a mano.'
      : 'Nadie se dio de baja todavía.';
    const pintar = () => {
      const q = ($q.value || '').trim().toLowerCase();
      $list.innerHTML = gente.filter((p) => nwMatch(p, q)).map((p) => nwPersonRow(p, '', p.empresa ? '<span class="nw-lgtag">' + esc(p.empresa) + '</span>' : '')).join('') ||
        '<p class="muted-note">' + (q ? 'Nadie con ese nombre o email.' : 'Sin bajas.') + '</p>';
    };
    pintar(); $q.addEventListener('input', pintar);
  }
  // Embudo real por video (rediseño): arranque→25→50→75→100 con Leads Y Ganados.
  // "Arrancó" en 0 con la bandera "no contabilizado" señala el hueco que existía
  // antes del fix de site.js (embeds sueltos sin openVideo() no sumaban play) —
  // filas viejas (previas al fix) también pueden mostrar esto si no tuvieron pct=0.
  function renderVideoAna(plays, leadsArr){
    const box = $('ka-video-table'); if (!box) return;
    const kpisEl = $('va-kpis');
    if (!plays.length){ box.innerHTML = '<p class="muted-note">Sin reproducciones en el período.</p>'; if (kpisEl) kpisEl.innerHTML = ''; return; }
    const leadSess = new Set((leadsArr || []).map((l) => l.session_id).filter(Boolean));
    const wonLeadIds = new Set((dealsList || []).filter((d) => stageOf(d.stage) === 'ganado').map((d) => String(d.lead_id)));
    const wonSess = new Set((leadsArr || []).filter((l) => l.session_id && wonLeadIds.has(String(l.id))).map((l) => l.session_id));
    const by = {};
    plays.forEach((p) => {
      const k = p.label || p.video_id;
      const b = by[k] = by[k] || { videoId: p.video_id, plays: 0, m: { 25: 0, 50: 0, 75: 0, 100: 0 }, sess: new Set(), maxBy: {} };
      const pct = +p.pct || 0;
      if (!pct){ b.plays++; if (p.session_id) b.sess.add(p.session_id); }
      else if (b.m[pct] !== undefined) b.m[pct]++;
      if (p.session_id) b.maxBy[p.session_id] = Math.max(b.maxBy[p.session_id] || 0, pct);
    });
    const rows = Object.entries(by).sort((a2, b2) => b2[1].plays - a2[1].plays);
    const leadIdBySess = {};
    (leadsArr || []).forEach((l) => { if (l.session_id) leadIdBySess[l.session_id] = l.id; });

    // KPIs globales del período
    const totalPlays = rows.reduce((a2, [, b]) => a2 + b.plays, 0);
    const allMax = []; rows.forEach(([, b]) => Object.values(b.maxBy).forEach((v) => allMax.push(v)));
    const avgAll = allMax.length ? Math.round(allMax.reduce((a2, v) => a2 + v, 0) / allMax.length) : 0;
    const leadSessAll = new Set(), wonSessAll = new Set();
    rows.forEach(([, b]) => b.sess.forEach((s) => { if (leadSess.has(s)) leadSessAll.add(s); if (wonSess.has(s)) wonSessAll.add(s); }));
    const pctOf = (n) => totalPlays ? (n / totalPlays * 100).toFixed(1) + '% de las reproducciones' : '';
    if (kpisEl) kpisEl.innerHTML =
      '<div class="kpi"><div class="n">' + totalPlays.toLocaleString('de-CH') + '</div><div class="l">Reproducciones</div></div>' +
      '<div class="kpi"><div class="n">' + avgAll + '%</div><div class="l">Visto en promedio</div></div>' +
      '<div class="kpi"><div class="n">' + leadSessAll.size + '</div><div class="l">→ Lead <span class="muted-note">' + pctOf(leadSessAll.size) + '</span></div></div>' +
      '<div class="kpi"><div class="n" style="color:var(--acid)">' + wonSessAll.size + '</div><div class="l">→ Ganado <span class="muted-note">' + pctOf(wonSessAll.size) + '</span></div></div>';

    box.innerHTML = rows.map(([k, b]) => {
      const sess = Object.keys(b.maxBy);
      const avg = sess.length ? Math.round(sess.reduce((a2, s2) => a2 + b.maxBy[s2], 0) / sess.length) : 0;
      const leads = [...b.sess].filter((s2) => leadSess.has(s2)).length;
      const won = [...b.sess].filter((s2) => wonSess.has(s2)).length;
      const noStart = !b.plays; // hueco real (pre-fix): hitos sin ningún pct=0 asociado
      const steps = [['Arrancó', noStart ? null : b.plays], ['25%', b.m[25]], ['50%', b.m[50]], ['75%', b.m[75]], ['100%', b.m[100]]];
      const base = Math.max(b.plays, b.m[25], b.m[50], b.m[75], b.m[100], 1);
      let worstDrop = null, worstPct = 0;
      for (let i = 1; i < steps.length; i++){
        const prev = steps[i - 1][1] || 0, cur = steps[i][1] || 0;
        if (prev > 0){ const drop = (prev - cur) / prev; if (drop > worstPct){ worstPct = drop; worstDrop = steps[i - 1][0] + '→' + steps[i][0]; } }
      }
      const bars = steps.map(([label, v], i) => {
        const h = v ? Math.max(6, Math.round((v / base) * 100)) : 6;
        const isStartGap = i === 0 && noStart;
        return '<div class="bar' + (i === steps.length - 1 && !isStartGap ? ' finish' : '') + '" style="height:' + h + '%' + (isStartGap ? ';background:var(--line)' : '') + '"><span>' + label + '</span><b style="color:' + (isStartGap ? 'var(--muted)' : '#0f1826') + '">' + (v == null ? '?' : v) + '</b></div>';
      }).join('');
      const leadIds = [...new Set([...b.sess].map((s2) => leadIdBySess[s2]).filter(Boolean))];
      return '<div class="va-card"' + (leadIds.length ? ' data-lead-ids="' + esc(leadIds.join(',')) + '" style="cursor:pointer" title="Ir al lead"' : '') + '>' +
        '<div class="hd"><b>🎬 ' + esc(String(k).slice(0, 60)) + '</b><span>' + (noStart ? '0 reproducciones' : b.plays + ' reproducciones') + ' · Ø visto ' + avg + '%' +
          (noStart ? ' <span class="of-badge" style="color:#f0c060;border-color:#f0c060">no contabilizado</span>' : '') + '</span></div>' +
        '<div class="va-funnel">' + bars + '</div>' +
        '<div class="va-fstats"><span>👤 Leads: <b>' + (leads || '<span class="muted-note">— (sin datos)</span>') + '</b></span>' +
        '<span>🏆 Ganados: <b class="acid">' + (won || '<span class="muted-note">— (sin datos)</span>') + '</b></span>' +
        (worstDrop ? '<span>Caída más fuerte: <b>' + worstDrop + '</b> (−' + Math.round(worstPct * 100) + '%)</span>' : '') + '</div>' +
        '<div class="va-vimeo" data-vimeo-badge="' + esc(b.videoId || '') + '"></div>' +
      '</div>';
    }).join('');
    box.querySelectorAll('.va-card[data-lead-ids]').forEach((card) => {
      card.addEventListener('click', () => { const ids = card.dataset.leadIds.split(','); gotoTab('leads'); openLead(ids[0]); });
    });

    loadVimeoOfficial(rows); // best-effort — nunca bloquea lo de arriba
  }
  // dato EXTRA de Vimeo oficial (play count del propio Vimeo) si hay token configurado
  // (VIMEO_ACCESS_TOKEN) — sin token, vimeo-stats responde {pending:true} y no mostramos
  // nada acá: el tracking propio de arriba ya es la fuente principal y confiable.
  async function loadVimeoOfficial(rows){
    try {
      const ids = [...new Set(rows.map(([, b]) => b.videoId).filter(Boolean))];
      if (!ids.length) return;
      const { data, error } = await supabase.functions.invoke('vimeo-stats', { body: { video_ids: ids } });
      if (error || !data || data.pending || data.error) return;
      const stats = data.stats || {};
      document.querySelectorAll('#ka-video-table [data-vimeo-badge]').forEach((el) => {
        const vid = el.dataset.vimeoBadge, s = stats[vid];
        if (s && s.plays != null) el.textContent = '📊 Vimeo oficial: ' + Number(s.plays).toLocaleString('de-CH') + ' plays';
      });
    } catch (e) { /* best-effort */ }
  }
  function renderBlogList(){
    const box = $('bg-list'); if (!box) return;
    const menu = $('bl2-menu'); if (menu) menu.hidden = true;   // cerrar popover al re-render
    bl2RenderKpis(); bl2RenderCal();
    const groups = bl2Groups();
    const idx = bl2Views ? bl2Index() : null;
    const fdate = (t) => t ? new Date(t).toLocaleDateString('es-CH', { day: '2-digit', month: 'short' }) : '—';
    // badges EN/DE/ES: verde publicado · azul borrador · gris punteado = falta (click → generar)
    const badges = (g) => ['en', 'de', 'es'].map((l) => {
      /* Puede haber MÁS de una fila para el mismo idioma: el motor creó mellizas con
         segundos de diferencia (13:16:34 y 13:16:41) y las dos quedaron publicadas
         apuntando a la misma URL. `find` devolvía la primera y la otra desaparecía de
         la pantalla — por eso editar el artículo no cambiaba nada en la web: estabas
         editando la melliza que no está en vivo. Se prefiere la publicada para el
         estado, y si hay más de una se avisa. */
      const mismas = g.rows.filter((x) => x.lang === l);
      const r = mismas.find((x) => x.status === 'published') || mismas[0];
      if (!r) return '<button class="bl2-lang no" data-loc="' + l + '" data-id="' + esc(g.main.id) + '" type="button" title="Generar versión ' + LANGNAME[l] + ' (nativa)">+' + LANGNAME[l] + '</button>';
      if (mismas.length > 1){
        return '<span class="bl2-lang dr" style="border-color:#f0c060;color:#f0c060" title="' + LANGNAME[l]
          + ' — hay ' + mismas.length + ' versiones de este artículo en ' + LANGNAME[l] + '. La web sirve una sola: si editás la otra, no pasa nada. Abrilo y dejá una.">'
          + LANGNAME[l] + ' ⚠</span>';
      }
      /* Tres estados, no dos: publicado · publicado con cambios sin subir ·
         borrador. El del medio faltaba y era el confuso: propagar o editar un idioma
         ya publicado cambia el texto en la base pero la web sigue con el viejo hasta
         re-publicar, y nada lo decía. El puntito lo dice. */
      const pubCambiado = r.status === 'published' && r.published_at && r.updated_at
        && Date.parse(r.updated_at) > Date.parse(r.published_at) + 60000;
      return '<span class="bl2-lang ' + (r.status === 'published' ? 'pub' : 'dr') + (pubCambiado ? ' chg' : '') + '" title="' +
        LANGNAME[l] + (r.status !== 'published' ? ' — borrador, sin publicar'
          : pubCambiado ? ' — publicado, pero tiene cambios sin subir a la web' : ' — publicado y al día') +
        '">' + LANGNAME[l] + '</span>';
    }).join('');

    // 1) borradores esperando aprobación — primero y con acciones prominentes
    const pend = groups.filter((g) => g.pending).sort((a, b) => b.date - a.date);
    $('bl2-pending').innerHTML = pend.length ?
      '<div class="pp-sec-h" style="margin-top:4px">🕐 Esperando tu aprobación <span class="count">' + pend.length + '</span></div>' +
      pend.map((g) => '<div class="bl2-pend">' +
        '<div class="bl2-pend-main"><div class="bl2-pend-title">' + esc(g.main.title || '(sin título)') + '</div>' +
        '<div class="bl2-pend-sub">' + esc(g.main.topic || g.main.slug || '') + ' · llegó ' + fdate(g.date) + ' · ' + badges(g) + '</div></div>' +
        bl2KwBlock(g) +
        '<div class="bl2-pend-acts">' +
          '<button class="btn btn-primary small" data-approve="' + esc(g.key) + '" type="button">✅ Aprobar y publicar ×' + g.rows.length + '</button>' +
          '<button class="btn btn-ghost small" data-review="' + esc(g.main.id) + '" type="button">👁 Revisar y editar</button>' +
          '<button class="btn btn-ghost small danger" data-reject="' + esc(g.key) + '" type="button">🗑 Rechazar</button>' +
        '</div></div>').join('')
      : '';

    // 2) historial: una fila por artículo (grupo) con performance
    const histAll = groups.filter((g) => !g.pending).sort((a, b) => b.date - a.date);
    $('bg-list-h').hidden = !histAll.length;
    const cnt = $('bl2-count'); if (cnt) cnt.textContent = '(' + histAll.length + ')';

    // chips de filtro: uno por categoría presente + "Todos", con conteo real
    const catCounts = {}; histAll.forEach((g) => { catCounts[g.category] = (catCounts[g.category] || 0) + 1; });
    const catBox = $('bl2-cat-filter');
    if (catBox) {
      const cats = Object.keys(catCounts).sort((a, b) => catCounts[b] - catCounts[a]);
      if (!cats.includes(bl2CatFilter) && bl2CatFilter !== 'all') bl2CatFilter = 'all';
      catBox.innerHTML = '<button type="button" class="bl2-cat-chip' + (bl2CatFilter === 'all' ? ' on' : '') + '" data-cat="all">Todos <b>' + histAll.length + '</b></button>' +
        cats.map((c) => '<button type="button" class="bl2-cat-chip' + (bl2CatFilter === c ? ' on' : '') + '" data-cat="' + esc(c) + '">' + esc(BL2_CAT_LBL[c] || c) + ' <b>' + catCounts[c] + '</b></button>').join('');
      catBox.querySelectorAll('[data-cat]').forEach((btn) => btn.addEventListener('click', () => { bl2CatFilter = btn.dataset.cat; renderBlogList(); }));
    }
    const hist = bl2CatFilter === 'all' ? histAll : histAll.filter((g) => g.category === bl2CatFilter);
    box.innerHTML = hist.length ?
      '<div class="lead-table-wrap"><table class="lead-table bl2-table"><thead><tr>' +
      '<th>Artículo</th><th>Idiomas</th>' +
      '<th style="text-align:right" title="Incluye tráfico automático — sirve para comparar un artículo contra otro">Visitas 30d 🤖</th>' +
      '<th style="text-align:right" title="Visitas de una persona confirmada. Se mide desde el 24/08, así que el número es chico por la fecha y crece cada día">Personas</th>' +
      '<th style="text-align:right" title="Mediana del tiempo en página. Mediana y no promedio: una pestaña olvidada llegó a 7.200 s y se llevaba el promedio a 186 s">Tiempo</th>' +
      '<th style="text-align:right" title="Leads que entraron por este artículo o que lo vieron antes de dejar sus datos">Leads</th>' +
      '<th style="text-align:right">Tendencia</th><th>Publicado</th><th style="width:38px"></th>' +
      '</tr></thead><tbody>' +
      hist.map((g) => {
        const v = idx ? bl2GroupViews(g, idx) : null;
        let l7 = 0, p7 = 0;
        if (idx) g.rows.forEach((r) => { const s = idx.bySlug.get(r.slug); if (s) { l7 += s.last7; p7 += s.prev7; } });
        const trend = !idx ? '<span class="mut">…</span>'
          : l7 > p7 ? '<span class="bl2-trend up">▲ ' + bl2Fmt(l7) + ' esta semana</span>'
          : l7 < p7 ? '<span class="bl2-trend dn">▼ ' + bl2Fmt(l7) + ' esta semana</span>'
          : '<span class="bl2-trend dn">· ' + bl2Fmt(l7) + '</span>';
        /* Personas, tiempo y leads se suman de las tres versiones de idioma: el
           artículo es uno, aunque tenga tres URLs. */
        let pers = 0, durs = [], leads = 0;
        if (idx) g.rows.forEach((r) => { const e = idx.bySlug.get(r.slug); if (e){ pers += (e.personas ? e.personas.size : 0); durs = durs.concat(e.durs || []); leads += (e.leads || 0); } });
        const med = bl2Mediana(durs);
        const openId = (g.rows.find((r) => r.lang === 'en' && r.status === 'published') || g.pub[0] || g.main).id;
        return '<tr data-open="' + esc(openId) + '">' +
          '<td><div class="bl2-t">' + esc(g.main.title || '(sin título)') + '</div><div class="bl2-sub">' + esc((g.pub[0] || g.main).slug || g.main.topic || '') + '</div></td>' +
          '<td style="white-space:nowrap">' + badges(g) + '</td>' +
          '<td class="bl2-num' + (v && idx && v >= idx.total / Math.max(hist.length, 1) ? ' good' : '') + '">' + (idx ? bl2Fmt(v) : '—') + '</td>' +
          '<td class="bl2-num' + (pers ? ' good' : '') + '">' + (idx ? (pers || '<span class="mut" style="color:var(--muted-2)">—</span>') : '—') + '</td>' +
          '<td class="bl2-num" style="color:' + (med == null ? 'var(--muted-2)' : med < 20 ? '#ff8b8b' : med < 60 ? '#f0c060' : '#7ed957') + '">' +
            (med == null ? '—' : med < 60 ? med + 's' : Math.round(med / 60) + 'm ' + (med % 60) + 's') + '</td>' +
          '<td class="bl2-num" style="color:' + (leads ? '#7ed957' : 'var(--muted-2)') + ';font-weight:' + (leads ? '700' : '400') + '">' + (leads || '0') + '</td>' +
          '<td style="text-align:right">' + trend + '</td>' +
          '<td class="mut" style="color:var(--muted-2);white-space:nowrap">' + fdate(g.pub.length ? Math.max(...g.pub.map((r) => +new Date(r.published_at || 0))) : g.date) + '</td>' +
          '<td><button class="bl2-dots" data-menu="' + esc(g.key) + '" type="button" title="Acciones">⋯</button></td></tr>';
      }).join('') + '</tbody></table></div>'
      : (pend.length ? '' : '<p class="muted-note">Todavía no hay artículos — agregá temas a la cola del motor o escribí uno puntual abajo.</p>');

    // bind (siempre al re-render)
    $('bl2-pending').querySelectorAll('[data-approve]').forEach((b) => b.addEventListener('click', () => bl2ApproveGroup(b.dataset.approve)));
    $('bl2-pending').querySelectorAll('[data-review]').forEach((b) => b.addEventListener('click', () => loadBlog(b.dataset.review, true)));
    $('bl2-pending').querySelectorAll('[data-reject]').forEach((b) => b.addEventListener('click', () => bl2RejectGroup(b.dataset.reject)));
    box.querySelectorAll('tr[data-open]').forEach((tr) => tr.addEventListener('click', (e) => {
      if (e.target.closest('.bl2-dots') || e.target.closest('.bl2-lang')) return;
      loadBlog(tr.dataset.open, true);
    }));
    box.querySelectorAll('.bl2-dots').forEach((b) => b.addEventListener('click', (e) => { e.stopPropagation(); bl2OpenMenu(b); }));
    document.querySelectorAll('#bg-list .bl2-lang.no, #bl2-pending .bl2-lang.no').forEach((b) => b.addEventListener('click', (e) => {
      e.stopPropagation(); localizeBlog(b.dataset.id, b.dataset.loc);
    }));
  }

  /* ---- bl2: ⋯ de la fila (mismo patrón fixed que dlOpenMenu) ---- */
  function bl2OpenMenu(btn){
    const menu = $('bl2-menu'); if (!menu) return;
    if (!menu.hidden && menu.dataset.k === String(btn.dataset.menu)){ menu.hidden = true; return; }
    const g = bl2Groups().find((x) => String(x.key) === String(btn.dataset.menu)); if (!g) return;
    menu.dataset.k = String(g.key);
    const live = g.pub.filter((r) => r.published_url);
    menu.innerHTML =
      '<button data-act="edit" type="button">✏️ Abrir y editar</button>' +
      live.map((r) => '<button data-act="live" data-url="' + esc(r.published_url) + '" type="button">↗ Ver live ' + LANGNAME[r.lang] + '</button>').join('') +
      '<hr /><button data-act="del" class="danger" type="button">🗑 Borrar (' + g.rows.length + ' idioma' + (g.rows.length === 1 ? '' : 's') + ')</button>';
    menu.hidden = false;
    const r = btn.getBoundingClientRect();
    menu.style.left = Math.max(8, Math.min(r.right - menu.offsetWidth, window.innerWidth - menu.offsetWidth - 8)) + 'px';
    menu.style.top = Math.min(r.bottom + 6, window.innerHeight - menu.offsetHeight - 8) + 'px';
    menu.querySelectorAll('button').forEach((mb) => mb.addEventListener('click', (ev) => {
      ev.stopPropagation(); menu.hidden = true;
      const act = mb.dataset.act;
      if (act === 'edit') loadBlog((g.pub[0] || g.main).id, true);
      else if (act === 'live') window.open(mb.dataset.url, '_blank', 'noopener');
      else if (act === 'del') bl2DeleteGroup(g.key);
    }));
  }
  document.addEventListener('click', (e) => { const m = $('bl2-menu'); if (m && !m.hidden && !e.target.closest('#bl2-menu') && !e.target.closest('.bl2-dots')) m.hidden = true; });

  // aprobar = el flujo de publicación existente (publish-blog por cada idioma del grupo)
  async function bl2ApproveGroup(key){
    const g = bl2Groups().find((x) => String(x.key) === String(key)); if (!g) return;
    const vars = g.rows.filter((b) => b.status !== 'published');
    if (!vars.length) { toast('Ya está todo publicado'); return; }
    const langs = vars.map((v) => LANGNAME[v.lang] || v.lang).join(' + ');
    if (!confirm('¿Aprobar y publicar "' + (g.main.title || '') + '" en ' + langs + '?\n\nSe commitea a GitHub y sale al aire en ~1-2 min.')) return;
    for (const v of vars){
      fillBlogEditor(v);
      const ok = await publishBlog({ skipConfirm: true });
      if (!ok) { toast('⚠️ Falló ' + (LANGNAME[v.lang] || v.lang) + ' — reintentá desde el editor'); break; }
    }
    await blogsLoad();
  }
  async function bl2RejectGroup(key){
    const g = bl2Groups().find((x) => String(x.key) === String(key)); if (!g) return;
    const vars = g.rows.filter((b) => b.status !== 'published');
    if (!vars.length) return;
    if (!confirm('¿Descartar el borrador "' + (g.main.title || '') + '" (' + vars.length + ' idioma' + (vars.length === 1 ? '' : 's') + ')?\n\nNo se puede deshacer. El tema NO vuelve a la cola.')) return;
    const { error } = await supabase.from('blogs').delete().in('id', vars.map((v) => v.id));
    if (error){ toast('No se pudo borrar: ' + error.message); return; }
    const ids = new Set(vars.map((v) => String(v.id)));
    blogsList = blogsList.filter((x) => !ids.has(String(x.id)));
    if (bgCur && ids.has(String(bgCur.id))) $('bg-result').hidden = true;
    toast('🗑 Borrador descartado'); renderBlogList();
  }
  async function bl2DeleteGroup(key){
    const g = bl2Groups().find((x) => String(x.key) === String(key)); if (!g) return;
    if (!confirm('¿Borrar "' + (g.main.title || '') + '" con sus ' + g.rows.length + ' idioma' + (g.rows.length === 1 ? '' : 's') + ' de la lista?\n\n(No lo saca de la web si ya lo publicaste)')) return;
    const { error } = await supabase.from('blogs').delete().in('id', g.rows.map((v) => v.id));
    if (error){ toast('No se pudo borrar: ' + error.message); return; }
    const ids = new Set(g.rows.map((v) => String(v.id)));
    blogsList = blogsList.filter((x) => !ids.has(String(x.id)));
    if (bgCur && ids.has(String(bgCur.id))) $('bg-result').hidden = true;
    renderBlogList();
  }

  /* ---- bl2: picker visual de imagen héroe + video ---- */
  function bl2ImgOptions(){
    const opts = [...document.querySelectorAll('#bg-hero-opts option')].map((o) => ({ v: o.value, l: o.textContent || o.value }));
    const seen = new Set(opts.map((o) => o.v));
    blogsList.forEach((b) => { if (b.hero_image && !seen.has(b.hero_image)) { seen.add(b.hero_image); opts.push({ v: b.hero_image, l: (b.title || 'de otro post').slice(0, 34) }); } });
    return opts;
  }
  /* De a tandas. Sebastián, 14 ago, desde el iPhone: "cuando voy a abrir las
     fotos y videos están todos juntos, no se las ve bien. Y se corta la app".
     Eran ~250 fotos y 155 miniaturas de Vimeo pedidas de una: el teléfono se
     clavaba. Se muestran 24 y hay un botón para traer el resto; el filtro
     sigue buscando sobre el catálogo COMPLETO, no sobre las 24. */
  const BL2_TANDA = 24;
