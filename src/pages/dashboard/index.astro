  /* ---- PDF adjunto: jsPDF + autotable servidos desde /assets (sin CDN), cargados on-demand ---- */
  let jsPdfPromise = null;
  function loadScriptOnce(src){
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src; s.onload = resolve; s.onerror = () => reject(new Error('no se pudo cargar ' + src));
      document.head.appendChild(s);
    });
  }
  function loadJsPDF(){
    if (!jsPdfPromise) jsPdfPromise = (async () => {
      if (!(window.jspdf && window.jspdf.jsPDF)) await loadScriptOnce('/assets/jspdf.umd.min.js');
      if (!(window.jspdf && window.jspdf.jsPDF)) throw new Error('jsPDF no disponible');
      const J = window.jspdf.jsPDF;
      if (!J.API.autoTable && !window.autoTable) await loadScriptOnce('/assets/jspdf.plugin.autotable.min.js');
      if (!J.API.autoTable && window.applyPlugin) window.applyPlugin(J);   // autotable v5: registrar doc.autoTable
      return J;
    })().catch((e) => { jsPdfPromise = null; throw e; });
    return jsPdfPromise;
  }
  // arma el PDF de la oferta (mismo diseño que printOffer, razonablemente) y devuelve base64
  async function buildOfferPdfBase64(lang){
    const J = await loadJsPDF();
    const L = OF_PDF_L[lang];
    const doc = new J({ unit: 'pt', format: 'a4' });
    const W = doc.internal.pageSize.getWidth(), H = doc.internal.pageSize.getHeight();
    const NAVY = [15, 24, 38], ACID = [221, 249, 143], MUT = [138, 148, 168], INK = [26, 34, 48], LINE = [232, 234, 239];
    const vatRate = parseFloat($('of-vat').value) || 0;
    const net = offerNet(ofCur), vat = net * vatRate / 100;
    const sum0 = (ofCur.items || []).reduce((a, it) => a + (Number(it.qty) || 0) * (Number(it.price) || 0), 0);
    const discPct = Number(ofCur.discount_pct) || 0;
    const today = new Date().toLocaleDateString(L.loc, { day: '2-digit', month: 'long', year: 'numeric' });
    const valid = ofValidDate().toLocaleDateString(L.loc, { day: '2-digit', month: 'long', year: 'numeric' });
    // banda navy con la marca
    doc.setFillColor(NAVY[0], NAVY[1], NAVY[2]); doc.rect(0, 0, W, 84, 'F');
    doc.setTextColor(ACID[0], ACID[1], ACID[2]); doc.setFont('helvetica', 'bold'); doc.setFontSize(24); doc.text('viven', 48, 46);
    doc.setTextColor(154, 166, 189); doc.setFont('helvetica', 'normal'); doc.setFontSize(7); doc.text('F I L M   P R O D U C T I O N', 48, 60);
    doc.setTextColor(244, 246, 251); doc.setFont('helvetica', 'bold'); doc.setFontSize(14);
    doc.text(L.doc + (ofCur.number ? ' ' + ofCur.number : ''), W - 48, 40, { align: 'right' });
    doc.setFont('helvetica', 'normal'); doc.setFontSize(8.5); doc.setTextColor(154, 166, 189);
    doc.text(today, W - 48, 54, { align: 'right' });
    doc.text(L.valid + ': ' + valid, W - 48, 66, { align: 'right' });
    let y = 112;
    // bloque del cliente
    const B = [ofCur.client_company, ofCur.client_contact, ofCur.client_address, ofCur.client_zip_city,
               [ofCur.client_phone, ofCur.client_email].filter(Boolean).join(' · ')].filter((x) => x && String(x).trim());
    doc.setFontSize(7.5); doc.setTextColor(MUT[0], MUT[1], MUT[2]); doc.text(L.forL.toUpperCase(), 48, y);
    doc.setFontSize(9.5); doc.setTextColor(INK[0], INK[1], INK[2]);
    (B.length ? B : [ofCur.client || '—']).forEach((line, i) => doc.text(String(line), 48, y + 14 + i * 13));
    y += 14 + Math.max(1, B.length) * 13 + 16;
    // saludo + intro personal
    doc.setFont('helvetica', 'bold'); doc.setFontSize(10.5);
    doc.text(ofCur.client_contact ? L.greet + ' ' + ofCur.client_contact.split(/\s+/)[0] : L.greet, 48, y); y += 15;
    doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(91, 100, 114);
    const introLines = doc.splitTextToSize(ofCur.intro_text || L.intro, W - 96);
    doc.text(introLines, 48, y); y += introLines.length * 12 + 12;
    doc.setFont('helvetica', 'bold'); doc.setFontSize(15); doc.setTextColor(INK[0], INK[1], INK[2]);
    doc.text(ofCur.title || L.defTitle, 48, y); y += 12;
    // tabla de posiciones agrupada por fase (con subtotales) — versión cliente, sin costos
    const body = []; const rowType = {};
    PHASES.filter((ph) => (ofCur.items || []).some((it) => phaseOf(it) === ph)).forEach((ph) => {
      rowType[body.length] = 'ph'; body.push([{ content: ph, colSpan: 4 }]);
      (ofCur.items || []).forEach((it) => {
        if (phaseOf(it) !== ph) return;
        body.push([String(it.name || ''), (it.qty ?? '') + ' ' + (it.unit || ''), fmtM(it.price), fmtM((Number(it.qty) || 0) * (Number(it.price) || 0))]);
      });
      const s = phaseSubtotal(ph);
      rowType[body.length] = 'sub'; body.push([{ content: L.sub + ' ' + ph, colSpan: 3 }, fmtM(s.net)]);
    });
    const tableOpts = {
      startY: y, margin: { left: 48, right: 48 },
      head: [[L.pos, L.qty, L.price, L.total]], body,
      theme: 'plain',
      styles: { font: 'helvetica', fontSize: 8.5, textColor: INK, cellPadding: { top: 5, bottom: 5, left: 4, right: 4 }, lineColor: LINE, lineWidth: { bottom: .6 } },
      headStyles: { fontSize: 7, fontStyle: 'bold', textColor: MUT },
      columnStyles: { 1: { halign: 'center' }, 2: { halign: 'right' }, 3: { halign: 'right' } },
      didParseCell: (d) => {
        if (d.section !== 'body') return;
        const t = rowType[d.row.index];
        if (t === 'ph'){ d.cell.styles.fillColor = [243, 247, 232]; d.cell.styles.textColor = [78, 101, 15]; d.cell.styles.fontStyle = 'bold'; d.cell.styles.fontSize = 7; }
        if (t === 'sub'){ d.cell.styles.fontStyle = 'bold'; d.cell.styles.textColor = [91, 100, 114]; if (d.column.index > 0) d.cell.styles.halign = 'right'; }
      },
    };
    if (typeof doc.autoTable === 'function') doc.autoTable(tableOpts); else window.autoTable(doc, tableOpts);
    y = (doc.lastAutoTable ? doc.lastAutoTable.finalY : y) + 20;
    const need = (h) => { if (y + h > H - 60){ doc.addPage(); y = 60; } };
    // tarjeta de totales (navy, a la derecha)
    const rowsT = [];
    if (discPct > 0){ rowsT.push([L.sub, fmtM(sum0)]); rowsT.push([L.disc + ' ' + discPct + '%', '- ' + fmtM(sum0 - net)]); }
    rowsT.push([L.net, fmtM(net)]); rowsT.push([L.vat + ' ' + vatRate + '%', fmtM(vat)]);
    const cardH = (rowsT.length + 1) * 16 + 22;
    need(cardH + 6);
    const cardX = W - 48 - 240;
    doc.setFillColor(NAVY[0], NAVY[1], NAVY[2]); doc.roundedRect(cardX, y, 240, cardH, 8, 8, 'F');
    doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(244, 246, 251);
    let cy = y + 20;
    rowsT.forEach(([k, v]) => { doc.text(k, cardX + 16, cy); doc.text(v, cardX + 224, cy, { align: 'right' }); cy += 16; });
    doc.setDrawColor(90, 100, 120); doc.line(cardX + 16, cy - 6, cardX + 224, cy - 6);
    doc.setFont('helvetica', 'bold'); doc.setFontSize(11.5); doc.setTextColor(ACID[0], ACID[1], ACID[2]);
    doc.text(L.gross, cardX + 16, cy + 10); doc.text(fmtM(net + vat), cardX + 224, cy + 10, { align: 'right' });
    y += cardH + 22;
    const para = (txt, size, color, bold) => {
      if (!txt) return;
      doc.setFont('helvetica', bold ? 'bold' : 'normal'); doc.setFontSize(size); doc.setTextColor(color[0], color[1], color[2]);
      const lines = doc.splitTextToSize(String(txt), W - 96);
      need(lines.length * (size + 3) + 8);
      doc.text(lines, 48, y); y += lines.length * (size + 3) + 8;
    };
    if (ofCur.terms){ para(L.terms.toUpperCase(), 8, MUT, true); para(ofCur.terms, 8, [60, 68, 84]); }
    para(ofCur.closing_text, 9, [91, 100, 114]);
    para(L.prices + ' ' + GTC_LINE, 7.5, MUT);
    // pie legal (COMPANY — un solo lugar)
    need(40);
    doc.setDrawColor(LINE[0], LINE[1], LINE[2]); doc.line(48, y, W - 48, y); y += 12;
    doc.setFont('helvetica', 'normal'); doc.setFontSize(7); doc.setTextColor(MUT[0], MUT[1], MUT[2]);
    doc.text(COMPANY.name + ' · ' + COMPANY.address + ' · ' + COMPANY.email + ' · ' + COMPANY.phone + ' · ' + COMPANY.web, W / 2, y, { align: 'center' }); y += 10;
    doc.text('Bank: ' + COMPANY.bank + ' · IBAN ' + COMPANY.iban + ' · BIC ' + COMPANY.bic, W / 2, y, { align: 'center' }); y += 10;
    doc.text('VAT: ' + COMPANY.vat + ' · ' + COMPANY.reg, W / 2, y, { align: 'center' });
    return doc.output('datauristring').split(',')[1];
  }
  const ofAttachName = (lang) => ({ de: 'Offerte', en: 'Offer', es: 'Oferta' }[lang] || 'Offerte') + '_' + (ofCur.number || 'VIVEN') + '.pdf';
  // ④ panel "Enviar": resumen (para, idioma, adjunto) + botón que abre el compositor
