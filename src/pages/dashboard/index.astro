  }
  /* ══════════════ 🧹 LIMPIAR EL PIPELINE ══════════════
     Sebastián, 26 ago 2026: "el pipeline sigue siendo un caos, lleno de cosas vacías…
     mirá cuáles son reales, el resto vamos eliminando, si no estás seguro preguntá. así
     no usamos nunca el pipeline".

     No borra nada por su cuenta ni adivina: mide, muestra la EVIDENCIA de cada deal y él
     tilda. Lo que se archiva se puede volver a traer — un deal borrado no.

     Un deal es REAL si dejó rastro: una oferta o propuesta, un email que contestaron,
     una nota, una task, una visita a la web, o un valor cargado a mano. Lo que no tiene
     NADA de eso en semanas no es una oportunidad, es una fila. */
  let limpCand = [], limpSel = new Set();

  async function limpAbrir(){
    const m = $('limp-modal'); if (!m) return;
    m.hidden = false;
    $('limp-body').innerHTML = '<p class="muted-note">Midiendo la actividad real de cada deal…</p>';
    $('limp-go').disabled = true;

    const abiertos = (dealsList || []).filter((d) => !d.archived && DL_OPEN.includes(stageOf(d.stage)));
    const ids = [...new Set(abiertos.map((d) => String(d.lead_id)).filter((x) => x && x !== 'null' && x !== 'undefined'))];

    /* Tres consultas y no una por deal: con 39 abiertos serían 117 viajes. */
    const q = (t) => t.then((x) => (x && !x.error && x.data) || []).catch(() => []);
    const [mails, notas, tasks] = ids.length ? await Promise.all([
      q(supabase.from('email_log').select('lead_id,direction').in('lead_id', ids)),
      q(supabase.from('lead_notes').select('lead_id').in('lead_id', ids)),
      q(supabase.from('lead_tasks').select('lead_id').in('lead_id', ids)),
    ]) : [[], [], []];
    const cuenta = (arr, f) => arr.reduce((a, x) => { if (!f || f(x)) a[String(x.lead_id)] = (a[String(x.lead_id)] || 0) + 1; return a; }, {});
    const nMailOut = cuenta(mails, (x) => x.direction !== 'in');
    const nMailIn = cuenta(mails, (x) => x.direction === 'in');
    const nNotas = cuenta(notas), nTasks = cuenta(tasks);

    limpCand = abiertos.map((d) => {
      const r = leadById(d.lead_id) || {};
      const lid = String(d.lead_id);
      const dom = leadDomain(r);
      const co = (dom && companyName(dom)) || r.company || '';
      const nombre = d.title || r.name || r.first_name || '';
      const ofs = offersForDeal(d);
      const props = (propsAll || []).filter((p) => !p.archived && !p.is_template && p.lead_id && String(p.lead_id) === lid);
      const visitas = (lastViews || []).filter((v) => r.session_id && v.session_id === r.session_id).length;
      const val = dealValue(d);
      const dias = dealStageDays(d);

      /* Señales de que ES real. Cualquiera alcanza. */
      const señales = [];
      if (ofs.length) señales.push(ofs.length + (ofs.length === 1 ? ' oferta' : ' ofertas'));
      if (props.length) señales.push(props.length + (props.length === 1 ? ' propuesta' : ' propuestas'));
      if (nMailIn[lid]) señales.push(nMailIn[lid] + ' email' + (nMailIn[lid] === 1 ? '' : 's') + ' que ELLOS mandaron');
      if (nNotas[lid]) señales.push(nNotas[lid] + ' nota' + (nNotas[lid] === 1 ? '' : 's'));
      if (nTasks[lid]) señales.push(nTasks[lid] + ' task' + (nTasks[lid] === 1 ? '' : 's'));
      if (visitas) señales.push(visitas + ' página' + (visitas === 1 ? '' : 's') + ' vistas');
      if (val) señales.push('valor ' + fmtChf(val));

      /* Motivos para dudar. Se ordenan de más grave a menos. */
      const motivos = [];
      if (/\btest\b|prueba|asdf|qwerty/i.test(nombre + ' ' + (r.email || ''))) motivos.push('parece una prueba');
      if (!nombre.trim()) motivos.push('sin nombre');
      if (!r.email) motivos.push('la persona no tiene email');
      if (String(r.message || '') === 'Newsletter signup') motivos.push('solo se suscribió al newsletter, nunca pidió nada');
      if (!co && !r.company) motivos.push('sin empresa');
      if (!señales.length) motivos.push('nunca pasó nada: sin documento, sin emails suyos, sin notas, sin tasks, sin visitas');
      else if (!ofs.length && !props.length && !nMailIn[lid] && dias > 30) motivos.push(dias + ' días quieto y nunca contestaron');

      return { d, r, nombre: nombre || '(sin nombre)', co, señales, motivos, val, dias,
               mailsOut: nMailOut[lid] || 0, etapa: stageOf(d.stage) };
    });

    /* Lo dudoso arriba, y dentro de eso lo más viejo primero. */
    const dudosos = limpCand.filter((c) => c.motivos.length).sort((a, b) => b.dias - a.dias);
    const reales = limpCand.filter((c) => !c.motivos.length);

    /* Preseleccionado SOLO lo que no admite discusión: pruebas, sin nombre, o cero rastro
       de cualquier tipo. Lo demás llega en gris y lo decide él. */
    limpSel = new Set(dudosos.filter((c) =>
      c.motivos.some((m) => /prueba|sin nombre|nunca pasó nada/.test(m))).map((c) => String(c.d.id)));

    const fila = (c) => {
      const st = STAGES.find((s) => s.key === c.etapa) || {};
      return '<label class="limp-row' + (limpSel.has(String(c.d.id)) ? ' on' : '') + '" data-id="' + esc(String(c.d.id)) + '">' +
        '<input type="checkbox" data-chk="' + esc(String(c.d.id)) + '"' + (limpSel.has(String(c.d.id)) ? ' checked' : '') + ' />' +
        '<div class="limp-txt">' +
          '<div class="limp-t"><b>' + esc(c.nombre) + '</b>' +
            (c.co ? ' <span class="limp-co">' + esc(c.co) + '</span>' : '') +
            '<span class="limp-st" style="color:' + (st.color || 'var(--muted)') + '">' + esc(st.label || '') + ' · ' + c.dias + 'd</span></div>' +
          (c.motivos.length ? '<div class="limp-mal">✕ ' + esc(c.motivos.join(' · ')) + '</div>' : '') +
          (c.señales.length ? '<div class="limp-bien">✓ ' + esc(c.señales.join(' · ')) + '</div>'
            : '<div class="limp-bien vacio">' + (c.mailsOut ? 'le mandamos ' + c.mailsOut + ' email' + (c.mailsOut === 1 ? '' : 's') + ' y nunca contestó' : 'ni siquiera le escribimos') + '</div>') +
        '</div></label>';
    };

    $('limp-body').innerHTML =
      '<p class="muted-note" style="margin:0 0 14px">' + limpCand.length + ' deals abiertos. ' +
        '<b>' + dudosos.length + '</b> no parecen reales y <b>' + reales.length + '</b> sí dejaron rastro. ' +
        'Se <b>archivan</b>, no se borran: se pueden volver a traer.</p>' +
      (dudosos.length
        ? '<div class="limp-sec">Para archivar <span>' + dudosos.length + '</span>' +
            '<button type="button" id="limp-todos" class="limp-mini">Marcar todos</button>' +
            '<button type="button" id="limp-ninguno" class="limp-mini">Ninguno</button></div>' +
          dudosos.map(fila).join('')
        : '<p class="muted-note">No encontré ninguno vacío. El pipeline está limpio.</p>') +
      (reales.length
        ? '<div class="limp-sec">Estos SÍ son reales — no los toco <span>' + reales.length + '</span></div>' +
          reales.sort((a, b) => b.val - a.val).map(fila).join('')
        : '');

    $('limp-body').querySelectorAll('[data-chk]').forEach((cb) => cb.addEventListener('change', () => {
      const id = cb.dataset.chk;
      if (cb.checked) limpSel.add(id); else limpSel.delete(id);
