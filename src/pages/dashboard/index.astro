      const eta = remaining <= 0 ? 'ya hay muestra suficiente — juntando la señal' : (weeks != null ? '~' + weeks + (weeks === 1 ? ' semana' : ' semanas') + ' al ritmo actual' : 'sin ritmo de tráfico todavía');
      verdict = '<div class="verdictbar wait"><span class="conf" style="color:#f0c060">' + (confPct > 0 ? confPct + '%' : '—') + '</span>' +
        '<div class="vtxt"><b>Todavía no hay nada que decidir.</b> ' + total + ' de ~' + needTot + ' sesiones necesarias para detectar una diferencia real. ' + eta + '.</div>' +
        '<div class="bar"><i style="width:' + Math.max(3, Math.min(100, confPct)) + '%;background:#f0c060"></i></div></div>';
    }
    // leads clickeables (pedido de Sebastián: "si tienen leads, dejame tocar el botón
    // a ver qué lead fue para entender si esa lead vale la pena o no") — con 0 leads
    // no hay nada que abrir, queda el número plano
    const leadsNum = (side, l2) => l2
      ? '<button type="button" class="ab-lc' + (abLeadsOpen === t.id + ':' + side ? ' on' : '') + '" data-side="' + side + '" title="Ver QUÉ leads convirtieron con esta variante"><b>' + l2 + '</b><span>leads ' + (abLeadsOpen === t.id + ':' + side ? '▴' : '▾') + '</span></button>'
      : '<div><b>0</b><span>leads</span></div>';
    const cell = (side, txt, e2, l2, conv) =>
      '<div class="ab-var' + (side === 'a' ? (aWins && r.eb ? ' win' : '') : (bWins ? ' win' : '')) + '">' +
        '<div class="k">' + (side === 'a' ? 'A — Original' : 'B — Variante') + '</div>' +
        '<div class="txt">' + esc(txt) + '</div>' +
        '<div class="nums"><div><b>' + e2 + '</b><span>sesiones</span></div>' + leadsNum(side, l2) + '<div><b>' + (e2 ? (conv * 100).toFixed(1) : '0') + '%</b><span>conv.</span></div></div></div>';
    const leadList = (abLeadsOpen === t.id + ':a' || abLeadsOpen === t.id + ':b') ? abLeadListHtml(t, abLeadsOpen.slice(-1)) : '';
    // sub-línea: path · split · día · auto-stop
    const sub = esc(t.url_path) + ' · split ' + (t.split_pct || 50) + '/' + (100 - (t.split_pct || 50)) +
      (day ? ' · día ' + day : '') + (endTxt ? ' · termina ' + endTxt + ' (auto-stop)' : '') + ' · ' + changes.length + ' cambio(s)';
    // acciones
