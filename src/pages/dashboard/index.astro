  .pj-et.on .n{color:var(--acid)}
  .pj-et .l{font-size:11.5px;color:var(--muted);margin-top:5px;line-height:1.25}
  .pj-et .chf{font-size:10.5px;color:var(--muted-2);margin-top:2px;font-variant-numeric:tabular-nums}

  .pj-fila{display:flex;align-items:center;gap:14px;background:var(--navy-800);border:1px solid var(--line);border-radius:14px;
    padding:14px 17px;margin-bottom:9px;flex-wrap:wrap;cursor:pointer;width:100%;text-align:left;font:inherit;color:inherit}
  .pj-fila:hover{border-color:var(--line-strong)}
  .pj-fila .tit{flex:1;min-width:190px;font-size:15.5px;font-weight:600}
  .pj-fila .tit small{display:block;font-size:12.5px;color:var(--muted);font-weight:400;margin-top:2px}
  .pj-fila .plata{font-size:16px;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap;text-align:right}
  .pj-fila .plata small{display:block;font-size:11px;font-weight:400;color:#f0c060}
  .pj-fila .aviso{font-size:12px;color:#f0c060;flex-basis:100%}
  .pj-chip{font-size:10.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;border-radius:999px;padding:4px 10px;white-space:nowrap;border:1px solid currentColor}

  .pj-hd{display:flex;align-items:flex-start;gap:14px;flex-wrap:wrap;margin:10px 0 14px}
  .pj-hd-t{flex:1;min-width:230px}
  .pj-hd-plata{text-align:right}
  .pj-hd-plata b{font-size:21px;font-weight:700;font-variant-numeric:tabular-nums;display:block}
  .pj-hd-plata small{font-size:12px;color:var(--muted)}

  .pj-pasos{display:flex;align-items:center;gap:0;flex-wrap:wrap;margin:0 0 12px}
  .pj-paso{padding:7px 13px;border:1px solid var(--line-strong);border-radius:999px;font:600 12.5px inherit;color:var(--muted);
    background:var(--navy-900);cursor:pointer}
  .pj-paso:hover{border-color:var(--acid);color:var(--acid)}
  .pj-paso.on{border-color:var(--acid);background:var(--acid);color:#16210a}
  .pj-flecha{color:var(--muted-2);padding:0 5px;font-size:11px}
  .pj-pasos{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .pj-etq{font-size:11.5px;color:var(--muted-2);text-transform:uppercase;letter-spacing:.05em}
  .pj-etsel{width:auto;min-width:150px;font-size:13px}
  .pj-etnota{font-size:12.5px;color:var(--muted-2)}
  .pj-etsug{background:none;border:0;color:var(--acid);font:inherit;font-size:12.5px;cursor:pointer;padding:0;text-align:left}
  .pj-etsug b{font-weight:700}
  .pj-etsug:hover{text-decoration:underline}

  .pj-cols{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  @media(max-width:820px){.pj-cols{grid-template-columns:1fr}}
  .pj-blq{margin:0;padding:16px 18px}
  .pj-blq h3{margin:0 0 12px;font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted-2);font-weight:700}
  .pj-kv{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px solid var(--line);font-size:13.5px;align-items:center}
  .pj-kv:last-child{border-bottom:0}
  .pj-kv .k{color:var(--muted-2);flex:none;display:flex;align-items:center;gap:8px}
  /* Los bloques van de a dos en una grilla, así que cada uno mide ~280px: todo lo que
     tenga min-width fijo adentro se desborda. Con Sonova adelante se veían el email del
     cliente cortado por la mitad y los campos del crew saliéndose de la tarjeta. */
  .pj-kv .v{color:var(--text);text-align:right;min-width:0;flex:1;overflow-wrap:anywhere}
  .pj-kv.pj-kv-col{display:block}
  .pj-kv.pj-kv-col .v{text-align:left;margin-top:9px}
  .pj-kv .v.falta{color:#f0c060}
  .pj-inp{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:9px;color:var(--text);
    font:inherit;font-size:13.5px;padding:6px 10px;max-width:100%;min-width:0}
  input.pj-inp{width:100%}
  textarea.pj-inp{width:100%;resize:vertical}
  /* Las dos fechas del rodaje, una al lado de la otra y sin desbordar. */
  .pj-fechas{display:grid;grid-template-columns:1fr 1fr;gap:6px}
  .pj-inp:focus{outline:none;border-color:var(--acid)}

  /* El número de proyecto. Monoespaciado y tabular para que dos referencias una debajo
     de la otra se comparen de un vistazo. */
  #ned-modal{z-index:430}
  .ned-grid{display:grid;grid-template-columns:1fr 1.6fr;gap:12px;margin:0 0 12px}
  @media(max-width:640px){.ned-grid{grid-template-columns:1fr}}
  .ned-grid label,.ned-lbl{display:block;font-size:12.5px;font-weight:600;color:var(--muted)}
  .ned-lbl{margin:0 0 12px}
  .ned-lbl em{font-weight:400;font-style:normal;color:var(--muted-2)}
  .ned-grid .ed-inp,.ned-lbl .ed-inp{width:100%;margin-top:5px}
  /* La vista previa se ve como el email de verdad: fondo claro, porque así lo va a leer. */
  .ned-prev{background:#fff;color:#1a2230;border-radius:12px;padding:18px 20px;max-height:340px;overflow:auto;margin:0 0 12px}
  .ned-xml{border:1px solid var(--line);border-radius:10px;padding:9px 12px;margin:0 0 4px}
  .ned-xml summary{cursor:pointer;font-size:12.5px;color:var(--muted)}
  .ned-xml pre{margin:10px 0 0;max-height:200px;overflow:auto;font-size:11px;line-height:1.5;
    color:#cfe3ff;background:var(--navy-900);border-radius:8px;padding:10px;white-space:pre-wrap;word-break:break-all}
  .pj-pdfrow{display:flex;align-items:center;gap:11px;flex-wrap:wrap;margin:0 0 14px;
    padding-bottom:14px;border-bottom:1px solid var(--line)}
  .pj-ref{display:inline-block;font-variant-numeric:tabular-nums;font-size:.78em;font-weight:700;
    color:var(--acid);background:color-mix(in srgb,var(--acid) 14%,transparent);
    border-radius:7px;padding:2px 8px;vertical-align:middle;letter-spacing:.02em}
  .pj-crew{display:grid;gap:6px}
  .pj-crew-row{display:grid;grid-template-columns:minmax(0,105px) minmax(0,1fr) auto;gap:7px;align-items:center}
  @media(max-width:600px){.pj-crew-row{grid-template-columns:minmax(0,1fr) auto}
    .pj-crew-row .pj-crew-rol{grid-column:1/-1}}
  .pj-crew-rol{font-size:12.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  /* 🧭 Playbook. Se lee mientras se habla por teléfono: la pregunta grande y legible,
     el porqué chiquito debajo, y la respuesta como un renglón que se toca y se escribe. */
  /* La barra de "Enviado · Deshacer" ocupa exactamente el lugar del botón Enviar: es
     donde estás mirando cuando acabás de tocarlo. */
  .und{display:flex;align-items:center;gap:12px;flex-wrap:wrap;width:100%;
    background:var(--panel-2);border:1px solid var(--line-strong);border-radius:10px;padding:9px 13px}
  .und-t{font-size:13px;font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .und-x{margin-left:auto;background:none;border:1px solid var(--acid);color:var(--acid);
    border-radius:99px;font:700 12.5px Inter,sans-serif;padding:6px 14px;cursor:pointer;white-space:nowrap}
  .und-x:hover{background:var(--acid);color:#1c2508}
  #lm2-undo-n{font-variant-numeric:tabular-nums}
  .pb-badge{display:inline-block;margin-left:6px;font-size:10.5px;font-weight:700;font-variant-numeric:tabular-nums;
    color:var(--muted);background:var(--panel-2);border-radius:99px;padding:1px 6px}
  .pb-badge:empty{display:none}
  .pb-badge.listo{color:#1c2508;background:var(--acid)}
  #pb-quien{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  /* Se abre DESDE la ficha de la persona, que también está en z-index 300. Con el mismo
     nivel y estando antes en el DOM, el playbook quedaba pintado por debajo: el botón
     "no hacía nada" porque el modal se abría detrás. Y antes de eso vivía adentro de la
     pestaña Pipeline, que está hidden cuando mirás Personas — dos formas distintas de
     no verse. (Sebastián, 26 ago 2026: "el botón de playbook no hace nada".) */
  #pb-modal{z-index:420}
  .lm2-pb{border:1px solid var(--line);border-radius:12px;background:var(--panel);margin-bottom:12px;overflow:hidden}
  .lm2-pb>summary{cursor:pointer;padding:11px 14px;font-weight:700;font-size:13px;
    display:flex;align-items:center;gap:10px;list-style:none;user-select:none}
  .lm2-pb>summary::-webkit-details-marker{display:none}
  .lm2-pb>summary:hover{background:var(--panel-2)}
  .lm2-pb .pb-prog{flex:1;max-width:180px;height:5px;border-radius:99px;background:var(--line);overflow:hidden}
  .lm2-pb .pb-prog>span{display:block;height:100%;background:var(--acid);transition:width .25s}
  .lm2-pb .pb-n{font-variant-numeric:tabular-nums;color:var(--muted);font-weight:600;font-size:12px}
  .pb-body{padding:2px 0 4px;max-height:min(70vh,660px);overflow:auto}
  #pb-quien .pb-prog{width:120px;height:5px;border-radius:99px;background:var(--line);overflow:hidden;display:inline-block}
  #pb-quien .pb-prog>span{display:block;height:100%;background:var(--acid);transition:width .25s}
  #pb-quien .pb-n{font-variant-numeric:tabular-nums;color:var(--muted);font-weight:600;font-size:12px}
  .pb-gh{font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);
    margin:14px 0 8px;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
  .pb-gn,.pb-aviso{letter-spacing:0;text-transform:none;font-size:11px;color:var(--muted-2)}
  .pb-aviso{color:#f0c060}
  .pb-q{padding:9px 0;border-top:1px solid var(--line)}
  .pb-qt{font-size:13.5px;font-weight:600;line-height:1.35}
  .pb-req{color:var(--acid);margin-left:5px;font-weight:900}
  .pb-why{font-size:11.5px;color:var(--muted-2);margin:2px 0 6px;line-height:1.4}
  /* La frase para decir en voz alta, entre comillas y en cursiva: se lee de un vistazo
     mientras hablás, que es cuando hace falta. */
  .pb-frase{font-size:12.5px;color:var(--text);line-height:1.55;margin:0 0 7px;padding:7px 11px;
    border-left:2px solid var(--acid);background:var(--panel-2);border-radius:0 8px 8px 0;font-style:italic}
  .pb-frase::before{content:'“'}
  .pb-frase::after{content:'”'}
  /* Respuestas para tocar: lo que es clasificación se elige, no se escribe. Los mismos
     chips que en las calculadoras del sitio, en chico. */
  .pb-chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 7px}
  .pb-chip{appearance:none;font:inherit;font-size:12.5px;line-height:1.25;cursor:pointer;
    padding:6px 11px;border-radius:999px;border:1px solid var(--line-strong);
    background:var(--panel);color:var(--text);transition:border-color .12s,background .12s}
  .pb-chip:hover{border-color:var(--muted)}
  .pb-chip.on{border-color:var(--acid);background:color-mix(in srgb,var(--acid) 16%,transparent);color:var(--acid);font-weight:600}
  .pb-chip:focus-visible{outline:2px solid var(--acid);outline-offset:2px}
  /* Y el matiz se escribe: el chip clasifica, el texto es lo que se pierde si no está. */
  .pb-libre{width:100%;border:1px dashed var(--line-strong);border-radius:8px;padding:7px 10px;
    background:transparent;color:inherit;font:inherit;font-size:13px;line-height:1.45;resize:vertical;outline:none}
  .pb-libre:focus{border-style:solid;border-color:var(--acid)}
  .pb-libre::placeholder{color:var(--muted-2)}
  .pb-q.ok .pb-libre{border-style:solid;border-color:var(--line)}
  .pb-when{font-size:10.5px;color:var(--muted-2);margin-top:4px}
  .pb-pie{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:16px;
    padding-top:12px;border-top:1px solid var(--line)}
  .pb-pie .sp{flex:1}
  @media(max-width:700px){ .pb-pie{flex-direction:column;align-items:stretch} .pb-pie .sp{display:none} }

  .pj-crew-x{background:none;border:0;color:var(--muted-2);cursor:pointer;font-size:15px;padding:0 4px}
  /* El costo de una fila de horas se toca ahí mismo. Cuando falta la tarifa el botón se ve
     ámbar y dice "sin tarifa": es a la vez el aviso y el lugar donde se arregla. */
  .pj-tf-set{background:none;border:0;padding:2px 6px;border-radius:6px;cursor:pointer;
    color:inherit;font:inherit;font-variant-numeric:tabular-nums;border-bottom:1px dashed transparent}
  .pj-tf-set:hover{background:var(--panel-2);border-bottom-color:var(--line-strong)}
  .pj-tf-set.falta{color:#f0c060;border-bottom:1px dashed #f0c060aa}
  .pj-tf-set.falta:hover{background:#f0c06018;border-bottom-color:#f0c060}
  .pj-tf-set:focus-visible{outline:2px solid var(--acid);outline-offset:2px}
  .pj-crew-x:hover{color:#ff8b8b}

  /* ---- guión y desglose ---- */
  .pj-blq > summary.pj-sum{cursor:pointer;list-style:none;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;
    font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted-2);font-weight:700}
  .pj-blq > summary.pj-sum::-webkit-details-marker{display:none}
  .pj-blq > summary.pj-sum::after{content:'▸';margin-left:auto;color:var(--muted-2);font-size:13px}
  .pj-blq[open] > summary.pj-sum::after{transform:rotate(90deg)}
  .pj-blq > summary.pj-sum > span{font-size:10.5px}
  .pj-blq > summary.pj-sum em{font-style:normal;text-transform:none;letter-spacing:0;font-size:11.5px;font-weight:400;color:var(--muted)}
  .pj-guion-body{padding-top:14px}
  /* Desglose: cada cosa con su ficha, no un chip suelto */
  .pj-necg{margin:0 0 14px}
  .pj-necg .cat{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-2);
    font-weight:700;margin:0 0 5px}
  .pj-nect{width:100%;border-collapse:collapse;font-size:12.5px}
  .pj-nect th{text-align:left;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;
    color:var(--muted-2);font-weight:700;padding:0 9px 6px 0;border-bottom:1px solid var(--line)}
  .pj-nect td{padding:6px 9px 6px 0;border-bottom:1px solid var(--line);vertical-align:top;color:var(--muted)}
  .pj-nect td.q{color:var(--text);font-weight:600;min-width:150px}
  .pj-nect td.w{white-space:nowrap}
  .pj-nect td.e{color:var(--muted-2);white-space:nowrap;font-size:11.5px}
  .pj-nect td.ev{color:var(--muted-2);font-style:italic;font-size:11.5px;line-height:1.45}
  .pj-area{border:1px solid var(--line-strong);border-radius:100px;padding:1px 8px;font-size:10.5px;
    color:var(--muted);white-space:nowrap}
  .pj-tipo{display:block;font-size:10px;letter-spacing:.06em;text-transform:uppercase;
    color:var(--muted-2);font-weight:600;margin-top:2px}
  @media(max-width:820px){
    .pj-elem thead{display:none}
    .pj-elem tbody,.pj-elem tr,.pj-elem td{display:block;width:100%}
    .pj-elem tr{border:1px solid var(--line);border-radius:10px;padding:8px 10px;margin:0 0 8px}
    .pj-elem td{border:0;padding:1px 0}
  }
  /* La ficha de proyecto por pasos */
  .pj-steps{display:flex;overflow-x:auto;border:1px solid var(--line);border-radius:13px;
    background:var(--navy-900);margin:0 0 12px;scrollbar-width:none}
  .pj-steps::-webkit-scrollbar{display:none}
  .pj-step{flex:1 0 auto;min-width:118px;border:0;background:none;color:var(--muted-2);font:inherit;
    text-align:left;padding:11px 14px 10px;cursor:pointer;border-bottom:2px solid transparent;
    border-right:1px solid var(--line)}
  .pj-step:last-child{border-right:0}
  .pj-step .n{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;color:var(--muted)}
  .pj-step .e{width:17px;height:17px;border-radius:50%;display:grid;place-items:center;
    font-size:9.5px;border:1.5px solid var(--line-strong);flex:none}
  .pj-step .d{font-size:10.5px;color:var(--muted-2);margin-top:2px;line-height:1.35;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pj-step.hecho .e{background:#7ed957;border-color:#7ed957;color:#0b1220;font-weight:800}
  .pj-step.on{background:var(--navy-800);border-bottom-color:var(--acid)}
  .pj-step.on .n{color:var(--text)}
  .pj-step.on .e{border-color:var(--acid);background:var(--acid);color:#1c2508;font-weight:800}
  .pj-step.on .d{color:var(--acid)}
  .pj-step:hover:not(.on){background:rgba(255,255,255,.02)}
  .pj-next{display:flex;gap:13px;align-items:center;flex-wrap:wrap;margin:0 0 14px;
    padding:12px 16px;background:rgba(190,242,100,.055);border:1px solid rgba(190,242,100,.22);border-radius:13px}
  .pj-next .txt{flex:1;min-width:220px;font-size:13.5px}
  .pj-next .txt b{color:var(--acid)}
  .pj-next .txt span{color:var(--muted);display:block;font-size:12px;margin-top:1px}
  /* Contactos del proyecto */
  .pj-gente{display:grid;grid-template-columns:repeat(auto-fit,minmax(212px,1fr));gap:9px}
  .pj-per{border:1px solid var(--line);border-radius:12px;padding:10px 12px;display:flex;gap:9px;
    align-items:flex-start;cursor:pointer}
  .pj-per.on{border-color:var(--acid);background:rgba(190,242,100,.045)}
  .pj-per .av{width:29px;height:29px;border-radius:50%;background:var(--navy-800);display:grid;
    place-items:center;font-size:11.5px;font-weight:700;color:var(--muted);flex:none}
  .pj-per .nm{font-size:13px;font-weight:600;line-height:1.3}
  .pj-per .rol{font-size:11px;color:var(--muted-2)}
  .pj-per .ml{font-size:11px;color:var(--muted);word-break:break-all}
  .pj-per .ck{margin-left:auto;width:17px;height:17px;border-radius:5px;border:1.5px solid var(--line-strong);
    flex:none;display:grid;place-items:center;font-size:9.5px}
  .pj-per.on .ck{background:var(--acid);border-color:var(--acid);color:#1c2508;font-weight:800}
  .pj-per select{background:none;border:0;color:var(--muted-2);font:inherit;font-size:10px;
    letter-spacing:.06em;text-transform:uppercase;font-weight:700;padding:2px 0;margin-top:3px;cursor:pointer}
  .pj-per .x{background:none;border:0;color:var(--muted-2);cursor:pointer;font-size:12px;padding:0 2px;line-height:1}
  .pj-per .x:hover{color:#ff8080}
  /* Project Brief adentro del panel */
  #pbf-modal{z-index:435}
  #plm-modal{z-index:436}
  .plm-quien{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px}
  .plm-quien span{border:1px solid var(--line);border-radius:100px;padding:3px 11px;font-size:12px;color:var(--muted)}
  .plm-quien span.no{border-color:#f0c060;color:#f0c060}
  .plm-quien span[data-plmp]{cursor:pointer}
  .plm-quien span.on{border-color:var(--acid);color:var(--acid);background:rgba(190,242,100,.07)}
  .plm-quien span.off{opacity:.5}
  .plm-tabs{display:flex;gap:6px;margin:0 0 12px;border-bottom:1px solid var(--line)}
  .plm-tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--muted-2);
    font:inherit;font-size:13px;font-weight:600;padding:7px 12px;cursor:pointer;margin-bottom:-1px}
  .plm-tabs button.on{color:var(--text);border-bottom-color:var(--acid)}
  .pb-tabs{display:flex;gap:6px;margin:2px 0 16px;border-bottom:1px solid var(--line)}
  .pb-tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--muted-2);
    font:inherit;font-size:13px;font-weight:600;padding:8px 13px;cursor:pointer;margin-bottom:-1px}
  .pb-tabs button.on{color:var(--text);border-bottom-color:var(--acid)}
  .pb-pane{max-height:min(66vh,640px);overflow:auto;padding-right:4px}

  /* ── Mandarles algo ── */
  .ml-para{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
  .ml-chip{display:flex;align-items:center;gap:8px;border:1px solid var(--line-strong);border-radius:99px;
    padding:6px 12px 6px 8px;font-size:13px;background:rgba(255,255,255,.03)}
  .ml-chip.no{opacity:.5;border-style:dashed}
  .ml-chip .em{color:var(--muted-2);font-size:12px}
  .ml-chip button{background:none;border:0;color:var(--muted-2);cursor:pointer;font-size:14px;line-height:1;padding:0 2px}
  .ml-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 14px}
