    box.hidden = false;
  }

  /* Qué pasó DESPUÉS de cada llamada. Se cuenta por persona y no por reserva: la misma
     persona que reprograma dos veces sigue siendo una sola conversación, contarla dos
     veces inflaría el numerador y el denominador de formas distintas. */
  async function bkPerfRender(){
    const box = $('bk-perf'); if (!box) return;
    const { data, error } = await supabase.from('bookings')
      .select('lead_id,start_at,status').lt('start_at', new Date().toISOString()).limit(1000);
    if (error || !data || !data.length){ box.hidden = true; return; }
    const AVANZO = ['videocall', 'propuesta', 'ganado'];
    const ids = [...new Set(data.map((b) => b.lead_id).filter(Boolean))];
    const gente = ids.map((id) => (allLeads || []).find((l) => String(l.id) === String(id))).filter(Boolean)
      .filter((l) => !esInterno(l.email));
    if (!gente.length){ box.hidden = true; return; }
    const avanzaron = gente.filter((l) => AVANZO.includes(l.status));
    const propuesta = gente.filter((l) => l.status === 'propuesta' || l.status === 'ganado');
    const ganados = gente.filter((l) => l.status === 'ganado');
    const pct = Math.round((propuesta.length / gente.length) * 100);
    const k = (n, l, sub) => '<div class="kpi"><div class="n">' + n + '</div><div class="l">' + l + '</div>'
      + (sub ? '<div class="muted-note" style="margin-top:2px;font-size:11.5px">' + sub + '</div>' : '') + '</div>';
    $('bk-perf-k').innerHTML = k(gente.length, 'Personas con call', 'sin internos ni pruebas')
      + k(propuesta.length, 'Llegaron a propuesta', '')
      + k(pct + '%', 'Call → propuesta', '')
      + k(ganados.length, 'Ganados', '');
    /* Con un puñado de llamadas el porcentaje se mueve 20 puntos con una sola persona:
       se muestra igual, pero diciendo que todavía no se lee como una tasa. */
    $('bk-perf-note').textContent = gente.length < 8
      ? 'Son ' + gente.length + (gente.length === 1 ? ' llamada' : ' llamadas') + ' — todavía muy pocas para leer el porcentaje como una tasa.'
      : (avanzaron.length - propuesta.length > 0
        ? (avanzaron.length - propuesta.length) + ' más quedaron en videocall sin propuesta todavía.'
        : 'Todas las que avanzaron llegaron hasta la propuesta.');
    box.hidden = false;
  }

  async function saveBookingSet(){
    if (!meEmail) { toast('Sin sesión detectada — entrá de nuevo'); return; }
    const durations = [...document.querySelectorAll('.bks-dur:checked')].map((x) => +x.value);
    const days = [...document.querySelectorAll('#bks-days input:checked')].map((x) => +x.value);
    if (!durations.length) { toast('Elegí al menos una duración'); return; }
    if (!days.length) { toast('Elegí al menos un día'); return; }
    const row = { updated_at: new Date().toISOString(), active: $('bks-active').checked,
      work_start: time2mins($('bks-start').value), work_end: time2mins($('bks-end').value),
      notice_hours: +$('bks-notice').value || 0, horizon_days: +$('bks-horizon').value || 28,
      buffer_min: +$('bks-buffer').value || 0, durations, days,
      host_name: $('bks-hname').value.trim(), host_role: $('bks-hrole').value.trim(),
      msg_en: $('bks-msg-en').value.trim() || null, msg_de: $('bks-msg-de').value.trim() || null, msg_es: $('bks-msg-es').value.trim() || null };
    // fix: cada persona (dueño incluido) escribe SU PROPIA fila por email — antes el dueño
    // pisaba siempre la fila legacy id=1, dejando su fila real huérfana e inaccesible
    row.email = meEmail;
    if (row.work_end - Math.max(...durations) < row.work_start) { toast('El horario es demasiado corto para la duración más larga'); return; }
    let error;
    if (bkRowId) {
      ({ error } = await supabase.from('booking_settings').update(row).eq('id', bkRowId));
    } else {
      const res = await supabase.from('booking_settings').insert(row).select('id').maybeSingle();
      error = res.error; if (!error && res.data) bkRowId = res.data.id;
    }
    if (error) { toast('No se pudo guardar (¿SQL 0073?): ' + error.message); return; }
    $('bks-note').textContent = '';
    toast('📅 Tus horarios de booking quedaron guardados');
  }
  $('bks-save') && $('bks-save').addEventListener('click', saveBookingSet);

