          <span class="pp-sum" id="pp-sum" hidden title="Del paquete recomendado. Si no marcaste ninguno, del más caro."></span>
          <span class="pp3-auto" id="pp3-autosave" hidden></span>
          <button class="btn btn-ghost small" id="pp-preview" type="button">👁 Vista previa</button>
          <button class="btn btn-ghost small" id="pp-view" type="button" hidden>🔗 Ver link</button>
          <button class="btn btn-ghost small" id="pp-del" type="button">🗑 Borrar</button>
          <button class="btn btn-ghost small" id="pp-save" type="button">💾 Guardar</button>
          <button class="btn btn-ghost small" id="pp-tpl-save" type="button" title="Guardar esta propuesta como template reutilizable">📋 Template</button>
          <button class="btn btn-primary small" id="pp-publish" type="button">🌐 Publicar</button>
