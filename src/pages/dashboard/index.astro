      const when = new Date(followUpTargetAt).toLocaleDateString('es-CH', { year: 'numeric', month: 'long' });
      supabase.from('lead_notes').insert({ lead_id: String(lead.id), author: 'Pipeline', body: '🕓 Seguimiento futuro — retomar en ' + when + (followUpReason ? ' — motivo: ' + followUpReason : '') }).then(() => {}, () => {});
    }
