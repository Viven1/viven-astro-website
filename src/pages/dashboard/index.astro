      '<label class="ofc-l">Nota (arriba de la oferta — editala a gusto)</label><textarea class="ed-inp" id="ofc-note" style="min-height:150px">' + esc(note0) + '</textarea>' +
      (ofCur.closing_text ? '<label class="ofc-l">Cierre (③ — va al final del email y del PDF)</label><div class="muted-note" style="font-size:12.5px;white-space:pre-wrap;border:1px solid var(--line);border-radius:9px;padding:8px 10px">' + esc(ofCur.closing_text) + '</div>' : '') +
      '<div class="of3-attach" style="margin-top:10px">📄 ' + esc(attachName) + '<small>PDF adjunto generado al enviar — el cliente lo puede reenviar o imprimir</small></div>' +
      '<p class="muted-note" style="margin:8px 0 0">El email lleva la oferta embebida (posiciones + totales) + el PDF adjunto y el botón para agendar un call. Se envía desde info@viven.ch.</p>' +
