  /* Entrar con Google. El destino va escrito y no location.origin: en localhost no
     está en la lista blanca de Supabase y el único resultado sería un error raro.
     El hd=viven.ch solo hace que Google proponga la cuenta de la casa — NO es un
     candado: el candado es user_roles (SQL 0127). */
  const OAUTH_DESTINO = 'https://www.viven.ch/dashboard/';
  $('login-google') && $('login-google').addEventListener('click', async (e) => {
    const b = e.currentTarget, err = $('login-google-err');
    err.hidden = true; b.disabled = true; b.textContent = 'Abriendo Google…';
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: OAUTH_DESTINO, queryParams: { hd: 'viven.ch' } }
    });
    // si falla acá no hubo redirección: se avisa y se devuelve el botón
    if (error){ err.textContent = 'No se pudo abrir Google: ' + (error.message || error); err.hidden = false; b.disabled = false; b.textContent = 'Entrar con Google'; }
  });
  /* El "no" de Google no vuelve por el promise de arriba: vuelve como parámetro en la
     URL de /dashboard/. Sin esto, alguien sin acceso ve el login otra vez y entiende
     que el botón está roto, cuando lo que pasa es que falta darle de alta. */
  (function avisarErrorOAuth(){
    const p = new URLSearchParams(location.hash.replace(/^#/, '') || location.search.replace(/^\?/, ''));
    const raw = p.get('error_description') || p.get('error');
    if (!raw) return;
    const txt = decodeURIComponent(raw).replace(/\+/g, ' ');
    const el = $('login-google-err'); if (!el) return;
    el.textContent = /signup|not allowed|disabled/i.test(txt)
      ? 'Esa cuenta de Google todavía no tiene acceso al dashboard. Pedile a Sebastián que te dé de alta — no es un error del botón.'
      : 'Google no completó el ingreso: ' + txt;
    el.hidden = false;
    // se limpia la URL para que un F5 no repita el cartel de algo ya leído, sin
    // llevarse puesto un ?lead=… que el error puede haber venido acompañando
    history.replaceState(null, '', location.pathname + (location.hash ? location.search : ''));
