  function hmRenderAgenda(){
    const box = $('hm-agenda'); if (!box) return;
    const seg = $('hm-agenda-seg');
    // el toggle Mías/Todas solo existe para superadmin — cualquier otra persona
    // (Sofia incluida) siempre queda forzada a 'mine', sin opción de ver la ajena
    if (seg){
      if (!isSuperadmin){ seg.innerHTML = ''; hmAgendaScope = 'mine'; }
      else {
        seg.innerHTML = ['mine', 'all'].map((k) =>
          '<button type="button" data-k="' + k + '" class="' + (hmAgendaScope === k ? 'on' : '') + '">' + (k === 'mine' ? 'Mías' : 'Todas') + '</button>').join('');
        seg.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { hmAgendaScope = b.dataset.k; hmRenderAgenda(); }));
      }
    }
    /* ===== LO QUE VIENE Y LO QUE PASÓ =====
       La Agenda mostraba solo los próximos 7 días, y con eso estaba vacía casi
       siempre: medido el 25 ago, 0 reuniones adelante, 8 en los últimos 30 días y la
       última fue ayer. Miraba para el lado donde no estaban los datos, y una pantalla
       que casi siempre está vacía se deja de abrir.
       Ahora es una línea de tiempo: reuniones pasadas y futuras, más las tareas con
       fecha —que existían y vivían solo en Hoy— con el día de hoy marcado en el medio.
       Si no hay nada adelante, lo de atrás sigue siendo información: a quién viste
       esta semana y con quién no hablás hace un mes. */
    const ahora = Date.now();
    const mine = (b) => (b.host_email || '').toLowerCase() === (meEmail || '').toLowerCase();
    const mias = (b) => hmAgendaScope === 'all' ? true : mine(b);
    const items = [];
    (upBookings || []).filter(mias).forEach((b) => items.push({ t: Date.parse(b.start_at), tipo: 'call', b }));
    (bookingsPasadas || []).filter(mias).forEach((b) => items.push({ t: Date.parse(b.start_at), tipo: 'call', b, pasado: true }));
    /* Las tareas con fecha son compromisos con día y hora igual que una reunión. Que
       vivieran solo en Hoy hacía que la Agenda dijera "no tenés nada" teniendo tres. */
    if (dlTasksAt) Object.keys(dlTasksMap || {}).forEach((lid) => {
      const t = dlTasksMap[lid];
      if (!t || !t.due_date) return;
      if (meEmail && t.assignee && String(t.assignee).toLowerCase() !== meEmail && hmAgendaScope !== 'all') return;
      const cuando = Date.parse(t.due_date + 'T' + (t.due_time || '09:00') + ':00');
      if (!cuando || cuando < ahora - 30 * 864e5) return;
      items.push({ t: cuando, tipo: 'task', task: t, lead: lid, pasado: cuando < ahora });
    });
    items.sort((a, b) => a.t - b.t);
    if (!items.length){
      box.innerHTML = '<p class="muted-note">' + (hmAgendaScope === 'all' ? 'Sin reuniones ni tareas del equipo en los últimos 30 días ni adelante.' : 'Sin reuniones ni tareas tuyas en los últimos 30 días ni adelante.') + '</p>';
      return;
    }
    const fmtCuando = (ms) => {
      const d = new Date(ms);
      return d.toLocaleDateString('es-CH', { weekday: 'short', day: '2-digit', month: 'short' }) + ' · ' + d.toLocaleTimeString('es-CH', { hour: '2-digit', minute: '2-digit' });
    };
    let puestoHoy = false;
    box.innerHTML = items.map((it) => {
      let marca = '';
      if (!puestoHoy && it.t >= ahora){ puestoHoy = true; marca = '<div class="ag-hoy"><span>hoy</span></div>'; }
      if (it.tipo === 'task'){
        return marca + '<div class="hatt-call' + (it.pasado ? ' ag-pas' : '') + '">' +
          '<span class="hc-when">✅ ' + esc(fmtCuando(it.t)) + '</span>' +
          '<button class="hc-who" type="button" data-lead="' + esc(String(it.lead)) + '">' + esc(it.task.title || 'Tarea') + '</button>' +
          '<span class="hc-dur">' + (it.pasado ? 'vencida' : 'tarea') + '</span></div>';
      }
      const b = it.b;
      const hostBadge = (hmAgendaScope === 'all' && b.host_email) ? '<span class="hc-host">' + esc(teamName(b.host_email).split(/\s+/)[0] || b.host_email) + '</span>' : '';
      return marca + '<div class="hatt-call' + (it.pasado ? ' ag-pas' : '') + '">' +
        '<span class="hc-when">📅 ' + esc(fmtCuando(it.t)) + '</span>' +
        '<button class="hc-who" type="button"' + (b.lead_id ? ' data-lead="' + esc(String(b.lead_id)) + '"' : '') + '>' + esc(b.name || b.email) + '</button>' +
        hostBadge +
        '<span class="hc-dur">' + (b.duration_m || 15) + ' min</span>' +
        (!it.pasado && b.meet_url ? '<a class="hc-meet" href="' + esc(b.meet_url) + '" target="_blank" rel="noopener">Meet ↗</a>' : '') +
      '</div>';
    }).join('') + (puestoHoy ? '' : '<div class="ag-hoy"><span>hoy</span></div><p class="muted-note" style="margin:10px 0 0">Nada agendado de acá en adelante.</p>');
    box.querySelectorAll('.hc-who[data-lead]').forEach((b) => b.addEventListener('click', () => openLead(b.dataset.lead)));
  }

  // Video calls booked por persona, 30 días (pedido explícito: "en algún lugar tenemos que
  // trackear la cantidad de video calls booked per person, tmb es muy importante para los
  // steps"). Cuenta por host_email de bookings.created_at (cuándo se hizo la reserva).
  // Sofia (member) ve solo su propio número; superadmin ve el desglose de todo el equipo.
  function hmRenderCalls(){
    const box = $('hm-calls'); if (!box) return;
    const counts = {};
    (bookingsHist || []).forEach((b) => { const e = (b.host_email || '').toLowerCase(); if (!e) return; counts[e] = (counts[e] || 0) + 1; });
    if (!isSuperadmin){
      const mine = counts[(meEmail || '').toLowerCase()] || 0;
      box.innerHTML = '<div class="kpi" style="border:0;background:none;padding:0"><div class="n">' + mine + '</div><div class="l">video calls agendadas por vos</div></div>';
      return;
    }
    const emails = Object.keys(counts);
    if (!emails.length){ box.innerHTML = '<p class="muted-note">Sin video calls agendadas en los últimos 30 días.</p>'; return; }
    const total = emails.reduce((a, e) => a + counts[e], 0);
    const max = Math.max(1, ...emails.map((e) => counts[e]));
    const rows = emails.sort((a, b) => counts[b] - counts[a]).map((e) => {
      const pct = Math.round(counts[e] / max * 100);
      return '<div class="bar-row"><span class="lbl">' + esc(teamName(e) || e) + '</span><div class="track"><div class="fill" style="width:' + pct + '%"></div></div><span class="val">' + counts[e] + '</span></div>';
    }).join('');
    box.innerHTML = '<div class="bars">' + rows + '</div><p class="muted-note" style="margin-top:8px">Total equipo: ' + total + '</p>';
  }

  // sparkline: 8 semanas ISO (lunes a lunes), última barra = semana en curso (ácida)
  function hmRenderSpark(){
    const box = $('hm-spark'), cap = $('hm-spark-cap'); if (!box) return;
    if (!hmViews60){ box.innerHTML = ''; if (cap) cap.textContent = 'cargando…'; return; }
    const w0 = (() => { const x = new Date(); x.setHours(0, 0, 0, 0); x.setDate(x.getDate() - (x.getDay() + 6) % 7); return x.getTime(); })();
    const b = Array(8).fill(0);
    hmViews60.forEach((v) => {
      const t = Date.parse(v.created_at); if (!t) return;
      const i = 7 + Math.floor((t - w0) / (7 * 864e5));   // 7 = semana actual, 0 = hace 7 semanas
      if (i >= 0 && i <= 7) b[i]++;
    });
    const max = Math.max(1, ...b);
    box.innerHTML = b.map((n, i) => '<i class="' + (i === 7 ? 'on' : '') + '" style="height:' + Math.max(4, Math.round(n / max * 100)) + '%" title="' + n + ' vistas"></i>').join('');
    if (cap) cap.textContent = 'esta semana: ' + b[7].toLocaleString('de-CH');
  }

  /* Resumen de analítica: qué temas mira la gente y cuántos leads deja cada uno
     (rpc_demanda_28d, el mismo dato que alimenta las oportunidades) + visitas y
     conversión del mes. Ocupa el lugar de Google Ads cuando no hay inversión. */
  async function hmRenderAnalitica(box){
    box.innerHTML = '<p class="muted-note">Cargando la analítica…</p>';
    const dem = await hmDemanda();
    if (!dem || !dem.length){
      box.innerHTML = '<p class="muted-note">Sin datos todavía. (Google Ads: cargá la inversión en Analytics → Google Ads.)</p>';
      return;
    }
    // visitas de los últimos 30 días desde el mismo array que ya usa el sparkline
    const desde30 = Date.now() - 30 * 864e5;
    const visitas = (hmViews60 || []).filter((v) => Date.parse(v.created_at || '') >= desde30).length;
    /* SIN los importados de bexio: son 168 contactos que entraron de la
       contabilidad, no gente que llegó por el sitio. Contarlos daba "187 leads
       en 30 días" y 4,9% de conversión cuando lo real son 19 y 0,5% — un número
       lindo y falso, que es peor que no tener número. */
    const leads30 = (allLeads || []).filter((l) =>
      Date.now() - Date.parse(l.created_at || '') < 30 * 864e5 && !esCartera(l)).length;
    /* ===== Ojo con el denominador =====
       Acá se calculaba "% de visitantes deja lead" como leads de 30 días dividido
       por las sesiones de 28 — y desde la 0139 esa columna pasó a ser PERSONAS
       medidas (que arrancan el 24/08). Dividir 30 días de leads por un día de
       personas daba 46%: el mismo error que Sebastián ya había cazado una vez.
       La tasa se saca del mismo período o no se saca. Como acá los dos números
       vienen de ventanas distintas, se muestra lo que cada uno es y listo. */
    const personasMed = dem.reduce((a, d) => a + (+d.personas || 0), 0);
    const top = dem.slice(0, 5);
    const topMax = top[0] ? (+top[0].sesiones_28d || 1) : 1;
    box.innerHTML =
      '<p class="muted-note" style="margin:0 0 10px">Sin inversión en Ads cargada — mientras tanto, lo que sí sabemos:</p>' +
      '<div class="hm-ads-grid" style="margin-bottom:12px">' +
        '<div><b>' + (visitas ? visitas.toLocaleString('de-CH') : '—') + '</b><span>visitas 30 d · incluye bots</span></div>' +
        '<div><b>' + leads30 + '</b><span>leads de la web (30 días)</span></div>' +
        '<div><b>' + (personasMed || '—') + '</b><span>personas confirmadas · desde el 24/08</span></div>' +
        '<div><b>' + dem.length + '</b><span>temas con tráfico</span></div>' +
      '</div>' +
      '<div class="hm-an-list">' + top.map((d) => {
        const ses = +d.sesiones_28d || 0, per = +d.personas || 0;
        const pct = Math.round(ses / topMax * 100);
        const seco = +d.leads === 0;
        /* Un tema con muchísimas sesiones y casi ninguna persona es un imán de
           bots, no demanda: se marca para que no se lea como interés real. */
        const bots = ses >= 100 && per <= 1;
        return '<div class="hm-an-row">' +
          '<span class="hm-an-t">' + esc(d.tema) + (bots ? ' <span title="Casi todo tráfico automático">🤖</span>' : '') + '</span>' +
          '<span class="hm-an-bar"><i style="width:' + pct + '%"></i></span>' +
          '<span class="hm-an-n">' + ses.toLocaleString('de-CH') + '</span>' +
          '<span class="hm-an-l' + (seco ? ' seco' : '') + '">' + d.leads + (+d.leads === 1 ? ' lead' : ' leads') + '</span>' +
        '</div>';
      }).join('') + '</div>' +
      '<p class="muted-note" style="margin:10px 0 0">Sesiones por tema en 28 días (el orden entre temas sirve; el número incluye tráfico automático). 🤖 marca los temas donde casi no hubo gente. En naranja, lo que trae tráfico y no deja nada.</p>';
  }

  function hmRenderAds(){
    const box = $('hm-ads'); if (!box) return;
    const spend = hmAds ? (+hmAds.spend || 0) : 0;
    if (!spend){
      /* Sin inversión cargada, esta tarjeta era un cartel muerto ocupando un
         cuarto de la pantalla. Sebastián, 14 ago: "google ads no tiene info
         pero sí tenemos toda la analítica, poné resumen ahí". Así que muestra
         de dónde viene la gente y qué mira — datos que ya tenemos. */
      hmRenderAnalitica(box);
      return;
    }
    const st = hmAdsStats();
    const roas = st.wonVal / spend;
    box.innerHTML = '<div class="hm-ads-grid">' +
      '<div><b>' + fmtChf(spend) + '</b><span>Inversión' + (hmAds.official ? '' : ' (manual)') + '</span></div>' +
      '<div><b>' + st.leads + '</b><span>Leads desde Ads</span></div>' +
      '<div><b>' + (st.leads ? fmtChf(Math.round(spend / st.leads)) : '–') + '</b><span>Costo por lead</span></div>' +
      '<div><b>×' + roas.toFixed(1) + '</b><span>ROAS</span></div></div>' +
      '<div class="hm-verdict" style="color:' + (roas >= 1 ? '#7ed957' : '#ff8b8b') + '">' +
      (roas >= 1 ? 'Cada franco invertido volvió ×' + roas.toFixed(1) + ' ✓' : 'Cada franco invertido volvió ×' + roas.toFixed(1) + ' ✗ — todavía no se recupera') + '</div>';
  }

  // pageviews de 60 días (solo created_at): UNA vez por ciclo, TTL 10 min — alimenta sparkline y KPI visitas
  async function hmFetchWeeks(){
    if (hmViews60Busy || (hmViews60 && Date.now() - hmViews60At < 6e5)) return;
    hmViews60Busy = true;
    try {
      const { data, error } = await fetchAllRows('pageviews', 'created_at', new Date(Date.now() - 60 * 864e5).toISOString(), new Date().toISOString());
      if (!error && data){ hmViews60 = data; hmViews60At = Date.now(); if (!$('tab-hoy').hidden) renderHome(); }
    } catch (e) { /* best-effort */ }
    finally { hmViews60Busy = false; }
  }

  // gasto de Ads: gads-stats UNA vez por día por navegador (cache en localStorage) + fallback manual
  async function hmFetchAds(){
    const today = new Date().toISOString().slice(0, 10);
    if (hmAds && hmAds.date === today) return;
    try {
      const c = JSON.parse(localStorage.getItem(HM_ADS_LS) || 'null');
      if (c && c.date === today){ hmAds = c; if (!$('tab-hoy').hidden) renderHome(); return; }
    } catch (e) { /* cache corrupto → refetch */ }
    if (hmAdsBusy) return;
    hmAdsBusy = true;
    let spend = 0, official = false;
    try { const { data: gs } = await supabase.functions.invoke('gads-stats', { body: { days: 30 } }); if (gs && gs.ok){ spend = Math.round(gs.total.cost); official = true; } } catch (e) { /* función no deployada / token pendiente */ }
    // mismos fallbacks que el tab de Ads: inversión manual (ads_settings → localStorage)
    if (!spend){ try { const { data: st } = await supabase.from('ads_settings').select('spend').eq('id', 1).maybeSingle(); spend = +((st || {}).spend || 0); } catch (e) { /* tabla pendiente (SQL 0037) */ } }
    if (!spend) spend = +(localStorage.getItem('vv_ads_spend') || 0);
    hmAds = { date: today, spend, official };
    try { localStorage.setItem(HM_ADS_LS, JSON.stringify(hmAds)); } catch (e) { /* sin espacio */ }
    hmAdsBusy = false;
    if (!$('tab-hoy').hidden) renderHome();
  }

  /* El resumen de IA del día (hmAi/hmAiRender/hmAiSummary) vivía acá. Se borró el
     25 ago 2026 junto con su tarjeta en Hoy — ver el comentario del markup. Los
     insights con IA siguen existiendo donde sí aportan: Analytics (sobre el tráfico)
     y Pipeline (sobre los deals). */
  /* ---------- 📤 Para mandar: borradores esperando el ok ----------
     Reusa la bandeja de salida que ya existe (tabla outbox) y su camino de
     envío: aprobar deja status='approved' con 10 minutos de ventana, y
     automations-run lo manda pasada la ventana. NO hay un segundo camino de
     envío — un email que sale por dos lados distintos es un email que algún día
     sale dos veces. */
  let sqRows = [];
  async function sqLoad(){
    const { data, error } = await supabase.from('outbox')
      .select('id,lead_id,subject,body,sender,kind,created_at')
      .eq('status', 'pending').order('created_at', { ascending: true }).limit(12);
    sqRows = error ? [] : (data || []);
    sqRender();
  }
  function sqRender(){
    const card = $('sq-card'), list = $('sq-list'); if (!card || !list) return;
    card.hidden = false;                                  // el botón de escribir vive acá aunque no haya nada
    $('sq-n').textContent = sqRows.length || '';
    if (!sqRows.length){
      list.innerHTML = '<p class="muted-note" style="margin:0">Ningún borrador esperando. Escribí el próximo con el botón de abajo.</p>';
      $('sq-note').textContent = '';
      return;
    }
    /* Tres, no todos. Medido el 24/08: este panel ocupaba 726 px de los 2.313 de Hoy
       — el más grande de la pantalla. Los que no entran siguen a un click. */
    const SQ_VIS = 3;
    list.innerHTML = sqRows.slice(0, SQ_VIS).map((o) => {
      const l = leadById(o.lead_id) || {};
      const quien = l.name || l.company || l.email || ('lead ' + o.lead_id);
      const cuerpo = String(o.body || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
      return '<div class="hm-item" style="cursor:default;align-items:flex-start">' +
        '<span class="ic">✉️</span>' +
        '<span class="tx">' +
          '<b>' + esc(quien) + '</b>' +
          '<small class="sq-subj">' + esc(o.subject || '(sin asunto)') + '</small>' +
          '<small class="sq-body">' + esc(cuerpo.slice(0, 90)) + (cuerpo.length > 90 ? '…' : '') + '</small>' +
        '</span>' +
        '<span class="wq-acts">' +
          '<button class="wq-b ok" data-sq-ok="' + o.id + '" type="button" title="Aprobar y enviar">✓</button>' +
          '<button class="wq-b" data-sq-ed="' + o.id + '" type="button" title="Editar en la Bandeja">✎</button>' +
          '<button class="wq-b" data-sq-no="' + o.id + '" type="button" title="No enviar">✕</button>' +
        '</span></div>';
    }).join('') +
      (sqRows.length > SQ_VIS
        ? '<button class="hm-more" id="sq-more" type="button">ver los otros ' + (sqRows.length - SQ_VIS) + ' →</button>'
        : '');
    const sqMore = $('sq-more');
    if (sqMore) sqMore.addEventListener('click', () => gotoTab('leads'));
    $('sq-note').textContent = 'Al aprobar quedan 10 minutos para deshacerlo antes de que salga.';
    list.querySelectorAll('[data-sq-ok]').forEach((b) => b.addEventListener('click', async () => {
      const o = sqRows.find((x) => String(x.id) === b.dataset.sqOk); if (!o) return;
      const l = leadById(o.lead_id) || {};
      if (!confirm('¿Aprobar este email para ' + (l.name || l.email || 'este contacto') + '?\n\nAsunto: ' + (o.subject || '') + '\n\nSale en 10 minutos — hasta entonces se puede deshacer desde la Bandeja.')) return;
      const { error } = await supabase.from('outbox').update({ status: 'approved', scheduled_at: obUndoSched(o.id) }).eq('id', o.id);
      if (error){ toast('No se pudo aprobar: ' + error.message); return; }
      toast('✅ Aprobado — sale en 10 minutos'); sqLoad();
    }));
    list.querySelectorAll('[data-sq-ed]').forEach((b) => b.addEventListener('click', () => {
      gotoTab('sistema'); sistemaSetSub('auto'); obFocus(b.dataset.sqEd);
    }));
    list.querySelectorAll('[data-sq-no]').forEach((b) => b.addEventListener('click', async () => {
      await supabase.from('outbox').update({ status: 'discarded' }).eq('id', b.dataset.sqNo);
      toast('✕ No se envía'); sqLoad();
    }));
  }
  /* Escribir el próximo: agarra a la persona más urgente de "Para hoy" que
     todavía no tenga borrador, le escribe el email con la IA (leyendo su
     conversación real) y lo deja acá para aprobar. Nunca manda solo. */
  async function sqWriteNext(){
    const btn = $('sq-write'); if (!btn || btn.disabled) return;
    const conBorrador = new Set(sqRows.map((o) => String(o.lead_id)));
    const cand = hmTodayItems().map((i) => i.leadId).filter(Boolean)
      .find((id) => !conBorrador.has(String(id)));
    if (!cand){ toast('No hay nadie pendiente sin borrador'); return; }
    const r = leadById(cand);
    if (!r || !r.email){ toast('Ese contacto no tiene email'); return; }
    btn.disabled = true; btn.textContent = '✍️ Escribiendo a ' + (r.name || r.email) + '…';
    try {
      const { data: hist } = await supabase.from('email_log').select('direction,subject,body').eq('lead_id', String(r.id)).order('created_at', { ascending: false }).limit(8);
      const history = (hist || []).map((h) => ({ direction: h.direction, subject: h.subject, body: String(h.body || '').replace(/<[^>]+>/g, ' ').slice(0, 800) }));
      /* lead ACOTADO: mandar la fila entera arrastra el enrichment de la IA y
         otros campos largos, y el modelo devolvía texto suelto en vez del JSON
         ("formato inesperado", visto al probarlo). Con los campos que la
         función realmente usa, contesta bien. */
      const magro = { id: r.id, name: r.name, first_name: r.first_name, email: r.email, company: r.company,
        status: r.status, channel: r.channel, lang: r.lang, message: String(r.message || '').slice(0, 1500) };
      const { data, error } = await supabase.functions.invoke('ai-email-draft', { body: { lead: magro, sender, hint: '', history, brief: '' } });
      if (error || !data || data.error || !data.body) throw new Error(data?.error || error?.message || 'sin respuesta');
      const { error: e2 } = await supabase.from('outbox').insert({
        lead_id: r.id, kind: 'followup', sender, subject: data.subject || '', body: data.body, status: 'pending' });
      if (e2) throw new Error(e2.message);
      toast('✍️ Borrador listo para ' + (r.name || r.email));
      await sqLoad();
    } catch (e) { toast('No se pudo escribir: ' + (e.message || e)); }
    finally { btn.disabled = false; btn.textContent = '✍️ Escribir el próximo'; }
  }

  /* ---------- 🌐 Oportunidades de la web ----------
     El CRM dice a quién escribirle hoy; esto dice qué construir para que mañana
     haya más a quién escribirle. Sale de la demanda REAL del sitio
     (rpc_demanda_28d, SQL 0125: personas por tema y cuántos leads dejó cada uno)
     cruzada con lo que ya existe: un solo lead magnet, los posts publicados.

     La demanda se agrega en Postgres a propósito: son 7.640 pageviews en 28
     días y PostgREST devuelve como mucho 1000 filas SIN avisar — contarlas en el
     navegador daba el 13% del mes y parecía el mes entero. */
  const HM_OP_LS = 'viven_hm_op_v1';
  let hmDem = null, hmOpTried = false;
  async function hmDemanda(){
    if (hmDem) return hmDem;
    const { data, error } = await supabase.rpc('rpc_demanda_28d');
    if (error) return null;                       // SQL 0125 sin correr → la tarjeta lo dice
    hmDem = data || [];
    return hmDem;
  }
  function hmOpSummary(dem){
    const k = hmDealKpis();
    const posts = (blogsList || []).filter((b) => b.status === 'published');
    return {
      /* Dos números por tema, y hay que decirle a la IA cuál es cuál: `sesiones_28d`
         incluye tráfico automático (sirve para el orden relativo entre temas) y
         `personas` son las confirmadas de gente, que se miden desde el 24/08 y por
         eso son pocas. Sin esta aclaración la IA leía 771 sesiones de "recursos"
         como demanda real — y ahí hubo 1 sola persona. */
      contexto: 'Viven, productora de video en Zúrich. Estos son los TEMAS que se miraron en el sitio en 28 días y cuántos leads dejó cada uno. IMPORTANTE: "sesiones_28d" incluye tráfico automático (bots) — sirve solo para comparar temas entre sí, nunca como cantidad de gente. "personas" son visitas humanas confirmadas y se miden recién desde el 24/08, así que el número es chico por la fecha, no por falta de interés. Un tema con muchas sesiones y casi ninguna persona es tráfico de bots, no demanda. Devolvé 3 oportunidades CONCRETAS de contenido/web para convertir ese tráfico en leads: lead magnets, artículos, cambios en una página, campañas. Nada de CRM ni de seguimiento a clientes puntuales — eso ya está cubierto en otra pantalla. Cada una tiene que citar el número que la justifica y decir qué archivo/página tocar.',
      demanda_28d: (dem || []).map((d) => ({ tema: d.tema, personas: d.personas, sesiones_28d: d.sesiones_28d, leads: d.leads })),
      lead_magnets_existentes: ['social media formats (PDF, EN/DE/ES) — es el único'],
      posts_publicados: posts.length,
      idiomas_del_sitio: ['en', 'de', 'es'],
      kpis: { leads_30d: (allLeads || []).filter((l) => Date.now() - Date.parse(l.created_at || '') < 30 * 864e5).length,
        pipeline_abierto_chf: Math.round(k.openVal) },
    };
  }
  function hmOpRenderTodas(list){ hmOpRender(list, true); }
  function hmOpRender(list, todas){
    const body = $('hm-op'); if (!body) return;
    if (!list || !list.length){ body.innerHTML = '<p class="muted-note">Sin oportunidades nuevas hoy.</p>'; return; }
    /* Dos. Ocupaba 553 px y son ideas, no urgencias: no compiten con lo que hay que
       hacer hoy. El resto se despliega si querés leerlas. */
    const OP_VIS = todas ? list.length : 2;
    const visibles = list.slice(0, OP_VIS);
    body.innerHTML = visibles.map((o, i) =>
      '<div class="hm-op-it">' +
        '<div class="hm-op-t">' + esc(o.icon || '💡') + ' ' + esc(o.title || '') + '</div>' +
        '<div class="hm-op-d">' + esc(o.detail || '') + '</div>' +
        '<div class="hm-op-a"><button class="btn btn-primary small" data-op="' + i + '" type="button">Aprobar</button></div>' +
      '</div>').join('') +
      (list.length > OP_VIS ? '<button class="hm-more" id="hm-op-more" type="button">ver las otras ' + (list.length - OP_VIS) + ' →</button>' : '');
    const opMore = $('hm-op-more');
    if (opMore) opMore.addEventListener('click', () => { opMore.remove(); hmOpRenderTodas(list); });
    body.querySelectorAll('[data-op]').forEach((b) => b.addEventListener('click', async () => {
      const o = list[+b.dataset.op]; if (!o) return;
      b.disabled = true;
      // sin url: una oportunidad no tiene "dónde ir", y un ↗ que te deja en la
      // misma pantalla es peor que no tener botón (lo reportó Sebastián)
      const ok = await wqAdd({ source: 'idea', ref: 'op:' + String(o.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40),
        title: o.title || 'Oportunidad de la web', detail: o.detail || '' });
      b.textContent = ok ? '✓ En la cola' : 'Ya estaba';
    }));
  }
  async function hmOportunidades(force){
    const body = $('hm-op'); if (!body) return;
    const today = new Date().toISOString().slice(0, 10);
    if (!force){
      try {
        const c = JSON.parse(localStorage.getItem(HM_OP_LS) || 'null');
        if (c && c.date === today && Array.isArray(c.list)){ hmOpRender(c.list); return; }
      } catch (e) { /* cache corrupto → regenerar */ }
      if (hmOpTried) return;
    }
    hmOpTried = true;
    const btn = $('hm-op-btn'); if (btn) btn.disabled = true;
    body.innerHTML = '<p class="ai-loading">Mirando qué busca la gente…</p>';
    try {
      const dem = await hmDemanda();
      if (!dem) { body.innerHTML = '<p class="muted-note">Falta correr el SQL <b>0125</b> (demanda por tema).</p>'; return; }
      const { data, error } = await supabase.functions.invoke('ai-insights', { body: { summary: hmOpSummary(dem), lang: 'es' } });
      const list = data && Array.isArray(data.insights) ? data.insights.slice(0, 3) : null;
      if (error || !list) throw new Error(data?.error || error?.message || 'sin respuesta');
      try { localStorage.setItem(HM_OP_LS, JSON.stringify({ date: today, list })); } catch (e) { /* sin espacio */ }
      hmOpRender(list);
    } catch (e) {
      body.innerHTML = '<p class="muted-note">No se pudo generar: ' + esc(e.message) + '</p>';
    } finally { if (btn) btn.disabled = false; }
  }
  $('hm-op-btn').addEventListener('click', () => hmOportunidades(true));
  $('sq-write') && $('sq-write').addEventListener('click', () => sqWriteNext());

  /* ---------- 🎯 Ritmo del mes: metas vs realidad (SQL 0108 business_goals) ----------
     Pesos del pipeline ponderado = dealProb() — la MISMA función que usan el KPI
     "Ponderado" y el board. "Propuesta enviada" ya no es fija: baja con los días sin
     respuesta. Inventar otros acá haría que el panel contradiga al resto de la pantalla.
     La edge function daily-digest replica esa curva (probDeal, con comentario). */
  let rmGoal = null, rmGoalFetched = false, rmGoalBusy = false;
  async function rmFetchGoal(){
    if (rmGoalBusy || rmGoalFetched) return;
    rmGoalBusy = true;
    try {
      const { data, error } = await supabase.from('business_goals').select('monthly_target').eq('id', 1).maybeSingle();
      if (!error){ rmGoal = data ? +data.monthly_target || 0 : 0; rmGoalFetched = true; rmRender(); }
    } catch (e) { /* tabla pendiente (SQL 0108 sin correr) → el panel muestra el aviso de definir objetivo */ }
    finally { rmGoalBusy = false; }
  }
  function rmRender(){
    if (!$('rm-panel')) return;
    const now = new Date(), D = 864e5;
    $('rm-month').textContent = '(' + now.toLocaleDateString('es-CH', { month: 'long', year: 'numeric' }) + ')';
    const m0 = new Date(now.getFullYear(), now.getMonth(), 1).getTime();
    const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
    const dayOfMonth = now.getDate();
    const all = (dealsList || []).filter((d) => !d.archived);
    // cerrado este mes: ganados con won_at (fallback last_stage_at) dentro del mes en curso
    const wonMonth = all.filter((d) => stageOf(d.stage) === 'ganado' && Date.parse(d.won_at || d.last_stage_at || '') >= m0);
    const closed = dealsValue(wonMonth);
    /* Contra el MES ANTERIOR completo, no contra "los 30 días de antes": Sebastián
       cobra del 1 al último día, así que la comparación tiene que ser mes contra mes.
       A esta altura del mes se compara contra el mes entero, que es lo que hay que
       igualar — por eso el texto dice "cerró" y no "vamos igual". */
    const mPrev0 = new Date(now.getFullYear(), now.getMonth() - 1, 1).getTime();
    const wonPrev = all.filter((d) => { const t = Date.parse(d.won_at || d.last_stage_at || '');
      return stageOf(d.stage) === 'ganado' && t >= mPrev0 && t < m0; });
    const closedPrev = dealsValue(wonPrev);
    const nomPrev = new Date(now.getFullYear(), now.getMonth() - 1, 1).toLocaleDateString('es-CH', { month: 'long' });
    // ponderado: mismos pesos/valores que hmDealKpis (números idénticos en todo el dashboard)
    const open = all.filter((d) => DL_OPEN.includes(stageOf(d.stage)));
    const weighted = dealsWeighted(open);
    const proj = closed + weighted;
    const goal = +rmGoal || 0;
    $('rm-closed').textContent = closed ? fmtChf(closed) : 'CHF 0';
    const cuantos = wonMonth.length ? wonMonth.length + (wonMonth.length === 1 ? ' deal ganado' : ' deals ganados') : 'sin cierres todavía';
    // el mes anterior al lado: sin comparación, un "CHF 0" no dice si es raro o normal
    const cmp = closedPrev
      ? ' · ' + nomPrev + ' cerró ' + fmtChf(closedPrev)
      : ' · ' + nomPrev + ' tampoco tuvo cierres';
    $('rm-closed-t').textContent = cuantos + cmp;
    $('rm-weighted').textContent = fmtChf(Math.round(weighted));
    /* rm-proj y rm-gap ya NO existen como tarjetas: la proyección y el gap se dicen
       en el titular. Se dejan las escrituras protegidas por si alguien vuelve a
       ponerlas — escribir sobre un id que no está tira el render entero. */
    const projEl = $('rm-proj'); if (projEl) projEl.textContent = fmtChf(Math.round(proj));
    $('rm-goal-val').textContent = goal ? fmtChf(goal) : (rmGoalFetched ? 'sin definir' : '–');
    const nada = { textContent: '', style: {} };   // sustituto inofensivo para los ids que ya no están
    const gapEl = $('rm-gap') || nada, gapT = $('rm-gap-t') || nada;
    const bar = $('rm-bar'), cap = $('rm-bar-cap'), act = $('rm-action');
    // "Afuera, esperando": mismo criterio que el KPI de abajo (ofertas + propuestas enviadas)
    const offSentR = (offersList || []).filter((o) => !o.archived && !o.is_template && o.status === 'sent' && !esDePrueba(o));
    const propSentR = (ppList || []).filter((p) => !p.archived && !p.is_template && p.status === 'sent' && !esDePrueba(p));
    const sentN = offSentR.length + propSentR.length;
    const sentV = offSentR.reduce((a, o) => a + offerNet(o), 0) + propSentR.reduce((a, p) => a + propVal(p), 0);
    if ($('rm-sent')){
      $('rm-sent').textContent = sentN ? fmtChf(Math.round(sentV)) : 'CHF 0';
      $('rm-sent-t').textContent = sentN ? sentN + (sentN === 1 ? ' enviada' : ' enviadas') + ', entre ofertas y propuestas' : 'nada esperando respuesta';
    }
    if (!goal){
      gapEl.textContent = '–'; gapEl.style.color = ''; gapT.textContent = 'definí el objetivo →';
      bar.hidden = true; cap.textContent = '';
      act.hidden = false; act.className = 'rm-action warn';
      act.textContent = rmGoalFetched ? 'Definí el objetivo mensual (✎ arriba) para ver el gap y el ritmo del mes.' : 'Cargando objetivo…';
      return;
    }
    /* ===== LO QUE FALTA ES OBJETIVO − CERRADO, y nada más =====
       Acá se calculaba objetivo − (cerrado + ponderado). Con CHF 0 cerrados y un
       ponderado de CHF 23'594, el titular decía "faltan CHF 26'406" — como si dos
       tercios del mes ya estuvieran resueltos. No lo están: el ponderado es una
       probabilidad, no plata. Sebastián, 25 ago: "faltan los 50K ya que nada está
       ganado, ponderado no es lo mismo". Tiene razón, y la confusión es peligrosa
       justo acá: es el número que decide si hay que salir a buscar trabajo.
       Ahora FALTA = objetivo − cerrado. La proyección sigue existiendo, pero dicha
       aparte y con su nombre. */
    const falta = Math.max(0, goal - closed);
    const gap = -falta;   // negativo mientras falte algo (el resto del bloque lo usa así)
    const gapAbs = Math.abs(Math.round(gap));
    gapEl.textContent = (gap >= 0 ? '+' : '−') + (gapAbs ? fmtChf(gapAbs) : 'CHF 0');
    gapEl.style.color = gap >= 0 ? '#7ed957' : '#ff8b8b';
    gapT.textContent = gap >= 0 ? 'proyección cubre el objetivo' : 'falta para el objetivo';
    // barra: cerrado vs objetivo, con marcador de "dónde deberías estar hoy" (día/días del mes)
    const pctClosed = Math.min(100, closed / goal * 100);
    const pctToday = Math.min(100, dayOfMonth / daysInMonth * 100);
    bar.hidden = false;
    const fill = $('rm-fill');
    fill.style.width = pctClosed.toFixed(1) + '%';
    fill.className = 'rm-fill' + (pctClosed + 0.5 < pctToday ? ' behind' : '');
    const mk = $('rm-marker');
    mk.style.left = pctToday.toFixed(1) + '%';
    mk.title = 'Hoy deberías estar en ' + fmtChf(Math.round(goal * dayOfMonth / daysInMonth)) + ' (' + Math.round(pctToday) + '% del mes)';
    cap.textContent = 'Cerrado ' + (closed ? fmtChf(closed) : 'CHF 0') + ' de ' + fmtChf(goal) + ' (' + Math.round(pctClosed) + '%) · día ' + dayOfMonth + ' de ' + daysInMonth + ' (' + Math.round(pctToday) + '% del mes)';
    // línea de acción: "faltan ~N leads" con conversión histórica REAL (leads→ganados 90 días)
    act.hidden = false;
    if (falta === 0){
      /* Cerrado de verdad, no proyectado: acá el verde está ganado. */
      act.className = 'rm-titular ok';
      act.innerHTML = 'Objetivo cumplido: cerraste <span class="bien">' + fmtChf(Math.round(closed)) + '</span> de ' + fmtChf(goal) + '.' +
        '<small>' + (closed > goal ? fmtChf(Math.round(closed - goal)) + ' arriba. ' : '') +
        'Lo que entre de acá en más es de más.</small>';
      return;
    }
    const t90 = Date.now() - 90 * D;
    /* Los 168 contactos importados de bexio NO son leads: entraron de la
       contabilidad, no pidieron nada. Metidos en el denominador daban una
       conversión de 6/192 = 3% y la pantalla pedía 183 leads este mes; sin
       ellos son 6 de ~24 y la cuenta se parece a la realidad.
       Decisión de Sebastián, 14 ago 2026: "no, los de bexio no pueden contar,
       si no no hace sentido". Se reusa esCartera(), el mismo criterio que ya
       usa el panel de Conversión real — un solo lugar que define qué es cartera
       vieja y qué es un lead de verdad. */
    const leads90 = (allLeads || []).filter((l) => !/^claude-/.test(l.session_id || '') && !/spam/i.test(l.status || '')
      && !esCartera(l) && Date.parse(l.created_at || '') >= t90);
    const won90 = all.filter((d) => stageOf(d.stage) === 'ganado' && Date.parse(d.won_at || d.last_stage_at || '') >= t90);
    const lead90Ids = new Set(leads90.map((l) => String(l.id)));
    const wonFromLeads90 = won90.filter((d) => lead90Ids.has(String(d.lead_id))).length;
    const avgWon = won90.length ? dealsValue(won90) / won90.length : 0;
    /* Antes que "conseguí N leads nuevos" está lo que YA está afuera esperando
       respuesta: si las propuestas enviadas cubren el gap, el mes se cierra
       cobrando eso, no saliendo a buscar gente. Con los números de hoy: faltan
       CHF 21'220 y hay CHF 39'557 en 4 propuestas — decir "necesitás 137 leads"
       en vez de eso es empujar al lado equivocado. */
    /* ===== UN SOLO "AFUERA, ESPERANDO" =====
       El titular contaba SOLO propuestas y el KPI de abajo propuestas + ofertas, así que
       la misma tarjeta decía "CHF 55'606 en 6" arriba y "CHF 61'642 · 7 enviadas" abajo.
       (Sebastián, 26 ago 2026: "los números no matchean".) Dos números distintos para lo
       mismo, a diez centímetros uno del otro, hacen dudar de los dos.
       Ahora los dos salen del MISMO conjunto —offSentR + propSentR, definidos arriba—,
       porque una oferta enviada está tan afuera esperando como una propuesta. */
    const enviadas = [
      ...offSentR.map((o) => ({ v: offerNet(o) })),
      ...propSentR.map((p) => ({ v: propVal(p) })),
    ];
    const valEnviadas = enviadas.reduce((a, x) => a + x.v, 0);
    if (enviadas.length && valEnviadas >= falta){
      const ord = enviadas.map((x) => x.v).sort((a, b) => b - a);
      let acum = 0, cuantas = 0;
      for (const v of ord){ acum += v; cuantas++; if (acum >= falta) break; }
      /* Titular: el número que duele en naranja, lo que puede salvarlo en verde, y
         el "qué hago" abajo en chico. Antes era todo un renglón de texto plano al
         final del bloque — cierto pero invisible. */
      act.className = 'rm-titular bad';
      const quedanD = daysInMonth - dayOfMonth;
      act.innerHTML = 'Faltan <span class="mal">' + fmtChf(Math.round(falta)) + '</span> para el objetivo del mes, ' +
        'y tenés <span class="bien">' + fmtChf(Math.round(valEnviadas)) + '</span> afuera en ' + enviadas.length +
        (enviadas.length === 1 ? ' oferta o propuesta.' : ' ofertas y propuestas.') +
        '<small>Con que ' + (cuantas === 1 ? 'entre la más grande' : 'entren las ' + cuantas + ' más grandes') +
        ', el mes está hecho' + (quedanD > 0 ? ' — quedan ' + quedanD + (quedanD === 1 ? ' día' : ' días') : '') + '. ' +
        'Según la etapa de cada una, lo probable es que entren ' + fmtChf(Math.round(weighted)) + ' — eso es una estimación, no plata cerrada.</small>';
      return;
    }
    // historia suficiente = al menos 10 leads y 2 cierres en 90 días; si no, no inventamos una tasa
    if (leads90.length >= 10 && won90.length >= 2 && wonFromLeads90 >= 1 && avgWon > 0){
      const conv = wonFromLeads90 / leads90.length;
      const needLeads = Math.ceil(falta / (avgWon * conv));
      act.className = 'rm-action bad';
      act.className = 'rm-titular bad';
      act.innerHTML = 'Faltan <span class="mal">' + fmtChf(Math.round(falta)) + '</span> para el objetivo del mes.<small>≈ ' + needLeads + (needLeads === 1 ? ' lead más' : ' leads más') + ' este mes (conversión 90 d: ' + wonFromLeads90 + '/' + leads90.length + ' leads ganados · ticket medio ' + fmtChf(Math.round(avgWon)) + ').';
    } else {
      act.className = 'rm-titular bad';
      act.innerHTML = 'Faltan <span class="mal">' + fmtChf(Math.round(falta)) + '</span> para el objetivo del mes.<small>Poca historia de conversión (90 d) para estimar cuántos leads equivalen — el número saldrá solo cuando haya más cierres.</small>';
    }
  }
  // objetivo editable inline: ✎ → input CHF → upsert business_goals id=1
  $('rm-goal-edit').addEventListener('click', () => {
    $('rm-goal-view').hidden = true; $('rm-goal-form').hidden = false;
    const inp = $('rm-goal-inp'); inp.value = rmGoal || ''; inp.focus();
  });
  $('rm-goal-cancel').addEventListener('click', () => { $('rm-goal-form').hidden = true; $('rm-goal-view').hidden = false; });
  $('rm-goal-save').addEventListener('click', async () => {
    const v = Math.max(0, Math.round(+$('rm-goal-inp').value || 0));
    const btn = $('rm-goal-save'); btn.disabled = true;
    try {
      const { error } = await supabase.from('business_goals').upsert({ id: 1, monthly_target: v, updated_at: new Date().toISOString() });
      if (error) throw error;
      rmGoal = v; rmGoalFetched = true;
      $('rm-goal-form').hidden = true; $('rm-goal-view').hidden = false;
      toast('🎯 Objetivo mensual guardado: ' + (v ? fmtChf(v) : 'sin objetivo'));
