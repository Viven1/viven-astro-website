<script is:inline define:vars={{ stillsPool, newsVideos, newsCases, blogVideos }}>window.STILLS_POOL = stillsPool; window.NEWS_VIDEOS = newsVideos; window.NEWS_CASES = newsCases; window.BLOG_VIDEOS = blogVideos;</script>
<script>
  import { createClient } from '@supabase/supabase-js';

  /* misma URL + publishable key que usa el sitio (públicas por diseño);
     los datos solo se pueden LEER tras login gracias a las policies RLS */
  const supabase = createClient(
    'https://lumoevaotokgqnpybkyf.supabase.co',
    'sb_publishable_ORGL5_FNZTXcGKwvjs-ymw_Y8DV_4ca'
  );

  // Puente para la app iOS nativa (WKWebView wrapper): Swift tiene el device
  // token de APNs pero no la sesión de Supabase (vive en localStorage, del
  // lado JS) — así que Swift llama esta función vía evaluateJavaScript() con
  // el token, y acá SÍ tenemos el JWT del usuario logueado para registrarlo.
  // No-op fuera de la app nativa (nadie más la llama).
  window.__vivenRegisterDeviceToken = function (token) {
    if (!token) return;
    supabase.functions.invoke('register-device-token', { body: { device_token: token, platform: 'ios' } })
      .then(({ error }) => {
        if (error) return;
        /* Dentro de la app del iPhone los avisos llegan por APNs, no por Web Push:
           WKWebView no tiene Push API, así que el chequeo de siempre daba "no
           soportado" y el header mostraba 🔕 Sin avisos AUNQUE el teléfono
           estuviera perfectamente registrado. Sebastián lo vio así el 14 ago y
           preguntó si era normal: no lo era, era el cartel midiendo lo que no
           corresponde en ese contexto. */
        window.__apnsOk = true;
        const w = document.getElementById('push-warn'); if (w) w.hidden = true;
        const b = document.getElementById('bell-push'); if (b) b.textContent = '📲 Avisos por la app ✓';
      })
      .catch(() => {});
  };


  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fmtTime = (secs) => {
    if (!secs || secs <= 0) return '—';
    const m = Math.floor(secs / 60), s = Math.round(secs % 60);
    return m ? m + 'm ' + (s < 10 ? '0' : '') + s + 's' : s + 's';
  };
  const STATUSES = ['new', 'nuevo', 'contacted', 'contactado', 'qualified', 'won', 'cerrado', 'lost', 'perdido'];
  const THANKS = /^\/(thank-you|danke|gracias)\/?$/;
  let allLeads = [], statusFilter = 'all', searchTerm = '', channelFilter = null, landingFilter = null, insightsData = null, lastViews = [], leadsView = 'board', coMeta = {}, coCur = null, coBound = false, meEmail = '';
  // última actividad por lead (notas/tasks/propuestas/web) — se llena en loadAll
  let actNotes = {}, actTasks = {}, actProps = {}, actWeb = {};

  /* ---- helpers globales de avatar (mismo esquema que la tabla de Personas) ---- */
  const AV_COLORS_G = ['#8ab4ff', '#c58af9', '#7ed957', '#f0c060', '#ff8b5e', '#5ec7d1', '#e08ac5'];
  const avColorG = (n) => { let h = 0; const x = String(n || '?'); for (let i = 0; i < x.length; i++) h = (h * 31 + x.charCodeAt(i)) >>> 0; return AV_COLORS_G[h % AV_COLORS_G.length]; };

  /* ---- 👤 Mi perfil (SQL 0064 team_profiles) — cache client-side, keyed por email en minúscula.
     Fuente de verdad progresiva: si hay fila, pisa a los mapas hardcodeados SENDERS/TEAM. ---- */
  let teamProfiles = {};
  async function loadTeamProfiles(){
    try {
      const { data, error } = await supabase.from('team_profiles').select('*');
      if (!error && data){
        teamProfiles = Object.fromEntries(data.map((p) => [String(p.email || '').toLowerCase(), p]));
        // la tabla manda; si viene vacía nos quedamos con los tres de siempre para
        // no dejar los selectores de responsable sin nadie
        const dela = data.filter((p) => p.email).map((p) => ({ email: String(p.email).toLowerCase(), name: p.name || p.email }));
        if (dela.length){
          const vistos = new Set(dela.map((t) => t.email));
          TEAM = dela.concat(TEAM_FALLBACK.filter((t) => !vistos.has(t.email)));
        }
      }
    } catch (e) { /* tabla pendiente (SQL 0064) — sigue con el fallback */ }
  }
  const profileFor = (email) => teamProfiles[String(email || '').toLowerCase()] || null;
  // mini-avatar: foto de team_profiles si hay, si no círculo con inicial (mismo patrón que Personas)
  function teamAvatarHtml(email, fallbackName){
    const p = profileFor(email);
    const nm = (p && p.name) || fallbackName || email || '?';
    const ini = esc((nm[0] || '?').toUpperCase());
    if (p && p.avatar_url) return '<img class="lt-av" src="' + esc(p.avatar_url) + '" alt="" style="object-fit:cover" />';
    return '<span class="lt-av" style="background:' + avColorG(nm) + '">' + ini + '</span>';
  }

  function show(view){
    $('login-view').hidden = view !== 'login';
    $('dash-view').hidden = view !== 'dash';
  }

  /* ---------- Navegación (sidebar) ---------- */
  // 'seo' y 'gads' ya no son tabs propios: viven como sub-tabs dentro de Analytics
  // fix (2026-07-14, reestructuración del shell — mockup bb59ab6d): de 17 tabs planos a
  // 8 destinos agrupados por intención; blog/news/magnets/seo viven dentro de 'contenido';
  // services/licenses/booking/ab/auto/tmpl/cashflow/profile viven dentro de 'sistema'.
  // fix (2026-07-15, pedido explícito: "me gustaba mas entrar y ver todo lo que paso y lo
  // que toca hacer, llamalo Hoy"): 'hoy' es ahora la portada por defecto (KPIs + Para hoy +
  // Señales + IA), separada de 'deals'/Pipeline que vuelve a ser un board puro. 'home' es
  // alias viejo de deep links → redirige a 'hoy'. Ver contenidoSetSub/sistemaSetSub más
  // abajo (mismo patrón que anaSetSub, ya probado con Analytics).
  const TABS = ['hoy', 'deals', 'leads', 'companies', 'agenda', 'offers', 'analytics', 'contenido', 'sistema'];
  // recarga Personas fresco desde la base — se llama al cambiar de tab, así un
  // contacto creado en OTRA sesión (vos, Sofia) aparece siempre en todos los
  // selects de "ligar a un contacto" (Ofertas, Propuestas, Licencias, Workflows,
  // Nurture…), no solo en el que ya tenías cargado en memoria al abrir el dashboard.
  async function refreshLeadsList(){
    try {
      // sin .limit(2000): ese techo dejaba contactos afuera en silencio (ver fetchAllRowsFull)
      const { data, error } = await fetchAllRowsFull('leads', '*', 'created_at');
      if (!error && data) allLeads = data;
    } catch (e) { /* si falla, seguimos con lo que ya había en memoria */ }
  }
  async function gotoTab(tab){
    // alias para deep links / botones viejos que apuntaban a tabs que ahora son
    // sub-tabs de 'contenido'/'sistema', o que se fusionaron en otro destino.
    if (tab === 'gads'){ anaSetSub('gads'); tab = 'analytics'; }
    if (tab === 'props') tab = 'offers';
    if (tab === 'home') tab = 'hoy';
    if (['blog', 'news', 'seo', 'magnets'].includes(tab)){ contenidoSetSub(tab); tab = 'contenido'; }
    if (['services', 'licenses', 'booking', 'ab', 'auto', 'tmpl', 'cashflow', 'crons', 'usuarios', 'profile'].includes(tab)){ sistemaSetSub(tab); tab = 'sistema'; }
    document.querySelectorAll('.side-item').forEach((x) => x.classList.toggle('active', x.dataset.tab === tab));
    // barra inferior móvil: marcar activo ("Más" queda activo si el tab está en la hoja)
    const SHEET_TABS = ['deals', 'companies', 'analytics', 'contenido', 'sistema'];
    document.querySelectorAll('.mob-nav [data-tab], .mob-sheet [data-tab]').forEach((b) => b.classList.toggle('active', b.dataset.tab === tab));
    const more = $('mob-more'); if (more) more.classList.toggle('active', SHEET_TABS.includes(tab));
    const sheet = $('mob-sheet'); if (sheet) sheet.hidden = true;
    TABS.forEach((k) => { const el = $('tab-' + k); if (el) el.hidden = k !== tab; });
    window.scrollTo(0, 0);
    await refreshLeadsList();
    // la analítica se trae en segunda fase: si entrás a un tab que la usa y todavía
    // no llegó, se pide acá (ver loadAnalytics)
    if (['hoy', 'analytics', 'leads'].includes(tab)) loadAnalytics();
    if (tab === 'hoy') renderHome(); // KPIs + Para hoy/Señales/Agenda-mini/IA viven en Hoy (portada)
    if (tab === 'agenda'){ hmRenderAgenda(); hmRenderCalls(); }
    if (tab === 'companies') renderCompanies();
    if (tab === 'offers') { offersInit(); proposalsInit(); }
    if (tab === 'analytics') anaSetSub(anaSub); // re-aplica el sub-tab guardado y dispara su carga
    if (tab === 'contenido') contenidoSetSub(contenidoSub);
    if (tab === 'sistema') sistemaSetSub(sistemaSub);
    syncTabUrl();
  }
  // refleja tab (+ sub-tab si aplica) en la URL, SIN sumar entradas al historial
  // (replaceState, no pushState — así el botón "atrás" no navega tab por tab).
  // Pedido explícito: "poder tener varias ventanas a la vez abiertas del dashboard,
  // que cambie la url segun el lugar, asi tmb cuando hago refresh me mantengo" —
  // cada ventana/pestaña del navegador tiene su propia URL, así que F5 en CUALQUIERA
  // de ellas te deja donde estabas, y podés abrir varias en paralelo cada una en
  // un lugar distinto (sub-tab vive en localStorage, compartido entre pestañas del
  // mismo navegador — sigue siendo "la última que elegiste en cualquiera de ellas",
  // igual que ya pasaba antes de esto).
  function syncTabUrl(){
    const tab = TABS.find((k) => { const el = $('tab-' + k); return el && !el.hidden; });
    if (!tab) return;
    const sub = tab === 'analytics' ? anaSub : tab === 'contenido' ? contenidoSub : tab === 'sistema' ? sistemaSub : '';
    const qs = '?tab=' + tab + (sub ? '&sub=' + sub : '');
    try { history.replaceState(null, '', location.pathname + qs); } catch (e) {}
  }

  /* ---------- Analytics: sub-tabs (Web / Google Ads / Videos) ---------- */
  // estado en módulo + localStorage: sobrevive al auto-refresh y a recargar la página
  let anaSub = localStorage.getItem('vv_ana_sub') || 'web';
  if (!['web', 'gads', 'videos', 'cro'].includes(anaSub)) anaSub = 'web';
  function anaSetSub(sub){
    anaSub = sub;
    try { localStorage.setItem('vv_ana_sub', sub); } catch (e) { /* modo privado */ }
    ['web', 'gads', 'videos', 'cro'].forEach((k) => { const el = $('ana-sub-' + k); if (el) el.hidden = k !== sub; });
    document.querySelectorAll('#ana-seg button').forEach((b) => b.classList.toggle('on', b.dataset.sub === sub));
    // carga perezosa (Web y Videos ya se renderizan en loadAll)
    if (sub === 'gads' && typeof window.gadsLoad === 'function') window.gadsLoad();
    if (sub === 'cro') croLoad(); // 🧪 CRO: carga 1 vez, después usa lo que hay en memoria
    rcLoad(); // 🧭 Recorridos: cierra el tab sea cual sea el sub — carga 1 vez por período
    syncTabUrl();
  }
  document.querySelectorAll('#ana-seg button').forEach((b) => b.addEventListener('click', () => anaSetSub(b.dataset.sub)));

  /* ---------- 🧭 Recorridos: funnels first-party + páginas de entrada + fricción ----------
     Datos de funnel_events / ux_signals (SQL 0106) vía RPCs security definer —
     el dashboard nunca baja filas crudas. Período propio 7/28 días, independiente
     del selector global (los funnels miran conversión reciente, no un día puntual). */
  let rcDays = 28, rcLoadedFor = 0;
  const RC_FUNNELS = [
    { id: 'landing', name: '🎯 Landings de Ads (film-production)' },
    { id: 'calc', name: '🧮 Calculadora de costos' },
    { id: 'brief', name: '📋 Brief de proyecto' },
    { id: 'magnet', name: '🧲 Lead magnet' }
  ];
  // labels amigables por funnel (fallback: label crudo del evento)
  const RC_LABELS = {
    calc: { view: 'Vio la calculadora', type: 'Eligió tipo', dur: 'Duración', days: 'Días de rodaje', locs: 'Locaciones', talent: 'Quién sale en cámara', chan: 'Dónde corre', lic: 'Licencia (buyout)', extras: 'Extras', email_submitted: 'Dejó su email' },
    brief: { view: 'Abrió el brief', goal: 'Objetivo', audience: 'Audiencia', distribution: 'Distribución', quantity: 'Cantidad', formats: 'Formatos', languages: 'Idiomas', oncamera: 'Quién sale en cámara', locations: 'Locaciones', timeline: 'Timing', budget: 'Presupuesto', action: 'Acción deseada', feeling: 'Emoción', destination: 'Destino', submitted: 'Envió el brief' },
    magnet: { view: 'Vio el gate', email_submitted: 'Dejó su email' },
    landing: { view: 'Llegó a la landing', scroll50: 'Scrolleó la mitad', form_view: 'Vio el formulario', form_submit: 'Envió el formulario' }
  };
  const RC_KINDS = { rage: '😡 Rage', dead: '💀 Dead', jserror: '🐞 Error JS' };
  function rcRenderFunnel(f, res){
    let inner;
    if (res && res.error) inner = '<p class="rc-note">No se pudo cargar (' + esc(res.error.message || 'error') + ') — ¿ya corriste el SQL 0106?</p>';
    else if (!res || !res.data || !res.data.length) inner = '<p class="rc-note">sin datos todavía — el tracking arranca hoy</p>';
    else {
      const rows = res.data;
      const base = Number(rows[0].sessions) || 1;
      let prev = null;
      inner = rows.map((r) => {
        const n = Number(r.sessions) || 0;
        const w = Math.max(2, Math.round((n / base) * 100));
        let drop = '<span class="rc-drop ok"></span>';
        if (prev !== null && prev > 0){
          const d = Math.round((1 - n / prev) * 100);
          drop = d > 0 ? '<span class="rc-drop">−' + d + '%</span>' : '<span class="rc-drop ok">' + (d < 0 ? '+' + -d + '%' : '=') + '</span>';
        }
        prev = n;
        const lbl = (RC_LABELS[f.id] && RC_LABELS[f.id][r.label]) || r.label || ('Paso ' + r.step);
        return '<div class="rc-row"><div class="rc-lbl" title="' + esc(r.label || '') + '">' + esc(lbl) + '</div>' +
          '<div class="rc-track"><i style="width:' + w + '%"></i><b>' + n + '</b></div>' + drop + '</div>';
      }).join('');
    }
    return '<div class="rc-funnel"><h3>' + f.name + '</h3>' + inner + '</div>';
  }
  /* ---------- 🗺️ Flujo de visitas: Sankey 3 columnas sobre pageviews (SQL 0107) ----------
     rpc_path_flows devuelve (step1, step2, step3, sessions) ya deduplicado y
     agregado server-side (top 60). Acá solo se agrupa en top-6 + "otras" +
     "(salida)" por columna y se dibuja el SVG a mano — cero librerías.
     Click en un nodo de entrada = filtro client-side (mismos datos, re-render). */
  let rcFlowRows = null, rcFlowFilter = null;
  const RC_EXIT = '(salida)', RC_OTHER = '(otras)';
  function rcFlowLabel(p){
    if (p === RC_EXIT) return { lang: '', text: 'salida', full: 'la sesión termina acá' };
    if (p === RC_OTHER) return { lang: '', text: 'otras', full: 'otras páginas (fuera del top 6)' };
    let lang = '', rest = p || '/';
    const m = /^\/(en|de|es)(\/.*)?$/.exec(rest);
    if (m){ lang = m[1].toUpperCase(); rest = m[2] || '/'; }
    return { lang, text: rest.length > 28 ? rest.slice(0, 27) + '…' : rest, full: p };
  }
  // top 6 paths por volumen + "otras" (agregado) + "(salida)" al final
  function rcFlowNodes(counts, withExit){
    const real = [...counts].filter((e) => e[0] !== RC_EXIT).sort((a, b) => b[1] - a[1]);
    const nodes = real.slice(0, 6).map((e) => ({ key: e[0], value: e[1] }));
    const rest = real.slice(6);
    if (rest.length) nodes.push({ key: RC_OTHER, value: rest.reduce((s, e) => s + e[1], 0), other: true });
    if (withExit && counts.get(RC_EXIT)) nodes.push({ key: RC_EXIT, value: counts.get(RC_EXIT), exit: true });
    const idx = new Map(nodes.map((n, i) => [n.key, i]));
    rest.forEach((e) => idx.set(e[0], idx.get(RC_OTHER))); // paths chicos → nodo "otras"
    return { nodes, idx };
  }
  function rcFlowRender(){
    const box = $('rc-flow'); if (!box) return;
    const rst = $('rc-flow-reset'); if (rst) rst.hidden = !rcFlowFilter;
    const rows = (rcFlowRows || []).filter((r) => !rcFlowFilter || r.step1 === rcFlowFilter);
    if (!rows.length){ box.innerHTML = '<p class="muted-note">Sin recorridos en el período todavía.</p>'; return; }
    // 1) volumen por path en cada columna (col 3 solo si la sesión llegó a una 2ª página)
    const c1 = new Map(), c2 = new Map(), c3 = new Map();
    rows.forEach((r) => {
      const n = Number(r.sessions) || 0;
      c1.set(r.step1, (c1.get(r.step1) || 0) + n);
      c2.set(r.step2, (c2.get(r.step2) || 0) + n);
      if (r.step2 !== RC_EXIT) c3.set(r.step3, (c3.get(r.step3) || 0) + n);
    });
    const cols = [rcFlowNodes(c1, false), rcFlowNodes(c2, true), rcFlowNodes(c3, true)];
    // 2) cintas agregadas nodo→nodo (índices dentro de cada columna)
    const agg = (m, a, b, n) => { const k = a + '|' + b; m.set(k, (m.get(k) || 0) + n); };
    const l12 = new Map(), l23 = new Map();
    rows.forEach((r) => {
      const n = Number(r.sessions) || 0;
      agg(l12, cols[0].idx.get(r.step1), cols[1].idx.get(r.step2), n);
      if (r.step2 !== RC_EXIT) agg(l23, cols[1].idx.get(r.step2), cols[2].idx.get(r.step3), n);
    });
    // 3) geometría: viewBox fija 960×420, escala común = la columna más "apretada"
    const W = 960, H = 420, TOP = 34, BOT = 412, GAP = 8, NW = 12, MINH = 5;
    const colX = [8, (W - NW) / 2, W - NW - 8];
    let scale = Infinity;
    cols.forEach((c) => {
      const tot = c.nodes.reduce((s, n) => s + n.value, 0);
      if (tot > 0) scale = Math.min(scale, (BOT - TOP - GAP * (c.nodes.length - 1)) / tot);
    });
    if (!isFinite(scale)) scale = 1;
    cols.forEach((c) => {
      let y = TOP;
      c.nodes.forEach((n) => { n.h = Math.max(MINH, n.value * scale); n.y = y; y += n.h + GAP; n.so = 0; n.to = 0; });
    });
    // 4) SVG: cintas primero (quedan debajo), nodos + labels encima
    const parts = ['<svg viewBox="0 0 ' + W + ' ' + H + '" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Flujo de visitas: entrada, segunda y tercera página">'];
    parts.push('<text class="rc-flow-col" x="' + colX[0] + '" y="16">Entrada</text>' +
      '<text class="rc-flow-col" x="' + (W / 2) + '" y="16" text-anchor="middle">2ª página</text>' +
      '<text class="rc-flow-col" x="' + (colX[2] + NW) + '" y="16" text-anchor="end">3ª página</text>');
    const ribbon = (links, a, b, x1, x2) => {
      // orden estable arriba→abajo para que las cintas no se crucen de más
      [...links].map(([k, v]) => { const p = k.split('|'); return { s: +p[0], t: +p[1], v }; })
        .sort((p, q) => (p.s - q.s) || (p.t - q.t))
        .forEach((l) => {
          const S = a.nodes[l.s], T = b.nodes[l.t], h = l.v * scale;
          const sy = S.y + S.so, ty = T.y + T.to; S.so += h; T.to += h;
          const mx = (x1 + x2) / 2, exit = b.nodes[l.t].exit;
          parts.push('<path class="rc-ribbon' + (exit ? ' rc-exit' : '') + '" d="M' + x1 + ' ' + sy.toFixed(1) +
            ' C' + mx + ' ' + sy.toFixed(1) + ' ' + mx + ' ' + ty.toFixed(1) + ' ' + x2 + ' ' + ty.toFixed(1) +
            ' L' + x2 + ' ' + (ty + h).toFixed(1) + ' C' + mx + ' ' + (ty + h).toFixed(1) + ' ' + mx + ' ' + (sy + h).toFixed(1) + ' ' + x1 + ' ' + (sy + h).toFixed(1) + ' Z">' +
            '<title>' + esc(S.key) + ' → ' + esc(T.key) + ': ' + l.v + ' sesiones</title></path>');
        });
    };
    ribbon(l12, cols[0], cols[1], colX[0] + NW, colX[1]);
    ribbon(l23, cols[1], cols[2], colX[1] + NW, colX[2]);
    cols.forEach((c, ci) => {
      c.nodes.forEach((n) => {
        const lb = rcFlowLabel(n.key);
        const click = ci === 0 && !n.other; // solo entradas reales filtran
        const cls = 'rc-flow-node' + (n.exit ? ' rc-exit' : '') + (n.other ? ' rc-other' : '') + (click ? ' rc-click' : '');
        const ty = (n.y + n.h / 2 + 3.5).toFixed(1);
        const right = ci < 2; // col 1 y 2: label a la derecha del nodo; col 3: a la izquierda
        const tx = right ? colX[ci] + NW + 6 : colX[ci] - 6;
        const lang = lb.lang ? '<tspan class="rc-flow-lang">' + lb.lang + ' </tspan>' : '';
        parts.push('<g class="' + cls + '"' + (click ? ' data-flow-src="' + esc(n.key) + '"' : '') + '>' +
          '<title>' + esc(lb.full) + ' — ' + n.value + ' sesiones' + (click ? ' (click para filtrar)' : '') + '</title>' +
          '<rect x="' + colX[ci] + '" y="' + n.y.toFixed(1) + '" width="' + NW + '" height="' + n.h.toFixed(1) + '" rx="4"/>' +
          '<text x="' + tx + '" y="' + ty + '"' + (right ? '' : ' text-anchor="end"') + '>' + lang + esc(lb.text) +
          ' <tspan class="rc-flow-n">· ' + n.value + '</tspan></text></g>');
      });
    });
    parts.push('</svg>');
    box.innerHTML = parts.join('');
    box.querySelectorAll('[data-flow-src]').forEach((g) => g.addEventListener('click', () => {
      rcFlowFilter = g.getAttribute('data-flow-src'); rcFlowRender();
    }));
  }
  async function rcFlowLoad(){
    const box = $('rc-flow'); if (!box) return;
    try {
      const { data, error } = await supabase.rpc('rpc_path_flows', { p_days: rcDays });
      if (error) throw error;
      rcFlowRows = data || []; rcFlowFilter = null; rcFlowRender();
    } catch (e) {
      const rst = $('rc-flow-reset'); if (rst) rst.hidden = true;
      box.innerHTML = '<p class="muted-note">No se pudo cargar (' + esc(e.message || 'error') + ') — ¿ya corriste el SQL 0107?</p>';
    }
  }
  (function(){ const rst = $('rc-flow-reset'); if (rst) rst.addEventListener('click', () => { rcFlowFilter = null; rcFlowRender(); }); })();

  async function rcLoad(force){
    const box = $('rc-funnels'); if (!box) return;
    if (!force && rcLoadedFor === rcDays) return; // ya cargado para este período
    rcLoadedFor = rcDays;
    rcFlowLoad(); // 🗺️ flujo de visitas — mismo período, en paralelo con los funnels
    // 1) funnels con drop-off (calc / brief / magnet) en paralelo
    const rs = await Promise.all(RC_FUNNELS.map((f) => Promise.resolve(supabase.rpc('rpc_funnel_steps', { p_funnel: f.id, p_days: rcDays })).catch((e) => ({ error: e }))));
    box.innerHTML = RC_FUNNELS.map((f, i) => rcRenderFunnel(f, rs[i])).join('');
    // 2) páginas de entrada (landing → rebote → profundidad)
    const eb = $('rc-entry');
    try {
      const { data, error } = await supabase.rpc('rpc_entry_pages', { p_days: rcDays });
      if (error) throw error;
      // las landings de ads (film-production.viven.ch) comparten tablas con el
      // sitio pero tienen paths propios — acá se etiquetan para diferenciarlas
      const LP_PATHS = new Set(['/', '/brand-video/', '/product-video-production/', '/employer-branding-video-production/', '/how-to-video-production/', '/video-production-agency/']);
      eb.innerHTML = (data && data.length)
        ? data.map((r) => {
            const s = Number(r.sessions) || 0, b = Number(r.bounces) || 0;
            const br = s ? Math.round((b / s) * 100) : 0;
            const lpTag = LP_PATHS.has(String(r.landing || '/')) ? ' <span style="border:1px solid color-mix(in srgb,var(--acid) 45%,transparent);color:var(--acid);border-radius:999px;font-size:9.5px;font-weight:700;letter-spacing:.05em;padding:1px 7px;vertical-align:1px">ADS LP</span>' : '';
            return '<tr><td>' + esc(r.landing || '/') + lpTag + '</td><td class="num">' + s + '</td>' +
              '<td class="num"' + (br >= 70 ? ' style="color:#ff8b8b;font-weight:700"' : '') + '>' + br + '%</td>' +
              '<td class="num">' + (r.avg_pages == null ? '–' : Number(r.avg_pages).toFixed(1)) + '</td></tr>';
          }).join('')
        : '<tr><td colspan="4"><p class="muted-note" style="margin:6px 0">Sin sesiones en el período.</p></td></tr>';
    } catch (e) {
      eb.innerHTML = '<tr><td colspan="4"><p class="muted-note" style="margin:6px 0">No se pudo cargar (' + esc(e.message || 'error') + ') — ¿ya corriste el SQL 0106?</p></td></tr>';
    }
    // 3) señales de fricción (rage / dead / jserror) — con resolución (SQL 0115):
    // ✓ Corregido oculta la señal salvo que REAPAREZCA después del fix;
    // 🤖 Claude la deja en cola 'requested' (Claude las levanta cada sesión).
    const ub = $('rc-ux');
    try {
      const [{ data, error }, { data: resols }] = await Promise.all([
        supabase.rpc('rpc_ux_signals', { p_days: rcDays }),
        supabase.from('ux_resolutions').select('kind,path,selector,status,created_at'),
      ]);
      if (error) throw error;
      const resByKey = new Map((resols || []).map((x) => [x.kind + '|' + (x.path || '') + '|' + (x.selector || ''), x]));
      let hiddenFixed = 0;
      const rows = (data || []).filter((r) => {
        const res = resByKey.get(r.kind + '|' + (r.path || '') + '|' + (r.selector || ''));
        if (res && res.status === 'fixed' && (!r.last_at || new Date(res.created_at) >= new Date(r.last_at))) { hiddenFixed++; return false; }
        r._res = res || null;
        return true;
      });
      ub.innerHTML = (rows.length
        ? rows.map((r, i) => {
            const res = r._res;
            const act = res && res.status === 'requested'
              ? '<span style="color:var(--acid);font-size:11px;font-weight:700;white-space:nowrap">🤖 en cola de Claude</span>'
              : '<button class="btn btn-ghost small" data-ux-fix="' + i + '" type="button" title="Marcar corregida — se oculta salvo que vuelva a ocurrir">✓ Corregido</button>' +
                '<button class="btn btn-ghost small" data-ux-req="' + i + '" type="button" title="Dejarla en la cola de Claude — la arregla en la próxima sesión">🤖 Claude</button>';
            const reap = res && res.status === 'fixed' ? ' <span title="Reapareció después de marcarla corregida" style="color:#ff8b8b;font-size:10.5px;font-weight:700">REAPARECIÓ</span>' : '';
            return '<tr><td class="rc-kind">' + (RC_KINDS[r.kind] || esc(r.kind)) + reap + '</td><td>' + esc(r.path || '') + '</td>' +
              '<td>' + esc(r.selector || '–') + '</td><td class="num">' + (Number(r.hits) || 0) + '</td><td class="num">' + (Number(r.sessions) || 0) + '</td>' +
              '<td style="white-space:nowrap;display:flex;gap:6px">' + act + '</td></tr>';
          }).join('')
        : '<tr><td colspan="6"><p class="muted-note" style="margin:6px 0">Sin señales' + (hiddenFixed ? ' pendientes (' + hiddenFixed + ' corregidas ocultas)' : ' — se empieza a registrar hoy') + '.</p></td></tr>')
        + (rows.length && hiddenFixed ? '<tr><td colspan="6"><p class="muted-note" style="margin:6px 0">' + hiddenFixed + ' señal(es) corregida(s) oculta(s) — reaparecen solas si vuelven a ocurrir.</p></td></tr>' : '');
      const uxMark = async (i, status) => {
        const r = rows[i]; if (!r) return;
        // fix: window.__vvMe no existe en ningún lado — created_by quedaba siempre null.
        // myEmail() es la identidad real (login de Supabase Auth, mismo helper que las notas).
        const { error: e2 } = await supabase.from('ux_resolutions').insert({ kind: r.kind, path: r.path || '', selector: r.selector || '', status, created_by: (typeof myEmail === 'function' ? myEmail() : null) });
        if (e2) { alert('No se pudo guardar: ' + (e2.message || 'error') + (String(e2.message || '').includes('ux_resolutions') ? ' — ¿ya corriste el SQL 0115?' : '')); return; }
        rcLoad(true);
      };
      ub.querySelectorAll('[data-ux-fix]').forEach((b) => b.addEventListener('click', () => uxMark(parseInt(b.dataset.uxFix, 10), 'fixed')));
      ub.querySelectorAll('[data-ux-req]').forEach((b) => b.addEventListener('click', () => uxMark(parseInt(b.dataset.uxReq, 10), 'requested')));
    } catch (e) {
      ub.innerHTML = '<tr><td colspan="6"><p class="muted-note" style="margin:6px 0">No se pudo cargar (' + esc(e.message || 'error') + ') — ¿ya corriste el SQL 0106/0115?</p></td></tr>';
    }
  }
  document.querySelectorAll('#rc-period button').forEach((b) => b.addEventListener('click', () => {
    rcDays = parseInt(b.dataset.days, 10) || 28;
    document.querySelectorAll('#rc-period button').forEach((x) => x.classList.toggle('on', x === b));
    rcLoad(true);
  }));

  /* ---------- 🧪 Motor de CRO semanal (tabla cro_ideas — SQL 0112 + función cro-ideas) ----------
     La fila más reciente es "la semana actual"; el dropdown deja mirar hasta 8 semanas
     atrás. Hecha/Descartar guardan un status DENTRO del jsonb ideas[i] (update simple,
     sin tabla extra); 🔄 invoca la función con {force:true} (la sesión alcanza de auth). */
  let croRows = [], croIdx = 0, croLoadedOnce = false;
  const CRO_TYPE = { ab_test: '🧪 A/B test', fix: '🔧 Fix', experiment: '🔬 Experimento' };
  const CRO_EFFORT = { S: 'Esfuerzo S', M: 'Esfuerzo M', L: 'Esfuerzo L' };
  function croImpactDots(n){
    n = Math.max(1, Math.min(5, Number(n) || 0));
    return '●'.repeat(n) + '○'.repeat(5 - n);
  }
  function croWeekLabel(ws){
    try { return 'Semana del ' + new Date(ws + 'T00:00:00').toLocaleDateString('es-CH', { day: '2-digit', month: 'short' }); }
    catch (e) { return 'Semana ' + ws; }
  }
  async function croLoad(force){
    const box = $('cro-list'); if (!box) return;
    if (croLoadedOnce && !force) return; // ya en memoria — el sub-tab solo re-muestra
    try {
      const { data, error } = await supabase.from('cro_ideas').select('id,week_start,ideas,created_at').order('week_start', { ascending: false }).limit(8);
      if (error) throw error;
      croRows = data || []; croIdx = 0; croLoadedOnce = true;
      const sel = $('cro-week');
      if (sel){
        sel.hidden = croRows.length < 2;
        sel.innerHTML = croRows.map((r, i) => '<option value="' + i + '">' + esc(croWeekLabel(r.week_start)) + (i === 0 ? ' (actual)' : '') + '</option>').join('');
        sel.value = '0';
      }
      croRender();
      croBackfillCola();
    } catch (e) {
      box.innerHTML = '<p class="muted-note">No se pudo cargar (' + esc(e.message || 'error') + ') — ¿ya corriste el SQL <b>0112</b>?</p>';
    }
  }
  function croRender(){
    const box = $('cro-list'); if (!box) return;
    const meta = $('cro-meta');
    const row = croRows[croIdx];
    if (!row){
      if (meta) meta.hidden = true;
      box.innerHTML = '<p class="muted-note">Todavía no hay ideas: el cron corre cada lunes a la mañana (SQL 0112), o generá la primera tanda ahora con el botón 🔄 de arriba.</p>';
      return;
    }
    const ideas = Array.isArray(row.ideas) ? row.ideas : [];
    if (meta){
      const open = ideas.filter((i) => !i.status).length;
      meta.textContent = croWeekLabel(row.week_start) + ' · ' + ideas.length + ' ideas (' + open + ' pendientes) · generadas el ' + new Date(row.created_at).toLocaleDateString('es-CH', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
      meta.hidden = false;
    }
    box.innerHTML = ideas.length ? ideas.map((idea, i) => {
      const st = idea.status || '';
      const cls = st === 'done' ? ' cro-done' : st === 'dismissed' ? ' cro-dismissed' : st === 'approved' ? ' cro-approved' : '';
      return '<div class="cro-card' + cls + '">' +
        '<div class="cro-head">' +
          '<span class="cro-badge ' + esc(idea.type || '') + '">' + (CRO_TYPE[idea.type] || esc(idea.type || 'idea')) + '</span>' +
          '<span class="cro-badge">' + esc(CRO_EFFORT[idea.effort] || idea.effort || '?') + '</span>' +
          (idea.where ? '<span class="cro-where" title="' + esc(idea.where) + '">📍 ' + esc(idea.where) + '</span>' : '') +
          '<span class="cro-impact" title="Impacto estimado ' + (Number(idea.impact) || 0) + '/5">' + croImpactDots(idea.impact) + '</span>' +
        '</div>' +
        '<div class="cro-title">' + (st === 'done' ? '✅ ' : st === 'approved' ? '🤖 ' : '') + esc(idea.title || '') + '</div>' +
        (idea.hypothesis ? '<p class="cro-hypo"><b>Por qué:</b> ' + esc(idea.hypothesis) + '</p>' : '') +
        (idea.evidence ? '<p class="cro-evidence"><b>📊 El dato:</b> ' + esc(idea.evidence) + '</p>' : '') +
        (idea.how ? '<p class="cro-how"><b>Qué haría:</b> ' + esc(idea.how) + '</p>' : '') +
        (st === 'approved' ? '<p class="cro-approved-note">🤖 Aprobada — está en la cola de Hoy ("Aprobado, falta hacerlo") con los días que lleva esperando, hasta que se marque hecha.</p>' : '') +
        '<div class="cro-actions">' +
          (st !== 'done' ? '<button class="btn small" data-cro-st="approved" data-cro-i="' + i + '" type="button">' + (st === 'approved' ? '↩︎ Quitar aprobación' : '🤖 Aprobar — la hace Claude') + '</button>' : '') +
          '<button class="btn btn-ghost small" data-cro-st="done" data-cro-i="' + i + '" type="button">' + (st === 'done' ? '↩︎ Reabrir' : '✅ Hecha') + '</button>' +
          '<button class="btn btn-ghost small" data-cro-st="dismissed" data-cro-i="' + i + '" type="button">' + (st === 'dismissed' ? '↩︎ Restaurar' : '🗑 Descartar') + '</button>' +
        '</div>' +
      '</div>';
    }).join('') : '<p class="muted-note">Esta semana quedó sin ideas — regenerá con 🔄.</p>';
    box.querySelectorAll('[data-cro-st]').forEach((b) => b.addEventListener('click', () => croSetStatus(parseInt(b.dataset.croI, 10), b.dataset.croSt)));
  }
  /* Las ideas aprobadas ANTES de que existiera la cola quedaron como una marca en
     el jsonb y nada más — justamente el problema. Al cargar el tab se encolan las
     que sigan aprobadas y sin hacer; el índice único evita duplicarlas. */
  /* La cola y la tarjeta de CRO tienen que decir lo mismo. ref = "<fila>:<índice>". */
  async function croMarcarIdea(ref, estado){
    const [rowId, i] = String(ref).split(':');
    const fila = (croRows || []).find((r) => String(r.id) === String(rowId));
    if (!fila || !Array.isArray(fila.ideas) || !fila.ideas[+i]) {
      // el tab de CRO puede no estar cargado en esta sesión: se actualiza directo
      const { data } = await supabase.from('cro_ideas').select('ideas').eq('id', rowId).maybeSingle();
      if (!data || !Array.isArray(data.ideas) || !data.ideas[+i]) return;
      data.ideas[+i].status = estado;
      await supabase.from('cro_ideas').update({ ideas: data.ideas }).eq('id', rowId);
      return;
    }
    fila.ideas[+i].status = estado;
    await supabase.from('cro_ideas').update({ ideas: fila.ideas }).eq('id', rowId);
    try { croRender(); } catch (e) { /* el tab puede no estar montado */ }
  }
  async function croBackfillCola(){
    for (const row of croRows){
      if (!Array.isArray(row.ideas)) continue;
      for (let i = 0; i < row.ideas.length; i++){
        const idea = row.ideas[i];
        if ((idea && idea.status) !== 'approved') continue;
        /* No sabemos el día exacto en que se aprobó (el jsonb no lo guardaba):
           usamos cuándo se generaron las ideas de esa semana. Es una cota, y se
           dice en el detalle para no inventar precisión que no tenemos. */
        await wqAdd({ source: 'cro', ref: row.id + ':' + i, title: idea.title || 'Idea de CRO',
          detail: (idea.how || idea.hypothesis || '') + ' · aprobada antes de que existiera esta cola',
          url: '/dashboard/?tab=analytics&sub=cro', approved_at: row.created_at });
      }
    }
  }
  async function croSetStatus(i, st){
    const row = croRows[croIdx]; if (!row || !Array.isArray(row.ideas) || !row.ideas[i]) return;
    const cur = row.ideas[i].status || '';
    const nuevo = cur === st ? null : st;          // segundo click = deshacer
    row.ideas[i].status = nuevo;
    croRender(); // optimista — el update va por detrás
    const { error } = await supabase.from('cro_ideas').update({ ideas: row.ideas }).eq('id', row.id);
    if (error){ row.ideas[i].status = cur || null; croRender(); alert('No se pudo guardar: ' + (error.message || 'error')); return; }
    /* Aprobar ahora ENCOLA. Antes solo escribía 'approved' en el jsonb y el
       cartel prometía que Claude la haría "en la próxima sesión": si esa sesión
       no la miraba, la idea moría ahí. Ahora cae en work_queue y se ve en Hoy
       con los días que lleva esperando. Desaprobar la saca. */
    const idea = row.ideas[i], ref = row.id + ':' + i;
    if (nuevo === 'approved'){
      await wqAdd({ source: 'cro', ref, title: idea.title || 'Idea de CRO',
        detail: idea.how || idea.hypothesis || '', url: '/dashboard/?tab=analytics&sub=cro' });
      toast('🤖 Aprobada y en la cola de Hoy');
    } else if (cur === 'approved'){
      await wqCancelRef('cro', ref);
    } else if (nuevo === 'done' || nuevo === 'dismissed'){
      await wqCancelRef('cro', ref);   // ya está hecha o descartada: fuera de la cola
    }
  }
  async function croGenerate(){
    const btn = $('cro-gen'); if (!btn || btn.disabled) return;
    btn.disabled = true; btn.textContent = '⏳ Generando…';
    try {
      const { data, error } = await supabase.functions.invoke('cro-ideas', { body: { force: true } });
      if (error) throw error;
      if (data && data.error) throw new Error(data.error);
      await croLoad(true);
    } catch (e) {
      alert('No se pudieron generar las ideas: ' + (e.message || e));
    } finally {
      btn.disabled = false; btn.textContent = '🔄 Generar ahora';
    }
  }
  (function(){
    const g = $('cro-gen'); if (g) g.addEventListener('click', croGenerate);
    const sel = $('cro-week'); if (sel) sel.addEventListener('change', () => { croIdx = parseInt(sel.value, 10) || 0; croRender(); });
  })();

