  /* Resumen para mirar ANTES de publicar: cuánto entra, cuánto cuesta y qué
     queda. Toma el paquete marcado como recomendado, que es el que el cliente
     elige casi siempre; si no hay ninguno marcado, el más caro. */
  function ppUpdateSum(){
    const el = $('pp-sum'); if (!el) return;
    const ts = (ppCur && ppCur.tiers) || [];
    if (!ts.length){ el.hidden = true; return; }
    const t = ts.find((x) => x.recommended) || ts.slice().sort((a, b) => tierNet(b) - tierNet(a))[0];
    const net = tierNet(t), cost = tierCostSum(t);
    const chf = (n) => 'CHF ' + Math.round(n).toLocaleString('de-CH');
    el.hidden = false;
    if (!cost){
      el.className = 'pp-sum warn';
      el.innerHTML = '⚠️ ' + chf(net) + ' · sin costo cargado, no se puede saber la ganancia';
      return;
    }
    el.className = 'pp-sum';

    /* El cliente los ve de CARO a BARATO —el primero fija la referencia— y con tres
       paquetes el del medio es el que se elige. Si el recomendado no es ese, o no hay
       ninguno marcado, se avisa: no es un error, es una decisión que conviene tomar a
       propósito y no por el orden en que se cargaron.
       (Sebastián, 26 ago 2026: "mejor de caro a barato con uno en el medio".) */
    let nota = '';
    if (ts.length === 3){
      const porPrecio = ts.slice().sort((a, b) => tierNet(b) - tierNet(a));
      const medio = porPrecio[1];
      const rec = ts.find((x) => x.recommended);
      if (!rec) nota = ' · <span style="color:#f0c060">ninguno marcado como recomendado — el del medio (' +
        esc(medio.name || chf(tierNet(medio))) + ') es el que se suele elegir</span>';
      else if (rec !== medio) nota = ' · <span style="color:#f0c060">el recomendado es el ' +
        (rec === porPrecio[0] ? 'más caro' : 'más barato') + '; el del medio (' +
        esc(medio.name || chf(tierNet(medio))) + ') convierte mejor</span>';
    }

    el.innerHTML = (t.recommended ? 'Recomendado' : 'Más caro') + ': ' + chf(net) +
      ' · ganancia <b>' + chf(net - cost) + '</b> · ' + Math.round((net - cost) / net * 100) + '%' + nota;
  }
