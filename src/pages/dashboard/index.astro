  async function nwTraducir(){
    nwGuardarTab();
    const origen = nwI18n[nwLangTab];
    if (!String(origen.subject || '').trim() || !(origen.blocks || []).length){ toast('Escribí primero esta versión'); return; }
    const otros = ['en', 'de', 'es'].filter((l) => l !== nwLangTab);
    const conTexto = otros.filter((l) => String((nwI18n[l] || {}).subject || '').trim());
    if (conTexto.length && !confirm('Ya hay texto en ' + conTexto.map((l) => NW_LANG_LBL[l]).join(' y ') + '.\n\n¿Reemplazarlo con la traducción?')) return;
    const btn = $('nw-traducir'); if (btn){ btn.disabled = true; btn.textContent = '✨ Traduciendo…'; }
    try {
      for (const lg of otros){
        const { data, error } = await supabase.functions.invoke('ai-newsletter-translate', {
          body: { from: nwLangTab, to: lg, subject: origen.subject, blocks: origen.blocks } });
