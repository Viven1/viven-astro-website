     Y el tiempo: MEDIANA, no promedio. En el blog el promedio da 186 s y la mediana
     10 s — la diferencia son pestañas olvidadas, una llegó al tope de 7.200 s. */
  function bl2Index(){
    const bySlug = new Map(); let total = 0;
    const wk = Date.now() - 7 * 864e5, wk2 = Date.now() - 14 * 864e5;
    const hum = new Set((humanAct || []).map((x) => x.session_id));
    (bl2Views || []).forEach((v) => {
      total++;
      const m = /\/blog\/([^\/?#]+)/.exec(v.path || ''); if (!m || !m[1]) return;
      const e = bySlug.get(m[1]) || { total: 0, last7: 0, prev7: 0, personas: new Set(), durs: [] };
      e.total++;
      if (v.session_id && hum.has(v.session_id)) e.personas.add(v.session_id);
      if (Number(v.duration) > 0) e.durs.push(Number(v.duration));
      const t = +new Date(v.created_at);
      if (t >= wk) e.last7++; else if (t >= wk2) e.prev7++;
