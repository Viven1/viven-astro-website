  /* Si falta el token del portal se genera acá mismo. Antes decía "generá primero el link
     del portal en «Portal del cliente»" y te mandaba a otra pantalla a apretar un botón que
     no decide nada — el token son 16 bytes al azar, no hay nada que elegir.
     (Sebastián, 26 ago 2026, mirando ese mismo cartel: "tendria q ser automatico...") */
  async function pjBriefDatos(op){
    const callado = op && op.callado;
    const p = pjCur; if (!p) return null;
    let d = await pjDeal(p);
    if (d && !d.portal_token){
      await pjGenPortal({ callado: true });
      d = await pjDeal(p);
    }
    if (!d || !d.portal_token){ if (!callado) toast('Este proyecto no tiene deal asociado — sin eso no hay portal'); return null; }
    const l = leadById(p.lead_id) || {};
    if (!l.email){ if (!callado) toast('El contacto del proyecto no tiene email'); return null; }
    const lang = ['en', 'de', 'es'].includes(l.lang) ? l.lang : 'en';
    /* La variante se sortea UNA vez y se guarda: si cambiara entre visitas, la medición
       de cuál se termina más no valdría nada. */
    const variante = p.brief_variante || (Math.random() < 0.5 ? 'largo' : 'pasos');
    return { p, d, l, lang, variante,
      url: location.origin + '/portal/?id=' + encodeURIComponent(d.id) + '&t=' + encodeURIComponent(d.portal_token),
      asunto: (p.ref ? p.ref + ' · ' : '') + (p.title || '') + ' — ' + PJ_BRIEF_MAIL[lang].s,
      cuerpo: PJ_BRIEF_MAIL[lang].p };
  }

