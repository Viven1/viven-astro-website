  let hmRodajes = [], hmRodAt = 0, hmRodPidiendo = false;

  async function hmRodajesLoad(){
    if (hmRodPidiendo || Date.now() - hmRodAt < 120000) return;
    hmRodAt = Date.now(); hmRodPidiendo = true;
    try {
      const hoy = new Date().toISOString().slice(0, 10);
      const en4 = new Date(Date.now() + 4 * 864e5).toISOString().slice(0, 10);
      const [pq, cq] = await Promise.all([
        supabase.from('projects').select('id,ref,title,shoot_start,location,crew,lead_id')
          .eq('archived', false).gte('shoot_start', hoy).lte('shoot_start', en4).order('shoot_start'),
        supabase.from('crew').select('name,email,phone'),
      ]);
      if (pq.error) throw pq.error;
      const tec = cq.error ? [] : (cq.data || []);
      const norm = (x) => String(x || '').toLowerCase().trim();
      hmRodajes = (pq.data || []).map((p) => {
        const crew = Array.isArray(p.crew) ? p.crew.filter((c) => c && c.nombre) : [];
        const sinTel = crew.filter((c) => {
          const t = tec.find((x) => norm(x.name) === norm(c.nombre));
          return !t || !t.phone;
        });
        const sinMail = crew.filter((c) => {
          const t = tec.find((x) => norm(x.name) === norm(c.nombre));
          return !t || !t.email;
        });
        const dias = Math.round((Date.parse(p.shoot_start + 'T00:00:00') - Date.parse(hoy + 'T00:00:00')) / 864e5);
        return { p, crew, sinTel, sinMail, dias, sinLoc: !String(p.location || '').trim() };
      });
      if (!$('tab-hoy').hidden){
        hmTodayCur = hmTodayItems();
        $('hm-today-n').textContent = hmTodayCur.length ? '(' + hmTodayCur.length + ')' : '';
        hmRenderToday(hmTodayCur);
      }
    } catch (e){ console.error('RODAJES_HOY', e && e.message); }
    finally { hmRodPidiendo = false; }
  }

  async function epLoad(forzar){
    /* ⚠️ NUNCA llamar a renderHome() desde acá.
       La primera versión hacía epLoad → epRender → renderHome → epLoad → … y eso es
       recursión infinita: Hoy se colgaba entero y no se veía nada. Se ve raro que
       algo tan chico rompa la pantalla completa, pero el ciclo no tiene freno y el
       navegador se queda sin pila. (25 ago: "no veo aún los emails de info@ en hoy...
       ¿falta algo?" — faltaba que la pantalla no se colgara.)
       Cuando llegan datos nuevos se redibuja SOLO la lista, que es lo único que
       cambia. */
    if (epPidiendo) return;
    if (!forzar && Date.now() - epAt < 30000) return;
    epAt = Date.now(); epPidiendo = true;
    try {
      const { data, error } = await supabase.from('email_pendientes')
        .select('id,from_email,from_name,subject,body,received_at,mailbox')
        .eq('status', 'pendiente').order('received_at', { ascending: false }).limit(200);
      if (error) throw error;
      const antes = JSON.stringify((epRows || []).map((r) => r.id));
      epRows = data || [];
      // solo se redibuja si de verdad cambió algo: si no, es trabajo por nada
      if (JSON.stringify(epRows.map((r) => r.id)) !== antes && !$('tab-hoy').hidden){
        hmTodayCur = hmTodayItems();
        $('hm-today-n').textContent = hmTodayCur.length ? '(' + hmTodayCur.length + ')' : '';
        hmRenderToday(hmTodayCur);
      }
    } catch (e) { epRows = []; }
    finally { epPidiendo = false; }
  }
  /* Agrupado por REMITENTE: quien escribió tres veces es UNA decisión, no tres. */
  function epGente(){
    const porRemitente = new Map();
    (epRows || []).filter((r) => !esInterno(r.from_email)).forEach((r) => {
      const k = (r.from_email || '').toLowerCase();
      const g = porRemitente.get(k) || { ...r, n: 0, ids: [] };
      g.n++; g.ids.push(r.id);
      porRemitente.set(k, g);
    });
    return [...porRemitente.values()];
  }
  async function epAprobar(g, btn){
    if (btn) btn.disabled = true;
    try {
      /* Se aprueban TODOS los emails de esa persona, no solo el último: si escribió
         tres veces, los tres van a su ficha. El primero crea el contacto. */
      let lid = null;
      for (const id of g.ids){
        const { data, error } = await supabase.rpc('aprobar_email_pendiente', { p_id: id, p_nombre: g.from_name || null });
        if (error) throw error;
        if (!data || !data.ok) throw new Error((data && data.error) || 'no se pudo');
        lid = data.lead_id;
