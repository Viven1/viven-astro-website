  /* ---- 🤖 Mejorar con aceptación (pedido: "hacelo vos y dejame aceptarlo"):
     seo-title-improve lee el archivo REAL de la página en GitHub, propone title +
     meta description nuevos (en el/los idioma(s) del frontmatter) y devuelve el
     archivo completo con SOLO eso cambiado. Acá se muestra el ANTES→DESPUÉS y
     recién con "✅ Aplicar y publicar" se commitea EXACTAMENTE ese contenido vía
     apply-link-suggest mode:'commit' (mismo contrato que canibalización: lo que
     se aprueba es lo que se publica; si el archivo cambió en el medio, el sha
     viejo hace fallar el commit limpio — GitHub 409 — y se regenera). ---- */
  // contexto real para la IA: las búsquedas del período que GSC atribuye a esa página
  function seoQueriesFor(page){
    return ((seoData && seoData.queries) || [])
      .filter((q) => q.page === page)
      .sort((a, b) => (b.impressions || 0) - (a.impressions || 0))
      .slice(0, 5)
      .map((q) => ({ query: q.key, impressions: q.impressions, position: q.position, ctr: q.ctr }));
  }
  function seoLenTag(s, max){
    const n = String(s == null ? '' : s).length;
    return ' <span style="font-size:11px;color:' + (n > max ? '#ff8b8b' : 'var(--muted-2)') + '">(' + n + '/' + max + ')</span>';
  }
  // title/desc pueden ser string (una lengua) u objeto {en,de,es} — una línea por idioma, con contador
  function seoMetaLines(v, max){
    const o = (v && typeof v === 'object') ? v : { '': v };
    return Object.keys(o).map((k) =>
      '<div style="margin-top:2px">' + (k ? '<b style="font-size:10px;text-transform:uppercase;color:var(--muted-2);margin-right:5px">' + esc(k) + '</b>' : '') +
      esc(String(o[k] == null || o[k] === '' ? '(vacío)' : o[k])) + seoLenTag(o[k], max) + '</div>').join('');
  }
  function seoBeforeAfter(before, after, max){
    return '<div style="color:var(--muted-2)"><span style="font-size:10px;text-transform:uppercase;letter-spacing:.04em">antes</span>' + seoMetaLines(before, max) + '</div>' +
      '<div style="margin-top:4px"><span style="font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:var(--acid)">después</span>' + seoMetaLines(after, max) + '</div>';
  }
  function seoImpNote(queries){
    const q0 = (queries && queries[0]) || {};
    return 'auto: query «' + (q0.query || '—') + '», ' + (q0.impressions || 0) + ' impresiones, posición ' + (q0.position != null ? (+q0.position).toFixed(1) : '—');
  }
  // opción secundaria: encolar en seo_actions para que Claude lo haga a mano en sesión
  function seoBindQueue(box, page, queries){
    const b = box.querySelector('.seo-imp-queue'); if (!b) return;
    b.addEventListener('click', async () => {
      b.disabled = true;
      if (await seoActionAdd(page, 'improve', 'requested', seoImpNote(queries))){ toast('🤖 Encolada — Claude la trabaja en la próxima sesión'); b.textContent = '✓ Encolada para Claude'; }
      else b.disabled = false;
    });
  }
  // corre el flujo completo dentro de un contenedor dado — lo comparten 📈 Top páginas y 🎯 CTR
  async function seoImproveRun(box, page, queries){
    box.innerHTML = '<div class="seo-title-box">🤖 Leyendo el archivo real de la página y proponiendo title + description… <span class="muted-note">(~15-30 s)</span></div>';
    try {
      const { data, error } = await supabase.functions.invoke('seo-title-improve', { body: { page, queries } });
      if (error || !data || data.error) throw new Error((data && data.error) || (error && error.message) || 'sin respuesta');
      seoImproveBox(box, page, queries, data);
    } catch (e) {
      box.innerHTML = '<div class="seo-title-box">❌ No se pudo generar la propuesta: ' + esc(e.message || String(e)) +
        '<div style="margin-top:8px"><button type="button" class="btn btn-ghost small seo-imp-queue">🤖 Prefiero que lo haga Claude a mano (encolar)</button></div></div>';
      seoBindQueue(box, page, queries);
    }
  }
  function seoImproveBox(box, page, queries, d){
    const q0 = ((queries && queries[0]) || {}).query || '';
    box.innerHTML = '<div class="seo-title-box">' +
      '<div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted-2);margin-bottom:6px">Propuesta — ' + esc(String(d.path || '')) + '</div>' +
      '<div style="font-size:12.5px"><b>Title</b>' + seoBeforeAfter(d.current && d.current.title, d.proposal && d.proposal.title, 60) + '</div>' +
      '<div style="font-size:12.5px;margin-top:10px"><b>Meta description</b>' + seoBeforeAfter(d.current && d.current.desc, d.proposal && d.proposal.desc, 155) + '</div>' +
      (d.rationale ? '<div style="margin-top:10px;color:var(--acid);font-size:12.5px">💡 ' + esc(d.rationale) + '</div>' : '') +
      (d.overLimit && d.overLimit.length ? '<div class="muted-note" style="margin-top:6px;color:#f0c060">⚠ Se pasa del largo recomendado: ' + esc(d.overLimit.join(', ')) + ' — igual se puede aplicar.</div>' : '') +
      '<div style="margin-top:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">' +
        '<button type="button" class="btn btn-primary small seo-imp-apply">✅ Aplicar y publicar</button>' +
        '<button type="button" class="btn btn-ghost small seo-imp-discard">✗ Descartar</button>' +
        '<button type="button" class="btn btn-ghost small seo-imp-queue" title="No publica nada — solo se encola en seo_actions">🤖 prefiero que lo haga Claude a mano</button>' +
      '</div><div class="muted-note seo-imp-status" style="margin-top:6px"></div></div>';
    seoBindQueue(box, page, queries);
    box.querySelector('.seo-imp-discard').addEventListener('click', () => {
      const tr = box.closest('tr');
      box.innerHTML = '';
      if (box.tagName === 'TD' && tr) tr.hidden = true;   // en Top páginas el box ES la fila de detalle
    });
    const applyBtn = box.querySelector('.seo-imp-apply');
    const status = box.querySelector('.seo-imp-status');
    applyBtn.addEventListener('click', async () => {
      applyBtn.disabled = true; applyBtn.textContent = '⏳ Publicando…';
      try {
        // mismo branch de commit que canibalización ({mode:'commit', path, sha, updated});
        // anchor/strongUrl/query solo arman el mensaje del commit
        const { data: com, error } = await supabase.functions.invoke('apply-link-suggest', {
          body: { mode: 'commit', path: d.path, sha: d.sha, updated: d.updated, anchor: 'title/description', strongUrl: page, weakUrl: page, query: q0 || 'SEO title' },
        });
        if (error || !com || com.error) throw new Error((com && com.error) || (error && error.message) || 'error desconocido');
        const note = JSON.stringify({ kind: 'title-improve', q: q0, before: d.current, after: d.proposal, commit: com.commitUrl || '' });
        await seoActionAdd(page, 'improve', 'done', note);
        applyBtn.remove();
        box.querySelectorAll('.seo-imp-discard, .seo-imp-queue').forEach((x) => x.remove());
        status.innerHTML = '<span style="color:#7ed957">✓ Aplicado — deploy en ~1 min (Cloudflare).</span> Cambió title + description de <code>' + esc(String(d.path || '')) + '</code>' +
          (com.commitUrl ? ' · <a href="' + esc(com.commitUrl) + '" target="_blank" rel="noopener">ver commit</a>' : '') +
          ' — el detalle queda en 🗂 Mejoras aplicadas, al final del tab.';
        seoRenderHistory();
      } catch (e) {
        applyBtn.disabled = false; applyBtn.textContent = '✅ Aplicar y publicar';
        // caso típico: el archivo cambió entre la propuesta y el apply → GitHub 409 por sha viejo
        status.innerHTML = '❌ No se pudo publicar: ' + esc(e.message || String(e)) +
          (/409/.test(String(e.message || '')) ? ' — la página cambió desde que se generó la propuesta; tocá 🤖 Mejorar de nuevo para regenerarla sobre la versión actual.' : '');
      }
    });
  }
  // 🗂 historial visible de lo aplicado (pedido: "ver qué hizo para ver que no haya errores")
  function seoRenderHistory(){
    const wrap = $('seo-hist-wrap'); if (!wrap) return;
    const rows = (seoActionsCache || []).filter((a) => a.action_type === 'improve' && a.status === 'done');
    const cnt = $('seo-hist-count'); if (cnt) cnt.textContent = rows.length ? '(' + rows.length + ')' : '';
    if (!rows.length){ wrap.innerHTML = '<p class="muted-note">Todavía no se aplicó ninguna mejora desde acá.</p>'; return; }
    wrap.innerHTML = rows.slice(0, 60).map((a) => {
      let d = null; try { d = JSON.parse(a.note || ''); } catch (e) { /* notas viejas en texto plano */ }
      const when = new Date(a.created_at).toLocaleDateString('es-CH', { day: '2-digit', month: 'short', year: '2-digit' });
      const pagePath = String(a.page || '').replace(/^https?:\/\/[^/]+/, '') || String(a.page || '');
      const body = d && d.after
        ? '<div style="margin-top:8px"><b>Title</b>' + seoBeforeAfter(d.before && d.before.title, d.after.title, 60) + '</div>' +
          '<div style="margin-top:8px"><b>Meta description</b>' + seoBeforeAfter(d.before && d.before.desc, d.after.desc, 155) + '</div>' +
          (d.commit ? '<div style="margin-top:8px"><a href="' + esc(d.commit) + '" target="_blank" rel="noopener">ver commit</a></div>' : '')
        : '<div class="muted-note" style="margin-top:6px">' + esc(a.note || '(sin detalle)') + '</div>';
      return '<details style="border:1px solid var(--line);border-radius:10px;padding:8px 12px;margin-bottom:6px">' +
        '<summary style="cursor:pointer;font-size:12.5px"><span class="muted-note">' + when + '</span> · <b>' + esc(pagePath) + '</b>' + (d && d.q ? ' <span class="muted-note">· «' + esc(d.q) + '»</span>' : '') + '</summary>' +
        '<div style="font-size:12.5px">' + body + '</div></details>';
    }).join('');
  }

  function seoRenderTopPages(){
    const cont = $('seo-p-wrap'), cnt = $('seo-p-count');
    if (!cont || !seoData) return;
    const src = seoData.pages || [];
    // deltas por página: si la función deployada todavía no manda prevPages, se muestran sin delta
    const prevBy = new Map((seoData.prevPages || []).map((p) => [p.key, p]));
    if (cnt) cnt.textContent = src.length ? '(' + src.length + ')' : '';
    if (!src.length){ cont.innerHTML = '<p class="muted-note">Sin datos todavía</p>'; return; }
    const state = seoPSort;
    const val = (r, k) => k === 'key' ? (r.key || '').toLowerCase() : (r[k] || 0);
    const rows = src.slice().sort((a, b) => { const av = val(a, state.k), bv = val(b, state.k); return av < bv ? -state.dir : av > bv ? state.dir : 0; });
    const fmtN = (n) => (n || 0).toLocaleString('de-CH');
    const hasPrev = prevBy.size > 0;
    const dClicks = (p, prev) => {
      if (!hasPrev) return '';
      if (!prev) return '<span class="up" style="font-size:11px">nueva</span>';
      const df = (p.clicks || 0) - (prev.clicks || 0);
      if (!df) return '<span class="muted-note" style="font-size:11px">=</span>';
      return '<span class="' + (df > 0 ? 'up' : 'down') + '" style="font-size:11px">' + (df > 0 ? '▲ +' : '▼ −') + Math.abs(df) + '</span>';
    };
    // OJO: en posición BAJAR es mejorar (misma lógica que seoPosDelta)
    const dPos = (p, prev) => {
      if (!hasPrev || !prev) return '';
      const df = (prev.position || 0) - (p.position || 0);
      if (Math.abs(df) < 0.15) return '<span class="muted-note" style="font-size:11px">=</span>';
      return '<span class="' + (df > 0 ? 'up' : 'down') + '" style="font-size:11px">' + (df > 0 ? '▲ ' : '▼ ') + Math.abs(df).toFixed(1) + '</span>';
    };
    let html = '<table class="lead-table seo-table"><thead><tr>' +
      seoSortTh(state, 'Página', 'key') + seoSortTh(state, 'Clicks', 'clicks', 1) + seoSortTh(state, 'Impresiones', 'impressions', 1) +
      seoSortTh(state, 'CTR', 'ctr', 1) + seoSortTh(state, 'Posición', 'position', 1) + '<th>Estado</th><th></th></tr></thead><tbody>';
    rows.forEach((p, i) => {
      const prev = prevBy.get(p.key);
      const act = seoActionFor(p.key);
      const badge = !act ? '' : act.status === 'requested'
        ? '<span style="color:#8ab4ff;font-size:11px;white-space:nowrap">🤖 en cola</span>'
        : '<span style="color:#7ed957;font-size:11px;white-space:nowrap">✓ hecha</span>';
      html += '<tr><td><span style="white-space:normal;word-break:break-all">' + esc(p.key.replace(/^https?:\/\/[^/]+/, '')) + '</span></td>' +
        '<td class="lt-num" style="white-space:nowrap">' + fmtN(p.clicks) + ' ' + dClicks(p, prev) + '</td>' +
        '<td class="lt-num">' + fmtN(p.impressions) + '</td>' +
        '<td class="lt-num">' + ((p.ctr || 0) * 100).toFixed(1) + '%</td>' +
        '<td class="lt-num" style="white-space:nowrap">' + (p.position || 0).toFixed(1) + ' ' + dPos(p, prev) + '</td>' +
        '<td>' + badge + '</td>' +
        '<td><div class="kw-acts">' +
          '<button type="button" class="seo-p-hist" data-i="' + i + '" title="Evolución de posición (snapshots semanales)">📉 evolución</button>' +
          (act && act.status === 'requested' ? '' : '<button type="button" class="seo-p-ai" data-i="' + i + '" title="La IA propone title + meta description nuevos con las búsquedas reales de esta página — vos ves el antes→después y aprobás (o descartás)">🤖 Mejorar</button>') +
          '<button type="button" class="seo-p-done" data-i="' + i + '" title="Marcar como mejorada a mano">✓ Hecha</button>' +
        '</div></td></tr>' +
        '<tr class="seo-opp-detail" id="seo-p-detail-' + i + '" hidden><td colspan="7"></td></tr>';
    });
    cont.innerHTML = html + '</tbody></table>';
    seoBindSort(cont, state, seoRenderTopPages);
    // el note lleva las métricas del momento: es el contexto con el que Claude
    // (o quien revise la cola) decide QUÉ mejorar sin volver a mirar GSC
    const mkNote = (p) => 'auto: período ' + (seoData.days || seoDays) + 'd — ' + (p.clicks || 0) + ' clicks, ' + (p.impressions || 0) + ' impresiones, CTR ' + ((p.ctr || 0) * 100).toFixed(1) + '%, posición ' + (p.position || 0).toFixed(1);
    cont.querySelectorAll('.seo-p-hist').forEach((b) => b.addEventListener('click', () => seoPageHistory(+b.dataset.i, rows[+b.dataset.i].key)));
    // 🤖 ya no encola a ciegas: abre la fila de detalle con la propuesta completa
    // (antes→después + Aplicar/Descartar); encolar para Claude queda como opción
    // secundaria adentro de la caja
    cont.querySelectorAll('.seo-p-ai').forEach((b) => b.addEventListener('click', () => {
      const i = +b.dataset.i, p = rows[i]; if (!p) return;
      const tr = $('seo-p-detail-' + i); if (!tr) return;
      tr.hidden = false;
      seoImproveRun(tr.querySelector('td'), p.key, seoQueriesFor(p.key));
    }));
    cont.querySelectorAll('.seo-p-done').forEach((b) => b.addEventListener('click', async () => {
      const p = rows[+b.dataset.i]; if (!p) return;
      b.disabled = true;
      if (await seoActionAdd(p.key, 'manual', 'done', mkNote(p))){ toast('✓ Marcada como hecha'); seoRenderTopPages(); }
      else b.disabled = false;
    }));
  }
  // evolución de posición de UNA página: sparkline + mini-tabla con los snapshots
  // semanales de gsc_page_history (cron lunes 07:15 UTC → gsc-stats {snapshot:true})
  async function seoPageHistory(i, page){
    const tr = $('seo-p-detail-' + i); if (!tr) return;
    if (!tr.hidden){ tr.hidden = true; return; }   // toggle
    tr.hidden = false;
    const td = tr.querySelector('td');
    td.innerHTML = '<div class="seo-title-box">Leyendo snapshots…</div>';
    try {
      const { data, error } = await supabase.from('gsc_page_history').select('date,clicks,impressions,position,ctr').eq('page', page).order('date', { ascending: true }).limit(120);
      if (error) throw error;
      if (!data || !data.length){
        td.innerHTML = '<div class="seo-title-box">Sin snapshots todavía para esta página — los datos se acumulan desde hoy, uno por semana (cron lunes 07:15 UTC). En unas semanas acá se ve la evolución real de la posición.</div>';
        return;
      }
      const pts = data.filter((r) => r.position != null);
      let spark = '';
      if (pts.length >= 2){
        const w = 320, h = 56, pad = 6;
        const posMin = Math.min(...pts.map((r) => +r.position)), posMax = Math.max(...pts.map((r) => +r.position));
        const span = Math.max(0.5, posMax - posMin);
        const xy = pts.map((r, j) => {
          const x = pad + j * (w - 2 * pad) / (pts.length - 1);
          const y = pad + ((+r.position - posMin) / span) * (h - 2 * pad);   // posición más baja = más arriba
          return x.toFixed(1) + ',' + y.toFixed(1);
        });
        spark = '<svg width="' + w + '" height="' + h + '" viewBox="0 0 ' + w + ' ' + h + '" style="display:block;max-width:100%;margin:4px 0 8px" aria-hidden="true">' +
          '<polyline fill="none" stroke="var(--acid)" stroke-width="2" points="' + xy.join(' ') + '"/></svg>' +
          '<div class="muted-note" style="font-size:11px;margin-bottom:8px">Posición media por snapshot (arriba = mejor): ' + (+pts[0].position).toFixed(1) + ' → ' + (+pts[pts.length - 1].position).toFixed(1) + '</div>';
      }
      const last = data.slice(-12).reverse();
      td.innerHTML = '<div class="seo-title-box">' + spark +
        '<table class="lead-table"><thead><tr><th>Snapshot</th><th class="lt-num">Posición</th><th class="lt-num">Clicks (7d)</th><th class="lt-num">Impresiones</th><th class="lt-num">CTR</th></tr></thead><tbody>' +
        last.map((r) => '<tr><td>' + esc(r.date) + '</td><td class="lt-num">' + (r.position != null ? (+r.position).toFixed(1) : '—') + '</td><td class="lt-num">' + (r.clicks || 0) + '</td><td class="lt-num">' + (r.impressions || 0) + '</td><td class="lt-num">' + (r.ctr != null ? (+r.ctr * 100).toFixed(1) + '%' : '—') + '</td></tr>').join('') +
        '</tbody></table>' +
        (data.length < 2 ? '<div class="muted-note" style="margin-top:6px">Primer snapshot guardado — la curva aparece cuando haya 2 o más.</div>' : '') +
        '</div>';
    } catch (e) {
      td.innerHTML = '<div class="seo-title-box">¿Corriste el SQL 0116 (gsc_page_history)? ' + esc(e.message || String(e)) + '</div>';
    }
  }

  // oportunidad de CTR: 100% determinístico a partir de lo que ya trae gsc-stats (sin IA, sin llamada extra)
  function seoComputeOpp(data){
    const days = data.days || seoDays;
    const scale = 30 / days; // clicks perdidos escalados a "por mes"
    return (data.queries || [])
      .filter((q) => q.impressions >= 50)
      .map((q) => {
        const exp = seoExpectedCtr(q.position);
        const lost = Math.max(0, exp * q.impressions - q.clicks) * scale;
        return { query: q.key, impressions: q.impressions, position: q.position, ctr: q.ctr, expCtr: exp, lost, page: q.page || '' };
      })
      .filter((r) => r.lost > 0.5 && r.ctr < r.expCtr * 0.75) // "meaningfully" por debajo de lo esperado
      .sort((a, b) => b.lost - a.lost)
      .slice(0, 15);
  }
  function seoRenderOpp(){
    const cont = $('seo-opp-wrap'); if (!cont) return;
    if (!seoOppRows.length){ cont.innerHTML = '<p class="muted-note">Sin oportunidades claras en este período — buena señal, tus CTR están cerca de lo esperado para cada posición (o todavía no hay suficiente volumen de impresiones).</p>'; return; }
    const rows = seoOppRows.slice();
    const val = (r, k) => k === 'query' ? r.query.toLowerCase() : (r[k] || 0);
    rows.sort((a, b) => { const av = val(a, seoOppSort.k), bv = val(b, seoOppSort.k); return av < bv ? -seoOppSort.dir : av > bv ? seoOppSort.dir : 0; });
    let html = '<table class="lead-table"><thead><tr>' +
      seoSortTh(seoOppSort, 'Búsqueda', 'query') + seoSortTh(seoOppSort, 'Impresiones', 'impressions', 1) + seoSortTh(seoOppSort, 'Pos.', 'position', 1) +
      seoSortTh(seoOppSort, 'CTR', 'ctr', 1) + seoSortTh(seoOppSort, 'CTR esperado', 'expCtr', 1) + seoSortTh(seoOppSort, 'Clicks perdidos/mes', 'lost', 1) +
      '<th>Página</th><th></th></tr></thead><tbody>';
    rows.forEach((r, i) => {
      html += '<tr><td>' + esc(r.query) + '</td><td class="lt-num">' + r.impressions.toLocaleString('de-CH') + '</td>' +
        '<td class="lt-num">' + r.position.toFixed(1) + '</td><td class="lt-num">' + (r.ctr * 100).toFixed(1) + '%</td>' +
        '<td class="lt-num">' + (r.expCtr * 100).toFixed(1) + '%</td><td class="lt-num seo-money">~' + Math.round(r.lost) + '</td>' +
        '<td style="white-space:normal;word-break:break-all;font-size:11.5px">' + (r.page ? esc(r.page.replace(/^https?:\/\/[^/]+/, '')) : '<span class="muted-note">—</span>') + '</td>' +
        '<td>' + (r.page ? '<button type="button" class="btn btn-ghost small seo-opp-title" data-i="' + i + '">✏️ ver title</button>' : '') + '</td></tr>' +
        '<tr class="seo-opp-detail" id="seo-opp-detail-' + i + '" hidden><td colspan="8"></td></tr>';
    });
    cont.innerHTML = html + '</tbody></table>';
    seoBindSort(cont, seoOppSort, seoRenderOpp);
    cont.querySelectorAll('.seo-opp-title').forEach((b) => b.addEventListener('click', () => seoShowTitle(+b.dataset.i, rows[+b.dataset.i])));
  }
  // "✏️ ver title actual": fetch client-side de la página real (mismo origen — sin CORS) +
  // extracción de <title>/meta description + sugerencia estática (sin IA — v1 rápido y gratis).
  async function seoShowTitle(i, row){
    const tr = $('seo-opp-detail-' + i); if (!tr) return;
    const td = tr.querySelector('td');
    tr.hidden = false;
    td.innerHTML = '<div class="seo-title-box">Leyendo ' + esc(row.page) + '…</div>';
    try {
      // fetch same-origin (el dashboard puede correr en viven.ch sin www y la URL
      // de GSC viene con www → CORS "Failed to fetch"); el path alcanza porque
      // ambos hosts sirven el mismo sitio
      const seoPath = row.page.startsWith('http') ? new URL(row.page).pathname : row.page;
      const res = await fetch(seoPath, { cache: 'no-store' });
      const html = await res.text();
      const tm = html.match(/<title[^>]*>([^<]*)<\/title>/i);
      const dm = html.match(/<meta[^>]+name=["']description["'][^>]+content=["']([^"']*)["']/i) || html.match(/<meta[^>]+content=["']([^"']*)["'][^>]+name=["']description["']/i);
      const title = tm ? tm[1].trim() : '(sin title)';
      const desc = dm ? dm[1].trim() : '(sin meta description)';
      td.innerHTML = '<div class="seo-title-box">' +
        '<div><b>Title actual</b> <span class="muted-note">(' + title.length + ' car.)</span>: ' + esc(title) + '</div>' +
        '<div style="margin-top:6px"><b>Meta description actual</b> <span class="muted-note">(' + desc.length + ' car.)</span>: ' + esc(desc) + '</div>' +
        '<div style="margin-top:8px;color:var(--acid)">💡 Meté «' + esc(row.query) + '» cerca del inicio del title (≤60 car.) y un beneficio/CTA claro en la description (≤155 car.).</div>' +
        '<div style="margin-top:10px"><button type="button" class="btn btn-primary small" id="seo-opp-imp-btn-' + i + '">🤖 Proponer mejora</button></div>' +
        '</div><div id="seo-opp-imp-box-' + i + '"></div>';
      // mismo flujo con aceptación que 📈 Top páginas, con la query de ESTA fila como contexto principal
      const impBtn = $('seo-opp-imp-btn-' + i);
      if (impBtn) impBtn.addEventListener('click', () => {
        impBtn.disabled = true;
        const qs = [{ query: row.query, impressions: row.impressions, position: row.position, ctr: row.ctr }]
          .concat(seoQueriesFor(row.page).filter((q) => q.query !== row.query).slice(0, 4));
        seoImproveRun($('seo-opp-imp-box-' + i), row.page, qs).then(() => { impBtn.disabled = false; });
      });
    } catch (e) {
      td.innerHTML = '<div class="seo-title-box">No pude leer la página en vivo: ' + esc(e.message || String(e)) + '</div>';
    }
  }

  // title/description en vivo de una página propia (mismo origen, sin CORS) — le da
  // a la IA contexto real en vez de solo la URL. Mismo fix que seoShowTitle: la URL
  // de GSC viene con www y el dashboard puede correr en viven.ch sin www → fetch
  // absoluto = CORS "Failed to fetch"; el path same-origin alcanza porque ambos
  // hosts sirven el mismo sitio. Compartida por el flujo individual y el bulk.
  async function seoFetchMeta(url){
    try {
      const p = String(url).startsWith('http') ? new URL(url).pathname : url;
      const res = await fetch(p, { cache: 'no-store' });
      const html = await res.text();
      const tm = html.match(/<title[^>]*>([^<]*)<\/title>/i);
      const dm = html.match(/<meta[^>]+name=["']description["'][^>]+content=["']([^"']*)["']/i) || html.match(/<meta[^>]+content=["']([^"']*)["'][^>]+name=["']description["']/i);
      return { title: tm ? tm[1].trim() : '', desc: dm ? dm[1].trim() : '' };
    } catch (_e) { return { title: '', desc: '' }; }
  }

  // ⚔️ Canibalización: además de listar las páginas que compiten, cada página débil
  // (todas menos la dominante, r.pages[0]) tiene un botón "🔗 Sugerir link" — llama a
  // ai-link-suggest para proponer anchor + oración + dónde insertarlo, con preview del
  // diff real antes de commitear. "🔁 Arreglar todas" corre ese MISMO flujo en secuencia
  // para todas las páginas débiles, con UNA confirmación inicial (los commits al repo
  // los hace apply-link-suggest vía GitHub API, igual que el flujo individual).
  let seoCannibRows = [];
  function seoRenderCannib(data){
    const cont = $('seo-cannib-wrap'); if (!cont) return;
    const rows = data.cannibalization || [];
    seoCannibRows = rows;
    if (!rows.length){ cont.innerHTML = '<p class="muted-note">Sin canibalización detectada — cada búsqueda top tiene una sola página dominante.</p>'; return; }
    const nBulk = seoCannibBulkItems().length;
    let html = '<div style="display:flex;justify-content:flex-end;margin-bottom:8px">' +
      '<button type="button" class="btn btn-ghost small" id="seo-cannib-all">🔁 Arreglar todas (' + nBulk + ')</button></div>' +
      '<div id="seo-cannib-bulk"></div>' +
      '<table class="lead-table"><thead><tr><th>Query</th><th>Páginas compitiendo</th></tr></thead><tbody>';
    rows.forEach((r, ri) => {
      const [strong, ...weak] = r.pages;
      html += '<tr><td>' + esc(r.query) + '</td><td class="seo-cannib-pages">' +
        '<div>🏆 ' + esc(strong.page.replace(/^https?:\/\/[^/]+/, '')) + ' (pos ' + strong.position.toFixed(1) + ', ' + strong.impressions + ' impr.)</div>' +
        weak.map((p, pi) => '<div>' + esc(p.page.replace(/^https?:\/\/[^/]+/, '')) + ' (pos ' + p.position.toFixed(1) + ', ' + p.impressions + ' impr.) ' +
          '<button type="button" class="btn btn-ghost small seo-cannib-link" data-ri="' + ri + '" data-pi="' + pi + '">🔗 Sugerir link</button></div>').join('') +
        '</td></tr>' +
        '<tr class="seo-cannib-detail" id="seo-cannib-detail-' + ri + '" hidden><td colspan="2"></td></tr>';
    });
    cont.innerHTML = html + '</tbody></table>';
    cont.querySelectorAll('.seo-cannib-link').forEach((b) => b.addEventListener('click', () =>
      seoLinkSuggest(+b.dataset.ri, +b.dataset.pi, rows)));
    const allBtn = $('seo-cannib-all'); if (allBtn) allBtn.addEventListener('click', seoCannibFixAll);
  }
  // items del bulk: una entrada por página débil, deduplicando pares débil→fuerte
  // que aparecen bajo varias queries (un solo link alcanza para todas)
  function seoCannibBulkItems(){
    const seen = new Set(); const items = [];
    (seoCannibRows || []).forEach((r) => {
      const strong = r.pages[0];
      r.pages.slice(1).forEach((weakP) => {
        const k = weakP.page + '→' + strong.page;
        if (seen.has(k)) return; seen.add(k);
        items.push({ query: r.query, strong, weakP });
      });
    });
    return items;
  }
  // "🔁 Arreglar todas": el flujo individual completo (meta en vivo → ai-link-suggest
  // → apply-link-suggest preview → commit) por cada página débil, EN SECUENCIA — no en
  // paralelo a propósito: si el mismo archivo recibe 2 links, el segundo preview ya lo
  // lee con el sha del primer commit y no pisa nada. UNA confirmación inicial y después
  // corre solo, con barra de progreso y resultado por fila.
  async function seoCannibFixAll(){
    const items = seoCannibBulkItems();
    if (!items.length){ toast('Nada que arreglar'); return; }
    if (!confirm('🔁 Arreglar todas las canibalizaciones\n\nVoy a insertar ' + items.length + ' link(s) interno(s): en cada página débil, un link con anchor exacto hacia su página dominante.\n\nPor cada uno: la IA redacta el anchor + la oración y el cambio se COMMITEA automáticamente al repo (rama dev, GitHub API — Cloudflare deploya solo), sin más confirmaciones.\n\n¿Dale?')) return;
    const btn = $('seo-cannib-all'); if (btn){ btn.disabled = true; btn.textContent = '⏳ Aplicando…'; }
    const box = $('seo-cannib-bulk');
    const short = (u) => String(u || '').replace(/^https?:\/\/[^/]+/, '') || '/';
    box.innerHTML = '<div class="seo-title-box" style="margin-bottom:10px">' +
      '<div style="height:6px;background:var(--navy-900);border-radius:4px;overflow:hidden;margin-bottom:8px"><i id="seo-cb-bar" style="display:block;height:100%;width:0;background:var(--acid);transition:width .3s"></i></div>' +
      items.map((it, i) => '<div id="seo-cb-line-' + i + '" class="muted-note" style="margin-bottom:3px">⏳ ' + esc(short(it.weakP.page)) + ' → ' + esc(short(it.strong.page)) + '</div>').join('') +
      '<div class="muted-note" id="seo-cb-sum" style="margin-top:8px"></div></div>';
    let okN = 0;
    for (let i = 0; i < items.length; i++){
      const it = items[i];
      const line = $('seo-cb-line-' + i);
      const label = esc(short(it.weakP.page)) + ' → ' + esc(short(it.strong.page));
      const invoke = async (fn, body) => {
        const { data, error } = await supabase.functions.invoke(fn, { body });
        if (error || !data || data.error) throw new Error((data && data.error) || (error && error.message) || (fn + ' sin respuesta'));
        return data;
      };
      try {
        if (line) line.innerHTML = '🤔 ' + label + ' — pensando el link…';
        const [weakMeta, strongMeta] = await Promise.all([seoFetchMeta(it.weakP.page), seoFetchMeta(it.strong.page)]);
        const sug = await invoke('ai-link-suggest', {
          query: it.query, weakUrl: it.weakP.page, weakTitle: weakMeta.title, weakDesc: weakMeta.desc,
          strongUrl: it.strong.page, strongTitle: strongMeta.title,
        });
        if (line) line.innerHTML = '✏️ ' + label + ' — generando el cambio…';
        const prev = await invoke('apply-link-suggest', { mode: 'preview', weakUrl: it.weakP.page, strongUrl: it.strong.page, anchor: sug.anchor, snippet: sug.snippet, placement: sug.placement, query: it.query });
        if (line) line.innerHTML = '🚀 ' + label + ' — commiteando…';
        const com = await invoke('apply-link-suggest', { mode: 'commit', path: prev.path, sha: prev.sha, updated: prev.updated, weakUrl: it.weakP.page, strongUrl: it.strong.page, anchor: sug.anchor, query: it.query });
        okN++;
        if (line) line.innerHTML = '<span style="color:#7ed957">✓</span> ' + label + ' — aplicado («' + esc(sug.anchor || '') + '»)' +
          (com.commitUrl ? ' · <a href="' + esc(com.commitUrl) + '" target="_blank" rel="noopener">commit</a>' : '');
      } catch (e) {
        if (line) line.innerHTML = '<span style="color:#ff8b8b">✗</span> ' + label + ' — ' + esc(e.message || String(e));
      }
      const bar = $('seo-cb-bar'); if (bar) bar.style.width = Math.round((i + 1) / items.length * 100) + '%';
    }
    const sum = $('seo-cb-sum'); if (sum) sum.innerHTML = '<b>' + okN + '/' + items.length + '</b> aplicados — Cloudflare deploya en 1-2 min. Los que fallaron se pueden reintentar uno a uno con «🔗 Sugerir link».';
    if (btn){ btn.disabled = false; btn.textContent = '🔁 Arreglar todas (' + items.length + ')'; }
    toast(okN + '/' + items.length + ' links aplicados');
  }
  async function seoLinkSuggest(ri, pi, rows){
    const tr = $('seo-cannib-detail-' + ri); if (!tr) return;
    const td = tr.querySelector('td');
    const r = rows[ri];
    const strong = r.pages[0], weakP = r.pages.slice(1)[pi];
    tr.hidden = false;
    td.innerHTML = '<div class="seo-title-box">Leyendo ambas páginas y pensando el link…</div>';
    try {
      const [weakMeta, strongMeta] = await Promise.all([seoFetchMeta(weakP.page), seoFetchMeta(strong.page)]);
      const { data, error } = await supabase.functions.invoke('ai-link-suggest', {
        body: {
          query: r.query, weakUrl: weakP.page, weakTitle: weakMeta.title, weakDesc: weakMeta.desc,
          strongUrl: strong.page, strongTitle: strongMeta.title,
        },
      });
      if (error || !data || data.error) throw new Error((data && data.error) || (error && error.message) || 'error desconocido');
      td.innerHTML = '<div class="seo-title-box">' +
        '<div><b>Anchor sugerido</b>: ' + esc(data.anchor) + '</div>' +
        '<div style="margin-top:6px"><b>Oración</b>: ' + esc(data.snippet) + '</div>' +
        (data.placement ? '<div style="margin-top:6px"><b>Dónde</b>: ' + esc(data.placement) + '</div>' : '') +
        '<div style="margin-top:10px"><button type="button" class="btn btn-primary small" id="seo-cannib-preview-' + ri + '-' + pi + '">👁️ Ver cambio antes de aplicar</button></div>' +
        '<div id="seo-cannib-diff-' + ri + '-' + pi + '"></div>' +
        '</div>';
      $('seo-cannib-preview-' + ri + '-' + pi).addEventListener('click', () =>
        seoLinkPreview(ri, pi, weakP.page, strong.page, r.query, data.anchor, data.snippet, data.placement));
    } catch (e) {
      td.innerHTML = '<div class="seo-title-box">No se pudo generar la sugerencia: ' + esc(e.message || String(e)) + '</div>';
    }
  }
  // "👁️ Ver cambio antes de aplicar": genera el archivo editado SIN commitear nada
  // (mode:'preview') y muestra el diff real (líneas agregadas/contexto) — recién con
  // eso a la vista aparece el botón para deployar. Pedido explícito: "a mano no hace
  // sentido, dame opción de confirmar y vos lo deployás" — pero confirmar tiene que
  // ser sobre algo concreto, no un confirm() genérico sin mostrar qué cambia.
  async function seoLinkPreview(ri, pi, weakUrl, strongUrl, query, anchor, snippet, placement){
    const btn = $('seo-cannib-preview-' + ri + '-' + pi);
    const box = $('seo-cannib-diff-' + ri + '-' + pi);
    btn.disabled = true; btn.textContent = '⏳ Generando el cambio…';
    try {
      const { data, error } = await supabase.functions.invoke('apply-link-suggest', {
        body: { mode: 'preview', weakUrl, strongUrl, anchor, snippet, placement, query },
      });
      if (error || !data || data.error) throw new Error((data && data.error) || (error && error.message) || 'error desconocido');
      btn.remove();
      const d = data.diff;
      const line = (s, cls) => '<div class="' + cls + '">' + esc(s || '(línea vacía)') + '</div>';
      box.innerHTML = '<div class="seo-title-box" style="margin-top:8px">' +
        '<div style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted-2);margin-bottom:6px">Diff real de ' + esc(weakUrl.replace(/^https?:\/\/[^/]+/, '')) + '</div>' +
        '<div style="font-family:monospace;font-size:12px;line-height:1.6;background:var(--navy-900);border-radius:8px;padding:10px;overflow-x:auto">' +
        d.ctxBefore.map((l) => line(l, 'muted-note')).join('') +
        d.removed.map((l) => line('− ' + l, 'seo-diff-rm')).join('') +
        d.added.map((l) => line('+ ' + l, 'seo-diff-add')).join('') +
        d.ctxAfter.map((l) => line(l, 'muted-note')).join('') +
        '</div>' +
        '<div style="margin-top:10px;display:flex;gap:8px;align-items:center">' +
        '<button type="button" class="btn btn-primary small" id="seo-cannib-commit-' + ri + '-' + pi + '">✅ Confirmar y deployar</button>' +
        '<button type="button" class="btn btn-ghost small" id="seo-cannib-cancel-' + ri + '-' + pi + '">Cancelar</button>' +
        '</div><div class="muted-note" style="margin-top:6px" id="seo-cannib-apply-status-' + ri + '-' + pi + '"></div>' +
        '</div>';
      $('seo-cannib-cancel-' + ri + '-' + pi).addEventListener('click', () => { box.innerHTML = ''; });
      $('seo-cannib-commit-' + ri + '-' + pi).addEventListener('click', () =>
        seoLinkCommit(ri, pi, data.path, data.sha, data.updated, weakUrl, strongUrl, anchor, query));
    } catch (e) {
      btn.disabled = false; btn.textContent = '👁️ Ver cambio antes de aplicar';
      box.innerHTML = '<div class="muted-note" style="margin-top:6px">❌ No se pudo generar el cambio: ' + esc(e.message || String(e)) + '</div>';
    }
  }
  // "✅ Confirmar y deployar": commitea EXACTAMENTE el contenido que ya se mostró en
  // el diff (mode:'commit', sin volver a llamar la IA) — lo que se aprueba es lo que
  // se publica, sin margen para que un segundo call devuelva algo distinto.
  async function seoLinkCommit(ri, pi, path, sha, updated, weakUrl, strongUrl, anchor, query){
    const btn = $('seo-cannib-commit-' + ri + '-' + pi);
    const status = $('seo-cannib-apply-status-' + ri + '-' + pi);
    btn.disabled = true; btn.textContent = '⏳ Deployando…';
    try {
      const { data, error } = await supabase.functions.invoke('apply-link-suggest', {
        body: { mode: 'commit', path, sha, updated, weakUrl, strongUrl, anchor, query },
      });
      if (error || !data || data.error) throw new Error((data && data.error) || (error && error.message) || 'error desconocido');
      btn.remove();
      $('seo-cannib-cancel-' + ri + '-' + pi)?.remove();
      status.innerHTML = '✅ Aplicado y deployado — <a href="' + esc(data.liveUrl) + '" target="_blank" rel="noopener">ver página</a>' +
        (data.commitUrl ? ' · <a href="' + esc(data.commitUrl) + '" target="_blank" rel="noopener">ver commit</a>' : '') +
        '<br><span class="muted-note">Puede tardar 1-2 min en reflejarse (deploy de Cloudflare).</span>';
    } catch (e) {
      btn.disabled = false; btn.textContent = '✅ Confirmar y deployar';
      status.textContent = '❌ No se pudo aplicar: ' + (e.message || String(e));
    }
  }

  // tendencia por keyword: lee la historia diaria guardada en gsc_daily (SQL 0069, la llena
  // gsc-sitemap-submit por cron) para las top keywords del período — sin eso, cero tendencia.
  async function loadSeoTrend(queries){
    const wrap = $('seo-trend-wrap'); if (!wrap) return;
    const topQ = (queries || []).slice(0, 10).map((q) => q.key).filter(Boolean);
    if (!topQ.length){ wrap.innerHTML = '<p class="muted-note">Sin búsquedas en el período.</p>'; return; }
    try {
      const since = new Date(Date.now() - 60 * 864e5).toISOString().slice(0, 10);
      const { data, error } = await supabase.from('gsc_daily').select('date,query,position').in('query', topQ).gte('date', since).order('date', { ascending: true });
      if (error) throw error;
      if (!data || !data.length){ wrap.innerHTML = '<p class="muted-note">Sin historia guardada todavía — arranca sola con el próximo cron diario de <code>gsc-sitemap-submit</code> (¿corriste el SQL 0069?). Necesita al menos 2 días de datos por keyword.</p>'; return; }
      const byQ = new Map();
      data.forEach((r) => { if (!byQ.has(r.query)) byQ.set(r.query, []); byQ.get(r.query).push(r); });
      const rows = [];
      byQ.forEach((pts, q) => {
        if (pts.length < 2) return;
        const mid = Math.max(1, Math.floor(pts.length / 2));
        const older = pts.slice(0, mid), recent = pts.slice(mid).length ? pts.slice(mid) : pts.slice(-1);
        const avg = (arr) => arr.reduce((a, r) => a + (+r.position || 0), 0) / arr.length;
        rows.push({ query: q, posNew: avg(recent), posOld: avg(older), delta: avg(older) - avg(recent), n: pts.length });
      });
      if (!rows.length){ wrap.innerHTML = '<p class="muted-note">Todavía no hay suficiente historia (mín. 2 días) para calcular tendencia.</p>'; return; }
      rows.sort((a, b) => Math.abs(b.delta) - Math.abs(a.delta));
      wrap.innerHTML = '<table class="lead-table"><thead><tr><th>Keyword</th><th class="lt-num">Pos.</th><th></th></tr></thead><tbody>' +
        rows.slice(0, 8).map((r) => {
          const up = r.delta > 0.3, down = r.delta < -0.3;
          const cls = up ? 'up' : down ? 'down' : '';
          const arrow = up ? '▲' : down ? '▼' : '=';
          const warn = down && Math.abs(r.delta) > 3 ? ' ⚠' : '';
          return '<tr><td>' + esc(r.query) + '</td><td class="lt-num">' + r.posNew.toFixed(1) + '</td>' +
            '<td class="' + cls + '">' + arrow + (Math.abs(r.delta) > 0.3 ? ' desde ' + r.posOld.toFixed(1) : '') + warn + '</td></tr>';
        }).join('') + '</tbody></table>';
    } catch (e) {
      wrap.innerHTML = '<p class="muted-note">¿Corriste el SQL 0069 (gsc_daily)? ' + esc(e.message || String(e)) + '</p>';
    }
  }

  // estado de indexación: última corrida de gsc-sitemap-submit (resubmit + spot-check URL Inspection), gsc_status (SQL 0069)
  async function loadSeoIndex(){
    const stEl = $('seo-idx-sitemap'), ckEl = $('seo-idx-urlcheck');
    if (!stEl || !ckEl) return;
    try {
      const { data, error } = await supabase.from('gsc_status').select('*').eq('id', 1).maybeSingle();
      if (error) throw error;
      if (!data){
        const msg = '<p class="muted-note">Sin datos todavía — se completa solo con la próxima corrida del cron diario (¿corriste el SQL 0069?).</p>';
        stEl.innerHTML = msg; ckEl.innerHTML = msg;
        return;
      }
      if (data.last_sitemap_at){
        const results = data.last_sitemap_results || {};
        stEl.innerHTML = Object.entries(results).map(([url, status]) => {
          const ok = status === 200 || status === 204;
          return '<div class="' + (ok ? 'seo-okline' : 'seo-badline') + '">' + (ok ? '✅' : '⚠') + ' ' + esc(String(url).replace(/^https?:\/\/[^/]+\//, '')) + ' — HTTP ' + esc(String(status)) + '</div>';
        }).join('') + '<div class="muted-note" style="margin-top:6px">Último envío: ' + new Date(data.last_sitemap_at).toLocaleString('es-CH') + '</div>';
      } else stEl.innerHTML = '<p class="muted-note">Todavía sin corridas.</p>';
      if (data.last_urlcheck_at && Array.isArray(data.last_urlcheck_results)){
        ckEl.innerHTML = data.last_urlcheck_results.map((c) => {
          const ok = c.verdict === 'PASS';
          return '<div class="' + (ok ? 'seo-okline' : 'seo-warnline') + '">' + (ok ? '✅' : '⏳') + ' ' + esc(c.url) + ' — ' + esc(c.verdict) + (c.coverageState ? ' (' + esc(c.coverageState) + ')' : '') + '</div>';
        }).join('') + '<div class="muted-note" style="margin-top:6px">Último spot-check: ' + new Date(data.last_urlcheck_at).toLocaleString('es-CH') + '</div>';
      } else ckEl.innerHTML = '<p class="muted-note">Sin spot-check todavía.</p>';
    } catch (e) {
      const msg = '<p class="muted-note">¿Corriste el SQL 0069 (gsc_status)? ' + esc(e.message || String(e)) + '</p>';
      stEl.innerHTML = msg; ckEl.innerHTML = msg;
    }
  }

  /* ---- 🩺 Salud del sitio (SQL 0117 + función site-health-check): última
     corrida del chequeo semanal de que el sitemap propio no apunte a ninguna
     URL rota — la causa raíz de la mayoría de los 404 reales del audit del
     2026-07-26. Panel independiente de gsc-stats: se carga igual aunque
     Search Console falle (mismo trato best-effort que loadSeoIndex). ---- */
  let shData = null;
  function shRender(){
    const body = $('sh-body'); if (!body) return;
    if (!shData){ body.innerHTML = '<p class="muted-note">Sin corridas todavía — tocá «🔄 Revisar ahora» o esperá al cron del lunes.</p>'; return; }
    const when = new Date(shData.created_at).toLocaleString('es-CH');
    const broken = shData.broken || [];
    const redirects = shData.redirects || [];
    let html = '<div class="muted-note" style="margin-bottom:8px">Última corrida: ' + esc(when) + '</div>' +
      '<div style="font-size:14px;margin-bottom:10px"><b>' + (shData.total || 0) + '</b> URLs totales · <b style="' + (broken.length ? 'color:#ff8b8b' : '') + '">' + (shData.broken_count || 0) + ' rotas</b> · ' + (shData.redirect_count || 0) + ' redirigiendo</div>';
    if (!shData.broken_count) {
      html += '<div class="seo-okline">✅ Todo el sitemap responde 200.</div>';
    } else {
      html += '<details><summary style="cursor:pointer;font-weight:600;font-size:13.5px">Ver ' + broken.length + ' URL' + (broken.length === 1 ? '' : 's') + ' rota' + (broken.length === 1 ? '' : 's') + '</summary><div style="margin-top:8px">' +
        broken.map((b) => '<div class="seo-badline">⚠ <a href="' + esc(b.url) + '" target="_blank" rel="noopener">' + esc(b.url) + '</a> — HTTP ' + esc(String(b.status || 'sin respuesta')) + '</div>').join('') +
        '</div></details>';
    }
    if (redirects.length) {
      html += '<details style="margin-top:8px"><summary style="cursor:pointer;font-weight:600;font-size:13.5px">Ver ' + redirects.length + ' redirigiendo</summary><div style="margin-top:8px">' +
        redirects.map((r) => '<div class="seo-warnline">⏳ <a href="' + esc(r.url) + '" target="_blank" rel="noopener">' + esc(r.url) + '</a> — HTTP ' + esc(String(r.status)) + (r.location ? ' → ' + esc(r.location) : '') + '</div>').join('') +
        '</div></details>';
    }
    body.innerHTML = html;
  }
  async function loadSiteHealth(){
    const body = $('sh-body'); if (!body) return;
    try {
      const { data, error } = await supabase.from('site_health_runs').select('*').order('created_at', { ascending: false }).limit(1).maybeSingle();
      if (error) throw error;
      shData = data;
      shRender();
    } catch (e) {
      body.innerHTML = '<p class="muted-note">¿Corriste la migración 0117 (site_health_runs)? ' + esc(e.message || String(e)) + '</p>';
    }
  }
  async function shRun(){
    const btn = $('sh-run'); if (!btn || btn.disabled) return;
    btn.disabled = true; btn.textContent = '⏳ Revisando…';
    try {
      const { data, error } = await supabase.functions.invoke('site-health-check', { body: {} });
      if (error) throw error;
      if (data && data.error) throw new Error(data.error);
      await loadSiteHealth();
    } catch (e) {
      alert('No se pudo revisar: ' + (e.message || e));
    } finally {
      btn.disabled = false; btn.textContent = '🔄 Revisar ahora';
    }
  }
  (function(){ const b = $('sh-run'); if (b) b.addEventListener('click', shRun); })();

  // delta de posición: BAJAR es mejorar (al revés que clicks/impresiones) — verde cuando mejora
  function seoPosDelta(cur, prev){
    const el = $('seo-k-pos-d'); if (!el) return;
    if (!prev && !cur){ el.textContent = '='; el.className = 'kdelta flat'; return; }
    if (!prev){ el.textContent = '▲ nuevo'; el.className = 'kdelta up'; return; }
    const diff = prev - cur;
    if (Math.abs(diff) < 0.15){ el.textContent = '='; el.className = 'kdelta flat'; return; }
    el.textContent = (diff > 0 ? '▲ mejoró ' : '▼ empeoró ') + Math.abs(diff).toFixed(1);
    el.className = 'kdelta ' + (diff > 0 ? 'up' : 'down');
  }

  function seoRenderKpis(data){
    const t = data.totals || {}, pt = data.prevTotals || {};
    const fmtN = (n) => (n || 0).toLocaleString('de-CH');
    $('seo-k-clicks').textContent = fmtN(t.clicks);
    $('seo-k-impr').textContent = fmtN(t.impressions);
    $('seo-k-ctr').textContent = ((t.ctr || 0) * 100).toFixed(1) + '%';
    $('seo-k-pos').textContent = (t.position || 0).toFixed(1);
    setDelta('seo-k-clicks-d', t.clicks, pt.clicks);
    setDelta('seo-k-impr-d', t.impressions, pt.impressions);
    setDelta('seo-k-ctr-d', t.ctr, pt.ctr);
    seoPosDelta(t.position || 0, pt.position || 0);
    const dClicks = pt.clicks ? ((t.clicks - pt.clicks) / pt.clicks * 100) : null;
    const verdict = $('seo-verdict');
    if (verdict) {
      verdict.innerHTML = '📈 <b>SEO en los últimos ' + (data.days || '') + ' días:</b> clicks ' +
        (dClicks == null ? 'sin período anterior para comparar' : ((dClicks >= 0 ? '+' : '') + dClicks.toFixed(0) + '% vs el período anterior')) +
        ' · ' + (data.queries || []).length + ' búsquedas distintas' +
        (data.cannibalization && data.cannibalization.length ? ' · ⚠ ' + data.cannibalization.length + ' casos de canibalización (ver abajo)' : '');
    }
  }

  async function loadSeo(){
