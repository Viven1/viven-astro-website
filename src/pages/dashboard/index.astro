      '<div class="lm2-who"><div class="nm">' + esc(r.name || (String(r.message || '') === 'Newsletter signup' && r.email) || '(sin nombre)') + (String(r.message || '') === 'Newsletter signup' ? ' <span class="lt-nl">📰 Newsletter</span>' : '') + '<span class="lm-score" id="lm2-score"></span></div>' +
      '<div class="sub">' + esc([r.job_title, company, r.email].filter(Boolean).join(' · ')) + '</div>' +
