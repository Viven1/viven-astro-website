    document.querySelectorAll('.au-cfg-stage').forEach((e) => e.style.display = t === 'stage' ? '' : 'none');
    document.querySelectorAll('.au-cfg-days').forEach((e) => e.style.display = t === 'inactivity' ? '' : 'none');
