      (ofCur.closing_text ? '<label class="ofc-l">Cierre (③ — va al final del email y del PDF)</label><div class="muted-note" style="font-size:12.5px;white-space:pre-wrap;border:1px solid var(--line);border-radius:9px;padding:8px 10px">' + esc(ofCur.closing_text) + '</div>' : '') +
