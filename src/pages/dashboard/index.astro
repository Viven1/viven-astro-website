        // la hora exacta SIEMPRE, y el "en ~N min" solo como ayuda cuando falta poco:
        // "en ~7 min" solo no dice a qué hora, y es lo que se pidió ver
        const whenTxt = !when ? 'en la próxima corrida'
          : mins <= 0 ? 'saliendo…'
          : obFechaHora(when) + (mins < 60 ? ' (en ~' + mins + ' min)' : '');
        return '<div style="display:flex;align-items:center;gap:10px;padding:4px 0;font-size:13px">' +
          '<span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(o.subject || '(sin asunto)') + ' → <b>' + esc(l.email || 'lead #' + o.lead_id) + '</b></span>' +
          '<span class="muted-note" style="flex:none">sale ' + esc(whenTxt) + '</span>' +
          '<button class="btn btn-ghost small" data-obundo="' + esc(String(o.id)) + '" type="button" style="flex:none">↩︎ Deshacer</button></div>';
      }).join('') + '</div>';
  }
