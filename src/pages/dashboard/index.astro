          '<span class="est">' + (c.resolved ? '✓ resuelto' : '● sin resolver') + '</span></div>' +
          '<p>' + esc(c.body) + '</p>' +
          '<div class="pj-com-acc">' +
            '<button class="btn btn-ghost small" data-cres="' + c.id + '">' + (c.resolved ? '↩︎ Reabrir' : '✓ Resuelto') + '</button>' +
            (c.task_id ? '<span class="muted-note" style="font-size:11.5px">ya es tarea</span>'
                       : '<button class="btn btn-ghost small" data-ctask="' + c.id + '">📋 Pasar a tarea</button>') +
          '</div></div>';
      }).join('');

    $('pj-files').innerHTML = !pjFiles.length ? '' :
      '<div class="pj-sec-h">Archivos para el cliente</div>' +
      pjFiles.map((f) => '<div class="pj-bill" data-f="' + f.id + '" style="display:flex;align-items:center;gap:11px">' +
        '<span style="flex:1;min-width:0;overflow-wrap:anywhere">' + esc(f.file_name) +
        '<small style="display:block;color:var(--muted-2);font-size:11.5px">' +
        (f.size_bytes ? Math.round(f.size_bytes / 1048576) + ' MB · ' : '') +
        (f.visible_cliente ? 'lo ve el cliente' : 'oculto') + '</small></span>' +
        '<button class="btn btn-ghost small" data-fvis="' + f.id + '">' + (f.visible_cliente ? '🙈 Ocultar' : '👁 Mostrar') + '</button>' +
        '<button class="pj-crew-x" data-fdel="' + f.id + '" type="button">✕</button></div>').join('');

    $('pj-vers').querySelectorAll('[data-edl]').forEach((b) => b.addEventListener('click', () => pjExportNotas(b.dataset.edl)));
    $('pj-vers').querySelectorAll('[data-noted]').forEach((b) => b.addEventListener('click', () => pjNotasAlEditor(b.dataset.noted)));
    $('pj-vers').querySelectorAll('[data-vdel]').forEach((b) => b.addEventListener('click', () => pjVerBorrar(b.dataset.vdel)));
    $('pj-vers').querySelectorAll('[data-vunapr]').forEach((b) => b.addEventListener('click', () => pjVerDesaprobar(b.dataset.vunapr)));
    $('pj-coms').querySelectorAll('[data-cres]').forEach((b) => b.addEventListener('click', () => pjComResolver(b.dataset.cres)));
    $('pj-coms').querySelectorAll('[data-ctask]').forEach((b) => b.addEventListener('click', () => pjComATarea(b.dataset.ctask)));
    $('pj-files').querySelectorAll('[data-fvis]').forEach((b) => b.addEventListener('click', () => pjFileVis(b.dataset.fvis)));
    $('pj-files').querySelectorAll('[data-fdel]').forEach((b) => b.addEventListener('click', () => pjFileBorrar(b.dataset.fdel)));
  }

  async function pjVerAdd(){
    const p = pjCur; if (!p) return;
    const url = prompt('Link del video (Vimeo o YouTube):\n\nEl video se queda donde ya vive — acá solo guardamos el link.');
    if (url === null) return;
    const titulo = prompt('¿Qué es esta versión? (p. ej. "Rohschnitt mit Farbe")') || '';
    const n = (pjVers[0] ? pjVers[0].n : 0) + 1;
    const { data, error } = await supabase.from('project_versions').insert({
      project_id: p.id, n, title: titulo.trim() || null, video_url: url.trim() || null, created_by: meEmail || null,
    }).select().single();
    if (error){ toast(error.message); return; }
    pjVers.unshift(data);
    toast('🎞 v' + n + ' subida — el cliente ya la ve en su portal');
    pjPortalRender();
  }
  /* Aprobar es una decisión, no un botón sin vuelta: si el cliente —o yo— toca por error,
     esto la devuelve a "esperando" y limpia la fecha. No borra nada más.
     (Sebastián, 26 ago 2026: "tengo que poder deshacer ese cambio tmb… por si fue un error.") */
  async function pjVerDesaprobar(id){
    const v = pjVers.find((x) => String(x.id) === String(id)); if (!v) return;
    if (!confirm('¿Sacarle la aprobación a la v' + v.n + '?\n\nVuelve a quedar esperando. Los comentarios no se tocan.')) return;
    const { error } = await supabase.from('project_versions')
      .update({ approved_at: null, approved_by: null }).eq('id', id);
    if (error){ toast(error.message); return; }
    v.approved_at = null; v.approved_by = null;
    pjPortalRender();
    toast('↩︎ v' + v.n + ' vuelve a esperando');
  }
  async function pjVerBorrar(id){
    const v = pjVers.find((x) => String(x.id) === String(id)); if (!v) return;
    if (!confirm('¿Borrar la v' + v.n + '?\n\nSe borran también sus comentarios.')) return;
    const { error } = await supabase.from('project_versions').delete().eq('id', id);
    if (error){ toast(error.message); return; }
    pjVers = pjVers.filter((x) => String(x.id) !== String(id));
    pjComs = pjComs.filter((c) => String(c.version_id) !== String(id));
    pjPortalRender();
  }
  async function pjComResolver(id){
    const c = pjComs.find((x) => String(x.id) === String(id)); if (!c) return;
    const nuevo = !c.resolved;
    const { error } = await supabase.from('project_comments')
      .update({ resolved: nuevo, resolved_at: nuevo ? new Date().toISOString() : null }).eq('id', id);
    if (error){ toast(error.message); return; }
    c.resolved = nuevo;
    pjPortalRender();
  }
  /* Un comentario que hay que arreglar tiene que vivir donde vive el resto del trabajo,
     no solo en el portal. */
  async function pjComATarea(id){
    const c = pjComs.find((x) => String(x.id) === String(id)); if (!c) return;
    const p = pjCur;
    if (!p.lead_id){ toast('El proyecto no tiene contacto — la tarea necesita uno'); return; }
    const { data, error } = await supabase.from('lead_tasks').insert({
      lead_id: String(p.lead_id),
      title: '🎬 ' + (c.tc_ms != null ? '[' + pjMMSS(c.tc_ms) + '] ' : '') + c.body.slice(0, 140),
      due_date: new Date().toISOString().slice(0, 10), done: false,
    }).select().single();
    if (error){ toast(error.message); return; }
    await supabase.from('project_comments').update({ task_id: data.id }).eq('id', id);
    c.task_id = data.id;
    toast('📋 Es una tarea del contacto');
    pjPortalRender();
  }
  async function pjFileVis(id){
    const f = pjFiles.find((x) => String(x.id) === String(id)); if (!f) return;
    const { error } = await supabase.from('project_files').update({ visible_cliente: !f.visible_cliente }).eq('id', id);
    if (error){ toast(error.message); return; }
    f.visible_cliente = !f.visible_cliente;
    pjPortalRender();
  }
  async function pjFileBorrar(id){
    const f = pjFiles.find((x) => String(x.id) === String(id)); if (!f) return;
    if (!confirm('¿Borrar "' + f.file_name + '"?')) return;
    await supabase.storage.from('project-files').remove([f.file_path]);
    await supabase.from('project_files').delete().eq('id', id);
    pjFiles = pjFiles.filter((x) => String(x.id) !== String(id));
    pjPortalRender();
  }
  async function pjFileSubir(files){
    const p = pjCur; if (!p || !files.length) return;
    for (const file of files){
      const limpio = file.name.replace(/[^\w.\-]+/g, '_').slice(-90);
      const path = 'p' + p.id + '/' + Date.now() + '_' + limpio;
      toast('⬆ ' + file.name);
      const { error } = await supabase.storage.from('project-files').upload(path, file, { contentType: file.type || undefined });
      if (error){ toast(error.message); continue; }
      const { data, error: e2 } = await supabase.from('project_files').insert({
        project_id: p.id, file_path: path, file_name: file.name, mime: file.type || null,
        size_bytes: file.size, subido_por: meEmail || null,
      }).select().single();
      if (e2){ toast(e2.message); continue; }
      pjFiles.unshift(data);
      pjPortalRender();
    }
    toast('📎 Listo — el cliente los baja con su código');
  }

  /* ===== LAS NOTAS, PARA PREMIERE =====
     Se bajan DOS archivos porque hacen cosas distintas:
     · el .xml (FCP7) es el que de verdad deja los comentarios como MARCADORES en el
       timeline — se importa en Premiere y cada nota queda en su segundo;
     · el .edl es el formato que pidió Sebastián por nombre y el que entiende cualquier
       otra sala de edición, aunque los comentarios ahí son texto del evento.
     El timecode se arma a 25 fps, que es el estándar de acá. */
  const PJ_FPS = 25;
  function pjTC(ms){
    const t = Math.max(0, Math.round((ms || 0) / 1000 * PJ_FPS));
    const f = t % PJ_FPS, s = Math.floor(t / PJ_FPS) % 60, m = Math.floor(t / (PJ_FPS * 60)) % 60, h = Math.floor(t / (PJ_FPS * 3600));
    const dd = (n) => String(n).padStart(2, '0');
    return dd(h) + ':' + dd(m) + ':' + dd(s) + ':' + dd(f);
  }
  function pjBajar(nombre, texto, mime){
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([texto], { type: mime }));
    a.download = nombre;
    document.body.appendChild(a); a.click();
    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
  }
  /* Arma el .edl y el .xml y los DEVUELVE. Antes bajaba los archivos y listo; ahora el
     mismo generador —el único probado— sirve para el botón de descargar y para el email
     al montajista. Dos generadores del mismo XML serían dos formatos distintos a la
     tercera corrección. */
  function pjNotasArchivos(versionId){
    const v = pjVers.find((x) => String(x.id) === String(versionId)); if (!v) return null;
    const notas = pjComs.filter((c) => String(c.version_id) === String(v.id) && c.tc_ms != null)
      .sort((a, b) => a.tc_ms - b.tc_ms);
    /* Sin notas con minuto NO se corta: el email al editor tiene sentido igual, solo va
       sin .xml ni .edl. Antes devolvía null y el modal no se abría — un botón que no hace
       nada y no dice por qué. */
    if (!notas.length){
      return { v, notas: [], xml: null, edl: null, base: ((pjCur.title || 'proyecto') + '_v' + v.n).replace(/[^\w.\-]+/g, '_') };
    }
    const base = ((pjCur.title || 'proyecto') + '_v' + v.n).replace(/[^\w.\-]+/g, '_');
    const limpiar = (s2) => String(s2 || '').replace(/[\r\n]+/g, ' ').trim();

    // --- EDL (CMX3600): una nota por evento, con su comentario ---
    let edl = 'TITLE: ' + (pjCur.title || 'Proyecto') + ' v' + v.n + '\nFCM: NON-DROP FRAME\n\n';
    notas.forEach((c, i) => {
      const ini = pjTC(c.tc_ms), fin = pjTC(c.tc_ms + 1000);
      edl += String(i + 1).padStart(3, '0') + '  AX       V     C        ' +
        ini + ' ' + fin + ' ' + ini + ' ' + fin + '\n' +
        '* FROM CLIP NAME: ' + limpiar(c.author_name || 'Cliente') + '\n' +
        '* COMMENT: ' + limpiar(c.body).slice(0, 200) + '\n\n';
    });


    // --- XML de Premiere (FCP7) con los comentarios como marcadores ---
    const esc2 = (s2) => String(s2 || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const dur = Math.max(...notas.map((c) => c.tc_ms)) / 1000 * PJ_FPS + PJ_FPS * 10;
    const xml = '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE xmeml>\n<xmeml version="4">\n' +
      '  <sequence>\n    <name>' + esc2((pjCur.title || 'Proyecto') + ' v' + v.n + ' — notas') + '</name>\n' +
      '    <duration>' + Math.round(dur) + '</duration>\n' +
      '    <rate><timebase>' + PJ_FPS + '</timebase><ntsc>FALSE</ntsc></rate>\n' +
      '    <media><video><format><samplecharacteristics><rate><timebase>' + PJ_FPS + '</timebase></rate>' +
      '<width>1920</width><height>1080</height></samplecharacteristics></format></video></media>\n' +
      notas.map((c) => {
        const fr = Math.round(c.tc_ms / 1000 * PJ_FPS);
        return '    <marker>\n      <name>' + esc2(limpiar(c.body).slice(0, 80)) + '</name>\n' +
          '      <comment>' + esc2(limpiar(c.author_name || 'Cliente') + ': ' + limpiar(c.body)) + '</comment>\n' +
          '      <in>' + fr + '</in>\n      <out>-1</out>\n    </marker>';
      }).join('\n') + '\n  </sequence>\n</xmeml>\n';
    return { v, base, notas, edl, xml };
  }

  function pjExportNotas(versionId){
    const r = pjNotasArchivos(versionId); if (!r) return;
    pjBajar(r.base + '_notas.edl', r.edl, 'text/plain');
    pjBajar(r.base + '_notas.xml', r.xml, 'application/xml');
    toast('📥 ' + r.notas.length + ' notas · el .xml deja los marcadores en el timeline, el .edl es el estándar');
  }

  /* ═══ Mandarle las notas al que monta ═══
     Primero se ve, después se manda — como todo lo que sale de acá. La ventana muestra
     el email exacto con las notas ya listadas, y el botón de enviar está adentro.
     (Sebastián, 26 ago 2026: "un botón para nosotros enviar al editor. Le envía el xml
     más todos los comentarios con timestamps para que lo vea en el email".) */
  /* ═══ Notas al editor: modal propio, editable ═══
     Estaba en un window.open y salía en blanco —con `noopener` la referencia a la ventana
     viene nula— y aunque hubiera abierto, ahí no se podía tocar nada. Ahora vive adentro
     del dashboard: se ve el email exacto, se cambia el destinatario, el asunto y se puede
     agregar un mensaje propio, con el .xml a la vista.
     (Sebastián, 26 ago 2026: "que salga directo desde el dashboard con un popup propio
     donde me muestre qué se le envía y le pueda hacer cambios, agregar cosas, etc.") */
  let nedCuerpo = null;

  async function pjNotasAlEditor(versionId){
    const p = pjCur; if (!p) return;
    const mail = ($('pj-editor-email').value || '').trim().toLowerCase();
    const r = pjNotasArchivos(versionId); if (!r) return;
    const lista = r.notas.map((c) => ({ tc: pjTC(c.tc_ms).slice(0, 8), autor: c.author_name || 'Cliente', texto: String(c.body || '') }));

    nedCuerpo = { project_id: p.id, to: mail, version: r.v.n, notas: lista,
                  xml: r.xml, edl: r.edl, portal_url: null,
                  video_url: r.v.video_url || p.deliverable_url || null };

    /* El modal se abre YA. Antes esperaba dos llamadas al servidor —el pase del montajista
       y la vista previa— y hasta que volvían no pasaba nada en pantalla: cuatro segundos
       mirando un botón. El pase se pide en paralelo y la preview se rehace cuando llega.
       (Sebastián, 26 ago 2026: "tocar al editor tarda como 4 segundos en cargar".) */
    $('ned-modal').hidden = false;
    $('ned-sub').textContent = (p.ref ? p.ref + ' · ' : '') + (p.title || '') + ' · v' + r.v.n + ' · ' + lista.length + ' notas';
    $('ned-to').value = mail;
    /* Arranca con el remitente que ya venías usando en el dashboard: es casi siempre el
       mismo, y elegirlo de nuevo cada vez es una decisión que no aporta nada. */
    const deSel = $('ned-de');
    if (!deSel.options.length){
      deSel.innerHTML = Object.keys(SENDERS).map((k) =>
        '<option value="' + k + '">' + esc(SENDERS[k].name) + ' — ' + esc(SENDERS[k].email) + '</option>').join('');
    }
    deSel.value = (localStorage.getItem('viven_ned_de') || sender || 'sofia');
    if (!deSel.value) deSel.value = Object.keys(SENDERS)[0];
    $('ned-msg').value = '';
    $('ned-adj').innerHTML =
      '<p class="muted-note" style="margin:8px 0 4px">Van dos archivos con el número del proyecto en el nombre. El <b>.xml</b> deja cada nota como marcador en el timeline de Premiere; el <b>.edl</b> es la red por si su programa no lee el xml.</p>' +
      '<pre>' + esc(r.xml.slice(0, 1400)) + (r.xml.length > 1400 ? '\n… (' + r.xml.length + ' caracteres en total)' : '') + '</pre>';
    nedPreview();

    /* Un pase propio para el montajista, de 30 días. Los minutos del email tienen que
       abrir el corte, y el corte está privado en Vimeo: solo reproduce embebido en
       viven.ch. Así que llevan al portal, no a vimeo.com.
       Va aparte y sin bloquear: si tarda o falla, el modal ya está abierto y los minutos
       caen al link de Vimeo. */
    const d = pjDealYa(p);
    if (d && d.portal_token && mail){
      supabase.functions.invoke('get-portal', {
        body: { id: d.id, t: d.portal_token, accion: 'pase_editor', email: mail } })
        .then(({ data: pe }) => {
          if (!pe || !pe.pase || !nedCuerpo) return;
          nedCuerpo.portal_url = location.origin + '/portal/?id=' + encodeURIComponent(d.id) +
            '&t=' + encodeURIComponent(d.portal_token) + '&pase=' + encodeURIComponent(pe.pase) +
            '&ver=' + encodeURIComponent(r.v.id);
          nedPreview();   // la preview se rehace con los minutos ya enlazados
        })
        .catch(() => {});
    }
  }

  /* La vista previa se pide al servidor —el mismo código que arma el email de verdad—
     así lo que ves es lo que sale, y no una copia que se desactualiza. */
  let nedT = null;
  function nedPreview(){
    clearTimeout(nedT);
    nedT = setTimeout(async () => {
      if (!nedCuerpo) return;
      const prev = $('ned-prev');
      if (!prev.querySelector('table, div')) prev.innerHTML = '<p style="color:#8a94a8;margin:0">Armando el email…</p>';
      try {
        const { data, error } = await supabase.functions.invoke('notas-al-editor', {
          body: { ...nedCuerpo, to: $('ned-to').value.trim() || nedCuerpo.to,
                  de: $('ned-de').value,
                  asunto_manual: $('ned-asunto').value.trim() || undefined,
                  mensaje: $('ned-msg').value, dry_run: true } });
        if (error) throw new Error(error.message);
        if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
        if (!$('ned-asunto').value.trim()) $('ned-asunto').value = data.asunto;
        prev.innerHTML = data.html;
        $('ned-msgout').textContent = data.responde_a
          ? 'Si contesta, le llega a ' + data.responde_a + '. Nada sale hasta que toques Enviar.'
          : 'Nada sale hasta que toques Enviar.';
      } catch (e){
        prev.innerHTML = '<p style="color:#b00;margin:0">⚠️ ' + esc(e.message || String(e)) + '</p>';
      }
    }, nedT === null ? 0 : 350);
  }

  (function nedBind(){
    const cerrar = () => { $('ned-modal').hidden = true; nedCuerpo = null; clearTimeout(nedT); nedT = null; };
    document.addEventListener('click', (e) => {
      if (e.target && (e.target.id === 'ned-x' || e.target.id === 'ned-back' || e.target.id === 'ned-modal')) cerrar();
    });
    document.addEventListener('keydown', (e) => {
      const m = $('ned-modal');
      if (e.key === 'Escape' && m && !m.hidden && !/TEXTAREA|INPUT/.test((e.target || {}).tagName || '')) cerrar();
    });
    document.addEventListener('input', (e) => {
      if (e.target && ['ned-to', 'ned-asunto', 'ned-msg'].includes(e.target.id)) nedPreview();
    });
    document.addEventListener('change', (e) => {
      if (e.target && e.target.id === 'ned-de'){
        localStorage.setItem('viven_ned_de', e.target.value);
        nedPreview();
      }
    });
    document.addEventListener('click', async (e) => {
      if (!e.target || e.target.id !== 'ned-go' || !nedCuerpo) return;
      const b = e.target, out = $('ned-msgout');
      const to = $('ned-to').value.trim().toLowerCase();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(to)){ out.textContent = '⚠️ Falta un email válido'; return; }
      b.disabled = true; out.textContent = 'Enviando…';
      try {
        const { data, error } = await supabase.functions.invoke('notas-al-editor', {
          body: { ...nedCuerpo, to, de: $('ned-de').value,
                  asunto_manual: $('ned-asunto').value.trim() || undefined, mensaje: $('ned-msg').value } });
        if (error) throw new Error(error.message);
        if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
        out.textContent = '✅ Enviado con ' + data.adjuntos + ' adjuntos';
        toast('📤 ' + data.notas + ' notas enviadas a ' + data.para);
        setTimeout(cerrar, 900);
      } catch (e2){ out.textContent = '⚠️ ' + (e2.message || e2); }
      finally { b.disabled = false; }
    });
  })();


  /* ---------- FACTURAS DEL CREW (SQL 0156) ----------
     "Ideal sería poder subir facturas de la crew al dashboard para enviar a bexio y
     saber el margen real de cada proyecto" (Sebastián, 26 ago 2026).
     Subís el PDF o la foto → la IA lee proveedor, número, fecha e importes → se ata a
     una línea de costo (ahí el margen deja de ser una estimación) → y se manda a bexio
     como factura de proveedor, siempre en borrador. */
  let pjBills = [];
  const PJ_BILL_EST = {
    nueva: ['📥 Subida', 'var(--muted)'], leida: ['🤖 Leída', '#8ab4ff'],
    revisada: ['✅ Revisada', '#7ed957'], en_bexio: ['🧾 En bexio', 'var(--acid)'],
    descartada: ['✕ Descartada', 'var(--muted-2)'],
  };

  async function pjBillsLoad(){
    const p = pjCur; if (!p) return;
    const { data, error } = await supabase.from('project_bills').select('*')
      .eq('project_id', p.id).neq('estado', 'descartada').order('created_at', { ascending: false });
    pjBills = error ? [] : (data || []);
    pjBillsRender();
  }

  function pjBillsRender(){
    const box = $('pj-bills'), res = $('pj-bills-resumen'); if (!box) return;
    /* Cuánto del costo tiene papel atrás. Es la diferencia entre "margen" y "margen
       real", y sin decirlo la palabra "real" no significa nada. */
    const conFactura = new Set(pjBills.filter((b) => b.cost_id).map((b) => String(b.cost_id)));
    const costoTotal = pjCostos.reduce((a, c) => a + pjCostoTotal(c), 0);
    const costoResp = pjCostos.filter((c) => conFactura.has(String(c.id))).reduce((a, c) => a + pjCostoTotal(c), 0);
    const pct = costoTotal ? Math.round(costoResp / costoTotal * 100) : 0;
    res.innerHTML = !pjBills.length
      ? '<p class="muted-note" style="margin:0 0 12px">Todavía no subiste ninguna. Cuando cada costo tenga su factura atrás, el margen deja de ser una estimación.</p>'
      : '<p class="muted-note" style="margin:0 0 12px">' + pjBills.length +
        (pjBills.length === 1 ? ' factura' : ' facturas') + ' · respaldan <b>' + pjCHF(costoResp) + '</b> de ' +
        pjCHF(costoTotal) + ' de costo' + (pct < 100 ? ' <span style="color:#f0c060">(' + pct + '%)</span>' : ' — todo respaldado') + '</p>';

    if (!pjBills.length){ box.innerHTML = ''; return; }
    box.innerHTML = pjBills.map((b) => {
      const [lbl, col] = PJ_BILL_EST[b.estado] || PJ_BILL_EST.nueva;
      const dudas = (b.extracted && b.extracted.dudas) || [];
      const baja = b.extracted && b.extracted.confianza === 'baja';
      const costo = pjCostos.find((c) => String(c.id) === String(b.cost_id));
      return '<div class="pj-bill" data-b="' + b.id + '">' +
        '<div class="pj-bill-hd">' +
