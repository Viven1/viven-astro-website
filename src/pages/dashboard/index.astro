      const upd = row && row.kind === 'content_followup' ? { status: 'pending' } : { status: 'pending', scheduled_at: null };
      const { error: e2 } = await supabase.from('outbox').update(upd).eq('id', b.dataset.obundo).eq('status', 'approved');
      if (e2){ toast('⚠️ ' + e2.message); return; }
