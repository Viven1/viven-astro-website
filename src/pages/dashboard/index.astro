    auSteps = { a: (a && a.steps_a) ? JSON.parse(JSON.stringify(a.steps_a)) : [], b: (a && a.steps_b) ? JSON.parse(JSON.stringify(a.steps_b)) : [] };
    auOpenIdx = null;
    $('au-dup').hidden = !a; $('au-del').hidden = !a;
