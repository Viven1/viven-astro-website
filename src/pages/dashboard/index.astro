  /* Quién aparece hoy en la página pública, y si vos sos uno de ellos. */
  async function bkQuienRender(mio){
    const box = $('bk-quien'); if (!box) return;
    const { data, error } = await supabase.from('team_profiles').select('email,name,book_visible');
    if (error || !data){ box.hidden = true; return; }
    const visibles = data.filter((p) => p.book_visible);
    const yoVisible = visibles.some((p) => (p.email || '').toLowerCase() === String(meEmail || '').toLowerCase());
    const yoActivo = mio && mio.active !== false;
    const quienes = visibles.length
      ? visibles.map((p) => p.name || p.email).join(' y ')
      : 'nadie';
    let txt = 'Hoy en <b>/book/</b> aparece ' + esc(quienes) + '.';
    if (!yoVisible){
      txt += ' <span class="cf-falta">Vos no</span> — lo que configures acá abajo no cambia lo que ve un cliente hasta que te agreguen a la página pública.';
    } else if (!yoActivo){
      txt += ' <span class="cf-falta">Tu booking está apagado</span>, así que quien entre a tu agenda ve el link de respaldo.';
    } else {
      txt += ' Tu agenda está encendida.';
    }
