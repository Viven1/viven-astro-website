  /* Los opcionales NO entran en el neto. Es lo que los hace opcionales: el cliente ve el
     precio y decide, y mientras no decida el total no los incluye. Si sumaran, el pipeline
     contaría plata que nadie aceptó.
     (Sebastián, 27 ago 2026: "en la oferta — add ons/optional items".) */
  const esOpt = (it) => !!(it && it.opcional);
  const offerNet = (o) => (o.items || []).filter((it) => !esOpt(it)).reduce((a, it) => a + (Number(it.qty) || 0) * (Number(it.price) || 0), 0) * (1 - (Number(o && o.discount_pct) || 0) / 100);
  const offerCost = (o) => (o.items || []).filter((it) => !esOpt(it)).reduce((a, it) => a + (Number(it.qty) || 0) * (Number(it.cost) || 0), 0);
  const offerMarginPct = (o) => { const n = offerNet(o); return n ? (n - offerCost(o)) / n * 100 : NaN; };

