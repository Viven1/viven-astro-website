    $('nwi-list').innerHTML = nwiList.map((n) => {
      const badge = n.status === 'sent' ? '<span class="of-badge" style="color:var(--won);border-color:currentColor">✅ ' + (n.sent_count || 0) + ' enviados</span>'
        : n.status === 'discarded' ? '<span class="of-badge" style="color:#8a93a6;border-color:currentColor">Descartada</span>'
        : '<span class="of-badge" style="color:#f0c060;border-color:currentColor">⏳ Esperando aprobación</span>';
