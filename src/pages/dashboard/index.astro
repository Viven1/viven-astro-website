  /* ---------- 🎯 Ritmo del mes: metas vs realidad (SQL 0108 business_goals) ----------
     Pesos del pipeline ponderado = dealProb() — la MISMA función que usan el KPI
     "Ponderado" y el board. "Propuesta enviada" ya no es fija: baja con los días sin
     respuesta. Inventar otros acá haría que el panel contradiga al resto de la pantalla.
     La edge function daily-digest replica esa curva (probDeal, con comentario). */
  let rmGoal = null, rmGoalFetched = false, rmGoalBusy = false;
  async function rmFetchGoal(){
    if (rmGoalBusy || rmGoalFetched) return;
    rmGoalBusy = true;
    try {
      const { data, error } = await supabase.from('business_goals').select('monthly_target').eq('id', 1).maybeSingle();
      if (!error){ rmGoal = data ? +data.monthly_target || 0 : 0; rmGoalFetched = true; rmRender(); }
    } catch (e) { /* tabla pendiente (SQL 0108 sin correr) → el panel muestra el aviso de definir objetivo */ }
    finally { rmGoalBusy = false; }
  }
  function rmRender(){
    if (!$('rm-panel')) return;
    const now = new Date(), D = 864e5;
    $('rm-month').textContent = '(' + now.toLocaleDateString('es-CH', { month: 'long', year: 'numeric' }) + ')';
    const m0 = new Date(now.getFullYear(), now.getMonth(), 1).getTime();
    const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
    const dayOfMonth = now.getDate();
    const all = (dealsList || []).filter((d) => !d.archived);
    // cerrado este mes: ganados con won_at (fallback last_stage_at) dentro del mes en curso
    const wonMonth = all.filter((d) => stageOf(d.stage) === 'ganado' && Date.parse(d.won_at || d.last_stage_at || '') >= m0);
    const closed = dealsValue(wonMonth);
    /* Contra el MES ANTERIOR completo, no contra "los 30 días de antes": Sebastián
       cobra del 1 al último día, así que la comparación tiene que ser mes contra mes.
       A esta altura del mes se compara contra el mes entero, que es lo que hay que
       igualar — por eso el texto dice "cerró" y no "vamos igual". */
    const mPrev0 = new Date(now.getFullYear(), now.getMonth() - 1, 1).getTime();
    const wonPrev = all.filter((d) => { const t = Date.parse(d.won_at || d.last_stage_at || '');
      return stageOf(d.stage) === 'ganado' && t >= mPrev0 && t < m0; });
    const closedPrev = dealsValue(wonPrev);
    const nomPrev = new Date(now.getFullYear(), now.getMonth() - 1, 1).toLocaleDateString('es-CH', { month: 'long' });
    // ponderado: mismos pesos/valores que hmDealKpis (números idénticos en todo el dashboard)
    const open = all.filter((d) => DL_OPEN.includes(stageOf(d.stage)));
    const weighted = dealsWeighted(open);
    const proj = closed + weighted;
    const goal = +rmGoal || 0;
    $('rm-closed').textContent = closed ? fmtChf(closed) : 'CHF 0';
    const cuantos = wonMonth.length ? wonMonth.length + (wonMonth.length === 1 ? ' deal ganado' : ' deals ganados') : 'sin cierres todavía';
    // el mes anterior al lado: sin comparación, un "CHF 0" no dice si es raro o normal
    const cmp = closedPrev
      ? ' · ' + nomPrev + ' cerró ' + fmtChf(closedPrev)
      : ' · ' + nomPrev + ' tampoco tuvo cierres';
    $('rm-closed-t').textContent = cuantos + cmp;
    $('rm-weighted').textContent = fmtChf(Math.round(weighted));
    $('rm-proj').textContent = fmtChf(Math.round(proj));
    $('rm-goal-val').textContent = goal ? fmtChf(goal) : (rmGoalFetched ? 'sin definir' : '–');
    const gapEl = $('rm-gap'), gapT = $('rm-gap-t'), bar = $('rm-bar'), cap = $('rm-bar-cap'), act = $('rm-action');
    if (!goal){
      gapEl.textContent = '–'; gapEl.style.color = ''; gapT.textContent = 'definí el objetivo →';
      bar.hidden = true; cap.textContent = '';
      act.hidden = false; act.className = 'rm-action warn';
      act.textContent = rmGoalFetched ? 'Definí el objetivo mensual (✎ arriba) para ver el gap y el ritmo del mes.' : 'Cargando objetivo…';
      return;
    }
    // GAP = proyección − objetivo (verde si la proyección ya cubre el objetivo)
    const gap = proj - goal;
    const gapAbs = Math.abs(Math.round(gap));
    gapEl.textContent = (gap >= 0 ? '+' : '−') + (gapAbs ? fmtChf(gapAbs) : 'CHF 0');
    gapEl.style.color = gap >= 0 ? '#7ed957' : '#ff8b8b';
    gapT.textContent = gap >= 0 ? 'proyección cubre el objetivo' : 'falta para el objetivo';
    // barra: cerrado vs objetivo, con marcador de "dónde deberías estar hoy" (día/días del mes)
    const pctClosed = Math.min(100, closed / goal * 100);
    const pctToday = Math.min(100, dayOfMonth / daysInMonth * 100);
    bar.hidden = false;
    const fill = $('rm-fill');
    fill.style.width = pctClosed.toFixed(1) + '%';
    fill.className = 'rm-fill' + (pctClosed + 0.5 < pctToday ? ' behind' : '');
    const mk = $('rm-marker');
    mk.style.left = pctToday.toFixed(1) + '%';
    mk.title = 'Hoy deberías estar en ' + fmtChf(Math.round(goal * dayOfMonth / daysInMonth)) + ' (' + Math.round(pctToday) + '% del mes)';
    cap.textContent = 'Cerrado ' + (closed ? fmtChf(closed) : 'CHF 0') + ' de ' + fmtChf(goal) + ' (' + Math.round(pctClosed) + '%) · día ' + dayOfMonth + ' de ' + daysInMonth + ' (' + Math.round(pctToday) + '% del mes)';
    // línea de acción: "faltan ~N leads" con conversión histórica REAL (leads→ganados 90 días)
    act.hidden = false;
    if (gap >= 0){
      act.className = 'rm-action ok';
      act.textContent = '✓ A este ritmo el mes cierra en ' + fmtChf(Math.round(proj)) + ' — ' + fmtChf(Math.round(gap)) + ' arriba del objetivo.';
      return;
    }
    const t90 = Date.now() - 90 * D;
    /* Los 168 contactos importados de bexio NO son leads: entraron de la
       contabilidad, no pidieron nada. Metidos en el denominador daban una
       conversión de 6/192 = 3% y la pantalla pedía 183 leads este mes; sin
       ellos son 6 de ~24 y la cuenta se parece a la realidad.
       Decisión de Sebastián, 14 ago 2026: "no, los de bexio no pueden contar,
       si no no hace sentido". Se reusa esCartera(), el mismo criterio que ya
       usa el panel de Conversión real — un solo lugar que define qué es cartera
       vieja y qué es un lead de verdad. */
    const leads90 = (allLeads || []).filter((l) => !/^claude-/.test(l.session_id || '') && !/spam/i.test(l.status || '')
      && !esCartera(l) && Date.parse(l.created_at || '') >= t90);
    const won90 = all.filter((d) => stageOf(d.stage) === 'ganado' && Date.parse(d.won_at || d.last_stage_at || '') >= t90);
    const lead90Ids = new Set(leads90.map((l) => String(l.id)));
    const wonFromLeads90 = won90.filter((d) => lead90Ids.has(String(d.lead_id))).length;
    const avgWon = won90.length ? dealsValue(won90) / won90.length : 0;
    /* Antes que "conseguí N leads nuevos" está lo que YA está afuera esperando
       respuesta: si las propuestas enviadas cubren el gap, el mes se cierra
       cobrando eso, no saliendo a buscar gente. Con los números de hoy: faltan
       CHF 21'220 y hay CHF 39'557 en 4 propuestas — decir "necesitás 137 leads"
       en vez de eso es empujar al lado equivocado. */
    const enviadas = (ppList || []).filter((p) => p.status === 'sent' && !p.archived && !p.is_template);
    const valEnviadas = enviadas.reduce((a, p) => a + propVal(p), 0);
    if (enviadas.length && valEnviadas >= Math.abs(gap)){
      const ord = enviadas.map(propVal).sort((a, b) => b - a);
      let acum = 0, cuantas = 0;
      for (const v of ord){ acum += v; cuantas++; if (acum >= Math.abs(gap)) break; }
      act.className = 'rm-action bad';
      act.textContent = '⚠ Faltan ' + fmtChf(Math.abs(Math.round(gap))) + ' — tenés ' + fmtChf(Math.round(valEnviadas)) +
        ' afuera en ' + enviadas.length + (enviadas.length === 1 ? ' propuesta enviada' : ' propuestas enviadas') +
        '. Con que entren ' + (cuantas === 1 ? 'la más grande' : 'las ' + cuantas + ' más grandes') + ', el mes está hecho.';
      return;
    }
    // historia suficiente = al menos 10 leads y 2 cierres en 90 días; si no, no inventamos una tasa
    if (leads90.length >= 10 && won90.length >= 2 && wonFromLeads90 >= 1 && avgWon > 0){
      const conv = wonFromLeads90 / leads90.length;
      const needLeads = Math.ceil(Math.abs(gap) / (avgWon * conv));
      act.className = 'rm-action bad';
      act.textContent = '⚠ Faltan ' + fmtChf(Math.abs(Math.round(gap))) + ' — ≈ ' + needLeads + (needLeads === 1 ? ' lead más' : ' leads más') + ' este mes (conversión 90 d: ' + wonFromLeads90 + '/' + leads90.length + ' leads ganados · ticket medio ' + fmtChf(Math.round(avgWon)) + ').';
    } else {
      act.className = 'rm-action bad';
      act.textContent = '⚠ Faltan ' + fmtChf(Math.abs(Math.round(gap))) + ' para el objetivo. Poca historia de conversión (90 d) para estimar cuántos leads equivalen — el número saldrá solo cuando haya más cierres.';
    }
  }
  // objetivo editable inline: ✎ → input CHF → upsert business_goals id=1
  $('rm-goal-edit').addEventListener('click', () => {
    $('rm-goal-view').hidden = true; $('rm-goal-form').hidden = false;
    const inp = $('rm-goal-inp'); inp.value = rmGoal || ''; inp.focus();
  });
  $('rm-goal-cancel').addEventListener('click', () => { $('rm-goal-form').hidden = true; $('rm-goal-view').hidden = false; });
  $('rm-goal-save').addEventListener('click', async () => {
