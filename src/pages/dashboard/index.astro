    $('limp-todos') && $('limp-todos').addEventListener('click', () => marcar(true));
    $('limp-ninguno') && $('limp-ninguno').addEventListener('click', () => marcar(false));
    limpBoton();
  }

  function limpBoton(){
    const b = $('limp-go'); if (!b) return;
    b.disabled = !limpSel.size;
    b.textContent = limpSel.size ? '🗄 Archivar ' + limpSel.size : '🗄 Archivar';
  }

  async function limpArchivar(){
    if (!limpSel.size) return;
    const ids = [...limpSel];
    if (!confirm('¿Archivar ' + ids.length + ' deal' + (ids.length === 1 ? '' : 's') + '?\n\nSalen del pipeline pero NO se borran: quedan guardados y se pueden volver a traer.')) return;
    const b = $('limp-go'); b.disabled = true; b.textContent = 'Archivando…';

    /* La mitad de las tarjetas del board NO tienen fila en `deals`: son sintéticas, un
       deal dibujado a partir de la persona, con id 'L274' en vez de un uuid. Mandarlas
       a un update sobre `deals.id` hacía que Postgres rechazara TODO el lote con
       "invalid input syntax for type uuid" y no se archivara ni una.
       Se materializan primero (ensureRealDeal, que ya existía para esto) y recién ahí se
       archivan: así la persona queda intacta y el deal se puede volver a traer. */
    const reales = [], sinteticos = [];
    ids.forEach((id) => {
      const d = (dealsList || []).find((x) => String(x.id) === String(id));
      if (!d) return;
      (d.synthetic ? sinteticos : reales).push(d);
    });

    let fallaron = 0;
    for (const d of sinteticos){
      const real = await ensureRealDeal(d);
      if (real) reales.push(real); else fallaron++;
    }

    const uuids = reales.map((d) => String(d.id));
    if (uuids.length){
      const { error } = await supabase.from('deals').update({ archived: true }).in('id', uuids);
      if (error){ toast('⚠️ ' + error.message); b.disabled = false; limpBoton(); return; }
      (dealsList || []).forEach((d) => { if (uuids.includes(String(d.id))) d.archived = true; });
    }

    toast(uuids.length
      ? '🗄 ' + uuids.length + ' archivados' + (fallaron ? ' · ' + fallaron + ' no se pudieron' : '') + ' — el pipeline quedó con lo que es real'
      : '⚠️ No se pudo archivar ninguno');
    limpSel.clear();
    $('limp-modal').hidden = true;
    renderPipeline();
  }

  function limpBind(){
    if (limpBind.hecho) return; limpBind.hecho = true;
    $('dl-limpiar') && $('dl-limpiar').addEventListener('click', limpAbrir);
    $('limp-x') && $('limp-x').addEventListener('click', () => $('limp-modal').hidden = true);
    $('limp-back') && $('limp-back').addEventListener('click', () => $('limp-modal').hidden = true);
    $('limp-modal') && $('limp-modal').addEventListener('click', (e) => { if (e.target === $('limp-modal')) $('limp-modal').hidden = true; });
    $('limp-go') && $('limp-go').addEventListener('click', limpArchivar);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !$('limp-modal').hidden) $('limp-modal').hidden = true; });
  }

  function renderPipeline(){
    limpBind();
    // el refresh automático re-dibuja todo: cerrar el ⋯ para que no quede flotando sobre cards viejas
    const menu = $('dl-menu'); if (menu) menu.hidden = true;
    const rows = dlDeals();
    const now = Date.now();
    const isOpen = (d) => DL_OPEN.includes(stageOf(d.stage));
    // fix (2026-07-14, shell): los KPIs (Pipeline abierto/Ponderado/Ganado 30d/Win rate)
    // se fusionaron con los de Home — ahora viven en #hm-* y los pobla hmDealKpis()/
    // renderHome(), que corre siempre que se entra a Pipeline (ver gotoTab). Acá solo
    // queda in30, que sigue haciendo falta más abajo.
    const in30 = (iso) => iso && (now - Date.parse(iso)) <= 30 * 864e5;
    // contador del chip de estancados (sobre los abiertos que matchean la búsqueda, sin el propio filtro)
    const stuckN = rows.filter((d) => isOpen(d) && dealStageDays(d) > 14).length;
    const nEl = $('dl-stuck-n'); if (nEl) nEl.textContent = stuckN;
    const stuckBtn = $('dl-stuck'); if (stuckBtn) stuckBtn.classList.toggle('active', dlStuck);
    /* ---- toggle de vista ---- */
    const board = dlView !== 'lista';
    const bBtn = $('dl-view-board'), lBtn = $('dl-view-list');
    if (bBtn) bBtn.classList.toggle('on', board);
    if (lBtn) lBtn.classList.toggle('on', !board);
    const pipe = $('pipeline'), drops = $('pipe-drops'), list = $('deals-list'), stageSum = $('pipe-stage-sum');
    if (!board){
      if (pipe) { pipe.hidden = true; pipe.innerHTML = ''; }
      if (drops) { drops.hidden = true; drops.innerHTML = ''; }
      if (stageSum) { stageSum.hidden = true; stageSum.innerHTML = ''; }
      const pager = $('pipe-pager'); if (pager) pager.hidden = true;
      if (list) { list.hidden = false; renderDealsList(rows); }
      return;
    }
    if (list) { list.hidden = true; list.innerHTML = ''; }
    if (pipe) pipe.hidden = false;
    if (drops) drops.hidden = false;
    if (stageSum) stageSum.hidden = false;
    /* ---- board: solo las 4 columnas de trabajo; ganado/perdido son drop-zones abajo ---- */
    let open = rows.filter(isOpen);
    if (dlStuck) open = open.filter((d) => dealStageDays(d) > 14);
    $('leads-empty').hidden = open.length > 0;
    const byStage = {}; DL_OPEN.forEach((k) => byStage[k] = []);
    open.forEach((d) => byStage[stageOf(d.stage)].push(d));
    /* El más QUIETO primero, no el más nuevo.
       Antes cada columna ordenaba por fecha de alta, así que arriba quedaba el deal
       recién creado y el que lleva cinco semanas parado se hundía al fondo — donde
       nadie mira. Medido el 25 ago: 10 de los 23 deals abiertos están en Contactado
       con 27 días de promedio y ninguno con propuesta. Ese es el que hay que ver al
       abrir la columna, no el de ayer.
       El color del borde ya avisaba (verde <7 d, ámbar 7-14, rojo >14); lo que
       faltaba era que el orden acompañara al color. */
    Object.values(byStage).forEach((a) => a.sort((x, y) => dealStageDays(y) - dealStageDays(x)));
    // resumen por etapa: total abierto (todo lo que ves en el board) + cada etapa
    // por separado, sin tener que sumar columna por columna a ojo
    if (stageSum) {
      const openVal = dealsValue(open);
      const openWt = Math.round(dealsWeighted(open));
      stageSum.innerHTML =
        '<div class="pss-card pss-total"><div class="pss-l">Total abierto<b class="pss-n">' + open.length + '</b></div>' +
          '<div class="pss-v">' + fmtChf(openVal) + '</div><div class="pss-w">pond. ' + fmtChf(openWt) + '</div></div>' +
        STAGES.filter((s) => DL_OPEN.includes(s.key)).map((s) => {
          const n = byStage[s.key].length, val = dealsValue(byStage[s.key]), wt = Math.round(dealsWeighted(byStage[s.key]));
          // el % ya no es fijo por etapa: se muestra el efectivo, que en Propuesta baja con los días
          const pct = val ? Math.round(wt / val * 100) : Math.round(s.prob * 100);
          return '<div class="pss-card" style="--stage:' + s.color + '"><span class="pss-bar"></span>' +
            '<div class="pss-body"><div class="pss-l">' + s.label + '<b class="pss-n">' + n + '</b></div>' +
            '<div class="pss-v">' + fmtChf(val) + '</div><div class="pss-w">pond. ' + fmtChf(wt) + ' (' + pct + '%)</div></div></div>';
        }).join('');
    }
    pipe.className = 'pipeline';
    pipe.innerHTML = STAGES.filter((s) => DL_OPEN.includes(s.key)).map((s) => {
      const n = byStage[s.key].length;
      const cards = byStage[s.key].map((d) => cardHTML(d, s)).join('') || '<div class="pipe-empty">Sin deals</div>';
      const val = dealsValue(byStage[s.key]);
      const wt = Math.round(dealsWeighted(byStage[s.key]));
      const pct = val ? Math.round(wt / val * 100) : Math.round(s.prob * 100);
      return '<div class="pipe-col" data-stage="' + s.key + '">' +
        '<div class="pipe-col-head"><span class="bar" style="background:' + s.color + '"></span><span class="st">' + s.label + '</span><span class="cnt">' + n + '</span></div>' +
        '<div class="pipe-col-sums"><span class="tot" style="color:' + s.color + '">' + fmtChf(val) + '</span><span class="wt">pond. ' + fmtChf(wt) + ' (' + Math.round(s.prob * 100) + '%)</span></div>' +
        '<div class="pipe-list">' + cards + '</div>' +
      '</div>';
    }).join('');
    // drop-zones de cierre con resumen 30d (soltar acá = mismo setDealStage que las columnas)
    const won30r = rows.filter((d) => stageOf(d.stage) === 'ganado' && in30(d.won_at || d.last_stage_at));
    const lost30r = rows.filter((d) => stageOf(d.stage) === 'perdido' && in30(d.lost_at || d.last_stage_at));
    const snoozeR = rows.filter((d) => stageOf(d.stage) === 'seguimiento_futuro');
    const snoozeDueR = snoozeR.filter((d) => d.follow_up_target_at && new Date(d.follow_up_target_at) - now <= 7 * 864e5);
    if (drops) drops.innerHTML =
      '<div class="pipe-drop win" data-stage="ganado" title="Ver los ganados en la vista Lista">🏆 Soltá acá para GANADO<span class="pd-sum">últimos 30d: ' + won30r.length + ' · ' + fmtChf(dealsValue(won30r)) + '</span></div>' +
      '<div class="pipe-drop lose" data-stage="perdido" title="Ver los perdidos en la vista Lista">✖ PERDIDO<span class="pd-sum">últimos 30d: ' + lost30r.length + ' · ' + fmtChf(dealsLostValue(lost30r)) + '</span></div>' +
      '<div class="pipe-drop snooze" data-stage="seguimiento_futuro" title="Ver seguimiento futuro en la vista Lista">🕓 SEGUIMIENTO FUTURO<span class="pd-sum">' + snoozeR.length + ' en espera' + (snoozeDueR.length ? ' · ' + snoozeDueR.length + ' vencen en 7d' : '') + '</span></div>';
    bindPipeline();
    pipePager();
    // próximo paso: task abierta más cercana por persona visible (1 query cacheada, ver dlFetchNextTasks)
    dlFetchNextTasks([...new Set(rows.map((d) => String(d.lead_id)).filter((x) => x && x !== 'undefined' && x !== 'null'))]);
  }
  /* ---- vista Lista: tabla con semáforo, próximo paso y última actividad ---- */
  function renderDealsList(rows){
    const cont = $('deals-list'); if (!cont) return;
    let ds = rows.slice();
    if (dlStuck) ds = ds.filter((d) => DL_OPEN.includes(stageOf(d.stage)) && dealStageDays(d) > 14);
    if (dlListStage === 'open') ds = ds.filter((d) => DL_OPEN.includes(stageOf(d.stage)));
    else if (dlListStage === 'ganado' || dlListStage === 'perdido' || dlListStage === 'seguimiento_futuro') ds = ds.filter((d) => stageOf(d.stage) === dlListStage);
    /* Con el supuesto a la vista: cuando el número sale de VARIAS ofertas alternativas
       —los paquetes Lite/Plus/Premium del mismo trato— la celda lo dice. Antes se sumaban
       las tres y el total mentía al doble; ahora se cuenta la mayor, que es un techo, y
       decirlo es la diferencia entre una estimación y un dato. */
    const rowValInfo = (d) => stageOf(d.stage) === 'perdido' ? dealLostValueInfo(d) : dealValueInfo(d);
    const rowVal = (d) => rowValInfo(d).chf;
    const CMP = {
      value: (a, b) => rowVal(b) - rowVal(a),
      days: (a, b) => dealStageDays(b) - dealStageDays(a),
      recent: masNuevo('created_at')
    };
    ds.sort(CMP[dlSort] || CMP.value);
    $('leads-empty').hidden = ds.length > 0;
    const chip = (k, l) => '<button class="dl-chip' + (dlListStage === k ? ' active' : '') + '" data-st="' + k + '" type="button">' + l + '</button>';
    // borrado en batch: solo deals REALES (no synthetic — esos no tienen fila en `deals`)
    const selectable = ds.filter((d) => !d.synthetic);
    const allChecked = selectable.length > 0 && selectable.every((d) => dlSelected.has(String(d.id)));
    const body = ds.map((d) => {
      const r = leadById(d.lead_id) || {};
      const s = STAGES.find((x) => x.key === stageOf(d.stage)) || STAGES[0];
      const vi = rowValInfo(d);
      const val = vi.chf;
      const days = dealStageDays(d);
      const dom = leadDomain(r);
      const co = (dom && companyName(dom)) || r.company || '';
      const ofs = offersForDeal(d);
      const dealName = d.title || ((ofs[0] && ofs[0].title) ? ofs[0].title : (r.name || r.first_name || '(sin nombre)'));
      return '<tr data-lead="' + esc(String(d.lead_id)) + '">' +
        '<td class="lt-chk">' + (d.synthetic ? '' : '<input type="checkbox" class="dl-row-chk" data-id="' + esc(d.id) + '"' + (dlSelected.has(String(d.id)) ? ' checked' : '') + ' onclick="event.stopPropagation()" />') + '</td>' +
        '<td><div class="lt-name">' + esc(dealName) + '</div>' + (stageOf(d.stage) === 'perdido' && (d.lost_reason || r.lost_reason) ? '<div class="lt-sub">✕ ' + esc(d.lost_reason || r.lost_reason) + '</div>' : '') + '</td>' +
        '<td>' + esc(co || '—') + (r.name || r.first_name ? '<div class="lt-sub">' + esc(r.name || r.first_name) + '</div>' : '') + '</td>' +
        '<td><span class="lt-pill" style="color:' + s.color + ';background:color-mix(in srgb,' + s.color + ' 14%,transparent);border-color:color-mix(in srgb,' + s.color + ' 40%,transparent)">' + s.label + '</span></td>' +
        '<td class="lt-val">' + (val ? fmtChf(val) : '<span class="lt-num">—</span>') +
          (vi.deN > 1
            ? '<div class="lt-sub" title="Son paquetes alternativos del mismo trabajo: el cliente elige UNO. ' +
                (vi.como === 'rec' ? 'Se cuenta el que está marcado como recomendado.' : 'Ninguno está marcado como recomendado, así que se cuenta el promedio de los ' + vi.deN + '.') + '">' +
              (vi.como === 'rec' ? 'el recomendado de ' + vi.deN : 'promedio de ' + vi.deN + ' paquetes') + '</div>'
            : '') + '</td>' +
        '<td>' + dealDaysChip(days) + '</td>' +
        '<td class="lt-act">' + dealNextStep(d, false) + '</td>' +
        '<td class="lt-act">' + esc(actLabel(lastActivity(r))) + '</td></tr>';
    }).join('');
    cont.innerHTML =
      '<div class="dl-lbar">' + chip('all', 'Todas') + chip('open', 'Abiertas') + chip('ganado', 'Ganadas') + chip('perdido', 'Perdidas') + chip('seguimiento_futuro', 'Seguimiento futuro') +
        '<select id="dl-sort" class="status" title="Ordenar">' +
          '<option value="value"' + (dlSort === 'value' ? ' selected' : '') + '>Valor ↓</option>' +
          '<option value="days"' + (dlSort === 'days' ? ' selected' : '') + '>Días en etapa ↓</option>' +
          '<option value="recent"' + (dlSort === 'recent' ? ' selected' : '') + '>Recientes</option>' +
        '</select>' +
        '<button class="btn btn-danger small" id="dl-del-sel" type="button" hidden>🗑 Borrar seleccionados</button></div>' +
      (ds.length ? '<div class="lead-table-wrap"><table class="lead-table"><thead><tr>' +
        '<th class="lt-chk">' + (selectable.length ? '<input type="checkbox" id="dl-chk-all"' + (allChecked ? ' checked' : '') + ' title="Seleccionar todos los deals reales visibles" />' : '') + '</th>' +
        '<th>Deal</th><th>Empresa · Contacto</th><th>Etapa</th><th>Valor</th><th>Días en etapa</th><th>Próximo paso</th><th>Última actividad</th>' +
        '</tr></thead><tbody>' + body + '</tbody></table></div>'
        : '<p class="muted-note" style="padding:10px 2px">Sin deals en esta vista.</p>');
    cont.querySelectorAll('.dl-lbar .dl-chip').forEach((b) => b.addEventListener('click', () => { dlListStage = b.dataset.st; renderPipeline(); }));
    const sel = cont.querySelector('#dl-sort'); if (sel) sel.addEventListener('change', () => { dlSort = sel.value; renderPipeline(); });
    cont.querySelectorAll('tbody tr').forEach((tr) => tr.addEventListener('click', () => openLead(tr.dataset.lead)));
    bindDlSelection(); updateDlDelBtn();
  }
  // Deals: selección múltiple para borrar en batch (mismo patrón que Personas/psSelected)
  let dlSelected = new Set();
  function updateDlDelBtn(){
    const btn = $('dl-del-sel'); if (!btn) return;
    btn.hidden = dlSelected.size === 0;
    btn.textContent = '🗑 Borrar seleccionados (' + dlSelected.size + ')';
  }
  function bindDlSelection(){
    document.querySelectorAll('.dl-row-chk').forEach((cb) => cb.addEventListener('change', () => {
      if (cb.checked) dlSelected.add(cb.dataset.id); else dlSelected.delete(cb.dataset.id);
      updateDlDelBtn();
      const all = $('dl-chk-all'); if (all) all.checked = [...document.querySelectorAll('.dl-row-chk')].every((c) => c.checked);
    }));
    const allBox = $('dl-chk-all');
    if (allBox) allBox.addEventListener('change', () => {
      document.querySelectorAll('.dl-row-chk').forEach((cb) => { cb.checked = allBox.checked; if (allBox.checked) dlSelected.add(cb.dataset.id); else dlSelected.delete(cb.dataset.id); });
      updateDlDelBtn();
    });
    const delBtn = $('dl-del-sel');
    if (delBtn) delBtn.onclick = async () => {
      const ids = [...dlSelected]; if (!ids.length) return;
      if (!confirm('¿Borrar definitivamente ' + ids.length + ' deal' + (ids.length === 1 ? '' : 's') + '? Esta acción no se puede deshacer.')) return;
      const { error } = await supabase.from('deals').delete().in('id', ids);
      if (error) { toast('⚠️ ' + error.message); return; }
      dealsList = (dealsList || []).filter((d) => !ids.includes(String(d.id)));
      dlSelected.clear();
      renderPipeline();
    };
  }
  /* ---- ⋯ de la tarjeta (mismo patrón que ppOpenMenu: fixed, pegado al botón) ---- */
  function dlOpenMenu(btn){
    const menu = $('dl-menu'); if (!menu) return;
    if (!menu.hidden && menu.dataset.id === String(btn.dataset.id)){ menu.hidden = true; return; }
    const d = (dealsList || []).find((x) => String(x.id) === String(btn.dataset.id)); if (!d) return;
    menu.dataset.id = String(d.id);
    /* Mover de etapa desde acá y no solo arrastrando. En el teléfono el tablero
       muestra UNA columna por vez con un paginador, así que arrastrar entre columnas
       es directamente imposible — y el menú solo ofrecía Ganado y Perdido, o sea que
       desde el teléfono un deal solo podía avanzar hasta cerrarse. */
    const et = stageOf(d.stage);
    menu.innerHTML =
      '<div class="dl-menu-lbl">Mover a</div>' +
      STAGES.filter((x) => DL_OPEN.includes(x.key) && x.key !== et)
        .map((x) => '<button data-mv="' + x.key + '" type="button"><span class="dl-mv-dot" style="background:' + x.color + '"></span>' + x.label + '</button>').join('') +
      '<hr />' +
      '<button data-act="won" type="button">🏆 Ganado</button>' +
      '<button data-act="lost" type="button">✖ Perdido</button>' +
      (et === 'seguimiento_futuro' ? '' : '<button data-mv="seguimiento_futuro" type="button">💤 Seguimiento futuro</button>') +
      '<hr /><button data-act="task" type="button">➕ Task</button>' +
      '<button data-act="open" type="button">👤 Abrir contacto</button>' +
      (d.synthetic ? '' : '<hr /><button data-act="del" type="button" class="danger">🗑 Borrar</button>');
    menu.hidden = false;
    const r = btn.getBoundingClientRect();
    menu.style.left = Math.max(8, Math.min(r.right - menu.offsetWidth, window.innerWidth - menu.offsetWidth - 8)) + 'px';
    menu.style.top = Math.min(r.bottom + 6, window.innerHeight - menu.offsetHeight - 8) + 'px';
    menu.querySelectorAll('button').forEach((mb) => mb.addEventListener('click', async (ev) => {
      ev.stopPropagation(); menu.hidden = true;
      const mv = mb.dataset.mv;
      if (mv){
        const ok = await setDealStage(d.id, mv);
        if (ok) toast('→ ' + ((STAGES.find((x) => x.key === mv) || {}).label || mv));
        return;
      }
      const act = mb.dataset.act;
      if (act === 'won'){ const ok = await setDealStage(d.id, 'ganado'); if (ok) toast('🏆 Deal ganado'); }
      else if (act === 'lost'){ const ok = await setDealStage(d.id, 'perdido'); if (ok) toast('✖ Deal perdido'); }   // setDealStage ya pregunta el motivo
      else if (act === 'task'){ lm2Tab = 'task'; lm2CompCollapsed = false; openLead(d.lead_id); }   // en ficha V2 abre con el composer en Task
      else if (act === 'open') openLead(d.lead_id);
      else if (act === 'del'){
        if (!confirm('¿Borrar este deal? No se puede deshacer.')) return;
        const { error } = await supabase.from('deals').delete().eq('id', d.id);
        if (error) { toast('⚠️ ' + error.message); return; }
        dealsList = (dealsList || []).filter((x) => String(x.id) !== String(d.id));
        toast('🗑 Deal borrado'); renderPipeline();
      }
    }));
  }
  // cerrar el ⋯ al clickear afuera (registro único, como el de pp-menu)
  document.addEventListener('click', (e) => { const m = $('dl-menu'); if (m && !m.hidden && !e.target.closest('#dl-menu') && !e.target.closest('.pc-dots')) m.hidden = true; });
  /* ---- toolbar de Deals: búsqueda propia + estancados + toggle de vista (bind único: HTML estático) ---- */
  $('dl-search') && $('dl-search').addEventListener('input', (e) => { dlSearch = e.target.value.toLowerCase().trim(); renderPipeline(); });
  $('dl-stuck') && $('dl-stuck').addEventListener('click', () => { dlStuck = !dlStuck; renderPipeline(); });
  function setDealsView(v){ dlView = v; localStorage.setItem('vv_deals_view', v); renderPipeline(); }
  $('dl-view-board') && $('dl-view-board').addEventListener('click', () => setDealsView('board'));
  $('dl-view-list') && $('dl-view-list').addEventListener('click', () => setDealsView('lista'));
  // orden de la tabla de Personas: click en el encabezado alterna ↑/↓
  let psSort = { k: 'created', dir: -1 }, psStage = 'all', psAct = 'all';
  /* Una sola fuente de verdad para "¿estamos en pantalla angosta?". Se usa
     matchMedia y no innerWidth para que rotar el teléfono redibuje solo. */
  const PS_ANGOSTO = window.matchMedia('(max-width: 700px)');
  const psAngosto = () => PS_ANGOSTO.matches;
  PS_ANGOSTO.addEventListener('change', () => { if (!$('tab-leads').hidden) renderLeads(); });
  function leadsListHTML(rows){
    if (!rows.length) return '<p class="muted-note" style="padding:14px">Sin personas que coincidan con la búsqueda o el filtro.</p>';
    const stageIdx = (r) => STAGES.findIndex((s) => s.key === stageOf(r.status));
    const actMap = new Map(rows.map((r) => [r.id, lastActivity(r)]));
    const scMap = new Map(rows.map((r) => [r.id, leadScore(r)]));
    // valor VISIBLE en la tabla: lo que hay/hubo sobre la mesa — regla única primero,
    // y si da 0 pero hay ofertas ligadas (ej. perdidas), mostrar ese valor igual.
    const rowVal = (r) => leadValue(r) || leadLostValue(r);
    const CMP = {
      name:    (a, b) => String(a.name || a.email || '').localeCompare(String(b.name || b.email || '')),
      email:   (a, b) => String(a.email || '').localeCompare(String(b.email || '')),
      company: (a, b) => String(companyName(leadDomain(a)) || a.company || '').localeCompare(String(companyName(leadDomain(b)) || b.company || '')),
      stage:   (a, b) => stageIdx(a) - stageIdx(b),
      value:   (a, b) => rowVal(a) - rowVal(b),
      channel: (a, b) => String(a.channel || '').localeCompare(String(b.channel || '')),
      score:   (a, b) => (scMap.get(a.id) || {}).score - (scMap.get(b.id) || {}).score,
      activity: (a, b) => ((actMap.get(a.id) || {}).t || 0) - ((actMap.get(b.id) || {}).t || 0),
      created: masViejo('created_at')
    };
    const sorted = rows.slice().sort((a, b) => (CMP[psSort.k] || CMP.created)(a, b) * psSort.dir);
    const AV_COLORS = ['#8ab4ff', '#c58af9', '#7ed957', '#f0c060', '#ff8b5e', '#5ec7d1', '#e08ac5'];
    const avColor = (n) => { let h = 0; const x = String(n || '?'); for (let i = 0; i < x.length; i++) h = (h * 31 + x.charCodeAt(i)) >>> 0; return AV_COLORS[h % AV_COLORS.length]; };
    const body = sorted.map((r) => {
      const s = STAGES.find((x) => x.key === stageOf(r.status)) || STAGES[0];
      const val = rowVal(r);
      const act = actMap.get(r.id);
      const isNl = String(r.message || '') === 'Newsletter signup';   // leads.source no existe — el origen vive en message (igual que 'CALCULADORA')
      const nm = r.name || r.first_name || (isNl && r.email) || '(sin nombre)';
      const ini = (nm[0] || '?').toUpperCase();
      const dom = leadDomain(r);
      const co = (dom && companyName(dom)) || r.company || '';
      const nd = dealsForLead(r.id).length;
      return '<tr data-id="' + esc(r.id) + '">' +
