  async function pjBillSubir(files){
    const p = pjCur; if (!p || !files || !files.length) return;
    const note = $('pj-bills-resumen');
    for (const file of files){
      note.innerHTML = '<p class="muted-note" style="margin:0 0 12px">⬆ Subiendo ' + esc(file.name) + '…</p>';
      /* El nombre del archivo va normalizado: un "Rechnung Müller (1).pdf" con espacios
         y paréntesis rompe la URL firmada en algunos clientes. */
      const limpio = file.name.replace(/[^\w.\-]+/g, '_').slice(-80);
      const path = 'p' + p.id + '/' + Date.now() + '_' + limpio;
      const { error: upErr } = await supabase.storage.from('project-bills').upload(path, file, { contentType: file.type || undefined });
      if (upErr){ toast('⚠️ ' + upErr.message); continue; }
      const { data: row, error: insErr } = await supabase.from('project_bills').insert({
        project_id: p.id, file_path: path, file_name: file.name, mime: file.type || null,
        size_bytes: file.size, subido_por: meEmail || null,
      }).select().single();
      if (insErr){ toast('⚠️ ' + insErr.message); continue; }
      pjBills.unshift(row);
      pjBillsRender();
      await pjBillLeer(row.id, true);   // leerla sola: subir y tener que apretar "leer" es un paso de más
    }
  }

  async function pjBillLeer(id, silencioso){
    const b = pjBills.find((x) => String(x.id) === String(id)); if (!b) return;
    const res = $('pj-bills-resumen');
    res.innerHTML = '<p class="muted-note" style="margin:0 0 12px">🤖 Leyendo ' + esc(b.file_name || 'la factura') + '… (unos segundos)</p>';
    try {
      const { data, error } = await supabase.functions.invoke('ai-bill-read', { body: { bill_id: b.id } });
      if (error || !data || data.error) throw new Error((data && data.error) || error.message);
      Object.assign(b, data.leido);
      if (!silencioso) toast('🤖 Leída');
    } catch (e){
      toast('⚠️ ' + (e.message || e));
    }
    pjBillsRender();
  }

  /* Las facturas de proveedor NO viven donde las de cliente: en bexio están en
     Compras → Facturas de proveedor (Einkauf → Lieferantenrechnungen), y entran en
     BORRADOR, así que no aparecen en ninguna lista de "contabilizadas". Esto muestra lo
     que bexio tiene de verdad, para no tener que buscarlo a mano.
     (Sebastián, 26 ago 2026: "mandé una y no la encuentro".) */
  async function pjBillsBexioLista(){
    const box = $('pj-bills-bx'); if (!box) return;
    box.innerHTML = '<p class="muted-note" style="margin:0 0 12px">Preguntándole a bexio…</p>';
    /* Con try: si la llamada se cae (red, sesión vencida) sin esto la promesa quedaba
       rechazada y el panel se congelaba en "Preguntándole a bexio…" para siempre —
       que desde afuera es exactamente "no muestra nada". */
    let data, error;
    try { ({ data, error } = await supabase.functions.invoke('bexio-bill', { body: { listar: true } })); }
    catch (e){ error = e; }
    if (error || !data || data.error){
      box.innerHTML = '<p class="muted-note" style="margin:0 0 12px;color:#f0c060">⚠️ ' +
        esc((data && data.error) || (error && error.message) || 'bexio no contestó') + '</p>';
      return;
    }
    const fs = data.facturas || [];
    const mias = new Set(pjBills.map((b) => String(b.bexio_id || '')).filter(Boolean));
    box.innerHTML =
      '<div class="pj-bx-lista">' +
        '<p class="muted-note" style="margin:0 0 8px">En bexio, <b>Compras → Facturas de proveedor</b>. ' +
        'Todas entran como <b>borrador</b>: no salen en las listas de contabilizadas. ' +
        '<a href="https://office.bexio.com/" target="_blank" rel="noopener">Abrir bexio ↗</a></p>' +
        (!fs.length
          ? '<p class="muted-note" style="margin:0 0 12px">bexio no tiene ninguna factura de proveedor. Si mandaste una desde acá, no llegó.</p>'
          : '<table class="lead-table"><thead><tr><th>Nº</th><th>Proveedor</th><th>Fecha</th>' +
            '<th style="text-align:right">Importe</th><th>Estado</th></tr></thead><tbody>' +
            fs.map((f) => '<tr' + (mias.has(String(f.id)) ? ' style="background:var(--panel-2)"' : '') + '>' +
              '<td>' + esc(f.nro || String(f.id)) + (mias.has(String(f.id)) ? ' <span class="muted-note">← de acá</span>' : '') + '</td>' +
              '<td>' + esc(f.proveedor || '—') + '</td>' +
              '<td>' + (f.fecha ? fmtDMY(String(f.fecha).slice(0, 10)) : '—') + '</td>' +
              '<td style="text-align:right">' + (f.total != null ? pjCHF(f.total) : '—') + '</td>' +
              '<td class="muted-note">' + esc(String(f.estado || '—')) + '</td></tr>').join('') +
            '</tbody></table>') +
      '</div>';
  }

  async function pjBillVer(id){
    const b = pjBills.find((x) => String(x.id) === String(id)); if (!b) return;
    /* URL firmada de vida corta: el bucket es privado porque son facturas con datos
       bancarios de gente real. */
    const { data, error } = await supabase.storage.from('project-bills').createSignedUrl(b.file_path, 300);
    if (error || !data){ toast('⚠️ ' + (error?.message || 'no se pudo abrir')); return; }
