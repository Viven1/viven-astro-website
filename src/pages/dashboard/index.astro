  // KPIs de deals con las MISMAS fórmulas que el board (renderPipeline) — números idénticos en todos lados
  function hmDealKpis(){
    const now = Date.now(), D = 864e5;
    const all = (dealsList || []).filter((d) => !d.archived);
    const open = all.filter((d) => DL_OPEN.includes(stageOf(d.stage)));
    const weighted = dealsWeighted(open);
    const wonAge = (d) => { const t = Date.parse(d.won_at || d.last_stage_at || ''); return t ? now - t : Infinity; };
    const wonAll = all.filter((d) => stageOf(d.stage) === 'ganado');
    const won30 = wonAll.filter((d) => wonAge(d) <= 30 * D);
    const won3060 = wonAll.filter((d) => { const a = wonAge(d); return a > 30 * D && a <= 60 * D; });
    /* Cerrado por MES CALENDARIO, que es como se paga (del 1 al último). El panel de
       Ritmo ya usaba este criterio; la tarjeta de abajo seguía con "últimos 30 días"
       y las dos se contradecían en pantalla. */
    const mes0 = new Date(); mes0.setDate(1); mes0.setHours(0, 0, 0, 0);
    const mesPrev0 = new Date(mes0); mesPrev0.setMonth(mesPrev0.getMonth() - 1);
    const wonEn = (desde, hasta) => wonAll.filter((d) => {
      const t = Date.parse(d.won_at || d.last_stage_at || '');
      return t && t >= desde && (hasta == null || t < hasta);
    });
    const won90 = wonAll.filter((d) => wonAge(d) <= 90 * D).length;
    const lost90 = all.filter((d) => { if (stageOf(d.stage) !== 'perdido') return false; const t = Date.parse(d.lost_at || d.last_stage_at || ''); return t && now - t <= 90 * D; }).length;
    const dec90 = won90 + lost90;
    return { openVal: dealsValue(open), openN: open.length, weighted, won30Val: dealsValue(won30), prev30Val: dealsValue(won3060),
      wonMesVal: dealsValue(wonEn(mes0.getTime(), null)),
      wonMesPrevVal: dealsValue(wonEn(mesPrev0.getTime(), mes0.getTime())),
      /* Un win rate necesita perdidos. Si nadie marca deals como perdidos —el caso
         de esta base: 0 perdidos— la cuenta da 100% siempre y no dice nada. Y con
         dos o tres casos tampoco: un 100% sobre 1 caso parece un logro y es ruido.
         Se muestra sólo con al menos 5 decididos Y algún perdido; si no, el KPI dice
         por qué no hay número.
         OJO CON LA REDACCIÓN (Sebastián, 24 ago 2026): que no haya perdidos NO es un
         descuido de carga. Es que esas propuestas todavía no se perdieron — no
         contestaron, que es otra cosa. El texto dice "todavía no se perdió ninguno",
         no "no los marcaste". */
      winRate: (dec90 >= 5 && lost90 > 0) ? Math.round(won90 / dec90 * 100) : null,
      won90, dec90, lost90 };
  }

  /* ======= ROAS de Ads: CÁLCULO CANÓNICO ÚNICO (Home + Analytics·Google Ads) =======
     Antes había 3 implementaciones que podían contradecirse: esta (Home), la del
     tab de Ads (fetch propio a `leads` + won leído directo de leads.status/deal_value,
     sin pasar por dealsList/dealValue) y, implícitamente, ads-conversions-sync.
     Ahora TODO el frontend usa esta única función: lead con gclid (limpio de
     tests/spam/exclusión manual) → su deal, con la MISMA regla de valor que el
     pipeline (dealValue: ofertas ganadas > ofertas abiertas > deal_value crudo).
     `offsetDays` corre la ventana hacia atrás para poder comparar vs el período
     anterior (mismo patrón que setDelta/renderAnalytics). */
  const ADS_LEAD_TEST_RE = /@viven\.ch$|@entropia|@example\.|^test@|@test\./i;
  const adsLeadOk = (r) => !!r.gclid && !r.ads_exclude && !ADS_LEAD_TEST_RE.test(r.email || '') && !/spam|descartado|perdido-spam/i.test(r.status || '');
  function adsRoasFor(days, offsetDays){
    const end = Date.now() - (offsetDays || 0) * 864e5, win = (days || 30) * 864e5, start = end - win;
    const inWin = (iso) => { const t = Date.parse(iso || ''); return t && t > start && t <= end; };
    const leads = (allLeads || []).filter((r) => adsLeadOk(r) && inWin(r.created_at));
    const gset = new Set(leads.map((r) => String(r.id)));
    const leadFor = (d) => leads.find((r) => String(r.id) === String(d.lead_id));
    const won = (dealsList || []).filter((d) => !d.archived && gset.has(String(d.lead_id)) && stageOf(d.stage) === 'ganado' && inWin(d.won_at || d.last_stage_at));
    const openDeals = (dealsList || []).filter((d) => !d.archived && gset.has(String(d.lead_id)) && DL_OPEN.includes(stageOf(d.stage)));
    const wonVal = won.reduce((a, d) => a + dealValue(d), 0);
    const openVal = openDeals.reduce((a, d) => a + dealValue(d), 0);
    // desglose por campaña (utm_campaign del lead) — para la tabla merge Google+CRM
    const byCamp = {};
    const campOf = (l) => (l && l.utm_campaign) || '(sin campaña)';
    leads.forEach((r) => { const c = campOf(r); byCamp[c] = byCamp[c] || { leads: 0, won: 0, wonVal: 0, openVal: 0 }; byCamp[c].leads++; });
    won.forEach((d) => { const c = campOf(leadFor(d)); byCamp[c] = byCamp[c] || { leads: 0, won: 0, wonVal: 0, openVal: 0 }; byCamp[c].won++; byCamp[c].wonVal += dealValue(d); });
    openDeals.forEach((d) => { const c = campOf(leadFor(d)); byCamp[c] = byCamp[c] || { leads: 0, won: 0, wonVal: 0, openVal: 0 }; byCamp[c].openVal += dealValue(d); });
    return { days: days || 30, leads, won, wonVal, openVal, byCamp };
  }
  // compat: Home usa esta forma reducida hace tiempo — misma fuente canónica ahora
  function hmAdsStats(){
    const r = adsRoasFor(30, 0);
    return { leads: r.leads.length, wonVal: r.wonVal, wonN: r.won.length };
  }

  /* ¿Siguen vivas?: propuestas enviadas hace más de un mes, sin próximo paso definido.
     El corte en 30 días no es caprichoso: a esa altura la probabilidad ya cayó a 20%
     (ver dealProb) y seguir mandando follow-ups no cambia nada — falta una decisión. */
  const HM_DUDA_DIAS = 30;
  function hmEsDudosa(d, days){
    if (stageOf(d.stage) !== 'propuesta') return false;
    if ((days == null ? dealStageDays(d) : days) <= HM_DUDA_DIAS) return false;
    if (!dlTasksAt) return false;                       // sin el cache de tasks no se sabe
    const r = leadById(d.lead_id) || {};
    return !dlTasksMap[String(d.lead_id)] && !r.next_follow_up_at;
  }
  function hmAliveItems(){
    return (dealsList || [])
      .filter((d) => !d.archived && !d.synthetic && hmEsDudosa(d, null))
      .map((d) => ({ d, dias: dealStageDays(d) }))
      .sort((a, b) => b.dias - a.dias);
  }
  function hmRenderAlive(){
    const box = $('hm-alive'), pan = $('hm-alive-panel'); if (!box || !pan) return;
    const items = hmAliveItems();
    pan.hidden = !items.length;
    if (!items.length) return;
    $('hm-alive-n').textContent = '(' + items.length + ')';
    box.innerHTML = items.slice(0, 6).map(({ d, dias }, i) => {
      const r = leadById(d.lead_id) || {};
      const quien = d.title || r.name || r.email || '(deal)';
      const val = dealValue(d);
      return '<div class="hm-alive-row"><div class="hm-alive-q"><b>' + esc(quien) + '</b>' +
        '<small>' + dias + ' días sin respuesta' + (val ? ' · ' + fmtChf(val) : '') + '</small></div>' +
        '<div class="hm-alive-b">' +
          '<button class="btn btn-ghost small" data-viva="' + i + '" type="button">Sigue viva</button>' +
          '<button class="btn btn-ghost small" data-luego="' + i + '" type="button">Más adelante</button>' +
          '<button class="btn btn-ghost small danger" data-perd="' + i + '" type="button">Se perdió</button>' +
        '</div></div>';
    }).join('');
    const de = (b, k) => items[+b.dataset[k]];
    // "Sigue viva" no cambia el estado: lo que falta es una fecha, no una etiqueta.
    // Abre la ficha en el composer de tasks para poner el próximo contacto.
    box.querySelectorAll('[data-viva]').forEach((b) => b.addEventListener('click', () => {
      const it = de(b, 'viva'); if (!it) return;
      lm2Tab = 'task'; lm2CompCollapsed = false;
      if (it.d.lead_id) openLead(it.d.lead_id); else gotoTab('deals');
    }));
    box.querySelectorAll('[data-luego]').forEach((b) => b.addEventListener('click', async () => {
      const it = de(b, 'luego'); if (!it) return;
      if (await setDealStage(it.d.id, 'seguimiento_futuro')) { toast('Guardado — vuelve solo cuando toque'); renderHome(); }
    }));
    box.querySelectorAll('[data-perd]').forEach((b) => b.addEventListener('click', async () => {
      const it = de(b, 'perd'); if (!it) return;
      if (await setDealStage(it.d.id, 'perdido')) { toast('Marcado como perdido'); renderHome(); }
    }));
  }

  /* ================= POPUP DE FOLLOW-UP =================
     Se abre desde Hoy sin salir de la pantalla: contexto arriba, el borrador ya
     escrito, y mandar. La ficha completa sigue estando a un click por si hace falta.
     Nada sale sin que Sebastián toque Enviar — igual que en la ficha. */
  let fuLead = null, fuCtx = null;
  const fuCerrar = () => { const m = $('fu-modal'); if (m) m.hidden = true; };
  function fuAbrir(leadId, ctx){
    const r = (allLeads || []).find((l) => String(l.id) === String(leadId));
    if (!r){ toast('No encontré a esa persona'); return; }
    if (!r.email){ toast('Ese contacto no tiene email — abrí la ficha'); openLead(leadId); return; }
    fuLead = r; fuCtx = ctx || {};
    const m = $('fu-modal'); if (!m) return;
    const dom = leadDomain(r);
    $('fu-quien').textContent = r.name || r.email;
    $('fu-donde').textContent = [(dom && companyName(dom)) || r.company || '', r.email].filter(Boolean).join(' · ');
    // remitentes: los mismos del resto del dashboard
    const sel = $('fu-de');
    sel.innerHTML = (TEAM || []).map((t) => '<option value="' + esc(t.email.split('@')[0]) + '">' + esc(t.name) + '</option>').join('')
      || '<option value="sofia">Sofia</option>';
    $('fu-subj').value = ''; $('fu-body').value = ''; $('fu-hint').value = '';
    $('fu-ctx').innerHTML = '<div><i>⏳</i><span>Buscando la conversación…</span></div>';
    m.hidden = false;
    fuCargar();
  }
  async function fuCargar(){
    const r = fuLead; if (!r) return;
    const cuerpo = $('fu-body'); cuerpo.value = ''; cuerpo.placeholder = 'Escribiendo el borrador…';
    // contexto real: propuesta/oferta esperando, emails cruzados, última nota
    const [{ data: hist }, { data: notas }] = await Promise.all([
      supabase.from('email_log').select('direction,subject,body,created_at').eq('lead_id', String(r.id)).order('created_at', { ascending: true }).limit(20),
      supabase.from('lead_notes').select('body,created_at').eq('lead_id', String(r.id)).order('created_at', { ascending: false }).limit(1),
    ]);
    const prop = (propsAll || []).find((x) => String(x.lead_id) === String(r.id) && x.status === 'sent' && !x.archived);
    const ofer = (offersList || []).find((x) => String(x.lead_id) === String(r.id) && x.status === 'sent' && !x.archived);
    const deal = (dealsList || []).find((x) => String(x.lead_id) === String(r.id) && !x.archived && DL_OPEN.includes(stageOf(x.stage)));
    const ctx = [];
    if (prop) ctx.push('<div><i>📄</i><span>Propuesta <b>' + esc(prop.title || 'sin título') + '</b>' +
      (prop.published_at ? ' · publicada hace ' + Math.floor((Date.now() - Date.parse(prop.published_at)) / 864e5) + ' d' : '') +
      (prop.views ? ' · <b>vista ' + prop.views + ' ' + (prop.views === 1 ? 'vez' : 'veces') + '</b>' : ' · sin vistas todavía') + '</span></div>');
    else if (ofer) ctx.push('<div><i>🧾</i><span>Oferta <b>' + esc(ofer.title || ofer.number || '') + '</b> enviada</span></div>');
    const nIn = (hist || []).filter((h) => h.direction === 'in').length;
    ctx.push('<div><i>✉️</i><span><b>' + (hist || []).length + ' emails</b> en la conversación' +
      (nIn ? ' — ' + nIn + ' de ' + (r.name ? r.name.split(' ')[0] : 'ellos') : ' — todavía no contestaron') + '</span></div>');
    /* ===== LO QUE ESCRIBIÓ, con sus palabras =====
       El bloque decía "3 emails en la conversación" y nada más: para saber QUÉ
       pidieron había que abrir la ficha, o sea salir de acá — justo lo que el popup
       vino a evitar. Y sin leer lo que escribieron no se puede juzgar si el borrador
       de la IA contesta lo que preguntaron. (Sebastián, 25 ago: "mostrá lo que
       escribió el cliente para entender mejor lo que respondemos".)
       Se muestra el último mensaje ENTRANTE; si nunca escribió por email —un lead
       del formulario— se muestra lo que dejó en el formulario, que es lo mismo con
       otro sobre. */
    const ultimoIn = (hist || []).filter((h) => h.direction === 'in').slice(-1)[0];
    const delForm = !ultimoIn && String(r.message || '').trim() && !/^🧮|^Newsletter signup$/.test(String(r.message).trim());
    if (ultimoIn || delForm){
      const crudo = ultimoIn ? String(ultimoIn.body || '') : String(r.message || '');
      /* fuera las citas del hilo (">" y "El ... escribió:"): en una respuesta larga,
         lo nuevo son las primeras líneas y el resto es lo que ya mandamos nosotros */
      const limpio = crudo
        .split(/\n\s*(?:>|El .{0,40} escribió:|On .{0,40} wrote:|Am .{0,40} schrieb:|-{3,}\s*Forwarded)/)[0]
        .replace(/\s+/g, ' ').trim();
      const corte = 420;
      const txt = limpio.length > corte ? limpio.slice(0, corte) + '…' : limpio;
      if (txt){
        ctx.push('<div class="fu-dijo"><i>💬</i><div>' +
          '<b>' + (ultimoIn ? 'Lo último que escribió' + (ultimoIn.created_at ? ' · ' + timeAgo(ultimoIn.created_at) : '')
                            : 'Lo que dejó en el formulario') +
          (ultimoIn && ultimoIn.subject ? ' · <span class="fu-asunto">' + esc(ultimoIn.subject) + '</span>' : '') + '</b>' +
          '<blockquote>' + esc(txt) + '</blockquote></div></div>');
      }
    }
    if (notas && notas[0]) ctx.push('<div><i>📝</i><span>Tu nota: ' + esc(String(notas[0].body).slice(0, 120)) + '</span></div>');
    if (deal) ctx.push('<div><i>🤝</i><span>Deal en <b>' + esc((STAGES.find((x) => x.key === stageOf(deal.stage)) || {}).label || '') + '</b>' +
      (dealValue(deal) ? ' · ' + fmtChf(dealValue(deal)) : '') + '</span></div>');
    ctx.push('<div><i>👤</i><span><a href="#" id="fu-ficha" style="color:var(--acid)">Abrir la ficha completa →</a></span></div>');
    $('fu-ctx').innerHTML = ctx.join('');
    const fl = $('fu-ficha'); if (fl) fl.addEventListener('click', (e) => { e.preventDefault(); fuCerrar(); openLead(r.id); });
    fuEscribir(hist);
  }
  async function fuEscribir(hist){
    const r = fuLead; if (!r) return;
    const b = $('fu-redo'), prev = b ? b.textContent : '';
    if (b){ b.disabled = true; b.textContent = '✨ Escribiendo…'; }
    try {
      let h = hist;
      if (!h){ const q = await supabase.from('email_log').select('direction,subject,body,created_at').eq('lead_id', String(r.id)).order('created_at', { ascending: true }).limit(20); h = q.data; }
      const history = (h || []).map((x) => ({ direction: x.direction, subject: x.subject, body: String(x.body || '').replace(/<[^>]+>/g, ' ').slice(0, 800) }));
      const brief = briefFullText(await latestBriefFor(r));
      const { data, error } = await supabase.functions.invoke('ai-email-draft', {
        body: { lead: r, sender: $('fu-de').value, hint: ($('fu-hint').value || '').trim(), history, brief }
      });
      if (error || data?.error) throw new Error(data?.error || error?.message || 'sin respuesta');
      $('fu-subj').value = data.subject || '';
      $('fu-body').value = data.body || '';
    } catch (e) {
      $('fu-body').placeholder = '';
      toast('No se pudo escribir el borrador: ' + (e.message || e) + ' — podés escribirlo a mano');
    } finally { if (b){ b.disabled = false; b.textContent = prev || '↻ Reescribir'; } }
  }
  async function fuEnviar(){
    const r = fuLead; if (!r) return;
    const cuerpo = ($('fu-body').value || '').trim();
    const asunto = ($('fu-subj').value || '').trim();
    if (!cuerpo){ toast('El email está vacío'); return; }
    if (!asunto){ toast('Falta el asunto'); return; }
    if (!confirm('¿Enviar este email a ' + r.email + '?\n\nSale desde info@viven.ch.')) return;
    const b = $('fu-send'); b.disabled = true; b.textContent = '📨 Enviando…';
    try {
      const de = $('fu-de').value;
      const { data, error } = await supabase.functions.invoke('send-outreach', {
        body: { to: r.email, subject: asunto, body: cuerpo, lead_id: r.id, mark_contacted: true,
                fromName: (SENDERS[de] || SENDERS.sofia).name }
      });
      if (error || !data || !data.ok) throw new Error(data?.error || error?.message || 'sin respuesta');
      r.status = 'contactado';
      toast('✓ Enviado — quedó en la conversación de ' + (r.name || r.email));
      fuCerrar(); renderLeads(); renderHome();
    } catch (e) { toast('No se pudo enviar: ' + (e.message || e)); }
    finally { b.disabled = false; b.textContent = '📨 Enviar'; }
  }
  document.addEventListener('click', (e) => { if (e.target && e.target.closest && e.target.closest('[data-fu-close]')) fuCerrar(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && $('fu-modal') && !$('fu-modal').hidden) fuCerrar(); });
  $('fu-send') && $('fu-send').addEventListener('click', fuEnviar);
  $('fu-redo') && $('fu-redo').addEventListener('click', () => fuEscribir(null));

  // "🎯 Para hoy": UNA lista por urgencia — cada fila sabe abrir lo suyo (openLead/openOffer/gotoTab)
  function hmTodayItems(){

    /* LO DE PRUEBA NO ENTRA EN «HOY». Un proyecto, una oferta o una propuesta de prueba
       generan avisos idénticos a los reales, y el que los mira no tiene cómo distinguirlos:
       el 1202 —«Proyecto de prueba x1»— puso durante días un aviso ROJO arriba de todo por
       un rodaje que no existe.
       Se usa esDePrueba(), el helper global, y NO una copia local: la primera versión lo
       declaró acá adentro y hmSignalItems() —que es otra función— lo llamaba igual. Eso es
       un ReferenceError que rompe las señales enteras, no una línea. Lo cazó el propio
       dash_perf_log de la app, no el build.
       El filtro va en cada punto donde se MUESTRA, y nunca al entrar a memoria: sacar las
       pruebas de la lista al cargarla ya rompió el portal y el brief, porque esa misma
       lista es de donde el proyecto saca su token. Ver filtrar-pruebas-rompe-lo-que-no-es-plata. */
    const _pruebaIds = new Set((leadsPrueba || []).map((l) => String(l.id)));
    const now = Date.now(), D = 864e5, items = [];
    const busyLeads = new Set();   // leads ya cubiertos por (a)/(b): no repetir al mismo cliente en (c)
    // (a) ofertas enviadas esperando >10d (si abrió el email hace poco → seguir HOY)
    (offersList || []).filter((o) => !o.archived && !o.is_template && o.status === 'sent' && !esDePrueba(o)).forEach((o) => {
      const ref = Date.parse(o.sent_at || o.updated_at); if (!ref) return;
      const days = Math.floor((now - ref) / D); if (days <= 10) return;
      const l = leadById(o.lead_id) || {};
      const opened = o.last_open_at && (now - Date.parse(o.last_open_at)) < 2 * D;
      if (o.lead_id) busyLeads.add(String(o.lead_id));
      items.push({ rank: opened ? -1 : 0, sev: 'rojo', icon: '🧾', at: ref, leadId: o.lead_id || null,
        chf: offerNet(o), dias: days, urgente: !!opened,
        t: o.title || ('Oferta ' + (o.number || '#' + o.id)),
        ctx: [l.name || l.email || o.client || '', days + ' d esperando'].filter(Boolean).join(' · ') +
          (opened ? ' · abrió el email hace ' + timeAgo(o.last_open_at) + ' → seguir HOY' : ''),
        /* Antes esto te mandaba a la pestaña de Ofertas y ahí tenías que buscar y
           escribir de cero. Ahora abre el popup con el borrador ya hecho, sin salir
           de Hoy (pedido de Sebastián). Sin lead_id no hay a quién escribirle: en ese
           caso se mantiene el camino viejo. */
        acts: hmActHecho(o.lead_id, 'oferta «' + (o.title || '') + '»', true, { tipo: 'oferta', id: o.id }),
        hint: 'Follow-up →', go: () => (o.lead_id ? fuAbrir(o.lead_id, { tipo: 'oferta', id: o.id })
                                                  : (gotoTab('offers'), openOffer(o.id))) });
    });
    // (b) propuestas publicadas: >8d sin respuesta (rojo) / >2d con 0 vistas (azul: ¿le llegó el link?)
    (propsAll || []).filter((p) => !p.archived && !p.is_template && p.status === 'sent' && !esDePrueba(p)).forEach((p) => {
      const ref = Date.parse(p.published_at || p.updated_at); if (!ref) return;
      const days = Math.floor((now - ref) / D);
      const l = leadById(p.lead_id) || {};
      const goP = p.lead_id ? () => openLead(p.lead_id) : () => gotoTab('props');
      if (days > 8){
        if (p.lead_id) busyLeads.add(String(p.lead_id));
        items.push({ rank: 1, sev: 'rojo', icon: '🌐', at: ref, leadId: p.lead_id || null, chf: propNet(p), dias: days, t: p.title || 'Propuesta',
          ctx: [l.name || l.email || '', days + ' d sin respuesta'].filter(Boolean).join(' · '),
          acts: hmActHecho(p.lead_id, 'propuesta «' + (p.title || '') + '»', true, { tipo: 'propuesta', id: p.id }),
          hint: 'Follow-up →', go: () => (p.lead_id ? fuAbrir(p.lead_id, { tipo: 'propuesta', id: p.id }) : goP()) });
      } else if (days > 2 && !p.last_view_at){
        items.push({ rank: 5, sev: 'azul', icon: '👁', at: ref, leadId: p.lead_id || null, chf: propNet(p), dias: days, t: p.title || 'Propuesta',
          ctx: [l.name || l.email || '', days + ' d · 0 vistas — ¿le llegó el link?'].filter(Boolean).join(' · '),
          acts: hmActHecho(p.lead_id, 'propuesta sin abrir', true, { tipo: 'propuesta', id: p.id }),
          hint: 'Reenviar →', go: goP });
      }
    });
    // (c) deals estancados >14d SIN próximo paso — solo con el cache de tasks ya cargado
    //     (si no, marcaría "sin próximo paso" a todos en el primer render)
    if (dlTasksAt){
      (dealsList || []).filter((d) => !d.archived && DL_OPEN.includes(stageOf(d.stage))).forEach((d) => {
        const days = dealStageDays(d); if (days <= 14) return;
        // los de más de 30 días en "propuesta" tienen su propio bloque (¿siguen vivas?):
        // ahí la pregunta no es "definí un paso" sino "decidí qué es esto"
        if (hmEsDudosa(d, days)) return;
        if (busyLeads.has(String(d.lead_id))) return;
        const r = leadById(d.lead_id) || {};
        /* Solo silencia si la fecha todavía no llegó. Con `r.next_follow_up_at` a secas,
           marcar «hecho» lo callaba PARA SIEMPRE: la fecha se cumplía y el aviso no volvía
           nunca, que es peor que molestar.
           (Sebastián, 27 ago 2026: "una vez que ponemos hecho, hace un nuevo reminder en 7
            días si no escuchamos nada del cliente".) */
        if (dlTasksMap[String(d.lead_id)] || pendienteAun(r.next_follow_up_at)) return;
        const stLabel = (STAGES.find((s) => s.key === stageOf(d.stage)) || {}).label || '';
        items.push({ rank: 2, sev: 'rojo', icon: '🤝', at: now - days * D, leadId: d.lead_id || null, chf: dealValue(d), dias: days, t: d.title || r.name || r.email || '(deal)',
          ctx: days + ' d en ' + stLabel + ' · sin próximo paso',
          acts: hmActHecho(d.lead_id, 'deal parado en ' + stLabel, true, { tipo: 'deal', id: d.id }),
          hint: 'Definir paso →', go: () => (d.lead_id ? openLead(d.lead_id) : gotoTab('deals')) });
      });
    }
    // (d) leads nuevos sin contactar <72h (los manuales los cargamos nosotros — no urgen)
    (allLeads || []).filter((l) => !/^claude-/.test(l.session_id || '') && !esInterno(l.email)
      && isNew(l.status) && l.channel !== 'manual' && (now - Date.parse(l.created_at)) < 72 * 36e5).forEach((l) => {
      items.push({ rank: 3, sev: 'ambar', icon: '📥', at: Date.parse(l.created_at), leadId: l.id, chf: 0,
        dias: Math.floor((now - Date.parse(l.created_at)) / D),
        /* la pelota es nuestra: preguntó y está esperando */
        espera: true,
        t: l.name || l.email || '(lead)',
        ctx: 'lead nuevo hace ' + timeAgo(l.created_at) + ' · sin contactar',
        /* Antes esto te mandaba a la ficha y ahí escribías de cero. Las propuestas y
           las ofertas ya abrían el popup con el borrador hecho; los leads nuevos no,
           que son justo los que más rápido hay que contestar. (Sebastián, 25 ago:
           "me sale contactar con gente nueva pero no me da popup con respuesta
           automática".) Sin email no hay a quién escribirle: ahí sí va la ficha. */
        acts: hmActHecho(l.id, 'lead nuevo', !!l.email, { tipo: 'lead_nuevo', id: l.id }),
        hint: 'Contactar →', go: () => (l.email ? fuAbrir(l.id, { tipo: 'lead_nuevo', id: l.id }) : openLead(l.id)) });
    });
    /* (0) LO QUE TIENE HORA FIJA EN LAS PRÓXIMAS 24 h.
       Sebastián: "¿por qué no ponemos la agenda en Hoy? Así tenemos real overview".
       Tiene razón: una reunión a las 10 es literalmente "lo que hay que hacer ahora",
       y hasta ahora Hoy no la mencionaba — vivía en otra pestaña.
       Va como FILA de la lista única, no como panel nuevo: la pantalla ya se ordenó
       una vez para tener una sola lista y no la vamos a volver a partir.
       Y va PRIMERO de todo, que es la única excepción al orden por plata en toda la
       pantalla. Se justifica sola: una propuesta de CHF 17'700 se puede seguir a las
       18:00 y sigue valiendo lo mismo; una reunión a las 10:00 no se puede hacer a
       las 18:00. La hora fija no se negocia con la plata.
       Solo 24 h: más adelante que eso no es "hoy" y ya está en la Agenda. */
    (upBookings || []).filter((b) => !esDePrueba(b)).forEach((b) => {
      const t = Date.parse(b.start_at); if (!t) return;
      if (t < now - 36e5 || t > now + 24 * 36e5) return;   // desde hace 1 h (por si está en curso) hasta mañana
      if (meEmail && b.host_email && String(b.host_email).toLowerCase() !== meEmail) return;
      const d = new Date(t);
      const hora = d.toLocaleTimeString('es-CH', { hour: '2-digit', minute: '2-digit' });
      const dia = t < now + (24 - d.getHours()) * 36e5 && d.toDateString() === new Date(now).toDateString() ? 'hoy' : 'mañana';
      items.push({ rank: -3, sev: 'azul', icon: '📅', at: t, chf: 0, fija: true,
        t: (b.name || b.email || 'Video call') + ' — ' + hora,
        ctx: 'video call ' + dia + ' · ' + (b.duration_m || 15) + ' min' + (b.meet_url ? ' · Meet' : ''),
        hint: b.meet_url ? 'Abrir Meet →' : 'Ver ficha →',
        go: () => { if (b.meet_url) window.open(b.meet_url, '_blank', 'noopener'); else if (b.lead_id) openLead(b.lead_id); } });
    });

    /* (c bis) RODAJE EN LOS PRÓXIMOS DÍAS CON ALGO QUE FALTA.
       Va arriba de todo —rank -4— porque tiene fecha de vencimiento real: un follow-up se
       puede hacer mañana, un teléfono que falta el día del rodaje ya no se consigue. */
    (hmRodajes || []).filter((r) => !esDePrueba(r.p)).forEach((r) => {
      /* CON NOMBRE Y APELLIDO. «4 sin teléfono» te obliga a entrar al proyecto y comparar
         la lista a mano para saber a quién llamar; los nombres dejan el aviso accionable
         desde donde estás. Se cortan en tres para que la fila siga siendo una línea. */
      const quienes = (lista) => {
        const ns = lista.map((c) => String(c.nombre || '').split(' ')[0]).filter(Boolean);
        return ns.length <= 3 ? ns.join(', ') : ns.slice(0, 3).join(', ') + ' y ' + (ns.length - 3) + ' más';
      };
      const faltan = [];
      if (r.sinTel.length) faltan.push('sin teléfono: ' + quienes(r.sinTel));
      if (r.sinMail.length) faltan.push('sin email: ' + quienes(r.sinMail));
      if (r.sinLoc) faltan.push('sin locación');
      if (!r.crew.length) faltan.push('sin crew armado');
      if (!faltan.length) return;
      const cuando = r.dias === 0 ? 'HOY' : r.dias === 1 ? 'MAÑANA' : 'en ' + r.dias + ' días';
      /* Con el atajo a lo que falta: si lo que falta son contactos, el camino corto es el
         importador de Técnicos, no el proyecto. Un aviso que solo señala el problema
         obliga a buscar dónde se arregla. */
      const faltanDatos = r.sinTel.length || r.sinMail.length;
      items.push({ rank: -4, sev: 'rojo', icon: '🎬', at: Date.parse(r.p.shoot_start + 'T06:00:00'), chf: 0, fija: true,
        t: 'Rodás ' + cuando + ' — ' + (r.p.title || 'proyecto ' + r.p.ref),
        ctx: faltan.join(' · ') + (r.crew.length ? ' · de ' + r.crew.length + ' del equipo' : '') + '. Sin eso no les llega el plan.',
        acts: faltanDatos
          ? [{ label: '📥 Cargar contactos', cls: 'btn-primary',
               title: 'Traerlos de Personas o pegar la lista',
               fn: async () => { gotoTab('crew'); await crewLoad(); ciAbrir(); } }]
          : null,
        hint: 'Abrir el proyecto →',
        go: () => { gotoTab('projects'); abrirProyectoPorRef(r.p.ref || r.p.id); } });
    });

    /* (c ter) EL PAPEL DICE PERDIDO Y EL DEAL NO.
       Sebastián, 28 ago 2026: "¿por qué no muestra en ningún lado deals perdidos?".
       No los escondía: no estaban marcados. Cinco clientes tenían la oferta o la propuesta
       en «perdida» y solo dos tenían el deal cerrado — Agepa seguía en «contactado» con
       tres ofertas perdidas encima.
       Eso no es un detalle de prolijidad: el win rate se calcula con la ETAPA DEL DEAL, así
       que cada pérdida sin marcar lo infla. Con 1 ganado y 2 perdidos daba 33%; con los 6
       perdidos reales da 14%. Un número que se mira para decidir precios.
       El aviso trae el botón: cerrarlo es un toque, y si no se puede cerrar de un toque no
       se cierra nunca. */
    (dealsList || []).forEach((d) => {
      const et = stageOf(d.stage);
      if (et === 'perdido' || et === 'ganado' || esDePrueba(d)) return;
      const ofs = offersForDeal(d).filter((o) => o.status !== 'tier' && !o.archived && !o.is_template);
      const pps = (propsAll || []).filter((p) => !p.archived && !p.is_template &&
        String(p.lead_id || '') === String(d.lead_id));
      const papeles = ofs.concat(pps);
      if (!papeles.length) return;
      if (!papeles.every((x) => x.status === 'lost')) return;
      const r = leadById(d.lead_id) || {};
      const quien = r.company || r.name || r.email || d.title || 'este deal';
      const cuantos = papeles.length;
      items.push({ rank: -1, sev: 'ambar', icon: '📕', at: now, chf: 0,
        t: quien + ' — ' + (cuantos === 1 ? 'su oferta está perdida' : 'sus ' + cuantos + ' ofertas están perdidas') + ' y el deal sigue en «' + (STAGES.find((x) => x.key === et) || {}).label + '»',
        ctx: 'El win rate se calcula con la etapa del deal, así que mientras no se cierre cuenta como si siguiera vivo.',
        acts: [{ label: '📕 Cerrar como perdido', cls: 'btn-ghost',
                 title: 'Marca el deal como perdido; te va a pedir el motivo',
                 fn: async (b) => { b.disabled = true; await setDealStage(d.id, 'perdido'); renderHome(); } }],
        hint: 'Abrir el deal →',
        go: () => { gotoTab('deals'); openLead(d.lead_id); } });
    });

    /* (d bis) ESCRIBIERON A info@ Y NO ESTÁN EN EL CRM (SQL 0144).
       Va en la misma lista y no en un panel propio: una consulta que entró hoy y
       nadie contestó es exactamente "lo que hay que hacer hoy", y meterla en otra
       pantalla es pedirle a alguien que se acuerde de ir a mirarla. Sebastián, 25
       ago, después de que le propusiera un panel aparte: "¿en hoy?".
       Es lo más perecedero que hay —alguien preguntó y está esperando— así que
       entra como urgente mientras tenga menos de un día. */
    epGente().forEach((g) => {
      const t = Date.parse(g.received_at || '') || now;
      items.push({ rank: -2, sev: 'azul', icon: '📥', at: t, chf: 0, espera: true,
        t: (g.from_name || g.from_email) + (g.n > 1 ? ' (' + g.n + ' emails)' : ''),
        ctx: 'escribió a info@ hace ' + timeAgo(g.received_at) + ' · ' + (g.subject || 'sin asunto'),
        /* dos botones en vez de un destino: la decisión es sí o no, y las dos
           opciones tienen que estar a un toque. Por eso esta fila no es un <button>
           como las demás (no se pueden anidar botones) sino una fila con acciones. */
        acts: [
          { label: '✓ Es cliente', cls: 'btn-primary', fn: (b) => epAprobar(g, b) },
          { label: '✕', cls: 'btn-ghost', title: 'No es un cliente — no vuelvo a preguntar por esta dirección', fn: (b) => epIgnorar(g, b) },
        ] });
    });
    // (e) tasks para hoy o vencidas, mías o sin asignar (mismo criterio que la campana)
    if (dlTasksAt){
      const t0 = new Date(); t0.setHours(0, 0, 0, 0);
      const tEnd = t0.getTime() + D;
      const mine = (t) => !meEmail || !t.assignee || String(t.assignee).toLowerCase() === meEmail;
      /* Y tampoco la gente importada de bexio: son 167 contactos históricos que se
         trajeron para tener el archivo, no prospectos. Producían 40 de las 45 tareas
         abiertas —«sin contacto hace 5 semanas»— y con eso Hoy dejó de mirarse.
         Las tareas siguen existiendo en su ficha; lo que se apaga es que reclamen atención
         desde acá. OJO: se filtra por el canal de la PERSONA, no por el título, porque
         Sonova también entró por bexio y sus dos avisos de licencia vencida son reales.
         (Sebastián, 2 sep 2026: "dejémoslos dentro pero apagados para no molestar".) */
      const _bexio = new Set((leadsPrueba || []).concat(allLeads || [])
        .filter((l) => l && l.channel === 'bexio-import').map((l) => String(l.id)));
      Object.keys(dlTasksMap)
        .filter((lid) => !_pruebaIds.has(String(lid)) && !_bexio.has(String(lid)))
        .forEach((lid) => {
        const t = dlTasksMap[lid];
        if (!t || !t.due_date || !mine(t)) return;
        const due = new Date(t.due_date + 'T' + (t.due_time || '23:59') + ':00').getTime();
        if (!(due < tEnd)) return;   // hoy o vencida
        const overdue = due < (t.due_time ? now : t0.getTime());
        const l = leadById(lid) || {};
        /* La tarea hereda la plata del contacto. Sin esto, "llamar a Theo" (que tiene
           una propuesta de CHF 17'700 esperando) pesaba lo mismo que una tarea suelta
           sin nada atrás, y las dos se ordenaban por fecha.
           Y OJO: vencida NO es urgente. Lo urgente es lo que se enfría hoy —un lead
           de hace horas, alguien que acaba de abrir el email—. Una tarea vencida hace
           cinco semanas aguanta una más; marcarla urgente hacía que se comiera los
           cuatro lugares visibles y empujara abajo las propuestas grandes. Pasó de
           verdad: la captura de Sebastián del 25/08 abría con dos tareas de CHF 0. */
        items.push({ rank: 4, sev: 'ambar', icon: '✅', at: due, chf: leadValue(l) || 0, t: t.title,
          ctx: [l.name || l.email || '', (overdue ? 'vencida' : 'para hoy') + (t.due_time ? ' · ' + t.due_time : '')].filter(Boolean).join(' · '),
          hint: 'Hacer →', go: () => openLead(lid) });
      });
    }
    /* ===== DE QUIÉN ES LA PELOTA, y después la plata =====
       El mockup que Sebastián eligió dice "ordenada por lo que más plata mueve", y
       eso vale — pero no para todo. Hay dos clases de pendiente distintas:

       · La pelota es NUESTRA: alguien preguntó y está esperando una respuesta. Un
         lead que entró anoche, una consulta a info@ que lleva doce días sin
         contestar. No tienen monto todavía y por eso el orden por plata los hundía
         al fondo, que es justo donde no hay que dejarlos: mientras no contestamos,
         la deuda es nuestra y crece sola.
       · La pelota es de ELLOS: una propuesta enviada, una oferta esperando, un deal
         quieto. Ahí sí manda la plata, porque lo único que cambia entre uno y otro
         es cuánto mueve.

       Arriba van los primeros, y como mucho DOS: si no, una racha de consultas se
       queda con la pantalla entera y las propuestas grandes desaparecen.
       Cuáles dos: el que MÁS espera y el MÁS nuevo. Ordenar solo por antigüedad
       hundía el lead que entró anoche abajo de cuatro propuestas, y contestar rápido
       es la mitad de convertirlo; ordenar solo por lo nuevo dejaba una consulta de
       doce días pudriéndose para siempre. Uno es el que más riesgo corre, el otro el
       que más chance tiene. El resto se ordena por plata.
       (Antes marcaba "urgentes" también a las tareas vencidas, y como hay varias y
       todas valen CHF 0, la pantalla abría con dos tareas de "sin contacto hace 5
       semanas" mientras la propuesta de CHF 17'700 quedaba fuera de vista.) */
    /* Lo que tiene hora fija va arriba de todo, por hora. Ver el comentario del
       bloque (0): es la única excepción al orden por plata, y dura 24 horas. */
    const fijas = items.filter((x) => x.fija).sort((a, b) => a.at - b.at);
    const porEdad = items.filter((x) => x.espera && !x.fija).sort((a, b) => a.at - b.at);
    const arriba = [];
    if (porEdad.length) arriba.push(porEdad[0]);                                  // el que más espera
    if (porEdad.length > 1) arriba.push(porEdad[porEdad.length - 1]);             // el más nuevo
    const resto = items.filter((x) => !x.fija && !arriba.includes(x));
    resto.sort((a, b) => ((b.chf || 0) - (a.chf || 0)) || (a.rank - b.rank) || (a.at - b.at));
    return fijas.concat(arriba, resto);
  }

  // "🔥 Señales calientes": aperturas de propuesta/oferta <48h + leads conocidos que volvieron a la web <24h
  function hmSignalItems(){
    const now = Date.now(), H48 = 48 * 36e5, sig = [];
    (propsAll || []).filter((p) => !p.archived && !p.is_template && !esDePrueba(p) && p.last_view_at && now - Date.parse(p.last_view_at) < H48).forEach((p) => {
      const l = leadById(p.lead_id) || {};
      const who = l.name || l.email || 'Alguien';
      const nth = Number(p.view_count) > 1 ? ' · ' + p.view_count + 'ª vista' : '';
      sig.push({ at: Date.parse(p.last_view_at), icon: '🌐', lead: p.lead_id, t: who + ' abrió la propuesta',
        ctx: (p.title || '(sin título)') + ' · hace ' + timeAgo(p.last_view_at) + nth,
        plain: who + ' abrió la propuesta «' + (p.title || '') + '» hace ' + timeAgo(p.last_view_at) });
    });
    (offersList || []).filter((o) => !o.archived && !o.is_template && !esDePrueba(o) && o.last_open_at && now - Date.parse(o.last_open_at) < H48).forEach((o) => {
      const l = leadById(o.lead_id) || {};
      const who = l.name || l.email || o.client || 'Alguien';
      sig.push({ at: Date.parse(o.last_open_at), icon: '🧾', lead: o.lead_id, t: who + ' abrió el email de la oferta',
        ctx: (o.title || o.number || '(sin título)') + ' · hace ' + timeAgo(o.last_open_at),
        plain: who + ' abrió el email de la oferta «' + (o.title || '') + '» hace ' + timeAgo(o.last_open_at) });
    });
    // web: sesiones de lastViews que pertenecen al session_id de un lead conocido (últimas 24h)
    const byS = {}; (allLeads || []).forEach((l) => { if (l.session_id && !/^claude-/.test(l.session_id)) byS[l.session_id] = l; });
    const acc = {};
    (lastViews || []).forEach((v) => {
      const l = v.session_id && byS[v.session_id]; if (!l) return;
      const t = Date.parse(v.created_at); if (!t || now - t > 864e5) return;
      const k = String(l.id); acc[k] = acc[k] || { l, n: 0, at: 0 };
      acc[k].n++; if (t > acc[k].at) acc[k].at = t;
    });
    Object.values(acc).forEach((c) => {
      const who = c.l.name || c.l.email || 'Un contacto';
      sig.push({ at: c.at, icon: '👀', lead: c.l.id, t: who + ' volvió a la web',
        ctx: c.n + ' página' + (c.n === 1 ? '' : 's') + ' · hace ' + timeAgo(new Date(c.at).toISOString()),
        plain: who + ' volvió a la web (' + c.n + ' páginas) hace ' + timeAgo(new Date(c.at).toISOString()) });
    });
    return sig.sort((a, b) => b.at - a.at);
  }

  /* "Ya lo seguí". Los avisos de Hoy se silencian solos cuando el contacto tiene una
     próxima fecha de seguimiento —esa condición ya existía— pero no había manera de
     ponerla desde Hoy: había que entrar a la ficha, buscar el campo y volver. Así que el
     mismo aviso volvía todos los días aunque lo hubieras hecho.
     Deja rastro además de silenciar: dentro de un mes, "¿a este lo seguimos?" se contesta
     mirando sus notas.
     (Sebastián, 27 ago 2026: "¿cómo marcar follow up hecho en hoy para q deje de
      molestar?") */
  async function hmSeguimientoHecho(leadId, btn, queEra){
    if (!leadId){ toast('Este aviso no tiene contacto asociado'); return; }
    const dias = 7;
    const cuando = new Date(Date.now() + dias * 86400000).toISOString().slice(0, 10);
    if (btn){ btn.disabled = true; btn.textContent = '…'; }
    try {
      const { error } = await supabase.from('leads')
        .update({ next_follow_up_at: cuando }).eq('id', String(leadId));
      if (error) throw new Error(error.message);
      await supabase.from('lead_notes').insert({
        lead_id: String(leadId),
        author: meEmail || 'dashboard',
        body: '✓ Seguimiento hecho' + (queEra ? ' — ' + queEra : '') + '. Vuelve a aparecer el ' + fmtDMY(cuando) + '.',
      });
      const l = leadById(leadId);
      if (l) l.next_follow_up_at = cuando;
      toast('✓ Anotado — no vuelve a aparecer hasta el ' + fmtDMY(cuando));
      hmTodayCur = hmTodayItems();
      $('hm-today-n').textContent = hmTodayCur.length ? '(' + hmTodayCur.length + ')' : '';
      hmRenderToday(hmTodayCur);
    } catch (e){
      toast('⚠️ ' + (e.message || e));
      if (btn){ btn.disabled = false; btn.textContent = '✓ Hecho'; }
    }
  }

  /* El botón va en todo aviso que sea un seguimiento de una persona. */
  /* Dos botones, no uno. «Hecho» solo servía para el caso en que ya lo seguiste por fuera
     —una llamada, un WhatsApp—, pero el aviso dice «sin próximo paso»: lo que hay que hacer
     es mandar el follow-up, no declararlo hecho. Poner el descarte como única acción invita
     a silenciar avisos en vez de trabajarlos.
     El follow-up va primero y resaltado; «Hecho» queda al lado, en gris.
     (Sebastián, 27 ago 2026: "acá ofrecería follow up, ¿o hecho?") */
  const hmActHecho = (leadId, queEra, conFollowUp, tipo) => {
    if (!leadId) return null;
    const acts = [];
    if (conFollowUp){
      acts.push({ label: '📤 Follow-up', cls: 'btn-primary',
        title: 'Escribirle ahora — se abre el borrador con la IA',
        fn: () => fuAbrir(leadId, tipo || { tipo: 'lead_nuevo', id: leadId }) });
    }
    acts.push({ label: '✓ Hecho', cls: 'btn-ghost',
      title: conFollowUp ? 'Ya le escribí por otro lado — que no vuelva por una semana'
                         : 'Ya lo seguí — que no vuelva a aparecer por una semana',
      fn: (b) => hmSeguimientoHecho(leadId, b, queEra) });
    return acts;
  };

  /* «Tiene un seguimiento agendado que todavía no venció». Una fecha pasada NO silencia:
     el día que se cumple, el aviso vuelve. */
  function pendienteAun(fecha){
    if (!fecha) return false;
    const t = Date.parse(String(fecha).length <= 10 ? fecha + 'T23:59:59' : fecha);
    return isFinite(t) && t > Date.now();
  }

  function hmRenderToday(items){
    const box = $('hm-today'); if (!box) return;
    hmTodayCur = items;
    /* Cuatro, no ocho (mockup aprobado). Una lista de 21 no se termina nunca: se mira
       una vez y se deja de mirar. Las demás siguen a un click. */
    const VISIBLES = 4;
    /* La plata en juego va A LA VISTA en cada fila. Si la lista se ordena por eso,
       el número tiene que estar: si no, el orden parece arbitrario y la primera
       reacción es desconfiar de él. Los días también — son la otra mitad de la
       decisión ("20 d sin respuesta" pesa distinto que "2 d"). */
    /* El monto va apilado sobre la acción, en el canal derecho que ya estaba medio
       vacío. Probé las otras dos formas en pantalla: como columna propia le comía el
       ancho al título ("Syz Capital AG - Podcast Post-Pro…") y metido en la línea de
       contexto se partía en dos renglones dejando un "·" suelto al empezar el
       segundo. Acá no compite con nada y las cifras quedan alineadas en columna. */
    const fila = (it, i) => it.acts
      /* SE PUEDE TOCAR, Y AHORA SE NOTA. Esta variante —la que trae botones de acción— ya
         llevaba al lugar exacto al hacerle click, pero decía `cursor:default` y no mostraba
         la flecha que muestran las otras: parecía un cartel y no un camino, así que nadie
         la tocaba. El texto es el que navega; los botones cortan la propagación.
         (Sebastián, 2 sep 2026: "en hoy, que todos los items me lleven a los items en
         cuestión".) */
      ? '<div class="hm-item hm-item-acts ' + it.sev + '" data-i="' + i + '" role="button" tabindex="0"' +
        (it.hint ? ' title="' + esc(it.hint.replace(/\s*→\s*$/, '')) + '"' : '') + '>' +
        '<span class="ic">' + it.icon + '</span>' +
        '<span class="tx"><b>' + esc(it.t) + '</b><small>' + esc(it.ctx) + '</small></span>' +
        /* El monto también en la variante con botones: si no, agregarle un «✓ Hecho» a un
           aviso le borraba la plata que tiene en juego, que es lo que ordena la lista. */
        (it.chf ? '<b class="hm-chf">' + fmtChf(Math.round(it.chf)) + '</b>' : '') +
        (it.hint ? '<span class="go go-acts">' + it.hint + '</span>' : '') +
        '<span class="hm-acts">' + it.acts.map((a, j) =>
          '<button class="btn ' + a.cls + ' small" data-act="' + i + ':' + j + '" type="button"' +
          (a.title ? ' title="' + esc(a.title) + '"' : '') + '>' + a.label + '</button>').join('') +
        '</span></div>'
      : '<button class="hm-item ' + it.sev + '" type="button" data-i="' + i + '">' +
        '<span class="ic">' + it.icon + '</span>' +
        '<span class="tx"><b>' + esc(it.t) + '</b><small>' + esc(it.ctx) + '</small></span>' +
        '<span class="hm-right">' +
          (it.chf ? '<b class="hm-chf">' + fmtChf(Math.round(it.chf)) + '</b>' : '') +
          '<span class="go">' + it.hint + '</span></span></button>';
    box.innerHTML = items.slice(0, VISIBLES).map(fila).join('') || '<p class="muted-note">Todo al día 🎉</p>';
    if (items.length > VISIBLES){
      box.innerHTML += '<button class="hm-more" id="hm-today-more" type="button">ver las otras ' + (items.length - VISIBLES) + ' →</button>';
    }
    const enganchar = () => {
      box.querySelectorAll('.hm-item[role="button"]').forEach((b) => b.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); b.click(); }
      }));
      box.querySelectorAll('.hm-item').forEach((b) => b.addEventListener('click', () => { const it = hmTodayCur[+b.dataset.i]; if (it && it.go) it.go(); }));
      box.querySelectorAll('[data-act]').forEach((b) => b.addEventListener('click', (e) => {
        e.stopPropagation();
        const [i, j] = b.dataset.act.split(':').map(Number);
        const a = hmTodayCur[i] && hmTodayCur[i].acts && hmTodayCur[i].acts[j];
        if (a && a.fn) a.fn(b);
      }));
    };
    enganchar();
    /* "Ver las otras" ahora despliega acá mismo. Antes te mandaba a la pestaña de
       Deals, que es otra pantalla con otro orden: perdías las cuatro que estabas
       mirando y tenías que volver a encontrar dónde ibas. */
    const more = $('hm-today-more');
    if (more) more.addEventListener('click', () => {
      box.innerHTML = items.map(fila).join('');
      enganchar();
    });
  }

