  /* ---------- ANALYTICS ---------- */
  function countBy(rows, key){
    const m = new Map();
    rows.forEach((r) => {
      const k = r[key] || '(sin dato)';
      m.set(k, (m.get(k) || 0) + 1);
    });
    return [...m.entries()].sort((a, b) => b[1] - a[1]);
  }
  function bars(el, entries, max, valFmt){
    const top = entries.slice(0, max || 10);
    const peak = top.length ? top[0][1] : 1;
    el.innerHTML = top.map(([k, v, extra]) =>
      '<div class="bar-row"><span class="lbl" title="' + esc(k) + '">' + esc(k) + '</span>' +
      '<span class="track"><span class="fill" style="width:' + Math.max(2, Math.round((v / peak) * 100)) + '%"></span></span>' +
      '<span class="val">' + (valFmt ? valFmt(v, extra) : v) + '</span></div>'
    ).join('') || '<p class="muted-note">Sin datos todavía.</p>';
  }

  /* tabla de rendimiento: canal/página → sesiones, leads y % de conversión */
  // clickable: 'channel' | 'landing' — qué filtro de Personas setea el click en el
  // número de leads (pedido explícito: "eso tiene que ser un shortcut a esos leads,
  // asi entiendo si son buenos o no de ese canal" — antes solo funcionaba en la
  // tabla de Canales, no en "¿Qué páginas convierten?")
  function perfTable(el, list, opts){
    const clickable = opts && opts.clickable;
    const withRate = list.map((r) => ({ ...r, rate: r.sessions ? (r.leads / r.sessions * 100) : 0 }))
      .sort((a, b) => (b.leads - a.leads) || (b.sessions - a.sessions));
    const maxRate = Math.max(1, ...withRate.map((r) => r.rate));
    el.innerHTML = withRate.slice(0, 8).map((r) =>
      '<tr>' +
        '<td>' + (r.badge ? '<span class="badge b-' + esc(r.key) + '">' + esc(r.label) + '</span>' : '<span title="' + esc(r.label) + '">' + esc(r.label) + '</span>') + '</td>' +
        '<td class="num">' + r.sessions + '</td>' +
        '<td class="num">' + (clickable && r.leads
          ? '<span class="lead-n perf-lead-click" data-val="' + esc(r.key) + '" title="Ver estos leads en Personas" style="cursor:pointer;text-decoration:underline dotted">' + r.leads + '</span>'
          : '<span class="lead-n' + (r.leads ? '' : ' zero') + '">' + r.leads + '</span>') + '</td>' +
        '<td class="num"><span class="rate-cell"><span class="rate-bar"><i style="width:' + Math.round((r.rate / maxRate) * 100) + '%"></i></span><span class="rate-num">' + (r.sessions ? r.rate.toFixed(1) + '%' : '—') + '</span></span></td>' +
      '</tr>'
    ).join('') || '<tr><td colspan="4" class="muted-note" style="padding:14px">Sin datos todavía.</td></tr>';
    if (clickable) el.querySelectorAll('.perf-lead-click').forEach((sp) => sp.addEventListener('click', (ev) => {
      ev.stopPropagation();
      if (clickable === 'landing') landingFilter = sp.dataset.val; else channelFilter = sp.dataset.val;
      psStage = 'all';
      gotoTab('leads'); renderLeads();
    }));
  }

  /* ---------- Funnel de ventas: conversión + tiempo entre etapas ---------- */
  function renderFunnel(leads, targetId){
    const set = (leads || []).filter((l) => !/^claude-/.test(l.session_id || ''));
    const steps = [
      { key: 'lead',       label: 'Leads',      ts: (l) => l.created_at },
      { key: 'contactado', label: 'Contactado', ts: (l) => l.contacted_at },
      { key: 'videocall',  label: 'Video Call', ts: (l) => l.videocall_at },
      { key: 'propuesta',  label: 'Propuesta enviada', ts: (l) => l.proposal_at },
      { key: 'ganado',     label: 'Ganado',     ts: (l) => l.won_at },
    ];
    const rows = steps.map((s) => ({ ...s, n: set.filter((l) => s.ts(l)).length, list: set.filter((l) => s.ts(l)) }));
    const top = Math.max(1, rows[0].n);
    const fmtDur = (d) => d >= 14 ? (d / 7).toFixed(1) + ' sem' : d.toFixed(1) + ' d';
    let html = '';
    rows.forEach((s, i) => {
      const prev = i ? rows[i - 1].n : s.n;
      const conv = i ? (prev ? Math.round(s.n / prev * 100) : 0) : 100;
      let avg = '—';
      if (i) {
        const prevTs = rows[i - 1].ts;
        const diffs = s.list.map((l) => { const a = Date.parse(s.ts(l)), b = Date.parse(prevTs(l)); return (a && b && a >= b) ? (a - b) / 864e5 : null; }).filter((x) => x != null);
        if (diffs.length) avg = fmtDur(diffs.reduce((a, b) => a + b, 0) / diffs.length);
      }
      const color = (STAGES.find((x) => x.key === s.key) || {}).color || '#8ab4ff';
      html += '<div class="fn-row"><div class="fn-label">' + s.label + '</div>' +
        '<div class="fn-bar-wrap"><div class="fn-bar" style="width:' + Math.max(5, Math.round(s.n / top * 100)) + '%;background:' + color + '"><span class="fn-n">' + s.n + '</span></div></div>' +
        '<div class="fn-meta">' + (i ? '<b>' + conv + '%</b><span>' + avg + '</span>' : '<b>100%</b><span>base</span>') + '</div></div>';
    });
    const won = rows[4].n, lost = set.filter((l) => l.lost_at).length, dec = won + lost;
    html += '<div class="fn-foot">Perdidos <b>' + lost + '</b> · Cierre (ganado / decididos) <b>' + (dec ? Math.round(won / dec * 100) + '%' : '—') + '</b>' +
      ' · <span class="fn-hint">los tiempos se miden arrastrando los leads por las etapas en orden</span></div>';
    $(targetId || 'funnel').innerHTML = html;
  }

  /* ▲▼% vs período anterior: verde sube / rojo baja / gris sin cambio */
  function setDelta(id, cur, prev){
    const el = $(id); if (!el) return;
    if (!prev && !cur){ el.textContent = '='; el.className = 'kdelta flat'; return; }
    if (!prev){ el.textContent = '▲ nuevo'; el.className = 'kdelta up'; return; }
    const pct = (cur - prev) / prev * 100;
    if (Math.abs(pct) < 0.05){ el.textContent = '='; el.className = 'kdelta flat'; return; }
    el.textContent = (pct > 0 ? '▲ +' : '▼ ') + pct.toFixed(Math.abs(pct) >= 10 ? 0 : 1) + '%';
    el.className = 'kdelta ' + (pct > 0 ? 'up' : 'down');
  }

  /* Por defecto SOLO personas: es lo que Sebastián pidió ver. El interruptor deja
     volver al tráfico completo cuando hace falta (por ejemplo para comparar con una
     herramienta externa que sí cuenta bots). */
  let anaSoloPersonas = true;
  function anaAvisoModo(solo, parcial, hayMedicion, totalCrudo, totalFiltrado){
    const b = $('ana-modo-btn'), t = $('ana-modo-txt');
    if (!b || !t) return;
    b.classList.toggle('on', !!solo);
    b.textContent = solo ? '👥 Solo personas' : '🌐 Todo el tráfico';
    if (!hayMedicion){
      t.textContent = 'La separación de bots se mide desde el 24/08 — en este período todavía no hay con qué separar.';
      b.disabled = true; return;
    }
    b.disabled = false;
    const desc = totalCrudo - totalFiltrado;
    t.textContent = solo
      ? 'Se descartaron ' + desc.toLocaleString('de-CH') + ' visitas automáticas' +
        (parcial ? ' · antes del 24/08 no se puede separar, así que ese tramo no aparece' : '')
      : 'Estás viendo TODO, bots incluidos (' + totalCrudo.toLocaleString('de-CH') + ' visitas)';
  }
  /* recorta una lista de leads al tramo medido — mismo criterio que las sesiones */
  const periodLeadsTramo = (arr, desde) => (arr || []).filter((l) => Date.parse(l.created_at) >= desde);
  /* Qué grupos de Analytics quedaron abiertos. Si cerrás "De dónde salió" porque no
     lo mirás, no tiene que volver a aparecer abierto mañana. */
  (function anaGruposMemoria(){
    let abiertos;
    try { abiertos = JSON.parse(localStorage.getItem('vv_ana_grupos') || 'null'); } catch (e) { /* cache corrupto */ }
    document.querySelectorAll('.ana-grupo-det').forEach((d) => {
      if (abiertos && Object.prototype.hasOwnProperty.call(abiertos, d.dataset.g)) d.open = !!abiertos[d.dataset.g];
      d.addEventListener('toggle', () => {
        const est = {};
        document.querySelectorAll('.ana-grupo-det').forEach((x) => { est[x.dataset.g] = x.open; });
        try { localStorage.setItem('vv_ana_grupos', JSON.stringify(est)); } catch (e) { /* modo privado */ }
      });
    });
  })();
  function renderAnalytics(rows, leads){
    /* ================= UN SOLO FILTRO PARA TODO EL TAB =================
       Analytics tiene 22 paneles y casi todos cuentan sesiones o páginas vistas.
       Parchear uno por uno era garantizar que se escapara alguno, así que el filtro
       vive acá: todo lo de abajo usa `real`, así que si `real` no tiene bots, no los
       tiene ninguno. (Sebastián, 25 ago: "controlá toda la info en analytics, muchos
       siguen con sesiones que deben ser con bots".)
       El interruptor de arriba permite ver el tráfico completo cuando hace falta. */
    const sinTest = rows.filter((r) => !/^claude-/.test(r.session_id || ''));
    const humIds = new Set((humanAct || [])
      .filter((x) => { const t = Date.parse(x.created_at); return t >= Math.max(rangeStart(), HUMAN_DESDE) && t <= rangeEnd(); })
      .map((x) => x.session_id));
    const hayMedicion = rangeEnd() > HUMAN_DESDE;
    const parcial = rangeStart() < HUMAN_DESDE;
    const soloPersonas = anaSoloPersonas && hayMedicion;
    const real = soloPersonas ? sinTest.filter((r) => humIds.has(r.session_id)) : sinTest;
    /* Las comparaciones ▲▼ solo tienen sentido si el período ANTERIOR está medido con
       el mismo criterio. Si no, compararíamos personas contra personas+bots y daría
       un derrumbe que no existe. */
    const compararOk = !soloPersonas || prevWin.start >= HUMAN_DESDE;
    /* Cuántos días cubre de verdad el tramo medido. Se calcula UNA vez y lo usan
       todas las etiquetas: antes cada una lo redondeaba a su manera y la pantalla
       decía "último 1 día" arriba y "últimos 2 días" en el gráfico, con los mismos
       datos. Dos cuentas para lo mismo es una invitación a desconfiar de las dos. */
    const diasMed = Math.max(1, Math.ceil((rangeEnd() - Math.max(rangeStart(), HUMAN_DESDE)) / 864e5));
    const diasMedTxt = diasMed === 1 ? 'último día' : 'últimos ' + diasMed + ' días';
    anaAvisoModo(soloPersonas, parcial, hayMedicion, sinTest.length, real.length);
    const entries = real.filter((r) => r.is_entry);
    const sessions = new Set(real.map((r) => r.session_id));
    /* la cartera de bexio queda afuera de los KPIs de performance (ver esCartera):
       si no, el import del 25 jul mete 168 "conversiones" en cualquier período que
       lo contenga y la tasa deja de significar nada */
    const periodLeads = (leads || []).filter((l) =>
      inRange(l.created_at) && !/^claude-/.test(l.session_id || '') && !esCartera(l));

    /* ===== Las cuatro tablas de rendimiento comparan sesiones contra leads =====
       Las sesiones vienen del tramo MEDIDO (desde el 24/08); los leads, del período
       entero. Con esa mezcla salían filas como "referral: 1 sesión → 2 leads = 200%".
       No es que el canal convierta 200%: es que el numerador tiene 30 días y el
       denominador uno. Acá se recortan los leads al mismo tramo, y el título de cada
       tabla dice de qué ventana está hablando. */
    const tablaLeads = (soloPersonas && parcial)
      ? periodLeadsTramo(periodLeads, Math.max(rangeStart(), HUMAN_DESDE))
      : periodLeads;
    const tramoTxt = (soloPersonas && parcial) ? ' · ' + diasMedTxt : '';
    const setCount = (id, txt) => { const e = $(id); if (e) e.textContent = txt; };
    setCount('perf-ch-c', '(' + (soloPersonas ? 'personas' : 'sesiones') + ' → leads' + tramoTxt + ')');
    setCount('perf-ref-c', '(referrers externos' + tramoTxt + ')');
    setCount('perf-lp-c', '(entrada → leads' + tramoTxt + ')');
    setCount('perf-bl-c', '(todas las vistas → leads' + tramoTxt + ')');

    /* KPIs — la conversión = lead real enviado (fiable, no depende del pageview) */
    /* Los dos KPIs de arriba solo cambian de ETIQUETA: los números ya vienen
       filtrados de `real` según el interruptor. El texto tiene que decir qué se está
       contando, porque "7.158 sesiones" y "78 visitas de personas" miden cosas
       distintas y sin la etiqueta parecería que la web se cayó. */
    const sufijo = parcial ? ' · ' + diasMedTxt : '';
    const humanIds = humIds;
    const setL = (id, txt) => { const e = $(id); if (e) e.textContent = txt; };
    setL('ka-views', real.length.toLocaleString('de-CH'));
    setL('ka-views-l', soloPersonas ? 'Páginas vistas de personas' + sufijo : 'Páginas vistas · incluye bots');
    setL('ka-sessions', sessions.size.toLocaleString('de-CH'));
    setL('ka-sessions-l', soloPersonas ? 'Personas' + sufijo : 'Sesiones · incluye bots');
    /* Los leads son del período ENTERO; las personas, solo del tramo medido. Si no
       se dice, la tarjeta de al lado invita a dividir una por otra — y esa cuenta
       (22 leads de 30 días ÷ 79 personas de uno) da 28%, que es justo el error que
       Sebastián ya cazó una vez. Por eso cada tarjeta lleva SU ventana escrita. */
    setL('ka-conv-l', 'Leads (conversiones)' + (soloPersonas && parcial ? ' · ' + rangeLabel().toLowerCase() : ''));
    /* Acá había una segunda tarjeta, "Personas (sin bots)", que salía de contar
       session_activity directo. Daba 81 mientras la de al lado decía 79 "visitas de
       personas" — y son la misma cosa: no sabemos identificar a una persona entre
       dos visitas, así que "una persona" y "una visita de una persona" son el mismo
       número. La diferencia eran dos sesiones con actividad cuyo pageview no estaba
       en la ventana cargada: ruido de implementación, no un dato distinto.
       Dos números parecidos con nombres parecidos no informan, hacen dudar de los
       dos. Queda uno solo. (Sebastián, 25 ago: "visitas de personas y personas...
       ¿no es lo mismo? ¿por qué diferentes números?") */
    /* ===== MEDIANA, no promedio =====
       Medido el 25 ago sobre las 124 vistas de personas con tiempo: mediana 20 s,
       promedio 5m13s, y cuatro vistas de más de media hora — tres clavadas en 7.200 s
       (dos horas), que es el tope. O sea: el promedio lo escribían un puñado de
       pestañas olvidadas abiertas, no la gente que lee. La mediana es el tiempo de
       la visita del medio y no se mueve por esos casos.
       (Sebastián, 25 ago: "¿seré yo que la dejo abierta?" — en parte sí, y con la
       mediana da igual quién sea.) */
    const durs = real.filter((r) => r.duration > 0);
    const ordenados = durs.map((r) => r.duration).sort((a, b) => a - b);
    const mediana = ordenados.length
      ? (ordenados.length % 2 ? ordenados[(ordenados.length - 1) / 2]
                              : (ordenados[ordenados.length / 2 - 1] + ordenados[ordenados.length / 2]) / 2)
      : 0;
    const promedio = durs.length ? durs.reduce((a, r) => a + r.duration, 0) / durs.length : 0;
    const avg = mediana;
    /* Hasta el 25/08 esto medía la pestaña abierta, no la pestaña mirada: una
       dejada de fondo toda la tarde entraba como una lectura de horas. Se arregló en
       site.js, pero los datos viejos ya están guardados así — decirlo, en vez de
       presentar un promedio contaminado como si fuera limpio. */
    $('ka-time').textContent = fmtTime(avg);
    const tl = $('ka-time-l');
    if (tl) tl.innerHTML = 'Tiempo en página <small style="opacity:.6">· mediana' +
      (promedio > mediana * 1.5 ? ' — el promedio da ' + fmtTime(promedio) + ', lo estiran pestañas olvidadas' : '') +
      (rangeStart() < Date.parse('2026-08-25T00:00:00Z') ? ' · antes del 25/08 contaba pestañas de fondo' : '') + '</small>';
    $('ka-conv').textContent = periodLeads.length;
    /* La tasa se calculaba leads ÷ sesiones, con las sesiones llenas de bots: daba
       0,3% y hacía parecer que la web no convierte. Ahora se calcula contra personas
       y SOLO si el período entero está medido — con medio período, el numerador
       (leads de 30 días) y el denominador (personas de 1 día) son de escalas
       distintas y el resultado sería igual de falso, para el otro lado. */
    /* ===== La tasa se calcula sobre el TRAMO MEDIDO, no se esconde =====
       Antes mostraba "—" y prometía un número "desde el 22/9", cuando el período
       entero estuviera medido. Es un mes de pantalla vacía por querer la ventana
       perfecta: si tengo personas de un día, los leads de ESE día también los
       tengo. Numerador y denominador del mismo tramo, y el rótulo dice cuál es.
       Lo que no se hace nunca es dividir leads de 30 días por personas de uno. */
    const rateEl = $('ka-rate'), rateL = $('ka-rate-l');
    if (!soloPersonas){
      /* En modo "todo el tráfico" la tasa va contra sesiones con bots adentro: es
         baja y diluida, pero es la que devuelven las herramientas externas. */
      if (rateEl) rateEl.textContent = sessions.size ? (periodLeads.length / sessions.size * 100).toFixed(1) + '%' : '—';
      if (rateL) rateL.textContent = 'De cada 100 sesiones (bots incluidos)';
    } else if (hayMedicion && sessions.size){
      const leadsTramo = parcial ? tablaLeads.length : periodLeads.length;
      const pct = leadsTramo / sessions.size * 100;
      if (rateEl) rateEl.textContent = (pct < 10 ? pct.toFixed(1) : Math.round(pct)) + '%';
      if (rateL) rateL.textContent = 'De cada 100 personas, cuántas dejan datos' + (parcial ? ' · ' + diasMedTxt : '');
    } else {
      if (rateEl) rateEl.textContent = '—';
      if (rateL) rateL.textContent = 'las personas se miden desde el 24/08';
    }
    if (!compararOk){ const rd = $('ka-rate-d'); if (rd) rd.textContent = ''; }
    cvpRender();   // conversión real por mes/trimestre/año (no depende del período de arriba)

    /* ▲▼ vs el período anterior de igual longitud (pageviews de prevViews, leads por created_at) */
    const pReal = (prevViews || []).filter((r) => !/^claude-/.test(r.session_id || ''));
    const pVisitas = prevStats ? Number(prevStats.visitas) : pReal.length;
    const pSesiones = prevStats ? Number(prevStats.sesiones) : new Set(pReal.map((r) => r.session_id)).size;
    const pSessions = { size: pSesiones };
    const pLeads = (leads || []).filter((l) => {
      if (/^claude-/.test(l.session_id || '')) return false;
      if (esCartera(l)) return false;   // mismo criterio que el período actual, si no la flecha ▲▼ compara distinto
      const t = new Date(l.created_at).getTime();
      return t >= prevWin.start && t <= prevWin.end;
    });
    /* La mediana del período anterior: de la RPC si está, y si no del array como siempre.
       Mediana también acá, si no la flecha compararía peras con manzanas. */
    const pDurs = pReal.filter((r) => r.duration > 0).map((r) => r.duration).sort((a, b) => a - b);
    const pAvg = prevStats
      ? Number(prevStats.dur_mediana) || 0
      : (pDurs.length
        ? (pDurs.length % 2 ? pDurs[(pDurs.length - 1) / 2] : (pDurs[pDurs.length / 2 - 1] + pDurs[pDurs.length / 2]) / 2)
        : 0);
    /* los leads no dependen de bots: esa comparación vale siempre */
    setDelta('ka-conv-d', periodLeads.length, pLeads.length);
    if (compararOk){
      setDelta('ka-sessions-d', sessions.size, pSessions.size);
      setDelta('ka-views-d', real.length, pVisitas);
      setDelta('ka-time-d', avg, pAvg);
      setDelta('ka-rate-d', sessions.size ? periodLeads.length / sessions.size : 0, pSessions.size ? pLeads.length / pSessions.size : 0);
    } else {
      // sin período anterior medido, una flecha sería una caída inventada
      ['ka-sessions-d', 'ka-views-d', 'ka-time-d', 'ka-rate-d'].forEach((id) => { const e = $(id); if (e){ e.textContent = ''; e.className = 'kdelta'; } });
    }

    /* tráfico + leads por día (anclado al fin de la ventana) */
    /* Con el filtro de personas puesto, el gráfico se recorta a los días MEDIDOS.
       Si no, dibujaba 30 días de los que 29 están vacíos por definición: una línea
       pegada al piso y un pico al final, que se lee como "el tráfico se derrumbó y
       volvió ayer". No pasó nada de eso — antes del 24/08 no hay medición. */
    const span = (soloPersonas && parcial) ? Math.min(rangeSpanDays(), diasMed) : rangeSpanDays();
    const anchor = rangeEnd();
    // el subtítulo dice QUÉ se está contando, de cuándo, y si hay contra qué comparar
    const dl = $('daily-label');
    if (dl) dl.textContent = '(' + (soloPersonas
      ? 'personas · ' + (parcial ? diasMedTxt : rangeLabel().toLowerCase())
      : rangeLabel().toLowerCase()) + (compararOk ? ' vs anterior)' : ')');
    const spanMs = span * 864e5; // corrimiento para alinear día a día con la ventana previa
    const days = [];
    for (let i = span - 1; i >= 0; i--) {
      const d = new Date(anchor - i * 864e5);
      days.push({ key: d.toISOString().slice(0, 10), pkey: new Date(d.getTime() - spanMs).toISOString().slice(0, 10), label: d.toLocaleDateString('es-CH', { day: '2-digit', month: 'short' }), set: new Set(), pset: new Set(), leads: 0 });
    }
    const dayMap = new Map(days.map((d) => [d.key, d]));
    const prevDayMap = new Map(days.map((d) => [d.pkey, d]));
    real.forEach((r) => { const d = dayMap.get(r.created_at.slice(0, 10)); if (d) d.set.add(r.session_id); });
    /* La línea punteada del período anterior solo se dibuja si ese período está
       medido con el MISMO criterio. Si no, sería la curva de bots contra la curva de
       gente: la escala se iría a las nubes y la línea real quedaría pegada al piso,
       leyéndose como un derrumbe que nunca pasó. */
    /* La línea punteada, día por día. Con la RPC ya vienen los conteos por fecha, así que
       en vez de sumar sesión por sesión se asigna el número: `pset` se usa después solo por
       su .size, y un objeto con size cumple el mismo contrato sin bajar 6.349 filas. */
    if (compararOk){
      if (prevStats && prevStats.por_dia){
        prevDayMap.forEach((d, fecha) => { d.pset = { size: Number(prevStats.por_dia[fecha]) || 0 }; });
      } else {
        pReal.forEach((r) => { const d = prevDayMap.get(r.created_at.slice(0, 10)); if (d) d.pset.add(r.session_id); });
      }
    }
    periodLeads.forEach((l) => { const d = dayMap.get(l.created_at.slice(0, 10)); if (d) d.leads++; });
    /* gráfico SVG real: área + línea de sesiones, puntos de leads, línea punteada del período anterior */
    const n = days.length, W = 1000, H = 260, padL = 42, padR = 14, padT = 16, padB = 28;
    const pw = W - padL - padR, ph = H - padT - padB, baseY = padT + ph;
    const maxS = Math.max(1, ...days.map((d) => d.set.size), ...days.map((d) => d.pset.size));
    const X = (i) => padL + (n <= 1 ? pw / 2 : (i / (n - 1)) * pw);
    const Y = (v) => padT + (1 - v / maxS) * ph;
    const pts = days.map((d, i) => [X(i), Y(d.set.size)]);
    const linePath = pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' ');
    const areaPath = 'M' + X(0).toFixed(1) + ' ' + baseY + ' ' + pts.map((p) => 'L' + p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' ') + ' L' + X(n - 1).toFixed(1) + ' ' + baseY + ' Z';
    const prevPath = compararOk ? days.map((d, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(d.pset.size).toFixed(1)).join(' ') : '';
    const grid = [0, 0.5, 1].map((t) => {
      const v = Math.round(maxS * t), y = Y(v);
      return '<line x1="' + padL + '" y1="' + y.toFixed(1) + '" x2="' + (W - padR) + '" y2="' + y.toFixed(1) + '" class="g-grid"/>' +
        '<text x="' + (padL - 8) + '" y="' + (y + 4).toFixed(1) + '" class="g-yl">' + v + '</text>';
    }).join('');
    const leadDots = days.map((d, i) => d.leads ? '<circle cx="' + X(i).toFixed(1) + '" cy="' + Y(d.set.size).toFixed(1) + '" r="' + (3 + Math.min(4, d.leads)) + '" class="g-lead"><title>' + d.label + ': ' + d.leads + ' leads</title></circle>' : '').join('');
    const hover = days.map((d, i) => '<circle cx="' + X(i).toFixed(1) + '" cy="' + Y(d.set.size).toFixed(1) + '" r="11" fill="transparent"><title>' + d.label + ' — ' + d.set.size + ' sesiones · ' + d.leads + ' leads' + (compararOk ? ' · período anterior: ' + d.pset.size : '') + '</title></circle>').join('');
    const step = Math.max(1, Math.ceil(n / 7));
    const xls = days.map((d, i) => ((i % step === 0) || i === n - 1) ? '<text x="' + X(i).toFixed(1) + '" y="' + (H - 8) + '" class="g-xl" text-anchor="middle">' + d.label + '</text>' : '').join('');
    $('daily-chart').innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" class="gsvg">' +
      '<defs><linearGradient id="gfill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ddf98f" stop-opacity=".28"/><stop offset="1" stop-color="#ddf98f" stop-opacity="0"/></linearGradient></defs>' +
      grid + '<path d="' + prevPath + '" class="g-prev"/><path d="' + areaPath + '" fill="url(#gfill)"/><path d="' + linePath + '" class="g-line"/>' + leadDots + hover + xls + '</svg>';

    /* funnel del período: del tráfico al cierre */
    /* Ojo con qué se le pasa: los leads van del período ENTERO, no del tramo medido.
       Un lead es un lead, no depende de si sabemos separar bots — recortarlos al
       tramo dejaba el embudo comercial en dos filas y tiraba 29 días de señal buena.
       Lo único que tiene otra ventana es el primer escalón (las personas), y por eso
       el % entre ese escalón y los leads se suprime cuando las ventanas no coinciden. */
    /* La conversión personas→leads SÍ se puede dar: hay que medir las dos cosas en el
       mismo tramo. Las personas existen desde el 24/08, así que se cuentan los leads que
       entraron desde esa fecha y se dividen por las personas de esa misma ventana.
       No es el número del período completo, y por eso va dicho con su tramo al lado.
       (Sebastián, 27 ago 2026: "acá falta lo más importante, porcentaje de personas a
        leads".) */
    let comun = null;
    if (soloPersonas && parcial){
      const desdeC = Math.max(rangeStart(), HUMAN_DESDE);
      const personasC = new Set((humanAct || [])
        .filter((x) => { const t = Date.parse(x.created_at); return t >= desdeC && t <= rangeEnd(); })
        .map((x) => x.session_id)).size;
      const leadsC = periodLeads.filter((l) => {
        const t = Date.parse(l.created_at);
        return t >= desdeC && t <= rangeEnd();
      }).length;
      const dias = Math.max(1, Math.ceil((rangeEnd() - desdeC) / 864e5));
      comun = { personas: personasC, leads: leadsC,
                txt: dias === 1 ? 'el último día' : 'los últimos ' + dias + ' días' };
    }
    renderAnaFunnel(sessions.size, periodLeads, soloPersonas, rangeLabel().toLowerCase(),
      !(soloPersonas && parcial), comun);

    /* rendimiento por CANAL: sesiones vs leads */
    const chSessions = new Map();
    entries.forEach((e) => { const k = e.channel || 'direct'; chSessions.set(k, (chSessions.get(k) || 0) + 1); });
    const chLeads = new Map();
    tablaLeads.forEach((l) => { const k = l.channel || 'direct'; chLeads.set(k, (chLeads.get(k) || 0) + 1); });
    const chKeys = new Set([...chSessions.keys(), ...chLeads.keys()]);
    const channelPerf = [...chKeys].map((k) => ({ key: k, label: k, badge: true, sessions: chSessions.get(k) || 0, leads: chLeads.get(k) || 0 }));
    perfTable($('perf-channel'), channelPerf, { clickable: 'channel' });

    /* rendimiento por PÁGINA DE ENTRADA */
    const lpSessions = new Map();
    entries.forEach((e) => { const k = e.path || '/'; lpSessions.set(k, (lpSessions.get(k) || 0) + 1); });
    const lpLeads = new Map();
    tablaLeads.forEach((l) => { const k = l.landing_path || '(sin dato)'; lpLeads.set(k, (lpLeads.get(k) || 0) + 1); });
    const lpKeys = new Set([...lpSessions.keys(), ...lpLeads.keys()]);
    const landingPerf = [...lpKeys].map((k) => ({ key: k, label: k, sessions: lpSessions.get(k) || 0, leads: lpLeads.get(k) || 0 }));
    perfTable($('perf-landing'), landingPerf, { clickable: 'landing' });

    /* rendimiento del BLOG: TODAS las vistas (no solo entrada — alguien puede leer
       2-3 posts en la misma sesión sin que cada uno sea la página de entrada), leads
       por landing_path exacto (mismo criterio que la tabla de arriba, solo filtrado
       a rutas /blog/). Pedido explícito: "mostrame el analytics de los blogs". */
    const BLOG_RE = /\/blog\/[^/]+\/?$/;
    const blogSess = new Map();
    real.forEach((r) => { const p = r.path || ''; if (!BLOG_RE.test(p)) return; if (!blogSess.has(p)) blogSess.set(p, new Set()); blogSess.get(p).add(r.session_id); });
    const blogLeadsN = new Map();
    tablaLeads.forEach((l) => { const p = l.landing_path || ''; if (BLOG_RE.test(p)) blogLeadsN.set(p, (blogLeadsN.get(p) || 0) + 1); });
    const blogKeys = new Set([...blogSess.keys(), ...blogLeadsN.keys()]);
    const blogTitle = (p) => {
      const m = p.match(/^\/(en|de|es)\/blog\/([^/]+)\//);
      if (!m) return p;
      return m[2].replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) + ' (' + m[1].toUpperCase() + ')';
    };
    const blogPerf = [...blogKeys].map((k) => ({ key: k, label: blogTitle(k), sessions: (blogSess.get(k) || new Set()).size, leads: blogLeadsN.get(k) || 0 }));
    perfTable($('perf-blog'), blogPerf, { clickable: 'landing' });

    /* REFERRERS externos: hostname del referrer de la ENTRADA de cada sesión.
       La atribución de leads es por session_id (igual espíritu que la tabla de canales). */
    const refBySess = new Map();
    entries.forEach((e) => {
      if (!e.referrer || !e.session_id || refBySess.has(e.session_id)) return;
      /* BUG DE SIEMPRE: site.js guarda el HOSTNAME pelado ("google.com"), no la URL
         entera. new URL("google.com") tira excepción, el catch hacía return, y como
         eso pasaba con TODAS las filas, este panel estuvo vacío desde que existe.
         Encontrado el 25 ago 2026 comparando la pantalla contra la base: había 19
         sesiones de google.com, 1 de linkedin y 1 de chatgpt, y la tabla no mostraba
         ninguna. Ahora se aceptan las dos formas. */
      let h = String(e.referrer || '').trim();
      try { if (/^https?:\/\//i.test(h)) h = new URL(h).hostname; } catch (err) { /* sigue como texto */ }
      h = h.replace(/^www\./, '').replace(/[/?#].*$/, '').toLowerCase();
      if (!h || h === 'viven.ch' || h.endsWith('.viven.ch')) return; // navegación interna no cuenta
      refBySess.set(e.session_id, h);
    });
    const refSessN = new Map();
    refBySess.forEach((h) => refSessN.set(h, (refSessN.get(h) || 0) + 1));
    const refLeadsN = new Map();
    tablaLeads.forEach((l) => { const h = l.session_id && refBySess.get(l.session_id); if (h) refLeadsN.set(h, (refLeadsN.get(h) || 0) + 1); });
    const refPerf = [...refSessN.keys()]
      .map((h) => ({ key: h, label: h, sessions: refSessN.get(h) || 0, leads: refLeadsN.get(h) || 0 }))
      .sort((a, b) => (b.leads - a.leads) || (b.sessions - a.sessions)).slice(0, 10);
    perfTable($('perf-ref'), refPerf);

    /* resumen compacto para los insights con IA */
    /* La IA lee ESTO. Si le mandábamos sesiones con 75% de bots, escribía consejos
       sobre el comportamiento de los bots con total seguridad. Ahora recibe lo mismo
       que ve la pantalla, y se le dice qué está mirando. */
    insightsData = {
      periodo: rangeLabel(),
      medicion: soloPersonas ? 'solo personas (tráfico automático excluido)' : 'todo el tráfico, bots incluidos',
      sesiones: sessions.size,
      paginas_vistas: real.length,
      tiempo_medio_seg: Math.round(avg),
      leads: periodLeads.length,
      tasa_conversion_pct: sessions.size ? +(periodLeads.length / sessions.size * 100).toFixed(2) : 0,
      canales: channelPerf.map((c) => ({ canal: c.label, sesiones: c.sessions, leads: c.leads })).slice(0, 8),
      paginas_entrada: landingPerf.map((p) => ({ path: p.label, sesiones: p.sessions, leads: p.leads })).slice(0, 8),
      referrers: refPerf.map((r) => ({ sitio: r.label, sesiones: r.sessions, leads: r.leads })).slice(0, 8),
      blog: blogPerf.slice().sort((a, b) => (b.leads - a.leads) || (b.sessions - a.sessions)).map((p) => ({ post: p.label, sesiones: p.sessions, leads: p.leads })).slice(0, 8),
    };

    /* insights automáticos (cache diario por navegador; el ↻ los fuerza) */
    autoInsights(false);

    /* dispositivos / idiomas */
    bars($('bars-device'), countBy(real, 'device'), 3);
    bars($('bars-lang'), countBy(entries, 'lang'), 8);

    /* top páginas por engagement (visitas + tiempo) */
    /* mismo criterio que el KPI de arriba: mediana. Una sola pestaña olvidada en
       una página con pocas visitas la mandaba al tope de la lista con "1h 12m". */
    const byPath = new Map();
    real.forEach((r) => {
      const p = byPath.get(r.path) || { views: 0, durs: [] };
      p.views++;
      if (r.duration > 0) p.durs.push(r.duration);
      byPath.set(r.path, p);
    });
    const medianaDe = (arr) => {
      if (!arr.length) return 0;
      const o = arr.slice().sort((a, b) => a - b);
      return o.length % 2 ? o[(o.length - 1) / 2] : (o[o.length / 2 - 1] + o[o.length / 2]) / 2;
    };
    const pages = [...byPath.entries()]
      .map(([k, p]) => [k, p.views, medianaDe(p.durs)])
      .sort((a, b) => b[1] - a[1]);
    bars($('bars-pages'), pages, 15, (v, t) => v + ' <small>· ' + fmtTime(t) + '</small>');
  }

  /* Funnel del período (sub-tab Web): arranca en SESIONES (tráfico) y baja hasta ganado.
     Adaptado de renderFunnel (Home/Personas) SIN tocarlo — acá la base es el tráfico y
     los pasos se cuentan sobre los leads CREADOS en el período (sus timestamps de etapa). */
  /* ===================== Funnel del período =====================
     Tres cosas que estaban mal y que Sebastián vio en pantalla:

     1) El primer escalón (personas, tramo medido desde el 24/08) se dividía contra
        el segundo (leads del período entero). Con 79 personas de un día y 22 leads
        de treinta daba 28% — la misma cuenta cruzada de las tablas de canales.
        Ahora los leads del funnel salen del MISMO tramo que las personas.

     2) "Ganado" no mostraba porcentaje. No es un bug del cálculo: el paso previo
        (Propuesta) estaba en 0, y no se puede dividir por cero. Sebastián: "¿es
        porque falta la propuesta? ¿no lo podemos dar igual?". Sí se puede, y hay
        que hacerlo: el camino NO es obligatorio. De los 168 ganados que hay en la
        base, 168 no tienen ni propuesta ni videollamada cargada. Un cierre que
        saltó escalones sigue siendo un cierre.
        Solución: cada escalón muestra su % sobre la BASE (los leads), que siempre
        existe, y además el % del paso previo cuando ese paso tiene gente. Si el
        anterior está vacío, se dice "salteó el paso anterior" en vez de un 0%
        que parece un fracaso.

     3) Es una cohorte: gente que ENTRÓ en el período, seguida hasta hoy. Los
        escalones de abajo van a estar siempre bajos porque un negocio tarda meses
        en cerrar — eso no es una fuga, es el calendario. Va dicho al pie. */
  function renderAnaFunnel(sessionCount, funnelLeads, soloPersonas, ventanaTxt, mismaVentana, comun){
    const el = $('ana-funnel'); if (!el) return;
    const stColor = (k) => (STAGES.find((x) => x.key === k) || {}).color || '#8ab4ff';
    const base = funnelLeads.length;   // los leads son la base del embudo comercial
    const steps = [
      /* el primer escalón cambia de nombre según qué se esté contando: decir
         "sesiones" cuando son personas hace que el % del paso siguiente parezca otro */
      { label: soloPersonas ? 'Personas' : 'Sesiones', n: sessionCount, color: '#8ab4ff', web: true },
      /* Cada escalón se lleva SU gente, no solo el número. Un embudo que dice «8 leads» y
         no deja ver cuáles son obliga a irse a Personas y reconstruir el filtro a mano —
         y ahí ya no es el mismo recorte, es uno parecido.
         (Sebastián, 28 ago 2026: "dejame tocar leads y que me muestre todos los que
         entraron".) */
      { label: 'Leads',      n: base, color: stColor('lead'), gente: funnelLeads },
      { label: 'Video Call', n: funnelLeads.filter((l) => l.videocall_at).length, color: stColor('videocall'), gente: funnelLeads.filter((l) => l.videocall_at) },
      { label: 'Propuesta',  n: funnelLeads.filter((l) => l.proposal_at).length, color: stColor('propuesta'), gente: funnelLeads.filter((l) => l.proposal_at) },
      { label: 'Ganado',     n: funnelLeads.filter((l) => l.won_at).length, color: stColor('ganado'), gente: funnelLeads.filter((l) => l.won_at) },
    ];
    /* Se guardan acá y no en el DOM: meter 289 personas en un data- las serializa enteras
       en el HTML y las vuelve a parsear en cada click. */
    anaFunnelGente = steps.map((s) => s.gente || null);
    const top = Math.max(1, steps[0].n);
    el.innerHTML = steps.map((s, i) => {
      let meta;
      if (i === 0){
        meta = '<b>100%</b><span>base</span>';
      } else if (i === 1){
        /* Este es el único salto que cruza dos mediciones distintas: arriba, gente
           medida desde el 24/08; acá, leads del período entero. Dividir uno por otro
           daba 28% — el número que ya nos hizo tropezar una vez. Si las ventanas no
           coinciden, no hay porcentaje: se dice por qué. */
        const pct = (mismaVentana && sessionCount) ? Math.round(s.n / sessionCount * 100) : null;
        if (pct != null){
          meta = '<b>' + pct + '%</b><span>de las personas</span>';
        } else if (comun && comun.personas){
          /* El período entero no se puede dividir —las personas empiezan el 24/08— pero el
             tramo donde las dos cosas existen sí, y es EL número: cuánta de la gente que
             entra deja sus datos. Se dice de qué tramo es, para que nadie lo lea como si
             fuera del mes. */
          const p2 = comun.leads / comun.personas * 100;
          meta = '<b>' + (p2 < 10 && p2 > 0 ? p2.toFixed(1) : Math.round(p2)) + '%</b>' +
            '<span>de las personas</span>' +
            '<span class="fn-prev">' + comun.leads + ' de ' + comun.personas + ' en ' + esc(comun.txt) + '</span>';
        } else {
          meta = '<b>—</b><span>otra ventana que las personas</span>';
        }
      } else {
        const prev = steps[i - 1].n;
        const pctBase = base ? (s.n / base * 100) : null;
        const bTxt = pctBase == null ? '—' : (pctBase < 10 && pctBase > 0 ? pctBase.toFixed(1) : Math.round(pctBase)) + '%';
        meta = '<b>' + bTxt + '</b><span>de los leads</span>' +
          (prev > 0 ? '<span class="fn-prev">' + Math.round(s.n / prev * 100) + '% del paso previo</span>'
                    : (s.n > 0 ? '<span class="fn-prev fn-skip">salteó el paso anterior</span>' : ''));
      }
      const tocable = (s.gente || []).length > 0;
      return '<div class="fn-row' + (tocable ? ' fn-tocable' : '') + '"' +
        (tocable ? ' role="button" tabindex="0" data-fn="' + i + '" title="Ver quiénes son estos ' + esc(s.label.toLowerCase()) + '"' : '') +
        '><div class="fn-label">' + s.label + (tocable ? ' <span class="fn-lupa">🔍</span>' : '') + '</div>' +
        '<div class="fn-bar-wrap"><div class="fn-bar" style="width:' + Math.max(5, Math.round(s.n / top * 100)) + '%;background:' + s.color + '"><span class="fn-n">' + s.n + '</span></div></div>' +
        '<div class="fn-meta">' + meta + '</div></div>';
    }).join('') +
      '<div class="fn-foot">Cohorte: los leads que entraron en ' + esc(ventanaTxt || rangeLabel().toLowerCase()) +
      ', seguidos hasta hoy. Los escalones de abajo van bajos porque un negocio tarda meses en cerrar — eso es el calendario, no una fuga. ' +
      'Y los pasos no son obligatorios: se puede cerrar sin propuesta cargada.' +
      (mismaVentana ? ''
        : comun && comun.personas
          ? ' El primer escalón mide otra ventana: las personas se miden desde el 24/08, así que el porcentaje de leads es el de ese tramo —donde las dos cosas existen— y no el del período entero.'
          : ' El primer escalón mide otra ventana (las personas se miden desde el 24/08), por eso ese salto no lleva porcentaje.') +
      '</div>';

    el.querySelectorAll('[data-fn]').forEach((fila) => {
      const abrir = () => anaFunnelVerGente(Number(fila.dataset.fn), steps[Number(fila.dataset.fn)].label);
      fila.addEventListener('click', abrir);
      fila.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); abrir(); } });
    });
  }

  /* La lista de un escalón. Se muestra acá mismo, debajo del embudo, y no mandando a
     Personas con un filtro: el recorte del embudo es una cohorte —los que ENTRARON en el
     período— y Personas no tiene ese filtro, así que reconstruirlo daría otra lista
     parecida. Mostrar la de verdad es más corto y no miente. */
  let anaFunnelGente = [];
  function anaFunnelVerGente(i, etiqueta){
    const gente = anaFunnelGente[i] || [];
    const caja = $('ana-funnel-gente'); if (!caja) return;
    if (caja.dataset.abierto === String(i)){ caja.hidden = true; caja.dataset.abierto = ''; return; }
    caja.dataset.abierto = String(i);
    caja.hidden = false;
    const filas = gente.slice().sort(masNuevo('created_at')).map((l) => {
      const st = STAGES.find((x) => x.key === stageOf(l.status)) || {};
      return '<button type="button" class="fng-row" data-lead="' + esc(String(l.id)) + '">' +
        '<span class="fng-n">' + esc(l.name || l.first_name || l.email || '(sin nombre)') + '</span>' +
        '<span class="fng-c">' + esc(l.company || l.email || '') + '</span>' +
        '<span class="fng-s" style="color:' + (st.color || 'var(--muted)') + '">' + esc(st.label || l.status || '—') + '</span>' +
        '<span class="fng-d">' + (l.created_at ? fmtDMY(l.created_at) : '') + '</span>' +
        '</button>';
    }).join('');
    caja.innerHTML = '<div class="fng-h">' + esc(etiqueta) + ' · ' + gente.length +
      ' <button type="button" class="btn btn-ghost xs" id="fng-cerrar">✕ Cerrar</button></div>' +
      (filas || '<p class="muted-note">Nadie en este escalón.</p>');
    $('fng-cerrar').addEventListener('click', () => { caja.hidden = true; caja.dataset.abierto = ''; });
    caja.querySelectorAll('[data-lead]').forEach((b) =>
      b.addEventListener('click', () => openLead(b.dataset.lead)));
  }

