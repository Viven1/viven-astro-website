  async function magnetsLoadPerf(){
    const cardsEl = $('lm-perf-cards'); if (!cardsEl) return;
    cardsEl.innerHTML = '<p class="muted-note">Cargando…</p>';
    if ($('lm-range-note')) $('lm-range-note').textContent = rangeLabel();
    try {
      const { data: views, error } = await fetchAllRows('pageviews', 'path,session_id,created_at', since(), until());
      if (error) throw error;
      /* ===== El denominador de este panel eran SESIONES, con bots adentro =====
         El 75% del tráfico es automático, así que "3,5% sesión → lead" no decía que
         el magnet convierta mal: decía que hay muchos bots. Y ese porcentaje es
         justamente el número que Sebastián pidió ver acá.
         Desde el 24/08 sabemos qué sesiones son de una persona. Cuando el período
         tiene tramo medido, TODO se calcula sobre ese tramo — sesiones y leads —
         para que numerador y denominador hablen de los mismos días. Si no hay tramo
         medido, se muestra lo de antes pero diciendo que incluye bots. */
      const lmDesde = Math.max(Date.parse(since()), HUMAN_DESDE);
      const lmMedido = Date.parse(until()) > HUMAN_DESDE;
      const lmHum = new Set((humanAct || [])
        .filter((x) => { const t = Date.parse(x.created_at); return t >= lmDesde && t <= Date.parse(until()); })
        .map((x) => x.session_id));
      const lmDias = Math.max(1, Math.round((Date.parse(until()) - lmDesde) / 864e5));
      const lmParcial = Date.parse(since()) < HUMAN_DESDE;
      const lmNota = lmMedido
        ? (lmParcial ? 'personas · últimos ' + lmDias + (lmDias === 1 ? ' día' : ' días') : 'personas · ' + rangeLabel().toLowerCase())
        : 'sesiones · incluye bots';
      /* filtra una lista de pageviews al tramo medido y solo a personas */
      const lmViews = (arr) => lmMedido ? (arr || []).filter((v) => lmHum.has(v.session_id) && Date.parse(v.created_at) >= lmDesde) : (arr || []);
      /* y lo mismo para cualquier fila con created_at (leads, envíos de PDF, briefs) */
      const lmEnVentana = (arr) => lmMedido ? (arr || []).filter((r) => Date.parse(r.created_at) >= lmDesde) : (arr || []);
      // brief profundo: NO se puede contar por leads.channel==='brief' — el trigger de
      // auto-lead (0028/0056) solo taggea ese channel cuando el lead es NUEVO. El caso
      // normal es alguien que YA es lead (se le manda el link de brief por email) y
      // ahí el channel original (organic/paid/etc.) queda intacto — el submit quedaba
      // invisible acá aunque existiera (bug real reportado por Sebastián). Se cuenta
      // por la tabla briefs directamente, sin filtrar por fecha de alta del lead.
      const { data: briefRows, error: briefErr } = await supabase.from('briefs').select('lead_id,email,created_at').gte('created_at', since()).lte('created_at', until());
      if (briefErr) throw briefErr;
      // Idem sesiones: /brief/ no carga site.js (no escribe en pageviews), tiene su
      // propio tracker a funnel_events (funnel:'brief', step 0 = abrió el brief).
      const { data: briefViews, error: bfErr } = await supabase.from('funnel_events').select('session_id').eq('funnel', 'brief').eq('step', 0).gte('created_at', since()).lte('created_at', until());
      if (bfErr) throw bfErr;
      const calcLeads = lmEnVentana((allLeads || []).filter((l) => /^🧮\s*CALCULADORA/.test(l.message || '') && inRange(l.created_at)));
      const briefLeadIds = new Set((briefRows || []).filter((b) => b.lead_id).map((b) => String(b.lead_id)));
      const briefEmails = new Set((briefRows || []).filter((b) => !b.lead_id && b.email).map((b) => b.email.toLowerCase()));
      const briefLeads = lmEnVentana((allLeads || []).filter((l) => briefLeadIds.has(String(l.id)) || (l.email && briefEmails.has(l.email.toLowerCase()))));
      const wonSet = new Set((dealsList || []).filter((d) => stageOf(d.stage) === 'ganado').map((d) => String(d.lead_id)));
      const calcSessions = new Set(lmViews(views).filter((v) => LM_CALC_PATHS.includes(lmNormPath(v.path))).map((v) => v.session_id)).size;
      /* el brief no escribe en pageviews (tiene tracker propio a funnel_events), así
         que su "sesión" se filtra igual pero contra esa tabla */
      const briefSessions = new Set((lmMedido ? (briefViews || []).filter((v) => lmHum.has(v.session_id)) : (briefViews || [])).map((v) => v.session_id)).size;
      const calcWon = calcLeads.filter((l) => wonSet.has(String(l.id))).length;
      const briefWon = briefLeads.filter((l) => wonSet.has(String(l.id))).length;
      const card = (label, sub, sessions, leads, won) => {
        const pct = sessions ? (leads / sessions * 100) : 0;
        return '<div class="of-card lm-card"><h3>' + label + (sub ? '<small>' + esc(sub) + '</small>' : '') + '</h3>' +
          '<div class="lm-kv"><span>' + (lmMedido ? 'Personas' : 'Sesiones') + '</span><b>' + sessions.toLocaleString('de-CH') + '</b></div>' +
          '<div class="lm-kv"><span>Leads generados</span><b>' + leads + '</b></div>' +
          '<div class="lm-kv"><span>Conversión → ganado</span><b>' + won + '</b></div>' +
          '<div class="lm-bigpct">' + pct.toFixed(1) + '%</div><div class="lm-bigpct-l">' + esc(lmNota) + ' → lead</div></div>';
      };
      /* Los PDF no estaban en este panel: las tarjetas eran DOS, escritas a mano
         (calculadora y brief). Sebastián: "los lead magnets nuevos pdfs no aparecen
         en el contado de leads". Ahora salen de magnet_sends, que es donde queda
         registrado cada pedido de PDF. Una tarjeta por magnet, sin lista fija:
         si mañana hay un magnet nuevo, aparece solo. */
      const { data: envios, error: mgErr } = await supabase.from('magnet_sends')
        .select('magnet,email,lead_id,created_at').gte('created_at', since()).lte('created_at', until());
      const porMagnet = {};
      if (!mgErr) (envios || []).forEach((m) => {
        const k = m.magnet || '(sin nombre)';
        (porMagnet[k] = porMagnet[k] || []).push(m);
      });
      const magnetCard = (clave, filas) => {
        const meta = LM_MAGNETS[clave] || { t: clave, e: '📄' };
        // personas distintas, no pedidos: el mismo email puede pedirlo dos veces
        /* el numerador se recorta al MISMO tramo que el denominador: contar 30 días
           de leads contra 1 día de personas daría un porcentaje enorme y falso */
        /* Y las direcciones internas afuera: los 6 pedidos de PDF que había el 25 ago
           2026 eran los SEIS de Sebastián probando el formulario. La tarjeta decía
           "2 leads generados" de gente que no existe. Mismo esInterno() que ya limpia
           Hoy y la cola de info@. */
        const filasV = lmEnVentana(filas).filter((m) => !esInterno(m.email));
        const pruebas = lmEnVentana(filas).length - filasV.length;
        const personas = new Set(filasV.map((m) => (m.email || '').toLowerCase()).filter(Boolean));
        const ids = new Set(filasV.filter((m) => m.lead_id).map((m) => String(m.lead_id)));
        const ganados = [...ids].filter((id) => wonSet.has(id)).length;
        /* Sesiones = las que vieron alguna página donde está embebido ESTE formulario.
           El PDF no tiene landing propia, así que el denominador sale del mapa que arma
           el build. Si no sabemos en qué páginas está, se muestra '—' y sin porcentaje:
           un porcentaje sobre un denominador inventado es peor que no tenerlo. */
        const rutas = MAGNET_PATHS[clave] || { exactas: [], prefijos: [] };
        const exactas = rutas.exactas || [], prefijos = rutas.prefijos || [];
        const cuantas = exactas.length + prefijos.length;
        const ses = cuantas
          ? new Set(lmViews(views).filter((v) => { const q = lmNormPath(v.path);
              return exactas.includes(q) || prefijos.some((pre) => q.startsWith(pre)); }).map((v) => v.session_id)).size
          : null;
        const pct = ses ? (personas.size / ses * 100) : null;
        return '<div class="of-card lm-card"><h3>' + meta.e + ' ' + esc(meta.t) +
            '<small>' + (cuantas ? 'PDF · en ' + exactas.length + (prefijos.length ? '+ páginas' : (exactas.length === 1 ? ' página' : ' páginas')) : 'PDF') + '</small></h3>' +
          '<div class="lm-kv"><span>' + (lmMedido ? 'Personas' : 'Sesiones') + '</span><b>' + (ses == null ? '—' : ses.toLocaleString('de-CH')) + '</b></div>' +
          '<div class="lm-kv"><span>Leads generados</span><b>' + personas.size + '</b></div>' +
          '<div class="lm-kv"><span>Conversión → ganado</span><b>' + ganados + '</b></div>' +
          '<div class="lm-bigpct">' + (pct == null ? '—' : pct.toFixed(1) + '%') + '</div>' +
          '<div class="lm-bigpct-l">' + (pct == null ? 'sin páginas conocidas' : esc(lmNota) + ' → lead') + '</div>' +
          (pruebas ? '<div class="muted-note" style="margin-top:6px;font-size:11.5px">' + pruebas
            + (pruebas === 1 ? ' pedido tuyo de prueba, afuera de la cuenta' : ' pedidos tuyos de prueba, afuera de la cuenta') + '</div>' : '')
          + '</div>';
      };
      const tarjetasPdf = Object.keys(porMagnet).sort().map((k) => magnetCard(k, porMagnet[k])).join('');
      cardsEl.innerHTML = card('🧮 Calculadora de costos', '3 idiomas', calcSessions, calcLeads.length, calcWon) +
        card('📋 Brief profundo', '', briefSessions, briefLeads.length, briefWon) + tarjetasPdf +
        (mgErr ? '<p class="muted-note" style="grid-column:1/-1;color:#ff8b5e">⚠️ No se pudieron leer los pedidos de PDF: ' + esc(mgErr.message) + '</p>'
               : !tarjetasPdf ? '<p class="muted-note" style="grid-column:1/-1">Ningún PDF pedido en este período.</p>' : '');
    } catch (e) { cardsEl.innerHTML = '<p class="muted-note">⚠️ ' + esc(e.message || String(e)) + '</p>'; }
  }
