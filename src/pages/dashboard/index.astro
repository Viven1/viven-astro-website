  const licCHF = (n) => 'CHF ' + Math.round(Number(n) || 0).toLocaleString('de-CH');
  /* El monto de una licencia es el del PERÍODO, no del mes: el formulario dice "Monto
     (CHF)" a secas y así se cargaron las dos que hay — Kanebo CHF 2.500 por dos años,
     Sonova CHF 1.500 por uno. El KPI los sumaba y les ponía "/mes", así que una cartera
     de CHF 4.000 se leía como CHF 48.000 al año. Para tener un mensual de verdad hay
     que prorratear cada una por su propia duración. (Regla: verificar la semántica de
     un campo de plata antes de sumarlo.) */
  function licMensual(l){
    const monto = Number(l.amount) || 0;
    if (!monto || !l.start_date || !l.renewal_date) return null;
    const dias = (Date.parse(l.renewal_date) - Date.parse(l.start_date)) / 864e5;
    if (!(dias > 20)) return null;              // período raro o de un día: no se inventa
    return monto / (dias / 30.44);
