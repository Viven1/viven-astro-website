  const licVencida = (l) => l.status === 'active' && l.renewal_date && licDaysTo(l.renewal_date) < 0;
  function licKpis(){
    const active = licList.filter((l) => l.status === 'active');
    /* Una licencia cuya fecha de renovación ya pasó no es cartera activa: es un
       vencimiento que nadie cerró. El 25 ago 2026 la de Sonova llevaba 43 días así y
       sumaba igual. */
    const vigentes = active.filter((l) => !licVencida(l));
    const total = vigentes.reduce((a, l) => a + (Number(l.amount) || 0), 0);
    const mensual = vigentes.reduce((a, l) => a + (licMensual(l) || 0), 0);
    const sinPeriodo = vigentes.filter((l) => licMensual(l) == null && Number(l.amount)).length;
    const renewed30 = licList.filter((l) => l.status === 'renewed' && l.updated_at && (Date.now() - Date.parse(l.updated_at) < 30 * 864e5))
      .reduce((a, l) => a + (Number(l.amount) || 0), 0);
    const due90 = vigentes.filter((l) => l.renewal_date && licDaysTo(l.renewal_date) <= 90)
      .reduce((a, l) => a + (Number(l.amount) || 0), 0);
    const vencidas = active.filter(licVencida);
    $('lic-k-active').innerHTML = licCHF(total)
      + '<small class="bajo">' + (mensual > 0 ? '≈ ' + licCHF(mensual) + '/mes prorrateado' : 'valor del período')
      + (sinPeriodo ? ' · ' + sinPeriodo + ' sin fechas' : '') + '</small>';
    $('lic-k-renewed').textContent = licCHF(renewed30);
    $('lic-k-due90').textContent = licCHF(due90);
    const rk = $('lic-k-risk');
    /* Sin repetir lo que ya dice la etiqueta de abajo: ahí pone "Vencidas sin cerrar". */
    rk.innerHTML = String(vencidas.length) + (vencidas.length
      ? '<small class="bajo">' + (vencidas.length === 1 ? 'una licencia activa cuya fecha ya pasó' : 'licencias activas cuya fecha ya pasó') + '</small>'
      : '');
    rk.style.color = vencidas.length > 0 ? '#ff8b8b' : '';
    const rl = document.querySelector('#lic-kpis .kpi:last-child .l');
    if (rl) rl.textContent = vencidas.length ? 'Vencidas sin cerrar' : 'En riesgo';
  }
  function licMatch(l){
    if (licFilter === 'active') return l.status === 'active' && !licVencida(l);
    if (licFilter === 'due') return l.status === 'active' && l.renewal_date && licDaysTo(l.renewal_date) <= 30;
    /* "Vencidas" filtraba por status='expired' —que hay que poner a mano— así que la de
