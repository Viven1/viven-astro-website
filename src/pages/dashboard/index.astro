        (baja || dudas.length
          ? '<div class="pj-bill-duda">⚠️ ' + (baja ? 'La IA la leyó con poca confianza. ' : '') +
            (dudas.length ? esc(dudas.join(' · ')) : 'Revisá los números contra el papel.') + '</div>' : '') +
        '<div class="pj-bill-acc">' +
