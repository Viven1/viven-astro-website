    const n = (k) => k === 'pruebas' ? leadsPrueba.length
      : k === 'todas' ? base.length
      : base.filter((r) => k === 'juego' ? PS_EN_JUEGO.includes(stageOf(r.status)) : stageOf(r.status) === 'ganado').length;
    el.innerHTML = [['juego', 'En juego'], ['clientes', 'Clientes'], ['todas', 'Todas']]
      .concat(leadsPrueba.length ? [['pruebas', '🧪 Pruebas']] : [])
      .map(([k, l]) => '<button type="button" data-seg="' + k + '"' + (psSeg === k ? ' class="on"' : '') + '>' + l + ' ' + n(k) + '</button>').join('');
    el.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
