      (lost ? '<span class="lm2-lost" title="' + esc(r.lost_reason || '') + '">Perdido</span>' : '') +
      (snoozed ? '<span class="lm2-lost" style="color:#5ec7d1" title="' + esc((topDealSnz && topDealSnz.follow_up_reason) || '') + '">🕓 Seguimiento futuro' + (snoozeUntil ? ' · ' + snoozeUntil : '') + '</span>' : '');
