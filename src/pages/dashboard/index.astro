      if (error){ btn.disabled = false; toast('No se pudo borrar: ' + error.message); return; }
      allLeads = allLeads.filter((l) => String(l.id) !== String(id));
      abLeadsCache = (abLeadsCache || []).filter((l) => String(l.id) !== String(id));
      if (typeof renderLeads === 'function') renderLeads();
      toast('🗑 Lead borrado');
      abLoad();   // refresca conteos y la lista — el número de la variante baja
    }));
    box.querySelectorAll('.ab-card [data-act]').forEach((btn) => btn.addEventListener('click', async () => {
      if (btn.disabled) return;
      const id = btn.closest('.ab-card').dataset.id, act = btn.dataset.act;
      const patchMap = { run: { status: 'running', start_at: new Date().toISOString() }, pause: { status: 'draft' }, winb: { status: 'done_b', end_at: new Date().toISOString() }, wina: { status: 'done_a', end_at: new Date().toISOString() } };
      if (act === 'cmp'){ const t = abTests.find((x) => String(x.id) === String(id)); if (t) abCompare(t); return; }
      if (act === 'del'){ if (!confirm('¿Borrar este test y sus datos?')) return; await supabase.from('ab_tests').delete().eq('id', id); abExpandedId = null; abLoad(); return; }
      const { error } = await supabase.from('ab_tests').update(patchMap[act]).eq('id', id);
      if (error) toast(error.message); else { toast(act === 'winb' ? '🏆 Variante B activa para el 100% del tráfico' : 'Listo'); abLoad(); }
    }));
