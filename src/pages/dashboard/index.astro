    const path = 'src/pages/' + lang + '/blog/' + slug + '/index.astro';
    return { path, content: astro, slug, lang };
  }
  function copyBlogAstro(){
    const b = buildBlogAstro(); if (!b) return;
    navigator.clipboard.writeText(b.content).then(() => toast('Copiado. Pegalo en: ' + b.path));
  }
  async function publishBlog(opts){
    opts = opts || {};   // ojo: el click del botón pasa el MouseEvent — ahí opts.skipConfirm es undefined y se confirma como siempre
    /* GUARDAR ANTES DE PUBLICAR.
       buildBlogAstro lee el cuerpo, el lead, el eyebrow y las FAQ de bgCur —o sea de
       lo último GUARDADO— mientras que el título, el slug, la foto y el video los lee
       de los campos en pantalla. Con esa mezcla, publicar sin guardar mandaba a la web
       una versión Frankenstein: la foto nueva con el texto viejo, o al revés. Y la
       fila de la base quedaba con lo viejo, así que al reabrir el editor los cambios
       "desaparecían". (Sebastián, 25 ago: "guardé fotos y videos distintos, pero no
       los guardó y publicó los que él quería".)
       Guardar primero hace que las dos mitades vengan del mismo lugar. */
    if (bgCur && bgCur.id && !(await saveBlogEdits(true))) return false;
    let sibs = {};
    if (bgCur && bgCur.group_id){
      const { data: sb } = await supabase.from('blogs').select('lang,slug').eq('group_id', bgCur.group_id).eq('status', 'published');
      (sb || []).forEach((r) => { if (r.lang !== bgCur.lang) sibs[r.lang] = r.slug; });
    }
    const b = buildBlogAstro(sibs); if (!b) return false;
    if (!/^[a-z0-9-]+$/.test(b.slug)) { toast('El slug solo puede tener letras, números y guiones'); return false; }
    const yaEsta = !!(bgCur && bgCur.status === 'published');
    if (!opts.skipConfirm && !confirm(
      yaEsta
        ? '¿Actualizar "' + $('bg-title').value + '" en la web?\n\nReemplaza el artículo que ya está publicado — misma URL, no se crea un duplicado. Tarda ~1-2 min en verse.'
        : '¿Publicar "' + $('bg-title').value + '" en la web?\n\nSe commitea a GitHub y Netlify lo publica en ~1-2 min en viven.ch/blog/' + b.slug + '/')) return false;
    const btn = $('bg-publish'), prev = btn.textContent; btn.disabled = true;
    btn.textContent = yaEsta ? '🔄 Actualizando…' : '🚀 Publicando…';
    $('bg-pub-note').textContent = 'Commiteando a GitHub… (' + (LANGNAME[b.lang] || b.lang) + ')';
    let ok = false;
    try {
      const { data, error } = await supabase.functions.invoke('publish-blog', { body: { path: b.path, content: b.content, message: 'blog: ' + $('bg-title').value } });
      if (error || !data || !data.ok) throw new Error(data?.error || error?.message || 'sin respuesta');
      const liveUrl = 'https://www.viven.ch/' + b.lang + '/blog/' + b.slug + '/';
      // marcar como publicado en la lista
      if (bgCur && bgCur.id) { await supabase.from('blogs').update({ status: 'published', published_at: new Date().toISOString(), published_url: liveUrl }).eq('id', bgCur.id); blogsLoad(); }
      $('bg-pub-note').innerHTML = (data.updated ? '✅ Actualizado' : '✅ Publicado') + ' — Netlify lo está deployando (~1-2 min). Va a estar en <a href="' + esc(liveUrl) + '" target="_blank" style="color:var(--acid)">' + esc(liveUrl) + '</a>' + (data.commit ? ' · <a href="' + esc(data.commit) + '" target="_blank" style="color:var(--muted)">ver commit</a>' : '');
      toast('🚀 Publicado — deployando en Netlify');
      ok = true;
    } catch (e) {
      $('bg-pub-note').textContent = 'No se pudo publicar (¿deployaste publish-blog + seteaste GITHUB_TOKEN?): ' + e.message;
    } finally { btn.disabled = false; btn.textContent = prev; }
    return ok;
  }

  /* ================= COMPANIES (empresas, modelo HubSpot) ================= */
  function domainOf(email){ const d = (email || '').split('@')[1]; if (!d || /gmail|hotmail|outlook|yahoo|icloud|gmx|bluewin|proton|me\.com/i.test(d)) return ''; return d.toLowerCase(); }
  // empresa a la que pertenece la persona: override manual (company_domain) o dominio del email
  function leadDomain(l){ return (l && (l.company_domain || domainOf(l.email))) || ''; }
  function slugKey(s){ return String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 48); }
  /* El nombre de la empresa: primero el que cargaste en su ficha, después el que la
     propia persona escribió al contactarnos, y recién al final el dominio capitalizado.
     El orden estaba al revés de hecho: 158 de los 172 dominios YA tienen el nombre real
     en el contacto y la pantalla igual mostraba "Ldc" en vez de "Louis Dreyfus Company",
     "Schroders" en vez de "Schroder Capital Management (Switzerland) AG". El dato
     estaba; no se estaba mirando. */
  function companyNameDeContactos(domain){
    const cuenta = {};
    (allLeads || []).forEach((l) => {
      if (leadDomain(l) !== domain) return;
      const c = String(l.company || '').trim();
      if (!c || c.toLowerCase() === domain) return;   // "forseasons.swiss" como nombre no aporta
      cuenta[c] = (cuenta[c] || 0) + 1;
    });
    // el más repetido; a igualdad, el más largo (suele ser la razón social completa)
    return Object.keys(cuenta).sort((a, b) => (cuenta[b] - cuenta[a]) || (b.length - a.length))[0] || '';
  }
  function companyName(domain){
    return (coMeta[domain] && coMeta[domain].name)
      || companyNameDeContactos(domain)
      || (domain ? domain.split('.')[0].charAt(0).toUpperCase() + domain.split('.')[0].slice(1) : '');
  }
  // todas las empresas conocidas (con o sin contactos) para el picker connect-or-create
  function allCompanyNames(){ return [...new Set([...companiesData().map((c) => c.name), ...Object.values(coMeta).map((c) => c.name).filter(Boolean)])].sort((a, b) => a.localeCompare(b)); }
  function companiesData(){
    const map = new Map();
    (allLeads || []).filter((l) => !/^claude-/.test(l.session_id || '')).forEach((l) => { const d = leadDomain(l); if (!d) return; if (!map.has(d)) map.set(d, []); map.get(d).push(l); });
    // empresas creadas a mano o importadas que todavía no tienen contactos
    Object.keys(coMeta).forEach((d) => { if (!map.has(d)) map.set(d, []); });
    return [...map.entries()].map(([domain, contacts]) => ({
      domain, name: companyName(domain), contacts,
      value: contacts.reduce((a, l) => a + offersForLead(l.id).reduce((b, o) => b + offerNet(o), 0), 0),
      won: contacts.some((l) => stageOf(l.status) === 'ganado'), meta: coMeta[domain] || null
    })).sort((a, b) => b.value - a.value || b.contacts.length - a.contacts.length || a.name.localeCompare(b.name));
  }
  // estado comercial de la empresa, derivado de sus contactos (no se guarda: se calcula siempre)
  function coStatus(c){
    if (!c.contacts.length) return { k: 'empty', label: 'Sin contactos', color: '#f0c060' };
    if (c.won) return { k: 'client', label: 'Cliente', color: '#7ed957' };
    if (c.contacts.every((l) => stageOf(l.status) === 'perdido')) return { k: 'lost', label: 'Perdido', color: '#9aa4b5' };
    return { k: 'prospect', label: 'Prospecto', color: '#8ab4ff' };
  }
  // plata de la empresa: en juego (draft+sent) y ganado (won) sobre las ofertas de todos sus
  // contactos — los paquetes de propuesta (status 'tier') quedan afuera, como en el pipeline
  function coMoney(c){
    const ofs = c.contacts.flatMap((l) => offersForLead(l.id)).filter((o) => o.status !== 'tier');
    return {
      open: ofs.filter((o) => o.status === 'draft' || o.status === 'sent').reduce((a, o) => a + offerNet(o), 0),
      won: ofs.filter((o) => o.status === 'won').reduce((a, o) => a + offerNet(o), 0),
      offers: ofs
    };
  }
  /* Arranca en "Prospectos". Primero probé con "Clientes" —cualquier cosa antes que
     las 173 filas de "Todas", que en su mayoría tienen un contacto y ningún dato—
     pero Sebastián lo corrigió y el criterio es mejor que el mío: "que abra en
     prospectos, que son los que queremos convertir. Siempre convertir y ganar
     primero". Un cliente ya ganado no necesita que lo mires al abrir la pantalla;
     un prospecto sí. Se recuerda la última elección igual. */
  let coSeg = 'prospect';
  try { const g = localStorage.getItem('vv_co_seg'); if (['all', 'client', 'prospect', 'empty'].includes(g)) coSeg = g; } catch (e) { /* modo privado */ }
  function renderCompanies(){
    if (!coBound){ coBound = true;
      $('co-back').addEventListener('click', () => { coCur = null; $('co-detail').hidden = true; $('co-list-view').hidden = false; });
      $('co-search').addEventListener('input', renderCompaniesList);
      $('co-del-btn').addEventListener('click', deleteCompany);
      $('co-del-sel').addEventListener('click', deleteSelectedCompanies);
      // popovers del header (➕ Crear / ⋯): cada botón togglea el suyo y cierra el otro; click afuera cierra los dos
      $('co-create-btn').addEventListener('click', () => { $('co-more-menu').hidden = true; $('co-create-menu').hidden = !$('co-create-menu').hidden; });
      $('co-more-btn').addEventListener('click', () => { $('co-create-menu').hidden = true; $('co-more-menu').hidden = !$('co-more-menu').hidden; });
      document.addEventListener('click', (e) => { if (!e.target.closest('#co-actions')){ $('co-create-menu').hidden = true; $('co-more-menu').hidden = true; } });
      $('co-new-person').addEventListener('click', coNewPerson);
      $('co-new-offer').addEventListener('click', () => coNewOfferProp('offer'));
      $('co-new-prop').addEventListener('click', () => coNewOfferProp('prop'));
    }
    // la lista queda siempre atrás; el detalle ahora es el modal fullscreen V3 (co3-modal)
    $('co-detail').hidden = true; $('co-list-view').hidden = false; renderCompaniesList();
    co3SafeRefresh();   // si el modal está abierto, refrescarlo con los datos nuevos (sin pisar ediciones en curso)
  }
  async function deleteCompany(){
    const domain = coCur; if (!domain) return;
    const data = companiesData().find((c) => c.domain === domain);
    const n = data ? data.contacts.length : 0;
    const warn = n ? '\n\nOjo: tiene ' + n + ' contacto' + (n === 1 ? '' : 's') + ' — la tarjeta va a seguir apareciendo (agrupada por dominio), pero sin la ficha/notas que cargaste.' : '';
    if (!confirm('¿Borrar la empresa "' + (data ? data.name : domain) + '"?' + warn)) return;
    const { error } = await supabase.from('companies').delete().eq('domain', domain);
    if (error) { alert('No se pudo borrar: ' + error.message); return; }
    delete coMeta[domain];
    coCur = null;
    toast('🗑 Empresa borrada');
    renderCompanies();
  }
  function renderCompaniesList(){
    let data = companiesData();
    const q = ($('co-search').value || '').toLowerCase().trim();
    if (q) data = data.filter((c) => (c.name + ' ' + c.domain).toLowerCase().includes(q));
    $('co-k-count').textContent = data.length;
    $('co-k-contacts').textContent = data.reduce((a, c) => a + c.contacts.length, 0);
    $('co-k-value').textContent = fmtChf(data.reduce((a, c) => a + c.value, 0));
    $('co-k-multi').textContent = data.filter((c) => c.contacts.length >= 2).length;
    // segment control con contadores vivos (sobre lo que quedó de la búsqueda)
    const segN = (k) => k === 'all' ? data.length : data.filter((c) => coStatus(c).k === k).length;
    $('co-seg').innerHTML = [['all', 'Todas'], ['client', 'Clientes'], ['prospect', 'Prospectos'], ['empty', 'Sin contactos']]
      .map(([k, l]) => '<button type="button" data-k="' + k + '" class="' + (coSeg === k ? 'on' : '') + '">' + l + ' ' + segN(k) + '</button>').join('');
    $('co-seg').querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
      coSeg = b.dataset.k;
      try { localStorage.setItem('vv_co_seg', coSeg); } catch (e) { /* modo privado */ }
      renderCompaniesList();
    }));
    if (coSeg !== 'all') data = data.filter((c) => coStatus(c).k === coSeg);
    /* Las que tienen dos o más contactos arriba: una empresa con varias personas es
       la que de verdad tiene una relación atrás, no un email suelto que se agrupó
       por dominio. Dentro de cada grupo manda la plata. */
    data.sort((a, b) => (Math.min(b.contacts.length, 2) - Math.min(a.contacts.length, 2))
      || ((b.value || 0) - (a.value || 0))
      || String(a.name || a.domain).localeCompare(String(b.name || b.domain)));
    $('co-empty').hidden = data.length > 0;
    $('co-list').className = '';
    // tabla estilo Personas (lead-table-hs mantiene todas las columnas en móvil con scroll horizontal)
    const allChecked = data.length > 0 && data.every((c) => coSelected.has(c.domain));
    $('co-list').innerHTML = data.length ? '<div class="lead-table-wrap lead-table-hs"><table class="lead-table"><thead><tr>' +
      '<th class="lt-chk"><input type="checkbox" id="co-chk-all"' + (allChecked ? ' checked' : '') + ' title="Seleccionar todas las visibles" /></th>' +
      '<th>Empresa</th><th>Estado</th><th class="lt-num">Contactos</th><th class="lt-num">En juego</th><th class="lt-num">Ganado</th><th>Última actividad</th>' +
      '</tr></thead><tbody>' + data.map((c) => {
        const st = coStatus(c), mo = coMoney(c);
        // última actividad de la empresa = la más reciente entre todos sus contactos
        const act = c.contacts.map((l) => lastActivity(l)).filter(Boolean).sort((a, b) => b.t - a.t)[0] || null;
        return '<tr data-d="' + esc(c.domain) + '">' +
          '<td class="lt-chk"><input type="checkbox" class="co-row-chk" data-domain="' + esc(c.domain) + '"' + (coSelected.has(c.domain) ? ' checked' : '') + ' onclick="event.stopPropagation()" /></td>' +
          '<td><div class="lt-person"><span class="co2-tav" style="background:' + coColor(c.name) + '">' + esc(c.name.slice(0, 2).toUpperCase()) + '</span><div><div class="lt-name">' + esc(c.name) + '</div><div class="lt-sub">' + esc(c.domain) + '</div></div></div></td>' +
          '<td><span class="of-badge" style="color:' + st.color + ';border-color:' + st.color + '">' + st.label + '</span></td>' +
          '<td class="lt-num">' + c.contacts.length + '</td>' +
          '<td class="lt-val" style="text-align:right">' + (mo.open ? fmtChf(mo.open) : '<span class="lt-num">—</span>') + '</td>' +
          '<td class="lt-val" style="text-align:right;color:#7ed957">' + (mo.won ? fmtChf(mo.won) : '<span class="lt-num" style="color:var(--muted)">—</span>') + '</td>' +
          '<td class="lt-act">' + esc(actLabel(act)) + '</td></tr>';
      }).join('') + '</tbody></table></div>' : '';
    $('co-list').querySelectorAll('tbody tr').forEach((tr) => tr.addEventListener('click', () => openCompany(tr.dataset.d)));
    bindCoSelection(); updateCoDelBtn();
  }
  // Empresas: selección múltiple para borrar en batch (espejo del patrón de Personas)
  let coSelected = new Set();
  function updateCoDelBtn(){
    const btn = $('co-del-sel'); if (!btn) return;
    btn.hidden = coSelected.size === 0;
    btn.textContent = '🗑 Borrar seleccionadas (' + coSelected.size + ')';
  }
  function bindCoSelection(){
    document.querySelectorAll('.co-row-chk').forEach((cb) => cb.addEventListener('change', () => {
      if (cb.checked) coSelected.add(cb.dataset.domain); else coSelected.delete(cb.dataset.domain);
      updateCoDelBtn();
      const all = $('co-chk-all'); if (all) all.checked = [...document.querySelectorAll('.co-row-chk')].every((c) => c.checked);
    }));
    // el "todas" vive en el header de la tabla (se re-renderiza con cada lista, igual que en Personas)
    const allBox = $('co-chk-all');
    if (allBox) allBox.addEventListener('change', () => {
      document.querySelectorAll('.co-row-chk').forEach((cb) => { cb.checked = allBox.checked; if (allBox.checked) coSelected.add(cb.dataset.domain); else coSelected.delete(cb.dataset.domain); });
      updateCoDelBtn();
    });
  }
  async function deleteSelectedCompanies(){
    const doms = [...coSelected]; if (!doms.length) return;
    // (a) con ficha manual en la tabla companies → borrable; (b) solo agrupadas por dominio → no hay fila en DB,
    // la tarjeta existe porque sus contactos comparten dominio y solo desaparece borrando esos contactos
    const withMeta = doms.filter((d) => coMeta[d]);
    const grouped = doms.filter((d) => !coMeta[d]);
    if (!withMeta.length){
      toast('Nada que borrar: esas empresas solo están agrupadas por dominio (sin ficha manual) — para que desaparezcan hay que borrar sus contactos en Personas');
      return;
    }
    const byDom = new Map(companiesData().map((c) => [c.domain, c]));
    const regen = withMeta.filter((d) => { const c = byDom.get(d); return c && c.contacts.length > 0; });
    let msg = '¿Borrar ' + withMeta.length + ' ficha' + (withMeta.length === 1 ? '' : 's') + ' manual' + (withMeta.length === 1 ? '' : 'es') + ' de empresa? Esta acción no se puede deshacer.';
    if (regen.length) msg += '\n\n⚠️ ' + regen.length + ' todavía ' + (regen.length === 1 ? 'tiene' : 'tienen') + ' contactos: su tarjeta va a seguir apareciendo (agrupada por dominio), pero sin la ficha/notas que cargaste.';
    if (grouped.length) msg += '\n\nℹ️ ' + grouped.length + ' seleccionada' + (grouped.length === 1 ? ' se salta' : 's se saltan') + ': solo ' + (grouped.length === 1 ? 'está agrupada' : 'están agrupadas') + ' por dominio, sin ficha manual en la base — para que ' + (grouped.length === 1 ? 'desaparezca' : 'desaparezcan') + ' hay que borrar sus contactos en Personas.';
    if (!confirm(msg)) return;
    const { error } = await supabase.from('companies').delete().in('domain', withMeta);
    if (error) { alert('No se pudo borrar: ' + error.message); return; }
    withMeta.forEach((d) => { delete coMeta[d]; });
    if (coCur && withMeta.includes(coCur)) coCur = null; // si el detalle abierto era una borrada, volver a la lista
    coSelected.clear();
    toast('🗑 ' + withMeta.length + ' ficha' + (withMeta.length === 1 ? ' borrada' : 's borradas'));
    renderCompanies();
  }
  // entry point de siempre: abrir una empresa dispara la ficha V3 fullscreen (misma gramática que Persona V2)
  function openCompany(domain){
    coCur = domain;   // los helpers existentes (coNewPerson, coNewOfferProp, deleteCompany) leen coCur
    co3Open(domain);
  }

  /* ================= EMPRESA V3 (co3-): detalle de empresa con la MISMA gramática visual =================
     que la ficha de PERSONA clásica (pedido de Sebastián: "no puede haber cambios tan grandes").
     Header .lm-top (avatar + nombre + badge + .lm-quick), izquierda .ab-sec con filas label→valor
     (inline-edit al click), centro timeline en un .lm-block, derecha .lm-block cards como la persona. */
  const co3Modal = $('co3-modal');
  let co3Cur = null, co3Filter = 'all', co3Events = [], co3Tasks = [];
  const co3Mobile = () => window.matchMedia('(max-width:960px)').matches;
  function co3Close(keepCur){
    co3Modal.classList.remove('open'); co3Modal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = '';
    co3Cur = null;
    if (!keepCur) coCur = null;
  }
  co3Modal.querySelectorAll('[data-close3]').forEach((el) => el.addEventListener('click', () => co3Close()));
  $('co3-enrich-btn') && $('co3-enrich-btn').addEventListener('click', () => co3Cur && co3RunEnrich(co3Cur));
  // ✨ enriquecimiento de EMPRESA con IA (SQL 0072) — mismo ai-enrich que Personas, pero
  // con solo company/domain (sin name/email). Auto-fill: solo pisa campos VACÍOS (nunca lo
  // que Sebastián ya cargó a mano) — mapeo empresa.nombre→name, industria→industry, web→website,
  // empleados→employees, ubicacion→city, primer redes[].tipo==='linkedin'→linkedin.
  let co3Enriching = false;
  function co3RenderEnrich(domain){
    const box = $('co3-enrich'); if (!box || co3Cur !== domain) return;
    const m = coMeta[domain] || {};
    const when = $('co3-en-when'); if (when) when.textContent = m.enriched_at ? '· actualizado ' + fmtDMY(m.enriched_at) : '';
    box.innerHTML = co3Enriching
      ? '<p class="muted-note">🔎 Buscando info en la web…</p>'
      : (m.enrichment ? enrichHTML(m.enrichment) : '<p class="muted-note">Sin datos todavía — tocá «Buscar info actual» (busca en la web en vivo).</p>');
  }
  async function co3RunEnrich(domain){
    if (!domain || co3Enriching) return;
    co3Enriching = true;
    const btn = $('co3-enrich-btn'); if (btn){ btn.disabled = true; btn.textContent = '🔎 Buscando…'; }
    co3RenderEnrich(domain);
    try {
      const m = coMeta[domain] || {};
      const { data, error } = await supabase.functions.invoke('ai-enrich', { body: { lead: { company: m.name || companyName(domain) || domain, domain } } });
      if (error || (data && data.error)) { toast('No se pudo: ' + ((data && data.error) || error.message)); return; }
      const em = (data.enrichment && data.enrichment.empresa) || {};
      const patch = { enrichment: data.enrichment, enriched_at: new Date().toISOString() };
      if (!m.name && em.nombre) patch.name = em.nombre;
      if (!m.industry && em.industria) patch.industry = em.industria;
      if (!m.website && em.web) patch.website = em.web;
      if (!m.employees && em.empleados) patch.employees = String(em.empleados);
      if (!m.city && em.ubicacion) patch.city = em.ubicacion;
      if (!m.linkedin) { const li = (em.redes || []).find((x) => x.tipo === 'linkedin'); if (li && li.url) patch.linkedin = li.url; }
      const ok = await coSaveMeta(domain, patch);
      if (!ok) return;
      toast('🔎 Empresa enriquecida y guardada');
      if (co3Cur === domain){ co3RenderLeft(domain); }
      renderCompaniesList();
    } catch (e) { toast('No se pudo: ' + (e && e.message || e)); }
    finally {
      co3Enriching = false;
      const btn2 = $('co3-enrich-btn'); if (btn2){ btn2.disabled = false; btn2.textContent = '✨ Buscar info actual'; }
      co3RenderEnrich(domain);
    }
  }
  // la misma lista filtrada que ve el tab Empresas — alimenta la navegación ←/→
  function co3Order(){
    let data = companiesData();
    const q = (($('co-search') && $('co-search').value) || '').toLowerCase().trim();
    if (q) data = data.filter((c) => (c.name + ' ' + c.domain).toLowerCase().includes(q));
    if (coSeg !== 'all') data = data.filter((c) => coStatus(c).k === coSeg);
    return data.map((c) => c.domain);
  }
  /* Lo que se produjo para una empresa: proyectos, briefs y playbook de TODOS sus
     contactos. Se pide al abrir la ficha y no en la carga general — son tres consultas
     que solo hacen falta cuando estás mirando una empresa. */
  let co3Extra = { cargando: false, proyectos: [], briefs: [], playbook: [] };

  async function co3ExtraLoad(domain){
    co3Extra = { cargando: true, proyectos: [], briefs: [], playbook: [] };
    const data = co3Data(domain);
    const ids = data.contacts.map((l) => l.id);
    if (!ids.length){ co3Extra.cargando = false; return; }
    try {
      const { data: proys } = await supabase.from('projects')
        .select('*').in('lead_id', ids).order('started_at', { ascending: false });
      co3Extra.proyectos = proys || [];

      /* El brief cuelga del PROYECTO; el playbook, de la PERSONA. Por eso son dos
         consultas y no una: la misma empresa puede tener un brief contestado por alguien
         que ya no trabaja ahí, y eso sigue siendo información de la empresa. */
      const pids = co3Extra.proyectos.map((x) => x.id);
      if (pids.length){
        const { data: br } = await supabase.from('project_briefs')
          .select('project_id,key,value').in('project_id', pids);
        const porProy = {};
        (br || []).filter((x) => String(x.value || '').trim()).forEach((x) => {
          (porProy[x.project_id] = porProy[x.project_id] || []).push(x);
        });
        co3Extra.briefs = Object.keys(porProy).map((pid) => {
          const p2 = co3Extra.proyectos.find((x) => String(x.id) === String(pid)) || {};
          return { proyecto: (p2.ref ? p2.ref + ' · ' : '') + (p2.title || 'Proyecto'),
                   filas: porProy[pid].map((x) => ({ q: (PBRIEF.BRIEF.find((q) => q.k === x.key) || {}).q?.es || x.key, v: x.value })) };
        });
      }

      const { data: pb } = await supabase.from('playbook_answers')
        .select('ref,key,value').eq('scope', 'lead').in('ref', ids.map(String));
      const porLead = {};
      (pb || []).filter((x) => String(x.value || '').trim()).forEach((x) => {
        (porLead[x.ref] = porLead[x.ref] || []).push(x);
      });
      co3Extra.playbook = Object.keys(porLead).map((lid) => {
        const l = data.contacts.find((c) => String(c.id) === String(lid)) || {};
        return { quien: l.name || l.email || 'Alguien de la empresa',
                 /* PLAYBOOK viene agrupado por tema, así que se aplana para poder
                    buscar la pregunta por su clave. */
                 filas: porLead[lid].map((x) => ({ q: (PLAYBOOK.flatMap((g) => g.qs || []).find((q) => q.k === x.key) || {}).q || x.key, v: x.value })) };
      });
    } catch (e){ /* si algo falla, la ficha se ve igual sin esta parte */ }
    co3Extra.cargando = false;
    if (co3Cur === domain) co3RenderRight(domain);
  }

  function co3Data(domain){
    return companiesData().find((c) => c.domain === domain) || { domain, name: companyName(domain), contacts: [], value: 0, won: false };
  }
  // refresh silencioso desde loadAll: nunca pisa una edición inline ni texto a medio escribir
  function co3SafeRefresh(){
    if (!co3Modal.classList.contains('open') || !co3Cur) return;
    if (co3Modal.querySelector('#co3-l input, #co3-l select')) return;
    const typed = [...co3Modal.querySelectorAll('#co3-r textarea, #co3-r input[type="text"], #co3-tl textarea')].some((t) => (t.value || '').trim());
    if (typed) return;
    co3Open(co3Cur, true);
  }

  function co3Open(domain, isRefresh){
    const data = co3Data(domain);
    co3Cur = domain; coCur = domain;
    if (!isRefresh) co3Filter = 'all';
    const m = coMeta[domain] || {};
    const st = coStatus(data);
    const order = co3Order();
    const oi = order.indexOf(domain);
    let web = m.website || ('https://' + domain);
    if (!/^https?:\/\//i.test(web)) web = 'https://' + web;
    // header IGUAL al de la persona: ← + avatar + nombre grande + badge + subline + botonera .lm-quick
    $('co3-hd').innerHTML =
      '<div class="lm-id">' +
        '<button class="lm-back" id="co3-back" type="button" title="Volver a Empresas">←</button>' +
        '<div class="lm-avatar" style="background:' + coColor(data.name) + ';color:#0f1826">' + esc(data.name.slice(0, 2).toUpperCase()) + '</div>' +
        '<div class="lm-idtext">' +
          '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap"><h3>' + esc(data.name) + '</h3>' +
            '<span class="of-badge" style="color:' + st.color + ';border-color:' + st.color + '">' + st.label + '</span></div>' +
          '<div class="lm-sub">' + esc([domain, m.industry, m.city].filter(Boolean).join(' · ')) + '</div>' +
        '</div>' +
      '</div>' +
      '<div class="lm-quick" style="position:relative">' +
        '<a class="lm-qbtn" id="co3-web" href="' + esc(web) + '" target="_blank" rel="noopener">🌐 Web</a>' +
        '<button class="lm-qbtn" id="co3-crear" type="button">➕ Crear ▾</button>' +
        '<button class="lm-qbtn" id="co3-nav-prev" type="button" title="Empresa anterior"' + (oi <= 0 ? ' disabled' : '') + '>‹</button>' +
        '<button class="lm-qbtn" id="co3-nav-next" type="button" title="Empresa siguiente"' + (oi < 0 || oi >= order.length - 1 ? ' disabled' : '') + '>›</button>' +
        '<button class="lm-qbtn" id="co3-dots" type="button" title="Más acciones">⋯</button>' +
        '<div class="lm2-menu" id="co3-menu" hidden></div>' +
      '</div>';
    const foot = $('co3-foot'); if (foot) foot.textContent = 'Empresa: ' + domain + (oi > -1 ? ' · ' + (oi + 1) + '/' + order.length : '');
    co3ExtraLoad(domain);   // producción, briefs y playbook — se piden solo al abrir la empresa
    const delBtn = $('co3-del-btn'); if (delBtn) delBtn.onclick = async () => { await deleteCompany(); if (!coCur) co3Close(); };
    $('co3-back').addEventListener('click', () => { co3Close(); gotoTab('companies'); });
    $('co3-nav-prev') && $('co3-nav-prev').addEventListener('click', () => oi > 0 && co3Open(order[oi - 1]));
    $('co3-nav-next') && $('co3-nav-next').addEventListener('click', () => oi < order.length - 1 && co3Open(order[oi + 1]));
    // popover compartido (➕ Crear / ⋯) — mismo patrón que lm2Menu
    const menu = $('co3-menu');
    function co3Menu(html, wire){
      menu.innerHTML = html; menu.hidden = false;
      wire(menu);
      setTimeout(() => document.addEventListener('click', () => { menu.hidden = true; }, { once: true }), 0);
    }
    $('co3-crear').addEventListener('click', (e) => {
      e.stopPropagation();
      if (!menu.hidden) { menu.hidden = true; return; }
      co3Menu('<button data-c="person">👤 Persona en esta empresa</button><button data-c="offer">🧾 Oferta</button><button data-c="prop">🌐 Propuesta</button>',
        (mn) => mn.querySelectorAll('button').forEach((cb) => cb.addEventListener('click', (ev) => {
          ev.stopPropagation(); mn.hidden = true;
          const c = cb.dataset.c;
          co3Close(true);   // los flujos existentes navegan a otro tab — cerrar el modal pero conservar coCur (lo leen)
          if (c === 'person') coNewPerson();
          else coNewOfferProp(c === 'offer' ? 'offer' : 'prop');
        })));
    });
    $('co3-dots').addEventListener('click', (e) => {
      e.stopPropagation();
      if (!menu.hidden) { menu.hidden = true; return; }
      co3Menu('<button data-act="web">🌐 Abrir sitio web</button><hr /><button data-act="del" class="danger">🗑 Borrar empresa</button>',
        (mn) => mn.querySelectorAll('button').forEach((b) => b.addEventListener('click', async (ev) => {
          ev.stopPropagation(); mn.hidden = true;
          if (b.dataset.act === 'web') window.open(web, '_blank', 'noopener');
          if (b.dataset.act === 'del') { await deleteCompany(); if (!coCur) co3Close(); }   // deleteCompany confirma y anula coCur si borró
        })));
    });

    co3RenderLeft(domain);
    co3RenderRight(domain);   // los composers de nota/task viven en la columna derecha (igual que la persona)
    co3LoadTimeline(domain);
    co3RenderEnrich(domain);
    // AUTO-disparo (solo la primera vez, sin tocar nada): si nunca se enriqueció y le
    // faltan campos clave, corre solo — no hace falta que Sebastián toque el botón.
    if (!isRefresh && !m.enriched_at && !m.industry && !m.employees) co3RunEnrich(domain);

    co3Modal.classList.add('open');
    co3Modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  /* --- columna izquierda: MISMO patrón que la persona (▾ SECCIÓN en mayúsculas + filas label→valor),
         con inline-edit al click en los campos de la empresa --- */
  function co3RenderLeft(domain){
    const box = $('co3-l'); if (!box || co3Cur !== domain) return;
    const m = coMeta[domain] || {};
    const data = co3Data(domain);
    const mo = coMoney(data);
    const nDeals = data.contacts.reduce((a, l) => a + dealsForLead(l.id).length, 0);
    const row = (k, v, edit, fkey) => '<div class="ab-row"><span class="ab-k">' + k + '</span>' +
      '<span class="ab-v' + (edit ? ' co3-fld' : '') + '"' + (edit ? ' data-f="' + fkey + '" title="Clic para editar" style="cursor:pointer"' : '') + '>' +
      (v || '—') + '</span></div>';
    const sec = (t, rows, open) => '<details class="ab-sec lm-fold"' + (open ? ' open' : '') + '><summary class="ab-h">' + t + '</summary>' + rows + '</details>';
    box.innerHTML =
      sec('Sobre la empresa',
        CO_FIELDS.map(([k, l]) => row(l, m[k] ? esc(String(m[k])) : '', true, k)).join('') +
        row('Dominio', esc(domain)), true) +
      sec('Negocio',
        row('En juego', mo.open ? fmtChf(mo.open) : '') +
        row('Ganado', mo.won ? '<span style="color:#7ed957">' + fmtChf(mo.won) + '</span>' : '') +
        row('Proyectos', String(nDeals)), true) +
      (!coMeta[domain] ? '<p class="muted-note" style="margin-top:12px;font-size:11px">Empresa agrupada por dominio: al editar un campo se crea su ficha en la base.</p>' : '');
    box.querySelectorAll('.co3-fld').forEach((el) => el.addEventListener('click', () => co3EditField(domain, el)));
  }
  function co3EditField(domain, el){
    if (el.querySelector('input')) return;
    const f = el.dataset.f; const cur = String((coMeta[domain] || {})[f] || '');
    el.innerHTML = '<input class="ed-inp" value="' + esc(cur) + '" style="width:100%;font-size:12.5px;padding:5px 7px" />';
    const inp = el.querySelector('input'); inp.focus(); inp.select();
    let done = false;
    const finish = async (save) => {
      if (done) return; done = true;
      const v = inp.value.trim();
      if (save && v !== cur){
        if (await coSaveMeta(domain, { [f]: v || null })) toast('Empresa guardada');
        co3Open(domain, true); renderCompaniesList();   // nombre/industria/ciudad afectan header, subline y lista
        return;
      }
      co3RenderLeft(domain);
    };
    inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') finish(true); else if (e.key === 'Escape') finish(false); });
    inp.addEventListener('blur', () => finish(true));
  }

  /* --- notas/tasks de la empresa: viven como BLOQUES de la columna derecha (igual que la persona);
         la nota/task se guarda en la ficha del contacto elegido --- */
  function co3ContactOpts(){
    const data = co3Data(co3Cur);
    return data.contacts.map((l, i) => '<option value="' + esc(String(l.id)) + '"' + (i === 0 ? ' selected' : '') + '>' + esc(l.name || l.email) + '</option>').join('');
  }
  // compat: los flujos viejos llamaban al composer del centro — ahora re-renderiza la columna derecha
  function co3RenderComposer(){ if (co3Cur) co3RenderRight(co3Cur); }

  /* --- timeline agregada de toda la empresa: emails + hilos de notas + tasks + ofertas ganadas --- */
  async function co3LoadTimeline(domain){
    const box = $('co3-tl'); if (!box || co3Cur !== domain) return;
    const data = co3Data(domain);
    const ids = data.contacts.map((l) => String(l.id));
    if (!ids.length){
      co3Events = []; co3Tasks = [];
      co3RenderChips();
      box.innerHTML = '<p class="muted-note">Sin contactos — la actividad de sus personas va a aparecer acá.</p>';
      return;
    }
    const nameOf = (id) => { const l = data.contacts.find((c) => String(c.id) === String(id)); return l ? (l.name || l.email) : ''; };
    const q = (t) => t.then((x) => (x && !x.error && x.data) || []).catch(() => []);
    const [emails, notes, tasks] = await Promise.all([
      q(supabase.from('email_log').select('*').in('lead_id', ids).order('created_at', { ascending: false }).limit(120)),
      q(supabase.from('lead_notes').select('*').in('lead_id', ids).order('created_at', { ascending: false }).limit(120)),
      q(supabase.from('lead_tasks').select('*').in('lead_id', ids).order('created_at', { ascending: false }).limit(120)),
    ]);
    if (co3Cur !== domain) return;   // cambió de empresa mientras cargaba
    co3Tasks = tasks;
    const ev = [];
    emails.forEach((e2) => ev.push({ t: e2.created_at, ty: 'email', chip: ['email', e2.direction === 'in' ? '📥 Recibido' : '✉️ Enviado'], title: '<b>' + esc(e2.subject || '(sin asunto)') + '</b>', meta: [esc(e2.sender_label || ''), 'con ' + esc(nameOf(e2.lead_id))].filter(Boolean).join(' · '), body: String(e2.body || '').replace(/<[^>]+>/g, ' ') }));
    // notas en HILOS estilo chat (mismo modelo que la Ficha V2: parent_id → nota raíz, un evento por hilo)
    const thrMap = new Map();
    notes.filter((n) => !n.parent_id).forEach((n) => thrMap.set(n.id, { root: n, replies: [] }));
    notes.filter((n) => n.parent_id).forEach((n) => { const t2 = thrMap.get(n.parent_id); if (t2) t2.replies.push(n); else thrMap.set(n.id, { root: n, replies: [] }); });
    thrMap.forEach((t2) => {
      t2.replies.sort(masViejo('created_at'));
      const last = t2.replies.length ? t2.replies[t2.replies.length - 1] : t2.root;
      ev.push({ t: last.created_at, ty: 'nota', chip: ['nota', t2.replies.length ? '💬 Hilo (' + (t2.replies.length + 1) + ')' : '📝 Nota'], thread: t2, who: nameOf(t2.root.lead_id), nid: t2.root.id, nleadid: t2.root.lead_id, nauthor: t2.root.author || '', nbody: t2.root.body || '' });
    });
    tasks.forEach((t) => ev.push({ t: t.created_at, ty: 'task', task: t, chip: ['task', t.done ? '✅ Task hecha' : '⏳ Task'], meta: [t.due_date ? '📅 ' + t.due_date + (t.due_time ? ' · 🕒 ' + t.due_time : '') : '', t.assignee ? teamName(t.assignee) : '', nameOf(t.lead_id)].filter(Boolean).join(' · ') }));
    data.contacts.forEach((l) => offersForLead(l.id).filter((o) => o.status === 'won').forEach((o) => ev.push({ t: o.updated_at || o.created_at, ty: 'sys', chip: ['sys', '🏆 Ganada'], title: '<b>' + esc(o.title || 'Oferta') + '</b> · ' + fmtChf(offerNet(o)), meta: nameOf(l.id) })));
    ordenarEventos(ev);
    co3Events = ev;
    co3RenderChips();
    co3RenderTl();
    co3RenderRight(domain);   // las tasks abiertas del rail derecho salen de esta carga
  }
  function co3RenderChips(){
    const CH = [['all', 'Todo'], ['email', '✉️ Emails'], ['nota', '📝 Notas'], ['task', '✅ Tasks'], ['sys', '🏆 Ganadas']];
    $('co3-chips').innerHTML = CH.map(([k, l]) => { const n = k === 'all' ? co3Events.length : co3Events.filter((e) => e.ty === k).length;
      return '<button data-f="' + k + '" class="' + (co3Filter === k ? 'on' : '') + '">' + l + (n ? ' ' + n : '') + '</button>'; }).join('');
    $('co3-chips').querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { co3Filter = b.dataset.f; co3RenderChips(); co3RenderTl(); }));
  }
  function co3RenderTl(){
    const box = $('co3-tl'); if (!box) return;
    const list = co3Filter === 'all' ? co3Events : co3Events.filter((e) => e.ty === co3Filter);
    if (!list.length) { box.innerHTML = '<p class="muted-note">Sin actividad todavía — los emails, notas y tasks de sus contactos van a aparecer acá.</p>'; return; }
    const when = (t) => lm2FmtDT(t) + ' · hace ' + timeAgo(t);
    const replyLink = (i) => '<div class="lm-note-m"><button class="lm-reply-btn co3-nreply" data-i="' + i + '" type="button">↩ Responder</button><div class="co3-nreply-box" hidden style="width:100%"></div></div>';
    // mismos componentes que la ficha de persona: emails = .lm-email (click expande),
    // notas = .lm-note con respuestas .lm-reply, tasks = .lm-task con checkbox
    box.innerHTML = list.map((e, i) => {
      if (e.thread){
        const msg = (n, isRep) => '<div class="lm-note' + (isRep ? ' lm-reply' : '') + '" style="border-bottom:0;padding:' + (isRep ? '6px 0 2px 10px' : '4px 0 0') + '">' +
          '<div class="lm-note-b">' + esc(n.body || '') + '</div>' +
          '<div class="lm-note-m">' + esc(n.author || '¿?') + ' · hace ' + timeAgo(n.created_at) + '</div></div>';
        return '<div class="lm-email" style="cursor:default">' +
          '<div class="lm-email-h"><span class="lm-email-subj">' + e.chip[1] + (e.who ? ' <span style="font-weight:400;color:var(--muted-2)">en ' + esc(e.who) + '</span>' : '') + '</span><span class="lm-email-meta">' + when(e.t) + '</span></div>' +
          msg(e.thread.root, false) + e.thread.replies.map((n) => msg(n, true)).join('') + replyLink(i) + '</div>';
      }
      if (e.ty === 'task'){
        const t = e.task || {};
        return '<div class="lm-task' + (t.done ? ' done' : '') + '"><input type="checkbox" class="co3-tk" data-id="' + esc(String(t.id)) + '"' + (t.done ? ' checked' : '') + '/>' +
          '<div class="lm-task-txt"><div>' + esc(t.title || '') + '</div>' +
          '<div class="lm-task-meta">' + (e.meta || '') + ' · ' + when(e.t) + '</div></div></div>';
      }
      if (e.ty === 'email'){
        const inbound = /Recibido/.test(e.chip[1]);
        return '<div class="lm-email' + (inbound ? ' lm-email-in' : '') + '">' +
          '<div class="lm-email-h"><span class="lm-email-subj">' + (inbound ? '📥 ' : '') + e.title + '</span><span class="lm-email-meta">' + when(e.t) + '</span></div>' +
