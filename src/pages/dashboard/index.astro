  // calendario editorial: qué salió, qué se escribe en el próximo cron (lu/mié/vie 7:30) y qué está en cola
  function bl2NextSlots(n){
    const out = []; const now = new Date();
    for (let i = 0; out.length < n && i < 21; i++) {
      const c = new Date(now.getFullYear(), now.getMonth(), now.getDate() + i, 7, 30, 0, 0);
      if ([1, 3, 5].indexOf(c.getDay()) === -1) continue;
      if (c <= now) continue;
      out.push(c);
    }
    return out;
  }
  function bl2RenderCal(){
    const box = $('bl2-cal'); if (!box) return;
    const DOW = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
    const DL = (d) => DOW[d.getDay()] + ' ' + d.getDate();
    const slots = bl2NextSlots(2);
    const cells = [];
    // último grupo publicado
    const lastPub = bl2Groups().filter((g) => g.pub.length).sort((a, b) => b.date - a.date)[0];
    if (lastPub) cells.push('<div class="bl2-day"><div class="d">' + DL(new Date(lastPub.date)) + '</div><div class="t">' + esc(lastPub.main.title || lastPub.main.topic || '') + '</div><span class="bl2-st done">✓ publicado ×' + lastPub.pub.length + '</span></div>');
    // borrador esperando ok (si hay, es lo que acaba de escribir el motor)
    const pend = bl2Groups().filter((g) => g.pending).sort((a, b) => b.date - a.date)[0];
    if (pend) cells.push('<div class="bl2-day next" data-review="' + esc(pend.main.id) + '" style="cursor:pointer"><div class="d">esperando tu ok</div><div class="t">' + esc(pend.main.title || pend.main.topic || '') + '</div><span class="bl2-st work">📝 borrador ×' + pend.rows.length + '</span></div>');
    // próximos crons con los temas de la cola
    slots.forEach((s, i) => {
      const topic = bl2Queue[i];
      cells.push('<div class="bl2-day' + (i === 0 && !pend ? ' next' : '') + '"><div class="d">' + DL(s) + (i === 0 ? ' · próximo' : '') + '</div><div class="t">' + (topic ? esc(topic.topic) : '<span class="muted-note">cola vacía</span>') + '</div><span class="bl2-st ' + (i === 0 ? 'work">⚙ se escribe 07:30' : 'pend">en cola') + '</span></div>');
    });
    cells.push('<div class="bl2-day add" id="bl2-cal-add"><div class="d">cola</div><div class="t">➕ agregar tema…</div><span class="bl2-st pend">' + bl2Queue.length + ' tema' + (bl2Queue.length === 1 ? '' : 's') + ' en cola</span></div>');
    box.innerHTML = cells.join('');
    const add = $('bl2-cal-add');
    if (add) add.addEventListener('click', () => {
      const p = $('cq-panel'); if (p) p.open = true;
      const inp = $('cq-new'); if (inp) { inp.scrollIntoView({ behavior: 'smooth', block: 'center' }); setTimeout(() => inp.focus(), 350); }
    });
    box.querySelectorAll('[data-review]').forEach((c) => c.addEventListener('click', () => loadBlog(c.dataset.review, true)));
  }
  /* ================= LEAD MAGNETS (🧲) ================= */
  // Parte A: performance real de los 2 imanes que YA existen — sin tablas nuevas,
