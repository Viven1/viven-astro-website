  async function saveBookingSet(){
    if (!meEmail) { toast('Sin sesión detectada — entrá de nuevo'); return; }
    const durations = [...document.querySelectorAll('.bks-dur:checked')].map((x) => +x.value);
    const days = [...document.querySelectorAll('#bks-days input:checked')].map((x) => +x.value);
    if (!durations.length) { toast('Elegí al menos una duración'); return; }
    if (!days.length) { toast('Elegí al menos un día'); return; }
    const row = { updated_at: new Date().toISOString(), active: $('bks-active').checked,
      work_start: time2mins($('bks-start').value), work_end: time2mins($('bks-end').value),
      notice_hours: +$('bks-notice').value || 0, horizon_days: +$('bks-horizon').value || 28,
      buffer_min: +$('bks-buffer').value || 0, durations, days,
      host_name: $('bks-hname').value.trim(), host_role: $('bks-hrole').value.trim(),
      msg_en: $('bks-msg-en').value.trim() || null, msg_de: $('bks-msg-de').value.trim() || null, msg_es: $('bks-msg-es').value.trim() || null };
    // fix: cada persona (dueño incluido) escribe SU PROPIA fila por email — antes el dueño
    // pisaba siempre la fila legacy id=1, dejando su fila real huérfana e inaccesible
    row.email = meEmail;
    if (row.work_end - Math.max(...durations) < row.work_start) { toast('El horario es demasiado corto para la duración más larga'); return; }
    let error;
    if (bkRowId) {
      ({ error } = await supabase.from('booking_settings').update(row).eq('id', bkRowId));
    } else {
      const res = await supabase.from('booking_settings').insert(row).select('id').maybeSingle();
      error = res.error; if (!error && res.data) bkRowId = res.data.id;
    }
    if (error) { toast('No se pudo guardar (¿SQL 0073?): ' + error.message); return; }
    $('bks-note').textContent = '';
    toast('📅 Tus horarios de booking quedaron guardados');
  }
