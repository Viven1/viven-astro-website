  /* Puntería de cada motor: de todo lo que ya decidiste, cuánto salió y cuánto tiraste.
     Es lo único que distingue un motor que trabaja para vos de uno que te da trabajo. */
  async function obMotores(){
    const box = $('ob-motores'); if (!box) return;
    const { data, error } = await supabase.from('outbox').select('kind,status').in('status', ['sent', 'discarded']);
    if (error || !data || !data.length){ box.hidden = true; return; }
    const LBL = { content_followup: '🎯 Contenido', reactivation: '♻️ Reactivación', followup: '📬 Follow-up',
                  followup_later: '🕓 Seguimiento futuro' };
    const por = {};
    data.forEach((o) => {
      const k = o.kind || 'workflow';
      por[k] = por[k] || { sent: 0, discarded: 0 };
      por[k][o.status] += 1;
    });
    const filas = Object.keys(por).map((k) => {
      const p = por[k], tot = p.sent + p.discarded;
      const pct = Math.round((p.sent / tot) * 100);
      /* Menos de un tercio aprobado y al menos 5 decididos: no es mala racha, es el
         motor. Con 4 decididos todavía puede ser casualidad y no vale asustar. */
      const mal = tot >= 5 && pct < 34;
      return { k, lbl: LBL[k] || '⚙️ ' + k, sent: p.sent, disc: p.discarded, tot, pct, mal };
    }).sort((a, b) => b.tot - a.tot);
    box.innerHTML = '<div class="ob-mot-h">Puntería de cada motor <em>de lo ya decidido</em></div>'
      + filas.map((f) => '<div class="ob-mot' + (f.mal ? ' mal' : '') + '">'
        + '<b>' + esc(f.lbl) + '</b>'
        + '<span class="ob-mot-bar"><i style="width:' + f.pct + '%"></i></span>'
        + '<span class="ob-mot-n">' + f.sent + ' de ' + f.tot + ' salieron · ' + f.pct + '%</span>'
        + (f.mal ? '<span class="ob-mot-w">tiraste ' + f.disc + ' — este motor te está dando trabajo, no ahorrándotelo</span>' : '')
        + '</div>').join('');
    box.hidden = false;
  }

  async function obLoad(){
   try {
    const nowIso = new Date().toISOString();
    const { data, error } = await supabase.from('outbox').select('*').in('status', ['pending', 'approved']).order('created_at');
    if (error){ $('ob-list').innerHTML = '<p class="muted-note">⚠️ ' + esc(error.message) + '</p>'; return; }
    // 🕐 VENTANA DE ARREPENTIMIENTO: aprobar programa el envío a +10 min; acá
    // arriba se ven los "por salir" con ↩︎ Deshacer hasta que salen de verdad
    const aprRows = (data || []).filter((o) => o.status === 'approved');
    obAprCache = aprRows;
    obUndoSched = (id) => {
      const row = (data || []).find((o) => String(o.id) === String(id));
      const undoAt = new Date(Date.now() + 10 * 60e3);
      const prev = row && row.scheduled_at ? new Date(row.scheduled_at) : null;
      return (prev && prev > undoAt ? prev : undoAt).toISOString();
    };
    // "⏰ Más tarde" oculta el borrador hasta scheduled_at — no lo borra de la
    // bandeja real. PERO en content_followup scheduled_at significa otra cosa
    // (la fecha real de envío del paso, para poder revisar los 3 pasos de la
    // secuencia de una — pedido explícito) y ahí SÍ debe seguir visible aunque
    // sea futuro.
    const pend = (data || []).filter((o) => o.status === 'pending');
    const obs = pend.filter((o) => o.kind === 'content_followup' || !o.scheduled_at || o.scheduled_at <= nowIso);
    const snoozed = pend.length - obs.length;
    $('ob-count').textContent = obs.length || '';
    $('ob-approve-all').hidden = obs.length < 2;
    obBadgeRefresh();
    obMotores();
    $('ob-list').innerHTML = obPorSalirHTML(aprRows) + obs.map((o) => {
      const l = (allLeads || []).find((x) => String(x.id) === String(o.lead_id)) || {};
      const CFW_CAT_LBL = { product: '📦 Product', brand: '🎬 Brand', employer: '👥 Employer branding', howto: '🎓 How-to', social: '📱 Social', corporate: '🏢 Corporate' };
      const srcTag = o.kind === 'followup' ? '📬 Follow-up' : o.kind === 'content_followup' ? '🎯 ' + (CFW_CAT_LBL[o.category] || o.category || 'Contenido') + ' · paso ' + o.step : o.kind === 'reactivation' ? '♻️ Reactivación · ' + (o.category === 'won' ? 'cliente ganado' : 'lead perdido') : o.kind === 'followup_later' ? '🕓 Seguimiento futuro' : '⚙️ Workflow';

      /* El borrador guarda un remitente por defecto —"team" para lo automático—, pero el
         que lo está por mandar es el que está mirando la pantalla. Si es Sofía o
         Sebastián, el desplegable arranca en su nombre; el valor guardado solo manda
         cuando alguien ya lo eligió a mano (sofia/sebastian) o cuando no sabemos quién es.
         Sin esto, Sofía tenía que acordarse de cambiarlo en cada envío, y 30 seguimientos
         salieron de info@ pidiendo respuesta. Un buzón que escribe no invita a contestar. */
      const obDe = (x) => (x.sender && x.sender !== 'team') ? x.sender : (yoClave() || x.sender || 'team');
      const senderEmail = SENDER_EMAIL_G[o.sender] || SENDER_EMAIL_G.team;
      const senderName = o.sender === 'sebastian' ? 'Sebastian' : o.sender === 'sofia' ? 'Sofia' : 'VIVEN';
      // content_followup: scheduled_at es la fecha real de envío (no un
      // snooze) — se muestra siempre para dejar claro que aprobar HOY no
      // manda antes de esa fecha, respeta el espaciado de la secuencia.
      // Va en TODOS los borradores, no solo en los de secuencia: aprobar sin saber
      // cuándo sale era medio a ciegas. Sin scheduled_at se dice qué pasa igual —
      // callarlo se leía como "no está programado", que es lo contrario de la verdad.
      const schedNote = '<div class="ob-sched-note">📅 Si lo aprobás, ' + esc(obCuandoSaleTxt(o.scheduled_at)) +
        // los 10 min de arrepentimiento solo aplican cuando no tiene fecha propia futura
        (!o.scheduled_at || o.scheduled_at <= nowIso ? ' · tenés 10 minutos para deshacer' : '') + '</div>';
      return '<div class="au-step" data-ob="' + o.id + '" data-kind="' + esc(o.kind || '') + '" data-lead="' + esc(String(o.lead_id || '')) + '" data-to="' + esc(l.name || l.email || ('Lead #' + o.lead_id)) + (l.email ? ' <' + esc(l.email) + '>' : '') + '">' +
        '<div class="ob-hd"><div class="ob-who">' + teamAvatarHtml(senderEmail, senderName) + '<b>' + esc(l.name || l.email || 'Lead #' + o.lead_id) + '</b>' + (l.company ? '<span class="muted-note">' + esc(l.company) + '</span>' : '') + '</div>' +
        '<span class="ob-kind">' + esc(srcTag) + '</span></div>' +
        schedNote +
        '<div class="ob-row"><div class="ob-f"><label>Sale de</label><select class="ob-sender"><option value="sofia"' + (obDe(o) === 'sofia' ? ' selected' : '') + '>Sofia</option><option value="sebastian"' + (obDe(o) === 'sebastian' ? ' selected' : '') + '>Sebastian</option><option value="team"' + (obDe(o) === 'team' ? ' selected' : '') + '>VIVEN (team)</option></select></div>' +
        '<div class="ob-f" style="flex:3"><label>Asunto</label><input class="ob-subject" value="' + esc(o.subject) + '" /></div></div>' +
        (o.kind === 'content_followup'
          ? '<div class="ob-f"><div class="ob-preview-bar"><label>Vista previa</label><button type="button" class="ob-html-toggle">✏️ Editar HTML</button></div>' +
            '<iframe class="ob-preview-frame" sandbox=""></iframe>' +
            '<div class="ob-html-editor" hidden><textarea class="ob-body">' + esc(o.body) + '</textarea></div></div>'
          : '<div class="ob-f"><label>Cuerpo</label><textarea class="ob-body">' + esc(o.body) + '</textarea></div>') +
        '<div class="ab-urlrow" style="margin-top:4px"><button class="btn btn-primary small" data-obact="ok" data-id="' + o.id + '" type="button">✅ Aprobar y enviar</button>' +
        '<button class="btn btn-ghost small" data-obact="lead" data-id="' + o.lead_id + '" type="button">👤 Ver ficha</button>' +
        // content_followup: scheduled_at ES la fecha real de envío del paso — el snooze
        // de 4h la pisaría y un paso pensado para día+9 saldría al toque. Sin botón ahí.
        (o.kind === 'content_followup' ? '' : '<button class="btn btn-ghost small" data-obact="later" data-id="' + o.id + '" type="button">⏰ Más tarde</button>') +
        '<button class="btn btn-ghost small danger" data-obact="no" data-id="' + o.id + '" type="button">✕ No enviar</button></div></div>';
    }).join('') || '<p class="muted-note">Bandeja vacía' + (snoozed ? ' (' + snoozed + ' pospuesto' + (snoozed > 1 ? 's' : '') + ' para más tarde)' : ' — los pasos 🤖 Email IA de tus workflows dejan acá sus borradores.') + '</p>';
    // content_followup guarda el body como HTML ya armado (thumbnails, link
    // cards) — un textarea con el markup crudo es imposible de revisar a
    // ojo. Se arma la preview como iframe (srcdoc vía JS, no atributo HTML,
    // así no hay que escapar comillas/apóstrofes del contenido) en vez de
    // mostrar el HTML como texto.
    $('ob-list').querySelectorAll('.ob-preview-frame').forEach((frame) => {
      const card = frame.closest('.au-step');
      const body = card.querySelector('.ob-body').value;
      obSetPreview(frame, body);
    });
    $('ob-list').querySelectorAll('.ob-html-toggle').forEach((btn) => btn.addEventListener('click', () => {
      const wrap = btn.closest('.ob-f');
      const editor = wrap.querySelector('.ob-html-editor');
      let frame = wrap.querySelector('.ob-preview-frame');
      const showingEditor = !editor.hidden;
      if (showingEditor) { frame = obSetPreview(frame, wrap.querySelector('.ob-body').value); }
      editor.hidden = !editor.hidden; frame.hidden = !frame.hidden;
      btn.textContent = editor.hidden ? '✏️ Editar HTML' : '🖼 Ver vista previa';
    }));
    $('ob-list').querySelectorAll('[data-obact]').forEach((b) => b.addEventListener('click', async () => {
      const act = b.dataset.obact;
      if (act === 'lead'){ gotoTab('leads'); openLead(b.dataset.id); return; }
      const card = b.closest('.au-step');
      if (act === 'ok'){
        const subj = card.querySelector('.ob-subject').value;
        const rawBody = card.querySelector('.ob-body').value.trim();
        const bodyPreview = (card.querySelector('.ob-html-editor') ? obHtmlToPreviewText(rawBody) : rawBody).slice(0, 220);
        const schedTxt = card.querySelector('.ob-sched-note');
        const schedLine = schedTxt ? '\n\n' + schedTxt.textContent : '';
        if (!confirm('¿Aprobar este email para ' + card.dataset.to + '?\n\nAsunto: ' + subj + '\n\n' + bodyPreview + (bodyPreview.length >= 220 ? '…' : '') + schedLine + '\n\nSale en 10 minutos — hasta entonces podés deshacerlo desde la Bandeja.')) return;
        const upd = { status: 'approved', sender: card.querySelector('.ob-sender').value, subject: subj, body: card.querySelector('.ob-body').value, scheduled_at: obUndoSched(b.dataset.id) };
        const { error: e2 } = await supabase.from('outbox').update(upd).eq('id', b.dataset.id);
        if (e2){ toast(e2.message); return; }
        toast('✅ Aprobado — 🕐 sale según lo programado (↩︎ Deshacer arriba en la Bandeja)');
      } else if (act === 'later'){
        const when = new Date(Date.now() + 4 * 3600e3).toISOString();
        const { error: e2 } = await supabase.from('outbox').update({ scheduled_at: when }).eq('id', b.dataset.id);
        if (e2){ toast('⚠️ ' + e2.message + ' (¿corriste la SQL 0063?)'); return; }
        toast('⏰ Pospuesto 4 horas');
      } else {
        /* Descartar una reactivación no era solo "este texto no": el motor marca
           leads.reactivation_drafted_at al CREAR el draft y no lo resetea nunca, así
           que descartar sacaba a esa persona de la lista para toda la vida — en
           silencio. Medido el 25 ago 2026: 13 de 15 borradores descartados, y 12
           personas quemadas sin que nadie lo decidiera. Ahora la pantalla pregunta
           cuál de las dos cosas quisiste. */
        if (card.dataset.kind === 'reactivation' && card.dataset.lead){
          const vuelve = confirm('Descartás el borrador para ' + card.dataset.to + '.\n\n'
            + 'A cada persona se le escribe UNA sola vez en la vida, así que descartar también la saca de la lista para siempre.\n\n'
            + 'Aceptar → descartar este texto, pero que pueda volver a proponerse más adelante\n'
            + 'Cancelar → descartar y no escribirle nunca más');
          await supabase.from('outbox').update({ status: 'discarded' }).eq('id', b.dataset.id);
          if (vuelve){
            const { error: e3 } = await supabase.from('leads').update({ reactivation_drafted_at: null }).eq('id', card.dataset.lead);
            toast(e3 ? ('✕ Descartado, pero no pude devolverlo a la lista: ' + e3.message) : '✕ Descartado — vuelve a la lista más adelante');
          } else {
            toast('✕ Descartado — no se le vuelve a escribir');
          }
        } else {
          await supabase.from('outbox').update({ status: 'discarded' }).eq('id', b.dataset.id);
          toast('✕ No se envía');
        }
      }
      obLoad();
    }));
    // ↩︎ Deshacer una aprobación (mientras está en la ventana de 10 min)
    $('ob-list').querySelectorAll('[data-obundo]').forEach((b) => b.addEventListener('click', async () => {
      const row = obAprCache.find((o) => String(o.id) === String(b.dataset.obundo));
      // content_followup conserva su fecha real de envío; el resto vuelve limpio
      const upd = row && row.kind === 'content_followup' ? { status: 'pending' } : { status: 'pending', scheduled_at: null };
      const { error: e2 } = await supabase.from('outbox').update(upd).eq('id', b.dataset.obundo).eq('status', 'approved');
      if (e2){ toast('⚠️ ' + e2.message); return; }
      toast('↩︎ Deshecho — volvió a pendiente, no se envía');
      obLoad();
    }));
    $('ob-approve-all').onclick = async () => {
      if (!confirm('¿Aprobar TODOS los borradores tal como están?\n\nSalen según lo programado — hasta entonces podés deshacer cada uno (o todos) desde la Bandeja.')) return;
      for (const card of $('ob-list').querySelectorAll('.au-step')){
        await supabase.from('outbox').update({ status: 'approved', sender: card.querySelector('.ob-sender').value, subject: card.querySelector('.ob-subject').value, body: card.querySelector('.ob-body').value, scheduled_at: obUndoSched(card.dataset.ob) }).eq('id', card.dataset.ob);
      }
      toast('✅ Todos aprobados — 🕐 salen según lo programado (↩︎ Deshacer arriba)'); obLoad();
    };
   } catch (e) { $('ob-list').innerHTML = '<p class="muted-note">⚠️ ' + esc(e && e.message || e) + '</p>'; }
  }

