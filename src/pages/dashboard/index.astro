        '<div class="ab-cmp-col"><div class="ab-cmp-l lb">B — Variante (' + (t.changes || []).length + ' cambio/s)</div><iframe src="' + esc(base) + '?vvab=' + t.id + ':b" loading="eager"></iframe></div>' +
