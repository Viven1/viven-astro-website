  /* El veredicto compara Bing CONTRA Google, así que necesita los dos cargados.
     Antes se escribía dentro de loadBing() leyendo seoData: como ahora los dos
     arrancan a la vez, Bing solía terminar primero y la línea nunca aparecía.
     Ahora la escribe quien termine último. */
  let bingTotals = null;
  function bingVerdict(){
    const v = $('bing-verdict'); if (!v || !bingTotals) return;
    const g = (seoData && seoData.totals) || null;
    const { clicks, impr } = bingTotals;
    if (!g || !g.impressions){ v.textContent = 'Mismo período que Google'; return; }
    const ctrB = impr ? clicks / impr : 0, ctrG = g.ctr || 0;
    const menos = impr ? Math.round(g.impressions / impr) : 0;
    v.innerHTML = ctrB > ctrG * 1.5
      ? '⚡ Manda ' + menos + '× menos impresiones que Google, pero su CTR es ' +
        (ctrG ? (ctrB / ctrG).toFixed(1) : '–') + '× mejor'
      : 'Comparado con Google en el mismo período';
  }
  async function loadBing(){
    const box = $('bing-panel'); if (!box) return;
    try {
      const desde = new Date(Date.now() - seoDays * 864e5).toISOString().slice(0, 10);
      const { data, error } = await supabase.from('bing_daily')
        .select('date,query,clicks,impressions,position').gte('date', desde);
      if (error) throw error;
      if (!data || !data.length) { box.hidden = true; return; }
      box.hidden = false;

      const clicks = data.reduce((t, r) => t + (r.clicks || 0), 0);
      const impr = data.reduce((t, r) => t + (r.impressions || 0), 0);
      const conPos = data.filter((r) => r.position);
      const pos = conPos.length ? conPos.reduce((t, r) => t + Number(r.position), 0) / conPos.length : 0;
      const fmtN = (n) => (n || 0).toLocaleString('de-CH');
      $('bing-k-clicks').textContent = fmtN(clicks);
      $('bing-k-impr').textContent = fmtN(impr);
      $('bing-k-ctr').textContent = impr ? (clicks / impr * 100).toFixed(1) + '%' : '–';
      $('bing-k-pos').textContent = pos ? pos.toFixed(1) : '–';

      const consultas = new Map();
      for (const r of data) {
        const a = consultas.get(r.query) || { clicks: 0, impressions: 0, pos: [] };
        a.clicks += r.clicks || 0; a.impressions += r.impressions || 0;
        if (r.position) a.pos.push(Number(r.position));
        consultas.set(r.query, a);
      }
      $('bing-count').textContent = consultas.size + ' búsquedas';

      bingTotals = { clicks, impr };
      bingVerdict();

      const top = [...consultas.entries()].sort((a, b) => b[1].clicks - a[1].clicks || b[1].impressions - a[1].impressions).slice(0, 10);
      $('bing-top').innerHTML =
        '<table class="lead-table"><thead><tr><th>Búsqueda</th><th>Clicks</th><th>Impresiones</th><th>Posición</th></tr></thead><tbody>' +
        top.map(([q, a]) => '<tr><td>' + esc(q) + '</td><td>' + a.clicks + '</td><td>' + a.impressions + '</td><td>' +
          (a.pos.length ? (a.pos.reduce((t, x) => t + x, 0) / a.pos.length).toFixed(1) : '–') + '</td></tr>').join('') +
        '</tbody></table>';
    } catch (e) {
      box.hidden = false;
      $('bing-top').innerHTML = '<p class="muted-note">No pude leer los datos de Bing: ' + esc(e.message || String(e)) + '</p>';
    }
  }

