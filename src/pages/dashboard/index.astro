        const bodyPreview = (card.querySelector('.ob-html-editor') ? obHtmlToPreviewText(rawBody) : rawBody).slice(0, 220);
        const schedTxt = card.querySelector('.ob-sched-note');
        const schedLine = schedTxt ? '\n\n' + schedTxt.textContent : '';
        if (!confirm('¿Aprobar este email para ' + card.dataset.to + '?\n\nAsunto: ' + subj + '\n\n' + bodyPreview + (bodyPreview.length >= 220 ? '…' : '') + schedLine + '\n\nSale en 10 minutos — hasta entonces podés deshacerlo desde la Bandeja.')) return;
        const upd = { status: 'approved', sender: card.querySelector('.ob-sender').value, subject: subj, body: card.querySelector('.ob-body').value, scheduled_at: obUndoSched(b.dataset.id) };
        const { error: e2 } = await supabase.from('outbox').update(upd).eq('id', b.dataset.id);
        if (e2){ toast(e2.message); return; }
        toast('✅ Aprobado — 🕐 sale según lo programado (↩︎ Deshacer arriba en la Bandeja)');
      } else if (act === 'later'){
        const when = new Date(Date.now() + 4 * 3600e3).toISOString();
        const { error: e2 } = await supabase.from('outbox').update({ scheduled_at: when }).eq('id', b.dataset.id);
        if (e2){ toast('⚠️ ' + e2.message + ' (¿corriste la SQL 0063?)'); return; }
