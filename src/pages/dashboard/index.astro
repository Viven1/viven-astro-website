  $('dl-stuck') && $('dl-stuck').addEventListener('click', () => { dlStuck = !dlStuck; renderPipeline(); });
  function setDealsView(v){ dlView = v; localStorage.setItem('vv_deals_view', v); renderPipeline(); }
