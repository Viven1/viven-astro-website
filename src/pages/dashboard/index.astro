  // Deals: selección múltiple para borrar en batch (mismo patrón que Personas/psSelected)
  let dlSelected = new Set();
  function updateDlDelBtn(){
    const btn = $('dl-del-sel'); if (!btn) return;
    btn.hidden = dlSelected.size === 0;
    btn.textContent = '🗑 Borrar seleccionados (' + dlSelected.size + ')';
  }
  function bindDlSelection(){
    document.querySelectorAll('.dl-row-chk').forEach((cb) => cb.addEventListener('change', () => {
      if (cb.checked) dlSelected.add(cb.dataset.id); else dlSelected.delete(cb.dataset.id);
      updateDlDelBtn();
      const all = $('dl-chk-all'); if (all) all.checked = [...document.querySelectorAll('.dl-row-chk')].every((c) => c.checked);
    }));
    const allBox = $('dl-chk-all');
    if (allBox) allBox.addEventListener('change', () => {
      document.querySelectorAll('.dl-row-chk').forEach((cb) => { cb.checked = allBox.checked; if (allBox.checked) dlSelected.add(cb.dataset.id); else dlSelected.delete(cb.dataset.id); });
      updateDlDelBtn();
    });
    const delBtn = $('dl-del-sel');
    if (delBtn) delBtn.onclick = async () => {
      const ids = [...dlSelected]; if (!ids.length) return;
      if (!confirm('¿Borrar definitivamente ' + ids.length + ' deal' + (ids.length === 1 ? '' : 's') + '? Esta acción no se puede deshacer.')) return;
      const { error } = await supabase.from('deals').delete().in('id', ids);
      if (error) { toast('⚠️ ' + error.message); return; }
