---
import { readFileSync } from 'node:fs';
/* Dónde vive cada formulario de PDF. Se calcula en el BUILD leyendo las páginas, no
   a mano: si mañana el magnet se embebe en otra página, el denominador del panel de
   lead magnets se actualiza solo. Sin esto no hay "sesiones" para los PDF, porque el
   formulario no tiene una landing propia — está embebido en decenas de páginas. */
/* LA VERSIÓN, ESCRITA EN LA PANTALLA.
   Sebastián, 28 ago 2026: "escribí la versión en el dashboard así sabemos por cuál vamos".
   Lo pidió el mismo día en que descubrimos que producción venía sirviendo un build de
   hacía seis días mientras cada deploy decía "success": no había forma de mirar la
   pantalla y saber qué código estabas viendo, ni de comparar la suya con la de Sofía.
   Se lee del sw.js en tiempo de build —el mismo archivo que define la caché— así que no
   hay un segundo número que pueda quedar desfasado. */
const _sw = readFileSync('public/dashboard-sw.js', 'utf8');
const DASH_VER = 'v' + ((_sw.match(/viven-crm-v(\d+)/) || [])[1] || '?');
const DASH_VER_NOTA = ((_sw.match(/\/\/\s*v\d+:\s*(.+)/) || [])[1] || '').trim();

const _paginas = import.meta.glob('/src/pages/**/*.astro', { query: '?raw', import: 'default', eager: true });
const _magnetPaths = {};
for (const [archivo, fuente] of Object.entries(_paginas)) {
  const claves = [...String(fuente).matchAll(/magnet="([a-z0-9-]+)"/g)].map((m) => m[1]);
  if (!claves.length) continue;
  let ruta = archivo.replace('/src/pages', '').replace(/index\.astro$/, '').replace(/\.astro$/, '/');
  if (!ruta.endsWith('/')) ruta += '/';
  // las rutas [lang] se sirven una vez por idioma
  let rutas = ruta.includes('/[lang]/') ? ['en', 'de', 'es'].map((l) => ruta.replace('/[lang]/', '/' + l + '/')) : [ruta];
  /* Si todavía queda un [param] (ej. /en/resources/[slug]/) es una ruta dinámica: no se
     puede expandir a mano, así que se guarda como PREFIJO y se compara con startsWith.
     Sin esto quedaban rutas literales con corchetes que no coinciden con ninguna visita
     real — el contador daba 0 y encima decía "en 27 páginas". */
  rutas = rutas.map((r) => (r.includes('[') ? { pre: r.slice(0, r.indexOf('[')) } : r));
  for (const k of new Set(claves)) (_magnetPaths[k] = _magnetPaths[k] || new Set()), rutas.forEach((r) => _magnetPaths[k].add(r));
}
const MAGNET_PATHS = Object.fromEntries(Object.entries(_magnetPaths).map(([k, v]) => {
  const arr = [...v];
  return [k, {
    exactas: arr.filter((x) => typeof x === 'string').sort(),
    prefijos: [...new Set(arr.filter((x) => x && x.pre).map((x) => x.pre))].sort(),
  }];
}));
// pool de fotos reales (stills de rodajes) para elegir los separadores de una propuesta
import projects from '../../data/projects.json';
import videos from '../../data/videos.json';
const stillsPool = projects
  .filter((p) => p.lang === 'en' && Array.isArray(p.stills) && p.stills.length)
  .map((p) => ({ client: p.client || p.headline || 'Project', stills: p.stills }));

/* Catálogo de videos para el blog. Antes eran DIEZ escritos a mano acá abajo,
   y por eso el mismo video salía en 13 posts distintos (medido 14 ago 2026:
   33 posts con video, 6 videos diferentes). El catálogo real tiene 155 con
   thumbnail público — los mismos que ya usa la galería del sitio. */
const V_JUNK = (t) => !t || /VIVEN_|prores|_\d+$|\.mo?v|_16x9|multichannel|clean|nooutro/i.test(t);
const V_IMPORTANT = ['UBS', 'Siemens', 'Porsche', 'ON', 'FIFA', 'Philips', 'V-ZUG', 'SENSAI', 'Meteomatics', 'Franke', 'KPMG', 'SV Group', 'PMI Science', 'ANYbotics', 'Nile', 'ABB', 'Sonova', 'Büchi', 'Stadtspital', 'Carvolution', 'LEM', 'TomFit', 'Capgemini', 'Calda Clinic'];
const vRank = (c) => { const i = V_IMPORTANT.indexOf(c); return i === -1 ? 99 : i; };
const blogVideos = videos
  .filter((v) => v && v.id && v.thumb && (v.access ? v.access === 'public' : true))
  .map((v) => ({
    id: String(v.id),
    thumb: v.thumb,
    client: v.client || '',
    cat: v.cat || '',
    // el corte a 58 dejaba colgando un "|" o un guion del título original
    label: [v.client, V_JUNK(v.title) ? (v.category || 'Video') : v.title].filter(Boolean).join(' — ').slice(0, 58).replace(/[\s|–—-]+$/, ''),
  }))
  .sort((a, b) => vRank(a.client) - vRank(b.client) || a.label.localeCompare(b.label));

// catálogo de videos (Vimeo) para las tarjetas de video del newsletter
const newsVideos = videos
  .filter((v) => v && v.id && v.thumb && (v.access ? v.access === 'public' : true))
  .map((v) => ({ id: String(v.id), title: v.title || v.name || v.client || 'Video', thumb: v.thumb, client: v.client || '' }));

/* Las 12 preguntas del Project Brief, para poder llenarlo desde el dashboard.
   Se importan en el build y viajan como JSON en la página: son las MISMAS que ve el
   cliente en su portal, así que no hay dos versiones que se separen.
   (Sebastián, 26 ago 2026: "tengo que poder tenerlo dentro del panel y llenarlo ahí".) */
import { BRIEF, BRIEF_SECCIONES, BRIEF_T } from '../../data/project-brief-i18n.js';

// case studies para las cards de case study del newsletter (páginas ya publicadas)
const newsCases = [
  { slug: 'siemens', title: 'Siemens — Employer Branding', url: 'https://www.viven.ch/en/case-study-how-viven-helped-siemens-switzerland-amplify-their-employer-branding',
    thumb: '/projects/siemens-shaping-the-future-together-employer-branding-campaign/02-RORES_clean_VIVEN.00_13_13_20.Still042.jpg' },
  { slug: 'meteomatics', title: 'Meteomatics — Video Solutions', url: 'https://www.viven.ch/en/case-study-meteomatics-simplifying-complexity-with-viven-ags-video-solutions',
    thumb: '/projects/meteomatics-product-campaign-brand-video/02-Meteomatics_VIVEN_Video_Agentur_040.jpg' },
  { slug: 'sv-group', title: 'SV Group — IT & Hospitality', url: 'https://www.viven.ch/en/case-study-sv-group-bringing-it-operations-and-hospitality-together',
    thumb: '/projects/kanebo-sensai-skincare-how-to-video-campaign/01-re_How_To_Videos_Viven_Video_Agency_51.jpg' },
];
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>Viven — Dashboard</title>
<!-- Página privada: fuera de buscadores y del sitemap -->
<meta name="robots" content="noindex,nofollow" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#0f1826" />
<!-- App móvil: instalable desde Safari → Compartir → "Añadir a pantalla de inicio" -->
<link rel="manifest" href="/dashboard.webmanifest" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Viven CRM" />
<link rel="apple-touch-icon" href="/assets/crm-icon.png" />
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/sg-var.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/inter-var.woff2" crossorigin />
<link rel="stylesheet" href="/assets/site.css" />
<script is:inline>
  // aplicar el tema guardado ANTES del primer render (sin flash)
  try { var t = localStorage.getItem('viven_theme'); if (t === 'light') document.documentElement.dataset.theme = 'light'; } catch (e) {}
</script>
<style is:global>
  /* La página no tenía box-sizing en ningún lado. Con content-box, un campo con
     width:100% mide 100% MÁS el padding y el borde, así que se sale de su
     contenedor: 17 reglas del dashboard usan ese patrón (propuestas, ofertas,
     blog, bandeja, automatizaciones). En escritorio sobra lugar y no se nota;
     en el celular el editor de propuestas se salía ~26px de la pantalla y,
     como .dash-wrap es overflow-x:hidden, el texto quedaba cortado sin forma
     de alcanzarlo. (Capturas de Sebastián, 11 ago 2026.)
     Solo 4 controles tienen ancho fijo en px, y todos siguen entrando. */
  input,select,textarea{box-sizing:border-box}
  /* Tema del dashboard: dark = el navy de siempre (site.css). bright = gris claro
     estilo Claude Code, más descansado de día. Se alterna con el botón ◐ y persiste. */
  :root[data-theme="light"]{
    --navy-900:#faf9f5;   /* fondo (gris cálido claro) */
    --navy-800:#ffffff;   /* tarjetas / paneles */
    --navy-700:#f0efea;   /* elementos elevados */
    --navy-600:#e2e1db;   /* hover / bordes fuertes */
    --line:rgba(20,25,35,.09);
    --line-strong:rgba(20,25,35,.18);
    --text:#1f2430;
    --muted:#5b6472;
    --muted-2:#8a919e;
    --acid:#5f7a12;       /* verde marca oscurecido: legible sobre blanco */
    --acid-dim:#4e650f;
    /* Los mismos cinco que site.css define para el oscuro. Verde, rojo y ámbar van
       oscurecidos: los del tema oscuro sobre blanco no se leen. */
    --panel:#ffffff;
    --panel-2:#f0efea;
    --falso:#6d4fd6;      /* violeta oscurecido: sobre blanco el del tema oscuro no se lee */
    --won:#3f8a2b;
    --lost:#c0392b;
    --warn:#9a6b00;
  }
  :root[data-theme="light"] body{background:var(--navy-900);color:var(--text)}
  /* botones/pills con fondo acid: en claro usar el verde de marca real con texto oscuro */
  :root[data-theme="light"] .btn-primary,
  :root[data-theme="light"] .lead-form button[type="submit"],
  :root[data-theme="light"] .toolbar .fpill.active,
  :root[data-theme="light"] .vt-btn.active{background:#dff28b;border-color:#dff28b;color:#1c2508}
  /* 1220 px fijos dejaban ~350 px de aire a cada lado en un monitor normal, y el
     dashboard es sobre todo tablas y tableros — cosas que ganan con el ancho, no
     párrafos que se vuelven ilegibles. (Sebastián, 25 ago: "ninguna pantalla es
     fullscreen, todas tienen un espacio en los costados al pedo".)
     El tope alto es para que en un monitor ultra-ancho el pipeline no quede con
     columnas de dos metros; el 96vw hace el trabajo en todo lo demás. */
  .dash-wrap{max-width:min(1760px, 96vw);margin:0 auto;padding:32px 28px 80px}
  /* Los KPIs de analítica cargan en una segunda fase (loadAnalytics). Al cambiar
     el período, los números viejos se quedaban en pantalla unos segundos como si
     fueran los nuevos — Sebastián lo leyó como "no cambia". Ahora se ven en
     tránsito: atenuados, sin poder clickearse, y con un cartel que lo dice. */
  .kpis.vv-cargando{opacity:.42;pointer-events:none;transition:opacity .2s}
  .vv-cargando-aviso{display:none;align-items:center;gap:8px;font-size:12.5px;color:var(--muted);margin:-4px 0 12px}
  .kpis.vv-cargando + .vv-cargando-aviso{display:flex}
  .vv-cargando-aviso .pt{width:8px;height:8px;border-radius:50%;background:var(--acid);animation:vvLatido 1s ease-in-out infinite}
  @keyframes vvLatido{0%,100%{opacity:.25}50%{opacity:1}}
  .bell-wrap{position:relative}
  .bell-btn{position:relative;background:var(--navy-800);border:1px solid var(--line-strong);color:var(--text);width:38px;height:38px;border-radius:10px;font-size:17px;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1}
  .bell-btn:hover{border-color:var(--acid)}
  .bell-badge{position:absolute;top:-6px;right:-6px;min-width:18px;height:18px;padding:0 4px;border-radius:9px;background:#ff5a5a;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 2px var(--navy-900)}
  .bell-panel{position:absolute;top:46px;right:0;width:360px;max-width:calc(100vw - 32px);max-height:min(70vh,520px);overflow:auto;background:var(--navy-800);border:1px solid var(--line-strong);border-radius:14px;box-shadow:0 18px 50px rgba(0,0,0,.5);z-index:120}
  .bell-h{display:flex;justify-content:space-between;align-items:center;padding:13px 15px;border-bottom:1px solid var(--line);font-weight:700;font-size:14px;position:sticky;top:0;background:var(--navy-800)}
  .bell-x{background:transparent;border:0;color:var(--muted);cursor:pointer;font-size:14px}
  .bell-pushbtn{background:transparent;border:1px solid var(--line-strong);border-radius:100px;color:var(--acid);cursor:pointer;font-family:inherit;font-size:11px;font-weight:600;padding:4px 10px}
  .bell-pushbtn:hover{border-color:var(--acid)}
  .bell-grp{font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;color:var(--muted-2);padding:11px 15px 4px}
  .bell-grp.od{color:#ff8b5e}
  .bell-item{display:flex;flex-direction:column;gap:2px;width:100%;text-align:left;background:transparent;border:0;border-top:1px solid var(--line);padding:10px 15px;cursor:pointer;color:inherit;font:inherit}
  .bell-item:hover{background:color-mix(in srgb,var(--acid) 8%,transparent)}
  .bell-item .bi-t{font-size:13.5px;font-weight:600}
  .bell-item .bi-s{font-size:11.5px;color:var(--muted)}
  .bell-item .bi-due{font-size:11px;font-weight:600;color:var(--muted-2)}
  .bell-item .bi-at{font-size:10.5px;color:var(--muted-2);opacity:.8}
  .bell-item .bi-due.od{color:#ff5a5a}
  .bell-row{display:flex;align-items:stretch}
  .bell-row .bell-item{flex:1;min-width:0}
  .bell-dis{flex:none;background:none;border:0;color:var(--muted-2);cursor:pointer;font-size:11px;padding:0 12px;opacity:.5;transition:.15s}
  .bell-row:hover .bell-dis{opacity:1}
  .bell-dis:hover{color:#ff8b8b}
  .bell-empty{padding:26px 15px;text-align:center;color:var(--muted);font-size:13px}
  @media(max-width:560px){.bell-panel{position:fixed;top:60px;left:16px;right:16px;width:auto;max-width:none}}
  .dash-head{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:24px}
  /* Estaba EN LÍNEA en el div, y un estilo en línea le gana a toda media query: el
     `gap:7px` de la versión móvil no se aplicaba nunca. Acá sí. */
  .dash-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  /* marca clickable (misma gramática que .bk-logo/.bk-fp del booking: wordmark + label chico
     debajo) — pedido explícito: "pone mejor el logo y que eso nos lleve al home" */
  .dash-brand{display:flex;flex-direction:column;align-items:flex-start;gap:0;background:none;border:0;padding:0;cursor:pointer;font-family:inherit;text-align:left;border-radius:6px}
  .dash-brand .logo-mark{height:26px;width:auto;aspect-ratio:1374/288;color:var(--acid);display:block;transition:opacity .15s}
  .dash-brand .db-sub{font-size:9.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-2);margin-top:6px}
  .dash-brand:hover .logo-mark{opacity:.8}
  .dash-brand:focus-visible{outline:2px solid var(--acid);outline-offset:4px}
  .dash-sub{color:var(--muted-2);font-size:13px;margin-top:4px}
  .login-card{max-width:420px;margin:12vh auto 0;border:1px solid var(--line-strong);border-radius:20px;background:var(--navy-800);padding:40px}
  .login-card .logo-mark{height:32px;width:auto;aspect-ratio:1374/288;color:var(--acid);display:block}
  .login-card .lc-sub{font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-2);margin-top:8px;margin-bottom:18px}
  .login-card p{color:var(--muted);font-size:14px;margin-bottom:24px}
  /* Botón de Google: blanco, como lo pide la guía de marca de Google y como lo
     espera cualquiera que ya lo vio en otras apps. Es el único blanco del login
     a propósito — es el camino principal y se tiene que ver antes que el resto. */
  .lg-google{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;
    background:#fff;color:#1f1f1f;border:1px solid #dadce0;border-radius:100px;
    font:600 15px/1 Inter,sans-serif;padding:13px 18px;cursor:pointer;transition:.2s}
  .lg-google:hover{background:#f6f7f9;box-shadow:0 1px 6px rgba(0,0,0,.25)}
  .lg-google[disabled]{opacity:.6;cursor:default}
  /* separador con el texto en el medio: deja claro que abajo hay otra puerta, no otro paso */
  .lg-sep{display:flex;align-items:center;gap:12px;margin:22px 0 18px;color:var(--muted-2);font-size:12px}
  .lg-sep::before,.lg-sep::after{content:'';flex:1;height:1px;background:var(--line)}
  .login-card .lead-form{opacity:.85}

  /* tabs */
  .tabs{display:flex;gap:8px;margin-bottom:28px;border-bottom:1px solid var(--line);padding-bottom:0}
  .tab{background:none;border:0;border-bottom:2px solid transparent;color:var(--muted);font-family:'Space Grotesk';font-size:16px;font-weight:600;padding:12px 18px;cursor:pointer;transition:.25s;display:inline-flex;align-items:center;gap:8px}
  .tab:hover{color:var(--text)}
  .tab.active{color:var(--acid);border-bottom-color:var(--acid)}
  .tab .pill{background:rgba(221,249,143,.14);color:var(--acid);border-radius:100px;font-size:11.5px;padding:2px 9px;font-family:'Inter'}

  .kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:28px}
  .kpis.four{grid-template-columns:repeat(4,1fr)}
  .kpi{border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(180deg,var(--navy-700),var(--navy-800));padding:20px}
  .kpi .n{font-family:'Space Grotesk';font-weight:700;font-size:30px;color:var(--acid);line-height:1.1;white-space:nowrap}
  .kpi .n small{font-size:16px;color:var(--muted)}
  /* Un <small> de una palabra ("/mes") va pegado al número y está bien. Uno de varias
     ("≈ CHF 105/mes prorrateado") se leía como parte de la cifra: va abajo, chico. */
  .kpi .n small.bajo{display:block;font-size:12px;line-height:1.35;margin-top:3px;font-weight:400}
  .kpi .l{color:var(--muted);font-size:12.5px;margin-top:6px}

  .panel{border:1px solid var(--line);border-radius:var(--radius);background:var(--navy-800);padding:24px;margin-bottom:22px;overflow-x:auto}
  .panel h2{font-size:17px;margin-bottom:16px;display:flex;align-items:center;gap:10px}
  .panel h2 .count{font-size:12px;color:var(--muted-2);font-weight:500}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:22px}

  /* daily chart */
  .chart{display:flex;align-items:flex-end;gap:3px;height:120px;padding-top:8px}
  .chart .col{flex:1;display:flex;flex-direction:column;justify-content:flex-end;height:100%;position:relative;border-radius:4px 4px 0 0;background:rgba(255,255,255,.03)}
  .chart .col .fill{background:var(--acid);opacity:.85;border-radius:4px 4px 0 0;min-height:2px;transition:.3s}
  .chart .col:hover .fill{opacity:1}
  .chart .col .tip{display:none;position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);background:var(--navy-900);border:1px solid var(--line-strong);border-radius:8px;padding:5px 9px;font-size:11px;color:var(--text);white-space:nowrap;z-index:5}
  .chart .col:hover .tip{display:block}
  .chart-labels{display:flex;justify-content:space-between;color:var(--muted-2);font-size:11px;margin-top:8px}

  /* bar rows */
  .bars{display:grid;gap:9px}
  .bar-row{display:grid;grid-template-columns:minmax(90px,160px) 1fr 88px;align-items:center;gap:12px;font-size:13px}
  .bar-row .lbl{color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .bar-row .track{height:9px;border-radius:100px;background:rgba(255,255,255,.05);overflow:hidden}
  .bar-row .fill{height:100%;border-radius:100px;background:var(--acid);min-width:2px}
  .bar-row .val{text-align:right;color:var(--text);font-weight:600;font-size:12.5px;white-space:nowrap}
  .bar-row .val small{color:var(--muted-2);font-weight:400}

  /* chart with conversion dots */
  .chart .col .dot{position:absolute;left:50%;transform:translateX(-50%);width:7px;height:7px;border-radius:50%;background:#ff9ec9;box-shadow:0 0 0 2px var(--navy-800);z-index:3}
  .chart-legend{display:flex;gap:18px;margin-top:10px;font-size:11.5px;color:var(--muted-2)}
  .chart-legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px}
  .chart-legend .s{background:var(--acid)}
  .chart-legend .c{border-radius:50%;background:#ff9ec9}
  .chart-legend .p{background:#8ab4ff;opacity:.55}
  /* línea punteada del período anterior en el gráfico diario */
  .g-prev{fill:none;stroke:#8ab4ff;stroke-width:1.5;stroke-dasharray:5 4;opacity:.5}
  /* ▲▼ vs período anterior en los KPIs */
  .kdelta{font-size:11px;font-weight:700;margin-top:4px;min-height:13px}
  .kdelta.up{color:#7ed957}
  .kdelta.down{color:#ff8b8b}
  .kdelta.flat{color:var(--muted-2)}
  /* sub-tabs de Analytics: pills en UNA fila, scrolleables en móvil */
  .ana-modo{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
  .ana-modo .muted-note{font-size:12.5px}
  .ana-modo .btn.on{background:var(--acid);border-color:var(--acid);color:#16210a}
  .ana-seg{margin:0 0 18px;flex-wrap:nowrap;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
  .ana-seg::-webkit-scrollbar{display:none}
  .ana-seg button{flex:none;font-size:12px;padding:7px 14px}

  /* insight banner */
  .insights{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px}
  .insight{border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(180deg,var(--navy-700),var(--navy-800));padding:18px 20px}
  .insight .t{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-2);margin-bottom:8px;display:flex;align-items:center;gap:7px}
  .insight .v{font-family:'Space Grotesk';font-weight:700;font-size:19px;color:var(--text);line-height:1.25}
  .insight .v em{color:var(--acid);font-style:normal}
  .insight .d{color:var(--muted);font-size:12.5px;margin-top:6px}
  @media(max-width:980px){.insights{grid-template-columns:1fr}}

  /* performance table (canales / páginas que traen leads) */
  .perf{width:100%;border-collapse:collapse;font-size:13px;min-width:440px}
  .perf th{text-align:left;color:var(--muted-2);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;padding:7px 10px;border-bottom:1px solid var(--line-strong)}
  .perf th.num,.perf td.num{text-align:right}
  .perf td{padding:10px;border-bottom:1px solid var(--line);vertical-align:middle}
  .perf tr:last-child td{border-bottom:0}
  .perf .rate-cell{display:flex;align-items:center;gap:9px;justify-content:flex-end}
  .perf .rate-bar{width:56px;height:7px;border-radius:100px;background:rgba(255,255,255,.06);overflow:hidden;flex-shrink:0}
  .perf .rate-bar i{display:block;height:100%;background:var(--acid);border-radius:100px}
  .perf .rate-num{font-weight:700;color:var(--text);min-width:42px;text-align:right}
  .perf .lead-n{font-weight:700;color:var(--acid)}
  .perf .lead-n.zero{color:var(--muted-2);font-weight:400}

  /* tables */
  table.dt{width:100%;border-collapse:collapse;font-size:13.5px;min-width:820px}
  .dt th{text-align:left;color:var(--muted-2);font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:8px 12px;border-bottom:1px solid var(--line-strong)}
  .dt td{padding:11px 12px;border-bottom:1px solid var(--line);color:var(--text);vertical-align:top}
  .dt tr:hover td{background:rgba(255,255,255,.02)}
  .dt td .sub{color:var(--muted-2);font-size:12px;display:block;margin-top:2px}
  .dt .msg{max-width:260px;color:var(--muted);font-size:13px}
  .badge{display:inline-block;padding:3px 10px;border-radius:100px;font-size:11.5px;font-weight:600;background:rgba(255,255,255,.08);color:var(--muted)}
  .b-paid_search{background:rgba(66,133,244,.18);color:#8ab4f8}
  .b-paid_social{background:rgba(24,119,242,.18);color:#7ba9e8}
  .b-organic{background:rgba(52,168,83,.18);color:#81c995}
  .b-ai{background:rgba(221,249,143,.16);color:var(--acid)}
  .b-social{background:rgba(255,110,180,.16);color:#ff9ec9}
  .b-referral{background:rgba(255,190,90,.16);color:#ffd28a}
  .b-email{background:rgba(160,110,255,.18);color:#c4a7ff}
  .gclid-dot{color:var(--acid);font-weight:700;font-size:12.5px}
  select.status{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:8px;color:var(--text);font-family:inherit;font-size:12.5px;padding:6px 9px;cursor:pointer}

  /* toolbar */
  .toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px;align-items:center}
  .toolbar input[type="search"]{flex:1;min-width:180px;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:100px;padding:9px 18px;color:var(--text);font-family:inherit;font-size:13.5px}
  .toolbar input[type="search"]:focus{outline:none;border-color:var(--acid)}
  .toolbar .fpill{background:transparent;border:1px solid var(--line-strong);color:var(--muted);font-family:inherit;font-size:12.5px;font-weight:600;padding:8px 15px;border-radius:100px;cursor:pointer;transition:.25s}
  .toolbar .fpill:hover{border-color:var(--acid);color:var(--acid)}
  .toolbar .fpill.active{background:var(--acid);border-color:var(--acid);color:#142033}

  .muted-note{color:var(--muted-2);font-size:13px}
  .btn.small{padding:9px 18px;font-size:13px}
  .dt tbody tr{cursor:pointer}

  /* ---------- Lead detail modal ---------- */
  .lead-modal{position:fixed;inset:0;z-index:300;display:none;align-items:flex-start;justify-content:center;padding:5vh 20px;overflow-y:auto}
  .lead-modal.open{display:flex}
  .lead-modal .backdrop{position:fixed;inset:0;background:rgba(9,15,26,.86);backdrop-filter:blur(8px)}
  .lead-card{position:relative;z-index:2;width:min(760px,100%);background:var(--navy-800);border:1px solid var(--line-strong);border-radius:20px;padding:32px;animation:pop .35s var(--ease)}
  /* registro de contacto FULL SCREEN (como HubSpot): header/footer fijos,
     columnas laterales quietas — solo la del MEDIO scrollea */
  .lead-card-wide{width:100vw;height:100dvh;max-width:none;border-radius:0;border:0;margin:0;padding:16px 26px 12px;display:flex;flex-direction:column;overflow:hidden;animation:none}
  .lead-modal.open:has(.lead-card-wide){padding:0;overflow:hidden}
  /* header estilo HubSpot */
  .lm-top{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding-bottom:16px;border-bottom:1px solid var(--line);margin-bottom:18px}
  .lm-id{display:flex;align-items:center;gap:13px;min-width:0}
  .lm-avatar{width:46px;height:46px;border-radius:50%;background:color-mix(in srgb,var(--acid) 18%,var(--navy-900));color:var(--acid);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;flex:none}
  .lm-idtext h3{margin:0;font-size:19px}
  .lm-sub{font-size:13.5px;color:var(--muted);margin-top:2px}
  .lm-sub a{color:var(--acid)}
  .lm-quick{display:flex;gap:8px;flex-wrap:wrap}
  .lm-qbtn{display:inline-flex;align-items:center;gap:6px;background:var(--navy-900);border:1px solid var(--line-strong);color:var(--text);border-radius:9px;font-size:13px;padding:8px 13px;cursor:pointer;text-decoration:none}
  .lm-qbtn:hover{border-color:var(--muted)}
  /* grid 3 columnas */
  .lm-grid{display:grid;grid-template-columns:300px 1fr 320px;gap:20px;align-items:stretch;flex:1;min-height:0}
  .lm-left,.lm-right{min-width:0;overflow-y:auto;padding-right:4px;scrollbar-width:thin}
  .lm-center{min-width:0;display:flex;flex-direction:column;gap:18px;overflow-y:auto;padding:0 6px 24px;scrollbar-width:thin;border-left:1px solid var(--line);border-right:1px solid var(--line);padding-left:22px;padding-right:22px}
  .lm-top{flex:none}
  .lead-card-wide .lead-actions{flex:none;border-top:1px solid var(--line);padding-top:10px;margin-top:10px}
  .ab-sec{margin-bottom:14px}
  .ab-sec .ab-h{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted-2);font-weight:700;margin-bottom:7px}
  .ab-row{display:flex;justify-content:space-between;gap:10px;padding:4px 0;font-size:13px;line-height:1.4}
  .ab-row .ab-k{color:var(--muted);flex:none}
  .ab-row .ab-v{color:var(--text);text-align:right;word-break:break-word;min-width:0}
  .ab-row .ab-v a{color:var(--acid)}
  .ab-badge{border:1px solid;border-radius:999px;font-size:11px;font-weight:600;padding:2px 9px}
  .lm-stage-sel{background:var(--navy-800);border:1px solid;border-radius:999px;font-family:inherit;font-size:11.5px;font-weight:600;padding:3px 10px;cursor:pointer}
  .lm-stage-sel option{color:var(--text);background:var(--navy-800)}
  .lm-block{background:var(--navy-900);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
  .lm-block-h{font-size:13px;font-weight:700;color:var(--text);margin-bottom:10px}
  .lm-deal{display:flex;flex-direction:column;gap:5px;width:100%;text-align:left;background:var(--navy-800);border:1px solid var(--line);border-radius:10px;padding:10px 12px;cursor:pointer;color:var(--text)}
  .lm-deal:hover{border-color:var(--muted)}
  .lm-deal-wrap{display:flex;flex-direction:column;gap:4px;margin-bottom:8px}
  .lm-conv{align-self:flex-end;background:transparent;border:0;color:var(--acid);font:inherit;font-size:11.5px;font-weight:600;cursor:pointer;padding:1px 2px}
  .lm-conv:hover{text-decoration:underline}
  .lm-mk{display:flex;gap:8px;margin-top:10px}
  .lm-mk .btn{flex:1;justify-content:center}
  .lm-dealval{width:100%;margin-top:8px;background:transparent;border:1px dashed var(--line-strong);border-radius:9px;color:var(--muted);font:inherit;font-size:12px;font-weight:600;padding:8px;cursor:pointer}
  .lm-dealval:hover{border-color:var(--acid);color:var(--acid)}
  .lm-deal-t{font-size:13px;font-weight:600}
  .lm-deal-b{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .lm-deal-b b{font-family:'Space Grotesk'}
  .lm-score{border:1px solid;border-radius:999px;font-size:12px;font-weight:700;padding:2px 10px;white-space:nowrap;cursor:help}
  .lm-taskadd{margin-bottom:10px}
  .lm-taskadd input,.lm-taskadd select,.lm-block textarea,.ed-inp{width:100%;background:var(--navy-800);border:1px solid var(--line-strong);border-radius:9px;color:var(--text);font-family:inherit;font-size:13px;padding:8px 10px}
  .ed-hint{display:block;font-size:11px;color:var(--muted-2);margin-top:4px}
  .ed-hint b{color:var(--acid);font-weight:600}
  .lost-note{background:color-mix(in srgb,#ff6b6b 12%,transparent);border:1px solid color-mix(in srgb,#ff6b6b 40%,transparent);color:#ff8b8b;border-radius:10px;font-size:13px;padding:9px 13px;margin:10px 0 4px}
  .of-composer{position:fixed;inset:0;z-index:400;background:rgba(9,15,26,.8);backdrop-filter:blur(6px);display:flex;align-items:flex-start;justify-content:center;padding:6vh 16px;overflow-y:auto}
  .ofc-card{background:var(--navy-800);border:1px solid var(--line-strong);border-radius:16px;padding:22px 24px;max-width:560px;width:100%}
  .ofc-l{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted-2);font-weight:700;margin:12px 0 5px}
  .tpl-strip{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:14px;background:var(--navy-800);border:1px dashed var(--line-strong);border-radius:12px;padding:10px 14px}
  .tpl-strip .tpl-l{font-size:11.5px;font-weight:700;color:var(--muted-2);text-transform:uppercase;letter-spacing:.05em}
  .tpl-chip{display:inline-flex;align-items:center;background:var(--navy-700);border:1px solid var(--line);border-radius:100px;overflow:hidden}
  .tpl-chip .tpl-use{background:none;border:0;color:var(--text);font:inherit;font-size:12.5px;font-weight:600;padding:6px 6px 6px 13px;cursor:pointer}
  .tpl-chip .tpl-use:hover{color:var(--acid)}
  .tpl-chip .tpl-del{background:none;border:0;color:var(--muted-2);font-size:11px;padding:6px 10px 6px 4px;cursor:pointer}
  .tpl-chip .tpl-del:hover{color:#ff8b8b}
  .fu-row{border:1px solid var(--line);border-radius:11px;padding:11px 13px;margin-bottom:9px;background:var(--navy-800)}
  .fu-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:7px}
  .fu-top input[type="datetime-local"]{background:var(--navy-700);border:1px solid var(--line-strong);border-radius:8px;color:var(--text);font-family:inherit;font-size:12px;padding:5px 8px}
  .fu-subj{flex:1;min-width:160px;background:transparent;border:0;border-bottom:1px dashed var(--line-strong);color:var(--text);font-family:inherit;font-size:13.5px;font-weight:600;padding:3px 2px}
  .fu-st{font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;border:1px solid;border-radius:100px;padding:2px 9px;white-space:nowrap}
  .fu-body{width:100%;box-sizing:border-box;background:var(--navy-700);border:1px solid var(--line);border-radius:9px;color:var(--text);font-family:inherit;font-size:13px;line-height:1.55;padding:9px 11px;min-height:64px;resize:none;overflow:hidden}
  .fu-actions{display:flex;gap:7px;margin-top:8px;flex-wrap:wrap}
  .of-terms-box{margin-top:18px}
  .of-terms-box .pp-sec-h{margin-bottom:8px}
  .lm-taskadd-row{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap}
  .lm-taskadd-row input[type=date]{flex:1 1 108px;min-width:0}
  .lm-taskadd-row input[type=time]{flex:0 0 92px;min-width:0}
  .lm-taskadd-row select{flex:1 1 100%;min-width:0}
  .lm-task{display:flex;align-items:flex-start;gap:9px;padding:7px 0;border-bottom:1px solid var(--line);font-size:13px}
  .lm-task input[type=checkbox]{margin-top:2px;width:15px;height:15px;accent-color:var(--acid);flex:none}
  .lm-task.done .lm-task-txt>div:first-child{text-decoration:line-through;color:var(--muted-2)}
  .lm-task-txt{flex:1;min-width:0}
  .lm-task-meta{color:var(--muted-2);font-size:11.5px;margin-top:2px}
  .lm-x{background:none;border:0;color:var(--muted-2);cursor:pointer;font-size:13px;padding:0 4px}
  .lm-x:hover{color:#ff8b8b}
  .lm-block textarea{min-height:64px;resize:vertical;margin-bottom:8px}
  .lm-noteadd{display:flex;gap:6px;margin-bottom:10px}.lm-noteadd select{flex:1;min-width:0}
  .lm-note{border-bottom:1px solid var(--line);padding:8px 0;font-size:13px}
  .lm-note-b{color:var(--text);white-space:pre-wrap;line-height:1.45}
  /* Preguntas y respuestas en la ficha de empresa (brief y playbook). Clase propia: las
     notas usan white-space:pre-wrap y acá el contenido es HTML, no texto suelto. */
  .co3-qa{border:1px solid var(--line);border-radius:11px;padding:11px 13px;margin:0 0 8px}
  .co3-qa .tt{font-size:12px;font-weight:700;color:var(--acid);margin:0 0 8px}
  .co3-qa .qa{margin:0 0 9px}
  .co3-qa .qa:last-child{margin-bottom:0}
  .co3-qa .qa b{display:block;font-size:11px;color:var(--muted-2);font-weight:600;line-height:1.4;margin:0 0 2px}
  .co3-qa .qa span{font-size:13px;color:var(--text);line-height:1.5}
  .lm-note-m{color:var(--muted-2);font-size:11px;margin-top:4px;display:flex;flex-wrap:wrap;gap:2px;align-items:center}
  .lm-note .lm-reply{border-bottom:0;border-left:2px solid var(--line-strong);margin:6px 0 0 8px;padding:6px 0 2px 10px}
  .lm-reply-btn{background:transparent;border:0;color:var(--acid);cursor:pointer;font:inherit;font-size:11px;padding:0;font-weight:600}
  .lm-reply-btn:hover{text-decoration:underline}
  .lm-reply-box{margin-top:6px}
  .lm-reply-ta{width:100%;background:var(--navy-800);border:1px solid var(--line-strong);border-radius:9px;color:var(--text);font-family:inherit;font-size:13px;padding:8px 10px;min-height:52px;resize:vertical;margin-bottom:6px}
  .lm-email{border:1px solid var(--line);border-radius:11px;padding:10px 13px;margin-bottom:8px;cursor:pointer}
  .lm-email-in{border-color:var(--acid);background:color-mix(in srgb,var(--acid) 7%,transparent)}
  .lm-email-h{display:flex;align-items:baseline;justify-content:space-between;gap:8px;font-size:13px}
  .lm-email-subj{color:var(--text);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .lm-email-meta{color:var(--muted-2);font-size:11px;white-space:nowrap;flex:none}
  .lm-email-snip{color:var(--muted);font-size:12.5px;margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .lm-email-body{color:var(--text);font-size:13px;line-height:1.55;margin-top:8px;white-space:pre-wrap;border-top:1px solid var(--line);padding-top:8px;display:none}
  .lm-email.open .lm-email-body{display:block}
  .lm-email.open .lm-email-snip{display:none}
  .lm-center .lm-block .lead-msg{background:none;border:0;padding:0;margin:0;color:var(--text)}
  .lm-center .lm-block .draft-box{background:var(--navy-800);min-height:200px;margin-top:2px}
  .lm-center .lm-block .draft-head{margin-bottom:8px}
  @media(max-width:900px){
    .lm-grid{grid-template-columns:1fr;overflow-y:auto;display:flex;flex-direction:column}
    .lm-left,.lm-right,.lm-center{overflow:visible;border:0;padding-left:0;padding-right:0}
  }
  @keyframes pop{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  .lead-card .close{position:absolute;top:18px;right:18px;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.08);border:1px solid var(--line-strong);color:#fff;font-size:18px;cursor:pointer;display:grid;place-items:center;transition:.25s}
  .lead-card .close:hover{background:var(--acid);color:#142033}
  .lead-card h3{font-size:24px;margin-bottom:2px}
  .lead-card .email-line{color:var(--muted);font-size:14px;margin-bottom:22px}
  .lead-card .email-line a{color:var(--acid)}
  .detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px}
  .detail{background:var(--navy-900);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
  .detail .k{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted-2);margin-bottom:4px}
  .detail .v{font-size:13.5px;color:var(--text);word-break:break-all}
  .lead-msg{background:var(--navy-900);border:1px solid var(--line);border-radius:12px;padding:16px;color:var(--muted);font-size:14px;line-height:1.6;margin-bottom:24px;white-space:pre-wrap}
  .lm-journey{background:var(--navy-900);border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:24px}
  .lm-journey .jr-h{font-size:12.5px;font-weight:700;color:var(--text);margin:6px 0 8px;letter-spacing:.01em}
  .lm-journey .jr-h span{color:var(--muted-2);font-weight:400}
  .lm-journey .jr-list{list-style:none;margin:0 0 6px;padding:0;counter-reset:jr}
  .lm-journey ol.jr-list li{counter-increment:jr}
  .lm-journey ol.jr-list li::before{content:counter(jr);display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;border-radius:50%;background:var(--navy-800);color:var(--muted-2);font-size:10px;margin-right:8px;flex:none}
  .lm-journey .jr-list li{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);padding:3px 0}
  .lm-journey .jr-path{color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0}
  .lm-journey .jr-dur{color:var(--muted-2);font-size:12px;white-space:nowrap}
  .draft-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
  .draft-head h4{font-size:15px;display:flex;align-items:center;gap:8px}
  .draft-head h4 span{color:var(--acid)}
  .draft-box{width:100%;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:12px;padding:16px;color:var(--text);font-family:inherit;font-size:13.5px;line-height:1.6;min-height:230px;resize:vertical}
  .draft-box:focus{outline:none;border-color:var(--acid)}
  .lead-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;justify-content:space-between}
  .lead-actions .left{display:flex;gap:10px;flex-wrap:wrap}
  .btn-danger{background:transparent;border:1px solid rgba(255,120,120,.4);color:#ff9a9a}
  .btn-danger:hover{background:rgba(255,90,90,.12);border-color:#ff9a9a;transform:translateY(-2px)}
  @media(max-width:680px){.detail-grid{grid-template-columns:1fr 1fr}}
  [hidden]{display:none!important}
  @media(max-width:980px){.kpis,.kpis.four{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:1280px){.grid-2{grid-template-columns:1fr}}
  /* ---------- Pipeline kanban ---------- */
  .dl-menu-lbl{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted-2);font-weight:700;padding:8px 12px 4px}
  .dl-mv-dot{width:8px;height:8px;border-radius:2px;display:inline-block;margin-right:8px;vertical-align:0}
  .pipe-pager{display:none;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;background:var(--navy-800);border:1px solid var(--line);border-radius:12px;padding:6px 8px}
  .pipe-pager[hidden]{display:none!important}
  .pipe-pager button{width:42px;height:38px;border-radius:9px;border:1px solid var(--line-strong);background:transparent;color:var(--text);font-size:20px;line-height:1;cursor:pointer}
  .pipe-pager button:disabled{opacity:.3}
  .pipe-pager #pgr-label{font-family:'Space Grotesk';font-weight:600;font-size:13.5px;display:flex;align-items:center;gap:7px}
  .pipe-pager #pgr-label .dot{width:8px;height:8px;border-radius:2px;display:inline-block}
  .pipe-pager #pgr-label .n{color:var(--muted-2);font-weight:400}
  .mob-ver{text-align:center;color:var(--muted-2);font-size:10px;padding:8px 0 2px;letter-spacing:.04em}
  .pipe-bar{display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap}
  .pipe-bar input[type=search]{flex:1;min-width:220px;background:var(--navy-800);border:1px solid var(--line-strong);border-radius:10px;color:var(--text);font-family:inherit;font-size:14px;padding:10px 14px}
  .pipe-hint{color:var(--muted-2);font-size:12.5px}
  .pipeline{display:flex;gap:12px;overflow-x:auto;padding-bottom:12px;align-items:flex-start}
  .pipe-col{flex:0 0 256px;min-width:256px;display:flex;flex-direction:column;max-height:76vh;background:var(--navy-800);border:1px solid var(--line);border-radius:12px}
  .pipe-col-head{display:flex;align-items:center;gap:8px;padding:12px 14px 10px;border-bottom:1px solid var(--line)}
  .pipe-col-head .bar{width:8px;height:8px;border-radius:2px;flex:none}
  .pipe-col-head .st{font-family:'Space Grotesk';font-weight:600;font-size:13.5px}
  .pipe-col-head .cnt{color:var(--muted);font-weight:600;font-size:13px}
  .pipe-col-sums{display:flex;align-items:baseline;justify-content:space-between;gap:8px;padding:8px 14px 9px;border-bottom:1px solid var(--line)}
  .pipe-col-sums .tot{font-weight:700;font-family:'Space Grotesk';font-size:15px;letter-spacing:-.01em}
  .pipe-col-sums .wt{color:var(--muted-2);font-size:10.5px;white-space:nowrap}
  .pipe-col.drop{border-color:var(--acid);box-shadow:0 0 0 2px rgba(221,249,143,.2)}
  /* resumen por etapa: todo el pipeline de un vistazo, sin scrollear el board para
     sumar columna por columna (pedido explícito: "necesito entender los numeros
     mucho mas rapido y mejor") */
  .pipe-stage-sum{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
  .pss-card{position:relative;flex:1 1 150px;min-width:150px;background:var(--navy-800);border:1px solid var(--line);border-radius:12px;padding:12px 14px;overflow:hidden}
  .pss-card.pss-total{background:color-mix(in srgb,var(--acid) 7%,var(--navy-800));border-color:color-mix(in srgb,var(--acid) 30%,var(--line))}
  .pss-bar{position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--stage)}
  .pss-body{padding-left:6px}
  .pss-total .pss-l{padding-left:0}
  .pss-l{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px;font-weight:600}
  .pss-n{color:var(--muted-2);font-weight:600;font-size:11.5px}
  .pss-v{font-family:'Space Grotesk';font-weight:700;font-size:18px;letter-spacing:-.01em;margin-top:3px}
  .pss-w{color:var(--muted-2);font-size:10.5px;margin-top:2px}
  @media(max-width:640px){.pss-card{flex:1 1 calc(50% - 5px)}}
  /* toggle de vista */
  .view-toggle{display:inline-flex;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:10px;padding:2px;gap:2px}
  .vt-btn{background:none;border:0;color:var(--muted);font-family:inherit;font-size:12.5px;font-weight:600;padding:6px 12px;border-radius:8px;cursor:pointer}
  .vt-btn.active{background:var(--acid);color:#10210a}
  /* vista lista */
  .lead-table{width:100%;border-collapse:collapse;font-size:14px}
  .lead-table th{text-align:left;color:var(--muted-2);font-size:11.5px;text-transform:uppercase;letter-spacing:.05em;font-weight:600;padding:10px 12px;border-bottom:1px solid var(--line)}
  .lead-table th.lt-sort{cursor:pointer;user-select:none;white-space:nowrap}
  .lead-table th.lt-sort:hover{color:var(--text)}
  .lead-table th.lt-sort.on{color:var(--acid)}
  .lead-table td{padding:12px;border-bottom:1px solid var(--line);color:var(--text)}
  .lead-table tr{cursor:pointer}
  .lead-table tbody tr:hover{background:var(--navy-800)}
  .lead-table .lt-name{font-weight:600}
  .lead-table .lt-mail{color:var(--muted);font-size:12.5px}
  .lead-table .lt-stage{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600}
  .lead-table .lt-stage .dot{width:8px;height:8px;border-radius:50%}
  /* medidor de fuerza de contraseña (Sistema → Usuarios) */
  .usr-meter{height:6px;border-radius:99px;background:rgba(255,255,255,.10);margin-top:8px;overflow:hidden}
  .usr-meter i{display:block;height:100%;width:0;border-radius:99px;transition:width .2s,background .2s}
  .lead-table .lt-val{font-family:'Space Grotesk';font-weight:700;white-space:nowrap}
  .lead-table .lt-act{color:var(--muted);font-size:12.5px;white-space:nowrap}
  .lead-table .lt-num{text-align:right;white-space:nowrap;color:var(--muted)}
  .lead-table .lt-chk{width:1%;white-space:nowrap;padding:12px 6px 12px 14px}
  .lead-table .lt-chk input{width:16px;height:16px;accent-color:var(--acid);cursor:pointer}
  /* Empresas rediseñadas: segment control sobre la tabla + detalle en 3 zonas (misma gramática que la Ficha V2) */
  .co-seg{display:flex;gap:6px;flex-wrap:wrap}
  .co-seg button{background:transparent;border:1px solid var(--line-strong);border-radius:100px;color:var(--muted);font:600 11px Inter,sans-serif;padding:6px 11px;cursor:pointer;white-space:nowrap}
  .co-seg button.on{border-color:var(--acid);color:var(--acid);background:rgba(221,249,143,.08)}
  .co2-tav{width:28px;height:28px;border-radius:8px;color:#0f1826;display:grid;place-items:center;font-weight:800;font-size:11px;font-family:'Space Grotesk';flex:none}
  .co2-hd{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 16px;border:1px solid var(--line);border-bottom:0;border-radius:14px 14px 0 0;background:var(--navy-800)}
  /* detalle de empresa: el CENTRO (KPIs + actividad) manda — rails angostos para su contenido */
  .co2-grid{display:grid;grid-template-columns:200px minmax(0,1fr) 260px;border:1px solid var(--line);border-radius:0 0 14px 14px;overflow:hidden;background:var(--navy-800)}
  .co2-l{border-right:1px solid var(--line);padding:14px}
  .co2-c{padding:16px 20px;background:rgba(0,0,0,.12);min-width:0}
  .co2-r{border-left:1px solid var(--line);padding:14px}
  /* el detalle necesita todo el ancho: solo cuando está abierto, el wrap crece (los demás tabs no cambian) */
  /* la ficha de empresa ya no necesita su excepción: el ancho general la cubre */
  /* KPIs del centro más densos: números chicos, menos padding → la timeline gana alto */
  #co-kpis{gap:10px;margin-bottom:14px}
  #co-kpis .kpi{padding:8px 12px}
  #co-kpis .kpi .n{font-size:15px}
  #co-kpis .kpi .l{margin-top:2px;font-size:11px}
  /* rail izquierdo compacto: los campos vacíos (—) no se comen una fila alta cada uno */
  .co2-l .lm2-kv{gap:6px;font-size:12px}
  .co2-l .lm2-kv .k{font-size:9.5px}
  /* fold de la ficha: en desktop el summary no existe (siempre abierta) */
  .co2-lfold>summary{display:none}
  @media(max-width:1199px){
    /* tablet ancha: la ficha se pliega arriba a lo ancho y el centro + rail derecho se reparten el resto */
    .co2-grid{grid-template-columns:minmax(0,1fr) 260px}
    .co2-l{grid-column:1/-1;border-right:0;border-bottom:1px solid var(--line);padding:10px 16px}
    .co2-lfold>summary{display:block}
  }
  @media(max-width:960px){
    .co2-grid{display:flex;flex-direction:column}
    .co2-l{order:2;border-right:0;border-bottom:0;border-top:1px solid var(--line)}
    .co2-c{order:1}
    .co2-r{order:3;border-left:0;border-top:1px solid var(--line)}
  }
  .lead-table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px}
  .pipe-list{display:flex;flex-direction:column;gap:9px;overflow-y:auto;min-height:50px;padding:11px}
  .pipe-card{background:var(--navy-700);border:1px solid var(--line);border-left:3px solid var(--stage,#8ab4ff);border-radius:8px;padding:11px 12px;cursor:grab;transition:transform .12s,border-color .2s,box-shadow .2s}
  .pipe-card:hover{border-color:var(--line-strong);box-shadow:0 6px 18px -10px rgba(0,0,0,.6);transform:translateY(-1px)}
  .pipe-card.dragging{opacity:.4;cursor:grabbing}
  .pipe-card .pc-name{font-family:'Space Grotesk';font-weight:600;font-size:13.5px;color:var(--acid);margin-bottom:8px;line-height:1.3}
  .pipe-card .pc-field{font-size:12px;color:var(--muted);margin-top:3px;display:flex;gap:5px;align-items:center}
  .pipe-card .pc-field .k{color:var(--muted-2);flex:none}
  .pipe-card .pc-field .v{color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:flex;align-items:center;gap:6px;min-width:0}
  .pipe-card .pc-field .v.amt{font-weight:700;font-family:'Space Grotesk'}
  .pipe-card .pc-act{font-size:11px;color:var(--muted-2);margin-top:6px}
  .pipe-card .pc-lost{font-size:12px;color:#ff8b8b;margin-top:6px;font-style:italic}
  .pipe-card .pc-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:10px;padding-top:9px;border-top:1px solid var(--line)}
  .pc-tags{display:flex;gap:5px;align-items:center;flex-wrap:wrap;min-width:0}
  .pc-badge{font-size:10px;letter-spacing:.02em;text-transform:uppercase;font-weight:700;color:var(--muted);background:rgba(255,255,255,.06);border-radius:100px;padding:2px 7px}
  .lt-score{border:1px solid;border-radius:100px;font-size:11.5px;font-weight:800;padding:2px 9px;white-space:nowrap;cursor:help}
  .pc-score{border:1px solid;border-radius:100px;font-size:10px;font-weight:800;padding:1px 7px;cursor:help}
  .pc-ads{font-size:10px;font-weight:800;color:#0f1826;background:#8ab4ff;border-radius:100px;padding:2px 7px}
  .pc-ost{font-size:10px;font-weight:800;letter-spacing:.02em}
  .pc-co{width:22px;height:22px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;color:#0f1826;flex:none}
  .deals-analytics{margin-top:22px;border-top:1px solid var(--line);padding-top:6px}
  .deals-analytics>summary{cursor:pointer;list-style:none;font-family:'Space Grotesk';font-weight:600;font-size:15px;padding:10px 2px;display:flex;align-items:center;gap:8px}
  .deals-analytics>summary::-webkit-details-marker{display:none}
  .deals-analytics>summary::before{content:'▸';color:var(--muted);transition:transform .15s}
  .deals-analytics[open]>summary::before{transform:rotate(90deg)}
  .deals-analytics>summary span{color:var(--muted-2);font-weight:400;font-size:12.5px}
  .pipe-empty{color:var(--muted-2);font-size:12px;text-align:center;padding:16px 6px;border:1px dashed var(--line);border-radius:10px;margin-top:10px}
  /* ---- Deals V2: toolbar propia, semáforo de días, chip de documento, drop-zones y vista Lista ---- */
  .dl-chip{background:transparent;border:1px solid var(--line-strong);color:var(--muted);font-family:inherit;font-size:12.5px;font-weight:600;padding:9px 15px;border-radius:100px;cursor:pointer;transition:.2s;white-space:nowrap}
  .dl-chip:hover{border-color:var(--acid);color:var(--acid)}
  .dl-chip.active{background:var(--acid);border-color:var(--acid);color:#142033}
  .dl-views{display:flex;border:1px solid var(--line-strong);border-radius:10px;overflow:hidden;flex:none}
  .dl-views button{background:transparent;border:0;color:var(--muted);font-family:inherit;font-size:12.5px;font-weight:600;padding:9px 14px;cursor:pointer}
  .dl-views button.on{background:var(--acid);color:#142033}
  .pc-head{display:flex;align-items:flex-start;justify-content:space-between;gap:6px}
  .pc-head .pc-name{margin-bottom:0;flex:1;min-width:0}
  .pc-dots{background:transparent;border:1px solid var(--line-strong);border-radius:7px;color:var(--muted);font-size:14px;line-height:1;padding:2px 7px;cursor:pointer;flex:none}
  .pc-dots:hover{color:var(--text);border-color:var(--acid)}
  .pc-sub{font-size:11.5px;color:var(--muted);margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pc-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:8px}
  .pc-amt{font-weight:700;font-family:'Space Grotesk';font-size:13.5px}
  .pc-next{font-size:11.5px;color:var(--muted);margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pc-next.warn{color:#f0c060}
  .pc-doc{display:inline-block;font-size:11px;font-weight:600;border:1px solid var(--line-strong);border-radius:999px;padding:3px 9px;margin-top:7px;color:var(--muted);max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pc-doc.ok{color:#7ed957;border-color:rgba(126,217,87,.5)}
  .pc-doc.hot{color:var(--acid);border-color:rgba(221,249,143,.55)}
  .pc-doc.warn{color:#f0c060;border-color:rgba(240,192,96,.5)}
  /* borde de alerta según los días en etapa (ámbar 7-14d, rojo >14d) */
  .pipe-card.pc-mid{border-color:rgba(240,192,96,.5)}
  .pipe-card.pc-bad{border-color:rgba(255,107,107,.55)}
  .pipeline[hidden]{display:none!important}   /* la vista Lista lo esconde; sin esto el display:flex le gana al hidden */
  .pipe-drops{display:flex;gap:10px;margin-top:4px;flex-wrap:wrap}
  .pipe-drops[hidden]{display:none!important}
  .pipe-drop{flex:1;min-width:230px;border:2px dashed;border-radius:12px;padding:13px 16px;text-align:center;cursor:pointer;font-family:'Space Grotesk';font-weight:600;font-size:13.5px;transition:.2s;background:transparent}
  .pipe-drop .pd-sum{display:block;font-family:'Inter',sans-serif;font-weight:400;font-size:11.5px;color:var(--muted);margin-top:3px}
  .pipe-drop.win{border-color:rgba(126,217,87,.45);color:#7ed957}
  .pipe-drop.lose{border-color:rgba(255,107,107,.45);color:#ff8b8b}
  .pipe-drop.snooze{border-color:rgba(94,199,209,.45);color:#5ec7d1}
  .pipe-drop.win.drop{background:rgba(126,217,87,.1);border-color:#7ed957}
  .pipe-drop.lose.drop{background:rgba(255,107,107,.1);border-color:#ff6b6b}
  .pipe-drop.snooze.drop{background:rgba(94,199,209,.1);border-color:#5ec7d1}
  .dl-lbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:12px}
  .dl-lbar select{margin-left:auto}

  /* ---------- Insights con IA ---------- */
  .ai-panel{background:linear-gradient(135deg,rgba(221,249,143,.06),var(--navy-800))}
  .ai-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap}
  .ai-head h2{margin:0}
  .ai-insight{display:flex;gap:12px;padding:14px 0;border-top:1px solid var(--line)}
  .ai-insight:first-child{border-top:0}
  .ai-insight .ico{font-size:20px;flex:none;line-height:1.3}
  .ai-insight .txt h4{font-size:15px;margin:0 0 3px;color:var(--text);font-family:'Space Grotesk'}
  .ai-insight .txt p{font-size:13.5px;color:var(--muted);margin:0;line-height:1.5}
  .ai-loading{color:var(--muted);font-size:14px;padding:10px 0}

  /* ---------- Gráfico SVG (real) ---------- */
  #daily-chart{height:auto!important;display:block;padding-top:4px}
  .gsvg{width:100%;height:auto;display:block;overflow:visible}
  .g-grid{stroke:rgba(255,255,255,.07);stroke-width:1}
  .g-yl{fill:var(--muted-2);font-size:11px;text-anchor:end;font-family:'Inter'}
  .g-xl{fill:var(--muted-2);font-size:11px;font-family:'Inter'}
  .g-line{fill:none;stroke:var(--acid);stroke-width:2.5;stroke-linejoin:round;stroke-linecap:round}
  .g-lead{fill:#ff9ec9;stroke:var(--navy-800);stroke-width:2;transition:.2s}
  .gsvg circle:hover{opacity:.8}
  .chart-labels{display:none}

  /* ===== Funnel ===== */
  .funnel{display:grid;gap:10px;margin-top:6px}
  .fn-row{display:grid;grid-template-columns:110px 1fr 120px;align-items:center;gap:14px}
  .fn-label{font-size:13.5px;color:var(--text);font-weight:600}
  .fn-bar-wrap{background:var(--navy-900);border-radius:8px;overflow:hidden}
  .fn-bar{height:34px;border-radius:8px;display:flex;align-items:center;justify-content:flex-end;padding:0 12px;min-width:34px;transition:width .4s ease}
  .fn-n{font-weight:700;color:#10210a;font-size:14px}
  .fn-meta{text-align:right;font-size:12.5px;color:var(--muted)}
  .fn-meta b{display:block;color:var(--text);font-size:15px}
  .fn-meta span{font-size:11.5px;color:var(--muted-2)}
  /* la segunda línea del meta: el % del paso previo, secundario al % sobre la base */
  .fn-meta .fn-prev{display:block;margin-top:2px;font-size:11px;opacity:.75}
  .fn-meta .fn-skip{color:#f0c060;opacity:.95}
  .fn-foot{margin-top:14px;padding-top:12px;border-top:1px solid var(--line);font-size:13px;color:var(--muted)}
  .fn-foot b{color:var(--text)}
  .fn-hint{color:var(--muted-2);font-size:11.5px}
  @media(max-width:640px){.fn-row{grid-template-columns:80px 1fr 84px;gap:8px}}

  /* ===== Offer tool ===== */
  .of-bar{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
  .of-list{display:grid;gap:10px;margin-top:16px}
  .of-card{background:var(--navy-800);border:1px solid var(--line);border-radius:14px;color:var(--text);transition:border-color .15s;font-family:inherit;overflow:hidden}
  .of-card:hover{border-color:var(--muted)}
  .of-card.arch{opacity:.6}
  .of-card-open{display:flex;align-items:center;gap:16px;width:100%;text-align:left;padding:15px 18px;cursor:pointer}
  .of-actions{display:flex;gap:8px;padding:0 12px 12px;flex-wrap:wrap}
  .of-act{background:var(--navy-900);border:1px solid var(--line-strong);color:var(--muted);border-radius:9px;font-size:12.5px;padding:6px 11px;cursor:pointer;font-family:inherit;transition:border-color .15s,color .15s}
  .of-act:hover{border-color:var(--muted);color:var(--text)}
  .of-act.danger:hover{border-color:#ff6b6b;color:#ff8b8b}
  /* "Más métricas": summary plegable con look de link muted (reemplaza a las 6 tarjetas KPI secundarias) */
  .of-more-sum{color:var(--muted);font-size:13px;cursor:pointer;list-style:none;padding:6px 0;user-select:none;width:max-content}
  .of-more-sum:hover{color:var(--text)}
  .of-more-sum::-webkit-details-marker{display:none}
  .btn:disabled{opacity:.45;cursor:not-allowed}
  .of-arch-list{display:flex;flex-direction:column;gap:10px;margin-top:8px}
  /* ---- 📤 Bandeja de salida (outbox) ---- */
  #ob-list{display:flex;flex-direction:column;gap:14px}
  #ob-list .au-step{background:var(--navy-800);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
  #ob-list .ob-hd{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
  #ob-list .ob-who{display:flex;gap:10px;align-items:center}
  #ob-list .ob-kind{font-size:11px;font-weight:700;letter-spacing:.3px;color:var(--acid);background:color-mix(in srgb,var(--acid) 14%,transparent);border:1px solid color-mix(in srgb,var(--acid) 40%,transparent);border-radius:20px;padding:3px 11px;flex:none}
  #ob-list .ob-sched-note{font-size:12px;color:var(--muted);margin-bottom:10px}
  #ob-list .ob-f{margin-bottom:10px}
  #ob-list .ob-f label{display:block;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:5px}
  #ob-list .ob-f input,#ob-list .ob-f select,#ob-list .ob-f textarea{width:100%;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:11px;color:var(--text);font-family:inherit;font-size:14px;padding:10px 12px}
  #ob-list .ob-f select{cursor:pointer;max-width:220px}
  #ob-list .ob-body{min-height:130px;line-height:1.55;resize:vertical}
  #ob-list .ob-row{display:flex;gap:14px;flex-wrap:wrap}
  #ob-list .ob-preview-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px}
  #ob-list .ob-preview-bar label{margin:0}
  #ob-list .ob-html-toggle{background:none;border:1px solid var(--line-strong);border-radius:8px;color:var(--muted);cursor:pointer;font-size:11.5px;padding:3px 10px}
  #ob-list .ob-html-toggle:hover{color:var(--acid);border-color:var(--acid)}
  #ob-list .ob-preview-frame{width:100%;height:360px;border:1px solid var(--line-strong);border-radius:11px;background:#fff}
  #ob-list .ob-row .ob-f{flex:1;min-width:180px}
  /* ---- editor de propuestas ---- */
  #pp-editor .bf,#contenido-sub-blog .bf,#sistema-sub-services .bf,#sistema-sub-usuarios .bf{margin-bottom:14px}
  #pp-editor .bf label,#contenido-sub-blog .bf label,#sistema-sub-services .bf label,#sistema-sub-licenses .bf label,#sistema-sub-cashflow .bf label,#sistema-sub-usuarios .bf label{display:block;font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:6px}
  #pp-editor .bf input,#pp-editor .bf select,#pp-editor .bf textarea,#contenido-sub-blog .bf input,#contenido-sub-blog .bf select,#contenido-sub-blog .bf textarea,#sistema-sub-licenses .bf input,#sistema-sub-licenses .bf select,#sistema-sub-licenses .bf textarea,#sistema-sub-cashflow .bf input,#sistema-sub-cashflow .bf select,#sistema-sub-cashflow .bf textarea,#sistema-sub-usuarios .bf input,#sistema-sub-usuarios .bf select{width:100%;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:11px;color:var(--text);font-family:inherit;font-size:14.5px;padding:11px 13px}
  /* ---------- Cash Flow (SQL 0077/0078/0079) ---------- */
  .cf-tag{display:inline-block;padding:2px 9px;border-radius:100px;font-size:11px;font-weight:600;white-space:nowrap}
  .cf-tag.rec{color:var(--acid);background:rgba(221,249,143,.12)}
  .cf-tag.loan{color:#8fb8ff;background:rgba(143,184,255,.12)}
  .cf-tag.bexio{color:#7ed957;background:rgba(126,217,87,.12)}
  .cf-tag.manual{color:var(--muted);background:rgba(255,255,255,.06)}
  .cf-amt{font-weight:700;white-space:nowrap}
  .cf-amt.pos{color:#7ed957}
  .cf-amt.neg{color:#ff8b8b}
  .cf-loan-bar{background:var(--navy-900);border-radius:8px;height:6px;overflow:hidden;margin:8px 0 6px}
  .cf-loan-bar i{display:block;height:100%;background:var(--acid);border-radius:8px}
  #sistema-sub-cashflow .of-card-sub{margin-top:4px}
  .lic-days{font-size:11px;font-weight:700;letter-spacing:.3px;padding:3px 10px;border-radius:20px;flex:none}
  .lic-days.ok{color:#7ed957;border:1px solid #7ed957}
  .lic-days.soon{color:#f0c060;border:1px solid #f0c060}
  .lic-days.due{color:#ff8b8b;border:1px solid #ff8b8b}
  .lic-days.past{color:var(--muted-2);border:1px solid var(--line-strong)}
  .of-act.lic-pri{background:var(--acid);border-color:var(--acid);color:var(--navy-900);font-weight:700}
  .of-act.lic-pri:hover{border-color:var(--acid);color:var(--navy-900)}
  :root[data-theme="light"] .of-act.lic-pri{background:#dff28b;border-color:#dff28b;color:#1c2508}
  .lic-renew{display:flex;gap:8px;align-items:center;padding:0 12px 12px;flex-wrap:wrap}
  .lic-renew input[type=date]{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:9px;color:var(--text);font-family:inherit;font-size:13px;padding:7px 10px}
  .pp-grid{display:grid;grid-template-columns:var(--cols,repeat(4,1fr));gap:14px;margin:18px 0 8px;align-items:end}
  .pp-grid .bf{margin-bottom:0}
  .pp-grid3{display:grid;grid-template-columns:2fr 1fr;gap:18px;margin-bottom:6px;align-items:start}
  .pp-grid3 > div .bf:last-child{margin-bottom:0}
  .pp-ta{width:100%;min-height:80px;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:11px;color:var(--text);font-family:inherit;font-size:14.5px;padding:11px 13px;resize:vertical}
  /* flex-wrap: son 13 encabezados de sección y varios llevan dos botones al lado del
     título. Sin envolver, en el teléfono el último se va fuera de la pantalla y no hay
     scroll que lo alcance —«+ Añadir» de los videos terminaba en 408px sobre 375—.
     El row-gap evita que al bajar de renglón quede pegado al título. */
  .pp-sec-h{display:flex;align-items:center;flex-wrap:wrap;gap:12px;row-gap:8px;font-weight:700;font-size:14px;margin:22px 0 10px;color:var(--text)}
  .pp-sec-h .count{font-weight:400;color:var(--muted-2);font-size:12.5px}
  .btn.xs{font-size:12px;padding:4px 10px}
  .pp-status-badge{border:1px solid var(--line-strong);border-radius:999px;font-size:12px;font-weight:600;padding:4px 12px;color:var(--muted)}
  .pp-status-badge.sent{color:#f0c060;border-color:#f0c060}
  .pp-status-badge.accepted{color:#7ed957;border-color:#7ed957}
  /* Propuestas V2 (lista): semáforo de espera + señal de interés en la tabla */
  .pp2-sem{display:inline-flex;align-items:center;border:1px solid;border-radius:999px;font-size:11.5px;font-weight:600;padding:3px 10px;white-space:nowrap}
  .pp2-sem.ok{color:#7ed957;border-color:rgba(126,217,87,.5)}
  .pp2-sem.mid{color:#f0c060;border-color:rgba(240,192,96,.5)}
  .pp2-sem.bad{color:#ff8b8b;border-color:rgba(255,107,107,.55)}
  .pp2-eye{font-size:12px;color:var(--muted);white-space:nowrap}
  .pp2-eye.hot{color:var(--acid);font-weight:700}
  .pp2-eye.warn{color:#f0c060}
  .bx-pcts{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 4px}
  .bx-pcts button{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:11px;color:var(--text);
    font:600 14px/1 inherit;padding:11px 16px;cursor:pointer;font-variant-numeric:tabular-nums}
  .bx-pcts button.on{background:var(--acid);border-color:var(--acid);color:#16210a}
  .bx-iva{display:inline-flex;gap:0;border:1px solid var(--line-strong);border-radius:999px;overflow:hidden;margin-left:8px;vertical-align:-4px}
  .bx-iva button{background:none;border:0;color:var(--muted);font:600 12px/1 inherit;padding:6px 11px;cursor:pointer}
  .bx-iva button.on{background:var(--acid);color:#16210a}
  .bx-iva button:disabled{opacity:.4;cursor:not-allowed}
  .bx-cand{display:flex;gap:10px;align-items:center;border:1px solid var(--line);border-radius:11px;
    padding:9px 12px;margin-top:7px;cursor:pointer;background:var(--navy-900)}
  .bx-cand.on{border-color:var(--acid);background:color-mix(in srgb,var(--acid) 10%,transparent)}
  .bx-cand b{font-size:13.5px}
  .bx-cand small{color:var(--muted-2);font-size:12px;display:block}
  .lm2-rescatar{margin-left:auto;background:transparent;border:1px dashed var(--line-strong);border-radius:999px;
    color:var(--muted-2);font:600 11.5px/1 inherit;padding:6px 12px;cursor:pointer}
  .lm2-rescatar:hover{border-color:var(--acid);color:var(--acid)}
  .lm2-rescatar:disabled{opacity:.5;cursor:default}
  .pp2-dots{background:transparent;border:1px solid var(--line-strong);border-radius:8px;color:var(--muted);font-size:15px;line-height:1;padding:4px 9px;cursor:pointer}
  .pp2-dots:hover{color:var(--text);border-color:var(--acid)}
  #pp-list table{min-width:920px} /* móvil = scroll horizontal dentro del wrap, sin colapsar columnas */
  .pp-linkbox{display:flex;align-items:center;gap:20px;flex-wrap:wrap;background:color-mix(in srgb,var(--acid) 8%,var(--navy-800));border:1px solid color-mix(in srgb,var(--acid) 40%,var(--line));border-radius:12px;padding:14px 18px;margin:8px 0 18px}
  .pp-linkbox .k{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted-2);margin-bottom:3px}
  .pp-linkbox a{color:var(--acid);word-break:break-all;font-size:14px}
  .pp-linkbox code{color:var(--text);font-size:14px;background:var(--navy-900);padding:2px 8px;border-radius:6px}
  .pp-row{background:var(--navy-800);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:10px}
  .pp-row .rowtop{display:flex;gap:10px;align-items:center;margin-bottom:8px}
  .pp-row input,.pp-row textarea,.pp-row select{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:9px;color:var(--text);font-family:inherit;font-size:14px;padding:9px 11px}
  /* red de seguridad: ningún select/input suelto (sin .grow ni width:100%) puede forzar
     la fila -y de arrastre la página entera- más ancha que la pantalla en celular */
  #pp-editor select,#pp-editor input{max-width:100%}
  /* bündig: el texto ocupa TODO el ancho y crece con el contenido — nunca scroll interno */
  .pp-row textarea,#pp-editor textarea{width:100%;min-height:54px;resize:none;overflow:hidden;line-height:1.55;display:block;margin-top:8px}
  .pp-row .grow{flex:1;min-width:0}
  .pp-row .rm{background:none;border:0;color:var(--muted-2);cursor:pointer;font-size:16px;padding:2px 6px}
  .pp-row .rm:hover{color:#ff8b8b}
  .pp-tier-row .tnums{display:flex;gap:8px;flex-wrap:wrap}
  .pp-tier-row .tnums input{width:90px}
  /* el selector de arriba también agarraba el checkbox de "recomendado" y lo
     estiraba a 90px: se veía como un cuadrado enorme separado de su texto */
  .pp-tier-row .tnums input[type=checkbox]{width:auto}
  /* fix: el <select> "usar oferta" no tenía ancho acotado — con títulos largos de oferta
     empujaba toda la fila (y la página entera) más ancha que la pantalla en celular */
  .pp-tier-row .tnums select.t-from{flex:1 1 160px;min-width:0;max-width:100%}
  .pp-tier-row .rec{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted);white-space:nowrap}
  /* precio + % desc. con label visible (antes solo un placeholder que desaparecía
     al tipear — quedaba invisible el % OFF que ya existía, pedido explícito de
     Sebastián de hacer el descuento por paquete más claro) */
  .pp-tier-row .t-price-lbl{display:flex;flex-direction:column;gap:2px;font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted-2);font-weight:600}
  .pp-tier-row .t-price-lbl input{text-transform:none;letter-spacing:normal;font-size:13.5px;font-weight:400;color:var(--text);margin-top:2px}
  .t-disc-final{font-size:12px;color:var(--acid);font-weight:600;align-self:center;white-space:nowrap}
  .pp-tier-row textarea{width:100%;min-height:90px}
  .pp-oflink{background:none;border:1px solid var(--line-strong);border-radius:8px;color:var(--acid);font-family:inherit;font-size:11.5px;font-weight:700;padding:5px 9px;cursor:pointer;margin-left:8px}
  .pp-oflink:hover{border-color:var(--acid)}
  .pp-tier-margin{font-size:12px;color:var(--muted-2);margin-top:6px}
  .pp-sum{font-size:12.5px;padding:5px 11px;border-radius:999px;border:1px solid var(--line-strong);background:var(--navy-900);color:var(--muted);white-space:nowrap}
  .pp-sum b{color:var(--text)}
  .pp-sum.warn{border-color:rgba(255,180,90,.5);color:#ffc46b}
  /* ---- Propuestas V3 (pp3-): editor por bloques ---- */
  .pp3-split{display:grid;grid-template-columns:216px minmax(0,1fr);gap:18px;align-items:start;margin-top:6px}
  .pp3-blocks{position:sticky;top:12px;background:var(--navy-800);border:1px solid var(--line);border-radius:12px;padding:8px;font-size:12.5px}
  .pp3-b{display:flex;align-items:center;gap:7px;padding:8px 9px;border-radius:8px;color:var(--muted);cursor:pointer;border:1px solid transparent;user-select:none;-webkit-user-select:none}
  .pp3-b:hover{color:var(--text)}
  .pp3-b.act{background:var(--navy-900);color:var(--text);border-color:color-mix(in srgb,var(--acid) 55%,transparent)}
  .pp3-b.off{opacity:.45}
  .pp3-b.off .pp3-bl{text-decoration:line-through}
  .pp3-b.drag{opacity:.5;border:1px dashed var(--acid)}
  .pp3-h{cursor:grab;color:var(--muted-2);font-size:11px;touch-action:none;padding:2px 1px}
  .pp3-bl{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pp3-tgl{background:none;border:0;color:var(--muted-2);cursor:pointer;font-size:12.5px;padding:0 2px;line-height:1}
  .pp3-tgl:hover{color:var(--acid)}
  .pp3-blk{scroll-margin-top:80px}
  .pp3-blk.dim{opacity:.45}
  .pp3-auto{font-size:11.5px;color:#7ed957;white-space:nowrap}
  .pp-status-badge.lost{color:#ff8b8b;border-color:#ff8b8b}
  /* ítems de paquete inline (⇄ sync con la oferta ligada) */
  .pp3-items{margin-top:8px;border-top:1px dashed var(--line-strong);padding-top:8px}
  .pp3-it{display:flex;gap:6px;align-items:flex-end;margin-bottom:6px}
  .pp3-it .iname{flex:1;min-width:0}
  /* cada número con su rótulo visible: en el celular no hay tooltip que valga y
     tres casillas "1 / 8370 / 0" sin etiqueta no se entienden (mismo patrón que
     .t-price-lbl del precio del paquete, que ya se lee bien) */
  .pp3-it .ppf{display:flex;flex-direction:column;gap:2px;font-size:9.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted-2);font-weight:600}
  .pp3-it .ppf input{width:100%;text-transform:none;letter-spacing:normal;font-weight:400;color:var(--text)}
  .pp3-it .ppf-q{width:64px}
  .pp3-it .ppf-p{width:96px}
  .pp3-it .ppf-c{width:88px}
  .pp3-it .icostin{opacity:.75}
  .pp3-it .icostin:focus{opacity:1}
  .pp3-it .icost{font-size:11px;color:var(--muted-2);white-space:nowrap;min-width:70px;text-align:right}
  .pp3-it-bar{display:flex;gap:6px;align-items:center;margin-top:4px}
  .pp3-it-bar select{flex:1;min-width:0;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:8px;color:var(--muted);font-size:12px;padding:7px 8px;font-family:inherit}
  .pp3-sync{font-size:11px;color:#7ed957;margin-left:6px;white-space:nowrap}
  /* ---- Ofertas V3 (of3-): editor en 4 pasos ---- */
  .of3-steps{display:flex;gap:6px;flex-wrap:wrap;margin:12px 0 4px}
  .of3-chip{border:1px solid var(--line-strong);border-radius:999px;background:var(--navy-800);color:var(--muted);font-family:inherit;font-size:12.5px;padding:6px 13px;cursor:pointer}
  .of3-chip:hover{color:var(--text)}
  .of3-chip.on{background:var(--acid);color:#10210a;border-color:var(--acid);font-weight:700}
  .of3-status{display:inline-flex;gap:4px;flex-wrap:wrap}
  .of3-status .of3-chip{font-size:11.5px;padding:4px 10px}
  .of3-nocost .of-table th:nth-child(6),.of3-nocost .of-table tr[data-i] td:nth-child(6),
  .of3-nocost .of-table th:nth-child(8),.of3-nocost .of-table tr[data-i] td:nth-child(8){display:none}
  .of3-nocost .of-table tr.of-sub td:nth-child(3){display:none}
  .of3-nocost .of-sum-row.int,.of3-nocost .of-summary hr,.of3-nocost #of-bep{display:none}
  .of3-send{background:var(--navy-800);border:1px solid var(--line);border-radius:14px;padding:18px;max-width:640px}
  .of3-send .k{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted-2);margin:10px 0 3px}
  .of3-send .k:first-child{margin-top:0}
  .of3-attach{display:inline-block;border:1px solid var(--line-strong);border-radius:10px;padding:8px 12px;background:var(--navy-900);font-size:13px;margin-top:4px}
  .of3-attach small{display:block;color:var(--muted-2);font-size:11px;margin-top:2px}
  /* ---- lead picker (lp-): combobox buscable para "ligar a lead/cliente" ---- */
  .lp-box{position:relative}
  .lp-in{width:100%;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:11px;color:var(--text);font-family:inherit;font-size:14px;padding:10px 13px}
  .lp-dd{position:absolute;top:calc(100% + 4px);left:0;right:0;z-index:80;background:var(--navy-800);border:1px solid var(--line-strong);border-radius:12px;box-shadow:0 14px 40px rgba(0,0,0,.45);max-height:290px;overflow:auto;padding:4px}
  .lp-r{display:block;width:100%;text-align:left;background:none;border:0;border-radius:8px;color:var(--text);font-family:inherit;font-size:13.5px;padding:8px 10px;cursor:pointer}
  .lp-r:hover,.lp-r.hi{background:color-mix(in srgb,var(--acid) 10%,transparent)}
  .lp-co{color:var(--muted)}
  .lp-sub{display:block;font-size:11.5px;color:var(--muted-2);margin-top:1px}
  .lp-sub i{font-style:normal;border:1px solid var(--line-strong);border-radius:20px;padding:0 7px;font-size:10.5px}
  .lp-none{color:var(--muted-2);font-size:13px;padding:8px 10px}
  .lp-chip{display:flex;align-items:center;gap:8px;background:var(--navy-900);border:1px solid color-mix(in srgb,var(--acid) 45%,var(--line-strong));border-radius:11px;padding:9px 13px;font-size:13.5px;color:var(--text)}
  .lp-chip-t{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .lp-x{background:none;border:0;color:var(--muted-2);cursor:pointer;font-size:14px;padding:0 2px}
  .lp-x:hover{color:#ff8b8b}
  @media(max-width:820px){.pp-grid{grid-template-columns:1fr 1fr}.pp-grid3{grid-template-columns:1fr}
    /* 1fr = minmax(auto,1fr): la columna no puede achicarse por debajo del
       min-content de su contenido, así que crecía a 453px dentro de un
       contenedor de 386 y se llevaba puesto todo el editor. El escritorio ya
       usaba minmax(0,1fr) justamente por esto; faltaba acá. */
    .pp3-split{grid-template-columns:minmax(0,1fr)}
    .pp3-blocks,.pp3-main{min-width:0}
    .pp3-blocks{position:sticky;top:0;z-index:5;display:flex;overflow-x:auto;gap:4px;padding:6px;scrollbar-width:none}
    .pp3-blocks::-webkit-scrollbar{display:none}
    .pp3-b{flex:0 0 auto;white-space:nowrap;padding:6px 8px}
  }
  /* fix: en celular real (≤560px) .pp-grid quedaba en 2 columnas (heredado de la regla de 820px)
     y se cortaba por el borde derecho — recién acá colapsa a 1 columna de verdad */
  @media(max-width:560px){.pp-grid{grid-template-columns:1fr}}
  /* ---- preview de blog ---- */
  .post-preview{background:var(--navy-800);border:1px solid var(--line);border-radius:14px;padding:26px 30px;max-width:760px;line-height:1.65}
  .post-preview .eyebrow{font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--acid)}
  .post-preview h1{font-size:26px;margin:8px 0 12px;color:var(--text);line-height:1.2}
  .post-preview .lead{font-size:16px;color:var(--muted);margin-bottom:18px}
  /* ---- Blog rediseñado (bl2-): pipeline + performance + editor visual ---- */
  #bl2-kpis{gap:10px;margin-bottom:14px}
  #bl2-kpis .kpi{padding:12px 14px}
  #bl2-kpis .kpi .n{font-size:20px;white-space:normal}
  #bl2-kpis .kpi .l{margin-top:3px;font-size:11px}
  .bl2-cal{display:flex;gap:8px;margin:0 0 18px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}
  .bl2-cal::-webkit-scrollbar{display:none}
  .bl2-day{flex:1;min-width:132px;border:1px solid var(--line);border-radius:11px;background:var(--navy-800);padding:9px 11px;font-size:11px}
  .bl2-day .d{font-weight:700;color:var(--muted-2);text-transform:uppercase;font-size:9.5px;letter-spacing:.07em}
  .bl2-day .t{font-weight:600;margin-top:4px;font-size:11.5px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .bl2-day.next{border-color:color-mix(in srgb,var(--acid) 45%,transparent)}
  .bl2-day.add{border-style:dashed;cursor:pointer;color:var(--muted-2)}
  .bl2-day.add:hover{border-color:var(--acid);color:var(--acid)}
  .bl2-st{font-size:9.5px;font-weight:700;border-radius:20px;padding:1px 7px;display:inline-block;margin-top:6px}
  .bl2-st.done{background:rgba(126,217,87,.15);color:#7ed957}
  .bl2-st.work{background:rgba(240,192,96,.15);color:#f0c060}
  .bl2-st.pend{background:rgba(138,180,255,.15);color:#8ab4ff}
  .bl2-lang{display:inline-grid;place-items:center;min-width:27px;height:19px;border-radius:5px;font-size:9px;font-weight:800;margin-right:3px;letter-spacing:.03em;border:1px solid transparent}
  .bl2-lang.pub{background:rgba(126,217,87,.16);color:#7ed957}
  .bl2-lang.dr{background:rgba(138,180,255,.15);color:#8ab4ff}
  /* publicado pero con cambios sin subir: el punto ámbar arriba a la derecha */
  .bl2-lang.chg{position:relative}
  .bl2-lang.chg::after{content:'';position:absolute;top:1px;right:1px;width:5px;height:5px;border-radius:50%;background:#f0c060}
  .bl2-lang.no{background:transparent;border-color:var(--line-strong);color:var(--muted-2);cursor:pointer}
  .bl2-lang.no:hover{border-color:var(--acid);color:var(--acid)}
  .bl2-pend{border:1px solid color-mix(in srgb,#f0c060 35%,var(--line));border-radius:14px;background:var(--navy-800);padding:14px 16px;margin-bottom:10px;display:flex;gap:14px;align-items:center;flex-wrap:wrap}
  .bl2-pend-main{flex:1;min-width:240px}
  .bl2-pend-title{font-weight:700;font-size:14.5px}
  .bl2-pend-sub{font-size:12px;color:var(--muted-2);margin-top:3px}
  .bl2-pend-acts{display:flex;gap:8px;flex-wrap:wrap}
  .bl2-kw{width:100%;border:1px solid var(--line);border-radius:10px;background:var(--navy-900);padding:9px 13px;margin:2px 0}
  .bl2-kw-tag{display:inline-block;font-weight:800;font-size:10.5px;border:1px solid;border-radius:6px;padding:2px 7px;white-space:nowrap;margin-right:8px;vertical-align:middle}
  .bl2-kw-kw{font-weight:700;font-size:12.5px;color:var(--text)}
  .bl2-kw-why{font-size:12px;color:var(--muted-2);margin-top:4px;line-height:1.55}
  .bl2-kw.muted{background:transparent;border-style:dashed}
  .bl2-table .bl2-t{font-weight:700;font-size:13.5px}
  .bl2-table .bl2-sub{font-size:11px;color:var(--muted-2);margin-top:2px}
  .bl2-table td{vertical-align:middle}
  .bl2-num{font-family:'Space Grotesk';font-weight:700;text-align:right;white-space:nowrap}
  .bl2-num.good{color:#7ed957}
  .bl2-trend{font-size:11.5px;font-weight:700;white-space:nowrap;text-align:right}
  .bl2-trend.up{color:#7ed957}
  .bl2-trend.dn{color:var(--muted-2)}
  .bl2-dots{background:transparent;border:1px solid var(--line-strong);border-radius:8px;color:var(--muted);cursor:pointer;font-size:14px;line-height:1;padding:4px 8px;font-family:inherit}
  .bl2-cat-bar{display:flex;flex-wrap:wrap;gap:7px;margin:10px 0 14px}
  .bl2-cat-chip{background:transparent;border:1px solid var(--line-strong);border-radius:20px;color:var(--muted);cursor:pointer;font-size:12.5px;font-family:inherit;padding:6px 12px;transition:.15s}
  .bl2-cat-chip b{font-weight:800;margin-left:3px;color:var(--muted-2)}
  .bl2-cat-chip:hover{border-color:var(--acid);color:var(--text)}
  .bl2-cat-chip.on{background:var(--acid);border-color:var(--acid);color:#0f1826;font-weight:700}
  .bl2-cat-chip.on b{color:#0f1826;opacity:.7}
  .bl2-dots:hover{border-color:var(--acid);color:var(--acid)}
  .bl2-ltabs{display:inline-flex;gap:6px;margin-left:6px}
  .bl2-ltab{background:transparent;border:1px solid var(--line-strong);border-radius:100px;color:var(--muted);font:700 11px Inter,sans-serif;padding:4px 11px;cursor:pointer}
  .bl2-ltab.on{border-color:var(--acid);color:var(--acid);background:rgba(221,249,143,.08)}
  .bl2-ltab.pub:not(.on){color:#7ed957}
  .bl2-ltab.miss{border-style:dashed;color:var(--muted-2)}
  .bl2-ltab.miss:hover{border-color:var(--acid);color:var(--acid)}
  .bl2-imgpick{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:6px;margin-bottom:8px}
  /* La altura la pone la IMAGEN, no el botón. Con `aspect-ratio` en el botón y
     `height:100%` en la img, la fila de la grilla se calculaba por el contenido
     —que era cero— y quedaba de 23px con miniaturas de 197px: cada foto se
     montaba sobre las seis siguientes. Eso es lo que Sebastián vio el 14 ago
     ("están todos juntos, no se las ve bien") y venía de antes. Medido:
     grid-template-rows 22.9px vs tile 197px. */
  .bl2-img{position:relative;border-radius:8px;overflow:hidden;border:2px solid var(--line);cursor:pointer;background:var(--navy-900);padding:0}
  .bl2-img img{width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;display:block}
  .bl2-img:hover{border-color:var(--line-strong)}
  .bl2-img.sel{border-color:var(--acid);box-shadow:0 0 0 2px color-mix(in srgb,var(--acid) 30%,transparent)}
  .bl2-img.sel::after{content:'✓';position:absolute;top:4px;right:4px;background:var(--acid);color:#142033;border-radius:50%;width:17px;height:17px;display:grid;place-items:center;font-size:11px;font-weight:800}
  .bl2-img.none{display:grid;place-items:center;min-height:64px;font-size:10px;color:var(--muted-2);font-weight:700}
  /* el nombre encima de la miniatura: sin esto, en el teléfono son 24 cuadraditos
     iguales y no se sabe cuál es cuál */
  .bl2-cap{position:absolute;left:0;right:0;bottom:0;padding:10px 6px 4px;font:600 10px Inter,sans-serif;color:#fff;
    background:linear-gradient(transparent,rgba(0,0,0,.78));text-align:left;line-height:1.15;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .bl2-mas{grid-column:1/-1;aspect-ratio:auto;padding:9px 0;font-size:11.5px;color:var(--acid);border-style:dashed}
  /* catálogos plegables: cerrados no tapan el artículo, abiertos son la grilla de siempre */
  .bl2-det{margin:8px 0 0;border:1px solid var(--line);border-radius:10px;background:var(--navy-900)}
  .bl2-det>summary{cursor:pointer;padding:8px 11px;font:700 12px Inter,sans-serif;color:var(--muted);list-style:none;display:flex;align-items:center;gap:8px}
  .bl2-det>summary::-webkit-details-marker{display:none}
  .bl2-det>summary::before{content:'▸';font-size:10px;color:var(--muted-2)}
  .bl2-det[open]>summary::before{content:'▾'}
  .bl2-det>summary:hover{color:var(--acid)}
  .bl2-det[open]{padding:0 11px 11px}
  .bl2-det .bl2-imgpick{max-height:290px;overflow-y:auto}
  .bl2-det-now{font-weight:500;color:var(--muted-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .bl2-vidpick{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
  .bl2-vid{background:transparent;border:1px solid var(--line-strong);border-radius:100px;color:var(--muted);font:600 11px Inter,sans-serif;padding:5px 11px;cursor:pointer}
  .bl2-vid:hover{border-color:var(--acid);color:var(--acid)}
  .bl2-vid.sel{border-color:var(--acid);color:var(--acid);background:rgba(221,249,143,.08)}
  @media(max-width:720px){
    .bl2-pend{padding:12px}
    .bl2-pend-acts{width:100%}
    .bl2-pend-acts .btn{flex:1;white-space:nowrap}
    .bl2-table th:nth-child(4),.bl2-table td:nth-child(4){display:none}
    /* En el iPhone tres columnas dejan miniaturas de ~90px: no se ve qué foto es
       (reporte de Sebastián, 14 ago). Dos columnas, más altas, y el cajón usa
       media pantalla en vez de 290px fijos. */
    .bl2-imgpick{grid-template-columns:repeat(2,1fr);gap:8px}
    .bl2-det .bl2-imgpick{max-height:52vh}
    .bl2-det[open]{padding:0 8px 10px}
  }
  .gads-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:14px}
  .gads-kpi{border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:flex;flex-direction:column;gap:4px}
  .gads-kpi b{font-size:19px;line-height:1.1}
  .gads-kpi span{font-size:11.5px;color:var(--muted)}
  .gads-roi{display:flex;gap:10px;flex-wrap:wrap;align-items:stretch}
  .gads-roi .gads-kpi{min-width:128px;justify-content:center}
  .gads-table{width:100%;border-collapse:collapse;font-size:13px;min-width:460px}
  .gads-table th,.gads-table td{padding:8px 10px;text-align:left;border-bottom:1px solid var(--line)}
  .gads-table th{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.5px}

  /* ============ rediseño tab NEWSLETTER (scoped a #contenido-sub-news — nunca inputs pelados) ============ */
  #contenido-sub-news .nw-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:18px;align-items:start}
  @media(max-width:900px){#contenido-sub-news .nw-grid{grid-template-columns:1fr}}
  /* ===== los tres pasos ===== */
  #contenido-sub-news .nw-langtabs{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 12px}
  #contenido-sub-news .nw-langtabs button{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:999px;
    color:var(--muted);font:600 12.5px/1 inherit;padding:8px 14px;cursor:pointer}
  #contenido-sub-news .nw-langtabs button.on{background:var(--acid);border-color:var(--acid);color:#16210a}
  #contenido-sub-news .nw-langtabs button.full:not(.on){border-color:color-mix(in srgb,var(--acid) 45%,transparent);color:var(--acid)}
  #contenido-sub-news .nw-langtabs .nw-trad{margin-left:auto;background:transparent}
  #contenido-sub-news .nw-paso{border:1px solid var(--line);border-radius:14px;background:var(--navy-800);margin-bottom:10px}
  #contenido-sub-news .nw-paso > summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:11px;
    padding:14px 16px;font-weight:700;font-size:15px}
  #contenido-sub-news .nw-paso > summary::-webkit-details-marker{display:none}
  #contenido-sub-news .nw-paso > summary::after{content:'▸';margin-left:auto;color:var(--muted-2);font-size:13px}
  #contenido-sub-news .nw-paso[open] > summary::after{content:'▾'}
  #contenido-sub-news .nw-paso > summary em{font-style:normal;font-weight:400;font-size:12.5px;color:var(--muted-2)}
  #contenido-sub-news .nw-paso-n{flex:none;width:24px;height:24px;border-radius:50%;background:var(--acid);color:#16210a;
    font-weight:800;font-size:12px;display:flex;align-items:center;justify-content:center}
  #contenido-sub-news .nw-paso-body{padding:0 16px 16px}
  #contenido-sub-news .nw-paso-body > .panel{border:0;background:none;padding:0;margin:0}
  /* lo automático pesa menos: se configura una vez y no compite con el envío de hoy */
  #contenido-sub-news .nw-auto{opacity:.75}
  #contenido-sub-news .nw-auto:hover,#contenido-sub-news .nw-auto[open]{opacity:1}
  #contenido-sub-news .nw-auto .nw-paso-n{background:var(--navy-600);color:var(--text)}
  #contenido-sub-news .nw-sec-h{font-size:10px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted-2);font-weight:700;margin:16px 0 8px;display:flex;align-items:center;gap:8px}
  #contenido-sub-news .nw-sec-h:first-child{margin-top:0}
  /* campos de formulario — dedicados, con clase reconocible */
  #contenido-sub-news .nw-inp{width:100%;background:var(--navy-900);border:1px solid var(--line-strong);border-radius:10px;color:var(--text);font:14px/1.5 inherit;padding:10px 12px}
  #contenido-sub-news textarea.nw-inp{min-height:120px;resize:vertical}
  #contenido-sub-news select.nw-sel{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:100px;color:var(--text);font:600 12.5px inherit;padding:8px 13px;cursor:pointer}
  #contenido-sub-news .nw-inp:focus,#contenido-sub-news .nw-sel:focus{outline:none;border-color:var(--acid)}
  #contenido-sub-news .nw-row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
  /* bloques de contenido — cards compactas en el editor */
  #contenido-sub-news .nw-block{border:1.5px solid rgba(221,249,143,.4);border-radius:12px;background:var(--navy-900);padding:10px 13px;margin:8px 0;position:relative}
  #contenido-sub-news .nw-block .nw-bh{display:flex;align-items:center;gap:8px;font-weight:700;font-size:12px;color:var(--acid);margin-bottom:8px}
  #contenido-sub-news .nw-block .nw-bctl{margin-left:auto;display:flex;gap:4px}
  #contenido-sub-news .nw-block .nw-bctl button{background:none;border:1px solid var(--line-strong);border-radius:7px;color:var(--muted);cursor:pointer;font-size:12px;line-height:1;padding:3px 7px}
  #contenido-sub-news .nw-block .nw-bctl button:hover{border-color:var(--acid);color:var(--acid)}
  #contenido-sub-news .nw-block .nw-bctl button:disabled{opacity:.3;cursor:default}
  #contenido-sub-news .nw-textblock{border:1px solid var(--line);border-radius:12px;background:var(--navy-900);margin:8px 0}
  #contenido-sub-news .nw-textblock textarea{width:100%;background:transparent;border:0;color:var(--text);font:13.5px/1.6 inherit;padding:11px 13px;resize:vertical;min-height:70px}
  #contenido-sub-news .nw-textblock textarea:focus{outline:none}
  #contenido-sub-news .nw-addrow{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
  #contenido-sub-news .nw-addbtn{border:1px dashed var(--line-strong);border-radius:100px;padding:6px 12px;font-size:11.5px;color:var(--muted);background:transparent;cursor:pointer}
  #contenido-sub-news .nw-addbtn:hover{border-color:var(--acid);color:var(--acid)}
  /* mini campo dentro de un bloque */
  #contenido-sub-news .nw-bfield{display:flex;flex-direction:column;gap:3px;margin-top:6px}
  #contenido-sub-news .nw-bfield label{font-size:10.5px;color:var(--muted-2);text-transform:uppercase;letter-spacing:.04em}
  #contenido-sub-news .nw-thumbrow{display:flex;gap:9px;align-items:center;margin-top:6px}
  #contenido-sub-news .nw-thumb{width:96px;aspect-ratio:16/9;border-radius:8px;background:#16233a center/cover no-repeat;display:grid;place-items:center;font-size:15px;color:#fff;flex:none}
  /* send box acid */
  #contenido-sub-news .nw-sendbox{border:1px solid rgba(221,249,143,.4);border-radius:13px;background:rgba(221,249,143,.06);padding:14px 16px;margin-top:12px}
  #contenido-sub-news .nw-sendbox .t{font-weight:700;font-size:13.5px}
  #contenido-sub-news .nw-sendbox .m{font-size:12px;color:var(--muted);margin-top:6px;line-height:1.6}
  #contenido-sub-news .nw-sendbox .m b{color:var(--text)}
  #contenido-sub-news .nw-sendbox .m .cap-over{color:var(--lost);font-weight:700}
  #contenido-sub-news .nw-bar{height:8px;border-radius:10px;background:rgba(255,255,255,.09);overflow:hidden;margin-top:10px}
  #contenido-sub-news .nw-bar i{display:block;height:100%;width:0;background:var(--acid);border-radius:10px;transition:width .3s}
  #contenido-sub-news .nw-bar-t{font-size:10.5px;color:var(--muted-2);margin-top:5px}
  /* KPI mini row */
  #contenido-sub-news .kmini{display:flex;gap:9px;margin-bottom:14px}
  #contenido-sub-news .kmini .k{flex:1;border:1px solid var(--line);border-radius:11px;background:var(--navy-900);padding:10px 12px}
  #contenido-sub-news .kmini .k .n{font-family:'Space Grotesk';font-weight:700;font-size:18px;color:var(--acid)}
  #contenido-sub-news .kmini .k .l{font-size:9px;color:var(--muted-2);text-transform:uppercase;letter-spacing:.05em;margin-top:2px}
  /* los tres números abren la lista de gente real detrás (pedido de Sebastián, 12 ago) */
  #contenido-sub-news .kmini .k.clickable{cursor:pointer;transition:border-color .12s,background .12s}
  #contenido-sub-news .kmini .k.clickable:hover{border-color:var(--acid);background:color-mix(in srgb,var(--acid) 6%,transparent)}
  /* listas de personas de los overlays (destinatarios, aperturas, bajas) */
  /* La tarjeta NO puede pasar el alto de la ventana: si pasa, la lista de checks y
     el boton "Listo" quedan abajo del borde y parece que no se puede editar
     (reportado por Sebastian el 12 ago 2026 — la tarjeta media 868px en una
     ventana de 746 y no llegaba a los checks). La tarjeta se limita y lo unico
     que scrollea es la lista. */
  .nw-peoplecard{display:flex;flex-direction:column;max-height:88vh}
  .nw-peoplecard > .nw-plist{flex:1 1 auto;min-height:96px;max-height:none}
  .nw-plist{max-height:min(52vh,420px);overflow-y:auto;margin-top:8px}
  .nw-prow{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--line);font-size:13.5px}
  .nw-prow .who{flex:1;min-width:0;overflow:hidden}
  .nw-prow .who .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .nw-prow .who .em{font-size:11px;color:var(--muted-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .nw-lgtag{flex:none;font-size:10px;font-weight:700;letter-spacing:.04em;border:1px solid var(--line-strong);border-radius:6px;padding:1px 5px;color:var(--muted)}
  .nw-sum{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 2px}
  .nw-sum span{border:1px solid var(--line);border-radius:8px;padding:4px 8px;font-size:11.5px;color:var(--muted)}
  .nw-sum b{font-family:'Space Grotesk';color:var(--acid)}
  .nw-langtabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
  /* lista de campañas */
  #contenido-sub-news .nw-sr{display:flex;align-items:flex-start;gap:9px;padding:11px 0;border-bottom:1px solid var(--line);font-size:12.5px}
  #contenido-sub-news .nw-sr:last-child{border-bottom:0}
  #contenido-sub-news .nw-sr .tt{font-weight:600;color:var(--text)}
  #contenido-sub-news .nw-sr .sub{font-size:10.5px;color:var(--muted-2);margin-top:2px}
  #contenido-sub-news .nw-sr .st2{margin-left:auto;font-size:10.5px;text-align:right;white-space:nowrap}
  #contenido-sub-news .nw-pill{font-size:9.5px;font-weight:700;border-radius:20px;padding:2px 8px;display:inline-block}
  #contenido-sub-news .nw-pill.ok{background:rgba(126,217,87,.15);color:var(--won)}
  #contenido-sub-news .nw-pill.warn{background:rgba(240,192,96,.15);color:var(--warn)}
  #contenido-sub-news .nw-sr.clickable{cursor:pointer}
  #contenido-sub-news .nw-sr.clickable:hover{background:color-mix(in srgb,var(--acid) 6%,transparent)}
  /* thumbnails picker (video/case/still) dentro del overlay */
  #contenido-sub-news .nw-pick{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;max-height:360px;overflow-y:auto;margin-top:8px}
  .nw-pick-btn{border:1px solid var(--line);border-radius:9px;overflow:hidden;background:var(--navy-900);cursor:pointer;padding:0;text-align:left}
  .nw-pick-btn:hover{border-color:var(--acid)}
  .nw-pick-btn img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}
  .nw-pick-btn .cap{font-size:10.5px;color:var(--muted);padding:5px 7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  /* input dentro de overlays del newsletter (fuera de #contenido-sub-news, no pueden usar .nw-inp scoped) */
  .nw-ov-inp{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:10px;color:var(--text);font-family:inherit;font-size:14px;padding:10px 12px}
  .nw-ov-inp:focus{outline:none;border-color:var(--acid)}

  /* ---- rediseño tab Google Ads: veredicto, settings, pacing, search terms ---- */
  .warnbox{background:rgba(255,210,127,.08);border:1px solid rgba(255,210,127,.35);border-radius:12px;padding:12px 16px;font-size:13px;color:#ffd27f;margin-bottom:14px}
  :root[data-theme="light"] .warnbox{color:#8a5a00;background:rgba(255,180,60,.12);border-color:rgba(255,180,60,.5)}
  .gads-stale{margin:10px 0 0;padding:10px 13px;border-radius:11px;font-size:13px;line-height:1.45;
    background:color-mix(in srgb,#f0c060 12%,transparent);border:1px solid color-mix(in srgb,#f0c060 40%,transparent);color:#f0c060}
  .gads-verdict{background:linear-gradient(135deg,color-mix(in srgb,var(--acid) 12%,transparent),color-mix(in srgb,var(--acid) 5%,transparent));border:1px solid var(--acid);border-radius:12px;padding:12px 16px;font-size:14px;margin:0}
  .gads-settings-pop{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:12px;padding:14px 16px;margin:10px 0;display:flex;gap:16px;flex-wrap:wrap;align-items:flex-end}
  .gads-settings-pop .bf{margin:0;min-width:220px;flex:1}
  #ana-sub-gads .bf label{display:block;font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:6px}
  #ana-sub-gads .bf input{width:100%;background:var(--navy-800);border:1px solid var(--line-strong);border-radius:11px;color:var(--text);font-family:inherit;font-size:14.5px;padding:11px 13px}
  .gads-two{display:grid;grid-template-columns:1.3fr 1fr;gap:14px;margin-top:14px;align-items:start}
  @media(max-width:900px){.gads-two{grid-template-columns:1fr}}
  .gads-pace b{font-size:13.5px}
  .gads-pacebar{height:10px;background:var(--navy-900);border-radius:999px;border:1px solid var(--line);overflow:hidden;margin:9px 0 5px}
  .gads-pacebar i{display:block;height:100%;background:var(--acid);transition:width .3s}
  .gads-pacebar i.over{background:#ff8b8b}
  .gads-sem{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:7px;flex:none}
  .gads-sem.ok{background:#7ed957}.gads-sem.mid{background:#ffd27f}.gads-sem.bad{background:#ff8b8b}
  .gads-roas-ok{color:#7ed957;font-weight:800}
  .gads-roas-bad{color:#ff8b8b;font-weight:800}
  .gads-negflag{color:#ff8b8b;font-size:12px;white-space:nowrap}
  .gads-okflag{color:#7ed957;font-size:12px;white-space:nowrap}
  .gads-spark-svg{width:100%;height:64px;display:block;overflow:visible}
  .gads-camp-acts{display:flex;gap:4px;justify-content:flex-end}
