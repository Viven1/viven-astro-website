      $('rm-goal-form').hidden = true; $('rm-goal-view').hidden = false;
      toast('🎯 Objetivo mensual guardado: ' + (v ? fmtChf(v) : 'sin objetivo'));
      rmRender();
    } catch (e) { toast('No se pudo guardar (¿corriste el SQL 0108?): ' + e.message); }
    finally { btn.disabled = false; }
  });
  $('rm-goal-inp').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('rm-goal-save').click(); });

  /* ---------- 🤖 Cola de "aprobado, falta hacerlo" (tabla work_queue — SQL 0124) ----------
     Sebastián, 14 ago 2026: aprobar una idea de CRO no hacía nada — escribía una
     marca en un jsonb y mostraba un cartel. "Hacelo y hacé que funcione bien o no
     sirve para nada". Esto es el lugar que hay que vaciar: lo aprobado queda acá,
     con los días de espera a la vista, hasta que alguien lo marca hecho. Sirve
     igual para las ideas de CRO y para las acciones sobre un cliente. */
  let wqRows = [];
  const wqDias = (iso) => Math.floor((Date.now() - new Date(iso).getTime()) / 864e5);
  const wqEspera = (iso) => { const d = wqDias(iso); return d <= 0 ? 'hoy' : d === 1 ? 'hace 1 día' : 'hace ' + d + ' días'; };

  async function wqLoad(){
    const { data, error } = await supabase.from('work_queue')
      .select('id,source,ref,title,detail,url,status,approved_at')
      .in('status', ['pending', 'doing']).order('approved_at', { ascending: true });
    if (error){ wqRows = []; wqRender(); return; }   // tabla sin crear todavía: el panel no molesta
    wqRows = data || [];
    wqRender();
  }
  function wqRender(){
    const card = $('wq-card'), list = $('wq-list'); if (!card || !list) return;
    card.hidden = wqRows.length === 0;
    $('wq-n').textContent = wqRows.length || '';
    // mismas clases que el resto de las listas de Hoy (.ic/.tx/.go): una fila
    // aprobada tiene que verse igual que cualquier otra cosa pendiente
    const ICONO = { cro: '🧪', accion: '📣', manual: '📌' };
    list.innerHTML = wqRows.map((r) => {
      const dias = wqDias(r.approved_at);
      return '<div class="hm-item' + (dias >= 7 ? ' ambar' : '') + '" style="cursor:default">' +
        '<span class="ic">' + (ICONO[r.source] || '📌') + '</span>' +
        '<span class="tx"><b>' + esc(r.title || '') + '</b>' +
          (r.detail ? '<small class="wq-det">' + esc(String(r.detail).slice(0, 160)) + '</small>' : '') +
          // la espera va en su propia línea: es el dato del panel y no puede
          // quedar cortada por el recorte del detalle
          '<small class="wq-age">aprobado ' + wqEspera(r.approved_at) + (r.status === 'doing' ? ' · en curso' : '') + '</small>' +
        '</span>' +
        '<span class="wq-acts">' +
          // el ↗ solo si lleva a otro lado: un botón que te deja donde ya estás
          // parece roto (reportado el 14 ago sobre las oportunidades de la web)
          (r.url && !/^\/dashboard\/\?tab=hoy$/.test(r.url) ? '<button class="wq-b" data-wq-ir="' + r.id + '" type="button" title="Ver dónde">↗</button>' : '') +
          '<button class="wq-b ok" data-wq-done="' + r.id + '" type="button" title="Marcar como hecho">✓</button>' +
          '<button class="wq-b" data-wq-cancel="' + r.id + '" type="button" title="Ya no hace falta">✕</button>' +
        '</span></div>';
    }).join('');
    const masViejo = wqRows.length ? wqDias(wqRows[0].approved_at) : 0;
    $('wq-note').textContent = wqRows.length
      ? (masViejo >= 7 ? '⚠️ Lo más viejo espera hace ' + masViejo + ' días.' : 'Se vacía a medida que se hacen.')
      : '';
    list.querySelectorAll('[data-wq-ir]').forEach((b) => b.addEventListener('click', () => {
      const r = wqRows.find((x) => String(x.id) === b.dataset.wqIr); if (r && r.url) location.href = r.url;
    }));
    list.querySelectorAll('[data-wq-done]').forEach((b) => b.addEventListener('click', () => wqSet(b.dataset.wqDone, 'done')));
    list.querySelectorAll('[data-wq-cancel]').forEach((b) => b.addEventListener('click', () => wqSet(b.dataset.wqCancel, 'cancelled')));
  }
  /* Encolar. El índice único (source, ref) con status pendiente hace que aprobar
     dos veces lo mismo —o un tap repetido en el teléfono— no cree dos pendientes. */
  async function wqAdd(item){
    /* Si eso mismo ya pasó por la cola —hecho o cancelado— NO vuelve a entrar.
       Sin esto, el backfill de CRO revivía cada idea ya resuelta en cuanto se
       abría el tab: la cola se llenaba sola de trabajo terminado. El índice
       único de la base solo cubre lo pendiente, así que el filtro va acá. */
    if (item.ref){
      const { data: previa } = await supabase.from('work_queue').select('id')
        .eq('source', item.source || 'manual').eq('ref', item.ref).limit(1);
      if (previa && previa.length) return false;
    }
    const fila = { source: item.source || 'manual', ref: item.ref || null, title: item.title || '(sin título)',
      detail: item.detail || null, url: item.url || null, status: 'pending', approved_by: meEmail || null };
    // el backfill sabe desde cuándo espera de verdad: sin esto todo lo viejo
    // aparecía como "aprobado hoy", que es justo lo que hay que poder ver
    if (item.approved_at) fila.approved_at = item.approved_at;
    const { error } = await supabase.from('work_queue').insert(fila);
    if (error && !/duplicate key|unique/i.test(error.message || '')){ toast('No se pudo encolar: ' + error.message); return false; }
    await wqLoad();
    return true;
  }
  async function wqCancelRef(source, ref){
    await supabase.from('work_queue').update({ status: 'cancelled' })
      .eq('source', source).eq('ref', ref).in('status', ['pending', 'doing']);
    await wqLoad();
  }
  async function wqSet(id, status, nota){
    const r = wqRows.find((x) => String(x.id) === String(id));
    const patch = { status };
    if (status === 'done'){ patch.done_at = new Date().toISOString(); if (nota) patch.done_note = nota; }
    const { error } = await supabase.from('work_queue').update(patch).eq('id', id);
    if (error){ toast('No se pudo actualizar: ' + error.message); return; }
    /* Cerrar el círculo del lado del CRO: si no se marca la idea en su propio
       jsonb, la tarjeta sigue diciendo "🤖 Aprobada" para siempre y el estado
       queda contradiciendo a la cola. */
    if (r && r.source === 'cro' && r.ref) await croMarcarIdea(r.ref, status === 'done' ? 'done' : null);
    // avisar al equipo que se hizo: el que aprobó no tiene que venir a preguntar
    if (status === 'done' && r) pushTo(null, '✅ Hecho: ' + (r.title || '').slice(0, 60), 'Lo aprobado ya está resuelto.', '/dashboard/?tab=hoy');
    toast(status === 'done' ? '✅ Marcado como hecho' : 'Sacado de la cola');
    await wqLoad();
  }

  function renderHome(){
