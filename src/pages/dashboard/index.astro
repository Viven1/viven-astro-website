     (Sebastián, 26 ago 2026: "tocar el project brief abre un popup vacío" / "tengo que
     poder tenerlo dentro del panel y llenarlo ahí".) */
  const PBRIEF = (() => { try { return JSON.parse($('brief-json').textContent); } catch (e){ return { BRIEF: [], BRIEF_SECCIONES: [], BRIEF_T: {} }; } })();
  let pbrResp = {}, pbrTarde = {}, pbrT = null, pbrLang = 'es';

  async function pjBriefVer(){
    const p = pjCur; if (!p) return;
    $('pbf-modal').hidden = false;
    $('pbf-sub').textContent = (p.ref ? p.ref + ' · ' : '') + (p.title || '');
    pbrTab('llenar');
    $('pbf-llenar').innerHTML = '<p class="muted-note" style="margin:0">Cargando…</p>';
    $('pbf-mandar').innerHTML = '';

    const l = leadById(p.lead_id) || {};
    pbrLang = ['en', 'de', 'es'].includes(l.lang) ? l.lang : 'en';

    /* updated_at también: con brief_done_at se sabe qué contestó DESPUÉS de darlo por
       terminado. Esa respuesta llega cuando el brief ya se leyó —o ya se escribió el
       guion—, así que si no se marca no la ve nadie.
       (Sebastián, 27 ago 2026: "que se agregue al brief ya enviado".) */
    const { data } = await supabase.from('project_briefs').select('key,value,updated_at').eq('project_id', p.id);
    pbrResp = {}; pbrTarde = {};
    const _cierre = p.brief_done_at ? Date.parse(p.brief_done_at) : null;
    (data || []).forEach((r) => {
      pbrResp[r.key] = r.value || '';
      if (_cierre && Date.parse(r.updated_at) > _cierre + 60000) pbrTarde[r.key] = r.updated_at;
    });
    pbrRender();
    pbrRenderMandar();
  }

  function pbrTab(cual){
    document.querySelectorAll('[data-pbt]').forEach((b) => b.classList.toggle('on', b.dataset.pbt === cual));
    $('pbf-llenar').hidden = cual !== 'llenar';
    $('pbf-mandar').hidden = cual !== 'mandar';
  }

  /* Las respuestas se guardan como "Chip · Otro chip — texto libre", igual que el
     playbook: un solo campo que se lee entero sin tener que cruzar dos tablas. */
  function pbrPartir(v){
    const t = String(v || '');
    const i = t.indexOf(' — ');
    if (i < 0) return { chips: t.trim() && !t.includes(' · ') && false ? [] : (t.includes(' · ') ? t.split(' · ').map((x) => x.trim()) : []), libre: t.includes(' · ') ? '' : t };
    return { chips: t.slice(0, i).split(' · ').map((x) => x.trim()).filter(Boolean), libre: t.slice(i + 3) };
  }
  function pbrJuntar(chips, libre){
    return [chips.join(' · '), String(libre || '').trim()].filter(Boolean).join(' — ');
  }

  function pbrRender(){
    const p = pjCur; if (!p) return;
    const L = pbrLang;
    const T = PBRIEF.BRIEF_T && PBRIEF.BRIEF_T[L] ? PBRIEF.BRIEF_T[L] : {};
    const contestadas = PBRIEF.BRIEF.filter((q) => String(pbrResp[q.k] || '').trim()).length;
    const total = PBRIEF.BRIEF.length;

    const nTarde = Object.keys(pbrTarde || {}).length;
    let html = (nTarde
      ? '<div class="pb-avisotarde">📝 ' + nTarde + (nTarde === 1 ? ' respuesta llegó' : ' respuestas llegaron') +
        ' después de que el cliente diera el brief por terminado. ' +
        (nTarde === 1 ? 'Está marcada abajo' : 'Están marcadas abajo') + ' — miralas antes de escribir el guion.</div>'
      : '') +
      '<div class="pb-prog"><span>' + contestadas + ' de ' + total + '</span>' +
      '<span class="bar"><i style="width:' + Math.round(contestadas / total * 100) + '%"></i></span>' +
      '<span>' + (p.brief_done_at ? '✓ el cliente lo dio por terminado' :
                  p.brief_sent_at ? 'enviado, sin terminar' : 'no se mandó todavía') + '</span></div>';

    let secActual = null;
    PBRIEF.BRIEF.forEach((q) => {
      if (q.sec !== secActual){
        secActual = q.sec;
        html += '<div class="pb-sec">' + esc((T.sec && T.sec[q.sec]) || q.sec) + '</div>';
      }
      const { chips, libre } = pbrPartir(pbrResp[q.k]);
      const tarde = pbrTarde[q.k];
      html += '<div class="pb-q' + (tarde ? ' pb-tarde' : '') + '" data-q="' + q.k + '">' +
        '<p class="qq">' + esc(q.q[L] || q.q.en) + (q.esencial ? '' : ' <span class="muted-note" style="font-weight:400">· opcional</span>') +
        (tarde ? ' <span class="pb-tardechip">agregado el ' + esc(fmtDMY(tarde)) + ', después de darlo por terminado</span>' : '') + '</p>' +
        (q.h ? '<p class="hh">' + esc(q.h[L] || q.h.en) + '</p>' : '') +
        ((q.op && (q.op[L] || q.op.en))
          ? '<div class="pb-chips">' + (q.op[L] || q.op.en).map((o) =>
              '<button type="button" class="pb-chip' + (chips.includes(o) ? ' on' : '') + '" data-o="' + esc(o) + '">' + esc(o) + '</button>').join('') + '</div>'
          : '') +
        '<textarea rows="2" data-k="' + q.k + '" placeholder="' + esc((q.libre && (q.libre[L] || q.libre.en)) || '') + '">' + esc(libre) + '</textarea>' +
      '</div>';
    });
    $('pbf-llenar').innerHTML = html;
    /* Que se vea entero lo que contestó. Con rows="2" fijo, una respuesta larga era una
       ventanita de dos líneas sobre 2.900px de texto — lo mismo que pasaba en el portal. */
    Array.prototype.forEach.call($('pbf-llenar').querySelectorAll('textarea'), (ta) => {
      const crecer = () => {
        ta.style.height = 'auto';
        ta.style.height = Math.min(ta.scrollHeight + 2, 420) + 'px';
        ta.style.overflowY = ta.scrollHeight + 2 > 420 ? 'auto' : 'hidden';
      };
      ta.addEventListener('input', crecer);
      crecer();
    });

    $('pbf-llenar').querySelectorAll('textarea').forEach((ta) => ta.addEventListener('input', () => pbrGuardarDebounce()));
    $('pbf-llenar').querySelectorAll('.pb-chip').forEach((b) => b.addEventListener('click', () => {
      const q = PBRIEF.BRIEF.find((x) => x.k === b.closest('.pb-q').dataset.q);
      /* Las de una sola respuesta se comportan como radio: elegir otra apaga la anterior.
         Si no, quedan dos respuestas contradictorias en el mismo campo. */
      if (q && !q.multi) b.closest('.pb-chips').querySelectorAll('.pb-chip').forEach((o) => { if (o !== b) o.classList.remove('on'); });
      b.classList.toggle('on');
      pbrGuardarDebounce();
    }));
  }

  function pbrLeerDom(){
    const out = {};
    $('pbf-llenar').querySelectorAll('.pb-q').forEach((caja) => {
      const chips = [...caja.querySelectorAll('.pb-chip.on')].map((c) => c.dataset.o);
      const libre = (caja.querySelector('textarea') || {}).value || '';
      out[caja.dataset.q] = pbrJuntar(chips, libre);
    });
    return out;
  }

  function pbrGuardarDebounce(){ clearTimeout(pbrT); pbrT = setTimeout(pbrGuardar, 700); }

  async function pbrGuardar(){
    const p = pjCur; if (!p) return;
    const nuevo = pbrLeerDom();
    const cambios = Object.keys(nuevo).filter((k) => String(nuevo[k] || '') !== String(pbrResp[k] || ''));
    if (!cambios.length) return;
    /* Solo lo que cambió, y sin borrar lo que el cliente escribió: una respuesta que se
       vacía acá se BORRA de la tabla, no se guarda como cadena vacía, para que el portal
       la muestre en blanco y no como "contestada". */
    const filas = cambios.filter((k) => String(nuevo[k]).trim())
      .map((k) => ({ project_id: p.id, key: k, value: nuevo[k], answered_by: 'VIVEN' }));
    const vacias = cambios.filter((k) => !String(nuevo[k]).trim());
    if (filas.length){
      const { error } = await supabase.from('project_briefs').upsert(filas, { onConflict: 'project_id,key' });
      if (error){ toast(error.message); return; }
    }
    if (vacias.length){
      await supabase.from('project_briefs').delete().eq('project_id', p.id).in('key', vacias);
    }
    cambios.forEach((k) => { pbrResp[k] = nuevo[k]; });
    /* Solo el contador se repinta: redibujar todo mientras escribís te saca el cursor. */
    const n = PBRIEF.BRIEF.filter((q) => String(pbrResp[q.k] || '').trim()).length;
    const pr = $('pbf-llenar').querySelector('.pb-prog');
    if (pr){
      pr.firstChild.textContent = n + ' de ' + PBRIEF.BRIEF.length;
      pr.querySelector('.bar i').style.width = Math.round(n / PBRIEF.BRIEF.length * 100) + '%';
    }
  }

  /* La vista previa la arma el SERVIDOR, con el mismo código que manda de verdad. Antes
     era una copia escrita acá: se veía el texto plano y salía otra cosa. Y peor —lo que
     se veía era un párrafo con la URL cruda pegada abajo, que parece phishing.
     (Sebastián, 26 ago 2026: "el texto está malo, parece spam de vuelta… siempre con
     botón y abajo el link por si el botón no funciona. El branding tiene que ser
     consistente".) */
  async function pbrRenderMandar(){
    const x = await pjBriefDatos({ callado: true });
    if (!x){
      /* El link del portal ya no se pide: pjBriefDatos lo genera solo. Lo único que
         puede faltar acá es el email del contacto. */
      $('pbf-mandar').innerHTML = '<p class="muted-note" style="margin:0">El contacto del proyecto no tiene email cargado — sin eso no hay a dónde mandárselo. Se carga en el paso «El cliente».</p>';
      return;
    }
    const T = { largo: 'las 12 de corrido, en cuatro secciones', pasos: 'una sección por vez, con Atrás y Siguiente' }[x.variante];
    $('pbf-mandar').innerHTML =
      '<p class="muted-note" style="margin:0 0 12px">Para <b>' + esc(x.l.name || x.l.email) + '</b> · ' + esc(x.l.email) +
        ' · idioma <b>' + x.lang.toUpperCase() + '</b> · le toca la presentación <b style="color:var(--acid)">' + esc(x.variante) + '</b> (' + T + ')</p>' +
      '<div id="pbf-prev" style="border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#f4f5f7">' +
        '<p style="color:#8a94a8;margin:0;padding:22px;font-size:13px">Armando el email…</p></div>' +
      '<div class="fu-actions" style="margin-top:16px">' +
        '<button class="btn btn-primary" id="pbf-go" type="button">📤 Mandárselo a ' + esc(x.l.email) + '</button>' +
        '<span class="muted-note" id="pbf-msg">Nada sale hasta que toques el botón.</span>' +
      '</div>';

    let asuntoReal = x.asunto;
    try {
      const { data, error } = await supabase.functions.invoke('get-portal', { body: {
        id: x.d.id, t: x.d.portal_token, accion: 'brief_preview', to: x.l.email } });
      if (error) throw new Error(error.message);
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
      asuntoReal = data.asunto;
      /* En un iframe con srcdoc: el email trae su propio <body> y sus estilos, y meterlo
         con innerHTML lo dejaría heredar los del dashboard — se vería distinto de como
         llega. Es la misma trampa del CSS scopeado de Astro. */
      $('pbf-prev').innerHTML =
        '<div style="background:#fff;border-bottom:1px solid #e6e9ef;padding:12px 16px;font-size:12px;color:#8a94a8">' +
          '<b style="color:#1a2230">Para:</b> ' + esc(data.para) + '<br /><b style="color:#1a2230">Asunto:</b> ' + esc(data.asunto) + '</div>' +
        '<iframe style="width:100%;height:560px;border:0;display:block;background:#f4f5f7"></iframe>';
      $('pbf-prev').querySelector('iframe').srcdoc = data.html;
    } catch (e){
      $('pbf-prev').innerHTML = '<p style="color:#b00;margin:0;padding:18px;font-size:13px">⚠️ ' + esc(e.message || e) + '</p>';
    }

    $('pbf-go').addEventListener('click', async () => {
      const b = $('pbf-go'), m = $('pbf-msg');
      b.disabled = true; m.textContent = 'Enviando…';
      try {
        const { data, error } = await supabase.functions.invoke('get-portal', { body: {
          id: x.d.id, t: x.d.portal_token, accion: 'brief_mandar',
          to: x.l.email, asunto: asuntoReal, variante: x.variante } });
        if (error) throw new Error(error.message);
        if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
        x.p.brief_sent_at = new Date().toISOString();
        x.p.brief_variante = x.variante;
        m.textContent = '✅ Enviado a ' + data.para;
        b.style.display = 'none';
        toast('📋 Brief enviado · presentación: ' + x.variante);
        pjRenderSteps();
      } catch (e){ m.textContent = '⚠️ ' + (e.message || e); b.disabled = false; }
    });
  }

  (function pbrBind(){
    const cerrar = () => { clearTimeout(pbrT); pbrGuardar(); $('pbf-modal').hidden = true; pjRenderPortal(); };
    document.addEventListener('click', (e) => {
      if (!e.target) return;
      if (e.target.id === 'pbf-x' || e.target.id === 'pbf-back' || e.target.id === 'pbf-modal') cerrar();
      if (e.target.dataset && e.target.dataset.pbt) pbrTab(e.target.dataset.pbt);
    });
    document.addEventListener('keydown', (e) => {
      const m = $('pbf-modal');
      if (e.key === 'Escape' && m && !m.hidden && !/TEXTAREA|INPUT/.test((e.target || {}).tagName || '')) cerrar();
    });
  })();

  async function pjBriefMandar(x){
    try {
      const { error } = await supabase.from('projects')
        .update({ brief_variante: x.variante, brief_sent_at: new Date().toISOString() }).eq('id', x.p.id);
      if (error) throw new Error(error.message);
      x.p.brief_variante = x.variante; x.p.brief_sent_at = new Date().toISOString();
      const { error: e2 } = await supabase.functions.invoke('send-outreach', {
        body: { to: x.l.email, subject: x.asunto, body: x.cuerpo + '\n\n' + x.url,
                lead_id: x.p.lead_id, fromName: 'Sofia' } });
      if (e2) throw new Error(e2.message);
      toast('📋 Brief enviado a ' + x.l.email + ' · presentación: ' + x.variante);
      pjRenderPortal();
      return { ok: true };
    } catch (e){ return { ok: false, error: e.message || String(e) }; }
  }

  async function pjGenPortal(op){
    const callado = op && op.callado;
    const p = pjCur; if (!p || !p.deal_id) return false;
    /* Regenerar un token existente rompe todos los links que el cliente ya tiene. Cuando
       se llama solo (desde un envío) nunca pisa el que hay. */
    /* Contra la BASE, no contra la memoria. La comprobación miraba dealsList, y cuando el
       deal no estaba ahí —los de prueba nunca están— daba por hecho que no había token y
       generaba uno nuevo, pisando el link que el cliente ya tenía. Pasó de verdad el 27 ago
       con el 1202: un token vivo reemplazado por otro.
       Un token existente no se pisa nunca en modo callado, y a mano se pregunta. */
    const { data: enBase } = await supabase.from('deals').select('portal_token').eq('id', p.deal_id).maybeSingle();
    if (enBase && enBase.portal_token){
      const d0 = pjDealYa(p);
      if (d0) d0.portal_token = enBase.portal_token;
      else pjDeals.set(String(p.deal_id), { id: p.deal_id, portal_token: enBase.portal_token });
      if (callado) return true;
      if (!confirm('Este proyecto YA tiene link de portal.\n\nSi generás uno nuevo, el que el cliente tenga guardado deja de funcionar.\n\n¿Generar uno nuevo igual?')) return true;
    }
    const tok = ([...crypto.getRandomValues(new Uint8Array(16))].map((b) => b.toString(16).padStart(2, '0')).join(''));
    const { error } = await supabase.from('deals').update({ portal_token: tok }).eq('id', p.deal_id);
    if (error){ toast('⚠️ ' + error.message); return false; }
    const d = pjDealYa(p);
    if (d) d.portal_token = tok;
    else pjDeals.set(String(p.deal_id), { id: p.deal_id, portal_token: tok });
    if (!callado) toast('🔗 Link del portal generado');
    pjRenderPortal();
    return true;
  }

  async function pjSetStage(st){
    const p = pjCur; if (!p || p.stage === st) return;
    const patch = { stage: st };
    if (st === 'entregado' && !p.delivered_at) patch.delivered_at = new Date().toISOString();
    if (st !== 'entregado' && p.delivered_at) patch.delivered_at = null;
    const { error } = await supabase.from('projects').update(patch).eq('id', p.id);
    if (error){ toast('⚠️ ' + error.message); return; }
    Object.assign(p, patch);
    toast('🎬 ' + pjEtapa(st).l);
    pjRenderDetail();
  }

  /* ═══ GUARDA SOLO ═══
     Sebastián, 26 ago 2026: "si cambio, borro o hago algo pero no toco guardar, guardalo
     igual. Ahora el botón está súper escondido… una caca".
     Tenía razón en las dos: el botón vive al final de una pantalla larguísima, y un dato
     que se pierde por no bajar hasta ahí es un dato perdido. Ahora cualquier cambio se
     guarda solo un segundo después de que dejás de escribir, y al salir de la pantalla.
     El botón queda, pero como red: ya no es la única forma. */
  const PJ_CAMPOS = ['pj-shoot-start', 'pj-shoot-end', 'pj-delivery', 'pj-plan', 'pj-editor', 'pj-editor-email', 'pj-cliente-email',
    'pj-location', 'pj-script', 'pj-storyboard', 'pj-deliverable', 'pj-notes',
    'pj-script-text', 'pj-portal-note'];
  let pjAutoT = null, pjAutoOn = false;

  function pjAutoGuardar(){
    if (!pjCur) return;
    clearTimeout(pjAutoT);
    const n = $('pj-save-note'); if (n) n.textContent = '✏️ sin guardar…';
    /* Un segundo después de la última tecla: guardar en cada letra son cien escrituras
       por párrafo, y no guardar hasta el final es lo que rompía. */
    pjAutoT = setTimeout(() => pjSave({ auto: true }), 1000);
  }

  function pjAutoBind(){
    if (pjAutoOn) return; pjAutoOn = true;

    /* ── SE GUARDA TODO, SIEMPRE ──
       Antes cada campo se enganchaba por su id, de una lista escrita a mano: el que se
       agregara mañana quedaba afuera y no se guardaba hasta tocar el botón, sin que nada
       lo dijera. Ahora el listener está en el contenedor y cubre cualquier campo de la
       ficha, incluidos los que todavía no existen — los del plan de rodaje, los del crew,
       los que se dibujan al vuelo.
       Se excluyen los que tienen su propio guardado (el plan y las listas, que van a otra
       tabla) para no escribir dos veces la misma tecla.
       (Sebastián, 26 ago 2026: "que guarde siempre todo automático, no recién cuando toco
       el botón".) */
    const detalle = $('pj-detail');
    if (detalle){
      const propio = (el) => el.closest('#pj-plan-tabla, #pj-plan-listas') ||
        ['pj-plan-notas', 'pj-plan-nec', 'pj-plan-rie', 'pj-gia-ind', 'pj-plan-ind',
         'crew-q', 'pj-loc-rapida'].includes(el.id);
      const mira = (ev) => {
        const el = ev.target;
        if (!el || !/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)) return;
        if (el.type === 'button' || el.type === 'submit') return;
        if (propio(el)) return;
        pjAutoGuardar();
      };
      detalle.addEventListener('input', mira);
      detalle.addEventListener('change', mira);
    }

    /* La lista sigue, para los campos que viven fuera de #pj-detail. */
    PJ_CAMPOS.forEach((id) => {
      const el = $(id); if (!el) return;
      el.addEventListener('input', pjAutoGuardar);
      el.addEventListener('change', pjAutoGuardar);
    });
    /* Al salir de la ficha o cerrar la pestaña, lo pendiente se guarda YA: el timer de
       un segundo no llega si te vas antes. */
    const yaMismo = () => { if (pjAutoT){ clearTimeout(pjAutoT); pjAutoT = null; pjSave({ auto: true }); } };
    window.addEventListener('pagehide', yaMismo);
    document.addEventListener('visibilitychange', () => { if (document.hidden) yaMismo(); });
    pjAutoBind.yaMismo = yaMismo;
  }

  async function pjSave(opts){
    const p = pjCur; if (!p) return;
    const auto = !!(opts && opts.auto);
    clearTimeout(pjAutoT); pjAutoT = null;
    const patch = {
      shoot_start: $('pj-shoot-start').value || null,
      shoot_end: $('pj-shoot-end').value || null,
      delivery_due: $('pj-delivery').value || null,
      shooting_plan: $('pj-plan').value.trim() || null,
      editor: $('pj-editor').value.trim() || null,
      editor_email: $('pj-editor-email').value.trim().toLowerCase() || null,
      client_contact_email: $('pj-cliente-email').value.trim().toLowerCase() || null,
      location: $('pj-location').value.trim() || null,
      script_url: $('pj-script').value.trim() || null,
      storyboard_url: $('pj-storyboard').value.trim() || null,
      deliverable_url: $('pj-deliverable').value.trim() || null,
      notes: $('pj-notes').value.trim() || null,
      script_text: $('pj-script-text').value.trim() || null,
      portal_note: $('pj-portal-note').value.trim() || null,
      crew: Array.isArray(p.crew) && p.crew.length ? p.crew : null,
    };
    const { error } = await supabase.from('projects').update(patch).eq('id', p.id);
    if (error){ $('pj-save-note').textContent = '⚠️ ' + error.message; return; }
    Object.assign(p, patch);
    $('pj-save-note').textContent = '💾 Guardado';
    setTimeout(() => { const n = $('pj-save-note'); if (n) n.textContent = ''; }, 2500);
    /* Un re-render en medio de la escritura te saca el cursor del campo. Al guardar solo
       no se redibuja: los datos ya están donde tienen que estar. */
    if (!auto) pjRenderDetail();
  }

  function pjBind(){
    $('pj-back').addEventListener('click', () => {
      if (pjAutoBind.yaMismo) pjAutoBind.yaMismo();   // lo pendiente no se pierde al volver
      pjCur = null; pjUrl(null); pjRenderList();
    });
    $('pj-portal-ir').addEventListener('click', () => pjAbrirPortal($('pj-portal-ir')));
    $('pj-borrar').addEventListener('click', pjBorrar);
    $('pj-reload').addEventListener('click', pjLoad);
    $('pj-nuevo') && $('pj-nuevo').addEventListener('click', () => {
      const f = $('pj-form'); f.hidden = !f.hidden;
      if (f.hidden) return;
      /* La lista de personas se arma al abrir y no al cargar la pantalla: si se arma
         antes, una persona creada hace un minuto no aparece. */
      $('pjf-lead').innerHTML = '<option value="">— elegí a quién —</option>' +
        (allLeads || []).slice()
          .sort((a, b) => String(a.name || a.email || '').localeCompare(String(b.name || b.email || '')))
          .map((l) => '<option value="' + esc(String(l.id)) + '">' +
            esc((l.company ? l.company + ' · ' : '') + (l.name || l.email || '')) + '</option>').join('');
      $('pjf-title').focus();
    });
    $('pjf-cancel') && $('pjf-cancel').addEventListener('click', () => { $('pj-form').hidden = true; });
    $('pjf-save') && $('pjf-save').addEventListener('click', pjCrearManual);
    $('pj-test') && $('pj-test').addEventListener('click', pjCrearTest);
    $('pj-limpiar') && $('pj-limpiar').addEventListener('click', pjLimpiarPruebas);
    $('pjf-pdf-btn') && $('pjf-pdf-btn').addEventListener('click', () => $('pjf-pdf').click());
    $('pjf-pdf') && $('pjf-pdf').addEventListener('change', (e) => { pjLeerOferta(e.target.files[0]); e.target.value = ''; });
    $('pj-save').addEventListener('click', () => pjSave());
    pjAutoBind();
    /* El que monta se elige de Técnicos como cualquier otro del equipo. */
    $('pj-editor-sel').addEventListener('change', async (e) => {
      const sel = e.target; if (!pjCur) return;
      if (sel.value === '__nuevo__'){
        sel.value = pjCur.editor || '';
