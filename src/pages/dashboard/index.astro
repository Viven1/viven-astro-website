     contador deja pasar solo a la última. */
  let bxTurno = 0;
  async function bxEnsayo(){
    if (!bxDoc) return;
    const mio = ++bxTurno;
    const go = $('bx-go'); go.disabled = true;
    $('bx-modal').classList.add('calculando');
    $('bx-note').textContent = 'Calculando con bexio…';
    try {
      const { data, error } = await supabase.functions.invoke('bexio-invoice', {
        body: { tipo: bxDoc.tipo, id: bxDoc.id, pct: bxPct, dry_run: true,
                contact_id: (bxCand && bxCand !== 'nuevo') ? bxCand : undefined,
                crear_contacto: bxCand === 'nuevo', iva: bxIva || undefined } });
      if (mio !== bxTurno) return;                 // llegó tarde: ya elegiste otra cosa
      if (error) throw error;
      if (data && data.error) throw new Error(data.error);
      const total = Number(data.total_documento) || 0;
      bxPintarPcts(total);
      /* Candidatos: se pregunta ANTES de crear. Con Sonova aparecían cuatro contactos
         parecidos en bexio; crear uno nuevo a ciegas dejaba cinco y eso no se
         deshace con un botón. */
      if (data.necesita_decision){
        $('bx-ctx').innerHTML =
          '<div><i>💰</i><span><b>' + fmtChf(total) + '</b> el documento · a facturar <b>' + fmtChf(Number(data.importe_a_facturar) || 0) + '</b> (' + bxPct + '%)</span></div>' +
          '<div><i>👤</i><span>En bexio hay contactos parecidos. Elegí cuál usar:</span></div>';
        $('bx-cands').innerHTML = (data.candidatos || []).map((c) =>
          '<div class="bx-cand' + (String(bxCand) === String(c.id) ? ' on' : '') + '" data-cid="' + c.id + '"><span>👤</span><div><b>' + esc(c.nombre) + '</b><small>' + esc(c.mail || 'sin email') + '</small></div></div>').join('') +
          '<div class="bx-cand' + (bxCand === 'nuevo' ? ' on' : '') + '" data-cid="nuevo"><span>➕</span><div><b>Crear uno nuevo</b><small>' + esc([data.cliente.empresa, data.cliente.persona, data.cliente.email].filter(Boolean).join(' · ')) + '</small></div></div>';
        $('bx-cands').querySelectorAll('.bx-cand').forEach((el) => el.addEventListener('click', () => {
          bxCand = el.dataset.cid === 'nuevo' ? 'nuevo' : +el.dataset.cid;
          bxEnsayo();
        }));
        $('bx-note').textContent = bxCand ? 'Se crea como borrador. La factura la mandás vos desde bexio.' : 'Elegí un contacto para seguir.';
        go.disabled = !bxCand;
        return;
      }
      $('bx-cands').innerHTML = '';
      /* Con un parcial se crean DOS borradores: el acconto y el saldo. Se listan los
         dos acá para que no haya sorpresas — "si ponemos 50% que arme ambas, así
         mandamos una y la segunda ya queda preparada". */
      const facturas = data.facturas || [];
      $('bx-ctx').innerHTML =
        '<div><i>💰</i><span><b>' + fmtChf(total) + '</b> el documento</span></div>' +
        facturas.map((f, i) => '<div><i>' + (i === 0 ? '🧾' : '⏳') + '</i><span>' + esc(f.etiqueta) +
          ' — <b>' + fmtChf(Number(f.importe) || 0) + '</b>' + (i > 0 ? ' <span style="color:var(--muted-2)">(queda lista para después)</span>' : '') + '</span></div>').join('') +
        '<div><i>👤</i><span>' + (data.se_crearia_contacto
          ? 'Se crea el contacto en bexio: <b>' + esc([data.cliente.empresa, data.cliente.persona].filter(Boolean).join(' · ')) + '</b>'
          : 'Contacto de bexio #' + data.contacto_id) + '</span></div>' +
        /* El IVA a la vista: no es decorativo. En el catálogo de bexio conviven
           tasas al 8,1% y al 7,7% activas, así que ver cuál se va a usar antes de
           crear es la única forma de cazar el día que agarre la equivocada. */
        (data.iva ? '<div><i>🧮</i><span>IVA:' +
          '<span class="bx-iva">' +
            '<button type="button" data-iva="si"' + (data.iva.sin_iva ? '' : ' class="on"') + '>8,1%</button>' +
            '<button type="button" data-iva="no"' + (data.iva.sin_iva ? ' class="on"' : '') + (data.iva.hay_tasa_export ? '' : ' disabled title="bexio no tiene una tasa de exportación activa"') + '>sin IVA · extranjero</button>' +
          '</span>' +
          (data.iva.sugerido_por_pais ? '<br /><span style="color:var(--muted-2)">Sugerido: el contacto de bexio está fuera de Suiza</span>' : '') +
          '</span></div>' : '');
      /* La elección del IVA vive en el modal y no en la función: quién paga IVA y
         quién no lo sabe él, no nosotros — un cliente alemán factura sin IVA aunque
         la dirección diga otra cosa. La sugerencia por país es una ayuda, no la
         decisión. */
      $('bx-ctx').querySelectorAll('[data-iva]').forEach((b) => b.addEventListener('click', () => {
        if (b.disabled) return;
        bxIva = b.dataset.iva;
        $('bx-ctx').querySelectorAll('[data-iva]').forEach((x) => x.classList.toggle('on', x === b));
        bxEnsayo();
      }));
      $('bx-go').textContent = facturas.length > 1 ? '🧾 Crear los 2 borradores en bexio' : '🧾 Crear borrador en bexio';
      $('bx-note').textContent = facturas.length > 1
        ? 'Las dos quedan en borrador. Mandás la primera ahora y la segunda cuando entregues.'
        : 'Se crea como borrador. La factura la mandás vos desde bexio.';
      go.disabled = false;
    } catch (e) {
      if (mio !== bxTurno) return;
      $('bx-ctx').innerHTML = '<div><i>⚠️</i><span>' + esc(e.message || String(e)) + '</span></div>';
      go.disabled = true;
    } finally {
      if (mio === bxTurno) $('bx-modal').classList.remove('calculando');
    }
  }
  async function bxCrear(){
    if (!bxDoc) return;
    const go = $('bx-go'); go.disabled = true; const prev = go.textContent; go.textContent = '🧾 Creando…';
    try {
      const { data, error } = await supabase.functions.invoke('bexio-invoice', {
        body: { tipo: bxDoc.tipo, id: bxDoc.id, pct: bxPct,
                contact_id: (bxCand && bxCand !== 'nuevo') ? bxCand : undefined,
                crear_contacto: bxCand === 'nuevo', iva: bxIva || undefined } });
      if (error) throw error;
      if (!data || !data.ok) throw new Error((data && data.error) || 'no se pudo');
      bxCerrar();
      const cr = data.creadas || [];
      toast('🧾 ' + cr.map((c) => c.numero).join(' + ') + ' en bexio' + (data.contacto_creado ? ' · contacto nuevo' : ''));
      alert((cr.length > 1 ? 'Dos borradores creados en bexio:' : 'Borrador creado en bexio:') + '\n\n' +
