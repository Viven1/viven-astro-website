<!-- ============ LOGIN ============ -->
<script type="application/json" id="magnet-paths" set:html={JSON.stringify(MAGNET_PATHS)}></script>

<div id="login-view" class="dash-wrap" hidden>
  <div class="login-card">
    <svg class="logo-mark" aria-label="Viven"><use href="#viven-logo"/></svg>
    <p class="lc-sub">Dashboard</p>
    <p>Acceso privado. Entrá con tu cuenta de Viven.</p>
    <!-- Google primero y grande: es la puerta de todos los días y no hay contraseña
         que perder. Email+contraseña queda abajo como puerta de emergencia (si Google
         se cae, o para una cuenta sin Workspace). Quien manda sobre el acceso NO es
         esto: es public.user_roles (SQL 0127, is_member()). -->
    <button type="button" id="login-google" class="lg-google">
      <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.91c1.7-1.57 2.69-3.88 2.69-6.62Z"/>
        <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.91-2.26c-.81.54-1.84.86-3.05.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.34A8.99 8.99 0 0 0 9 18Z"/>
        <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.94H.96a8.99 8.99 0 0 0 0 8.12l3.01-2.34Z"/>
        <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.59C13.46.89 11.43 0 9 0A8.99 8.99 0 0 0 .96 4.94l3.01 2.34C4.68 5.16 6.66 3.58 9 3.58Z"/>
      </svg>
      Entrar con Google
    </button>
    <p id="login-google-err" class="muted-note" hidden style="color:#ff8b5e;margin:10px 0 0"></p>
    <div class="lg-sep"><span>o con email y contraseña</span></div>
    <form id="login-form" class="lead-form">
      <div class="field"><label>Email</label><input type="email" name="email" required autocomplete="username" /></div>
      <div class="field"><label>Contraseña</label><input type="password" name="password" required autocomplete="current-password" /></div>
      <button type="submit">Entrar</button>
      <p class="form-error">Login incorrecto — revisa email y contraseña.</p>
      <!-- Aviso de sesión vencida: lo enciende onAuthStateChange cuando el token
           muere mientras se trabaja (antes las queries fallaban calladas y la
           pantalla quedaba muerta, sin mandar a nadie al login). -->
      <p id="login-expired" class="muted-note" hidden style="border:1px solid rgba(240,192,96,.45);background:rgba(240,192,96,.10);color:#f0c060;border-radius:10px;padding:9px 12px;margin:10px 0 0">⏱ Se venció la sesión — volvé a entrar.</p>
      <p style="margin:12px 0 0"><button type="button" id="login-forgot" style="background:none;border:0;padding:0;color:var(--acid);font:600 13px Inter,sans-serif;text-decoration:underline;text-underline-offset:3px;cursor:pointer">¿Olvidaste tu contraseña?</button></p>
      <p id="login-forgot-msg" class="muted-note" hidden style="margin:8px 0 0"></p>
    </form>
  </div>
</div>

<!-- ============ DASHBOARD ============ -->
<div id="dash-view" class="dash-wrap" hidden>
  <div class="dash-head">
    <div>
      <button class="dash-brand" id="dash-brand-btn" type="button" title="Ir a Hoy"><svg class="logo-mark" aria-label="Viven"><use href="#viven-logo"/></svg><span class="db-sub">Dashboard</span></button>
      <p class="dash-sub" id="updated-at">Últimos 30 días</p>
    </div>
    <div class="dash-actions" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
      <!-- Búsqueda global ⌘K: pastilla-affordance (abre el command palette al click) -->
      <button class="vv-search" id="vv-search-btn" type="button" title="Buscar persona, empresa, oferta… (⌘K)" aria-label="Buscar">
        <span class="vv-search-ic">🔍</span><span class="vv-search-t">Buscar…</span><kbd class="vv-kbd">⌘K</kbd>
      </button>
      <!-- ➕ Crear ▾ global: rutea a los flujos "nuevo" ya existentes de cada entidad -->
      <div class="vv-create" id="vv-create">
        <button class="btn btn-primary small" id="vv-create-btn" type="button" aria-haspopup="menu" aria-expanded="false">➕ Crear ▾</button>
        <div class="vv-create-menu" id="vv-create-menu" role="menu" hidden>
          <button type="button" role="menuitem" data-create="persona">👤 Persona</button>
          <button type="button" role="menuitem" data-create="empresa">🏢 Empresa</button>
          <button type="button" role="menuitem" data-create="deal">🤝 Deal</button>
          <button type="button" role="menuitem" data-create="oferta">🧾 Oferta</button>
          <button type="button" role="menuitem" data-create="propuesta">🌐 Propuesta</button>
        </div>
      </div>
      <button class="bell-btn" id="theme-btn" type="button" title="Cambiar tema (oscuro/claro)" aria-label="Cambiar tema">◐</button>
      <!-- Si no hay suscripción push, se ve ACÁ, no escondido dentro del panel de la
           campana. El 13 ago 2026 Sebastián estuvo sin recibir un solo lead: el permiso
           estaba concedido, la suscripción no existía, y nada lo decía. -->
      <button class="bell-btn" id="push-warn" type="button" hidden title="No estás recibiendo notificaciones en este dispositivo — tocá para activarlas" aria-label="Activar notificaciones" style="width:auto;padding:0 11px;gap:6px;border-color:#ff8b5e;color:#ff8b5e;font-size:12px;font-weight:600">🔕 Sin avisos</button>
      <div class="bell-wrap">
        <button class="bell-btn" id="bell-btn" type="button" title="Tareas y avisos" aria-label="Tareas y avisos">🔔<span class="bell-badge" id="bell-badge" hidden>0</span></button>
        <div class="bell-panel" id="bell-panel" hidden>
          <div class="bell-h"><span>🔔 Tareas y avisos</span><span style="display:flex;gap:8px;align-items:center"><button class="bell-pushbtn" id="bell-push" type="button" title="Recibir notificaciones en este dispositivo aunque la app esté cerrada">📲 Activar push</button><button class="bell-x" id="bell-x" type="button" aria-label="Cerrar">✕</button></span></div>
          <div id="bell-list"><p class="muted-note" style="padding:14px">Cargando…</p></div>
        </div>
      </div>
      <button class="btn btn-primary small" id="app-update-btn" type="button" hidden title="Hay una versión nueva de la app instalada — tocá para cargarla">🔄 Nueva versión</button>
      <button class="btn btn-ghost small" id="refresh-btn" type="button">↻ Actualizar</button>
      <button class="btn btn-ghost small" id="logout-btn" type="button">Salir</button>
    </div>
  </div>

  <div class="dash-body">
    <aside class="dash-side">
