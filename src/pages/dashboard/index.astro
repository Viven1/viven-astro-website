          '<td class="lt-num" style="color:' + sc.tier.c + ';white-space:nowrap" title="' + esc(sc.factors.join('\n')) + '">' + sc.tier.t + ' · ' + sc.score + '</td>' +
          '<td class="lt-num"><button type="button" class="btn btn-ghost small danger ab-lead-del" data-lead="' + l.id + '" title="Borrar este lead (falso/test) — mismo borrado definitivo que en Personas; el conteo de la variante baja">🗑</button></td></tr>';
      }).join('') + '</tbody></table></div></div>';
