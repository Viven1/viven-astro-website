  /* ¿La factura es el papel de un costo que YA está presupuestado, o es un costo nuevo?
     Esta era la trampa: antes siempre insertaba una línea nueva, así que subir la factura
     de alguien que ya estaba en el paquete firmado contaba su costo DOS VECES y el margen
     se hundía sin motivo. (Sebastián, 26 ago 2026: "¿la sincroniza con la persona en el
     proyecto o cuenta el costo doble?".)
     Ahora busca a quién podría corresponder y pregunta. Solo se crea una línea nueva si
     él dice que es un costo nuevo. */
  function pjCostosCandidatos(b){
    const norm = (x) => String(x || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
    const prov = norm(b.supplier);
    const palabras = prov.split(' ').filter((w) => w.length > 3);
    const imp = Number(b.net ?? b.gross) || 0;
    const conFactura = new Set(pjBills.filter((x) => x.cost_id && String(x.id) !== String(b.id)).map((x) => String(x.cost_id)));
    return pjCostos
      .filter((c) => !conFactura.has(String(c.id)))
      .map((c) => {
        const txt = norm(c.person) + ' ' + norm(c.concept);
        // el nombre del proveedor pesa más que el importe: dos líneas pueden costar igual
        let pts = 0;
        if (prov && (txt.includes(prov) || palabras.some((w) => txt.includes(w)))) pts += 10;
        const tot = pjCostoTotal(c);
        if (imp && tot && Math.abs(tot - imp) / Math.max(tot, imp) < 0.02) pts += 6;
        else if (imp && tot && Math.abs(tot - imp) / Math.max(tot, imp) < 0.15) pts += 2;
        return { c, pts, tot };
      })
      .filter((x) => x.pts > 0)
      .sort((a2, b2) => b2.pts - a2.pts)
      .slice(0, 6);
  }

  async function pjBillACosto(id){
    const b = pjBills.find((x) => String(x.id) === String(id)); if (!b) return;
    const p = pjCur;
    const imp = Number(b.net ?? b.gross) || 0;
    const cands = pjCostosCandidatos(b);

    if (cands.length){
      const lista = cands.map((x, i) => (i + 1) + ') ' + (x.c.person ? x.c.person + ' — ' : '') +
        (x.c.concept || 'línea') + ' · presupuestado ' + pjCHF(x.tot)).join('\n');
      const r = prompt('Esta factura de ' + (b.supplier || '—') + ' por ' + pjCHF(imp) +
        '\n\n¿Es el papel de una línea que ya está en el proyecto? Si lo es, elegila y NO se suma de nuevo:\n\n' + lista +
        '\n\nEscribí el número, o "nueva" si es un costo que todavía no estaba.', '1');
      if (r === null) return;
      if (!/^nueva$/i.test(r.trim())){
        const el = cands[+r.trim() - 1];
        if (!el){ toast('No entendí cuál'); return; }
        /* Enganchar la factura a la línea. Y si el importe real difiere del
           presupuestado, ofrecer corregirlo: para eso existe el "margen real". */
        const patch = { cost_id: el.c.id, estado: 'revisada' };
        const dif = imp - el.tot;
        if (imp && Math.abs(dif) >= 1 &&
            confirm('La línea está presupuestada en ' + pjCHF(el.tot) + ' y la factura dice ' + pjCHF(imp) +
              ' (' + (dif > 0 ? '+' : '') + pjCHF(dif) + ').\n\n¿Actualizo la línea al importe real de la factura?')){
          const { data: cu, error: eu } = await supabase.from('project_costs')
            .update({ qty: 1, unit_cost: imp }).eq('id', el.c.id).select().single();
          if (eu){ toast('⚠️ ' + eu.message); return; }
          const ix = pjCostos.findIndex((c) => String(c.id) === String(el.c.id));
          if (ix >= 0) pjCostos[ix] = cu;
        }
        const { error: e3 } = await supabase.from('project_bills').update(patch).eq('id', b.id);
        if (e3){ toast('⚠️ ' + e3.message); return; }
        b.cost_id = el.c.id; b.estado = 'revisada';
        toast('📎 Factura enganchada a "' + (el.c.concept || 'la línea') + '" — no se sumó de nuevo');
        pjCostosRender(); pjBillsRender();
        return;
      }
    }

    const concepto = (b.extracted && b.extracted.concepto) || b.supplier || 'Factura';
    const { data: c, error } = await supabase.from('project_costs').insert({
      project_id: p.id, concept: String(concepto).slice(0, 120), person: b.supplier || null,
      kind: 'crew', qty: 1, unit_cost: imp, sort: pjCostos.length + 100,
      notes: b.vendor_ref ? 'Factura ' + b.vendor_ref : null,
    }).select().single();
    if (error){ toast('⚠️ ' + error.message); return; }
    const { error: e2 } = await supabase.from('project_bills').update({ cost_id: c.id, estado: 'revisada' }).eq('id', b.id);
    if (e2){ toast('⚠️ ' + e2.message); return; }
    b.cost_id = c.id; b.estado = 'revisada';
    pjCostos.push(c);
    toast('💸 Línea de costo NUEVA — ' + pjCHF(c.unit_cost) + ' que no estaba presupuestado');
    pjCostosRender(); pjBillsRender();
  }

  async function pjBillABexio(id){
    const b = pjBills.find((x) => String(x.id) === String(id)); if (!b) return;
    if (!confirm('¿Mandar esta factura a bexio?\n\n' + (b.supplier || '—') + ' · ' + pjCHF(b.gross) +
      '\n\nEntra como BORRADOR de factura de proveedor: no se contabiliza sola, la revisás y la aprobás en bexio.')) return;
    const llamar = (extra) => supabase.functions.invoke('bexio-bill', { body: { bill_id: b.id, ...extra } });
    try {
      let { data, error } = await llamar({});
      if (error) throw new Error(error.message);
      /* bexio ya tiene cuatro contactos "Sonova" por crear a ciegas: si hay varios
         candidatos —o ninguno— lo decide una persona, no la función. */
      if (data && data.necesita_eleccion){
        const cands = data.candidatos || [];
        let elegido = null;
        if (cands.length){
          const txt = cands.map((c, i) => (i + 1) + ') ' + c.nombre + (c.mail ? ' · ' + c.mail : '')).join('\n');
          const r = prompt('En bexio hay ' + cands.length + ' contactos parecidos a "' + (b.supplier || '') + '":\n\n' + txt +
            '\n\nEscribí el número del que corresponde, o "nuevo" para crearlo.');
          if (r === null) return;
          if (/^\d+$/.test(r.trim()) && cands[+r.trim() - 1]) elegido = cands[+r.trim() - 1].id;
          else if (!/^nuevo$/i.test(r.trim())){ toast('No entendí la respuesta'); return; }
        } else if (!confirm('En bexio no hay ningún contacto que se llame "' + (b.supplier || '') + '".\n\n¿Lo creo?')) return;
        ({ data, error } = await llamar(elegido ? { supplier_id: elegido } : { crear_proveedor: true }));
        if (error) throw new Error(error.message);
      }
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
      b.estado = 'en_bexio'; b.bexio_id = String(data.bexio_id); b.bexio_no = data.bexio_no;
      toast('🧾 En bexio como borrador' + (data.bexio_no ? ' · ' + data.bexio_no : '') +
        (data.proveedor_creado ? ' · proveedor creado' : ''));
      pjBillsRender();
    } catch (e){ toast('⚠️ ' + (e.message || e)); }
  }

  async function pjBillQuitar(id){
    const b = pjBills.find((x) => String(x.id) === String(id)); if (!b) return;
    if (!confirm('¿Quitar "' + (b.supplier || b.file_name) + '" del proyecto?\n\nEl archivo se borra. Si ya está en bexio, allá queda.')) return;
    await supabase.storage.from('project-bills').remove([b.file_path]);
    const { error } = await supabase.from('project_bills').delete().eq('id', b.id);
    if (error){ toast('⚠️ ' + error.message); return; }
    pjBills = pjBills.filter((x) => String(x.id) !== String(id));
    pjBillsRender();
  }

  /* ---------- DESGLOSE DE GUIÓN (ai-breakdown, SQL 0155) ----------
     Del texto del guión salen escenas, todo lo que hay que conseguir, la lista de
     planos y una propuesta de jornadas — como en Maestro. Lo más valioso no son las
     escenas: son los AVISOS, que es donde aparece lo que el guión pide y el
     presupuesto no tiene. En la prueba con el guión de Sonova encontró que el drone y
     el lente macro no estaban presupuestados, y que si la nieta es menor hace falta
     permiso de trabajo infantil. */
  const PJ_NEC_LBL = {
    personajes: '🎭 Personajes', locaciones: '📍 Locaciones', props: '🎬 Props',
    vestuario: '👔 Vestuario', arte: '🖼 Arte', maquillaje: '💄 Maquillaje',
    sonido: '🎙 Sonido', equipo_especial: '🎥 Equipo especial', post: '✂️ Post', permisos: '📋 Permisos',
  };

  /* ═══ Escribir guiones con IA ═══
     De a TRES, y las tres se guardan. Un guión solo no se puede juzgar —se lee y parece
     bien, o parece mal, y no hay con qué comparar. Tres ángulos distintos del mismo brief
     convierten "¿está bien?" en "¿cuál?", que es una pregunta que sí se contesta.
     El elegido cae en el guión del proyecto, y de ahí sigue el desglose que ya existe:
     escenas, todo lo que hay que conseguir y las jornadas. Por eso no hay un segundo
     generador de planes de rodaje.
     (Sebastián, 26 ago 2026: "¿cómo hago para generar guiones?" y "solo yo, y puedo
     decidir cuál mandar, o mandar los tres si quiero".) */
  let pjGuiones = [];

  async function pjGuionesLoad(){
    const p = pjCur; if (!p) return;
    const { data, error } = await supabase.from('project_scripts')
      .select('*').eq('project_id', p.id).eq('tipo', 'guion')
      .order('created_at', { ascending: false }).order('id');
    pjGuiones = error ? [] : (data || []);
    pjGuionesRender();
    pjRenderSteps();
  }

  /* El cuerpo como tabla: un A/V script es dos columnas —lo que se ve y lo que se
     escucha— y aplanarlo a párrafo le saca justamente lo que lo hace legible. */
  function pjGuionTabla(g){
    const filas = Array.isArray(g.cuerpo) ? g.cuerpo : [];
    if (!filas.length) return '';
    return '<div class="pj-gtxt"><table>' + filas.map((f) => g.formato === 'cine'
      ? '<tr><td colspan="2"><div class="enc">' + esc(f.encabezado || '') + '</div>' +
          (f.accion ? '<div>' + esc(f.accion) + '</div>' : '') +
          (f.dialogo ? '<div class="dlg">' + esc(f.dialogo) + '</div>' : '') + '</td></tr>'
      : '<tr><td class="tc">' + esc(f.tc || '') + '</td><td>' + esc(f.video || '') +
          (f.audio ? '<div class="au">🔊 ' + esc(f.audio) + '</div>' : '') + '</td></tr>'
    ).join('') + '</table></div>';
  }

  /* Texto plano: es lo que entiende el desglose, lo que se pega en un email y lo que se
     puede leer sin la app. */
  function pjGuionTexto(g){
    const filas = Array.isArray(g.cuerpo) ? g.cuerpo : [];
    const cab = [(g.titulo || g.angulo || 'Guión'),
                 g.premisa ? '(' + g.premisa + ')' : '',
                 g.duracion_seg ? '~' + g.duracion_seg + ' s' : ''].filter(Boolean).join('\n');
    const cuerpo = filas.map((f) => g.formato === 'cine'
      ? [f.encabezado || '', f.accion || '', f.dialogo ? '\n' + f.dialogo : ''].filter(Boolean).join('\n')
      : (f.tc ? '[' + f.tc + '] ' : '') + 'IMAGEN: ' + (f.video || '') + (f.audio ? '\nAUDIO: ' + f.audio : '')
    ).join('\n\n');
    return cab + '\n\n' + cuerpo;
  }

  function pjGuionesRender(){
    const box = $('pj-guiones'); if (!box) return;
    if (!pjGuiones.length){ box.innerHTML = ''; return; }
    /* Solo la última tanda: las viejas ya cumplieron y tres tarjetas se comparan, nueve no. */
    const tanda = pjGuiones[0].tanda;
    const g3 = pjGuiones.filter((g) => String(g.tanda) === String(tanda));
    const viejas = pjGuiones.length - g3.length;
    box.innerHTML = '<div class="pj-g3">' + g3.map((g) =>
      '<div class="pj-g' + (g.elegido ? ' elegido' : '') + '">' +
        '<div class="ang">' + (g.elegido ? '★ ' : '') + esc(g.angulo || 'Sin nombre') + '</div>' +
        (g.premisa ? '<p class="pre">' + esc(g.premisa) + '</p>' : '') +
        '<div class="met">' + esc(g.titulo || '') + (g.duracion_seg ? ' · ~' + g.duracion_seg + ' s' : '') +
          ' · ' + (g.formato === 'cine' ? 'cinematográfico' : 'A/V') +
          (g.sent_at ? ' · 📤 enviado ' + fmtDMY(g.sent_at) : '') + '</div>' +
        pjGuionTabla(g) +
        '<div class="acc">' +
          '<button class="btn btn-ghost small" data-gusar="' + g.id + '">' + (g.elegido ? '★ Es el elegido' : 'Usar este') + '</button>' +
          '<button class="btn btn-ghost small" data-gpdf="' + g.id + '" title="Se abre listo para imprimir o guardar como PDF">📄 PDF</button>' +
          '<button class="btn btn-ghost small" data-gcopy="' + g.id + '">📋 Copiar</button>' +
          '<button class="pj-crew-x" data-gdel="' + g.id + '" type="button">✕</button>' +
        '</div>' +
      '</div>').join('') + '</div>' +
      (viejas ? '<p class="muted-note" style="margin:-6px 0 14px">Hay ' + viejas + ' guiones de tandas anteriores. Se guardan, pero no se muestran: tres se comparan, nueve no.</p>' : '');

    box.querySelectorAll('[data-gusar]').forEach((b) => b.addEventListener('click', () => pjGuionElegir(b.dataset.gusar)));
    box.querySelectorAll('[data-gpdf]').forEach((b) => b.addEventListener('click', () => pjGuionPDF(b.dataset.gpdf)));
    box.querySelectorAll('[data-gcopy]').forEach((b) => b.addEventListener('click', () => {
      const g = pjGuiones.find((x) => String(x.id) === String(b.dataset.gcopy)); if (!g) return;
      navigator.clipboard.writeText(pjGuionTexto(g)).then(() => toast('📋 Copiado'));
    }));
    box.querySelectorAll('[data-gdel]').forEach((b) => b.addEventListener('click', () => pjGuionBorrar(b.dataset.gdel)));
  }

  async function pjGuionGenerar(){
    const p = pjCur; if (!p) return;
    const btn = $('pj-gia-go'), prev = btn.textContent, nota = $('pj-gia-note');
    btn.disabled = true; btn.textContent = '✍️ Escribiendo…';
    nota.textContent = 'Tres ángulos distintos del mismo brief. Tarda entre 30 y 60 segundos.';
    try {
      const { data, error } = await supabase.functions.invoke('ai-guion', { body: {
        project_id: p.id,
        formato: $('pj-gia-fmt').value,
        duracion_seg: Number($('pj-gia-dur').value),
        indicaciones: $('pj-gia-ind').value.trim() || undefined,
      } });
      if (error) throw new Error(error.message);
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
      /* Con qué material trabajó, a la vista. Un guión escrito solo con el título del
         proyecto y un guión escrito con el brief del cliente se leen igual de bien y no
         valen lo mismo; sin decirlo, la única forma de notarlo es leerlo entero. */
      nota.textContent = (data.fuentes || []).length
        ? 'Escrito con: ' + data.fuentes.join(' + ') + '.'
        : '';
      await pjGuionesLoad();
      toast('✍️ ' + (data.guiones || []).length + ' guiones listos — elegí uno');
    } catch (e){
      nota.textContent = '⚠️ ' + (e.message || e);
    } finally { btn.disabled = false; btn.textContent = prev; }
  }

  /* Elegir es una decisión interna: con cuál seguimos. Vuelca el texto al guión del
     proyecto —de ahí sale el desglose— sin pisar nada a ciegas si ya había otro escrito. */
  async function pjGuionElegir(id){
    const p = pjCur; if (!p) return;
    const g = pjGuiones.find((x) => String(x.id) === String(id)); if (!g) return;
    const ta = $('pj-script-text');
    const habia = (ta.value || '').trim();
    const texto = pjGuionTexto(g);
    if (habia && habia !== texto &&
        !confirm('El proyecto ya tiene un guión escrito.\n\n¿Reemplazarlo por «' + (g.angulo || '') + '»?')) return;

    /* Uno solo elegido: el índice único de la base lo exige, y con dos elegidos el
       desglose no sabría de cuál sale. */
    await supabase.from('project_scripts').update({ elegido: false })
      .eq('project_id', p.id).eq('tipo', 'guion').eq('elegido', true);
    const { error } = await supabase.from('project_scripts').update({ elegido: true }).eq('id', id);
    if (error){ toast(error.message); return; }
    pjGuiones.forEach((x) => { x.elegido = String(x.id) === String(id); });

    ta.value = texto;
    const { error: e2 } = await supabase.from('projects').update({ script_text: texto }).eq('id', p.id);
    if (e2){ toast(e2.message); return; }
    p.script_text = texto;
    pjGuionesRender();
    pjRenderDesglose();
    $('pj-guion-blq').open = true;
    toast('★ Listo — ahora tocá «Desglosar con IA» para sacar escenas y jornadas');
  }

  async function pjGuionBorrar(id){
    const g = pjGuiones.find((x) => String(x.id) === String(id)); if (!g) return;
    if (!confirm('¿Borrar «' + (g.angulo || 'este guión') + '»?')) return;
    const { error } = await supabase.from('project_scripts').delete().eq('id', id);
    if (error){ toast(error.message); return; }
    pjGuiones = pjGuiones.filter((x) => String(x.id) !== String(id));
    pjGuionesRender();
  }

  /* ── El PDF del guion ──
     Sin librería: una ventana con el guion maquetado y el diálogo de imprimir del
     navegador, que ya sabe guardar como PDF.

     Y CON MARCA. Un guion se imprime, se lleva al set y se lo pasa a gente que no
     trabaja con nosotros —el técnico, el cliente, un proveedor— así que es un documento
     de VIVEN que circula solo. El logo va en SVG: acá sí se puede (es un navegador, no
     un cliente de correo) y en papel se imprime nítido a cualquier tamaño.
     Fondo blanco y negro sobre blanco a propósito: esto se imprime.
     (Sebastián, 26 ago 2026: "el PDF que genera el guion no tiene branding nuestro, nada
     sale nunca sin branding".) */
  function pjGuionPDF(id){
    const p = pjCur; const g = pjGuiones.find((x) => String(x.id) === String(id));
    if (!p || !g) return;
    const filas = Array.isArray(g.cuerpo) ? g.cuerpo : [];
    /* Los [FALTA: …] se marcan. Son los datos que el cliente todavía no dio, y en un
       guion impreso pasan como texto normal — que es cómo se llega al set con un hueco
       que nadie vio. En papel salen con fondo, así que también se ven en blanco y negro. */
    const falta = (t) => esc(t || '').replace(/\[FALTA:([^\]]*)\]/g,
      (m, x) => '<span class="falta">FALTA:' + x + '</span>');
    const cuerpo = g.formato === 'cine'
      ? filas.map((f) => '<div class="esc"><h3>' + esc(f.encabezado || '') + '</h3>' +
          (f.accion ? '<p>' + falta(f.accion) + '</p>' : '') +
          (f.dialogo ? '<pre class="dlg">' + falta(f.dialogo) + '</pre>' : '') + '</div>').join('')
      : '<table><thead><tr><th class="tc">TC</th><th>Imagen</th><th>Audio</th></tr></thead><tbody>' +
        filas.map((f) => '<tr><td class="tc">' + (f.tc ? '<span>' + esc(f.tc) + '</span>' : '') + '</td><td>' + falta(f.video) +
          '</td><td class="au">' + falta(f.audio) + '</td></tr>').join('') + '</tbody></table>';
    const w = window.open('', '_blank');
    if (!w){ toast('El navegador bloqueó la ventana. Permitila y probá de nuevo.'); return; }
    const hoy = new Date().toLocaleDateString('de-CH');
    const pieTxt = [(p.ref ? '#' + p.ref : ''), esc(p.title || ''), 'VIVEN AG · Zürich'].filter(Boolean).join('  ·  ');
    w.document.write('<!doctype html><html lang="es"><head><meta charset="utf-8">' +
      '<title>' + esc((p.ref ? p.ref + ' ' : '') + (g.titulo || g.angulo || 'Guion')) + '</title><style>' +
      /* Los colores de VIVEN, no un documento genérico. En papel el acid (#ddf98f) no
         sirve para texto —es un verde limón sobre blanco— pero sí como FONDO con el navy
         encima: así la marca está en las cabeceras y los minutos, que es donde el ojo
         vuelve, y el guion sigue siendo legible fotocopiado.
         (Sebastián, 26 ago 2026: "sale cortado, le faltan nuestros colores".) */
      /* Las tipografías de la marca, las mismas que la oferta: Space Grotesk para los
         títulos, Inter para el texto. El guion salía en Georgia y Helvetica —correcto para
         un documento cualquiera, pero no es VIVEN, y estos dos papeles le llegan al mismo
         cliente con una semana de diferencia. */
      '@import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap");' +
      ':root{--navy:#1b2c46;--acid:#ddf98f;--tinta:#1a2230;--gris:#6b7896;--linea:#e3e7ee;' +
        '--display:"Space Grotesk",Helvetica,Arial,sans-serif;--texto:Inter,-apple-system,Helvetica,Arial,sans-serif}' +
      /* En PANTALLA se ve como una hoja: fondo gris, papel centrado con sombra. Antes el
         contenido arrancaba pegado al borde de la ventana y llegaba hasta el otro lado
         —"sale cortado"— porque los márgenes solo existían en @page, que es cosa de la
         impresión. */
      'body{font:10.5pt/1.62 var(--texto);color:var(--tinta);' +
        'background:#e6e9ef;margin:0;padding:26px 16px 60px}' +
      '.hoja{max-width:186mm;margin:0 auto;background:#fff;padding:22mm 18mm;' +
        'box-shadow:0 10px 40px -12px rgba(0,0,0,.35);border-radius:2px}' +
      '@page{margin:18mm 16mm 20mm;' +
        '@bottom-left{content:"' + pieTxt.replace(/"/g, "'") + '";' +
        'font:8pt Inter,Helvetica,Arial,sans-serif;color:#8a94a8}' +
        '@bottom-right{content:counter(page) " / " counter(pages);font:8pt Inter,Helvetica,Arial,sans-serif;color:#8a94a8}}' +

      'header{display:flex;align-items:center;justify-content:space-between;gap:20px;' +
        'border-bottom:3px solid var(--navy);padding-bottom:11px;margin-bottom:20px}' +
      /* El logo con ancho fijo y alto automático: con solo `height` el navegador puede
         estirarlo antes de leer el viewBox del SVG, y sale deformado en el PDF. */
      'header img{width:96px;height:auto;display:block}' +
      '.hd-r{text-align:right;font:8.5pt/1.5 var(--texto);color:var(--gris);' +
        'letter-spacing:.07em;text-transform:uppercase}' +
      'h1{font:700 21pt/1.16 var(--display);margin:0 0 7px;letter-spacing:-.02em;color:var(--navy)}' +
      '.meta{font:600 8.5pt/1.5 var(--texto);color:var(--gris);letter-spacing:.09em;' +
        'text-transform:uppercase;margin:0 0 5px}' +
      '.prem{font:italic 11pt/1.6 var(--texto);color:#3d4757;margin:15px 0 26px;padding:10px 0 10px 15px;' +
        'border-left:4px solid var(--acid);background:linear-gradient(90deg,rgba(221,249,143,.22),transparent 60%)}' +
      'table{width:100%;border-collapse:collapse;font:10.5pt/1.55 var(--texto)}' +
      /* La cabecera en la marca: fondo acid, texto navy. Es la fila que dice de qué va
         cada columna y la que hace que el documento se reconozca de lejos. */
      'thead th{text-align:left;font:700 8pt var(--display);letter-spacing:.12em;text-transform:uppercase;' +
        'color:var(--navy);background:var(--acid);padding:7px 10px;border:0}' +
      'thead th:first-child{border-radius:4px 0 0 4px}' +
      'thead th:last-child{border-radius:0 4px 4px 0}' +
      'td{vertical-align:top;padding:11px 10px;border-bottom:1px solid var(--linea)}' +
      /* El minuto, en un chip: es lo que se busca con el dedo cuando se lee en el set. */
      'td.tc,th.tc{width:56px;white-space:nowrap}' +
      'td.tc{font:700 9pt var(--display);color:var(--navy);font-variant-numeric:tabular-nums}' +
      'td.tc span{background:rgba(221,249,143,.45);border-radius:4px;padding:2px 6px;display:inline-block}' +
      'td.au{color:#3d4757;width:38%;white-space:pre-line}' +
      '.falta{background:#fff3cd;border-bottom:1.5px solid #b8860b;padding:0 3px;' +
        'font-weight:700;font-size:.92em;letter-spacing:.02em}' +
      'tr{break-inside:avoid}' +
      '.esc{break-inside:avoid;margin:0 0 20px}' +
      '.esc h3{font:700 10.5pt var(--display);letter-spacing:.08em;margin:0 0 7px;' +
        'color:var(--navy);padding:5px 10px;background:rgba(221,249,143,.35);border-radius:4px}' +
      '.esc p{margin:0 0 9px}' +
      '.dlg{font:10.5pt/1.5 var(--texto);white-space:pre-wrap;margin:0 0 9px 20mm}' +
      'footer{margin-top:30px;border-top:3px solid var(--acid);padding-top:11px;' +
        'font:8.5pt/1.6 var(--texto);color:var(--gris)}' +
      'footer b{color:var(--navy)}' +
      /* Chrome no imprime fondos si el usuario no lo tilda; esto lo pide por defecto y
         sin él la cabecera acid sale en blanco. */
      'body{-webkit-print-color-adjust:exact;print-color-adjust:exact}' +
      '.barra{position:sticky;top:0;background:var(--navy);color:#fff;padding:9px 14px;' +
        'border-radius:9px;margin:0 auto 18px;max-width:186mm;font:13px var(--texto);' +
        'display:flex;gap:12px;align-items:center;justify-content:space-between}' +
      '.barra button{background:var(--acid);color:#1c2508;border:0;border-radius:100px;' +
        'font:700 13px var(--texto);padding:8px 18px;cursor:pointer}' +
      /* LAS REGLAS DE IMPRESIÓN VAN ÚLTIMAS, Y CON !important.
         Estaban en el medio del CSS, y `.barra` —que viene después— define `display:flex`.
         Misma especificidad, gana la última: la barra de "Guardar como PDF" salía IMPRESA
         adentro del PDF. Lo mismo le puede pasar a cualquier `.noprint` que se agregue
         mañana, así que el bloque se queda al final y la regla se blinda.
         (Sebastián, 26 ago 2026: "eso de guardar o imprimir no puede aparecer en el PDF".) */
      '@media print{' +
        'body{background:#fff;padding:0}' +
        '.hoja{max-width:none;margin:0;padding:0;box-shadow:none;border-radius:0}' +
        '.noprint,.barra{display:none !important}' +
      '}' +
      '</style></head><body>' +
      /* Un botón propio: el diálogo de imprimir se abre solo, pero si se cierra por error
         no había forma de volver a abrirlo sin cerrar la ventana y empezar de nuevo. */
      '<div class="barra noprint"><span>Guardá como PDF desde el diálogo de imprimir.</span>' +
        '<button onclick="window.print()">Imprimir / Guardar PDF</button></div>' +
      '<div class="hoja">' +
      '<header><img src="' + location.origin + '/assets/brand/viven-logo-navy.svg" alt="VIVEN" />' +
        '<div class="hd-r">' + (p.ref ? 'Proyecto ' + esc(p.ref) + '<br>' : '') + esc(hoy) + '</div></header>' +
      '<p class="meta">' + esc([p.title || '', p.client_contact || ''].filter(Boolean).join(' · ')) + '</p>' +
      '<h1>' + esc(g.titulo || g.angulo || 'Guion') + '</h1>' +
      '<p class="meta">' + (g.duracion_seg ? '~' + g.duracion_seg + ' s · ' : '') +
        (g.formato === 'cine' ? 'guion cinematográfico' : 'guion A/V') +
        (g.angulo && g.titulo ? ' · ' + esc(g.angulo) : '') + '</p>' +
      (g.premisa ? '<p class="prem">' + esc(g.premisa) + '</p>' : '') +
      cuerpo +
      '<footer><b>VIVEN AG</b> · Zürich · viven.ch<br>' +
        'Borrador de trabajo — no es la versión final. ' +
        (p.ref ? 'Referencia del proyecto: ' + esc(p.ref) + '.' : '') + '</footer>' +
      '</div></body></html>');
    w.document.close();
    /* Se espera a que el logo cargue: si se imprime antes, sale la primera página sin
       marca y no hay forma de saberlo hasta ver el PDF. */
    const dale = () => { try { w.focus(); w.print(); } catch (e){ } };
    const img = w.document.querySelector('header img');
    if (img && !img.complete){ img.onload = dale; img.onerror = dale; setTimeout(dale, 2500); }
    else setTimeout(dale, 350);
  }

  /* ═══ Plan de rodaje ═══
     Tres cosas que Maestro ya tenía resueltas y acá faltaban:

     1. Nada se escribe sin que alguien lo toque. La IA propone el plan ENTERO —se ve
        exactamente lo que se va a guardar— y recién ahí se confirma. Por eso pedir una
        propuesta nueva no puede pisar lo que corregiste a mano.
     2. Todo se edita a mano: cada campo de cada fila, agregar bloques, moverlos, borrarlos.
        La IA es un punto de partida, no el dueño del plan.
     3. Vacío no es una alarma. Un proyecto sin plan todavía es normal, no un atraso.

     (Sebastián, 26 ago 2026: "tiene que poder regenerarse por si no funciona o está mal
     hecho; puede ser cambiado a mano también. Mirá cómo lo hice con Maestro.") */
  /* ── LA JORNADA DE RODAJE DE VIVEN ──
     Sebastián, 26 ago 2026: 9 horas de rodaje más una de almuerzo, y overtime hasta 15.
     Los tramos, confirmados por él: 10-12 → +25%, 13-14 → +50%, 15 y arriba → +100%.
     (La primera lectura los había puesto en 10-11 / 12-14 / 15 y él los corrigió.)

     Está también en supabase/functions/_shared/jornada.ts, que es de donde la leen los
     prompts. Si cambia el convenio, cambian los dos. */
  const JORNADA = {
    horasNormales: 9, horasLunch: 1, topeAbsoluto: 15,
    tramos: [{ desde: 10, hasta: 12, recargo: 0.25 },
             { desde: 13, hasta: 14, recargo: 0.50 },
             { desde: 15, hasta: 99, recargo: 1.00 }],
  };

  function costoJornada(horas, tarifaHora){
    const h = Math.max(0, Number(horas) || 0), t = Math.max(0, Number(tarifaHora) || 0);
    const normales = Math.min(h, JORNADA.horasNormales);
    let total = normales * t;
    const detalle = [];
    JORNADA.tramos.forEach((tr) => {
      const desde = Math.max(tr.desde, JORNADA.horasNormales + 1);
      const n = Math.max(0, Math.min(h, tr.hasta) - desde + 1);
      if (n <= 0) return;
      const costo = n * t * (1 + tr.recargo);
      total += costo;
      detalle.push({ horas: n, recargo: tr.recargo, costo });
    });
    return { total, normales: normales * t, extra: total - normales * t, detalle,
             pasaElTope: h > JORNADA.topeAbsoluto };
  }

  /* Cuánto dura cada jornada del plan, mirando la primera y la última hora de sus bloques.
     El almuerzo entra en el reloj pero no es rodaje, así que se descuenta para saber si el
     TRABAJO se pasó de nueve. */
  /* La tarifa por hora con la que se calcula el sobrecosto. Sale de los técnicos del
     proyecto —su tarifa real— y si no la tienen cargada, de la tarifa por día dividida por
     las horas normales. Si no hay ninguna, devuelve 0 y la pantalla lo dice en vez de
     inventar un número. */
  function pjTarifaDeReferencia(){
    const p = pjCur; if (!p) return 0;
    const nombres = (Array.isArray(p.crew) ? p.crew : []).map((c) => crewNorm(c && c.nombre)).filter(Boolean);
    const suyos = (crewList || []).filter((t) => nombres.includes(crewNorm(t.name)) && !t.interno);
    const tarifas = suyos.map((t) => Number(t.tarifa_hora) ||
      (Number(t.tarifa_dia) ? Number(t.tarifa_dia) / JORNADA.horasNormales : 0)).filter((x) => x > 0);
    if (!tarifas.length) return 0;
    /* El promedio, no la suma: el aviso dice "por persona" para que se multiplique por el
       equipo que de verdad se queda. Sumar acá daría un número que parece el total y no lo
       es —depende de cuántos se quedan— y un total inventado es peor que ninguno. */
    return Math.round(tarifas.reduce((a, b) => a + b, 0) / tarifas.length);
  }

  function pjPlanJornadas(){
    const filas = pjPlanFilas();
    const porBloque = {};
    filas.forEach((f) => {
      /* La jornada es lo que va antes del "·": "Jornada 1 · Mañana" y "Jornada 1 · Tarde"
         son el mismo día. */
      const dia = String(f.bloque || '').split('·')[0].trim() || 'Sin jornada';
      const m = String(f.hora || '').match(/^(\d{1,2}):(\d{2})/);
      if (!m) return;
      const min = +m[1] * 60 + +m[2];
      const b = porBloque[dia] = porBloque[dia] || { dia, desde: min, hasta: min, lunch: false, vuelta: false, ultimo: 0, filas: 0 };
      b.desde = Math.min(b.desde, min);
      if (min >= b.hasta){ b.hasta = min; b.ultimo = Number(f.dura_min) || 0; }
      b.filas++;
      if (/comida|almuerzo|lunch/i.test(String(f.que || ''))) b.lunch = true;
      /* El regreso tiene que estar en el plan: si no está, la jornada dura más de lo que
         dice y nadie lo ve. */
      if (/vuelta|regreso|volver|retorno|go home|viaje de vuelta/i.test(String(f.que || ''))) b.vuelta = true;
    });
    return Object.values(porBloque).map((b) => {
      /* EL VIAJE DE VUELTA CUENTA. La jornada no termina cuando se apaga la cámara: termina
         cuando el equipo llegó. Por eso el reloj va de la citación al regreso.
         Al último bloque se le suma lo que dura: si trae minutos cargados, esos; si no, una
         hora, que es lo que tarda desmontar y cargar. Sin eso, un día que "termina a las
         18:00" figuraba una hora más corto de lo que es.
         (Sebastián, 26 ago 2026: "también cuenta el go home time".) */
      const ultimoMin = b.ultimo || 60;
      const enSet = (b.hasta - b.desde + ultimoMin) / 60;
      const rodaje = Math.max(0, enSet - (b.lunch ? JORNADA.horasLunch : 0));
      return { ...b, enSet, rodaje, sobra: Math.max(0, rodaje - JORNADA.horasNormales) };
    });
  }

  let pjPlan = null;        // la fila guardada de project_scripts (tipo 'plan')
  let pjPlanRecT = null;    // debounce del recálculo de horas
  let pjPlanProp = null;    // la propuesta de la IA, todavía sin guardar
  let pjPlanT = null;       // debounce del guardado

  const PJ_PL_COLS = [
    /* La jornada NO es una columna: es el encabezado de su tramo. Repetir «Jornada 1 ·» en
       cada fila de un rodaje de un día es ruido en doce renglones.
       (Sebastián, 26 ago 2026: "¿por qué ponés jornada 1 si es solo una?") */
    ['hora', 'Empieza', 'input', '08:00'],
    /* Cuánto dura el bloque. Es lo que permite que la jornada se sume de verdad —y, más
       adelante, que mover un bloque recalcule el día en vez de retipear todas las horas. */
    ['dura_min', 'Dura', 'input', '45'],
    ['que', 'Qué se rueda', 'textarea', 'Entrevista a la directora técnica'],
    ['donde', 'Dónde', 'input', 'Sala de reuniones'],
    ['quien', 'Quién', 'input', 'Cámara + sonido'],
    ['escenas', 'Escenas', 'input', '3, 7'],
    /* Qué tiene que ESTAR en ese bloque. Sale del desglose de las escenas que se ruedan
       ahí: un plan que no dice qué llevar es una agenda, no un plan. */
    ['lleva', 'Qué llevar', 'textarea', 'Trípode, 2 lavaliers, el producto'],
    ['notas', 'Notas', 'textarea', ''],
  ];

  async function pjPlanLoad(){
    const p = pjCur; if (!p) return;
    pjPlanProp = null;
    const { data, error } = await supabase.from('project_scripts')
      .select('*').eq('project_id', p.id).eq('tipo', 'plan')
      .order('updated_at', { ascending: false }).limit(1);
    pjPlan = (error || !data || !data.length) ? null : data[0];
    /* Las tres listas viven juntas en `premisa` y se separan al leer: notas del día, lo que
       hay que conseguir y los riesgos. */
    if (pjPlan){
      const t = String(pjPlan.premisa || '');
      const corte = (desde, hasta) => {
        if (!t.includes(desde)) return '';
        const x = t.split(desde)[1];
        return (hasta && x.includes(hasta) ? x.split(hasta)[0] : x).trim();
      };
      pjPlan.notas_dia = corte('Notas del día:', 'Hay que conseguir antes:') ||
                         corte('Notas del día:', 'Ojo con:');
      pjPlan.necesita_txt = corte('Hay que conseguir antes:', 'Ojo con:');
      pjPlan.riesgos_txt = corte('Ojo con:', null);
    }
    pjPlanRender();
    pjPlanCabRender();
    pjLugarCargar();
    pjRenderSteps();
  }

  /* La citación GENERAL: la primera hora del plan. Estaba calculada igual en tres lugares
     (el crew, la hoja de gente y ahora los contactos del cliente); con tres copias, el día
     que cambie el criterio dos van a seguir diciendo lo de antes. */
  function pjCitaGeneral(){
    const conH = pjPlanFilas().filter((f) => String(f.hora || '').match(/^\d{1,2}:\d{2}/));
    return conH.length ? String(conH[0].hora).slice(0, 5) : '';
  }

  function pjPlanFilas(){ return (pjPlan && Array.isArray(pjPlan.cuerpo)) ? pjPlan.cuerpo : []; }

  /* ── La cabecera del día ──
     Lo que Maestro pone arriba de todo y acá faltaba: la citación grande, dónde presentarse
     PEGADO a la hora —son un solo dato operativo, y separarlos hace que se mire la hora sin
     leer nunca la dirección—, el viaje desde la base, y la luz.
     La dirección se resuelve una vez y queda guardada: si no cambió, no se vuelve a pedir.
     Lo que no se pudo calcular dice por qué; no se rellena ni se deja en blanco. */
  let pjLugar = null, pjLugarDe = null;

  async function pjLugarCargar(){
    const p = pjCur; if (!p) return;
    const dir = String(p.location || '').trim();
    const clave = dir + '|' + (p.shoot_start || '');
    if (!dir){ pjLugar = null; pjLugarDe = clave; pjPlanCabRender(); return; }
    if (pjLugarDe === clave) return;              // ya resuelto para esta dirección y fecha
    pjLugarDe = clave;
    pjLugar = { cargando: true };
    pjPlanCabRender();
    try {
      const { data, error } = await supabase.functions.invoke('lugar-rodaje', {
        body: { direccion: dir, fecha: p.shoot_start || '' } });
      pjLugar = (error || !data || data.error)
        ? { error: (data && data.error) || (error && error.message) || 'no se pudo' }
        : data;
    } catch (e){ pjLugar = { error: String(e) }; }
    if (pjCur === p) pjPlanCabRender();
  }

  function pjPlanCabRender(){
    const p = pjCur, box = $('pj-plan-cab'); if (!p || !box) return;
    const filas = pjPlanFilas();
    if (!filas.length){ box.innerHTML = ''; return; }

    /* La citación es la primera hora del plan. La primera TOMA es otra cosa: la primera
       fila que no sea llegada, montaje o viaje. Confundirlas es un dato equivocado a la
       vista de todo el equipo. */
    const hh = (f) => String(f.hora || '').match(/^(\d{1,2}):(\d{2})/);
    const conHora = filas.filter(hh);
    const cita = conHora.length ? conHora[0].hora : null;
    const esPrep = (f) => /llegada|montaje|viaje|traslado|carga|preparaci/i.test(String(f.que || ''));
    const primera = conHora.find((f) => !esPrep(f));
    const ult = conHora[conHora.length - 1];
    let fin = null;
    if (ult){
      const m = hh(ult), min = +m[1] * 60 + +m[2] + (Number(ult.dura_min) || 60);
      fin = String(Math.floor(min / 60) % 24).padStart(2, '0') + ':' + String(min % 60).padStart(2, '0');
    }

    const L = pjLugar || {};
    const dato = (lbl, v, sub) => '<div><p class="lbl">' + lbl + '</p>' +
      (v ? '<div class="v">' + v + '</div>' : '<div class="falta">—</div>') +
      (sub ? '<div class="fte">' + sub + '</div>' : '') + '</div>';

    box.innerHTML = '<div class="pj-cita">' +
      '<div class="big"><p class="lbl">Citación</p>' +
        (cita ? '<div class="hora">' + esc(cita) + '</div>' : '<div class="falta">sin horas en el plan</div>') + '</div>' +
      '<div class="donde"><p class="lbl">Dónde presentarse</p>' +
        (String(p.location || '').trim()
          ? '<div class="dir">' + esc(p.location) + '</div>' +
            (L.maps ? '<a href="' + esc(L.maps) + '" target="_blank" rel="noopener">Abrir en Maps ↗</a>' : '') +
            (L.cargando ? '<div class="fte">buscando la dirección…</div>'
             : L.viaje ? '<div class="chip">🚐 ' + L.viaje.min + ' min · ' + L.viaje.km + ' km desde ' + esc(L.base || '') + '</div>'
             : L.encontrada === false ? '<div class="falta">' + esc(L.motivo || 'no se encontró esa dirección') + '</div>'
             : L.viaje_motivo ? '<div class="falta">' + esc(L.viaje_motivo) + '</div>' : '')
          /* Se carga acá mismo. Mandar a alguien a otra pantalla a completar un campo que
             está pidiendo esta es la clase de viaje que hace que el campo quede vacío. */
          : '<div class="pj-locpide"><input class="pj-inp" id="pj-loc-rapida" placeholder="Calle, número y ciudad" />' +
            '<span class="muted-note">Con eso salen el viaje desde la oficina y la hora de la luz.</span></div>') +
      '</div>' +
      '<div class="otros">' +
        dato('Primera toma', primera ? esc(primera.hora) : null) +
        dato('Fin estimado', fin ? esc(fin) : null, fin ? 'con el viaje de vuelta' : '') +
        dato('Luz', L.luz && L.luz.amanece ? esc(L.luz.amanece) + ' · ' + esc(L.luz.atardece) : null,
             L.luz && L.luz.amanece ? esc(L.luz_fuente || '') : esc(L.luz_motivo || (L.cargando ? 'calculando…' : ''))) +
      '</div></div>';

    const rap = $('pj-loc-rapida');
    if (rap) rap.addEventListener('change', () => {
      const v = rap.value.trim(); if (!v) return;
      p.location = v;
      $('pj-location').value = v;
      pjAutoGuardar();
      pjLugarCargar();
    });
  }

  /* La sinopsis de las escenas de un bloque, sacada del DESGLOSE.
     No hace falta regenerar el plan para verla: el resumen de cada escena ya está guardado,
     y la fila del plan dice qué escenas se ruedan ahí. Un plan hecho la semana pasada gana
     la sinopsis igual.
     (Sebastián, 26 ago 2026: "¿por qué sigue sin mostrar sinopsis de lo que se rueda?") */
  function pjSinopsisDe(escenas){
    const p = pjCur;
    const b = p && p.breakdown;
    if (!b || !Array.isArray(b.escenas)) return '';
    const nums = String(escenas || '').match(/\d+/g);
    if (!nums || !nums.length) return '';
    const txt = nums.map((n) => {
      const e = b.escenas.find((x) => String(x.n) === String(n));
      return e && String(e.resumen || '').trim() ? String(e.resumen).trim() : '';
    }).filter(Boolean);
    if (!txt.length) return '';
    /* Sin repetir: dos escenas del mismo momento suelen traer el mismo resumen. */
    return [...new Set(txt)].join(' ');
  }

  function pjPlanRender(){
    /* El enganche del click va ACÁ, donde el plan se dibuja de verdad. La primera versión
       lo llamaba solo desde el manejador de horas del crew —o sea, casi nunca— y la
       pestaña «Citación» no hacía nada al tocarla. Es idempotente: se engancha una sola
       vez aunque el plan se redibuje veinte veces. */
    pjPlanTabs();
    /* Y se renderiza la gente aunque la pestaña esté oculta: el contador «(4)» del botón
       sale de ahí, y un contador vacío hace dudar de si la pestaña tiene algo. */
    pjPlanGenteRender();
    const filas = pjPlanFilas();
    const est = $('pj-plan-est');
    if (est) est.textContent = filas.length
      ? filas.length + ' bloques' + (pjPlan && pjPlan.updated_at ? ' · ' + fmtDMY(pjPlan.updated_at) : '')
      : 'sin plan todavía';

    // La propuesta, arriba y separada de lo guardado: no se confunde una con otra.
    $('pj-plan-prop').innerHTML = !pjPlanProp ? '' :
      '<div class="pj-prop"><h4>Propuesta de la IA — todavía no está guardada</h4>' +
      '<p class="sub">' + esc(pjPlanProp.titulo || '') + ' · ' + (pjPlanProp.filas || []).length + ' bloques' +
        (pjPlanProp.guion ? ' · del guión «' + esc(pjPlanProp.guion) + '»' : '') + '</p>' +
      '<div class="lead-table-wrap"><table class="lead-table"><thead><tr><th>Bloque</th><th>Hora</th><th>Qué</th><th>Dónde</th><th>Quién</th><th>Qué llevar</th></tr></thead><tbody>' +
      (pjPlanProp.filas || []).map((f) => '<tr><td>' + esc(f.bloque || '') + '</td><td>' + esc(f.hora || '') +
        '</td><td>' + esc(f.que || '') + (f.notas ? '<br><span class="muted-note">' + esc(f.notas) + '</span>' : '') +
        '</td><td>' + esc(f.donde || '') + '</td><td>' + esc(f.quien || '') +
        '</td><td>' + (f.lleva ? esc(f.lleva) : '<span class="muted-note">—</span>') + '</td></tr>').join('') +
      '</tbody></table></div>' +
      '<div class="acc">' +
        '<button class="btn btn-primary small" id="pj-plan-usar" type="button">' +
          (filas.length ? '📅 Reemplazar el plan por este' : '📅 Usar este plan') + '</button>' +
        (filas.length ? '<button class="btn btn-ghost small" id="pj-plan-sumar" type="button">➕ Agregarlo abajo del que hay</button>' : '') +
        '<button class="btn btn-ghost small" id="pj-plan-tirar" type="button">Descartarla</button>' +
      '</div></div>';

    if (pjPlanProp){
      $('pj-plan-usar').addEventListener('click', () => pjPlanGuardarProp(true));
      const sm = $('pj-plan-sumar'); if (sm) sm.addEventListener('click', () => pjPlanGuardarProp(false));
      $('pj-plan-tirar').addEventListener('click', () => { pjPlanProp = null; pjPlanRender(); });
    }

    /* ── Lo que dura cada jornada, y lo que cuesta si se pasa ──
       Un plan que se estira no avisa solo: las horas están repartidas en diez filas y nadie
       las suma. Acá se suman, y si el trabajo pasa de nueve se dice cuánto sale — con el
       recargo aplicado tramo por tramo, no un "ojo que es largo".
       Se necesita una tarifa por hora para poner el número; si no hay, se avisa igual sin
       inventarla. (Un número sin de dónde salió no se dice.) */
    pjPlanCabRender();
    const jor = pjPlanJornadas();
    const largas = jor.filter((j) => j.sobra > 0);
    const tarifa = pjTarifaDeReferencia();
    $('pj-plan-jor').innerHTML = !jor.length ? '' :
      '<div class="pj-jorbar">' + jor.map((j) => {
        const c = j.sobra > 0 && tarifa ? costoJornada(j.rodaje, tarifa) : null;
        const cls = j.rodaje > JORNADA.topeAbsoluto ? ' tope' : j.sobra > 0 ? ' larga' : '';
        return '<div class="pj-jor1' + cls + '"><b>' + esc(j.dia) + '</b>' +
          '<span>' + j.rodaje.toFixed(j.rodaje % 1 ? 1 : 0) + ' h de rodaje' +
            (j.lunch ? ' + almuerzo' : '') + '</span>' +
          (j.rodaje > JORNADA.topeAbsoluto
            ? '<em>⛔ pasa las ' + JORNADA.topeAbsoluto + ' h — no se puede rodar así</em>'
            : j.sobra > 0
              ? '<em>⚠️ ' + j.sobra.toFixed(j.sobra % 1 ? 1 : 0) + ' h de más' +
                (c ? ' · +' + pjCHF(c.extra) + ' por persona' : ' · cargá una tarifa por hora para ver cuánto sale') + '</em>'
              : !j.lunch ? '<em>sin almuerzo en el plan</em>'
              : !j.vuelta ? '<em>sin el viaje de vuelta — la jornada dura más de lo que dice</em>' : '') +
          '</div>';
      }).join('') + '</div>' +
      (largas.length
        ? '<p class="muted-note" style="margin:8px 0 0">La jornada de VIVEN son ' + JORNADA.horasNormales +
          ' h de rodaje más 1 de almuerzo, contando desde la citación hasta que el equipo vuelve — el viaje de vuelta es parte de la jornada. ' +
          'Estirar se paga: +25% de la hora 10 a la 12, +50% la 13 y la 14, +100% de la 15 en adelante. ' +
          'Si el trabajo no entra, dos jornadas salen más baratas que una larga.</p>'
        : '');

    // El plan guardado: editable adentro.
    $('pj-plan-tabla').innerHTML = !filas.length
      ? '<p class="muted-note" style="margin:0">Todavía no hay plan. Es normal — se arma cuando hay fechas. Pedí una propuesta, o agregá los bloques a mano.</p>'
      : '<div class="lead-table-wrap"><table class="pj-pl"><thead><tr>' +
        PJ_PL_COLS.map((c) => '<th>' + c[1] + '</th>').join('') + '<th></th></tr></thead><tbody>' +
        filas.map((f, i) => {
          /* El tramo se anuncia una vez, en una fila propia, y no se repite en cada
             renglón. Cuando hay una sola jornada el nombre suele ser «Mañana» / «Tarde»,
             que es exactamente lo que hace falta saber. */
          const bloq = String(f.bloque || '').trim();
          const nuevoBloque = i === 0 || bloq !== String(filas[i - 1].bloque || '').trim();
          const cab = nuevoBloque && bloq
            ? '<tr class="blq-cab"><td colspan="' + (PJ_PL_COLS.length + 1) + '">' +
              '<input data-pf="' + i + '" data-pk="bloque" value="' + esc(bloq) + '" ' +
              'placeholder="Mañana" title="El nombre de este tramo. Cambiarlo acá lo cambia para todas sus filas." /></td></tr>'
            : '';
          return cab + '<tr' + (nuevoBloque ? ' class="blq-ini"' : '') + '>' +
            PJ_PL_COLS.map((c) => '<td class="c-' + c[0] + '" data-l="' + c[1] + '">' +
              (c[2] === 'textarea'
                ? '<textarea rows="2" data-pf="' + i + '" data-pk="' + c[0] + '" placeholder="' + esc(c[3]) + '">' + esc(f[c[0]] || '') + '</textarea>'
                : '<input data-pf="' + i + '" data-pk="' + c[0] + '" value="' + esc(f[c[0]] || '') + '" placeholder="' + esc(c[3]) + '" />') +
              '</td>').join('') +
            '<td data-l=""><div class="mv">' +
              '<button type="button" data-pup="' + i + '" title="Subir">↑</button>' +
              '<button type="button" data-pdn="' + i + '" title="Bajar">↓</button>' +
              '<button type="button" data-pdel="' + i + '" title="Borrar este bloque">✕</button>' +
            '</div></td></tr>';
        }).join('') + '</tbody></table></div>';

    /* Las horas fijas se marcan con su motivo —la nota de esa fila— en vez de una etiqueta
       que haya que aprender. Y si alguna quedó pisada por el bloque de arriba, se dice. */
    const pisados = pjPlanRecalcular();
    $('pj-plan-tabla').querySelectorAll('.c-hora').forEach((td, i) => {
      const f = pjPlanFilas()[i];
      if (!f) return;
      if (f.fija){
        const por = String(f.notas || '').trim().split(/[.\n]/)[0].slice(0, 40);
        td.insertAdjacentHTML('beforeend',
          '<span class="pj-fija">📌 ' + (por ? esc(por) : 'no se mueve') + '</span>');
      }
      if (pisados.includes(i)) td.classList.add('pisada');
    });

    /* La sinopsis, debajo de lo que se rueda. Es lo que hace entender qué se está filmando
       a quien no leyó el guion — y sale del desglose, no hace falta regenerar el plan. */
    $('pj-plan-tabla').querySelectorAll('.c-que').forEach((td, i) => {
      const f = pjPlanFilas()[i]; if (!f) return;
      const sin = pjSinopsisDe(f.escenas);
      if (sin && !String(f.que || '').includes(sin.slice(0, 40))){
        td.insertAdjacentHTML('beforeend', '<span class="pj-sinop">' + esc(sin) + '</span>');
      }
    });

    const tb = $('pj-plan-tabla');
    tb.querySelectorAll('[data-pf]').forEach((el) => el.addEventListener('input', () => {
      const fs = pjPlanFilas(), i = +el.dataset.pf, f = fs[i]; if (!f) return;
      /* Renombrar el tramo lo renombra en TODAS sus filas: son el mismo tramo, y dejar la
         mitad con el nombre viejo lo partiría en dos sin que nadie lo pida. */
      if (el.dataset.pk === 'bloque'){
        const antes = String(f.bloque || '');
        fs.forEach((x) => { if (String(x.bloque || '') === antes) x.bloque = el.value; });
      } else {
        f[el.dataset.pk] = el.value;
        /* Escribir una hora la vuelve FIJA: la escribió una persona. Borrarla la devuelve
           al cálculo. */
        if (el.dataset.pk === 'hora'){
          f.fija = !!String(el.value).trim() && i > 0;
          if (!String(el.value).trim()) delete f.fija;
        }
        /* Cambiar la duración o una hora corre todo lo de abajo. Se repinta después de
           escribir, no mientras: redibujar en cada tecla saca el cursor del campo. */
        if (el.dataset.pk === 'dura_min' || el.dataset.pk === 'hora'){
          clearTimeout(pjPlanRecT);
          pjPlanRecT = setTimeout(() => {
            const foco = document.activeElement;
            const guardar = foco && foco.dataset ? { f: foco.dataset.pf, k: foco.dataset.pk, sel: foco.selectionStart } : null;
            pjPlanRecalcular();
            pjPlanRender();
            if (guardar){
              const v = $('pj-plan-tabla').querySelector('[data-pf="' + guardar.f + '"][data-pk="' + guardar.k + '"]');
              if (v){ v.focus(); try { v.setSelectionRange(guardar.sel, guardar.sel); } catch (e){ } }
            }
          }, 600);
        }
      }
      pjPlanGuardarDebounce();
    }));
    tb.querySelectorAll('[data-pup]').forEach((b) => b.addEventListener('click', () => pjPlanMover(+b.dataset.pup, -1)));
    tb.querySelectorAll('[data-pdn]').forEach((b) => b.addEventListener('click', () => pjPlanMover(+b.dataset.pdn, 1)));
    tb.querySelectorAll('[data-pdel]').forEach((b) => b.addEventListener('click', () => pjPlanBorrarFila(+b.dataset.pdel)));

    pjPlanGenteRender();
    $('pj-plan-notas').value = (pjPlan && pjPlan.notas_dia) || '';

    /* "Hay que conseguir" y "Ojo con" también se editan: la IA los propone y después
       aparecen cosas que solo sabe el que atendió el teléfono. */
    $('pj-plan-listas').innerHTML = !pjPlan ? '' :
      '<div class="pj-listas">' +
        '<div><h4>Hay que conseguir antes</h4>' +
          '<textarea id="pj-plan-nec" rows="4" placeholder="Una cosa por línea. Es la lista que le mandamos al cliente.">' +
          esc(pjPlan.necesita_txt || '') + '</textarea></div>' +
        '<div><h4>Ojo con</h4>' +
          '<textarea id="pj-plan-rie" rows="4" placeholder="Una cosa por línea. Lo que puede tirar abajo el día.">' +
          esc(pjPlan.riesgos_txt || '') + '</textarea></div>' +
      '</div>';
    if (pjPlan){
      ['pj-plan-nec', 'pj-plan-rie'].forEach((id) => $(id).addEventListener('input', () => {
        pjPlan.necesita_txt = $('pj-plan-nec').value;
        pjPlan.riesgos_txt = $('pj-plan-rie').value;
        pjPlanGuardarDebounce();
      }));
    }
    if (pjPlan){
      $('pj-plan-notas').addEventListener('input', () => {
        pjPlan.notas_dia = $('pj-plan-notas').value;
        pjPlanGuardarDebounce();
      });
    }
  }

  /* ── El plan en PDF ──
     Mismo papel que el guion: logo, cabecera con el número de proyecto, y el pie repetido
     en todas las hojas. Un plan de rodaje se imprime y se lleva al set; una hoja suelta sin
     número no vuelve a su carpeta.
     La barra de imprimir va con .noprint y las reglas de impresión al FINAL del CSS — si no,
     una regla posterior con la misma especificidad la vuelve a mostrar y sale dentro del PDF.
     (Sebastián, 26 ago 2026: "falta todo lo de poder mandar como PDF".) */
  /* Con `{soloHtml:true}` devuelve el HTML del plan en vez de abrir la ventana de impresión.
     Ese mismo HTML es el que se manda al servidor para adjuntarlo en PDF al email: si el
     papel se armara en otro lado, el adjunto y lo que ves al imprimir se irían separando. */
  function pjPlanPDF(op){
    const soloHtml = op && op.soloHtml;
    const p = pjCur; if (!p) return;
    const filas = pjPlanFilas();
    if (!filas.length){ toast('El plan está vacío'); return; }
    const jor = pjPlanJornadas();
    const hoy = new Date().toLocaleDateString('de-CH');
    const fechas = [p.shoot_start ? fmtDMY(p.shoot_start) : '', p.shoot_end && p.shoot_end !== p.shoot_start ? fmtDMY(p.shoot_end) : '']
      .filter(Boolean).join(' – ');
    const pieTxt = [(p.ref ? '#' + p.ref : ''), String(p.title || ''), 'VIVEN AG · Zürich'].filter(Boolean).join('  ·  ');

    /* Los mismos datos que la pantalla, sacados de las mismas filas: si se calcularan dos
       veces con dos criterios, el papel y la pantalla dirían horas distintas. */
    const hh = (f) => String(f.hora || '').match(/^(\d{1,2}):(\d{2})/);
    const conHora = filas.filter(hh);
    const esPrep = (f) => /llegada|montaje|viaje|traslado|carga|preparaci/i.test(String(f.que || ''));
    const ultF = conHora[conHora.length - 1];
    let finTxt = null;
    if (ultF){ const m = hh(ultF), t = +m[1] * 60 + +m[2] + (Number(ultF.dura_min) || 60);
      finTxt = String(Math.floor(t / 60) % 24).padStart(2, '0') + ':' + String(t % 60).padStart(2, '0'); }
    const L = pjLugar || {};
    const cab = {
      cita: conHora.length ? conHora[0].hora : null,
      primera: (conHora.find((f) => !esPrep(f)) || {}).hora || null,
      fin: finTxt,
      viaje: L.viaje ? L.viaje.min + ' min · ' + L.viaje.km + ' km desde ' + (L.base || '') : null,
      luz: L.luz && L.luz.amanece ? L.luz.amanece + ' – ' + L.luz.atardece : null,
    };
    const notasDia = (pjPlan && pjPlan.notas_dia || '').trim();
    /* Cada uno con SU citación en la hoja. Antes la hoja tenía una sola hora arriba y el
       equipo entero la leía como propia: el que tenía que llegar dos horas después se
       enteraba por WhatsApp, o no se enteraba. */
    const crewPDF = (Array.isArray(p.crew) ? p.crew : []).filter((c) => c && c.nombre).map((c) => {
      const t = crewFicha(c.nombre);
      return { nombre: c.nombre, rol: c.rol || '', tel: (t && t.phone) || '', hora: c.hora || '' };
    });

    let blq = null;
    /* En papel NO va la nota de producción de cada fila ("se arranca por cocina porque ahí
       están casi todas las escenas"): es el porqué del orden, se lee una vez al planificar
       y ocupaba más de la mitad de la altura de la tabla. Sí va la sinopsis —qué se ve— que
       es lo que hay que rodar.
       Y el nombre del bloque pierde el "Jornada 1 · " cuando hay una sola jornada: diez
       franjas repitiendo lo mismo. */
    const unaJornada = jor.length <= 1;
    const cuerpo = filas.map((f) => {
      const b0 = String(f.bloque || '').trim();
      const b = unaJornada ? b0.replace(/^\s*jornada\s*\d+\s*[·:.-]\s*/i, '') : b0;
      const cab = b && b !== blq ? (blq = b, '<tr class="cab"><td colspan="6">' + esc(b) + '</td></tr>') : '';
      const dur = Number(f.dura_min) ? Number(f.dura_min) + '′' : '';
      return cab + '<tr>' +
        '<td class="h">' + esc(f.hora || '') + '</td>' +
        '<td class="d">' + dur + '</td>' +
        '<td class="q"><b>' + esc(f.que || '') + '</b>' +
          (f.escenas && f.escenas !== '—' ? '<span class="esc">Esc. ' + esc(f.escenas) + '</span>' : '') +
          (() => { const sn = pjSinopsisDe(f.escenas);
                   return sn && !String(f.que || '').includes(sn.slice(0, 40))
                     ? '<span class="sin">' + esc(sn) + '</span>' : ''; })() +
        '</td>' +
        '<td>' + esc(f.donde || '') + '</td>' +
        '<td>' + esc(f.quien || '') + '</td>' +
        '<td class="ll">' + esc(f.lleva || '') + '</td></tr>';
    }).join('');

    const nec = (pjPlan && pjPlan.necesita_txt || '').trim();
    const rie = (pjPlan && pjPlan.riesgos_txt || '').trim();
    const lista = (t) => t.split('\n').map((x) => x.replace(/^[·\-\s]+/, '').trim()).filter(Boolean)
      .map((x) => '<li>' + esc(x) + '</li>').join('');

    /* El guion elegido, o el que esté pegado a mano. Mismo criterio que el paso «Guion»:
       si hay uno marcado como elegido, ése; si no, el texto del proyecto. */
    const gEleg = (pjGuiones || []).find((g) => g.elegido);
    const guionTit = gEleg ? [gEleg.titulo, gEleg.angulo].filter(Boolean).join(' · ') : '';
    /* El guion A/V viene como bloques {tc, video, audio}, no como un texto: se dibuja en
       dos columnas, que es como se lee un guion audiovisual. Un guion de cine viene como
       texto y va tal cual. */
    const gc = gEleg && gEleg.cuerpo;
    const guionAV = Array.isArray(gc) && gc.length && (gc[0].video || gc[0].audio) ? gc : null;
    const guionTxt = guionAV ? '' : String(
      (Array.isArray(gc) ? gc.map((x) => x && (x.texto || x.cuerpo || '')).join('\n\n') : gc) || p.script_text || '').trim();

    const w = soloHtml ? null : window.open('', '_blank');
    if (!soloHtml && !w){ toast('El navegador bloqueó la ventana. Permitila y probá de nuevo.'); return; }
    const HTML = ('<!doctype html><html lang="es"><head><meta charset="utf-8">' +
      '<title>' + esc((p.ref ? p.ref + ' ' : '') + 'Plan de rodaje') + '</title><style>' +
      '@import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap");' +
      /* En papel el acento es el AZUL, no el verde. El verde es de pantalla: impreso en
         una láser en blanco y negro queda un gris claro que no separa nada, y a color
         chupa tinta en franjas enteras. El azul imprime como azul y como gris oscuro.
         (Sebastián, 27 ago 2026: "cambia el verde por el azul".) */
      ':root{--navy:#1b2c46;--acid:#ddf98f;--tinta:#1a2230;--gris:#6b7896;--linea:#e3e7ee;' +
        '--display:"Space Grotesk",Helvetica,Arial,sans-serif;--texto:Inter,-apple-system,Helvetica,Arial,sans-serif}' +
      'body{font:10pt/1.55 var(--texto);color:var(--tinta);background:#e6e9ef;margin:0;padding:26px 16px 60px;' +
        '-webkit-print-color-adjust:exact;print-color-adjust:exact}' +
      '.hoja{max-width:196mm;margin:0 auto;background:#fff;padding:14mm 12mm;' +
        'box-shadow:0 10px 40px -12px rgba(0,0,0,.35);border-radius:2px}' +
      '@page{margin:16mm 12mm 18mm;' +
        '@bottom-left{content:"' + pieTxt.replace(/"/g, "'") + '";font:8pt Inter,Arial,sans-serif;color:#8a94a8}' +
        '@bottom-right{content:counter(page) " / " counter(pages);font:8pt Inter,Arial,sans-serif;color:#8a94a8}}' +
      'header{display:flex;align-items:center;justify-content:space-between;gap:20px;' +
        'border-bottom:3px solid var(--navy);padding-bottom:11px;margin-bottom:18px}' +
      'header img{width:92px;height:auto;display:block}' +
      '.hd-r{text-align:right;font:8.5pt/1.5 var(--texto);color:var(--gris);letter-spacing:.07em;text-transform:uppercase}' +
      'h1{font:700 19pt/1.16 var(--display);margin:0 0 5px;letter-spacing:-.02em;color:var(--navy)}' +
      '.meta{font:600 8.5pt/1.5 var(--texto);color:var(--gris);letter-spacing:.09em;text-transform:uppercase;margin:0 0 14px}' +
      '.jor{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 16px}' +
      '.jor div{border:1px solid var(--linea);border-radius:8px;padding:7px 12px;font-size:9pt}' +
      '.jor b{display:block;font:700 9pt var(--display);color:var(--navy)}' +
      /* Densidad de hoja de llamado: se lee de un vistazo, parado. Cada punto de padding
         de más son dos filas menos por página. */
      'table{width:100%;border-collapse:collapse;font:8.5pt/1.38 var(--texto);table-layout:fixed}' +
      'thead th{text-align:left;font:700 7pt var(--display);letter-spacing:.1em;text-transform:uppercase;' +
        'color:#fff;background:var(--navy);padding:5px 6px;border:0}' +
      'td{vertical-align:top;padding:4px 6px;border-bottom:1px solid var(--linea);overflow-wrap:anywhere}' +
      /* Los anchos, explícitos. Con table-layout:fixed y solo dos columnas medidas, el
         navegador repartía el resto en partes iguales: «Qué se rueda» quedaba en seis
         renglones mientras «Dura» tenía cuatro centímetros de aire al lado de un «90′». */
      'col.c-h{width:12mm}col.c-d{width:10mm}col.c-q{width:38%}col.c-do{width:15%}col.c-qn{width:19%}col.c-ll{width:17%}' +
      'td.h{font:700 9pt var(--display);color:var(--navy);white-space:nowrap;font-variant-numeric:tabular-nums}' +
      'td.d{color:var(--gris);white-space:nowrap;font-variant-numeric:tabular-nums;font-size:8pt}' +
      'td.q b{display:block;color:var(--tinta);font-weight:700}' +
      'td.q .esc{font-size:7.5pt;color:var(--navy);font-weight:600;margin-left:5px}' +
      'td.q .sin{display:block;font-size:8pt;color:#3d4757;margin-top:1px;line-height:1.4}' +
      'td.ll{font-size:8pt;color:#3d4757}' +
      'tr.cab td{background:rgba(27,44,70,.09);font:700 7pt var(--display);letter-spacing:.09em;' +
        'text-transform:uppercase;color:var(--navy);padding:3px 6px;border-bottom:0}' +
      'tr{break-inside:avoid}' +
      '.dos{display:flex;gap:22px;margin-top:20px}' +
      '.dos > div{flex:1}' +
      '.dos h3{font:700 8pt var(--display);letter-spacing:.11em;text-transform:uppercase;color:var(--navy);' +
        'margin:0 0 6px;padding-bottom:4px;border-bottom:1px solid var(--linea)}' +
      '.dos ul{margin:0;padding-left:16px;font-size:9pt;line-height:1.6;color:#3d4757}' +
      '.cita{display:flex;gap:22px;flex-wrap:wrap;border:1px solid var(--linea);border-radius:8px;' +
        'padding:10px 14px;margin:0 0 14px}' +
      '.cita .l{display:block;font:700 7pt var(--display);letter-spacing:.12em;text-transform:uppercase;color:var(--gris)}' +
      '.cita b{font:600 10.5pt var(--texto);color:var(--tinta)}' +
      '.cita b.hh{font:700 14pt var(--display);color:var(--navy);font-variant-numeric:tabular-nums}' +
      '.cita .dir{flex:1;min-width:150px}' +
      '.cita .s{display:block;font-size:8pt;color:var(--gris);margin-top:2px}' +
      '.notas{background:rgba(27,44,70,.06);border-left:3px solid var(--navy);padding:9px 12px;' +
        'margin:0 0 14px;font-size:9.5pt;line-height:1.55;color:#3d4757;white-space:pre-wrap}' +
      '.notas .l{display:block;font:700 7pt var(--display);letter-spacing:.12em;text-transform:uppercase;' +
        'color:var(--navy);margin-bottom:3px}' +
      '.eq{margin-top:20px;break-inside:avoid}' +
      '.eq h3{font:700 8pt var(--display);letter-spacing:.11em;text-transform:uppercase;color:var(--navy);' +
        'margin:0 0 6px;padding-bottom:4px;border-bottom:1px solid var(--linea)}' +
      '.eqt td{padding:5px 10px 5px 0;border-bottom:1px solid var(--linea);font-size:9pt}' +
      '.eqt .tel{font-variant-numeric:tabular-nums;color:var(--gris);white-space:nowrap;text-align:right}' +
      /* El crew en UNA fila de columnas en vez de una tabla larga: son cuatro nombres, no
         necesitan cuatro renglones. */
      '.eqt-fila{width:100%;table-layout:fixed}' +
      '.eqt-fila td{border:0;padding:0 10px 0 0;vertical-align:top;font-size:9pt}' +
      '.eqt-fila td b{display:block;color:var(--navy)}' +
      '.eqt-fila td span{display:block;font-size:8pt;color:var(--gris);line-height:1.45}' +
      '.eqt-fila td .tel{font-variant-numeric:tabular-nums}' +
      '.eqt-fila td .cita1{font:700 9.5pt var(--display);color:var(--navy);font-variant-numeric:tabular-nums;margin-top:1px;display:block}' +
      /* El guion va detrás, siempre en página nueva: es un anexo, no parte de la hoja. */
      '.guion{break-before:page;page-break-before:always;margin-top:0}' +
      '.guion h2{font:700 13pt var(--display);color:var(--navy);margin:0 0 2px}' +
      '.guion .gsub{font-size:9pt;color:var(--gris);margin:0 0 12px}' +
      '.guion pre{white-space:pre-wrap;font:9.5pt/1.55 var(--texto);color:var(--tinta);margin:0}' +
      '.gav{width:100%;border-collapse:collapse;margin:0}' +
      '.gav th{font:700 7pt var(--display);letter-spacing:.1em;text-transform:uppercase;color:#fff;' +
        'text-align:left;padding:5px 6px;background:var(--navy);border:0}' +
      '.gav td{padding:7px 8px 7px 0;border-bottom:1px solid var(--linea);font-size:9pt;line-height:1.5;vertical-align:top}' +
      '.gav .tc{font-variant-numeric:tabular-nums;color:var(--gris);white-space:nowrap;width:8%}' +
      '.gav .au{width:42%;color:var(--navy)}' +
      '.gav tr{break-inside:avoid}' +
      'footer{margin-top:24px;border-top:3px solid var(--navy);padding-top:10px;font:8.5pt/1.6 var(--texto);color:var(--gris)}' +
      'footer b{color:var(--navy)}' +
      '.barra{position:sticky;top:0;background:var(--navy);color:#fff;padding:9px 14px;border-radius:9px;' +
        'margin:0 auto 18px;max-width:196mm;font:13px var(--texto);display:flex;gap:12px;' +
        'align-items:center;justify-content:space-between}' +
      '.barra button{background:var(--acid);color:#1c2508;border:0;border-radius:100px;' +
        'font:700 13px var(--texto);padding:8px 18px;cursor:pointer}' +
      /* Al final y con !important: una regla posterior con la misma especificidad ganaría. */
      '@media print{body{background:#fff;padding:0}' +
        '.hoja{max-width:none;margin:0;padding:0;box-shadow:none;border-radius:0}' +
        '.noprint,.barra{display:none !important}}' +
      '</style></head><body>' +
      '<div class="barra noprint"><span>Guardá como PDF desde el diálogo de imprimir.</span>' +
        '<button onclick="window.print()">Imprimir / Guardar PDF</button></div>' +
      '<div class="hoja">' +
      '<header><img src="' + location.origin + '/assets/brand/viven-logo-navy.svg" alt="VIVEN" />' +
        '<div class="hd-r">' + (p.ref ? 'Proyecto ' + esc(p.ref) + '<br>' : '') + esc(hoy) + '</div></header>' +
      '<h1>Plan de rodaje</h1>' +
      '<p class="meta">' + esc([p.title || '', p.client_contact || '', fechas].filter(Boolean).join(' · ')) + '</p>' +
      /* La citación y dónde presentarse, arriba de todo y juntas: es lo que se busca a las
         seis de la mañana, y en papel también. */
      '<div class="cita">' +
        '<div><span class="l">Citación</span><b class="hh">' + esc(cab.cita || '—') + '</b></div>' +
        '<div class="dir"><span class="l">Dónde</span><b>' + esc(p.location || 'sin locación cargada') + '</b>' +
          (cab.viaje ? '<span class="s">' + cab.viaje + '</span>' : '') + '</div>' +
        '<div><span class="l">Primera toma</span><b class="hh">' + esc(cab.primera || '—') + '</b></div>' +
        '<div><span class="l">Fin estimado</span><b class="hh">' + esc(cab.fin || '—') + '</b></div>' +
        (cab.luz ? '<div><span class="l">Luz</span><b>' + esc(cab.luz) + '</b></div>' : '') +
      '</div>' +
      /* Lo de abajo se saca de la HOJA. Las notas del día, las jornadas, lo que hay que
         conseguir y los riesgos son cinco páginas de contexto para una hoja que se lee
         parado, con una linterna, a las seis de la mañana. Van en el email, que es donde
         se leen sentado la noche anterior.
         Maestro hace lo mismo: la orden del día es cronograma y citación, y lo demás va
         por otro lado.
         (Sebastián, 27 ago 2026: "no solo los horarios con el tiempo de citación, la
          locación, las cosas que se ruedan pero no todas las notas de arriba e idealmente
          en una página máx dos... ahora son 5".) */
      '<table>' +
      '<colgroup><col class="c-h"><col class="c-d"><col class="c-q"><col class="c-do"><col class="c-qn"><col class="c-ll"></colgroup>' +
      /* «Empieza» y «Dura» no entran en columnas de 12 mm: se pisaban entre sí en el
         encabezado ("EMPIEZADURA"). En una hoja de llamado se dice Hora y Min. */
      '<thead><tr><th>Hora</th><th>Min</th><th>Qué se rueda</th><th>Dónde</th><th>Quién</th><th>Qué llevar</th></tr></thead>' +
      '<tbody>' + cuerpo + '</tbody></table>' +
      (crewPDF.length ? '<div class="eq"><h3>Quién viene</h3><table class="eqt eqt-fila"><tbody><tr>' +
        crewPDF.map((c) => '<td><b>' + esc(c.nombre) + '</b><span>' + esc(c.rol) + '</span>' +
          '<span class="cita1">' + esc(c.hora ? String(c.hora).slice(0, 5) : (cab.cita || '')) + '</span>' +
          '<span class="tel">' + (c.tel ? esc(c.tel) : 'sin teléfono') + '</span></td>').join('') +
        '</tr></tbody></table></div>' : '') +
      '<footer><b>VIVEN AG</b> · Zürich · viven.ch' +
        (p.ref ? ' — Referencia del proyecto: ' + esc(p.ref) + '.' : '') + '</footer>' +
      /* El guion detrás, en su propia página. Va con la hoja para que el equipo lo tenga
         encima sin buscarlo en otro lado — que es lo que pasa siempre.
         (Sebastián, 27 ago 2026: "y agrega el script a rodar tmb para que todos lo tengan".) */
      ((guionAV || guionTxt)
        ? '<div class="guion"><h2>El guion</h2>' +
          (guionTit ? '<p class="gsub">' + esc(guionTit) + '</p>' : '') +
          (guionAV
            ? '<table class="gav"><thead><tr><th>TC</th><th>Video</th><th>Audio</th></tr></thead><tbody>' +
              guionAV.map((b2) => '<tr><td class="tc">' + esc(b2.tc || b2.n || '') + '</td>' +
                '<td>' + esc(b2.video || '') + '</td>' +
                '<td class="au">' + esc(b2.audio || '') + '</td></tr>').join('') +
              '</tbody></table>'
            : '<pre>' + esc(guionTxt) + '</pre>') +
          '</div>'
        : '') +
      '</div></body></html>');
    if (soloHtml) return HTML;
    w.document.write(HTML);
    w.document.close();
    const dale = () => { try { w.focus(); w.print(); } catch (e){ } };
    const img = w.document.querySelector('header img');
    if (img && !img.complete){ img.onload = dale; img.onerror = dale; setTimeout(dale, 2500); }
    else setTimeout(dale, 350);
  }

  /* Mandarlo al equipo: preview primero, siempre. El email lo arma el SERVIDOR con el
     mismo código que manda de verdad, así lo que se ve es lo que sale. */
  let plmT = null, plmVista = 'equipo', plmSel = { equipo: new Set(), cliente: new Set() };
  const PLM_IDIOMA = { es: 'español', en: 'inglés', de: 'alemán' };

  /* Lo que el email necesita para decir lo MISMO que la pantalla: la cabecera calculada
     acá, la sinopsis de cada fila y el equipo con sus teléfonos. Si el servidor lo
     recalculara con su criterio, el email y el dashboard dirían horas distintas. */
  function pjPlanParaEmail(){
    const p = pjCur; if (!p) return {};
    const filas = pjPlanFilas();
    const hh = (f) => String(f.hora || '').match(/^(\d{1,2}):(\d{2})/);
    const conHora = filas.filter(hh);
    const esPrep = (f) => /llegada|montaje|viaje|traslado|carga|preparaci/i.test(String(f.que || ''));
    const ult = conHora[conHora.length - 1];
    let fin = null;
    if (ult){ const m = hh(ult), t = +m[1] * 60 + +m[2] + (Number(ult.dura_min) || 60);
      fin = String(Math.floor(t / 60) % 24).padStart(2, '0') + ':' + String(t % 60).padStart(2, '0'); }
    const L = pjLugar || {};
    return {
      cabecera: {
        cita: conHora.length ? conHora[0].hora : null,
        primera: (conHora.find((f) => !esPrep(f)) || {}).hora || null,
        fin,
        maps: L.maps || null,
        viaje: L.viaje ? L.viaje.min + ' min · ' + L.viaje.km + ' km desde ' + (L.base || '') : null,
        luz: L.luz && L.luz.amanece ? L.luz.amanece + ' – ' + L.luz.atardece : null,
      },
      notas_dia: (pjPlan && pjPlan.notas_dia) || '',
      /* La sinopsis se manda ya resuelta: sale del desglose, que el servidor tendría que
         volver a cruzar con las mismas reglas para llegar al mismo texto. */
      filas_extra: filas.map((f) => ({ sinopsis: pjSinopsisDe(f.escenas) })),
      equipo_lista: (Array.isArray(p.crew) ? p.crew : []).filter((c) => c && c.nombre).map((c) => {
        const t = crewFicha(c.nombre);
        return { nombre: c.nombre, rol: c.rol || '', tel: (t && t.phone) || '', hora: c.hora || '' };
      }),
    };
  }

  async function pjPlanMandar(){
    const p = pjCur; if (!p) return;
    if (!pjPlanFilas().length){ toast('El plan está vacío'); return; }
    $('plm-modal').hidden = false;
    $('plm-sub').textContent = (p.ref ? p.ref + ' · ' : '') + (p.title || '');
    $('plm-msg').value = '';
    $('plm-asunto').value = '';
    const deSel = $('plm-de');
    if (!deSel.options.length){
      deSel.innerHTML = Object.keys(SENDERS).map((k) =>
        '<option value="' + k + '">' + esc(SENDERS[k].name) + ' — ' + esc(SENDERS[k].email) + '</option>').join('');
    }
    deSel.value = localStorage.getItem('viven_ned_de') || sender || 'sofia';
    $('plm-prev').innerHTML = '<p style="color:#8a94a8;margin:0">Armando el email…</p>';
    plmVista = 'equipo';
    plmSel = { equipo: new Set(), cliente: new Set() };
    document.querySelectorAll('[data-plmv]').forEach((b) => b.classList.toggle('on', b.dataset.plmv === 'equipo'));
    plmT = null;
    plmPreview();
  }

  function plmPreview(){
    clearTimeout(plmT);
    plmT = setTimeout(async () => {
      const p = pjCur; if (!p) return;
      const prev = $('plm-prev');
      try {
        const { data, error } = await supabase.functions.invoke('plan-al-equipo', { body: {
          project_id: p.id, de: $('plm-de').value,
          publico: plmVista === 'cliente',
          ...pjPlanParaEmail(),
          asunto: $('plm-asunto').value.trim() || undefined,
          /* El mismo HTML que imprime el botón 📄. El servidor lo pasa a PDF y lo adjunta:
             el navegador no sabe hacer un PDF sin abrirle a alguien el diálogo de imprimir.
             (Sebastián, 26 ago 2026: "que el plan tmb vaya como pdf".) */
          pdf_html: pjPlanPDF({ soloHtml: true }) || undefined,
          mensaje: $('plm-msg').value, dry_run: true } });
        if (error) throw new Error(error.message);
        if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
        $('plm-asunto').value = data.asunto;
        /* Quién lo recibe, con tilde. Al equipo y al cliente les llegan DOS emails
           distintos —no uno con copia— porque el del cliente no lleva lo interno: qué lleva
           cada área, las notas de producción, los riesgos. Mandar el mismo papel es la
           forma más fácil de que lea algo que no le tocaba.
           (Sebastián, 26 ago 2026: "dejame agregar al cliente si quiero, y si no por
           separado para que vea otras cosas que el resto".) */
        const grupo = plmVista;
        const gente = (grupo === 'cliente' ? data.cliente : data.equipo) || [];
        const supuestos = gente.filter((g) => g.idioma_supuesto);
        if (!plmSel[grupo].size) gente.forEach((g) => plmSel[grupo].add(g.email));
        $('plm-para').innerHTML =
          '<div class="plm-quien">' +
            gente.map((g) => '<span class="' + (plmSel[grupo].has(g.email) ? 'on' : 'off') +
              '" data-plmp="' + esc(g.email) + '" title="' + esc(g.email) +
              (g.idioma ? ' — le llega en ' + PLM_IDIOMA[g.idioma] + (g.idioma_supuesto ? ', supuesto por el dominio de su email' : ', según su ficha') : '') + '">' +
              (plmSel[grupo].has(g.email) ? '✓ ' : '') + esc(g.nombre) +
              /* EL IDIOMA, AL LADO DEL NOMBRE. El preview muestra UN email —el del primero de
                 la lista— pero cada uno recibe el suyo. Sin esto, que a alguien le llegue en
                 un idioma que no habla se descubre cuando ya lo recibió, y es el email del
                 día de rodaje. El «?» marca los que no lo tienen cargado en la ficha: ahí el
                 idioma es una apuesta por el dominio del email, no un dato. */
              (g.idioma ? ' <b class="plm-lang' + (g.idioma_supuesto ? ' sup' : '') + '">' +
                 g.idioma.toUpperCase() + (g.idioma_supuesto ? '?' : '') + '</b>' : '') +
              '</span>').join('') +
            (grupo === 'equipo' ? (data.sin_email || []).map((n) =>
              '<span class="no">' + esc(n) + ' · sin email</span>').join('') : '') +
          '</div>' +
          (!gente.length
            ? '<p class="muted-note" style="margin:-6px 0 12px">' + (grupo === 'cliente'
                ? 'El proyecto no tiene contactos con email. Se agregan en el paso Cliente.'
                : 'Ninguno del crew tiene email cargado. Se cargan en Técnicos.') + '</p>'
            : grupo === 'cliente'
              ? '<p class="muted-note" style="margin:-6px 0 12px">Al cliente le llega otra hoja: los horarios, dónde y qué se rueda, y lo que tiene que traer él. Sin lo que lleva cada área ni las notas internas.</p>'
              : (data.sin_email || []).length
                ? '<p class="muted-note" style="margin:-6px 0 12px">A los marcados no les llega: cargales el email en Técnicos.</p>'
                : '') +
          /* Que el adjunto se sepa ANTES, no al recibir el email. */
          (supuestos.length
            ? '<p class="muted-note" style="margin:-6px 0 12px">A ' + supuestos.map((g) => esc(g.nombre)).join(', ') +
              ' le' + (supuestos.length === 1 ? '' : 's') + ' escribimos en ' +
              [...new Set(supuestos.map((g) => PLM_IDIOMA[g.idioma]))].join(' y ') +
              ' porque no tiene' + (supuestos.length === 1 ? '' : 'n') + ' idioma cargado — se corrige en su ficha.</p>'
            : '') +
          (data.llevara_pdf
            ? '<p class="muted-note" style="margin:-6px 0 12px;color:var(--acid)">📄 Va con el plan adjunto en PDF, igual que el que sale del botón 📄.</p>'
            : '<p class="muted-note" style="margin:-6px 0 12px">Sin adjunto: el plan va en el cuerpo del email. El PDF adjunto necesita la clave de Cloudflare — el email sale igual.</p>');
        $('plm-para').querySelectorAll('[data-plmp]').forEach((el) => el.addEventListener('click', () => {
          const e2 = el.dataset.plmp;
          if (plmSel[grupo].has(e2)) plmSel[grupo].delete(e2); else plmSel[grupo].add(e2);
          plmT = 0; plmPreview();
        }));
        /* En un iframe: el email trae sus propios estilos y con innerHTML heredaría los del
           dashboard — se vería distinto de como llega. */
        prev.innerHTML = '<iframe style="width:100%;height:520px;border:0;display:block;background:#f4f5f7"></iframe>';
        prev.querySelector('iframe').srcdoc = data.html;
        $('plm-msgout').textContent = data.responde_a
          ? 'Si contestan, les llega a ' + data.responde_a + '. Nada sale hasta que toques Mandar.'
          : 'Nada sale hasta que toques Mandar.';
      } catch (e){
        prev.innerHTML = '<p style="color:#b00;margin:0">⚠️ ' + esc(e.message || e) + '</p>';
      }
    }, plmT === null ? 0 : 350);
  }

  (function plmBind(){
    const cerrar = () => { $('plm-modal').hidden = true; clearTimeout(plmT); plmT = null; };
    document.addEventListener('click', (e) => {
      if (e.target && (e.target.id === 'plm-x' || e.target.id === 'plm-back' || e.target.id === 'plm-modal')) cerrar();
    });
    document.addEventListener('input', (e) => {
      if (e.target && ['plm-asunto', 'plm-msg'].includes(e.target.id)) plmPreview();
    });
    document.addEventListener('change', (e) => {
      if (e.target && e.target.id === 'plm-de'){ localStorage.setItem('viven_ned_de', e.target.value); plmPreview(); }
    });
    document.addEventListener('click', (e) => {
      if (!e.target || !e.target.dataset || !e.target.dataset.plmv) return;
      plmVista = e.target.dataset.plmv;
      document.querySelectorAll('[data-plmv]').forEach((b) => b.classList.toggle('on', b === e.target));
      $('plm-asunto').value = '';
      plmT = 0; plmPreview();
    });
    document.addEventListener('click', async (e) => {
      if (!e.target || e.target.id !== 'plm-go' || !pjCur) return;
      const b = e.target, out = $('plm-msgout');
      b.disabled = true; out.textContent = 'Enviando…';
      try {
        /* Dos envíos, no uno con copia: son dos hojas distintas. Si solo hay tildados en un
           grupo, sale uno solo. */
        const tandas = [];
        if (plmSel.equipo.size) tandas.push({ publico: false, to: [...plmSel.equipo] });
        if (plmSel.cliente.size) tandas.push({ publico: true, to: [...plmSel.cliente] });
        if (!tandas.length){ out.textContent = '⚠️ No tildaste a nadie'; b.disabled = false; return; }
        /* Se arma UNA vez para las dos tandas: es el mismo plan, y armarlo dos veces son
           dos PDFs pagos por el mismo papel. */
        const pdfHtml = pjPlanPDF({ soloHtml: true });
        let n = 0, notaPdf = null;
        for (const t of tandas){
          const { data, error } = await supabase.functions.invoke('plan-al-equipo', { body: {
            project_id: pjCur.id, de: $('plm-de').value, publico: t.publico, to: t.to,
            ...pjPlanParaEmail(),
            /* El asunto escrito a mano vale solo para la versión que se estaba mirando: la
               otra usa el suyo, que dice otra cosa. */
            asunto: (t.publico === (plmVista === 'cliente')) ? ($('plm-asunto').value.trim() || undefined) : undefined,
            pdf_html: pdfHtml || undefined,
            mensaje: $('plm-msg').value } });
          if (error) throw new Error(error.message);
          if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
          n += (data.para || []).length;
          if (data.pdf_nota) notaPdf = data.pdf_nota;
        }
        out.textContent = '✅ Enviado a ' + n + (notaPdf ? ' · ⚠️ ' + notaPdf : '');
        toast('📤 Plan enviado a ' + n + (tandas.length > 1 ? ' — dos versiones, equipo y cliente' : ''));
        setTimeout(cerrar, 900);
      } catch (e2){ out.textContent = '⚠️ ' + (e2.message || e2); }
      finally { b.disabled = false; }
    });
  })();

  /* ── Quién viene, con su teléfono ──
     En Maestro esto está en la misma hoja porque el teléfono se busca cuando alguien no
     llegó, y ahí no se abre otra pantalla. Sale de la ficha de cada técnico; el que no lo
     tenga cargado sale marcado, no en blanco. */
  /* ── LA PESTAÑA CITACIÓN ──
     Todos los que van al rodaje en una sola lista —equipo y cliente— con su hora editable
     acá mismo. Antes esto era una tarjeta de solo lectura al final de la hoja que decía
     «su hora se carga en el paso Cliente»: para poner una hora había que salir del plan,
     buscar el paso, y volver. Un dato que cuesta cargar no se carga, y el que no se carga
     sale mal en el email del día de rodaje.
     (Sebastián, 29 ago 2026: "poné una pestaña, citación y todas las personas dentro. Ese
     es el lugar correcto".)
     La general es la primera hora del plan; quien tiene la suya la muestra en verde, para
     que se vea de un golpe quién no llega con el resto. */
  /* El cambio de pestaña. Se engancha una sola vez —el plan se redibuja muchas veces— y
     al entrar a Citación se re-renderiza, porque la gente y las horas cambian desde otros
     pasos mientras la pestaña está oculta. */
  let pjpTabsBound = false;
  function pjPlanTabs(){
    const barra = $('pj-plan-tabs'); if (!barra || pjpTabsBound) return;
    pjpTabsBound = true;
    barra.addEventListener('click', (e) => {
      const b = e.target.closest('[data-plantab]'); if (!b) return;
      const cual = b.dataset.plantab;
      barra.querySelectorAll('[data-plantab]').forEach((x) => x.classList.toggle('on', x === b));
      $('pj-plan-dia').hidden = cual !== 'dia';
      $('pj-plan-gente').hidden = cual !== 'cita';
      if (cual === 'cita') pjPlanGenteRender();
    });
  }

  function pjPlanGenteRender(){
    const p = pjCur, box = $('pj-plan-gente'); if (!p || !box) return;
    const crew = Array.isArray(p.crew) ? p.crew.filter((c) => c && c.nombre) : [];
    const conCli = (pjContactos || []).filter((c) => c._on !== false);
    const n = crew.length + conCli.length;
    const chip = $('pjp-cita-n'); if (chip) chip.textContent = n ? '(' + n + ')' : '';
    if (!n){
      box.innerHTML = '<p class="muted-note">Todavía no hay nadie: el equipo se arma en el paso <b>Crew</b> y los del cliente en el paso <b>Cliente</b>.</p>';
      return;
    }

    /* UNA COLUMNA POR JORNADA. Con un solo campo de hora, un rodaje de tres días miente dos
       veces: cada jornada arranca a una hora distinta, y sobre todo NO TODOS VAN TODOS LOS
       DÍAS. Un campo vacío significaba «la general», así que el DP que no trabaja el día 2
       aparecía igual en el plan de ese día — y se enteraba al recibir el email.
       (Sebastián, 29 ago 2026: "¿y qué pasa si son varios días? ¿cómo lo hacemos ahí?")
       La citación general es la primera hora DE ESA JORNADA, no la del plan entero. */
    const jors = pjPlanJornadas()
      .map((b) => ({ nombre: b.dia, general: String(Math.floor(b.desde / 60)).padStart(2, '0') + ':' + String(b.desde % 60).padStart(2, '0') }));
    const dias = jors.length ? jors : [{ nombre: 'Jornada 1', general: '' }];
    const unSoloDia = dias.length === 1;

    /* Dónde vive la hora de alguien ese día. `horas` es el mapa nuevo; `hora` es el valor
       viejo de una sola jornada y se sigue leyendo para la primera, para no perder lo ya
       cargado. */
    const horaDe = (x, i2) => {
      const m = x && x.horas;
      if (m && Object.prototype.hasOwnProperty.call(m, dias[i2].nombre)) return m[dias[i2].nombre];
      return i2 === 0 ? (x && x.hora) || '' : '';
    };

    /* De 04:00 a 23:45 de a 15 minutos, que es como se cita a alguien a un rodaje. Si ya
       tiene una hora que no cae en el cuarto, se agrega para no perderla al abrir. */
    /* Con varias jornadas la hora general ya está en el encabezado de la columna, así que
       la opción dice solo «la general»: repetirla no cabía —salía «la general (08…»— y
       encima duplicaba el dato. Con un solo día no hay encabezado, así que ahí sí va. */
    const opciones = (valor, general) => {
      const actual = valor && valor !== 'no' ? String(valor).slice(0, 5) : '';
      const horas = [];
      for (let h = 4; h <= 23; h++) for (const mm of ['00', '15', '30', '45'])
        horas.push(String(h).padStart(2, '0') + ':' + mm);
      if (actual && !horas.includes(actual)) horas.push(actual);
      horas.sort();
      return '<option value=""' + (!valor ? ' selected' : '') + '>' +
          ((general && unSoloDia) ? 'la general (' + esc(general) + ')' : 'la general') + '</option>' +
        /* «No viene» es una respuesta, no un vacío: es la diferencia entre «llega a la hora
           de todos» y «ese día no está». Sin esta opción, la segunda se escribe como la
           primera y sale en el plan. */
        '<option value="no"' + (valor === 'no' ? ' selected' : '') + '>— no viene —</option>' +
        horas.map((t) => '<option value="' + t + '"' + (t === actual ? ' selected' : '') + '>' + t + '</option>').join('');
    };

    const celdas = (clave, id, x) => dias.map((d, i2) => {
      const v = horaDe(x, i2);
      return '<select class="pj-inp pj-cita-h' + (v === 'no' ? ' fuera' : (v ? ' propia' : '')) + '"' +
        ' data-cita="' + clave + '" data-id="' + esc(String(id)) + '" data-dia="' + esc(d.nombre) + '"' +
        ' title="' + esc(d.nombre) + (d.general ? ' — la general es ' + esc(d.general) : '') + '">' +
        opciones(v, d.general) + '</select>';
    }).join('');

    const fila = (clave, id, nombre, rol, tel, mail, x) =>
      '<div class="pj-cita-row">' +
        '<span class="n">' + esc(nombre) + '</span>' +
        '<span class="r">' + esc(rol || '') + '</span>' +
        '<span class="t' + (tel ? '' : ' no') + '">' + (tel ? esc(tel) : 'sin teléfono') + '</span>' +
        '<span class="t' + (mail ? '' : ' no') + '">' + (mail ? esc(mail) : 'sin email') + '</span>' +
        celdas(clave, id, x) +
      '</div>';

    const cab = unSoloDia ? '' :
      '<div class="pj-cita-row pj-cita-cab"><span class="n"></span><span class="r"></span><span class="t"></span><span class="t"></span>' +
      dias.map((d) => '<span class="jh">' + esc(d.nombre.replace(/^Jornada /, 'J')) + (d.general ? '<em>' + esc(d.general) + '</em>' : '') + '</span>').join('') +
      '</div>';

    box.style.setProperty('--cita-dias', String(dias.length));
    box.innerHTML =
      '<p class="muted-note" style="margin:0 0 12px">' +
        (unSoloDia
          ? (dias[0].general
              ? 'La citación general es <b>' + esc(dias[0].general) + '</b> —la primera hora del plan—. Poné una hora solo para quien llegue distinto.'
              : 'Cargá el cronograma y su primera hora pasa a ser la citación general.')
          : 'Son <b>' + dias.length + ' jornadas</b>, cada una con su propia citación general. Poné una hora solo para quien llegue distinto ese día, y <b>«no viene»</b> para quien ese día no trabaja.') +
        ' Va en el plan y en el email de cada uno.</p>' +
      (crew.length ? '<div class="pj-sec-h">Equipo</div>' + cab + crew.map((c, i2) => {
        const t = crewFicha(c.nombre);
        return fila('crew', i2, c.nombre, c.rol, t && t.phone, t && t.email, c);
      }).join('') : '') +
      (conCli.length ? '<div class="pj-sec-h">Del cliente</div>' + (crew.length ? cab : '') + conCli.map((c) =>
        fila('cli', c.id, c.name || c.email, PJ_RECIBE.reduce((a, [k, l]) => k === c.recibe ? l : a, ''),
             c.phone, c.email, c)).join('') : '') +
      (crew.some((c) => { const t = crewFicha(c.nombre); return !t || !t.phone; })
        ? '<p class="muted-note" style="margin:11px 0 0">Los que salen «sin teléfono» van así en la hoja. Se cargan en <b>Técnicos</b>.</p>' : '');

    box.querySelectorAll('[data-cita]').forEach((sel) => sel.addEventListener('change', async () => {
      const val = sel.value || null;
      const dia = sel.dataset.dia;
      sel.classList.toggle('propia', !!val && val !== 'no');
      sel.classList.toggle('fuera', val === 'no');
      const guardar = (x) => {
        x.horas = x.horas && typeof x.horas === 'object' ? x.horas : {};
        if (val === null) delete x.horas[dia]; else x.horas[dia] = val;
        /* `hora` se mantiene en espejo para la primera jornada: lo leen el plan, el PDF y
           el email, que todavía piensan en un solo día. Cuando pasen a leer `horas`, se
           saca de acá y no antes — mientras tanto, dos lugares diciendo lo mismo es mejor
           que uno diciendo algo viejo. */
        if (dia === dias[0].nombre) x.hora = (val && val !== 'no') ? val : null;
        return x;
      };
      if (sel.dataset.cita === 'crew'){
        const arr = Array.isArray(pjCur.crew) ? pjCur.crew.filter((c) => c && c.nombre) : [];
        const c = arr[Number(sel.dataset.id)]; if (!c) return;
        guardar(c);
        const { error } = await supabase.from('projects').update({ crew: pjCur.crew }).eq('id', pjCur.id);
        if (error){ toast('⚠️ ' + error.message); return; }
      } else {
        const c = (pjContactos || []).find((x) => String(x.id) === sel.dataset.id); if (!c) return;
        guardar(c);
        const { error } = await supabase.from('project_contacts')
          .update({ horas: c.horas, hora: c.hora }).eq('id', c.id);
        if (error){ toast('⚠️ ' + error.message); return; }
      }
      pjPlanCabRender && pjPlanCabRender();
    }));
  }



  /* ── LAS HORAS SE RECALCULAN ──
     Escribís cuánto dura cada bloque y las horas salen solas: cada uno empieza cuando
     termina el anterior. Si alargás uno de 60′ a 90′, todo lo de abajo se corre media hora.
     Antes había que retipear las horas una por una — así se llega al set con dos que no
     cierran.

     Una hora escrita A MANO queda FIJA: no se mueve aunque lo de arriba se estire, y a
     partir de ella el reloj arranca de nuevo. Es la diferencia entre una consecuencia y una
     decisión: «la cocina se libera a las 11» no se corre porque el montaje tardó más — se
     corre todo lo demás, y si llega a pisarla, se avisa.
     (Sebastián, 26 ago 2026: "si cambio tiempo a mano, el resto se tiene que adaptar".) */
  const pjHoraMin = (h) => {
    const m = String(h || '').match(/^(\d{1,2}):(\d{2})/);
    return m ? +m[1] * 60 + +m[2] : null;
  };
  const pjMinHora = (t) => String(Math.floor((t % 1440 + 1440) % 1440 / 60)).padStart(2, '0') +
    ':' + String(((t % 60) + 60) % 60).padStart(2, '0');

  /* Devuelve los índices cuya hora quedó pisada por el bloque de arriba. No los mueve: una
     hora fija es una decisión de alguien, y correrla en silencio es peor que avisar. */
  function pjPlanRecalcular(){
    const filas = pjPlanFilas();
    if (!filas.length) return [];
    let reloj = pjHoraMin(filas[0].hora);
    if (reloj == null) return [];
    const pisados = [];
    filas.forEach((f, i) => {
      const propia = pjHoraMin(f.hora);
      if (i === 0 || f.fija){
        /* Fija: manda ella. Si el bloque anterior la pasó, se anota y sigue. */
        if (propia != null){
          if (i > 0 && reloj > propia) pisados.push(i);
          reloj = propia;
        }
      } else {
        f.hora = pjMinHora(reloj);
      }
      reloj += Number(f.dura_min) || 0;
    });
    return pisados;
  }

  function pjPlanMover(i, d){
    const f = pjPlanFilas(); const j = i + d;
    if (j < 0 || j >= f.length) return;
    const t = f[i]; f[i] = f[j]; f[j] = t;
    pjPlanRecalcular();
    pjPlanRender(); pjPlanGuardar();
  }

  function pjPlanBorrarFila(i){
    const f = pjPlanFilas();
    if (!f[i]) return;
    /* Sin confirmación: es una fila de una tabla y volver a escribirla cuesta menos que
       leer un cartel. Lo que sí se confirma es reemplazar el plan entero. */
    f.splice(i, 1);
    pjPlanRecalcular();
    pjPlanRender(); pjPlanGuardar();
  }

  async function pjPlanFilaNueva(){
    const p = pjCur; if (!p) return;
    const f = pjPlanFilas();
    /* Hereda el bloque de la última fila: agregar tres cosas a la misma jornada es el
       caso normal, y volver a tipear "Jornada 1 · Mañana" cada vez es trabajo tonto. */
    const ult = f[f.length - 1] || {};
    f.push({ bloque: ult.bloque || 'Jornada 1', hora: '', que: '', donde: ult.donde || '', quien: '', escenas: '', notas: '' });
    if (!pjPlan){
      const { data, error } = await supabase.from('project_scripts').insert({
        project_id: p.id, tipo: 'plan', formato: 'plan', titulo: 'Plan de rodaje', cuerpo: f,
      }).select().single();
      if (error){ toast(error.message); return; }
      pjPlan = data;
    }
    pjPlan.cuerpo = f;
    pjPlanRender(); pjPlanGuardar();
    const ins = $('pj-plan-tabla').querySelectorAll('.c-que textarea');
    if (ins.length) ins[ins.length - 1].focus();
  }

  function pjPlanGuardarDebounce(){ clearTimeout(pjPlanT); pjPlanT = setTimeout(pjPlanGuardar, 700); }

  /* Se guarda solo mientras editás. En proyectos ya pasó lo contrario y Sebastián lo
     cortó: "si cambio, borro o hago algo pero no toco guardar, guardalo igual". */
  async function pjPlanGuardar(){
    const p = pjCur; if (!p || !pjPlan) return;
    const filas = pjPlanFilas().map((f, i) => ({ ...f, n: i + 1 }));
    const { error } = await supabase.from('project_scripts').update({
      cuerpo: filas,
      premisa: [pjPlan.notas_dia ? 'Notas del día:\n' + pjPlan.notas_dia : '',
                pjPlan.necesita_txt ? '\nHay que conseguir antes:\n' + pjPlan.necesita_txt : '',
                pjPlan.riesgos_txt ? '\nOjo con:\n' + pjPlan.riesgos_txt : ''].filter(Boolean).join('\n'),
    }).eq('id', pjPlan.id);
    if (error){ toast(error.message); return; }
    /* El campo viejo de una línea sigue existiendo y hay cosas que lo leen. Se mantiene
       al día con un resumen en texto para que nada se quede mirando un plan viejo. */
    const txt = pjPlanTexto();
    $('pj-plan').value = txt;
    await supabase.from('projects').update({ shooting_plan: txt || null }).eq('id', p.id);
    p.shooting_plan = txt;
  }

  function pjPlanTexto(){
    const f = pjPlanFilas();
    if (!f.length) return '';
    let blq = null;
    const cuerpo = f.map((r) => {
      let out = '';
      if (String(r.bloque || '') !== blq){ blq = String(r.bloque || ''); out += (out ? '' : '') + '\n' + blq + '\n'; }
      return out + [r.hora, r.que, r.donde && '· ' + r.donde, r.quien && '· ' + r.quien].filter(Boolean).join('  ') +
        (r.lleva ? '\n      Llevar: ' + r.lleva : '') +
        (r.notas ? '\n      (' + r.notas + ')' : '');
    }).join('\n').trim();
    const extra = [pjPlan && pjPlan.necesita_txt ? '\n\nHAY QUE CONSEGUIR ANTES:\n' + pjPlan.necesita_txt : '',
                   pjPlan && pjPlan.riesgos_txt ? '\n\nOJO CON:\n' + pjPlan.riesgos_txt : ''].join('');
    return cuerpo + extra;
  }

  /* Pedirla NO guarda nada: vuelve la propuesta entera y se ve antes de decidir. Es la
     única forma de que "regenerar" sea seguro cuando ya corregiste el plan a mano. */
  async function pjPlanPedir(){
    const p = pjCur; if (!p) return;
    const btn = $('pj-plan-ia'), prev = btn.textContent, nota = $('pj-plan-note');
    btn.disabled = true; btn.textContent = '📅 Armando…';
    /* Si el desglose no está hecho, el plan sale sin la columna de qué llevar: se avisa
       antes, no después de mirarlo y preguntarse por qué está vacía. */
    nota.textContent = (p.breakdown && (p.breakdown.escenas || []).some((e) => (e.elementos || []).length))
      ? 'No se guarda nada: primero la ves.'
      : 'Ojo: sin desglose hecho, el plan no va a saber qué hay que llevar a cada bloque.';
    try {
      const { data, error } = await supabase.functions.invoke('ai-guion', { body: {
        project_id: p.id, tipo: 'plan',
        indicaciones: $('pj-plan-ind').value.trim() || undefined,
        plan_actual: pjPlanFilas().length ? pjPlanFilas() : undefined,
      } });
      if (error) throw new Error(error.message);
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
      pjPlanProp = data.propuesta;
      nota.textContent = '';
      pjPlanRender();
      $('pj-plan-prop').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } catch (e){
      nota.textContent = '⚠️ ' + (e.message || e);
    } finally { btn.disabled = false; btn.textContent = prev; }
  }

  async function pjPlanGuardarProp(reemplazar){
    const p = pjCur; if (!p || !pjPlanProp) return;
    const nuevas = (pjPlanProp.filas || []).map((f) => ({ ...f }));
    const filas = reemplazar ? nuevas : pjPlanFilas().concat(nuevas);
    if (reemplazar && pjPlanFilas().length &&
        !confirm('El plan que hay ahora se reemplaza por la propuesta.\n\nLo que corregiste a mano se pierde. ¿Seguimos?')) return;

    const nec = (pjPlanProp.necesita || []).join('\n');
    const rie = (pjPlanProp.riesgos || []).join('\n');
    if (!pjPlan){
      const { data, error } = await supabase.from('project_scripts').insert({
        project_id: p.id, tipo: 'plan', formato: 'plan',
        titulo: pjPlanProp.titulo || 'Plan de rodaje', cuerpo: filas,
      }).select().single();
      if (error){ toast(error.message); return; }
      pjPlan = data;
      pjPlan.necesita_txt = nec; pjPlan.riesgos_txt = rie;
    } else {
      pjPlan.cuerpo = filas;
      /* Al agregar abajo, lo que ya estaba escrito en las listas no se pisa: se suma. */
      pjPlan.necesita_txt = reemplazar ? nec : [pjPlan.necesita_txt, nec].filter(Boolean).join('\n');
      pjPlan.riesgos_txt = reemplazar ? rie : [pjPlan.riesgos_txt, rie].filter(Boolean).join('\n');
    }
    pjPlanProp = null;
    pjPlanRender();
    await pjPlanGuardar();
    $('pj-plan-blq').open = true;
    toast('📅 Plan guardado — tocá cualquier campo para corregirlo');
  }

  function pjRenderDesglose(){
    const p = pjCur; if (!p) return;
    $('pj-script-text').value = p.script_text || '';
    const b = p.breakdown;
    const est = $('pj-guion-est');
    if (est) est.textContent = b
      ? (b.escenas || []).length + ' escenas · desglosado el ' + fmtDMY(p.breakdown_at)
      : (p.script_text ? 'guión cargado, sin desglosar' : 'sin guión');
    $('pj-plan-gen').hidden = !(b && (b.jornadas || []).length);
    const box = $('pj-desglose');
    if (!b){ box.innerHTML = ''; return; }

    const chips = (arr) => (arr || []).map((x) => '<span class="pj-chipn">' + esc(x) + '</span>').join('');
    const necesita = Object.keys(PJ_NEC_LBL).filter((k) => (b.necesidades || {})[k] && b.necesidades[k].length);
    /* Si el desglose es de antes de las fichas, `necesidades_detalle` no existe: se sigue
       mostrando el formato viejo en vez de dejar la sección vacía. */
    const det = Object.keys(PJ_NEC_LBL).filter((k) => ((b.necesidades_detalle || {})[k] || []).length);

    /* Los avisos van PRIMERO. Son lo único del desglose que cambia una decisión hoy:
       lo que falta definir y —sobre todo— lo que el guión pide y no está presupuestado. */
    const sinPresu = (b.avisos || []).filter((a) => /no est[áa] presupuestad/i.test(a));
    const otros = (b.avisos || []).filter((a) => !/no est[áa] presupuestad/i.test(a));

    box.innerHTML =
      (b.sinopsis ? '<p class="muted-note" style="margin:14px 0 0;font-size:13.5px">' + esc(b.sinopsis) + '</p>' : '') +
      (sinPresu.length
        ? '<div class="pj-avisos plata"><b>💸 El guión pide cosas que no están presupuestadas</b><ul>' +
          sinPresu.map((a) => '<li>' + esc(a) + '</li>').join('') + '</ul></div>' : '') +
      (otros.length
        ? '<div class="pj-avisos"><b>❓ Falta definir</b><ul>' +
          otros.map((a) => '<li>' + esc(a) + '</li>').join('') + '</ul></div>' : '') +

      /* Cada cosa con su ficha, no una palabra suelta. Un chip que dice "Laptop" no dice
         cuántas, de quién, dónde entra ni quién la trae — y esas cuatro son las únicas
         preguntas que importan en el set.
         (Sebastián, 26 ago 2026: "pensá más como Maestro… todo dentro de cada escena,
         cada ítem tiene su propia info adentro, para saber qué, quién, dónde, cuánto".) */
      (det.length ? '<div class="pj-sec-h">Todo lo que hay que conseguir</div>' +
        det.map((k) => '<div class="pj-necg"><div class="cat">' + PJ_NEC_LBL[k] + '</div>' +
          '<div class="lead-table-wrap"><table class="pj-nect"><tbody>' +
          (b.necesidades_detalle[k] || []).map((x) =>
            '<tr><td class="q">' + (Number(x.cantidad) > 1 ? '<b>' + x.cantidad + '×</b> ' : '') + esc(x.que) + '</td>' +
            '<td class="w">' + (x.quien ? esc(x.quien) : '') + '</td>' +
            '<td class="a">' + (x.area ? '<span class="pj-area">' + esc(x.area) + '</span>' : '') + '</td>' +
            '<td class="e">' + ((x.escenas || []).length ? 'esc. ' + x.escenas.join(', ') : '') + '</td></tr>').join('') +
          '</tbody></table></div></div>').join('') : '') +
      (!det.length && necesita.length ? '<div class="pj-sec-h">Todo lo que hay que conseguir</div>' +
        '<div class="pj-nec">' + necesita.map((k) =>
          '<div><span class="k">' + PJ_NEC_LBL[k] + '</span><div>' + chips(b.necesidades[k]) + '</div></div>').join('') +
        '</div>' : '') +

      ((b.jornadas || []).length ? '<div class="pj-sec-h">Jornadas sugeridas</div>' +
        '<div class="pj-jor">' + b.jornadas.map((j) =>
          '<div class="pj-jor-d"><b>Día ' + j.dia + (j.horas_estimadas ? ' · ' + j.horas_estimadas + ' h' : '') + '</b>' +
          '<div class="loc">' + esc(j.locacion || 'Locación sin definir') + '</div>' +
          '<div class="esc">Escenas ' + (j.escenas || []).join(', ') + '</div>' +
          (j.notas ? '<div class="notas">' + esc(j.notas) + '</div>' : '') + '</div>').join('') +
        '</div>' : '') +

      ((b.escenas || []).length ? '<div class="pj-sec-h">Escena por escena</div>' +
        b.escenas.map((e) => '<details class="pj-esc"><summary>' +
          '<b>#' + e.n + '</b> ' + esc(e.titulo) +
          '<em>' + [e.int_ext, e.dia_noche, e.locacion].filter(Boolean).map(esc).join(' · ') +
          (e.duracion_s ? ' · ' + e.duracion_s + 's' : '') + '</em></summary>' +
          (e.resumen ? '<p class="muted-note" style="margin:8px 0">' + esc(e.resumen) + '</p>' : '') +
          /* Los elementos de la escena, cada uno con lo suyo. La evidencia es la frase del
             guion que lo justifica: si el desglose dice que hace falta algo, se puede ver
             de dónde lo sacó sin volver a leer el guion. */
          ((e.elementos || []).length
            ? '<div class="lead-table-wrap"><table class="pj-nect pj-elem"><thead><tr>' +
              '<th>Qué</th><th>Quién</th><th>Dónde</th><th>Lo trae</th><th>Del guion</th></tr></thead><tbody>' +
              e.elementos.map((el) => '<tr><td class="q">' +
                (Number(el.cantidad) > 1 ? '<b>' + el.cantidad + '×</b> ' : '') + esc(el.que) +
                '<span class="pj-tipo">' + esc((PJ_NEC_LBL[el.tipo] || el.tipo).replace(/^\S+\s/, '')) + '</span></td>' +
                '<td class="w">' + esc(el.quien || '') + '</td>' +
                '<td class="w">' + esc(el.donde || '') + '</td>' +
                '<td class="a">' + (el.quien_lo_consigue ? '<span class="pj-area">' + esc(el.quien_lo_consigue) + '</span>' : '') + '</td>' +
                '<td class="ev">' + (el.evidencia ? '«' + esc(el.evidencia) + '»' : '') + '</td></tr>').join('') +
              '</tbody></table></div>'
            : ['personajes', 'props', 'vestuario', 'arte', 'maquillaje', 'sonido', 'equipo_especial', 'post']
                .filter((k) => (e[k] || []).length)
                .map((k) => '<div class="pj-esc-kv"><span>' + PJ_NEC_LBL[k] + '</span><div>' + chips(e[k]) + '</div></div>').join('')) +
          ((e.planos || []).length ? '<div class="lead-table-wrap" style="margin-top:10px"><table class="lead-table">' +
            '<thead><tr><th>Plano</th><th>Tipo</th><th>Movimiento</th><th>Qué pasa</th><th style="text-align:right">seg</th></tr></thead><tbody>' +
            e.planos.map((s2) => '<tr><td><b>' + esc(s2.n) + '</b></td><td>' + esc(s2.tipo) + '</td><td>' + esc(s2.movimiento) +
              '</td><td>' + esc(s2.descripcion) + '</td><td style="text-align:right">' + (s2.duracion_s || '') + '</td></tr>').join('') +
            '</tbody></table></div>' : '') +
        '</details>').join('') : '');
  }

  async function pjDesglosar(){
    const p = pjCur; if (!p) return;
    const guion = $('pj-script-text').value.trim();
    if (guion.length < 80){ toast('Pegá el guión primero — con menos de 80 caracteres no hay nada que desglosar'); return; }
    const btn = $('pj-desglosar'), prev = btn.textContent;
    btn.disabled = true; btn.textContent = '✨ Desglosando…';
    /* Tarda cerca de un minuto: decirlo evita que se toque el botón cuatro veces. */
    $('pj-desglose-note').textContent = 'Leyendo el guión escena por escena, y después los planos de cada una. Tarda un minuto o dos.';
    try {
      const { data, error } = await supabase.functions.invoke('ai-breakdown', {
        body: { project_id: p.id, script: guion, lang: 'es' },
      });
      if (error || !data || data.error) throw new Error((data && data.error) || error.message || 'sin respuesta');
      p.script_text = guion;
      p.breakdown = data.breakdown;
      p.breakdown_at = new Date().toISOString();
      /* Si algún lote de planos falló, se dice: un desglose al que le faltan planos y no
         lo avisa se lleva al set como si estuviera completo. */
      $('pj-desglose-note').textContent = data.aviso_guardado
        ? '⚠️ Desglosado, pero no se pudo guardar: ' + data.aviso_guardado
        : data.aviso_planos ? '✅ Desglosado · ⚠️ ' + data.aviso_planos
        : '✅ Desglosado';
      pjRenderDesglose();
    } catch (e){
      $('pj-desglose-note').textContent = '⚠️ ' + (e.message || e);
    } finally {
      btn.disabled = false; btn.textContent = prev;
    }
  }

  /* Las jornadas se pasan al plan de rodaje como TEXTO editable, no como otra tabla:
     el plan es lo que se imprime y se manda, y siempre termina con cosas a mano
     (horarios de catering, quién trae qué, el teléfono del contacto en la locación). */
  function pjPlanDesdeJornadas(){
    const p = pjCur, b = p && p.breakdown; if (!b || !(b.jornadas || []).length) return;
    const lineas = b.jornadas.map((j) => {
      const escs = (j.escenas || []).map((n) => {
        const e = (b.escenas || []).find((x) => x.n === n);
        return e ? '   · Esc ' + e.n + ' — ' + e.titulo + (e.int_ext ? ' (' + e.int_ext + '/' + e.dia_noche + ')' : '') : '   · Esc ' + n;
      }).join('\n');
      return 'DÍA ' + j.dia + (j.horas_estimadas ? ' · ' + j.horas_estimadas + ' h' : '') + '\n' +
        '   Locación: ' + (j.locacion || 'por definir') + '\n' + escs +
        (j.notas ? '\n   Nota: ' + j.notas : '');
    }).join('\n\n');
    const actual = $('pj-plan').value.trim();
    if (actual && !confirm('Ya hay algo escrito en el plan de rodaje.\n\n¿Reemplazarlo por las jornadas del desglose?')) return;
    $('pj-plan').value = lineas;
    toast('📅 Jornadas pasadas al plan — revisalo y guardá');
    /* Antes scrolleaba hasta el input; ahora ese input está escondido, así que lleva a la
       tabla del plan, que es donde de verdad se revisa. */
    const blq = $('pj-plan-blq');
    if (blq){ blq.open = true; blq.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
  }

  /* ---------- COSTO REAL DEL PROYECTO (SQL 0154) ----------
     El catálogo de servicios tiene un costo de referencia y encima solo 8 de 25 lo
     tienen cargado. Lo que costó un proyecto depende de a quién contrataste ESA vez:
     "dejame cargar los costos por proyecto por si cambia el crew" (Sebastián, 26 ago).
     Acá el costo es un hecho del proyecto, no del catálogo. */
  let pjCostos = [];
  const PJ_KINDS = [['crew', '👥 Crew'], ['equipo', '🎥 Equipo'], ['otros', '📦 Otros']];
  /* Las unidades del presupuesto están en alemán porque así se factura en Suiza.
     En singular para el encabezado ("costo por día") y con su traducción a la vista. */
  const PJ_UNIT_1 = { tag: 'día', std: 'hora', stk: 'unidad', fix: 'total', pauschal: 'total',
    person: 'persona', sprache: 'idioma', monat: 'mes', woche: 'semana' };
  const PJ_UNIT_N = { tag: 'días', std: 'horas', stk: 'unidades', fix: 'precio cerrado', pauschal: 'precio cerrado',
    person: 'personas', sprache: 'idiomas', monat: 'meses', woche: 'semanas' };
  const pjUnidad = (u, n) => {
    const k = String(u || '').toLowerCase();
    const trad = (Number(n) === 1 ? PJ_UNIT_1 : PJ_UNIT_N)[k];
    return u ? (trad ? u + ' (' + trad + ')' : u) : '';
  };
  const pjCostoTotal = (c) => (Number(c.qty) || 0) * (Number(c.unit_cost) || 0);

  async function pjCostosLoad(){
    const p = pjCur; if (!p) return;   // devuelve promesa: las facturas se cargan después, para poder cruzarlas con los costos
    const { data, error } = await supabase.from('project_costs').select('*')
      .eq('project_id', p.id).order('sort').order('id');
    pjCostos = (error ? [] : (data || []));
    pjCostosRender();
  }

  function pjCostosRender(){
    const p = pjCur; if (!p) return;
    const vendido = Number(p.amount_chf) || 0;
    const costo = pjCostos.reduce((a, c) => a + pjCostoTotal(c), 0);
    const pagado = pjCostos.filter((c) => c.paid).reduce((a, c) => a + pjCostoTotal(c), 0);
    const sinCargar = pjCostos.filter((c) => !(Number(c.unit_cost) > 0)).length;
    const margen = vendido - costo;
    const pct = vendido ? Math.round(margen / vendido * 100) : null;

    /* El margen con líneas en cero NO es el margen: es un techo. Decirlo con el número
       de líneas que faltan es la diferencia entre un dato y una ilusión. */
    const confiable = pjCostos.length > 0 && sinCargar === 0;
    const col = margen < 0 ? '#ff8b8b' : confiable ? 'var(--acid)' : '#f0c060';
    $('pj-margen').innerHTML = !pjCostos.length
      ? '<p class="muted-note" style="margin:0 0 12px">Sin costos cargados. Traelos del presupuesto y ajustá lo que cambió — el margen se calcula solo.</p>'
      : '<div class="pj-margen-box">' +
          '<div><span>Vendido</span><b>' + pjCHF(vendido) + '</b></div>' +
          '<div><span>Costo' + (pagado ? ' · ' + pjCHF(pagado) + ' ya pagado' : '') + '</span><b>' + pjCHF(costo) + '</b></div>' +
          '<div><span>Margen' + (pct != null ? ' · ' + pct + '%' : '') + '</span><b style="color:' + col + '">' + pjCHF(margen) + '</b></div>' +
        '</div>' +
        (sinCargar
          ? '<p class="muted-note" style="margin:8px 0 12px;color:#f0c060">⚠️ ' + sinCargar +
            (sinCargar === 1 ? ' línea todavía en cero' : ' líneas todavía en cero') +
            ' — hasta cargarlas, ese margen es un techo y no el margen real.</p>'
          : '<p class="muted-note" style="margin:8px 0 12px">Todas las líneas tienen costo — este margen es el real.</p>');

    if (!pjCostos.length){ $('pj-costos').innerHTML = ''; return; }
    $('pj-costos').innerHTML = '<table class="lead-table"><thead><tr>' +
      '<th>Concepto</th><th>Quién</th><th>Tipo</th><th style="text-align:right">Cantidad</th>' +
      '<th style="text-align:right">Costo por unidad</th><th style="text-align:right">Total</th><th>Pagado</th><th></th>' +
      '</tr></thead><tbody>' +
      pjCostos.map((c) => '<tr data-c="' + c.id + '">' +
        '<td data-l="Concepto"><input class="pj-inp pj-c" data-f="concept" value="' + esc(c.concept || '') + '" /></td>' +
        '<td data-l="Quién"><input class="pj-inp pj-c" data-f="person" value="' + esc(c.person || '') + '" placeholder="quién" /></td>' +
        '<td data-l="Tipo"><select class="pj-inp pj-c" data-f="kind">' + PJ_KINDS.map(([k, l]) =>
            '<option value="' + k + '"' + (c.kind === k ? ' selected' : '') + '>' + l + '</option>').join('') + '</select></td>' +
        /* La unidad va PEGADA a la cantidad: "3" no dice nada, "3 Tag" sí. Venía del
           presupuesto y se estaba tirando. (Sebastián, 26 ago: "poné si son horas o
           días, así entendemos mejor".) */
        '<td data-l="Cantidad" style="text-align:right"><span class="pj-qty">' +
          '<input class="pj-inp pj-c pj-num" data-f="qty" type="number" step="0.5" value="' + (Number(c.qty) || 0) + '" />' +
          '<input class="pj-inp pj-c pj-unit" data-f="unit" list="pj-units" value="' + esc(c.unit || '') + '" placeholder="unid." title="Tag = día · Std = hora · Fix = precio cerrado" />' +
        '</span></td>' +
        '<td data-l="Costo por ' + esc(PJ_UNIT_1[String(c.unit || '').toLowerCase()] || (c.unit || 'unidad')) + '" style="text-align:right"><input class="pj-inp pj-c pj-num" data-f="unit_cost" inputmode="decimal" value="' + (Number(c.unit_cost) || 0) + '" /></td>' +
        '<td data-l="Total" style="text-align:right;white-space:nowrap"><b>' + Math.round(pjCostoTotal(c)).toLocaleString('de-CH') + '</b>' +
          (c.unit ? '<small class="pj-uhint">' + esc((Number(c.qty) || 0) + ' ' + (PJ_UNIT_N[String(c.unit).toLowerCase()] || c.unit)) + '</small>' : '') + '</td>' +
        '<td data-l="Pagado" style="text-align:center"><input type="checkbox" class="pj-c" data-f="paid"' + (c.paid ? ' checked' : '') + ' /></td>' +
        '<td><button class="pj-crew-x" data-del="' + c.id + '" type="button" title="Borrar la línea">✕</button></td>' +
      '</tr>').join('') + '</tbody></table>';

    /* Se guarda al salir del campo, no en cada tecla: escribir "1200" son cuatro
       teclas y serían cuatro escrituras a la base. */
    $('pj-costos').querySelectorAll('.pj-c').forEach((el) => {
      const ev = el.type === 'checkbox' || el.tagName === 'SELECT' ? 'change' : 'blur';
      el.addEventListener(ev, () => pjCostoGuardar(el));
    });
    $('pj-costos').querySelectorAll('[data-del]').forEach((b) => b.addEventListener('click', () => pjCostoBorrar(b.dataset.del)));
  }

  async function pjCostoGuardar(el){
    const tr = el.closest('[data-c]'); if (!tr) return;
    const id = tr.dataset.c, f = el.dataset.f;
    const c = pjCostos.find((x) => String(x.id) === String(id)); if (!c) return;
    let v = el.type === 'checkbox' ? el.checked : el.value;
    /* El costo de una jornada de DoP se escribe "1'100" o "1.100": el mismo parser que
       el resto de la plata, o vuelve a pasar lo de los sueldos. */
    if (f === 'qty' || f === 'unit_cost') v = numCHF(v);
    if (c[f] === v) return;
    const { error } = await supabase.from('project_costs').update({ [f]: v }).eq('id', id);
    if (error){ toast('⚠️ ' + error.message); return; }
    c[f] = v;
    pjCostosRender();
  }
  async function pjCostoBorrar(id){
    const c = pjCostos.find((x) => String(x.id) === String(id));
    if (!confirm('¿Borrar la línea "' + (c ? c.concept : '') + '"?')) return;
    const { error } = await supabase.from('project_costs').delete().eq('id', id);
    if (error){ toast('⚠️ ' + error.message); return; }
    pjCostos = pjCostos.filter((x) => String(x.id) !== String(id));
    pjCostosRender();
  }
  async function pjCostoAdd(){
    const p = pjCur; if (!p) return;
    const { data, error } = await supabase.from('project_costs')
      .insert({ project_id: p.id, concept: '', kind: 'crew', qty: 1, unit_cost: 0, sort: pjCostos.length + 100 })
      .select().single();
    if (error){ toast('⚠️ ' + error.message); return; }
    pjCostos.push(data);
    pjCostosRender();
    const ult = $('pj-costos').querySelector('tr:last-child input[data-f="concept"]');
    if (ult) ult.focus();
  }
  async function pjCostosSembrar(){
    const p = pjCur; if (!p) return;
    if (pjCostos.length && !confirm('Ya hay costos cargados. Traer del presupuesto no los pisa — solo avisa si no hay nada.\n\n¿Seguir igual?')) return;
    const { data, error } = await supabase.rpc('sembrar_costos_proyecto', { p_project: p.id });
    if (error){ toast('⚠️ ' + error.message + ' (¿corriste la SQL 0154?)'); return; }
    if (!data){ toast('Ya tenía costos cargados — no se tocó nada'); return; }
    toast('💸 ' + data + ' líneas traídas del presupuesto');
    pjCostosLoad();
  }

  function pjRenderPortal(){
    const p = pjCur, box = $('pj-portal'); if (!box) return;
    const d = pjDealYa(p);
    /* Si el deal todavía no está en memoria —los de prueba nunca entran a dealsList— se
       pide una vez y se vuelve a dibujar, en vez de mostrar "Generar link" sobre un portal
       que ya existe. */
    if (!d && p.deal_id && !pjDeals.has(String(p.deal_id))){
      pjDeal(p).then((x) => { if (x && pjCur === p) pjRenderPortal(); });
    }
    if (!d || !d.portal_token){
      box.innerHTML = '<button class="btn btn-ghost small" id="pj-portal-gen" type="button">Generar link</button>';
      const b = $('pj-portal-gen');
      if (b) b.addEventListener('click', () => pjGenPortal());
      return;
    }
    const url = location.origin + '/portal/?id=' + encodeURIComponent(d.id) + '&t=' + encodeURIComponent(d.portal_token);
    /* "Abrir" es para VOS, "Copiar link" es para el cliente: son dos links distintos y
       confundirlos fue el bloqueo. El tuyo lleva un pase de equipo de 2 horas, porque el
       dashboard vive en la app Viven CRM y el portal se abre en Chrome — dos sesiones
       distintas, así que leer la del navegador no alcanzaba.
       (Sebastián, 26 ago 2026: "el portal no lo puedo ver todavía".) */
    box.innerHTML = '<button class="btn btn-ghost small" id="pj-portal-abrir" type="button" title="Abrirlo como equipo, sin código">👁 Abrir</button> ' +
      '<button class="btn btn-ghost small" id="pj-portal-mio" type="button" title="Copiar el link con tu pase, para abrirlo en el celular">📱 Copiar mi link</button> ' +
      '<button class="btn btn-ghost small" id="pj-portal-copy" type="button" title="Este es el que se le manda al cliente: le pide su código">🔗 Copiar link del cliente</button>';
    const cp = $('pj-portal-mio');
    if (cp) cp.addEventListener('click', async () => {
      /* El mismo link, para abrirlo en el teléfono. El pase no vence, así que sirve
         siempre — y es el único que entra sin código. */
      cp.disabled = true;
      try {
        const { data, error } = await supabase.functions.invoke('get-portal', {
          body: { id: d.id, t: d.portal_token, accion: 'pase_equipo' } });
        if (error) throw new Error(error.message);
        if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
        const mio = url + '&pase=' + encodeURIComponent(data.pase);
        await navigator.clipboard.writeText(mio);
        toast('📋 Copiado — pegalo en el celular y entrás sin código');
      } catch (e){ toast('⚠️ ' + (e.message || e)); }
      finally { cp.disabled = false; }
    });
    const ab = $('pj-portal-abrir');
    if (ab) ab.addEventListener('click', () => pjAbrirPortal(ab));
    const c = $('pj-portal-copy');
    if (c) c.addEventListener('click', () => {
      navigator.clipboard.writeText(url).then(() => toast('🔗 Link del portal copiado'), () => toast('No se pudo copiar'));
    });
  }
  /* Abrir el portal del cliente entrando como equipo: sin código y sin gastar el suyo.
     Es la misma acción que el botón de adentro del paso «Post», pero acá vive suelta para
     que el botón de la barra —el que está siempre— pueda usarla. */
  /* Borrar un proyecto. Es irreversible y se lleva puesto todo lo que cuelga: versiones,
     comentarios del cliente, archivos, brief, guiones, plan, costos y horas. Por eso NO
     alcanza con un confirm: primero se cuenta lo que hay y se muestra, y después hay que
     escribir el número del proyecto. Un proyecto de prueba se borra igual de rápido; uno
     real no se borra por error de dedo.
     (Sebastián, 27 ago 2026: "dejame borrar proyectos de test también".) */
  /* 🧹 BORRAR LO DE PRUEBA, EN TANDA.
     Sebastián, 28 ago 2026: "dejame borrarlas tmb. eso solo al principio que los usamos".
     Se lleva lo que se crea y se tira —proyectos, deals, ofertas, propuestas— y NO los
     leads: esos son la prueba de que los formularios andan y viven en el segmento
     «🧪 Pruebas» de Personas (regla suya del 26 ago). El diálogo lo dice, para que la
     decisión esté a la vista y no escondida en el código.
     El botón solo aparece si hay algo que borrar: un botón que casi siempre no hace nada
     es un botón que se aprieta sin leer. */
  function pjPruebasCuenta(){
    const ids = new Set((leadsPrueba || []).map((l) => String(l.id)));
    const de = (arr) => (arr || []).filter((x) => x && ids.has(String(x.lead_id)));
    return { pro: de(pjList), deals: de(dealsPrueba || []), ofs: de(offersList), props: de(ppList) };
  }
  function pjLimpiarBoton(){
    const b = $('pj-limpiar'); if (!b) return;
    const c = pjPruebasCuenta();
    const n = c.pro.length + c.deals.length + c.ofs.length + c.props.length;
    b.hidden = n === 0;
    b.textContent = '🧹 Limpiar las pruebas (' + n + ')';
  }
  async function pjLimpiarPruebas(){
    const b = $('pj-limpiar'); if (b) b.disabled = true;
    try {
      const c = pjPruebasCuenta();
      const lleva = [
        c.pro.length && c.pro.length + ' proyecto' + (c.pro.length === 1 ? '' : 's') + ' (con su brief, plan, contactos y archivos)',
        c.deals.length && c.deals.length + ' deal' + (c.deals.length === 1 ? '' : 's'),
        c.ofs.length && c.ofs.length + ' oferta' + (c.ofs.length === 1 ? '' : 's'),
        c.props.length && c.props.length + ' propuesta' + (c.props.length === 1 ? '' : 's'),
      ].filter(Boolean);
      if (!lleva.length){ toast('No hay nada de prueba para borrar'); return; }
      const dicho = prompt(
        'BORRAR LO DE PRUEBA\n\n' +
        'Se borra:\n· ' + lleva.join('\n· ') + '\n\n' +
        'NO se borran las personas de prueba: son la prueba de que los formularios andan, y\n' +
        'siguen en el segmento «🧪 Pruebas» de Personas.\n\n' +
        'Esto no se puede deshacer. Escribí BORRAR para confirmar:');
      if (dicho === null) return;
      if (String(dicho).trim().toUpperCase() !== 'BORRAR'){ toast('No coincide — no se borró nada'); return; }

      /* Los archivos del storage no se van con la fila. Se borran primero y, si falla alguno,
         se corta acá: mejor no borrar nada que dejar archivos sin dueño ocupando lugar. */
      const idsPro = c.pro.map((p) => p.id);
      if (idsPro.length){
        const { data: fs } = await supabase.from('project_files').select('file_path').in('project_id', idsPro);
        const rutas = (fs || []).map((x) => x.file_path).filter(Boolean);
        if (rutas.length){
          const { error: eSt } = await supabase.storage.from('project-files').remove(rutas);
          if (eSt){ toast('⚠️ No se pudieron borrar los archivos: ' + eSt.message); return; }
        }
      }
      /* En este orden y de a una tabla: projects, deals y lead_notes NO tienen FK a leads
         —guardan el lead_id como texto—, así que nada se borra solo. Es justo lo que dejó
         los 8 deals huérfanos que reporta check-integridad. */
      const pasos = [
        ['proyectos', () => idsPro.length ? supabase.from('projects').delete().in('id', idsPro) : null],
        ['ofertas', () => c.ofs.length ? supabase.from('offers').delete().in('id', c.ofs.map((x) => x.id)) : null],
        ['propuestas', () => c.props.length ? supabase.from('proposals').delete().in('id', c.props.map((x) => x.id)) : null],
        ['deals', () => c.deals.length ? supabase.from('deals').delete().in('id', c.deals.map((x) => x.id)) : null],
      ];
      for (const [que, fn] of pasos){
        const r = await fn(); if (!r) continue;
        if (r.error){ toast('⚠️ ' + que + ': ' + r.error.message); return; }
      }
      toast('🧹 Listo — ' + lleva.length + ' tipo(s) de dato de prueba borrados');
      await loadAll();
      await pjLoad();
    } catch (e){ toast('⚠️ ' + (e && e.message)); }
    finally { if (b) b.disabled = false; }
  }

  async function pjBorrar(){
    const p = pjCur; if (!p) return;
    const b = $('pj-borrar');
    b.disabled = true;
    try {
      const cuenta = async (tabla) => {
        const { count } = await supabase.from(tabla).select('id', { count: 'exact', head: true }).eq('project_id', p.id);
        return count || 0;
      };
      const [vers, coms, files, briefs, scripts, costos, horas, cont] = await Promise.all([
        cuenta('project_versions'), cuenta('project_comments'), cuenta('project_files'),
        cuenta('project_briefs'), cuenta('project_scripts'), cuenta('project_costs'),
        cuenta('project_hours'), cuenta('project_contacts'),
      ]);
      const lleva = [
        vers && vers + ' versión' + (vers === 1 ? '' : 'es'),
        coms && coms + ' comentario' + (coms === 1 ? '' : 's') + ' del cliente',
        files && files + ' archivo' + (files === 1 ? '' : 's'),
        briefs && briefs + ' respuesta' + (briefs === 1 ? '' : 's') + ' del brief',
        scripts && scripts + ' guion/plan',
        costos && costos + ' costo' + (costos === 1 ? '' : 's'),
        horas && horas + ' registro' + (horas === 1 ? '' : 's') + ' de horas',
        cont && cont + ' contacto' + (cont === 1 ? '' : 's'),
      ].filter(Boolean);

      const ref = String(p.ref || p.id);
      const dicho = prompt(
        'BORRAR EL PROYECTO ' + ref + ' — ' + (p.title || '') + '\n\n' +
        (lleva.length ? 'Se borra también:\n· ' + lleva.join('\n· ') + '\n\n' : 'No tiene nada cargado adentro.\n\n') +
        'Esto no se puede deshacer. El deal y las facturas NO se tocan.\n\n' +
        'Escribí ' + ref + ' para confirmar:');
      if (dicho === null) return;
      if (String(dicho).trim() !== ref){ toast('No coincide — no se borró nada'); return; }

      /* Los archivos del storage no se van con la fila: se borran antes, y si alguno falla
         el proyecto NO se borra, para no dejar archivos sin dueño ocupando lugar. */
      const { data: fs } = await supabase.from('project_files').select('file_path').eq('project_id', p.id);
      const rutas = (fs || []).map((f) => f.file_path).filter(Boolean);
      if (rutas.length){
        const { error: eSt } = await supabase.storage.from('project-files').remove(rutas);
        if (eSt){ toast('⚠️ No se pudieron borrar los archivos: ' + eSt.message); return; }
      }

      const { error } = await supabase.from('projects').delete().eq('id', p.id);
      if (error){ toast('⚠️ ' + error.message); return; }
      pjList = (pjList || []).filter((x) => String(x.id) !== String(p.id));
      pjCur = null; pjUrl(null); pjRenderList();
      toast('🗑 Proyecto ' + ref + ' borrado');
    } finally { b.disabled = false; }
  }

  async function pjAbrirPortal(boton){
    const p = pjCur; if (!p) return;
    if (boton) boton.disabled = true;
    try {
      if (!p.deal_id) throw new Error('Este proyecto no tiene deal asociado — sin eso no hay portal');
      await pjGenPortal({ callado: true });
      const d = await pjDeal(p);
      if (!d || !d.portal_token) throw new Error('No pude generar el link del portal');
      const url = location.origin + '/portal/?id=' + encodeURIComponent(d.id) + '&t=' + encodeURIComponent(d.portal_token);
      const { data, error } = await supabase.functions.invoke('get-portal', {
        body: { id: d.id, t: d.portal_token, accion: 'pase_equipo' },
      });
      if (error) throw new Error(error.message);
      if (!data || data.error) throw new Error((data && data.error) || 'sin respuesta');
      window.open(url + '&pase=' + encodeURIComponent(data.pase), '_blank', 'noopener');
    } catch (e){
      toast('⚠️ ' + (e.message || e));
    } finally { if (boton) boton.disabled = false; }
  }

