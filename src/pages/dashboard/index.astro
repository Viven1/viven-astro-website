    if (error){ servicesList = []; return { error }; }
    servicesList = data || [];
    return {};
  }
  /* ================= 📄 LICENCIAS: ingreso recurrente, avisos -90/-30/0 ================= */
  let licensesBuilt = false, licList = [], licEditing = null, licFilter = 'active';
  // días desde hoy hasta una fecha ISO (YYYY-MM-DD); negativo = ya venció
  const licDaysTo = (d) => Math.round((new Date(d + 'T00:00:00').getTime() - new Date(new Date().toDateString()).getTime()) / 864e5);
  function licensesInit(){
    if (!licensesBuilt){
      licensesBuilt = true;
