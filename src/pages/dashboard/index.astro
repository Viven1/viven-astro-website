  /* -- ➕ Crear ▾ global -- */
  .vv-create{position:relative}
  .vv-create-menu{position:absolute;top:calc(100% + 6px);right:0;z-index:130;min-width:190px;background:var(--navy-800);border:1px solid var(--line-strong);border-radius:12px;box-shadow:0 18px 50px rgba(0,0,0,.5);padding:6px;display:flex;flex-direction:column;gap:2px}
  .vv-create-menu button{display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:none;border:0;color:var(--text);font-family:inherit;font-size:13.5px;font-weight:500;padding:9px 11px;border-radius:8px;cursor:pointer}
  .vv-create-menu button:hover,.vv-create-menu button:focus-visible{background:color-mix(in srgb,var(--acid) 14%,transparent);color:var(--acid);outline:none}
  /* -- ⌘K command palette -- */
  .vv-cmdk{position:fixed;inset:0;z-index:500;display:none;align-items:flex-start;justify-content:center;padding:12vh 20px 20px}
  .vv-cmdk.open{display:flex}
  .vv-cmdk-bd{position:fixed;inset:0;background:rgba(9,15,26,.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
  .vv-cmdk-panel{position:relative;z-index:2;width:min(600px,100%);background:var(--navy-800);border:1px solid var(--line-strong);border-radius:16px;box-shadow:0 30px 80px -20px rgba(0,0,0,.7);overflow:hidden;animation:vvCmdkIn .18s ease}
  .vv-cmdk-top{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line)}
  .vv-cmdk-top .ci-ic{font-size:16px;color:var(--muted-2)}
  .vv-cmdk-input{flex:1;background:none;border:0;outline:none;color:var(--text);font-family:inherit;font-size:15px;min-width:0}
  .vv-cmdk-input::placeholder{color:var(--muted-2)}
  .vv-cmdk-esc{font:600 10px Inter,system-ui,sans-serif;color:var(--muted-2);border:1px solid var(--line-strong);border-radius:5px;padding:2px 6px;white-space:nowrap}
  .vv-cmdk-results{max-height:min(52vh,420px);overflow:auto;padding:6px}
  .vv-cmdk-grp{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted-2);font-weight:700;padding:10px 10px 4px}
  .vv-cmdk-item{display:flex;align-items:center;gap:11px;width:100%;text-align:left;background:none;border:0;color:var(--text);font-family:inherit;font-size:13.5px;padding:9px 11px;border-radius:9px;cursor:pointer}
  .vv-cmdk-item .ci-ic{font-size:15px;width:20px;text-align:center;flex:none}
  .vv-cmdk-item .ci-main{display:flex;flex-direction:column;min-width:0}
  .vv-cmdk-item .ci-t{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .vv-cmdk-item .ci-sub{color:var(--muted-2);font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .vv-cmdk-item.sel,.vv-cmdk-item:hover{background:color-mix(in srgb,var(--acid) 14%,transparent)}
  .vv-cmdk-item.sel .ci-t,.vv-cmdk-item:hover .ci-t{color:var(--acid)}
  .vv-cmdk-empty{padding:24px 12px;text-align:center;color:var(--muted-2);font-size:13px}
  @keyframes vvCmdkIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
  @media(prefers-reduced-motion:reduce){.vv-cmdk-panel{animation:none}.dash-side{transition:none}}
  /* en móvil la barra ya usa el bottom-nav: la pastilla de búsqueda queda compacta (solo lupa) */
  @media(max-width:820px){
    .vv-search{min-width:0;padding:0;width:38px;height:38px;justify-content:center;border-radius:10px}
    .vv-search .vv-search-t,.vv-search .vv-kbd{display:none}
  }
  /* ===== LA BARRA DE ARRIBA SE SALÍA DE LA PANTALLA =====
     En un teléfono de 375 px los seis controles de la derecha no entran. `.dash-actions`
     ya tenía flex-wrap, pero no podía ENCOGER —le faltaba min-width:0— así que en vez de
     envolver se desbordaba: la campana, "Actualizar" y "Salir" quedaban fuera del
     viewport y no se podían tocar. La campana es donde viven las tareas y los avisos.
     El primer intento los achicó a íconos con font-size:0 y salió peor: los botones
     tienen estilos inline que le ganan a la hoja, así que el texto seguía y el ::before
     agregaba una campana de más. Se deja que envuelva, que es lo que la fila ya sabía
     hacer, y se le da lugar. */
  @media(max-width:560px){
    .dash-head{flex-wrap:wrap;align-items:flex-start;gap:10px}
    .dash-actions{min-width:0;flex:1 1 100%;justify-content:flex-start;row-gap:8px}
    .dash-actions .btn{padding:8px 13px;font-size:12.5px}
    /* Y que los botones NO encojan. Con solo permitir el wrap, flex prefirió apretarlos:
       la lupa, actualizar y salir quedaron de 6 px de ancho — dentro de la pantalla y
       aun así imposibles de tocar, que es la misma inutilidad con otra forma. Al no
       poder encoger, la fila baja de línea, que es lo que uno quiere en un teléfono.
       44 px de alto es el mínimo cómodo para el dedo. */
    .dash-actions > *{flex:0 0 auto}
    .dash-actions button{min-height:40px}
  }
  /* ---------- Modo app en móvil: sidebar → barra inferior fija ---------- */
  .mob-nav,.mob-sheet{display:none}
  @media(max-width:820px){
    /* clave: en columna, los hijos deben ESTIRARSE al ancho del viewport —
       con el align-items:flex-start del desktop, .dash-main tomaba el ancho del
       CONTENIDO (980px con el board) y toda la página quedaba ancha → iOS no scrolleaba */
    .dash-body{flex-direction:column;align-items:stretch}
    .dash-main{width:100%;max-width:100%;min-width:0}
    .dash-side{display:none}                          /* fuera la lista gigante de arriba */
    /* La barra de abajo mide 54 px y es `fixed`: con 84 px de colchón la última tarjeta
       quedaba 25 px tapada (medido). 110 px deja el último renglón legible sin que
       parezca que la página se cortó. */
    .dash-wrap{padding:calc(14px + env(safe-area-inset-top)) 14px calc(110px + env(safe-area-inset-bottom));overflow-x:hidden}
    body{overflow-x:clip}
    /* cards de ofertas/propuestas: nada cortado a la derecha — el monto baja a su propia línea */
    .of-card-open{flex-wrap:wrap;gap:6px 12px;padding:13px 14px}
    .of-card-main{flex:1 1 100%}
    .of-card-nums{text-align:left;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
    .of-card-net{font-size:16px}
    .of-actions{padding:0 10px 10px;gap:6px}
    .of-act{font-size:12px;padding:7px 10px}
    /* Editor de propuestas en el celular. Una fila de posición pedía 376pt fijos
       (cant. 64 + precio 96 + costo 88 + total 70 + ✕, más gaps) y el iPhone tiene
       375–430pt: como .dash-wrap es overflow-x:hidden, no se cortaba con scroll
       sino que se RECORTABA — cantidad, precio y costo quedaban invisibles e
       intocables desde el teléfono. Ahora el nombre toma la línea entera y los
       números bajan a la siguiente. (Reporte de Sebastián con captura, 11 ago 2026.) */
    .pp3-it{flex-wrap:wrap;row-gap:8px;padding-bottom:9px;border-bottom:1px dashed var(--line)}
    .pp3-it .iname{flex:1 1 100%}
    .pp3-it .ppf{flex:1 1 0;width:auto;min-width:0}
    /* con el padding de escritorio (11px por lado) entraban 4 dígitos justos:
       un precio de 5 cifras se cortaba mientras se tipeaba */
    .pp3-it .ppf input{padding:9px 6px;text-align:right}
    .pp3-it .icost{flex:0 0 auto;margin-left:auto;align-self:center}
    .pp3-it .it-rm{align-self:center}
    /* la ✕ medía 42x23: imposible de acertar con el dedo, y borra una posición */
    .pp-row .rm{min-width:38px;min-height:38px;display:inline-flex;align-items:center;justify-content:center;padding:0}
    .pp-oflink,.pp3-it-bar .btn.xs{min-height:36px;padding:8px 12px}
    /* nombre y subtítulo del paquete, uno por línea (antes el subtítulo se comía
       la mitad del ancho y ninguno de los dos se leía) */
    .pp-tier-row .rowtop{flex-wrap:wrap}
    .pp-tier-row .t-name{flex:1 1 auto}
    .pp-tier-row .t-sub{order:3;flex:1 1 100%}
    /* la línea de ganancia/margen no comparte renglón con el botón de la oferta */
    .pp-tier-row .pp-tier-margin{flex:1 1 100%;margin-top:0}
    .pp-oflink{margin-left:0}
    /* modal de contacto: header respeta el notch */
    .lead-card-wide{padding-top:calc(10px + env(safe-area-inset-top))}
    .dash-head{margin-bottom:12px;flex-wrap:nowrap;gap:8px}
    .dash-brand .logo-mark{height:19px}
    .dash-brand .db-sub{display:none}
    .dash-sub{display:none}
    .dash-head .btn.small{padding:8px 11px;font-size:12.5px;white-space:nowrap}
    /* ➕ Crear ▾ era el único botón de texto sin compactar en la barra — quedaba
       empujando/cortando al resto en pantallas angostas (mismo trato que refresh/logout) */
    /* El texto original de estos tres botones sigue en el DOM (oculto con
       font-size:0) y, siendo el botón una grilla, ocupaba una SEGUNDA fila: el
       ícono del ::before quedaba centrado en la primera fila, ~7px arriba del
       centro real. Se notaba al lado de 🔍/◐/🔔, que centran bien porque son
       flex con un solo hijo. (Reporte de Sebastián con captura, 11 ago 2026.)
       Solución: el ::before sale del flujo y se centra contra el botón entero,
       así la altura del texto invisible deja de importar. */
    #vv-create-btn,#refresh-btn,#logout-btn{font-size:0;width:38px;height:38px;padding:0;border-radius:10px;position:relative}
    #vv-create-btn::before,#refresh-btn::before,#logout-btn::before{position:absolute;inset:0;display:grid;place-items:center;line-height:1}
    #vv-create-btn::before{content:'➕';font-size:16px}
    #refresh-btn::before{content:'↻';font-size:17px}
    .dash-actions{gap:7px;flex-wrap:nowrap!important}
    #logout-btn::before{content:'⏻';font-size:16px}
    /* inputs a 16px: iOS no hace zoom al enfocar */
    input,select,textarea{font-size:16px!important}
    .tabs{overflow-x:auto;scrollbar-width:none;margin-bottom:18px;flex-wrap:nowrap}
    .tabs::-webkit-scrollbar{display:none}
    .tab{padding:10px 12px;font-size:14.5px;white-space:nowrap;flex:none}
    .panel{padding:16px 14px}
    .kpis,.kpis.four{grid-template-columns:repeat(2,1fr);gap:10px}
    .kpi{padding:14px 15px}
    .kpi .n{font-size:clamp(19px,6.5vw,26px)}
    .home-kpis{gap:8px}
    .hk{flex-basis:120px;padding:11px 13px}
    .hk-n{font-size:19px}
    .hm-card{padding:14px 15px}
    /* pipeline: una columna por pantalla, con snap como un carrusel */
    .pipe-pager{display:flex!important}
    /* iOS: sin snap (se pelea con el scroll vertical anidado de las columnas) — scroll libre y robusto */
    .pipeline{touch-action:pan-x pan-y;overscroll-behavior-x:contain}
    .pipe-col{flex:0 0 85vw;min-width:85vw;max-height:68dvh;touch-action:pan-x pan-y}
    .pipe-list{touch-action:pan-x pan-y}
    .pipe-card{cursor:default;touch-action:pan-x pan-y}
    /* tabla de Personas/Empresas → cards apiladas (nada de scroll horizontal).
       OJO: el mapeo es POSICIONAL y la 1ª celda ahora es el CHECKBOX de selección (batch delete)
       — antes era el nombre y el card quedaba sin título. El nombre vive en la 2ª celda;
       el checkbox va absoluto arriba a la derecha (el "seleccionar todos" del thead se pierde
       en móvil, aceptado). */
    .lead-table-hs table{min-width:0;width:100%}
    .lead-table-hs thead{display:none}
    .lead-table-hs tbody tr{position:relative;display:flex;flex-wrap:wrap;align-items:center;gap:3px 10px;padding:12px 44px 12px 14px;border-bottom:1px solid var(--line)}
    .lead-table-hs tbody td{display:none;padding:0;border:0;white-space:normal}
    .lead-table-hs tbody td.lt-chk{display:block;position:absolute;top:12px;right:12px;width:auto;padding:0}
    .lead-table-hs tbody td:nth-child(2){display:block;flex:1 1 100%}   /* nombre (persona/empresa): título del card */
    .lead-table-hs tbody td:nth-child(2) .lt-name{font-size:14.5px}
    .lead-table-hs tbody td:nth-child(5){display:block;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;color:var(--muted);font-size:12px}
    .lead-table-hs tbody td:nth-child(6){display:block}
    .lead-table-hs tbody td.lt-val{display:block;font-weight:700;font-family:'Space Grotesk';font-size:13px;color:var(--text)}
    /* contacto apilado en orden útil: conversación → proyectos/ofertas → ficha */
    .lm-center{order:1}
    .lm-right{order:2}
    .lm-left{order:3}
    /* acciones rápidas: TODAS visibles (envuelven en filas), nada escondido en scroll */
    .lm-quick{flex-wrap:wrap;overflow:visible;margin-right:0}
    .lm-quick .lm-qbtn{flex:0 1 auto}
    /* header del contacto compacto y sin pisar el notch */
    .lead-card-wide .close{top:calc(8px + env(safe-area-inset-top));right:14px}
    .lead-card h3{font-size:19px}
    .lm-top{padding-right:52px}
    /* botonera final: los útiles se estiran, BORRAR queda chico y al final — no un banner rojo */
    .lead-actions .btn{flex:1 1 auto}
    .lead-actions .btn-danger{flex:0 0 auto;margin-left:auto;font-size:12.5px;padding:9px 14px}
    /* barras de título (Deals/Ofertas/etc): que el texto envuelva y el botón baje */
    .of-bar{flex-wrap:wrap}
    .of-bar > div{min-width:0;flex:1 1 100%}
    .of-bar .muted-note{white-space:normal}
    /* editor de OFERTA: la tabla de posiciones se vuelve cards (adiós scroll lateral) */
    .of-table{min-width:0}
    .of-table thead{display:none}
    .of-table tr[data-i]{display:grid;grid-template-columns:repeat(4,1fr);gap:7px 8px;padding:11px 12px;border-bottom:1px solid var(--line)}
    .of-table tr[data-i] td{display:block;padding:0;border:0;min-width:0}
    .of-table tr[data-i] td:nth-child(1){grid-area:1/1/2/4}
    .of-table tr[data-i] td:nth-child(9){grid-area:1/4/2/5;justify-self:end}
    .of-table tr[data-i] td:nth-child(2){grid-area:2/1/3/3}
    .of-table tr[data-i] td:nth-child(3){grid-area:2/3/3/4}
    .of-table tr[data-i] td:nth-child(4){grid-area:2/4/3/5}
    .of-table tr[data-i] td:nth-child(5){grid-area:3/1/4/2}
    .of-table tr[data-i] td:nth-child(6){grid-area:3/2/4/3}
    .of-table tr[data-i] td:nth-child(7){grid-area:3/3/4/4;align-self:end;text-align:right;font-weight:700;font-family:'Space Grotesk'}
    .of-table tr[data-i] td:nth-child(8){grid-area:3/4/4/5;align-self:end;text-align:right;font-size:12px}
    .of-table tr[data-i] td:nth-child(n+3)::before{display:block;font-size:9.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted-2);margin-bottom:3px}
    .of-table tr[data-i] td:nth-child(3)::before{content:'Cant.'}
    .of-table tr[data-i] td:nth-child(4)::before{content:'Unidad'}
    .of-table tr[data-i] td:nth-child(5)::before{content:'Precio'}
    .of-table tr[data-i] td:nth-child(6)::before{content:'Costo int.'}
    .of-table tr[data-i] td:nth-child(7)::before{content:'Total';font-weight:400;font-family:'Inter'}
    .of-table tr[data-i] td:nth-child(8)::before{content:'Margen'}
    .of-table tr.of-phase,.of-table tr.of-sub{display:flex;justify-content:space-between;gap:10px;padding:9px 12px;border-bottom:1px solid var(--line)}
    .of-table tr.of-phase td,.of-table tr.of-sub td{display:block;padding:0;border:0}
    #bg-result .pp-grid{grid-template-columns:1fr!important}
    .of-add{flex-direction:column;align-items:stretch}
    .of-add select{min-width:0;width:100%}
    .of-add .btn{width:100%}
    .mob-nav{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:250;background:color-mix(in srgb,var(--navy-800) 88%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-top:1px solid var(--line-strong);padding:6px 4px calc(6px + env(safe-area-inset-bottom))}
    .mob-nav button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;background:none;border:0;color:var(--muted-2);font-family:inherit;cursor:pointer;padding:4px 2px;border-radius:10px}
    .mob-nav button .mi{font-size:19px;line-height:1}
    .mob-nav button .ml{font-size:10px;font-weight:600;letter-spacing:.01em}
    .mob-nav button.active{color:var(--acid)}
    .mob-sheet{position:fixed;left:12px;right:12px;bottom:calc(66px + env(safe-area-inset-bottom));z-index:249;background:var(--navy-800);border:1px solid var(--line-strong);border-radius:16px;box-shadow:0 18px 50px rgba(0,0,0,.5);padding:8px;display:flex;flex-direction:column}
    .mob-sheet[hidden]{display:none}
    .mob-sheet button{background:none;border:0;color:var(--text);font-family:inherit;font-size:14.5px;font-weight:600;text-align:left;padding:13px 14px;border-radius:10px;cursor:pointer}
    .mob-sheet button.active,.mob-sheet button:hover{background:color-mix(in srgb,var(--acid) 10%,transparent);color:var(--acid)}
    /* modal de contacto a pantalla completa */
    .lead-modal{padding:0}
    .lead-modal .lead-card{width:100%;min-height:100dvh;border-radius:0;margin:0}
  }
  /* tablas genéricas (no la de Personas) en pantallas chicas: ocultar columnas 5 y 6 */
  @media(max-width:560px){
    .lead-table-wrap:not(.lead-table-hs) .lead-table th:nth-child(5),.lead-table-wrap:not(.lead-table-hs) .lead-table td:nth-child(5),
    .lead-table-wrap:not(.lead-table-hs) .lead-table th:nth-child(6),.lead-table-wrap:not(.lead-table-hs) .lead-table td:nth-child(6){display:none}
  }
  /* ---- home ---- */
  /* flex-wrap (no grid): con 7 KPIs, un grid de columnas fijas deja huecos vacíos en la
     última fila — flex reparte el ancho sobrante entre las tarjetas que sí hay en cada
     fila (incluida la última, aunque quede incompleta), así nunca queda un agujero
     (pedido explícito: "tiene info por todos lados pero muchos agujeros, mejor mas
     compacto que se lea mejor el overview") */
  .home-kpis{display:flex;flex-wrap:wrap;gap:10px}
  .hk{flex:1 1 128px;background:var(--navy-800);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
  .hk-l{color:var(--muted);font-size:11.5px}
  .hk-n{font-family:'Space Grotesk';font-weight:700;font-size:21px;color:var(--text);line-height:1.15;margin-top:3px}
  .hk-t{font-size:11.5px;margin-top:3px;font-weight:600}

  /* ── HOY: los números en una tira, no en tarjetas ──
     Eran siete tarjetas de 21px ocupando la primera pantalla, y la lista de lo que hay
     que hacer —lo único accionable— empezaba abajo del pliegue. Los números no se van:
     se achican y se ponen en fila, que es como se leen de reojo. Lo que gana la pantalla
     son tres o cuatro acciones más a la vista.
     Solo cambia la presentación: mismos ids, mismos datos, mismo JS.
     (Mockup aprobado por Sebastián el 27 ago 2026.) */
  /* La MISMA tira para los tres números del ritmo del mes. Compactar solo los cuatro de
     abajo no alcanzaba: el bloque de arriba —titular, párrafo, barra y TRES tarjetas
     grandes— es el que empuja la lista fuera de la primera pantalla, y es el que Sebastián
     seguía viendo igual.
     (Sebastián, 27 ago 2026, después del primer intento: "same same".) */
  #tab-hoy .hm-kpis,
  #tab-hoy .rm-kpis{gap:0;background:var(--navy-800);border:1px solid var(--line);
    border-radius:12px;padding:2px 4px;margin-bottom:14px}
  #tab-hoy .hm-kpis .hk,
  #tab-hoy .rm-kpis .hk{flex:1 1 150px;background:none;border:0;border-radius:0;
    padding:9px 14px;display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px;min-width:0}
  #tab-hoy .hm-kpis .hk + .hk,
  #tab-hoy .rm-kpis .hk + .hk{border-left:1px solid var(--line)}
  #tab-hoy .hm-kpis .hk-l,
  #tab-hoy .rm-kpis .hk-l{font-size:11px;color:var(--muted-2);order:2;flex:1 1 100%;margin:0;line-height:1.35}
  #tab-hoy .hm-kpis .hk-n,
  #tab-hoy .rm-kpis .hk-n{font-size:17px;margin:0;order:0;line-height:1.1}
  /* min-height:13px en una fila baja deja un hueco fantasma cuando no hay delta. */
  #tab-hoy .hm-kpis .kdelta,
  #tab-hoy .rm-kpis .kdelta{order:1;margin:0;min-height:0;font-size:10.5px}
  #tab-hoy .hm-kpis .kdelta:empty,
  #tab-hoy .rm-kpis .kdelta:empty{display:none}
  #tab-hoy .hm-kpis .hk-t,
  #tab-hoy .rm-kpis .hk-t{font-size:10.5px;margin:0;order:3;flex:1 1 100%;line-height:1.4}
  @media(max-width:700px){
    #tab-hoy .hm-kpis .hk,
  #tab-hoy .rm-kpis .hk{flex:1 1 44%}
    #tab-hoy .hm-kpis .hk + .hk,
  #tab-hoy .rm-kpis .hk + .hk{border-left:0}
    #tab-hoy .hm-kpis .hk:nth-child(odd) + .hk,
    #tab-hoy .rm-kpis .hk:nth-child(odd) + .hk{border-left:1px solid var(--line)}
  }
  .hk-t.up{color:#7ed957}
  .hk-t.down{color:#ff8b8b}
  .hk-t.muted{color:var(--muted-2);font-weight:400}
  /* Hoy: KPIs + cards — cards compactas, sin el padding/margin de .panel default
     (24px) que hacía sentir todo muy espaciado */
  .hm-grid{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:12px;margin-top:14px;align-items:start}
  .hm-grid .panel{margin-bottom:0}
  .hm-card{padding:18px 20px}
  .hm-card h2{font-size:14px;margin-bottom:11px}
  /* las filas de todas las listas de Hoy respiran igual */
  .hm-card .hm-item{padding:13px 6px 13px 14px;gap:12px}
  .hm-card .hm-item .tx b{line-height:1.35}
  .hm-card .hm-item .tx small{line-height:1.45;margin-top:3px}
  /* masonry con CSS multi-column (no grid): con un grid de 3 columnas fijas, "Para
     hoy"/"Señales calientes" (cortas) dejaban un agujero enorme debajo mientras la
     3ª columna (Visitas/Ads/IA apiladas) seguía mucho más abajo — acá el browser
     reparte las 5 cards entre columnas balanceando la altura total, así no queda
     una columna corta con espacio muerto al lado de una larga (pedido explícito,
     con captura: "mira todo el dead space") */
  /* Tres columnas de 280px dejaban títulos partidos en cuatro renglones y
     botones amontonados — "mirá qué apretado todo, dame más espacio"
     (Sebastián, 14 ago 2026, con la pantalla llena de tarjetas). Ahora las
     columnas arrancan en 360px: en un monitor normal siguen entrando dos o
     tres, pero cada una respira. */
  .hm-masonry{column-count:3;column-width:360px;column-gap:16px;margin-top:16px}
  .pb-q.pb-tarde{border-left:3px solid var(--acid);padding-left:11px}
  .pb-tardechip{font-size:11px;color:var(--acid);font-weight:600;white-space:nowrap}
  .pb-avisotarde{background:color-mix(in srgb,var(--acid) 13%,transparent);border:1px solid color-mix(in srgb,var(--acid) 40%,transparent);
    color:var(--text);border-radius:11px;padding:10px 13px;font-size:13px;line-height:1.5;margin:0 0 12px}
  .crew-roles{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
  .crew-roles button{background:var(--navy-900);border:1px solid var(--line);border-radius:99px;color:var(--muted);
    font:inherit;font-size:12px;padding:4px 11px;cursor:pointer;white-space:nowrap}
  .crew-roles button:hover{border-color:var(--acid);color:var(--acid)}
  .crew-roles button.on{background:var(--acid);border-color:var(--acid);color:#16210a;font-weight:700}
  .pj-per input[type=time]{margin-top:5px;background:var(--navy-900);border:1px solid var(--line);border-radius:7px;
    color:var(--text);font:inherit;font-size:12px;padding:3px 6px;width:100px}
  .pj-per1 .h{font-variant-numeric:tabular-nums;font-size:12px;color:var(--muted-2);white-space:nowrap}
  .pj-per1 .h.propia{color:var(--acid);font-weight:700}
  .pj-crew-row .pj-crew-h{width:104px;flex:none;font-size:12.5px}
  @media(max-width:560px){ .pj-crew-row .pj-crew-h{width:88px} }
  .ci-row{display:flex;gap:10px;align-items:flex-start;padding:9px 10px;border:1px solid var(--line);
    border-radius:10px;margin-bottom:7px;cursor:pointer;font-size:13.5px}
  .ci-row:hover{border-color:var(--acid)}
  .ci-row input{margin-top:3px}
  .ci-row .ci-d{display:block;font-size:12px;color:var(--muted);margin-top:2px}
  .of-desc{width:100%;margin-top:5px;background:var(--navy-900);border:1px solid var(--line);border-radius:7px;
    color:var(--muted);font:12px/1.45 inherit;padding:5px 8px;resize:vertical;min-height:28px;display:block}
  .of-desc:focus{color:var(--text);border-color:var(--acid);outline:none}
  .of-opt{display:flex;align-items:center;gap:6px;margin-top:5px;font-size:11px;color:var(--muted-2);cursor:pointer}
  .of-opt input{margin:0}
  tr.of-esopt{opacity:.72}
  tr.of-esopt .num{font-style:italic}
  .hm-masonry .hm-card{break-inside:avoid;margin-bottom:16px}
  /* La lista de acciones abarca las tres columnas. Vivía en una columna de 360 px, y ahí
     un renglón con nombre + contexto + monto + botón no entra: el nombre quedaba cortado
     («medienjobs....») y el contexto se partía en seis líneas al lado de un panel vecino
     con media pantalla vacía. Es la lista principal de la pantalla; le corresponde el
     ancho de la pantalla.
     (Sebastián, 27 ago 2026: "corregí el layout en browser... así no sirve".) */
  .hm-masonry #hm-acciones{column-span:all;-webkit-column-span:all}
  /* Y en angosto los botones bajan, en vez de estrangular el texto. */
  @media(max-width:700px){
    .hm-item{flex-wrap:wrap}
    .hm-item .tx{flex:1 1 100%;order:1}
    .hm-item .ic{order:0}
    .hm-item .hm-acts,.hm-item .hm-right,.hm-item .hm-chf{order:2;padding-left:0;margin-top:6px}
    .hm-item .hm-acts{margin-left:auto}
  }
  /* tablet (iPad portrait/landscape, ~620-1180px): "columns:280px 3" colapsaba a
     1 columna ahí porque el ancho de contenido (sidebar + padding descontados)
     no alcanzaba para 2×280px+gap — quedaba todo full-width y desperdiciando
     el espacio (pedido explícito: "hace half width y masonry, usemos el espacio") */
  @media(max-width:1180px) and (min-width:621px){.hm-masonry{column-count:2;column-width:auto}}
  @media(max-width:620px){.hm-masonry{column-count:1;column-width:auto}}
  /* 🎯 Ritmo del mes (tab Hoy): mismo lenguaje visual que los KPIs .hk de abajo */
  .rm-panel{margin-bottom:12px}
  .rm-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
  .rm-head h2{margin-bottom:0}
  .rm-goal{display:flex;align-items:center;gap:6px;margin-left:auto}
  .rm-goal-lbl{color:var(--muted);font-size:12.5px}
  .rm-goal-lbl b{color:var(--text);font-family:'Space Grotesk'}
  .rm-kpis{margin-bottom:12px}
  /* El titular baja un punto y el párrafo de abajo pierde altura: la frase sigue siendo
     lo primero que se lee, pero deja de ocupar tres renglones enteros. */
  #tab-hoy .rm-panel{padding-top:16px;padding-bottom:14px}
  /* El párrafo que cuelga del titular: es un <small> adentro, no un bloque aparte. */
  #tab-hoy .rm-titular{margin:0 0 10px}
  #tab-hoy .rm-titular small{font-size:12.5px;line-height:1.5;margin-top:5px}
  #tab-hoy .rm-kpis{margin-top:12px}
  .rm-titular{font:700 clamp(16px,1.85vw,20px)/1.32 'Space Grotesk',sans-serif;letter-spacing:-.01em;
    margin:2px 0 14px;text-wrap:balance}
  .rm-titular .mal{color:#ff8b5e} .rm-titular .bien{color:var(--acid)}
  .rm-titular small{display:block;font:400 13.5px/1.55 Inter,sans-serif;color:var(--muted);margin-top:7px;letter-spacing:0}
  .rm-kpis{margin-top:16px}
  .rm-bar{position:relative;height:10px;border-radius:6px;background:var(--navy-900);border:1px solid var(--line);overflow:visible}
  .rm-fill{position:absolute;left:0;top:0;bottom:0;border-radius:6px;background:#7ed957;transition:width .3s}
  .rm-fill.behind{background:#f0c060}
  .rm-marker{position:absolute;top:-4px;bottom:-4px;width:2px;background:var(--text);opacity:.65;border-radius:1px}
  .rm-bar-cap{margin-top:6px;font-size:12px}
  .rm-action{margin:10px 0 0;font-size:13px;font-weight:600}
  .rm-action.ok{color:#7ed957}
  .rm-action.warn{color:#f0c060}
  .rm-action.bad{color:#ff8b8b}
  .hm-list{display:flex;flex-direction:column}
  /* fila accionable: barra de severidad a la izquierda (rojo/ámbar/azul) */
  .hm-item{position:relative;display:flex;align-items:center;gap:10px;width:100%;background:none;border:0;border-top:1px solid var(--line);padding:10px 6px 10px 14px;cursor:pointer;text-align:left;color:var(--text);font-family:inherit}
  .hm-item:first-child{border-top:0}
  .hm-item:hover{background:var(--navy-900)}
  .hm-item::before{content:'';position:absolute;left:2px;top:13px;bottom:13px;width:3px;border-radius:2px;background:var(--muted-2)}
  .hm-item.rojo::before{background:#ff6b6b}
  .hm-item.ambar::before{background:#f0c060}
  .hm-item.azul::before{background:#8ab4ff}
  .hm-item.hot::before{background:#ff8b5e}
  .hm-item .ic{flex:none;font-size:15px}
  .hm-item .tx{flex:1;min-width:0}
  .hm-item .tx b{display:block;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hm-item .tx small{display:block;color:var(--muted);font-size:12px;margin-top:1px;line-height:1.35}
  /* el monto en juego: alineado a la derecha, tabular para que las cifras se lean en columna */
  /* sub-encabezado de sección DENTRO de la lista: pesa menos que un <h2> de panel,
     que es justamente el punto — son partes de una lista, no pantallas distintas */
  .hm-sub{display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;
    font-weight:700;color:var(--muted-2);margin:16px 0 8px;padding-top:14px;border-top:1px solid var(--line)}
  .hm-sub .count{text-transform:none;letter-spacing:0}
  .hm-item .hm-acts{flex:none;display:flex;gap:6px;align-items:center;padding-left:10px}
  @media(max-width:560px){
    /* EN EL TELÉFONO, «SALIR» QUEDABA FUERA DE LA PANTALLA.
       A 375px los seis botones del encabezado terminaban en 398px: la campana, el
       actualizar y el salir no se podían tocar. Y si los avisos están apagados aparece
       «🔕 Sin avisos», 99px más, y se caen tres.
       Dos causas encimadas: el `gap:10px` estaba EN LÍNEA en el div —y un estilo en línea
       le gana a toda media query, así que el `gap:7px` de la versión móvil no se aplicaba
       nunca— y el bloque de ≤820px, que va DESPUÉS en el archivo, le pisaba el
       `flex-wrap:wrap` al de ≤560px con un !important. La regla más angosta perdía contra
       la más ancha por orden, que es al revés de lo que uno espera al leerlo.
       Acá van juntas y al final, que es donde ganan. Con esto los seis entran en su propio
       renglón y terminan en 285. (Medido en el DOM real a 375px, 28 ago 2026.) */
    .dash-head{flex-wrap:wrap!important}
    .dash-actions{gap:7px!important;flex-wrap:wrap!important;flex:1 1 100%;justify-content:flex-start}
    .hm-item .hm-acts .btn{padding:6px 9px;font-size:11.5px}
  }
  .hm-item .hm-right{flex:none;display:flex;flex-direction:column;align-items:flex-end;gap:2px;padding-left:10px}
  .hm-item .hm-chf{font-family:'Space Grotesk','Space Grotesk Fallback','Inter',sans-serif;font-weight:700;font-size:13px;color:var(--text);font-variant-numeric:tabular-nums;white-space:nowrap;line-height:1.2}
  .hm-item .go{flex:none;color:var(--acid);font-size:11.5px;font-weight:700;white-space:nowrap}
  /* botones de la cola "aprobado, falta hacerlo" — tienen que ser tocables con el
     pulgar en el teléfono, de ahí los 30px */
  /* el título acá NO se corta con puntos suspensivos: "Rescatar el funn…" no dice
     qué hay que hacer. Dos líneas de título, tres de detalle. */
  #wq-list .tx b{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  #wq-list .wq-det{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  #wq-list .wq-age{opacity:.75;margin-top:2px}
  #wq-list .hm-item{align-items:flex-start}
  .hm-alive-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:9px 0;border-top:1px solid var(--line)}
  .hm-alive-row:first-child{border-top:0}
  .hm-alive-q{flex:1;min-width:150px}
  .hm-alive-q b{display:block;font-size:14px;font-weight:600;line-height:1.25}
  .hm-alive-q small{color:var(--muted);font-size:12px}
  /* botones chicos y sin envolverse: en la columna angosta de Hoy, tres botones con
     el padding normal saltaban a una segunda línea y cada fila ocupaba el doble
     (medido: 464 px para tres filas) */
  .hm-alive-b{display:flex;gap:5px;flex-wrap:nowrap}
  .hm-alive-b .btn{padding:6px 9px;font-size:11.5px;white-space:nowrap}
  /* oportunidades de la web: mismo peso visual que una fila de Para hoy, con la
     acción abajo porque el texto es lo que se lee primero */
  .hm-op-it{border-top:1px solid var(--line);padding:11px 0}
  .hm-op-it:first-child{border-top:0;padding-top:2px}
  .hm-op-t{font-weight:700;font-size:13.5px;line-height:1.3}
  .hm-op-d{color:var(--muted);font-size:12.5px;line-height:1.45;margin-top:3px}
  .hm-op-a{margin-top:8px}
  /* borradores para mandar: asunto en blanco, cuerpo en gris y recortado, para
     poder decidir sin abrir nada */
  .sq-subj{color:var(--text)!important;font-weight:600}
  .sq-body{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .wq-acts{flex:none;display:flex;gap:4px}
  .wq-b{width:30px;height:30px;border-radius:8px;border:1px solid var(--line-strong);background:transparent;color:var(--muted);font-size:13px;cursor:pointer;line-height:1}
  .wq-b:hover{border-color:var(--acid);color:var(--acid)}
  .wq-b.ok:hover{border-color:var(--acid);color:#142033;background:var(--acid)}
  .hm-more{width:100%;background:none;border:0;border-top:1px solid var(--line);color:var(--acid);font-family:inherit;font-weight:600;font-size:12.5px;padding:10px 6px;cursor:pointer;text-align:left}
  .hm-spark{display:flex;align-items:flex-end;gap:5px;height:62px}
  .hm-spark i{flex:1;background:color-mix(in srgb,var(--acid) 28%,transparent);border-radius:3px 3px 0 0;min-height:3px}
  .hm-spark i.on{background:var(--acid)}
  .hm-spark-cap{color:var(--muted);font-size:12px;margin-top:8px}
  .hm-ads-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
  .hm-ads-grid div b{display:block;font-family:'Space Grotesk';font-size:16px}
  .hm-ads-grid div span{color:var(--muted);font-size:11.5px}
  /* resumen de analítica (ocupa el lugar de Ads cuando no hay inversión) */
  .hm-an-list{display:grid;gap:7px}
  .hm-an-row{display:grid;grid-template-columns:1fr 46px 34px 58px;align-items:center;gap:8px;font-size:12.5px}
  .hm-an-t{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .hm-an-bar{height:6px;border-radius:99px;background:rgba(255,255,255,.10);overflow:hidden}
  .hm-an-bar i{display:block;height:100%;background:var(--acid);opacity:.75}
  .hm-an-n{text-align:right;font-variant-numeric:tabular-nums;color:var(--muted)}
  .hm-an-l{text-align:right;font-variant-numeric:tabular-nums;color:var(--muted-2);font-size:11.5px}
  .hm-an-l.seco{color:#ff8b5e}
  .hm-verdict{font-weight:700;font-size:12.5px;margin-top:10px}
  @media(max-width:1280px){.hm-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:920px){.hm-grid{grid-template-columns:1fr}}
  /* tab Agenda: 2 columnas solo con espacio real; en móvil apila full-width */
  .hm-grid.agenda-grid{grid-template-columns:1fr 1fr}
  @media(max-width:920px){.hm-grid.agenda-grid{grid-template-columns:1fr}}
  @media(max-width:720px){
    /* el chip "Mías" no puede desbordar la card: el h2 pasa a flex con wrap */
    #tab-agenda .hm-card h2{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px}
    #tab-agenda .hm-agenda-seg{margin-left:0}
    /* "Video calls por persona": nombre con ellipsis + conteo SIEMPRE visible a la derecha */
    .bar-row{grid-template-columns:minmax(64px,38%) 1fr auto;gap:8px}
  }

  /* ---------- 🧭 Recorridos: funnels first-party con drop-off (prefijo rc-) ---------- */
  .rc-funnels{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px}
  .rc-funnel h3{font-size:13.5px;margin:0 0 10px;font-family:'Space Grotesk';letter-spacing:-.01em}
  .rc-funnel .rc-note{color:var(--muted);font-size:12.5px}
  .rc-row{display:flex;align-items:center;gap:10px;margin-bottom:7px}
  .rc-lbl{flex:0 0 132px;font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rc-track{flex:1;min-width:0;position:relative;height:24px;background:var(--navy-900);border:1px solid var(--line);border-radius:7px;overflow:hidden}
  .rc-track i{display:block;height:100%;background:color-mix(in srgb,var(--acid) 55%,transparent);border-radius:6px 0 0 6px}
  .rc-track b{position:absolute;inset:0;display:flex;align-items:center;padding:0 8px;font-size:11.5px;color:var(--text)}
  .rc-drop{flex:0 0 52px;text-align:right;font-size:11.5px;font-weight:700;color:#ff8b8b;font-variant-numeric:tabular-nums}
  .rc-drop.ok{color:var(--muted-2)}
  .rc-kind{white-space:nowrap}
  @media(max-width:680px){.rc-lbl{flex-basis:104px}}
  /* 🗺️ Flujo de visitas (Sankey 3 columnas, SVG generado por JS) */
  .rc-flow-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:14px}
  .rc-flow-reset{background:var(--navy-900);border:1px solid var(--line);color:var(--text);font-size:12px;padding:5px 12px;border-radius:8px;cursor:pointer;font-family:inherit}
  .rc-flow-reset:hover{border-color:var(--acid)}
  .rc-flow-wrap{overflow-x:auto;margin-bottom:6px}
  .rc-flow-inner{min-width:720px}
  .rc-flow-inner svg{width:100%;height:auto;display:block}
  .rc-flow-col{font-size:11px;font-family:'Space Grotesk';fill:var(--muted);text-transform:uppercase;letter-spacing:.05em}
  .rc-ribbon{fill:var(--acid);opacity:.25;transition:opacity .15s}
  .rc-ribbon:hover{opacity:.5}
  .rc-ribbon.rc-exit{fill:#8b93a7}
  .rc-flow-node rect{fill:color-mix(in srgb,var(--acid) 55%,transparent);stroke:var(--line)}
  .rc-flow-node.rc-exit rect{fill:color-mix(in srgb,#8b93a7 40%,transparent)}
  .rc-flow-node.rc-other rect{fill:color-mix(in srgb,var(--acid) 25%,transparent)}
  .rc-flow-node text{font-size:11px;fill:var(--text)}
  .rc-flow-node .rc-flow-lang{fill:var(--acid);font-weight:700;font-size:9.5px;letter-spacing:.03em}
  .rc-flow-node .rc-flow-n{fill:var(--muted);font-variant-numeric:tabular-nums}
  .rc-flow-node.rc-click{cursor:pointer}
  .rc-flow-node.rc-click:hover rect{stroke:var(--acid)}

  /* ---------- 🧪 Motor de CRO semanal (prefijo cro-) ---------- */
  .cro-tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .cro-tools select{background:var(--navy-900);border:1px solid var(--line-strong);border-radius:9px;color:var(--text);font-family:inherit;font-size:12.5px;padding:7px 10px}
  .cro-card{border:1px solid var(--line);border-radius:12px;background:var(--navy-900);padding:16px 18px;margin-bottom:10px}
  .cro-card.cro-done{border-color:rgba(126,217,87,.35)}
  .cro-card.cro-dismissed{opacity:.4}
  .cro-card.cro-approved{border-color:color-mix(in srgb,var(--acid) 55%,transparent);box-shadow:0 0 0 1px color-mix(in srgb,var(--acid) 25%,transparent)}
  .cro-approved-note{color:var(--acid);font-size:12px;font-weight:600;margin:8px 0 0}
  .cro-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px}
  .cro-badge{border:1px solid var(--line-strong);border-radius:999px;font-size:10.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:2px 9px;color:var(--muted);white-space:nowrap}
  .cro-badge.ab_test{color:#8ab4ff;border-color:rgba(138,180,255,.45)}
  .cro-badge.fix{color:#ff8b8b;border-color:rgba(255,139,139,.45)}
  .cro-badge.experiment{color:#f0c060;border-color:rgba(240,192,96,.45)}
  .cro-where{color:var(--muted-2);font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:340px}
  .cro-impact{margin-left:auto;color:var(--acid);font-size:11px;letter-spacing:2px;white-space:nowrap}
  .cro-title{font-size:14.5px;font-weight:700;font-family:'Space Grotesk';letter-spacing:-.01em;line-height:1.35}
  .cro-hypo{color:var(--muted);font-size:13px;line-height:1.55;margin:6px 0 0}
  .cro-evidence{color:var(--muted);font-size:12.5px;font-style:italic;line-height:1.5;margin:8px 0 0;border-left:2px solid color-mix(in srgb,var(--acid) 45%,transparent);padding-left:10px}
  .cro-how{color:var(--text);font-size:12.5px;line-height:1.55;margin:8px 0 0}
  .cro-how b{color:var(--muted-2);font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;margin-right:4px}
  .cro-actions{display:flex;gap:8px;margin-top:12px}
</style>
</head>
<body>

<!-- ═══ RED DE SEGURIDAD DE LA PANTALLA EN BLANCO ═══
     `login-view` y `dash-view` arrancan los dos con `hidden`, y quien los muestra es el
     bundle. O sea: si el bundle no carga, la página queda COMPLETAMENTE en blanco, sin un
     cartel, sin un botón, sin nada que explique qué pasó ni qué hacer.
     Pasa de verdad: el service worker guarda el HTML del dashboard, y si sirve una copia
     vieja, esa copia pide un bundle con un hash que ya no existe en el servidor. 404, el
     módulo no ejecuta, pantalla blanca. Recargar no arregla nada porque el SW vuelve a
     servir lo mismo.
     Este script es INLINE y no depende de nada: si en seis segundos nadie mostró una
     vista, aparece el cartel con el botón que borra las cachés y vuelve a pedir todo.
     (Sebastián, 26 ago 2026: "sigo sin poder acceder el dashboard del browser, todo
     blanco".) -->
<div id="vv-rescate" hidden style="position:fixed;inset:0;z-index:99999;display:flex;
  align-items:center;justify-content:center;padding:24px;background:#0b1220;
  font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#f4f6fb">
  <div style="max-width:420px;text-align:center">
    <p style="font-size:17px;font-weight:700;margin:0 0 8px">El dashboard no terminó de cargar</p>
    <p id="vv-rescate-p" style="font-size:14px;line-height:1.6;color:#9aa6bd;margin:0 0 20px">
      Suele ser una copia vieja guardada en el navegador. El botón la borra y vuelve a pedir todo.</p>
    <button id="vv-rescate-b" type="button" style="background:#ddf98f;color:#1c2508;border:0;
      border-radius:100px;font:700 15px inherit;padding:13px 26px;cursor:pointer">Recargar limpio</button>
    <p id="vv-rescate-e" style="font-size:11.5px;color:#6b7896;margin:18px 0 0;word-break:break-word"></p>
  </div>
</div>
<!-- `is:inline` NO es opcional: sin eso Astro se lleva este script a un archivo externo
     con hash, y el rescate pasaría a depender de que carguen los archivos externos — que es
     exactamente lo que falla cuando la pantalla queda en blanco. Probado con el bundle roto
     a propósito: la versión procesada no aparecía. -->
<script is:inline>
(function(){
  var mostrado = false, motivo = '';
  function vista(id){ var e = document.getElementById(id); return e && !e.hidden; }
  function mostrar(){
    if (mostrado || vista('login-view') || vista('dash-view')) return;
    mostrado = true;
    var c = document.getElementById('vv-rescate'); if (!c) return;
    c.hidden = false;
    if (motivo) document.getElementById('vv-rescate-e').textContent = motivo;
  }
  /* Si el módulo no carga, el navegador dispara 'error' sobre el <script>. Es la señal
     más rápida que hay: no hace falta esperar los seis segundos. */
  window.addEventListener('error', function(e){
    var t = e.target;
    if (t && (t.tagName === 'SCRIPT' || t.tagName === 'LINK')){
      motivo = 'No cargó: ' + String(t.src || t.href || '').split('/').pop();
      mostrar();
    }
  }, true);
  setTimeout(mostrar, 6000);

  document.getElementById('vv-rescate-b').addEventListener('click', function(){
    var b = this; b.disabled = true; b.textContent = 'Limpiando…';
    var fin = function(){ location.replace(location.pathname + location.search + '#r=' + Date.now()); location.reload(); };
    /* Se borran las cachés Y se desregistra el service worker: si el SW es el que está
       sirviendo el HTML viejo, borrar solo la caché lo deja volver a guardarlo igual. */
    var tareas = [];
    try { if (window.caches) tareas.push(caches.keys().then(function(ks){
      return Promise.all(ks.map(function(k){ return caches.delete(k); })); })); } catch (e){ }
    try { if (navigator.serviceWorker) tareas.push(navigator.serviceWorker.getRegistrations()
      .then(function(rs){ return Promise.all(rs.map(function(r){ return r.unregister(); })); })); } catch (e){ }
    Promise.all(tareas).then(fin, fin);
    setTimeout(fin, 3000);   // si algo se cuelga, se recarga igual
  });
})();
</script>


