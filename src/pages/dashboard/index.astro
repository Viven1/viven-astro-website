  /* ---- sidebar (HubSpot-style) ---- */
  .dash-body{display:flex;gap:22px;align-items:flex-start}
  .dash-side{flex:0 0 190px;position:sticky;top:16px;display:flex;flex-direction:column;gap:2px;padding-right:4px}
  .side-group{margin-top:4px}
  .side-group .side-sec{display:flex;align-items:center;justify-content:space-between;width:100%;background:none;border:0;cursor:pointer;font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted-2);font-weight:700;padding:12px 10px 6px;font-family:inherit}
  .side-group .side-sec:hover{color:var(--muted)}
  .side-chev{width:12px;height:12px;transition:transform .18s}
  .side-group.collapsed .side-chev{transform:rotate(-90deg)}
