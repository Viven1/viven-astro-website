  /* ================= PROPUESTAS (Qwilr-like) ================= */
  let ppList = [], ppCur = null, ppBuilt = false;
  // el link usa el dominio donde está servido el dashboard (staging ahora, viven.ch cuando esté live)
  const PROP_BASE = location.origin;
  const senderObj = (key) => key === 'sebastian'
    ? { name: 'Sebastian Cepeda', email: 'sebastian@viven.ch', phone: '+41 43 508 45 67', role: 'Founder | Executive Producer' }
    : { name: 'Sofia Treviño', email: 'sofia@viven.ch', phone: '+41 43 508 45 67', role: 'Producer' };
  const DEFAULT_TESTIMONIALS = [
    { quote: 'From the concept to the shooting days to the production of breathtaking videos, VIVEN offers an absolutely ingenious complete package that meets the highest standards.', name: 'Alexander Stauch', role: 'Head of Marketing', company: 'Meteomatics AG' },
    { quote: 'It was awesome working with VIVEN! Great collaboration, flexibility and outstanding results!', name: 'Gianluca Cesari', role: 'Co-Founder & Business Development Lead', company: 'Sevensense Robotics' }
  ];
  const makeSlug = (t) => { const b = (t || 'proposal').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 50) || 'proposal'; return b + '-' + Math.random().toString(36).slice(2, 8); };
  const tierNet = (t) => (t.items || []).reduce((a, it) => a + (Number(it.qty) || 0) * (Number(it.price) || 0), 0);
  const tierCostSum = (t) => (t.items || []).reduce((a, it) => a + (Number(it.qty) || 0) * (Number(it.cost) || 0), 0);
  // precio final tras el % OFF — MISMA fórmula que tierPrice() en la propuesta pública
  // (src/pages/proposal/index.astro), para que el editor muestre exactamente lo que va
  // a ver el cliente (pedido explícito: descuento por paquete, más % en el más caro)
  const tierFinalPrice = (t) => (Number(t.price) || 0) * (1 - (Number(t.discount_pct) || 0) / 100);
  const tierDiscFinalTxt = (t) => (Number(t.discount_pct) || 0) > 0 ? '→ ' + fmtM(tierFinalPrice(t)) + ' final' : '';
  /* ---- bloques de la propuesta (orden + on/off, persistidos en content.block_order / content.blocks_off) ---- */
  const PP_BLOCKS = [
    ['intro', '✉️ Carta intro'], ['overview', '🎯 Overview'], ['photo1', '🖼 Foto separador'], ['scope', '🔧 Scope'],
    ['tiers', '💎 Paquetes'], ['addons', '➕ Add-ons'], ['terms', '📜 Términos'], ['call', '📅 Book a call'],
    ['testimonial', '⭐ Testimonial + video'], ['videos', '🎬 Trabajos'],
  ];
  // el orden default replica EXACTO el layout que la página pública tenía hasta hoy
  const PP_BLOCK_DEFAULT = ['intro', 'photo1', 'overview', 'scope', 'tiers', 'addons', 'terms', 'call', 'testimonial', 'videos'];
  const ppBlockLabel = (k) => (PP_BLOCKS.find(([key]) => key === k) || [k, k])[1];
  // sanea un block_order guardado: solo claves conocidas, sin duplicados, y las que falten al final
  function ppNormOrder(order){
    const known = PP_BLOCKS.map(([k]) => k);
    const seen = new Set();
    const out = (Array.isArray(order) ? order : []).filter((k) => known.includes(k) && !seen.has(k) && seen.add(k));
    known.forEach((k) => { if (!seen.has(k)) out.push(k); });
    return out.length ? out : PP_BLOCK_DEFAULT.slice();
  }
  /* ---- autosave (compartido ofertas/propuestas): "● Guardado hace Xs" ---- */
  function autosaveNote(elId, ts){
    const el = $(elId); if (!el) return;
    if (!ts){ el.hidden = true; return; }
    const s = Math.max(0, Math.round((Date.now() - ts) / 1000));
    el.hidden = false;
    el.textContent = '● Guardado hace ' + (s < 60 ? s + 's' : Math.round(s / 60) + 'min');
  }
  let ppAutoT = null, ppLastSaved = 0, ppSaving = false;
  setInterval(() => { autosaveNote('pp3-autosave', ppLastSaved); autosaveNote('of3-autosave', ofLastSaved); }, 5000);
  function ppMarkDirty(){
