      // no solo un draft de outbox esperando aprobación como el resto
      if (lead) { const dv = dealValue(d); pushTo(null, '🏆 Deal ganado: ' + (lead.name || lead.email || ''), (d.title || 'Proyecto') + (dv ? ' · ' + fmtChf(dv) : ''), '/dashboard/?lead=' + lead.id); }
