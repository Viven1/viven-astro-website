    box.querySelectorAll('[data-still]').forEach((s) => s.addEventListener('change', () => { nwBlocks[+s.dataset.still].src = s.value; nwRenderEditor(); }));
    box.querySelectorAll('[data-ctalabel]').forEach((t) => t.addEventListener('input', () => { nwBlocks[+t.dataset.ctalabel].label = t.value; }));
    box.querySelectorAll('[data-ctadest]').forEach((s) => s.addEventListener('change', () => { const i = +s.dataset.ctadest; nwBlocks[i].dest = s.value === 'custom' ? '' : s.value; nwRenderEditor(); }));
