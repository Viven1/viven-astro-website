  function bindAbList(){
    const box = $('ab-list');
    box.querySelectorAll('.ab-crow').forEach((row) => row.addEventListener('click', () => {
      abExpandedId = row.dataset.id; abLeadsOpen = null; renderAbList(abExp, abLeadsCache);
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));
    // conteo de leads clickeable → despliega/colapsa la lista de ESOS leads
    box.querySelectorAll('.ab-lc').forEach((btn) => btn.addEventListener('click', () => {
      const key = btn.closest('.ab-card').dataset.id + ':' + btn.dataset.side;
      abLeadsOpen = abLeadsOpen === key ? null : key;
      renderAbList(abExp, abLeadsCache);
    }));
    box.querySelectorAll('.ab-leadrow').forEach((tr) => tr.addEventListener('click', () => { gotoTab('leads'); openLead(tr.dataset.lead); }));
    // 🗑 por lead (pedido: "dejame borrar leads si son falsas o tests"): EXACTAMENTE la
    // misma rutina que Personas (🗑 Borrar seleccionados / ficha → Borrar): delete directo
    // en leads — las tablas relacionadas las resuelve la base igual que allá, sin caminos
    // distintos. Después: fuera de allLeads en memoria + abLoad() para que el conteo baje.
    box.querySelectorAll('.ab-lead-del').forEach((btn) => btn.addEventListener('click', async (ev) => {
      ev.stopPropagation();   // la fila entera abre la ficha — que el 🗑 no la dispare
      if (!confirm('¿Borrar este lead? No se puede deshacer.')) return;
      const id = btn.dataset.lead;
      btn.disabled = true;
      const { error } = await supabase.from('leads').delete().eq('id', id);
      if (error){ btn.disabled = false; toast('No se pudo borrar: ' + error.message); return; }
      allLeads = allLeads.filter((l) => String(l.id) !== String(id));
      abLeadsCache = (abLeadsCache || []).filter((l) => String(l.id) !== String(id));
      if (typeof renderLeads === 'function') renderLeads();
      toast('🗑 Lead borrado');
      abLoad();   // refresca conteos y la lista — el número de la variante baja
    }));
    box.querySelectorAll('.ab-card [data-act]').forEach((btn) => btn.addEventListener('click', async () => {
      if (btn.disabled) return;
      const id = btn.closest('.ab-card').dataset.id, act = btn.dataset.act;
      const patchMap = { run: { status: 'running', start_at: new Date().toISOString() }, pause: { status: 'draft' }, winb: { status: 'done_b', end_at: new Date().toISOString() }, wina: { status: 'done_a', end_at: new Date().toISOString() } };
      if (act === 'cmp'){ const t = abTests.find((x) => String(x.id) === String(id)); if (t) abCompare(t); return; }
      if (act === 'del'){ if (!confirm('¿Borrar este test y sus datos?')) return; await supabase.from('ab_tests').delete().eq('id', id); abExpandedId = null; abLoad(); return; }
      const { error } = await supabase.from('ab_tests').update(patchMap[act]).eq('id', id);
      if (error) toast(error.message); else { toast(act === 'winb' ? '🏆 Variante B activa para el 100% del tráfico' : 'Listo'); abLoad(); }
    }));
  }
  function abCompare(t){
