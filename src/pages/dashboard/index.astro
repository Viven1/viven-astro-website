  /* Con AÑO cuando el evento no es de este año. Sin él, «14 ago 09:30» de 2025 y de 2026 se
     ven idénticos y la lista parece desordenada aunque esté bien ordenada. */
  function lm2FmtDT(d){
    const t = Date.parse(d);
    if (!Number.isFinite(t)) return 'sin fecha';
    const f = new Date(t);
    const opt = { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' };
    if (f.getFullYear() !== new Date().getFullYear()) opt.year = 'numeric';
    return f.toLocaleString('es-CH', opt);
  }

  /* Ordenar eventos por fecha, a prueba de fechas rotas.
     `new Date(b.t) - new Date(a.t)` devuelve NaN en cuanto UN evento trae una fecha que no
     parsea, y un comparador que devuelve NaN deja en cualquier orden la lista ENTERA, no
     solo ese elemento. Acá se parsea una vez, lo inválido se va al fondo, y el desempate
     por tipo hace que dos cosas del mismo segundo salgan siempre igual.
     Lo usan las tres timelines: persona, empresa y proyecto — el mismo bug estaba copiado
     en las tres.
     (Sebastián, 27 ago 2026: "mirá la timeline de la persona, que no salen por tiempo ni en
      orden".) */
  /* Comparadores por fecha a prueba de fechas rotas. `new Date(a) - new Date(b)` devuelve
     NaN si UNA fecha no parsea, y un comparador que devuelve NaN deja la lista entera en
     cualquier orden — no solo ese elemento. Estos parsean una vez y mandan lo inválido al
     fondo, que es donde no molesta. */
  const _ts = (x) => { const n = Date.parse(x); return Number.isFinite(n) ? n : null; };
  /* Aceptan VARIOS campos y gana el primero que traiga una fecha válida: `updated_at` puede
     venir vacío y entonces la que ordena es `created_at`. Escrito así porque el
     `a.updated_at || a.created_at` de antes elegía el campo mirando si tenía ALGO, no si esa
     algo era una fecha: una cadena basura ganaba el || y devolvía NaN igual. */
  const _tsDe = (o, campos) => {
    for (const c of campos) { const n = _ts(o && o[c]); if (n !== null) return n; }
    return null;
  };
  const masNuevo = (...campos) => (a, b) => {
    const x = _tsDe(a, campos), y = _tsDe(b, campos);
    if (x === null && y === null) return 0;
    if (x === null) return 1;
    if (y === null) return -1;
    return y - x;
  };
  const masViejo = (...campos) => (a, b) => {
    const x = _tsDe(a, campos), y = _tsDe(b, campos);
    if (x === null && y === null) return 0;
    if (x === null) return 1;
    if (y === null) return -1;
    return x - y;
  };

  function ordenarEventos(ev){
    ev.forEach((e) => { const n = Date.parse(e && e.t); e._ms = Number.isFinite(n) ? n : -Infinity; });
    ev.sort((a, b) => (b._ms - a._ms) || String(a.ty || '').localeCompare(String(b.ty || '')));
    const rotas = ev.filter((e) => e._ms === -Infinity);
    if (rotas.length) console.warn('TIMELINE: ' + rotas.length + ' evento(s) sin fecha válida', rotas);
    return ev;
  }

