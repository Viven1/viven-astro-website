      '<button class="btn btn-ghost small" id="ofc-cancel" type="button">Cancelar</button></div></div>';
    ov.querySelector('#ofc-cancel').addEventListener('click', () => ov.remove());
    ov.addEventListener('click', (e) => { if (e.target === ov) ov.remove(); });
    ov.querySelector('#ofc-send').addEventListener('click', async () => {
      const to = ov.querySelector('#ofc-to').value.trim();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(to)){ toast('Poné un email válido'); return; }
      const btn = ov.querySelector('#ofc-send'); btn.disabled = true; btn.textContent = 'Generando PDF…';
      const note = ov.querySelector('#ofc-note').value;
      // PDF adjunto: se genera acá mismo (jsPDF local, sin CDN); si falla, el email sale igual sin adjunto
      let pdfB64 = null;
      try { pdfB64 = await buildOfferPdfBase64(lang); }
      catch (e) { console.warn('PDF adjunto falló:', e); toast('⚠️ No se pudo generar el PDF adjunto — el email sale embebido igual'); }
      btn.textContent = 'Enviando…';
      // offer_id: con él, send-offer taggea el mail para el tracking de aperturas (webhook Resend → last_open_at)
      // y marca status='sent' + sent_at del lado del server — solo se puede si la oferta ya está guardada (tiene id)
      const body = { to, subject: ov.querySelector('#ofc-subj').value.trim(), html: offerEmailHTML(note, lang, pdfB64 ? attachName : null), text: note, reply_to: myEmail() };
      if (pdfB64){ body.pdf_base64 = pdfB64; body.pdf_filename = attachName; }
      if (ofCur.id) body.offer_id = ofCur.id;
      const { data, error } = await supabase.functions.invoke('send-offer', { body });
      btn.disabled = false; btn.textContent = '📨 Enviar email';
      if (error || (data && data.error)){ toast('No se pudo enviar (¿deployaste send-offer?): ' + (error?.message || data.error)); return; }
      ov.remove();
      if (ofCur.id){
        // el server ya la marcó enviada: reflejarlo en memoria, en el select del editor y en la lista
        ofCur.status = 'sent'; ofCur.sent_at = new Date().toISOString();
        $('of-status').value = 'sent'; renderOf3Status();
        toast('📨 Oferta enviada a ' + to + (pdfB64 ? ' (con PDF adjunto)' : ''));
        offersLoad();
